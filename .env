# -----------------------------------------------------------------------------
# APP CONFIGURATION
# -----------------------------------------------------------------------------
# Application-level settings

APP_NAME=AwoERP
APP_VERSION="0.1.0 beta"
# Valid values: development, staging, production, testing
APP_STAGE=dev
# Enable debug mode (true/false) - overrides stage-based logging
DEBUG=true
APP_DEBUG=true
# Custom environment identifier
ENVIRONMENT=local
APP_ENV=local
# Kubernetes namespace or deployment namespace
NAMESPACE=default
APP_NAMESPACE=default

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
# Database connection settings

DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=ledger
# Valid SSL modes: disable, require, verify-ca, verify-full
DB_SSL_MODE=disable
# Connection pool settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
# Connection lifetime (e.g., "5m", "1h", "30s")
DB_CONN_MAX_LIFETIME=5m
DB_URL="postgresql://$DB_USER:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_NAME?sslmode=$DB_SSL_MODE"
TEST_DATABASE_URL="$DB_URL"
#
# # Migration Configuration
MIGRATION_URL=file://db/migration

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
# Redis cache/session store settings

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

#
# # looger
# LOG_TYPE=zerolog
# LOG_LEVEL=info
# LOG_FORMAT=console
# LOG_DEVELOPMENT=true
# SERVICE_NAME="Awo ERP"
# SERVICE_VERSION=0.1.0
# LOG_OUTPUT=stdout
#
# =============================================================================
# APPLICATION ENVIRONMENT VARIABLES
# =============================================================================
# This file contains all environment variables that can be used to configure
# the application. These variables will override the default values and any
# values specified in config.yaml files.
#
# Usage:
# 1. Copy this file to .env in your project root
# 2. Uncomment and set the values you want to override
# 3. Keep sensitive values (passwords, secrets) in environment variables only
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# HTTP and gRPC server settings

SERVER_PORT=8080
GRPC_PORT=9090
# Server bind address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
SERVER_HOST=0.0.0.0
# Timeout values (e.g., "30s", "1m", "5m30s")
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
# Maximum header size (e.g., "1MB", "512KB")
SERVER_MAX_HEADER_SIZE=1MB

# -----------------------------------------------------------------------------
# GOA FRAMEWORK CONFIGURATION
# -----------------------------------------------------------------------------
# Goa.design specific settings for API service

# OpenAPI/Swagger Documentation
GOA_OPENAPI_ENABLED=true
GOA_OPENAPI_PATH="internal/api/gen/openapi"
GOA_OPENAPI_SPEC_PATH=/openapi.json
GOA_OPENAPI_TITLE="AwoERP API"
GOA_OPENAPI_DESCRIPTION="AwoERP service API documentation"
GOA_OPENAPI_VERSION="1.0.0"
GOA_OPENAPI_CONTACT_NAME="API Support"
GOA_OPENAPI_CONTACT_EMAIL=api-support@example.com
GOA_OPENAPI_CONTACT_URL=https://example.com/support

# CORS Configuration
GOA_CORS_ENABLED=true
# Comma-separated list of allowed origins
GOA_CORS_ALLOW_ORIGINS=http://localhost:3000,https://app.example.com
# Comma-separated list of allowed methods
GOA_CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
# Comma-separated list of allowed headers
GOA_CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin,X-TenentID
# Comma-separated list of exposed headers
GOA_CORS_EXPOSE_HEADERS=Content-Length,Content-Type,X-Total-Count
GOA_CORS_ALLOW_CREDENTIALS=true
# Preflight cache duration in seconds
GOA_CORS_MAX_AGE=86400

# Request Configuration
GOA_REQUEST_MAX_BODY_SIZE=10MB
GOA_REQUEST_TIMEOUT=30s

# Rate Limiting
GOA_RATE_LIMIT_ENABLED=true
GOA_RATE_LIMIT_RPM=60
GOA_RATE_LIMIT_BURST=10

# Middleware Configuration
GOA_MIDDLEWARE_REQUEST_ID_ENABLED=true
GOA_MIDDLEWARE_REQUEST_ID_HEADER=X-Request-ID

GOA_MIDDLEWARE_LOGGING_ENABLED=true
GOA_MIDDLEWARE_LOGGING_LOG_REQUEST_BODY=false
GOA_MIDDLEWARE_LOGGING_LOG_RESPONSE_BODY=false
# Comma-separated list of paths to skip logging
GOA_MIDDLEWARE_LOGGING_SKIP_PATHS=/health,/metrics,/swagger

GOA_MIDDLEWARE_RECOVERY_ENABLED=true

GOA_MIDDLEWARE_METRICS_ENABLED=true
GOA_MIDDLEWARE_METRICS_PATH=/metrics

GOA_MIDDLEWARE_HEALTH_ENABLED=true
GOA_MIDDLEWARE_HEALTH_PATH=/health
GOA_MIDDLEWARE_HEALTH_DETAILED=false

# Security Configuration
GOA_SECURITY_JWT_ENABLED=true
# Signing methods: HS256, HS384, HS512, RS256, RS384, RS512, ES256, ES384, ES512
GOA_SECURITY_JWT_SIGNING_METHOD=HS256
GOA_SECURITY_JWT_CLAIMS_USER_ID=sub
GOA_SECURITY_JWT_CLAIMS_ROLES=roles
GOA_SECURITY_JWT_CLAIMS_PERMISSIONS=permissions

GOA_SECURITY_API_KEY_ENABLED=false
GOA_SECURITY_API_KEY_HEADER=X-API-Key

GOA_SECURITY_BASIC_AUTH_ENABLED=false

# Response Configuration
GOA_RESPONSE_DEFAULT_FORMAT=json
GOA_RESPONSE_PRETTY_JSON=true
GOA_RESPONSE_INCLUDE_STACK_TRACE=false

# File Upload Configuration
GOA_UPLOAD_MAX_FILE_SIZE=50MB
# Comma-separated list of allowed MIME types
GOA_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/csv
GOA_UPLOAD_TEMP_DIR=/tmp/uploads

# Circuit Breaker Configuration
GOA_CIRCUIT_BREAKER_ENABLED=false
GOA_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
GOA_CIRCUIT_BREAKER_RESET_TIMEOUT=60s
GOA_CIRCUIT_BREAKER_HALF_OPEN_MAX_REQUESTS=3

# -----------------------------------------------------------------------------
# TEMPORAL CONFIGURATION
# -----------------------------------------------------------------------------
# Temporal workflow engine settings

TEMPORAL_HOST_PORT=localhost:7233

# -----------------------------------------------------------------------------
# AUTHENTICATION CONFIGURATION
# -----------------------------------------------------------------------------
# JWT and authentication settings

# IMPORTANT: Use a strong, unique secret in production
JWT_SECRET=secret-jwt-key

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Feature toggles for enabling/disabling functionality

# Enable new dashboard feature (true/false)
ENABLE_NEW_DASHBOARD=false

# -----------------------------------------------------------------------------
# LOGGER CONFIGURATION
# -----------------------------------------------------------------------------
# Logging system settings

# Logger type: zap, zerolog, slog
LOG_TYPE=zerolog
# Log level: debug, info, warn, error, fatal
LOG_LEVEL=debug
# Log format: json, text, console
LOG_FORMAT=console
# Enable development mode logging (true/false)
LOG_DEV=true
# Service name for structured logging
SERVICE_NAME=AwoERP
# Service version for logging
SERVICE_VERSION=1.0.0
# Output destination: stdout, stderr, or file path
LOG_OUTPUT=stdout

