# =============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Environment variables for local development only
# Copy this file to .env in your project root for development

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
APP_NAME=AwoERP
APP_VERSION="0.1.0 beta"
APP_STAGE=dev
APP_ENV=local
ENVIRONMENT=local
NAMESPACE=default
APP_NAMESPACE=default

# Debug settings (enabled for development)
DEBUG=true
APP_DEBUG=true

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GRPC_PORT=9090

# Development timeouts (generous for debugging)
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_MAX_HEADER_SIZE=1MB

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=ledger
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_URL="postgresql://admin:admin@localhost:5432/ledger?sslmode=disable"
TEST_DATABASE_URL="postgresql://admin:admin@localhost:5432/ledger?sslmode=disable"
MIGRATION_URL=file://db/migration

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# TEMPORAL CONFIGURATION
# -----------------------------------------------------------------------------
# Temporal server connection
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default

# Client configuration
TEMPORAL_CLIENT_TIMEOUT=10s
TEMPORAL_CLIENT_CONNECTION_TIMEOUT=5s
TEMPORAL_CLIENT_KEEP_ALIVE_TIME=30s
TEMPORAL_CLIENT_KEEP_ALIVE_TIMEOUT=5s

# Worker configuration
TEMPORAL_WORKER_MAX_CONCURRENT_ACTIVITIES=100
TEMPORAL_WORKER_MAX_CONCURRENT_WORKFLOWS=100
TEMPORAL_WORKER_MAX_CONCURRENT_LOCAL_ACTIVITIES=100
TEMPORAL_WORKER_TASK_QUEUE=awo-erp-task-queue

# Workflow configuration
TEMPORAL_WORKFLOW_EXECUTION_TIMEOUT=10m
TEMPORAL_WORKFLOW_RUN_TIMEOUT=5m
TEMPORAL_WORKFLOW_TASK_TIMEOUT=10s

# Activity configuration
TEMPORAL_ACTIVITY_START_TO_CLOSE_TIMEOUT=30s
TEMPORAL_ACTIVITY_SCHEDULE_TO_START_TIMEOUT=10s
TEMPORAL_ACTIVITY_SCHEDULE_TO_CLOSE_TIMEOUT=1m
TEMPORAL_ACTIVITY_HEARTBEAT_TIMEOUT=5s

# Retry policy
TEMPORAL_RETRY_INITIAL_INTERVAL=1s
TEMPORAL_RETRY_BACKOFF_COEFFICIENT=2.0
TEMPORAL_RETRY_MAXIMUM_INTERVAL=100s
TEMPORAL_RETRY_MAXIMUM_ATTEMPTS=3

# Development specific settings
TEMPORAL_LOG_LEVEL=info
TEMPORAL_METRICS_ENABLED=true
TEMPORAL_METRICS_PREFIX=temporal_
TEMPORAL_ENABLE_LOGGING_IN_REPLAY=false

# TLS Configuration (disabled for development)
TEMPORAL_TLS_ENABLED=false
# TEMPORAL_TLS_CERT_PATH=
# TEMPORAL_TLS_KEY_PATH=
# TEMPORAL_TLS_CA_PATH=
# TEMPORAL_TLS_SERVER_NAME=

# Web UI (if running Temporal UI locally)
TEMPORAL_WEB_UI_HOST=localhost
TEMPORAL_WEB_UI_PORT=8080

# Development workflow settings
TEMPORAL_DEV_MODE=true
TEMPORAL_ENABLE_SESSION_RECORDING=false

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# IMPORTANT: This is for development only - use a secure secret in production
JWT_SECRET=dev-jwt-secret-key

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
LOG_TYPE=zerolog
LOG_LEVEL=debug
LOG_FORMAT=console
LOG_DEV=true
SERVICE_NAME=AwoERP
SERVICE_VERSION=1.0.0
LOG_OUTPUT=stdout

# -----------------------------------------------------------------------------
# GOA FRAMEWORK CONFIGURATION
# -----------------------------------------------------------------------------

# OpenAPI/Swagger (enabled for development)
GOA_OPENAPI_ENABLED=true
GOA_OPENAPI_PATH="internal/api/gen/openapi"
GOA_OPENAPI_SPEC_PATH=/openapi.json
GOA_OPENAPI_TITLE="AwoERP API"
GOA_OPENAPI_DESCRIPTION="AwoERP service API documentation"
GOA_OPENAPI_VERSION="1.0.0"
GOA_OPENAPI_CONTACT_NAME="Development Team"
GOA_OPENAPI_CONTACT_EMAIL=dev@example.com
GOA_OPENAPI_CONTACT_URL=http://localhost:3000

# CORS (permissive for development)
GOA_CORS_ENABLED=true
GOA_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
GOA_CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
GOA_CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin,X-TenentID
GOA_CORS_EXPOSE_HEADERS=Content-Length,Content-Type,X-Total-Count
GOA_CORS_ALLOW_CREDENTIALS=true
GOA_CORS_MAX_AGE=86400

# Request Configuration
GOA_REQUEST_MAX_BODY_SIZE=10MB
GOA_REQUEST_TIMEOUT=30s

# Rate Limiting (disabled or very permissive for development)
GOA_RATE_LIMIT_ENABLED=false
GOA_RATE_LIMIT_RPM=1000
GOA_RATE_LIMIT_BURST=100

# Middleware Configuration
GOA_MIDDLEWARE_REQUEST_ID_ENABLED=true
GOA_MIDDLEWARE_REQUEST_ID_HEADER=X-Request-ID

# Logging middleware (verbose for development)
GOA_MIDDLEWARE_LOGGING_ENABLED=true
GOA_MIDDLEWARE_LOGGING_LOG_REQUEST_BODY=true
GOA_MIDDLEWARE_LOGGING_LOG_RESPONSE_BODY=true
GOA_MIDDLEWARE_LOGGING_SKIP_PATHS=/health,/metrics

GOA_MIDDLEWARE_RECOVERY_ENABLED=true
GOA_MIDDLEWARE_METRICS_ENABLED=true
GOA_MIDDLEWARE_METRICS_PATH=/metrics
GOA_MIDDLEWARE_HEALTH_ENABLED=true
GOA_MIDDLEWARE_HEALTH_PATH=/health
GOA_MIDDLEWARE_HEALTH_DETAILED=true

# Security (basic for development)
GOA_SECURITY_JWT_ENABLED=true
GOA_SECURITY_JWT_SIGNING_METHOD=HS256
GOA_SECURITY_JWT_CLAIMS_USER_ID=sub
GOA_SECURITY_JWT_CLAIMS_ROLES=roles
GOA_SECURITY_JWT_CLAIMS_PERMISSIONS=permissions

GOA_SECURITY_API_KEY_ENABLED=false
GOA_SECURITY_BASIC_AUTH_ENABLED=false

# Response Configuration (pretty for development)
GOA_RESPONSE_DEFAULT_FORMAT=json
GOA_RESPONSE_PRETTY_JSON=true
GOA_RESPONSE_INCLUDE_STACK_TRACE=true

# File Upload Configuration
GOA_UPLOAD_MAX_FILE_SIZE=50MB
GOA_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/csv
GOA_UPLOAD_TEMP_DIR=/tmp/uploads

# Circuit Breaker (disabled for development)
GOA_CIRCUIT_BREAKER_ENABLED=false

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Enable experimental features in development
ENABLE_NEW_DASHBOARD=true

# =============================================================================
# DOCKER COMPOSE OVERRIDE (if using containers)
# =============================================================================
# Uncomment these if running with docker-compose for development
#
# DB_HOST=postgres
# REDIS_HOST=redis
# TEMPORAL_HOST_PORT=temporal:7233
# TEMPORAL_WEB_UI_HOST=temporal-ui

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
#
# This configuration is optimized for development:
#
# Debug mode enabled
# Verbose logging
# Pretty JSON responses
# Stack traces included in errors
# Permissive CORS settings
# Rate limiting disabled
# Request/response body logging enabled
# Detailed health checks
# Local database with simple credentials
# Feature flags enabled for testing
# Complete Temporal workflow configuration
# Development-friendly timeouts and retries
#
#   DO NOT use these settings in production!
#
# TEMPORAL SETUP:
# 1. Install Temporal CLI: https://docs.temporal.io/cli
# 2. Start Temporal server: temporal server start-dev
# 3. Access Web UI at: http://localhost:8080
# 4. View workflows and activities in the Temporal Web UI
#
# To use:
# 1. Copy this file to .env in your project root
# 2. Adjust database credentials if needed
# 3. Start your local PostgreSQL and Redis instances
# 4. Start Temporal server (see above)
# 5. Run your application
#
# =============================================================================
