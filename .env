# -----------------------------------------------------------------------------
# TESTING ENVIRONMENT EXAMPLE
# -----------------------------------------------------------------------------
# Uncomment and modify for testing environment
#
# APP_STAGE=testing
# DEBUG=true
# ENVIRONMENT=test
# DB_HOST=test-db
# DB_PASSWORD=test_password
# DB_NAME=ledger_test
# REDIS_HOST=test-redis
# LOG_LEVEL=debug
# JWT_SECRET=test-jwt-secret

