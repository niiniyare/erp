# app configuration
APP_NAME=ledger
APP_VERSION=1.0.0
APP_STAGE=dev
DEBUG=true
APP_ENV=local
NAMESPACE=default

# ATABASE
DB_NAME=ledger
DB_USER=admin
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=disable
TEST_DATABASE_URL='postgresql://admin:admin@localhost:5432/ledger?sslmode=disable'

# Migration Configuration
MIGRATION_URL=file://db/migration

# looger
LOG_TYPE=zerolog
LOG_LEVEL=info
LOG_FORMAT=console
LOG_DEVELOPMENT=true
SERVICE_NAME="Awo ERP"
SERVICE_VERSION=0.1.0
LOG_OUTPUT=stdout
