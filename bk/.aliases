# Termux Aliases Configuration
# Organized and optimized for Termux environment

# ========================================
# CORE SYSTEM NAVIGATION
# ========================================
alias c="clear"
alias q="exit"
alias pf="cd $PREFIX"
alias ss="cd /sdcard/Pictures/Screenshots/"
alias ms="cd /sdcard/Movies"
alias dl="cd /sdcard/Download"
alias ds="cd /sdcard/Documents"
alias archives="cd /data/data/com.termux/cache/apt/archives/"

# ========================================
# ENHANCED FILE OPERATIONS (using lsd)
# ========================================
alias ls="lsd"
alias la="lsd -la --group-dirs=first"
alias l="lsd -lha"
alias ll="lsd -l --group-dirs=first"
alias lt="lsd --tree"
alias lta="lsd --tree -la"
alias ltd="lsd --tree -d"
alias lst="lsd -lt"
alias lsr="lsd -lR"
alias lsize="lsd -lSha"
alias ldate="lsd -ltha"

# Additional lsd enhanced aliases
alias ldir="lsd -la --group-dirs=first --classify"
alias ldetail="lsd -la --blocks=permission,user,group,size,date,name --date='+%Y-%m-%d %H:%M'"
alias lmin="lsd --oneline"
alias lgrid="lsd --grid"

alias bat="bat --theme OneHalfDark"
alias v='$EDITOR'
alias rm="rm -i"
alias rmf="rm -rf"

# File preview and search
alias preview="fzf --preview='bat --color=always --style=numbers --theme OneHalfDark {}' --preview-window=down"
alias largefile="du -h -x -s -- * | sort -r -h | head -20"

# ========================================
# PACKAGE MANAGEMENT (TERMUX)
# ========================================
# Primary Termux package manager
alias pacupd="pkg update"
alias pacupg="pkg upgrade"
alias pacupgupd="pkg update && pkg upgrade"

# Enhanced package management with nala
alias update="apt update -y && apt upgrade -y && apt list --upgradable -a"
alias sysupdate="apt update -y && apt upgrade -y && apt list --upgradable -a"
alias ni="nala install --assume-yes"
alias search="nala search"
alias upgradable="apt list --upgradable -a"

# Standard Termux commands
alias install="pkg install"
alias uninstall="pkg uninstall"

# ========================================
# TERMUX-SPECIFIC FEATURES
# ========================================
# Termux API
alias scan="termux-media-scan"
alias open="termux-open"
alias url="termux-open-url"
alias clip-set="termux-clipboard-set"
alias clip-get="termux-clipboard-get"

# Termux Settings
alias reload="termux-reload-settings"
alias termconf="$EDITOR ~/.termux/termux.properties"
alias termper="termux-setup-storage"

# ========================================
# PROOT DISTROS
# ========================================
alias prot="cd $PREFIX/var/lib/proot-distro"
alias protlogin="proot-distro login"
alias ubuntu='proot-distro login ubuntu -- zsh'
alias fedora="proot-distro login fedora -- zsh"

# ========================================
# DEVELOPMENT TOOLS
# ========================================
# Git shortcuts
alias gitgraph="git log --all --decorate --oneline --graph"
alias gitupdate="git fetch && git pull"
alias gitstat="git status"
alias gitad="git add"
alias gitcom="git commit -m"
alias lg='lazygit'

# Build tools
alias m="make"

# ========================================
# MULTIMEDIA & ENTERTAINMENT
# ========================================
# Music (MPD/NCMPCPP)
alias n="ncmpcpp"
alias mkill="mpd --kill"
alias music="ncmpcpp"

# Video conversion
alias convi="ffmpeg -i \$1 -c:v libx264 -crf 25 \$2"

# ========================================
# NETWORK UTILITIES
# ========================================
alias pg="ping google.com"
alias myip="bash ~/.scripts/system/ip.sh simcard"
alias myipwifi="bash ~/.scripts/system/ip.sh wifi"
alias myiphotspot="bash ~/.scripts/system/ip.sh hotspot"
alias myipvpn="bash ~/.scripts/system/ip.sh vpn"
alias myipall="bash ~/.scripts/system/ip.sh all"

# Security and reconnaissance tools
alias domain="subfinder"

# ========================================
# SYSTEM INFORMATION
# ========================================
alias neo="neofetch"
alias neodebug="bash ~/.config/neofetch/debug-logo.sh"
alias disk="bash ~/.scripts/system/fetch.sh storage"
alias battery="bash ~/.scripts/system/fetch.sh battery"
alias fetch="bash ~/.scripts/system/fetch.sh"

# ========================================
# CONFIGURATION FILES
# ========================================
# Core configs
alias zshrc="$EDITOR ~/.zshrc"
alias aliasconf="$EDITOR ~/.aliases"
alias refresh="source ~/.zshrc"
alias zr="source ~/.zshrc"

# Application configs
alias nviminit="$EDITOR ~/.config/nvim/init.lua"
alias nvimtheme="$EDITOR ~/.config/nvim/lua/chadrc.lua"
alias neoconf="$EDITOR ~/.config/neofetch/config.conf"
alias mpdconf="$EDITOR ~/.config/mpd/mpd.conf"
alias ncmconf="$EDITOR ~/.config/ncmpcpp/config"

# Script configs
alias chcolor="~/.scripts/colorscheme/colors.sh"
alias chfont="~/.scripts/fonts/fonts.sh"
alias chzsh="~/.scripts/zsh/changetheme.sh"
alias schemeconf="$EDITOR ~/.scripts/colorscheme/colors.sh"
alias fontsconf="$EDITOR ~/.scripts/fonts/fonts.sh"
alias fetchconf="$EDITOR ~/.scripts/system/fetch.sh"

# ========================================
# USAGE LOGS
# ========================================
alias fontused="cat ~/.config/mytermux/fonts/used.log"
alias colorused="cat ~/.config/mytermux/colorscheme/used.log"
alias zshused="cat ~/.config/mytermux/zsh/used.log"

# ========================================
# VISUAL TOYS & TERMINAL EYE CANDY
# ========================================
alias 256colors2="~/.scripts/toys/256colors2.pl"
alias bloks="~/.scripts/toys/bloks"
alias colortest="~/.scripts/toys/colortest"
alias colorview="~/.scripts/toys/colorview"
alias colorbars="~/.scripts/toys/colorbars"
alias panes="~/.scripts/toys/panes"
alias pipes1="~/.scripts/toys/pipes1"
alias pipes2="~/.scripts/toys/pipes2"
alias dna="~/.scripts/toys/dna"
alias ghost="~/.scripts/toys/ghost"
alias jfetch="~/.scripts/toys/jfetch"
alias rains="~/.scripts/toys/rains"
alias spacey="~/.scripts/toys/spacey"

# ========================================
# DATABASE (PostgreSQL)
# ========================================
alias pgstart="pg_ctl -D ~/pg -l ~/pg/logfile start"
alias pgstop="pg_ctl -D ~/pg -l ~/pg/logfile stop"

# ========================================
# WEB DEVELOPMENT
# ========================================
# Web servers and development tools
alias markdown-server="algernon -s -u -n . :3002"
alias apaconf="$EDITOR $PREFIX/etc/apache2/httpd.conf"
alias phpmyadminconf="$EDITOR $PREFIX/etc/phpmyadmin/config.inc.php"

# ========================================
# UTILITIES
# ========================================
alias how="~/dotfiles/cht.sh"
alias repocek="node ~/.scripts/js/repochecker.js"
alias listfont="magick convert -list font | grep -iE 'font:.*'"

# ========================================
# FILE TYPE ASSOCIATIONS
# ========================================
alias -s {go,js,jsx,zsh,ts,tsx,py,lua,json,md,sql,yaml,yml,toml,tml,Makefile,css,scss,html,csv,sass,proto,fizz,svelte,adoc,txt,text,templ,Makefile}=$EDITOR


#Change
alias chcolor="~/.scripts/colorscheme/colors.sh"
alias chfont="~/.scripts/fonts/fonts.sh"
alias chzsh="~/.scripts/zsh/changetheme.sh"

#Config
alias fontused="cat ~/.config/mytermux/fonts/used.log"
alias colorused="cat ~/.config/mytermux/colorscheme/used.log"
alias zshused="cat ~/.config/mytermux/zsh/used.log"
