// =============================================================================
// PERMISSION EVALUATION ENDPOINTS
// =============================================================================

// EvaluatePermission handles comprehensive permission evaluation
func (h *UserManagementHandler) EvaluatePermission(c *gin.Context) {
	ctx := h.tracing.ExtractHTTPHeaders(c.Request.Context(), c.Request.Header)
	
	ctx, span := h.tracing.StartSpan(ctx, "http.evaluate_permission",
		tracing.WithSpanKind(tracing.SpanKindServer))
	defer span.End()
	
	timer := h.metrics.Timer("http_request_duration", metrics.Fields{
		"method":   c.Request.Method,
		"endpoint": "/api/v1/permissions/evaluate",
	})
	defer timer.Stop()
	
	// Parse and validate request
	var req EvaluatePermissionRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		h.handleValidationError(c, ctx, err)
		return
	}
	
	// Convert to service request
	serviceReq := &coreUser.PermissionEvaluationRequest{
		UserID:       req.UserID,
		ResourceName: req.ResourceName,
		ActionName:   req.ActionName,
		EntityID:     req.EntityID,
		Context:      req.Context,
	}
	
	// Call service layer
	result, err := h.service.EvaluatePermission(ctx, serviceReq)
	if err != nil {
		h.handleError(c, ctx, err, "Failed to evaluate permission")
		return
	}
	
	// Success response
	c.JSON(http.StatusOK, PermissionEvaluationResponse{
		Allowed:           result.Allowed,
		PolicyDecisions:   result.PolicyDecisions,
		EffectiveRoles:    result.EffectiveRoles,
		EvaluationTimeMS:  result.EvaluationTimeMS,
		CacheHit:          result.CacheHit,
		Obligations:       result.Obligations,
		DataFilters:       result.DataFilters,
		FieldRestrictions: result.FieldRestrictions,
	})
}

// =============================================================================
// HELPER METHODS
// =============================================================================

// parseIntParam safely parses an integer parameter with default
func (h *UserManagementHandler) parseIntParam(c *gin.Context, param string, defaultValue int) int {
	if str := c.Query(param); str != "" {
		if val, err := strconv.Atoi(str); err == nil && val > 0 {
			return val
		}
	}
	return defaultValue
}

// parseUUID safely parses a UUID parameter
func (h *UserManagementHandler) parseUUID(str string) *uuid.UUID {
	if str == "" {
		return nil
	}
	if id, err := uuid.Parse(str); err == nil {
		return &id
	}
	return nil
}

// parseDate safely parses a date string
func (h *UserManagementHandler) parseDate(dateStr *string) *time.Time {
	if dateStr == nil || *dateStr == "" {
		return nil
	}
	if date, err := time.Parse("2006-01-02", *dateStr); err == nil {
		return &date
	}
	return nil
}

// handleError handles errors consistently
func (h *UserManagementHandler) handleError(c *gin.Context, ctx context.Context, err error, message string) {
	h.tracing.RecordError(ctx, err, tracing.WithErrorStatus())
	
	h.metrics.IncrementCounter("http_errors_total", metrics.Fields{
		"method":     c.Request.Method,
		"endpoint":   c.Request.URL.Path,
		"error_type": "business_error",
	})
	
	logger.ErrorContext(ctx, message, logger.Fields{"error": err.Error()})
	
	// Handle specific errors
	switch {
	case errors.Is(err, errors.ErrUserNotFound):
		c.JSON(http.StatusNotFound, ErrorResponse{
			Error: "Resource not found",
			Code:  "NOT_FOUND",
		})
	case errors.Is(err, errors.ErrEmailAlreadyExists):
		c.JSON(http.StatusConflict, ErrorResponse{
			Error: "Email already exists",
			Code:  "EMAIL_EXISTS",
		})
	case errors.Is(err, errors.ErrUsernameAlreadyExists):
		c.JSON(http.StatusConflict, ErrorResponse{
			Error: "Username already exists",
			Code:  "USERNAME_EXISTS",
		})
	default:
		c.JSON(http.StatusInternalServerError, ErrorResponse{
			Error: "Internal server error",
			Code:  "INTERNAL_ERROR",
		})
	}
}

// handleValidationError handles validation errors
func (h *UserManagementHandler) handleValidationError(c *gin.Context, ctx context.Context, err error) {
	h.tracing.RecordError(ctx, err, tracing.WithErrorStatus())
	
	h.metrics.IncrementCounter("http_errors_total", metrics.Fields{
		"method":     c.Request.Method,
		"endpoint":   c.Request.URL.Path,
		"error_type": "validation_error",
	})
	
	logger.ErrorContext(ctx, "Invalid request payload", logger.Fields{"error": err.Error()})
	
	c.JSON(http.StatusBadRequest, ErrorResponse{
		Error: "Invalid request data",
		Code:  "VALIDATION_ERROR",
	})
}

// buildPaginationResponse builds pagination metadata
func (h *UserManagementHandler) buildPaginationResponse(page, perPage, total int) PaginationResponse {
	totalPages := (total + perPage - 1) / perPage
	return PaginationResponse{
		Page:       page,
		PerPage:    perPage,
		Total:      total,
		TotalPages: totalPages,
		HasNext:    page < totalPages,
		HasPrev:    page > 1,
	}
}

// Conversion helper methods
func (h *UserManagementHandler) convertPersonToResponse(p *coreUser.Person) PersonResponse {
	response := PersonResponse{
		ID:         p.ID.String(),
		TenantID:   p.TenantID.String(),
		EntityID:   p.EntityID.String(),
		PersonType: p.PersonType,
		FirstName:  p.FirstName,
		LastName:   p.LastName,
		Email:      p.Email,
		IsActive:   p.IsActive,
		CreatedAt:  p.CreatedAt.Format(time.RFC3339),
		UpdatedAt:  p.UpdatedAt.Format(time.RFC3339),
	}
	
	if p.MiddleName != nil {
		response.MiddleName = p.MiddleName
	}
	if p.Phone != nil {
		response.Phone = p.Phone
	}
	if p.DeletedAt != nil {
		deletedAt := p.DeletedAt.Format(time.RFC3339)
		response.DeletedAt = &deletedAt
	}
	
	return response
}

func (h *UserManagementHandler) convertEmployeeToResponse(e *coreUser.Employee) EmployeeResponse {
	response := EmployeeResponse{
		ID:               e.ID.String(),
		TenantID:         e.TenantID.String(),
		PersonID:         e.PersonID.String(),
		EntityID:         e.EntityID.String(),
		EmployeeNumber:   e.EmployeeNumber,
		HireDate:         e.HireDate.Format("2006-01-02"),
		EmploymentStatus: string(e.EmploymentStatus),
		SecurityLevel:    e.SecurityLevel,
		CreatedAt:        e.CreatedAt.Format(time.RFC3339),
		UpdatedAt:        e.UpdatedAt.Format(time.RFC3339),
	}
	
	if e.PositionTitle != nil {
		response.PositionTitle = e.PositionTitle
	}
	if e.DepartmentID != nil {
		deptID := e.DepartmentID.String()
		response.DepartmentID = &deptID
	}
	if e.ManagerID != nil {
		mgrID := e.ManagerID.String()
		response.ManagerID = &mgrID
	}
	if e.TerminationDate != nil {
		termDate := e.TerminationDate.Format("2006-01-02")
		response.TerminationDate = &termDate
	}
	
	return response
}

func (h *UserManagementHandler) convertUserToResponse(u *coreUser.User) UserResponse {
	response := UserResponse{
		ID:            u.ID.String(),
		TenantID:      u.TenantID.String(),
		EntityID:      u.EntityID.String(),
		Email:         u.Email,
		UserType:      u.UserType,
		AccountStatus: string(u.AccountStatus),
		IsActive:      u.IsActive,
		MfaEnabled:    u.MfaEnabled,
		CreatedAt:     u.CreatedAt.Format(time.RFC3339),
		UpdatedAt:     u.UpdatedAt.Format(time.RFC3339),
	}
	
	if u.PersonID != nil {
		personID := u.PersonID.String()
		response.PersonID = &personID
	}
	if u.EmployeeID != nil {
		empID := u.EmployeeID.String()
		response.EmployeeID = &empID
	}
	if u.Username != nil {
		response.Username = u.Username
	}
	if u.LastLoginAt != nil {
		lastLogin := u.LastLoginAt.Format(time.RFC3339)
		response.LastLoginAt = &lastLogin
	}
	
	return response
}

// =============================================================================
// REQUEST/RESPONSE TYPES
// =============================================================================

// Error response types
type ErrorResponse struct {
	Error string `json:"error"`
	Code  string `json:"code"`
}

// Pagination response
type PaginationResponse struct {
	Page       int  `json:"page"`
	PerPage    int  `json:"per_page"`
	Total      int  `json:"total"`
	TotalPages int  `json:"total_pages"`
	HasNext    bool `json:"has_next"`
	HasPrev    bool `json:"has_prev"`
}

// Person types
type CreatePersonRequest struct {
	PersonType         string                 `json:"person_type" binding:"required"`
	FirstName          string                 `json:"first_name" binding:"required"`
	LastName           string                 `json:"last_name" binding:"required"`
	MiddleName         *string                `json:"middle_name,omitempty"`
	Email              *string                `json:"email,omitempty"`
	Phone              *string                `json:"phone,omitempty"`
	BirthDate          *string                `json:"birth_date,omitempty"`
	NationalID         *string                `json:"national_id,omitempty"`
	TaxID              *string                `json:"tax_id,omitempty"`
	Address            map[string]interface{} `json:"address,omitempty"`
	SecurityAttributes map[string]interface{} `json:"security_attributes,omitempty"`
	Metadata           map[string]interface{} `json:"metadata,omitempty"`
}

type PersonResponse struct {
	ID         string  `json:"id"`
	TenantID   string  `json:"tenant_id"`
	EntityID   string  `json:"entity_id"`
	PersonType string  `json:"person_type"`
	FirstName  string  `json:"first_name"`
	LastName   string  `json:"last_name"`
	MiddleName *string `json:"middle_name,omitempty"`
	Email      string  `json:"email"`
	Phone      *string `json:"phone,omitempty"`
	IsActive   bool    `json:"is_active"`
	CreatedAt  string  `json:"created_at"`
	UpdatedAt  string  `json:"updated_at"`
	DeletedAt  *string `json:"deleted_at,omitempty"`
}

type PersonListResponse struct {
	Data       []PersonResponse   `json:"data"`
	Pagination PaginationResponse `json:"pagination"`
}

// Employee types
type CreateEmployeeRequest struct {
	PersonID         uuid.UUID              `json:"person_id" binding:"required"`
	EmployeeNumber   string                 `json:"employee_number" binding:"required"`
	PositionTitle    *string                `json:"position_title,omitempty"`
	DepartmentID     *uuid.UUID             `json:"department_id,omitempty"`
	ManagerID        *uuid.UUID             `json:"manager_id,omitempty"`
	HireDate         *string                `json:"hire_date" binding:"required"`
	SecurityLevel    int                    `json:"security_level"`
	AccessAttributes map[string]interface{} `json:"access_attributes,omitempty"`
}

type EmployeeResponse struct {
	ID               string  `json:"id"`
	TenantID         string  `json:"tenant_id"`
	PersonID         string  `json:"person_id"`
	EntityID         string  `json:"entity_id"`
	EmployeeNumber   string  `json:"employee_number"`
	PositionTitle    *string `json:"position_title,omitempty"`
	DepartmentID     *string `json:"department_id,omitempty"`
	ManagerID        *string `json:"manager_id,omitempty"`
	HireDate         string  `json:"hire_date"`
	TerminationDate  *string `json:"termination_date,omitempty"`
	EmploymentStatus string  `json:"employment_status"`
	SecurityLevel    int     `json:"security_level"`
	CreatedAt        string  `json:"created_at"`
	UpdatedAt        string  `json:"updated_at"`
}

type EmployeeListResponse struct {
	Data       []EmployeeResponse `json:"data"`
	Pagination PaginationResponse `json:"pagination"`
}

// User types
