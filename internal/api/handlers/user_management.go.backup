// UserManagementHandler handles comprehensive user management operations
// following the new enterprise-grade API design
type UserManagementHandler struct {
	service coreUser.Service
	tracing *tracing.TracingService
	metrics *metrics.MetricsService
}

// NewUserManagementHandler creates a new comprehensive user management handler
func NewUserManagementHandler(service coreUser.Service, tracing *tracing.TracingService, metrics *metrics.MetricsService) *UserManagementHandler {
	return &UserManagementHandler{
		service: service,
		tracing: tracing,
		metrics: metrics,
	}
}

// =============================================================================
// PERSON MANAGEMENT ENDPOINTS
// =============================================================================

// ListPersons handles listing persons with filtering and pagination
func (h *UserManagementHandler) ListPersons(c *gin.Context) {
	ctx := h.tracing.ExtractHTTPHeaders(c.Request.Context(), c.Request.Header)
	
	ctx, span := h.tracing.StartSpan(ctx, "http.list_persons",
		tracing.WithSpanKind(tracing.SpanKindServer),
		tracing.WithAttributes(
			attribute.String("http.method", c.Request.Method),
			attribute.String("http.url", c.Request.URL.String()),
		))
	defer span.End()
	
	timer := h.metrics.Timer("http_request_duration", metrics.Fields{
		"method":   c.Request.Method,
		"endpoint": "/api/v1/persons",
	})
	defer timer.Stop()
	
	// Parse query parameters
	page := h.parseIntParam(c, "page", 1)
	perPage := h.parseIntParam(c, "per_page", 20)
	personType := c.Query("person_type")
	isActiveStr := c.Query("is_active")
	search := c.Query("search")
	
	var isActive *bool
	if isActiveStr != "" {
		if active, err := strconv.ParseBool(isActiveStr); err == nil {
			isActive = &active
		}
	}
	
	// Extract tenant and entity from headers
	tenantID := c.GetHeader("X-Tenant-ID")
	entityID := c.GetHeader("X-Entity-ID")
	
	if tenantID == "" || entityID == "" {
		c.JSON(http.StatusBadRequest, ErrorResponse{
			Error: "Missing required headers: X-Tenant-ID and X-Entity-ID",
			Code:  "MISSING_HEADERS",
		})
		return
	}
	
	// Add parameters to span
	span.SetAttributes(
		attribute.Int("query.page", page),
		attribute.Int("query.per_page", perPage),
		attribute.String("query.person_type", personType),
		attribute.String("query.search", search),
	)
	
	// Build service request
	req := &coreUser.ListPersonsRequest{
		Page:       page,
		PerPage:    perPage,
		PersonType: &personType,
		IsActive:   isActive,
		Search:     &search,
		TenantID:   tenantID,
		EntityID:   entityID,
	}
	
	// Call service layer
	persons, total, err := h.service.ListPersons(ctx, req)
	if err != nil {
		h.handleError(c, ctx, err, "Failed to list persons")
		return
	}
	
	// Convert to response format
	personResponses := make([]PersonResponse, len(persons))
	for i, person := range persons {
		personResponses[i] = h.convertPersonToResponse(person)
	}
	
	// Success metrics
	h.metrics.IncrementCounter("http_requests_total", metrics.Fields{
		"method":   c.Request.Method,
		"endpoint": "/api/v1/persons",
		"status":   "success",
	})
	
	// Success response
	c.JSON(http.StatusOK, PersonListResponse{
		Data:       personResponses,
		Pagination: h.buildPaginationResponse(page, perPage, total),
	})
}

// CreatePerson handles creating a new person entity
func (h *UserManagementHandler) CreatePerson(c *gin.Context) {
	ctx := h.tracing.ExtractHTTPHeaders(c.Request.Context(), c.Request.Header)
	
	ctx, span := h.tracing.StartSpan(ctx, "http.create_person",
		tracing.WithSpanKind(tracing.SpanKindServer))
	defer span.End()
	
	timer := h.metrics.Timer("http_request_duration", metrics.Fields{
		"method":   c.Request.Method,
		"endpoint": "/api/v1/persons",
	})
	defer timer.Stop()
	
	// Parse and validate request
	var req CreatePersonRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		h.handleValidationError(c, ctx, err)
		return
	}
	
	// Extract tenant and entity from headers
	tenantID := c.GetHeader("X-Tenant-ID")
	entityID := c.GetHeader("X-Entity-ID")
	
	if tenantID == "" || entityID == "" {
		c.JSON(http.StatusBadRequest, ErrorResponse{
			Error: "Missing required headers: X-Tenant-ID and X-Entity-ID",
			Code:  "MISSING_HEADERS",
		})
		return
	}
	
	// Convert to service request
	serviceReq := &coreUser.CreatePersonRequest{
		TenantID:           tenantID,
		EntityID:           entityID,
		PersonType:         req.PersonType,
		FirstName:          req.FirstName,
		LastName:           req.LastName,
		MiddleName:         req.MiddleName,
		Email:              req.Email,
		Phone:              req.Phone,
		BirthDate:          h.parseDate(req.BirthDate),
		NationalID:         req.NationalID,
		TaxID:              req.TaxID,
		Address:            req.Address,
		SecurityAttributes: req.SecurityAttributes,
		Metadata:           req.Metadata,
	}
	
	// Call service layer
	person, err := h.service.CreatePerson(ctx, serviceReq)
	if err != nil {
		h.handleError(c, ctx, err, "Failed to create person")
		return
	}
	
	// Success metrics
	h.metrics.IncrementCounter("http_requests_total", metrics.Fields{
		"method":   c.Request.Method,
		"endpoint": "/api/v1/persons",
		"status":   "success",
	})
	
	// Success response
	c.JSON(http.StatusCreated, h.convertPersonToResponse(person))
}

// GetPerson handles retrieving a person by ID
func (h *UserManagementHandler) GetPerson(c *gin.Context) {
	ctx := h.tracing.ExtractHTTPHeaders(c.Request.Context(), c.Request.Header)
	
	ctx, span := h.tracing.StartSpan(ctx, "http.get_person",
		tracing.WithSpanKind(tracing.SpanKindServer))
	defer span.End()
	
	timer := h.metrics.Timer("http_request_duration", metrics.Fields{
		"method":   c.Request.Method,
		"endpoint": "/api/v1/persons/{id}",
	})
	defer timer.Stop()
	
	// Get person ID from path
	personIDStr := c.Param("person_id")
	personID, err := uuid.Parse(personIDStr)
	if err != nil {
		h.handleValidationError(c, ctx, err)
		return
	}
	
	// Extract tenant from headers
	tenantID := c.GetHeader("X-Tenant-ID")
	if tenantID == "" {
		c.JSON(http.StatusBadRequest, ErrorResponse{
			Error: "Missing required header: X-Tenant-ID",
			Code:  "MISSING_HEADERS",
		})
		return
	}
	
	span.SetAttributes(attribute.String("person.id", personID.String()))
	
	// Call service layer
	person, err := h.service.GetPersonByID(ctx, personID)
	if err != nil {
		h.handleError(c, ctx, err, "Failed to get person")
		return
	}
	
	// Success metrics
	h.metrics.IncrementCounter("http_requests_total", metrics.Fields{
		"method":   c.Request.Method,
		"endpoint": "/api/v1/persons/{id}",
		"status":   "success",
	})
	
	// Success response
	c.JSON(http.StatusOK, h.convertPersonToResponse(person))
}

