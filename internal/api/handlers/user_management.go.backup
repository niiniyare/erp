// ListEmployees handles listing employees with filtering and pagination
func (h *UserManagementHandler) ListEmployees(c *gin.Context) {
	ctx := h.tracing.ExtractHTTPHeaders(c.Request.Context(), c.Request.Header)
	
	ctx, span := h.tracing.StartSpan(ctx, "http.list_employees",
		tracing.WithSpanKind(tracing.SpanKindServer))
	defer span.End()
	
	timer := h.metrics.Timer("http_request_duration", metrics.Fields{
		"method":   c.Request.Method,
		"endpoint": "/api/v1/employees",
	})
	defer timer.Stop()
	
	// Parse query parameters
	page := h.parseIntParam(c, "page", 1)
	perPage := h.parseIntParam(c, "per_page", 20)
	employmentStatus := c.Query("employment_status")
	departmentID := c.Query("department_id")
	search := c.Query("search")
	
	// Extract tenant and entity from headers
	tenantID := c.GetHeader("X-Tenant-ID")
	entityID := c.GetHeader("X-Entity-ID")
	
	if tenantID == "" || entityID == "" {
		c.JSON(http.StatusBadRequest, ErrorResponse{
			Error: "Missing required headers: X-Tenant-ID and X-Entity-ID",
			Code:  "MISSING_HEADERS",
		})
		return
	}
	
	// Build service request
	req := &coreUser.ListEmployeesRequest{
		Page:             page,
		PerPage:          perPage,
		EmploymentStatus: &employmentStatus,
		DepartmentID:     h.parseUUID(departmentID),
		Search:           &search,
		TenantID:         tenantID,
		EntityID:         entityID,
	}
	
	// Call service layer
	employees, total, err := h.service.ListEmployees(ctx, req)
	if err != nil {
		h.handleError(c, ctx, err, "Failed to list employees")
		return
	}
	
	// Convert to response format
	employeeResponses := make([]EmployeeResponse, len(employees))
	for i, employee := range employees {
		employeeResponses[i] = h.convertEmployeeToResponse(employee)
	}
	
	// Success response
	c.JSON(http.StatusOK, EmployeeListResponse{
		Data:       employeeResponses,
		Pagination: h.buildPaginationResponse(page, perPage, total),
	})
}

