// Integration tests
func TestAdminAdvancedService_DelegatedMethods(t *testing.T) {
	mockAdmin := &mockAdminService{}
	mockEngine := &mockAdvancedEvaluationEngine{}
	mockConditionalAccess := &mockConditionalAccessService{}
	
	service := NewAdminAdvancedService(
		mockAdmin,
		mockEngine,
		mockConditionalAccess,
		&mockLogger{},
		&mockMetrics{},
		&mockTracing{},
	)

	ctx := context.Background()

	t.Run("BulkEnableFlags delegates correctly", func(t *testing.T) {
		request := &BulkEnableFlagsRequest{
			TenantID: uuid.New(),
			FlagIDs:  []uuid.UUID{uuid.New(), uuid.New()},
		}

		expectedResult := &BulkOperationResult{
			Success:     true,
			ProcessedCount: 2,
			FailedCount: 0,
		}

		mockAdmin.On("BulkEnableFlags", ctx, request).
			Return(expectedResult, nil)

		result, err := service.BulkEnableFlags(ctx, request)

		require.NoError(t, err)
		assert.Equal(t, expectedResult, result)
		mockAdmin.AssertExpectations(t)
	})

	t.Run("BulkDisableFlags delegates correctly", func(t *testing.T) {
		request := &BulkDisableFlagsRequest{
			TenantID: uuid.New(),
			FlagIDs:  []uuid.UUID{uuid.New(), uuid.New()},
		}

		expectedResult := &BulkOperationResult{
			Success:     true,
			ProcessedCount: 2,
			FailedCount: 0,
		}

		mockAdmin.On("BulkDisableFlags", ctx, request).
			Return(expectedResult, nil)

		result, err := service.BulkDisableFlags(ctx, request)

		require.NoError(t, err)
		assert.Equal(t, expectedResult, result)
		mockAdmin.AssertExpectations(t)
	})

	t.Run("GetSystemHealth delegates correctly", func(t *testing.T) {
		expectedResult := &SystemHealthResult{
			Status:     "healthy",
			Components: map[string]string{"database": "ok", "cache": "ok"},
		}

		mockAdmin.On("GetSystemHealth", ctx).
			Return(expectedResult, nil)

		result, err := service.GetSystemHealth(ctx)

		require.NoError(t, err)
		assert.Equal(t, expectedResult, result)
		mockAdmin.AssertExpectations(t)
	})
}