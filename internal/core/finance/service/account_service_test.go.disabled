// Test Setup
func setupAccountServiceTest(t *testing.T) *AccountServiceTestSuite {
	suite := &AccountServiceTestSuite{
		mockRepo:         new(MockAccountsRepository),
		mockIAMService:   new(MockIAMService),
		mockAuthzService: new(MockAuthzService),
		mockFFService:    new(MockFeatureFlagService),
		mockTracing:      new(MockTracingService),
		mockMetrics:      new(MockMetricsProvider),
		tenantID:         uuid.New(),
		userID:           uuid.New(),
		entityID:         uuid.New(),
	}

	// Set up context with tenant and user
	suite.ctx = context.Background()
	suite.ctx = context.WithValue(suite.ctx, shared.TenantIDKey, suite.tenantID)
	suite.ctx = context.WithValue(suite.ctx, shared.UserIDKey, suite.userID)

	// Set up IAM service to return authz service
	suite.mockIAMService.On("Authorization").Return(suite.mockAuthzService)

	// Create the account service
	suite.accountService = NewAccountService(
		suite.mockRepo,
		suite.mockTracing,
		suite.mockMetrics,
		suite.mockIAMService,
		suite.mockFFService,
	)

	return suite
}

// Helper function to create a valid account request
func createValidAccountRequest(entityID uuid.UUID) domain.CreateAccountRequest {
	return domain.CreateAccountRequest{
		EntityID:        &entityID,
		AccountCode:     "1000",
		AccountName:     "Test Account",
		AccountType:     domain.AccountTypeCurrentAsset,
		RootType:        domain.RootTypeAsset,
		NormalBalance:   domain.NormalBalanceDebit,
		IsActive:        true,
		CurrencyCode:    nil, // Will be set by service
	}
}

// Helper function to create a test account
func createTestAccount(id uuid.UUID, entityID uuid.UUID) *domain.Accounts {
	currency := "USD"
	return &domain.Accounts{
		ID:               id,
		EntityID:         &entityID,
		AccountCode:      "1000",
		AccountName:      "Test Account",
		AccountType:      domain.AccountTypeCurrentAsset,
		RootType:         domain.RootTypeAsset,
		NormalBalance:    domain.NormalBalanceDebit,
		IsActive:         true,
		IsSystemAccount:  false,
		CurrencyCode:     &currency,
		CreatedAt:        time.Now(),
		UpdatedAt:        time.Now(),
	}
}