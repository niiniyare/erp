// TestAccountService_SearchAccounts_Enhanced_Basic tests enhanced search functionality
func TestAccountService_SearchAccounts_Enhanced_Basic(t *testing.T) {
	suite := setupAccountServiceTest(t)

	// Set up permission check - Allow
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 7,
		CacheHit:         false,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, mock.AnythingOfType("*authz.PermissionEvaluationRequest")).Return(permissionResult, nil)

	// Set up feature flag - Enhanced search enabled
	suite.mockFFService.On("IsEnabled", suite.ctx, "enhanced_account_search", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(true, nil)

	// Set up repository call - enhanced search allows higher limits (500 vs 200)
	testAccounts := []*domain.Accounts{
		createTestAccount(uuid.New(), suite.entityID),
		createTestAccount(uuid.New(), suite.entityID),
	}
	// When enhanced search is enabled, limit of 300 should be allowed (up to 500)
	suite.mockRepo.On("Search", suite.ctx, "test", 300).Return(testAccounts, nil)

	// Execute test with high limit
	result, err := suite.accountService.SearchAccounts(suite.ctx, "test", 300)

	// Assertions
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Len(t, result, 2)

	// Verify mocks
	suite.mockAuthzService.AssertExpectations(t)
	suite.mockFFService.AssertExpectations(t)
	suite.mockRepo.AssertExpectations(t)
}

// TestAccountService_NoUserContext_Basic tests behavior without user context
func TestAccountService_NoUserContext_Basic(t *testing.T) {
	suite := setupAccountServiceTest(t)
	
	// Use context without user ID
	ctxNoUser := context.Background()
	ctxNoUser = context.WithValue(ctxNoUser, shared.TenantIDKey, suite.tenantID)

	// Set up feature flag
	suite.mockFFService.On("IsEnabled", ctxNoUser, "enhanced_account_validation", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(false, nil)

	// Set up repository calls
	suite.mockRepo.On("ValidateAccountCode", ctxNoUser, "1000", (*uuid.UUID)(nil)).Return(nil)
	suite.mockRepo.On("Create", ctxNoUser, mock.AnythingOfType("*domain.Accounts")).Return(nil)
	testAccount := createTestAccount(uuid.New(), suite.entityID)
	suite.mockRepo.On("GetByCode", ctxNoUser, &suite.entityID, "1000").Return(testAccount, nil)
	suite.mockMetrics.On("IncrementCounter", mock.AnythingOfType("string"), mock.AnythingOfType("metrics.Fields"))
	suite.mockMetrics.On("ObserveHistogram", mock.AnythingOfType("string"), mock.AnythingOfType("float64"), mock.AnythingOfType("metrics.Fields"))

	// Execute test
	req := createValidAccountRequest(suite.entityID)
	result, err := suite.accountService.CreateAccount(ctxNoUser, req)

	// Assertions - should succeed without ABAC check
	require.NoError(t, err)
	require.NotNil(t, result)

	// ABAC service should not have been called
	suite.mockAuthzService.AssertNotCalled(t, "EvaluatePermission")
}

// TestAccountService_Integration_AllLayers tests all integration layers working together
func TestAccountService_Integration_AllLayers(t *testing.T) {
	suite := setupAccountServiceTest(t)

	// Set up permission check - Allow (ABAC layer)
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 10,
		CacheHit:         false,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, mock.AnythingOfType("*authz.PermissionEvaluationRequest")).Return(permissionResult, nil)

	// Set up feature flag - Enhanced validation enabled (Feature Flag layer)
	suite.mockFFService.On("IsEnabled", suite.ctx, "enhanced_account_validation", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(true, nil)

	// Set up repository calls (valid code, long enough for enhanced validation)
	suite.mockRepo.On("ValidateAccountCode", suite.ctx, "1000", (*uuid.UUID)(nil)).Return(nil)
	suite.mockRepo.On("Create", suite.ctx, mock.AnythingOfType("*domain.Accounts")).Return(nil)
	testAccount := createTestAccount(uuid.New(), suite.entityID)
	suite.mockRepo.On("GetByCode", suite.ctx, &suite.entityID, "1000").Return(testAccount, nil)
	suite.mockMetrics.On("IncrementCounter", mock.AnythingOfType("string"), mock.AnythingOfType("metrics.Fields"))
	suite.mockMetrics.On("ObserveHistogram", mock.AnythingOfType("string"), mock.AnythingOfType("float64"), mock.AnythingOfType("metrics.Fields"))

	// Execute test with valid request (Settings layer provides defaults)
	req := createValidAccountRequest(suite.entityID)
	req.AccountCode = "1000" // Valid length for enhanced validation
	result, err := suite.accountService.CreateAccount(suite.ctx, req)

	// Assertions - all layers should work together
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Equal(t, "1000", result.AccountCode)
	assert.Equal(t, "USD", *result.CurrencyCode) // Default from Settings layer

	// Verify all layers were involved
	suite.mockAuthzService.AssertExpectations(t) // ABAC
	suite.mockFFService.AssertExpectations(t)     // Feature Flags
	suite.mockRepo.AssertExpectations(t)          // Repository
	// Settings layer is handled by helper without mocks
}