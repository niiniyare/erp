// =============================================================================
// PERMISSION EVALUATION ERROR TESTS
// =============================================================================

func TestAccountService_CreateAccount_PermissionEvaluationError(t *testing.T) {
	suite := setupAccountServiceTest(t)

	// Set up permission check - Error
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, mock.AnythingOfType("*authz.PermissionEvaluationRequest")).Return((*authz.PermissionEvaluationResult)(nil), stdErrors.New("ABAC service unavailable"))

	// Execute test
	req := createValidAccountRequest(suite.entityID)
	result, err := suite.accountService.CreateAccount(suite.ctx, req)

	// Assertions
	require.Error(t, err)
	require.Nil(t, result)
	
	// Check error type through string content
	assert.Equal(t, "PERMISSION_ERROR", busErr.Code)
	assert.Contains(t, busErr.Message, "Failed to evaluate permissions")

	// Verify mock calls
	suite.mockAuthzService.AssertExpectations(t)
	suite.mockRepo.AssertNotCalled(t, "Create")
}

func TestAccountService_UpdateAccount_PermissionEvaluationTimeout(t *testing.T) {
	suite := setupAccountServiceTest(t)
	accountID := uuid.New()

	// Set up permission check - Timeout error
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, mock.AnythingOfType("*authz.PermissionEvaluationRequest")).Return((*authz.PermissionEvaluationResult)(nil), context.DeadlineExceeded)

	// Execute test
	req := domain.UpdateAccountRequest{
		AccountName: testStringPtr("Updated Name"),
	}
	result, err := suite.accountService.UpdateAccount(suite.ctx, accountID, req)

	// Assertions
	require.Error(t, err)
	require.Nil(t, result)
	
	// Check error type through string content
	assert.Equal(t, "UNAUTHORIZED", busErr.Code)

	// Verify mock calls
	suite.mockAuthzService.AssertExpectations(t)
	suite.mockRepo.AssertNotCalled(t, "Update")
}

// =============================================================================
// FEATURE FLAG EVALUATION ERROR TESTS
// =============================================================================

func TestAccountService_CreateAccount_FeatureFlagError(t *testing.T) {
	suite := setupAccountServiceTest(t)

	// Set up permission check - Allow
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 10,
		CacheHit:         false,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, mock.AnythingOfType("*authz.PermissionEvaluationRequest")).Return(permissionResult, nil)

	// Set up feature flag - Error (should fallback gracefully)
	suite.mockFFService.On("IsEnabled", suite.ctx, "enhanced_account_validation", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(false, stdErrors.New("feature flag service unavailable"))

	// Set up repository calls (should still proceed)
	suite.mockRepo.On("ValidateAccountCode", suite.ctx, "1000", (*uuid.UUID)(nil)).Return(nil)
	suite.mockRepo.On("Create", suite.ctx, mock.AnythingOfType("*domain.Accounts")).Return(nil)
	testAccount := createTestAccount(uuid.New(), suite.entityID)
	suite.mockRepo.On("GetByCode", suite.ctx, &suite.entityID, "1000").Return(testAccount, nil)
	suite.mockMetrics.On("IncrementCounter", mock.AnythingOfType("string"), mock.AnythingOfType("metrics.Fields"))
	suite.mockMetrics.On("ObserveHistogram", mock.AnythingOfType("string"), mock.AnythingOfType("float64"), mock.AnythingOfType("metrics.Fields"))

	// Execute test
	req := createValidAccountRequest(suite.entityID)
	result, err := suite.accountService.CreateAccount(suite.ctx, req)

	// Assertions - should succeed despite feature flag error
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Equal(t, "1000", result.AccountCode)

	// Verify all mock calls
	suite.mockAuthzService.AssertExpectations(t)
	suite.mockFFService.AssertExpectations(t)
	suite.mockRepo.AssertExpectations(t)
}

func TestAccountService_DeleteAccount_FeatureFlagTimeout(t *testing.T) {
	suite := setupAccountServiceTest(t)
	accountID := uuid.New()

	// Set up permission check - Allow
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 8,
		CacheHit:         false,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, mock.AnythingOfType("*authz.PermissionEvaluationRequest")).Return(permissionResult, nil)

	// Set up feature flag - Timeout (should fallback to false)
	suite.mockFFService.On("IsEnabled", suite.ctx, "enhanced_account_deletion", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(false, context.DeadlineExceeded)

	// Set up repository calls
	account := createTestAccount(accountID, suite.entityID)
	account.IsSystemAccount = false
	suite.mockRepo.On("GetByID", suite.ctx, accountID).Return(account, nil)
	suite.mockRepo.On("HasTransactions", suite.ctx, accountID).Return(false, nil)
	suite.mockRepo.On("GetChildren", suite.ctx, accountID).Return([]*domain.Accounts{}, nil)
	suite.mockRepo.On("Delete", suite.ctx, accountID).Return(nil)
	suite.mockMetrics.On("IncrementCounter", "accounts_deleted_total", mock.AnythingOfType("metrics.Fields"))
	suite.mockMetrics.On("ObserveHistogram", "account_deletion_duration", mock.AnythingOfType("float64"), mock.AnythingOfType("metrics.Fields"))

	// Execute test
	err := suite.accountService.DeleteAccount(suite.ctx, accountID)

	// Assertions - should succeed without enhanced checks
	require.NoError(t, err)

	// Verify mocks
	suite.mockFFService.AssertExpectations(t)
	suite.mockRepo.AssertExpectations(t)
}

