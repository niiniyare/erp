func TestAccountService_ListAccounts_ZeroLimit(t *testing.T) {
	suite := setupAccountServiceTest(t)

	// Set up user permissions
	userPermissions := &authz.UserEffectivePermissions{
		UserID: suite.userID,
		Permissions: map[string][]string{
			"account": {"read", "list"},
		},
		Roles:     []string{"accountant"},
		Timestamp: time.Now(),
	}
	suite.mockAuthzService.On("GetUserEffectivePermissions", suite.ctx, suite.userID, (*uuid.UUID)(nil)).Return(userPermissions, nil)

	// Set up feature flag
	suite.mockFFService.On("IsEnabled", suite.ctx, "enhanced_account_listing", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(false, nil)

	// Set up repository call - limit should be adjusted to 50
	expectedFilter := mock.MatchedBy(func(filter *domain.AccountFilter) bool {
		return filter.Limit != nil && *filter.Limit == 50
	})
	suite.mockRepo.On("List", suite.ctx, expectedFilter).Return([]*domain.Accounts{}, nil)
	suite.mockMetrics.On("IncrementCounter", "account_list_requests_total", mock.AnythingOfType("metrics.Fields"))
	suite.mockMetrics.On("ObserveHistogram", "account_list_duration", mock.AnythingOfType("float64"), mock.AnythingOfType("metrics.Fields"))

	// Execute test with zero limit
	zeroLimit := 0
	filter := &domain.AccountFilter{
		Limit: &zeroLimit,
	}

	result, err := suite.accountService.ListAccounts(suite.ctx, filter)

	// Assertions
	require.NoError(t, err)
	require.NotNil(t, result)

	// Verify mocks
	suite.mockRepo.AssertExpectations(t)
}

// =============================================================================
// CONCURRENT ACCESS TESTS
// =============================================================================

func TestAccountService_CreateAccount_ConcurrentAccess(t *testing.T) {
	suite := setupAccountServiceTest(t)

	// Set up permission check - Allow
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 5,
		CacheHit:         true,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", mock.Anything, mock.Anything).Return(permissionResult, nil).Maybe()

	// Set up feature flag
	suite.mockFFService.On("IsEnabled", mock.Anything, mock.Anything, mock.Anything).Return(false, nil).Maybe()

	// Set up repository calls
	suite.mockRepo.On("ValidateAccountCode", mock.Anything, mock.Anything, mock.Anything).Return(nil).Maybe()
	suite.mockRepo.On("Create", mock.Anything, mock.Anything).Return(nil).Maybe()
	testAccount := createTestAccount(uuid.New(), suite.entityID)
	suite.mockRepo.On("GetByCode", mock.Anything, mock.Anything, mock.Anything).Return(testAccount, nil).Maybe()
	suite.mockMetrics.On("IncrementCounter", mock.Anything, mock.Anything).Maybe()
	suite.mockMetrics.On("ObserveHistogram", mock.Anything, mock.Anything, mock.Anything).Maybe()

	// Execute concurrent operations
	const numGoroutines = 10
	results := make(chan error, numGoroutines)

	for i := 0; i < numGoroutines; i++ {
		go func(index int) {
			req := createValidAccountRequest(suite.entityID)
			req.AccountCode = "CONCURRENT" + uuid.New().String()[:6]
			_, err := suite.accountService.CreateAccount(suite.ctx, req)
			results <- err
		}(i)
	}

	// Collect results
	var errors []error
	for i := 0; i < numGoroutines; i++ {
		if err := <-results; err != nil {
			errors = append(errors, err)
		}
	}

	// Assertions - should handle concurrent access gracefully
	assert.Len(t, errors, 0, "No errors expected from concurrent access")
}