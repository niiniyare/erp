func TestAccountService_DeleteAccount_AccountHasTransactions(t *testing.T) {
	suite := setupAccountServiceTest(t)
	accountID := uuid.New()

	// Set up permission check - Allow
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 8,
		CacheHit:         false,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, mock.AnythingOfType("*authz.PermissionEvaluationRequest")).Return(permissionResult, nil)

	// Set up feature flag
	suite.mockFFService.On("IsEnabled", suite.ctx, "enhanced_account_deletion", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(false, nil)

	// Set up repository calls
	account := createTestAccount(accountID, suite.entityID)
	account.IsSystemAccount = false
	suite.mockRepo.On("GetByID", suite.ctx, accountID).Return(account, nil)
	suite.mockRepo.On("HasTransactions", suite.ctx, accountID).Return(true, nil) // Has transactions
	suite.mockMetrics.On("IncrementCounter", "account_deletion_errors", mock.AnythingOfType("metrics.Fields"))

	// Execute test
	err := suite.accountService.DeleteAccount(suite.ctx, accountID)

	// Assertions
	require.Error(t, err)
	
	// Check error type through string content
	assert.Equal(t, "HAS_TRANSACTIONS", busErr.Code)
	assert.Contains(t, busErr.Message, "Cannot delete account with existing transactions")

	// Verify mocks
	suite.mockRepo.AssertExpectations(t)
	suite.mockRepo.AssertNotCalled(t, "Delete")
}

func TestAccountService_DeleteAccount_AccountHasChildren(t *testing.T) {
	suite := setupAccountServiceTest(t)
	accountID := uuid.New()

	// Set up permission check - Allow
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 8,
		CacheHit:         false,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, mock.AnythingOfType("*authz.PermissionEvaluationRequest")).Return(permissionResult, nil)

	// Set up feature flag
	suite.mockFFService.On("IsEnabled", suite.ctx, "enhanced_account_deletion", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(false, nil)

	// Set up repository calls
	account := createTestAccount(accountID, suite.entityID)
	account.IsSystemAccount = false
	suite.mockRepo.On("GetByID", suite.ctx, accountID).Return(account, nil)
	suite.mockRepo.On("HasTransactions", suite.ctx, accountID).Return(false, nil)
	
	// Has child accounts
	childAccounts := []*domain.Accounts{
		createTestAccount(uuid.New(), suite.entityID),
	}
	suite.mockRepo.On("GetChildren", suite.ctx, accountID).Return(childAccounts, nil)
	suite.mockMetrics.On("IncrementCounter", "account_deletion_errors", mock.AnythingOfType("metrics.Fields"))

	// Execute test
	err := suite.accountService.DeleteAccount(suite.ctx, accountID)

	// Assertions
	require.Error(t, err)
	
	// Check error type through string content
	assert.Equal(t, "HAS_CHILDREN", busErr.Code)
	assert.Contains(t, busErr.Message, "Cannot delete account with child accounts")

	// Verify mocks
	suite.mockRepo.AssertExpectations(t)
	suite.mockRepo.AssertNotCalled(t, "Delete")
}

