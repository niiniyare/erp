// =============================================================================
// BENCHMARK HELPER FUNCTIONS
// =============================================================================

func setupAccountServiceTestForBenchmark(b *testing.B) *AccountServiceTestSuite {
	b.Helper()
	
	suite := &AccountServiceTestSuite{
		mockRepo:         new(MockAccountsRepository),
		mockIAMService:   new(MockIAMService),
		mockAuthzService: new(MockAuthzService),
		mockFFService:    new(MockFeatureFlagService),
		mockTracing:      new(MockTracingService),
		mockMetrics:      new(MockMetricsProvider),
		tenantID:         uuid.New(),
		userID:           uuid.New(),
		entityID:         uuid.New(),
	}

	// Set up context with tenant and user
	suite.ctx = context.Background()
	suite.ctx = context.WithValue(suite.ctx, shared.TenantIDKey, suite.tenantID)
	suite.ctx = context.WithValue(suite.ctx, shared.UserIDKey, suite.userID)

	// Set up IAM service to return authz service
	suite.mockIAMService.On("Authorization").Return(suite.mockAuthzService)

	// Create the account service
	suite.accountService = NewAccountService(
		suite.mockRepo,
		suite.mockTracing,
		suite.mockMetrics,
		suite.mockIAMService,
		suite.mockFFService,
	)

	return suite
}

// =============================================================================
// COMPARATIVE BENCHMARKS
// =============================================================================

func BenchmarkAccountService_CreateAccount_WithIntegration(b *testing.B) {
	suite := setupAccountServiceTestForBenchmark(b)

	// Full integration (ABAC + Feature Flags + Settings)
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 5,
		CacheHit:         false,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", mock.Anything, mock.Anything).Return(permissionResult, nil)
	suite.mockFFService.On("IsEnabled", mock.Anything, mock.Anything, mock.Anything).Return(false, nil)
	suite.mockRepo.On("ValidateAccountCode", mock.Anything, mock.Anything, mock.Anything).Return(nil)
	suite.mockRepo.On("Create", mock.Anything, mock.Anything).Return(nil)
	testAccount := createTestAccount(uuid.New(), suite.entityID)
	suite.mockRepo.On("GetByCode", mock.Anything, mock.Anything, mock.Anything).Return(testAccount, nil)
	suite.mockMetrics.On("IncrementCounter", mock.Anything, mock.Anything).Maybe()
	suite.mockMetrics.On("ObserveHistogram", mock.Anything, mock.Anything, mock.Anything).Maybe()

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		req := createValidAccountRequest(suite.entityID)
		req.AccountCode = "INT" + uuid.New().String()[:8]
		_, err := suite.accountService.CreateAccount(suite.ctx, req)
		if err != nil {
			b.Fatalf("CreateAccount failed: %v", err)
		}
	}
}

