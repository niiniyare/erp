// =============================================================================
// BENCHMARK TESTS
// =============================================================================

func BenchmarkAccountService_CreateAccount(b *testing.B) {
	suite := setupAccountServiceTestForBenchmark(b)

	// Set up common mocks for all iterations
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 5,
		CacheHit:         true,
		Timestamp:        time.Now(),
	}

	// Use mock.Anything to handle multiple calls
	suite.mockAuthzService.On("EvaluatePermission", mock.Anything, mock.Anything).Return(permissionResult, nil)
	suite.mockFFService.On("IsEnabled", mock.Anything, mock.Anything, mock.Anything).Return(false, nil)
	suite.mockRepo.On("ValidateAccountCode", mock.Anything, mock.Anything, mock.Anything).Return(nil)
	suite.mockRepo.On("Create", mock.Anything, mock.Anything).Return(nil)

	// Pre-create test accounts for GetByCode calls
	testAccount := createTestAccount(uuid.New(), suite.entityID)
	suite.mockRepo.On("GetByCode", mock.Anything, mock.Anything, mock.Anything).Return(testAccount, nil)

	// Ignore metrics for benchmark
	suite.mockMetrics.On("IncrementCounter", mock.Anything, mock.Anything).Maybe()
	suite.mockMetrics.On("ObserveHistogram", mock.Anything, mock.Anything, mock.Anything).Maybe()

	b.ResetTimer()
	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			req := domain.CreateAccountRequest{
				EntityID:      &suite.entityID,
				AccountCode:   "BENCH" + uuid.New().String()[:8],
				AccountName:   "Benchmark Account",
				AccountType:   domain.AccountTypeCurrentAsset,
				RootType:      domain.RootTypeAsset,
				NormalBalance: domain.NormalBalanceDebit,
				IsActive:      true,
			}

			_, err := suite.accountService.CreateAccount(suite.ctx, req)
			if err != nil {
				b.Fatalf("CreateAccount failed: %v", err)
			}
		}
	})
}

