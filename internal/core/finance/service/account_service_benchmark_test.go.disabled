func BenchmarkAccountService_ListAccounts_WithPermissions(b *testing.B) {
	suite := setupAccountServiceTestForBenchmark(b)

	// Set up user permissions
	userPermissions := &authz.UserEffectivePermissions{
		UserID: suite.userID,
		Permissions: map[string][]string{
			"account": {"read", "list"},
		},
		Roles:     []string{"accountant"},
		Timestamp: time.Now(),
	}
	suite.mockAuthzService.On("GetUserEffectivePermissions", mock.Anything, suite.userID, mock.Anything).Return(userPermissions, nil)

	// Set up feature flag
	suite.mockFFService.On("IsEnabled", mock.Anything, "enhanced_account_listing", mock.Anything).Return(false, nil)

	// Set up repository call
	testAccounts := []*domain.Accounts{
		createTestAccount(uuid.New(), suite.entityID),
		createTestAccount(uuid.New(), suite.entityID),
	}
	suite.mockRepo.On("List", mock.Anything, mock.Anything).Return(testAccounts, nil)
	suite.mockMetrics.On("IncrementCounter", mock.Anything, mock.Anything).Maybe()
	suite.mockMetrics.On("ObserveHistogram", mock.Anything, mock.Anything, mock.Anything).Maybe()

	b.ResetTimer()
	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			limit := 50
			filter := &domain.AccountFilter{
				Limit: &limit,
			}
			_, err := suite.accountService.ListAccounts(suite.ctx, filter)
			if err != nil {
				b.Fatalf("ListAccounts failed: %v", err)
			}
		}
	})
}

