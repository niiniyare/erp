func BenchmarkAccountService_SearchAccounts_Enhanced(b *testing.B) {
	suite := setupAccountServiceTestForBenchmark(b)

	// Set up permission check - Allow
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 2,
		CacheHit:         true,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", mock.Anything, mock.Anything).Return(permissionResult, nil)

	// Set up feature flag - Enhanced search enabled
	suite.mockFFService.On("IsEnabled", mock.Anything, "enhanced_account_search", mock.Anything).Return(true, nil)

	// Set up repository call
	testAccounts := []*domain.Accounts{
		createTestAccount(uuid.New(), suite.entityID),
		createTestAccount(uuid.New(), suite.entityID),
	}
	suite.mockRepo.On("Search", mock.Anything, mock.Anything, mock.Anything).Return(testAccounts, nil)

	b.ResetTimer()
	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			_, err := suite.accountService.SearchAccounts(suite.ctx, "test", 100)
			if err != nil {
				b.Fatalf("SearchAccounts failed: %v", err)
			}
		}
	})
}

