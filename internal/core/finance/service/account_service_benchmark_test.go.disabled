func BenchmarkFeatureFlagEvaluation_Fast(b *testing.B) {
	suite := setupAccountServiceTestForBenchmark(b)

	evalCtx := &featureflag.EvaluationContext{
		TenantID:    suite.tenantID,
		UserID:      &suite.userID,
		Environment: "production",
		Attributes: map[string]string{
			"module": "finance",
		},
	}

	// Fast feature flag evaluation (cached)
	suite.mockFFService.On("IsEnabled", mock.Anything, "enhanced_account_validation", evalCtx).Return(true, nil)

	b.ResetTimer()
	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			_, err := suite.mockFFService.IsEnabled(context.Background(), "enhanced_account_validation", evalCtx)
			if err != nil {
				b.Fatalf("IsEnabled failed: %v", err)
			}
		}
	})
}

