func TestAccountService_UpdateAccount_Success(t *testing.T) {
	suite := setupAccountServiceTest(t)
	accountID := uuid.New()

	// Set up permission check - Allow
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 8,
		CacheHit:         false,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, &authz.PermissionEvaluationRequest{
		UserID:       suite.userID,
		ResourceType: "account",
		ResourceID:   &accountID,
		Action:       "update",
	}).Return(permissionResult, nil)

	// Set up repository calls
	existingAccount := createTestAccount(accountID, suite.entityID)
	suite.mockRepo.On("GetByID", suite.ctx, accountID).Return(existingAccount, nil)
	suite.mockRepo.On("Update", suite.ctx, mock.AnythingOfType("*domain.Accounts")).Return(nil)
	suite.mockMetrics.On("IncrementCounter", "accounts_updated_total", mock.AnythingOfType("metrics.Fields"))
	suite.mockMetrics.On("ObserveHistogram", "account_update_duration", mock.AnythingOfType("float64"), mock.AnythingOfType("metrics.Fields"))

	// Execute test
	newName := "Updated Account Name"
	req := domain.UpdateAccountRequest{
		AccountName: &newName,
	}

	result, err := suite.accountService.UpdateAccount(suite.ctx, accountID, req)

	// Assertions
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Equal(t, "Updated Account Name", result.AccountName)

	// Verify all mocks
	suite.mockAuthzService.AssertExpectations(t)
	suite.mockRepo.AssertExpectations(t)
	suite.mockMetrics.AssertExpectations(t)
}

