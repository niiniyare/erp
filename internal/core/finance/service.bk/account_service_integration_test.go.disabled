// =============================================================================
// CREATE ACCOUNT TESTS
// =============================================================================

func TestAccountService_CreateAccount_Success(t *testing.T) {
	suite := setupAccountServiceTest(t)

	// Set up permission check - Allow
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 10,
		CacheHit:         false,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, &authz.PermissionEvaluationRequest{
		UserID:       suite.userID,
		ResourceType: "account",
		Action:       "create",
		EntityID:     &suite.entityID,
	}).Return(permissionResult, nil)

	// Set up feature flag - Enhanced validation disabled
	suite.mockFFService.On("IsEnabled", suite.ctx, "enhanced_account_validation", &featureflag.EvaluationContext{
		TenantID:    suite.tenantID,
		UserID:      &suite.userID,
		Environment: "production",
		Attributes: map[string]string{
			"module":        "finance",
			"resource_type": "account",
		},
	}).Return(false, nil)

	// Set up repository calls
	suite.mockRepo.On("ValidateAccountCode", suite.ctx, "1000", (*uuid.UUID)(nil)).Return(nil)
	suite.mockRepo.On("Create", suite.ctx, mock.MatchedBy(func(account *domain.Accounts) bool {
		return account.AccountCode == "1000" && account.AccountName == "Test Account" && *account.CurrencyCode == "USD"
	})).Return(nil)
	
	testAccount := createTestAccount(uuid.New(), suite.entityID)
	suite.mockRepo.On("GetByCode", suite.ctx, &suite.entityID, "1000").Return(testAccount, nil)

	// Set up metrics calls
	suite.mockMetrics.On("IncrementCounter", "accounts_created_total", mock.AnythingOfType("metrics.Fields"))
	suite.mockMetrics.On("ObserveHistogram", "account_creation_duration", mock.AnythingOfType("float64"), mock.AnythingOfType("metrics.Fields"))

	// Execute test
	req := createValidAccountRequest(suite.entityID)
	result, err := suite.accountService.CreateAccount(suite.ctx, req)

	// Assertions
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Equal(t, "1000", result.AccountCode)
	assert.Equal(t, "Test Account", result.AccountName)
	assert.Equal(t, "USD", *result.CurrencyCode)

	// Verify all mock calls
	suite.mockAuthzService.AssertExpectations(t)
	suite.mockFFService.AssertExpectations(t)
	suite.mockRepo.AssertExpectations(t)
	suite.mockMetrics.AssertExpectations(t)
}

func TestAccountService_CreateAccount_PermissionDenied(t *testing.T) {
	suite := setupAccountServiceTest(t)

	// Set up permission check - Deny
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionDeny,
		EvaluationTimeMS: 5,
		CacheHit:         true,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, &authz.PermissionEvaluationRequest{
		UserID:       suite.userID,
		ResourceType: "account",
		Action:       "create",
		EntityID:     &suite.entityID,
	}).Return(permissionResult, nil)

	// Execute test
	req := createValidAccountRequest(suite.entityID)
	result, err := suite.accountService.CreateAccount(suite.ctx, req)

	// Assertions
	require.Error(t, err)
	require.Nil(t, result)
	
	var busErr *errors.BusinessError
	require.True(t, errors.As(err, &busErr))
	assert.Equal(t, "UNAUTHORIZED", busErr.Code)
	assert.Equal(t, "Cannot create account", busErr.Message)

	// Verify mock calls
	suite.mockAuthzService.AssertExpectations(t)
	suite.mockRepo.AssertNotCalled(t, "Create")
}

func TestAccountService_CreateAccount_EnhancedValidation(t *testing.T) {
	suite := setupAccountServiceTest(t)

	// Set up permission check - Allow
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 10,
		CacheHit:         false,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, mock.AnythingOfType("*authz.PermissionEvaluationRequest")).Return(permissionResult, nil)

	// Set up feature flag - Enhanced validation enabled
	suite.mockFFService.On("IsEnabled", suite.ctx, "enhanced_account_validation", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(true, nil)

	// Execute test with short account code (should fail enhanced validation)
	req := createValidAccountRequest(suite.entityID)
	req.AccountCode = "12" // Too short for enhanced validation
	result, err := suite.accountService.CreateAccount(suite.ctx, req)

	// Assertions
	require.Error(t, err)
	require.Nil(t, result)
	
	var busErr *errors.BusinessError
	require.True(t, errors.As(err, &busErr))
	assert.Equal(t, "VALIDATION_ERROR", busErr.Code)
	assert.Contains(t, busErr.Message, "at least 3 characters")

	// Verify mock calls
	suite.mockAuthzService.AssertExpectations(t)
	suite.mockFFService.AssertExpectations(t)
	suite.mockRepo.AssertNotCalled(t, "Create")
}

func TestAccountService_CreateAccount_DefaultCurrency(t *testing.T) {
	suite := setupAccountServiceTest(t)

	// Set up permission check - Allow
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 10,
		CacheHit:         false,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, mock.AnythingOfType("*authz.PermissionEvaluationRequest")).Return(permissionResult, nil)

	// Set up feature flag
	suite.mockFFService.On("IsEnabled", suite.ctx, "enhanced_account_validation", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(false, nil)

	// Set up repository calls
	suite.mockRepo.On("ValidateAccountCode", suite.ctx, "1000", (*uuid.UUID)(nil)).Return(nil)
	suite.mockRepo.On("Create", suite.ctx, mock.MatchedBy(func(account *domain.Accounts) bool {
		// Verify that USD was set as default currency
		return account.CurrencyCode != nil && *account.CurrencyCode == "USD"
	})).Return(nil)
	
	testAccount := createTestAccount(uuid.New(), suite.entityID)
	suite.mockRepo.On("GetByCode", suite.ctx, &suite.entityID, "1000").Return(testAccount, nil)
	suite.mockMetrics.On("IncrementCounter", mock.AnythingOfType("string"), mock.AnythingOfType("metrics.Fields"))
	suite.mockMetrics.On("ObserveHistogram", mock.AnythingOfType("string"), mock.AnythingOfType("float64"), mock.AnythingOfType("metrics.Fields"))

	// Execute test with no currency code
	req := createValidAccountRequest(suite.entityID)
	req.CurrencyCode = nil // Should be set to USD by service

	result, err := suite.accountService.CreateAccount(suite.ctx, req)

	// Assertions
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Equal(t, "USD", *result.CurrencyCode)

	// Verify all mocks
	suite.mockRepo.AssertExpectations(t)
}

