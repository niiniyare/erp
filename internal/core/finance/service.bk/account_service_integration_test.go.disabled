func TestAccountService_SearchAccounts_Success(t *testing.T) {
	suite := setupAccountServiceTest(t)

	// Set up permission check - Allow
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 7,
		CacheHit:         false,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, &authz.PermissionEvaluationRequest{
		UserID:       suite.userID,
		ResourceType: "account",
		Action:       "search",
	}).Return(permissionResult, nil)

	// Set up feature flag - Enhanced search disabled
	suite.mockFFService.On("IsEnabled", suite.ctx, "enhanced_account_search", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(false, nil)

	// Set up repository call
	testAccounts := []*domain.Accounts{
		createTestAccount(uuid.New(), suite.entityID),
	}
	suite.mockRepo.On("Search", suite.ctx, "test", 50).Return(testAccounts, nil)

	// Execute test
	result, err := suite.accountService.SearchAccounts(suite.ctx, "test", 50)

	// Assertions
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Len(t, result, 1)

	// Verify mocks
	suite.mockAuthzService.AssertExpectations(t)
	suite.mockFFService.AssertExpectations(t)
	suite.mockRepo.AssertExpectations(t)
}

func TestAccountService_SearchAccounts_EnhancedSearch(t *testing.T) {
	suite := setupAccountServiceTest(t)

	// Set up permission check - Allow
	permissionResult := &authz.PermissionEvaluationResult{
		Decision:         model.PolicyDecisionAllow,
		EvaluationTimeMS: 9,
		CacheHit:         false,
		Timestamp:        time.Now(),
	}
	suite.mockAuthzService.On("EvaluatePermission", suite.ctx, mock.AnythingOfType("*authz.PermissionEvaluationRequest")).Return(permissionResult, nil)

	// Set up feature flag - Enhanced search enabled
	suite.mockFFService.On("IsEnabled", suite.ctx, "enhanced_account_search", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(true, nil)

	// Set up repository call - enhanced search allows higher limits
	testAccounts := []*domain.Accounts{
		createTestAccount(uuid.New(), suite.entityID),
		createTestAccount(uuid.New(), suite.entityID),
	}
	suite.mockRepo.On("Search", suite.ctx, "test", 300).Return(testAccounts, nil)

	// Execute test with high limit (should be capped at 500 for enhanced search)
	result, err := suite.accountService.SearchAccounts(suite.ctx, "test", 300)

	// Assertions
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Len(t, result, 2)

	// Verify mocks
	suite.mockFFService.AssertExpectations(t)
	suite.mockRepo.AssertExpectations(t)
}

// =============================================================================
// LIST ACCOUNT TESTS
// =============================================================================

func TestAccountService_ListAccounts_Success(t *testing.T) {
	suite := setupAccountServiceTest(t)

	// Set up permission check for user effective permissions
	userPermissions := &authz.UserEffectivePermissions{
		UserID: suite.userID,
		Permissions: map[string][]string{
			"account": {"read", "list"},
		},
		Roles:     []string{"accountant"},
		Timestamp: time.Now(),
	}
	suite.mockAuthzService.On("GetUserEffectivePermissions", suite.ctx, suite.userID, (*uuid.UUID)(nil)).Return(userPermissions, nil)

	// Set up feature flag - Enhanced listing disabled
	suite.mockFFService.On("IsEnabled", suite.ctx, "enhanced_account_listing", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(false, nil)

	// Set up repository call
	limit := 50
	filter := &domain.AccountFilter{
		Limit: &limit,
	}
	testAccounts := []*domain.Accounts{
		createTestAccount(uuid.New(), suite.entityID),
		createTestAccount(uuid.New(), suite.entityID),
	}
	suite.mockRepo.On("List", suite.ctx, filter).Return(testAccounts, nil)
	suite.mockMetrics.On("IncrementCounter", "account_list_requests_total", mock.AnythingOfType("metrics.Fields"))
	suite.mockMetrics.On("ObserveHistogram", "account_list_duration", mock.AnythingOfType("float64"), mock.AnythingOfType("metrics.Fields"))

	// Execute test
	result, err := suite.accountService.ListAccounts(suite.ctx, filter)

	// Assertions
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Len(t, result, 2)

	// Verify mocks
	suite.mockAuthzService.AssertExpectations(t)
	suite.mockFFService.AssertExpectations(t)
	suite.mockRepo.AssertExpectations(t)
	suite.mockMetrics.AssertExpectations(t)
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

func testStringPtr(s string) *string {
	return &s
}

// =============================================================================
// CONTEXT TESTS (No User/Tenant in Context)
// =============================================================================

func TestAccountService_CreateAccount_NoUserContext(t *testing.T) {
	suite := setupAccountServiceTest(t)
	
	// Use context without user ID
	ctxNoUser := context.Background()
	ctxNoUser = context.WithValue(ctxNoUser, shared.TenantIDKey, suite.tenantID)

	// Set up feature flag
	suite.mockFFService.On("IsEnabled", ctxNoUser, "enhanced_account_validation", mock.AnythingOfType("*featureflag.EvaluationContext")).Return(false, nil)

	// Set up repository calls
	suite.mockRepo.On("ValidateAccountCode", ctxNoUser, "1000", (*uuid.UUID)(nil)).Return(nil)
	suite.mockRepo.On("Create", ctxNoUser, mock.AnythingOfType("*domain.Accounts")).Return(nil)
	testAccount := createTestAccount(uuid.New(), suite.entityID)
	suite.mockRepo.On("GetByCode", ctxNoUser, &suite.entityID, "1000").Return(testAccount, nil)
	suite.mockMetrics.On("IncrementCounter", mock.AnythingOfType("string"), mock.AnythingOfType("metrics.Fields"))
	suite.mockMetrics.On("ObserveHistogram", mock.AnythingOfType("string"), mock.AnythingOfType("float64"), mock.AnythingOfType("metrics.Fields"))

	// Execute test
	req := createValidAccountRequest(suite.entityID)
	result, err := suite.accountService.CreateAccount(ctxNoUser, req)

	// Assertions - should succeed without ABAC check
	require.NoError(t, err)
	require.NotNil(t, result)

	// ABAC service should not have been called
	suite.mockAuthzService.AssertNotCalled(t, "EvaluatePermission")
}