			CacheHit:       false,
			RequestID:      "history-test",
		},
	}
	
	suite.mockABACService.On("GetDecisionHistory", suite.ctx, suite.userID, limit).
		Return(abacHistory, nil)
	
	// Act
	result, err := suite.adapter.GetDecisionHistory(suite.ctx, suite.userID, limit)
	
	// Assert
