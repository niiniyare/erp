func (suite *AdapterTestSuite) TestGetCacheStatistics_Success() {
	// Arrange
	abacStats := &abac.GetCacheStatsOutput{
		HitRate:           0.85,
		MissRate:          0.15,
		TotalRequests:     1000,
		CacheHits:         850,
		CacheMisses:       150,
		EvictionCount:     10,
		AverageLatencyMS:  25,
	}
	
	suite.mockABACService.On("GetCacheStatistics", suite.ctx).
		Return(abacStats, nil)
	
	// Act
	result, err := suite.adapter.GetCacheStatistics(suite.ctx)
	
	// Assert
	require.NoError(suite.T(), err)
