	"github.com/niiniyare/erp/internal/shared/types"
)

// ─── TEST SUITE DEFINITION ─────────────────────────────────────────────────

type AdapterTestSuite struct {
	suite.Suite
	
	// System under test
	adapter Service
	
	// Mock controller
	ctrl *gomock.Controller
	
	// Mock dependencies
	mockABACService   *abac.MockService
	mockAccessService *access.MockService
	mockLogger        *logger.MockLogger
	mockMetrics       *metrics.MockMetricsProvider
	mockTracer        *tracing.MockTracingService
	
	// Test data
	ctx      context.Context
	userID   uuid.UUID
	entityID uuid.UUID
	policyID uuid.UUID
	requestID uuid.UUID
	now      time.Time
}

// SetupTest initializes the test suite
func (suite *AdapterTestSuite) SetupTest() {
	// Create gomock controller
	suite.ctrl = gomock.NewController(suite.T())
	
	// Create mock dependencies
	suite.mockABACService = abac.NewMockService(suite.ctrl)
	suite.mockAccessService = access.NewMockService(suite.ctrl)
	suite.mockLogger = logger.NewMockLogger(suite.ctrl)
	suite.mockMetrics = metrics.NewMockMetricsProvider(suite.ctrl)
	suite.mockTracer = tracing.NewMockTracingService(suite.ctrl)
	
	// Create adapter with mocks
	suite.adapter = NewAdapter(
		suite.mockABACService,
		suite.mockAccessService,
		suite.mockLogger,
		suite.mockMetrics,
		suite.mockTracer,
	)
	
	// Initialize test data
	suite.ctx = context.Background()
	suite.userID = uuid.New()
	suite.entityID = uuid.New()
	suite.policyID = uuid.New()
	suite.requestID = uuid.New()
	suite.now = time.Now()
	
	// Setup default mock behaviors
	suite.setupDefaultMocks()
}

// TearDownTest cleans up after each test
func (suite *AdapterTestSuite) TearDownTest() {
	// Verify all mock expectations were met
	suite.ctrl.Finish()
}

// setupDefaultMocks configures default behaviors for mocks
func (suite *AdapterTestSuite) setupDefaultMocks() {
	// Default tracing setup - allow any span operations
	suite.mockTracer.EXPECT().StartSpan(gomock.Any(), gomock.Any()).
		Return(suite.ctx, tracing.NewMockSpan(suite.ctrl)).AnyTimes()
	
	// Default metrics setup - allow any metrics operations
	suite.mockMetrics.EXPECT().ObserveHistogram(gomock.Any(), gomock.Any(), gomock.Any()).AnyTimes()
	suite.mockMetrics.EXPECT().IncrementCounter(gomock.Any(), gomock.Any()).AnyTimes()
	
	// Default logging setup - allow any logging operations
	suite.mockLogger.EXPECT().InfoContext(gomock.Any(), gomock.Any(), gomock.Any()).AnyTimes()
	suite.mockLogger.EXPECT().ErrorContext(gomock.Any(), gomock.Any(), gomock.Any()).AnyTimes()
}

// ─── PERMISSION EVALUATION TESTS ───────────────────────────────────────────

func (suite *AdapterTestSuite) TestEvaluatePermission_Success() {
	// Arrange
	req := &PermissionEvaluationRequest{
		UserID:       suite.userID,
		ResourceType: "document",
		Action:       "read",
		RequestID:    "test-request",
	}
	
	abacResult := &abac.PermissionEvaluationResult{
		Decision: types.PolicyDecisionAllow,
		PolicyDecisions: []*models.PolicyDecision{
			{
				PolicyID:      suite.policyID,
				Decision:      types.PolicyDecisionAllow,
				Reason:        "Policy allows access",
				MatchedRule:   "default_rule",
				EvaluationMS:  5,
				TargetMatched: true,
			},
		},
		EvaluationTimeMS: 25,
		CacheHit:         false,
		RequestID:        "test-request",
		Timestamp:        suite.now,
	}
	
	suite.mockABACService.EXPECT().EvaluatePermission(gomock.Eq(suite.ctx), gomock.Any()).
		Return(abacResult, nil)
	
	// Act
	result, err := suite.adapter.EvaluatePermission(suite.ctx, req)
	
	// Assert
	require.NoError(suite.T(), err)
	require.NotNil(suite.T(), result)
	suite.Equal(model.PolicyDecisionAllow, result.Decision)
	suite.Equal(int64(25), result.EvaluationTimeMS)
	suite.Equal("test-request", result.RequestID)
	suite.Len(result.PolicyDecisions, 1)
}

func (suite *AdapterTestSuite) TestEvaluatePermission_ABACServiceError() {
	// Arrange
	req := &PermissionEvaluationRequest{
		UserID:       suite.userID,
		ResourceType: "document",
		Action:       "read",
	}
	
	suite.mockABACService.On("EvaluatePermission", suite.ctx, mock.Anything).
		Return(nil, ErrABACServiceUnavailable)
	
	// Act
	result, err := suite.adapter.EvaluatePermission(suite.ctx, req)
	
	// Assert
	require.Error(suite.T(), err)
	require.Nil(suite.T(), result)
	suite.Contains(err.Error(), "failed to evaluate permission via ABAC")
}

func (suite *AdapterTestSuite) TestBulkEvaluatePermissions_Success() {
	// Arrange
	req := &BulkPermissionEvaluationRequest{
		Requests: []*PermissionEvaluationRequest{
			{
				UserID:       suite.userID,
				ResourceType: "document",
				Action:       "read",
			},
			{
				UserID:       suite.userID,
				ResourceType: "document",
				Action:       "write",
			},
		},
		RequestID: "bulk-test",
	}
	
	abacResult := &abac.BulkPermissionEvaluationResult{
		Results: []*abac.PermissionEvaluationResult{
			{
				Decision:         types.PolicyDecisionAllow,
				PolicyDecisions:  []*models.PolicyDecision{},
				EvaluationTimeMS: 15,
				CacheHit:         true,
				Timestamp:        suite.now,
			},
			{
				Decision:         types.PolicyDecisionDeny,
				PolicyDecisions:  []*models.PolicyDecision{},
				EvaluationTimeMS: 20,
				CacheHit:         false,
				Timestamp:        suite.now,
			},
		},
		TotalRequests:   2,
		SuccessfulCount: 2,
		FailedCount:     0,
		TotalTimeMS:     35,
		AverageTimeMS:   17.5,
		RequestID:       "bulk-test",
		Timestamp:       suite.now,
	}
	
	suite.mockABACService.On("BulkEvaluatePermissions", suite.ctx, mock.MatchedBy(func(r *abac.BulkPermissionEvaluationRequest) bool {
		return len(r.Requests) == 2 && r.RequestID == "bulk-test"
	})).Return(abacResult, nil)
	
	// Act
	result, err := suite.adapter.BulkEvaluatePermissions(suite.ctx, req)
	
	// Assert
	require.NoError(suite.T(), err)
	require.NotNil(suite.T(), result)
	suite.Equal(2, result.TotalRequests)
	suite.Equal(2, result.SuccessfulCount)
	suite.Equal(0, result.FailedCount)
	suite.Len(result.Results, 2)
	suite.Equal(model.PolicyDecisionAllow, result.Results[0].Decision)
	suite.Equal(model.PolicyDecisionDeny, result.Results[1].Decision)
}

// ─── USER PERMISSIONS TESTS ────────────────────────────────────────────────

func (suite *AdapterTestSuite) TestGetUserEffectivePermissions_Success() {
	// Arrange
	abacResult := &abac.UserEffectivePermissions{
		UserID:   suite.userID,
		EntityID: &suite.entityID,
		Permissions: map[string][]string{
			"document": {"read", "write"},
			"user":     {"read"},
		},
		Roles:     []string{"user", "editor"},
		Timestamp: suite.now,
	}
	
	suite.mockABACService.On("GetUserEffectivePermissions", suite.ctx, suite.userID, &suite.entityID).
		Return(abacResult, nil)
	
	// Act
	result, err := suite.adapter.GetUserEffectivePermissions(suite.ctx, suite.userID, &suite.entityID)
	
	// Assert
	require.NoError(suite.T(), err)
	require.NotNil(suite.T(), result)
	suite.Equal(suite.userID, result.UserID)
	suite.Equal(&suite.entityID, result.EntityID)
	suite.Equal(2, len(result.Permissions))
	suite.Equal(2, len(result.Roles))
	suite.Contains(result.Permissions, "document")
	suite.Contains(result.Permissions, "user")
	suite.Contains(result.Roles, "user")
	suite.Contains(result.Roles, "editor")
}

func (suite *AdapterTestSuite) TestCalculateRoleHierarchy_Success() {
	// Arrange
	abacResult := &abac.RoleHierarchy{
		UserID:   suite.userID,
		EntityID: &suite.entityID,
		Roles:    []string{"user", "editor", "admin"},
		Hierarchy: map[string][]string{
			"admin":  {"editor", "user"},
			"editor": {"user"},
			"user":   {},
		},
		Timestamp: suite.now,
	}
	
	suite.mockABACService.On("CalculateRoleHierarchy", suite.ctx, suite.userID, &suite.entityID).
		Return(abacResult, nil)
	
	// Act
	result, err := suite.adapter.CalculateRoleHierarchy(suite.ctx, suite.userID, &suite.entityID)
	
	// Assert
	require.NoError(suite.T(), err)
	require.NotNil(suite.T(), result)
	suite.Equal(suite.userID, result.UserID)
	suite.Equal(&suite.entityID, result.EntityID)
	suite.Equal(3, len(result.Roles))
	suite.Equal(3, len(result.Hierarchy))
	suite.Contains(result.Hierarchy, "admin")
	suite.Contains(result.Hierarchy, "editor")
	suite.Contains(result.Hierarchy, "user")
}

// ─── ACCESS REQUEST TESTS ──────────────────────────────────────────────────

func (suite *AdapterTestSuite) TestCreateAccessRequest_Success() {
	// Arrange
	req := &CreateAccessRequestRequest{
		UserID:        suite.userID,
		ResourceType:  "document",
		Action:        "read",
		Justification: "Need access for project review",
		Priority:      "high",
	}
	
	accessResult := &access.AccessRequest{
		ID:            suite.requestID,
		RequesterID:   suite.userID,
		TargetUserID:  &suite.userID,
		EntityID:      suite.entityID,
		RequestType:   access.RequestType("RESOURCE_ACCESS"),
		Justification: req.Justification,
		ApprovalStatus: types.ApprovalStatusPending,
		CreatedAt:     suite.now,
		UpdatedAt:     suite.now,
		TenantID:      uuid.New(),
	}
	
	suite.mockAccessService.On("CreateAccessRequest", suite.ctx, mock.MatchedBy(func(r *access.CreateAccessRequestRequest) bool {
		return r.UserID == req.UserID && r.ResourceType == req.ResourceType && r.Action == req.Action
	})).Return(accessResult, nil)
	
	// Act
	result, err := suite.adapter.CreateAccessRequest(suite.ctx, req)
	
	// Assert
	require.NoError(suite.T(), err)
	require.NotNil(suite.T(), result)
	suite.Equal(suite.requestID, result.ID)
	suite.Equal(suite.userID, result.UserID)
	suite.Equal("resource", result.ResourceType)
	suite.Equal("access", result.Action)
	suite.Equal(req.Justification, result.Justification)
}

