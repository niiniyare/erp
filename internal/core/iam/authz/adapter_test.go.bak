// ─── INTEGRATION TESTS ─────────────────────────────────────────────────────

func (suite *AdapterTestSuite) TestCompleteWorkflow_PermissionEvaluationToDecisionHistory() {
	// Test a complete workflow from permission evaluation to decision history
	
	// Step 1: Evaluate permission
	evalReq := &PermissionEvaluationRequest{
		UserID:       suite.userID,
		ResourceType: "document",
		Action:       "read",
		RequestID:    "workflow-test",
	}
	
	abacEvalResult := &abac.PermissionEvaluationResult{
		Decision:         types.PolicyDecisionAllow,
		PolicyDecisions:  []*models.PolicyDecision{},
		EvaluationTimeMS: 30,
		CacheHit:         false,
		RequestID:        "workflow-test",
		Timestamp:        suite.now,
	}
	
	suite.mockABACService.On("EvaluatePermission", suite.ctx, mock.Anything).
		Return(abacEvalResult, nil)
	
	evalResult, err := suite.adapter.EvaluatePermission(suite.ctx, evalReq)
	require.NoError(suite.T(), err)
	require.NotNil(suite.T(), evalResult)
	
	// Step 2: Check decision history
	abacHistory := []*abac.DecisionHistoryEntry{
		{
			ID:             uuid.New(),
			UserID:         suite.userID,
			ResourceType:   "document",
			ResourceID:     uuid.New(),
			Action:         "read",
			Decision:       types.PolicyDecisionAllow,
			Allowed:        true,
			EvaluationTime: 30 * time.Millisecond,
			EvaluatedAt:    suite.now,
			PolicyCount:    1,
			CacheHit:       false,
			RequestID:      "workflow-test",
		},
	}
	
	suite.mockABACService.On("GetDecisionHistory", suite.ctx, suite.userID, 10).
		Return(abacHistory, nil)
	
	historyResult, err := suite.adapter.GetDecisionHistory(suite.ctx, suite.userID, 10)
	require.NoError(suite.T(), err)
	require.NotNil(suite.T(), historyResult)
	require.Len(suite.T(), historyResult, 1)
	
	// Verify the workflow consistency
	suite.Equal(evalResult.Decision, historyResult[0].Decision)
	suite.Equal(evalReq.UserID, historyResult[0].UserID)
	suite.Equal(evalReq.ResourceType, historyResult[0].ResourceType)
	suite.Equal(evalReq.Action, historyResult[0].Action)
}

// ─── PERFORMANCE AND LOAD TESTS ────────────────────────────────────────────

func (suite *AdapterTestSuite) TestBulkEvaluatePermissions_Performance() {
	// Test bulk evaluation with a large number of requests
	requests := make([]*PermissionEvaluationRequest, 100)
	abacResults := make([]*abac.PermissionEvaluationResult, 100)
	
	for i := 0; i < 100; i++ {
		requests[i] = &PermissionEvaluationRequest{
			UserID:       uuid.New(),
			ResourceType: "document",
			Action:       "read",
		}
		abacResults[i] = &abac.PermissionEvaluationResult{
			Decision:         types.PolicyDecisionAllow,
			PolicyDecisions:  []*models.PolicyDecision{},
			EvaluationTimeMS: 5,
			CacheHit:         i%2 == 0, // Alternate cache hit/miss
			Timestamp:        suite.now,
		}
	}
	
	bulkReq := &BulkPermissionEvaluationRequest{
		Requests:  requests,
		RequestID: "perf-test",
	}
	
	abacBulkResult := &abac.BulkPermissionEvaluationResult{
		Results:         abacResults,
		TotalRequests:   100,
		SuccessfulCount: 100,
		FailedCount:     0,
		TotalTimeMS:     500,
		AverageTimeMS:   5.0,
		RequestID:       "perf-test",
		Timestamp:       suite.now,
	}
	
	suite.mockABACService.On("BulkEvaluatePermissions", suite.ctx, mock.Anything).
		Return(abacBulkResult, nil)
	
	// Act with timing
	start := time.Now()
	result, err := suite.adapter.BulkEvaluatePermissions(suite.ctx, bulkReq)
	duration := time.Since(start)
	
	// Assert
	require.NoError(suite.T(), err)
	require.NotNil(suite.T(), result)
	suite.Equal(100, result.TotalRequests)
	suite.Equal(100, result.SuccessfulCount)
	suite.Equal(0, result.FailedCount)
	suite.Len(result.Results, 100)
	
	// Performance assertion (should complete reasonably quickly)
	suite.Less(duration, 100*time.Millisecond, "Bulk evaluation should complete within 100ms")
}

// ─── TEST SUITE RUNNER ─────────────────────────────────────────────────────

func TestAdapterTestSuite(t *testing.T) {
	suite.Run(t, new(AdapterTestSuite))
}

// ─── BENCHMARK TESTS ───────────────────────────────────────────────────────

func BenchmarkEvaluatePermission(b *testing.B) {
	// Setup
	mockABACService := &abac.MockService{}
	mockAccessService := &access.MockService{}
	mockLogger := &logger.MockLogger{}
	mockMetrics := &metrics.MockMetricsProvider{}
	mockTracer := &tracing.MockTracingService{}
	
	adapter := NewAdapter(
		mockABACService,
		mockAccessService,
		mockLogger,
		mockMetrics,
		mockTracer,
	)
	
	ctx := context.Background()
	userID := uuid.New()
	
	req := &PermissionEvaluationRequest{
		UserID:       userID,
		ResourceType: "document",
		Action:       "read",
		RequestID:    "benchmark",
	}
	
	abacResult := &abac.PermissionEvaluationResult{
		Decision:         types.PolicyDecisionAllow,
		PolicyDecisions:  []*models.PolicyDecision{},
		EvaluationTimeMS: 10,
		CacheHit:         true,
		RequestID:        "benchmark",
		Timestamp:        time.Now(),
	}
	
	// Setup mocks
	mockABACService.On("EvaluatePermission", ctx, mock.Anything).Return(abacResult, nil)
	mockTracer.On("StartSpan", mock.Anything, mock.AnythingOfType("string"), mock.Anything).
		Return(ctx, &tracing.MockSpan{})
	mockMetrics.On("ObserveHistogram", mock.AnythingOfType("string"), mock.AnythingOfType("float64"), mock.Anything).
		Return()
	mockMetrics.On("IncrementCounter", mock.AnythingOfType("string"), mock.Anything).
		Return()
	mockLogger.On("InfoContext", mock.Anything, mock.AnythingOfType("string"), mock.Anything).
		Return()
	
	// Benchmark
	b.ResetTimer()
	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			_, err := adapter.EvaluatePermission(ctx, req)
			if err != nil {
				b.Fatal(err)
			}
		}
	})
}