// TestUserQueryOperations implements IAM-REPO-002: Verify user query operations with tenant isolation
func (s *UserRepositoryTestSuite) TestUserQueryOperations() {
	testCases := []struct {
		name           string
		queryType      string
		queryParam     any
		setupMocks     func()
		expectError    bool
		errorContains  string
		validateResult func(*testing.T, any)
	}{
		{
			name:       "IAM-REPO-002_GetByEmail_ReturnsUserSecurely",
			queryType:  "by_email",
			queryParam: "test@example.com",
			setupMocks: func() {
				s.store.EXPECT().
					GetUserByEmail(gomock.Any(), "test@example.com").
					Return(db.User{
						ID:            uuid.New(),
						TenantID:      s.tenantID,
						Email:         "test@example.com",
						PasswordHash:  "", // Should not be returned
						AccountStatus: string(model.UserAccountStatusActive),
					}, nil).
					Times(1)
			},
			expectError: false,
			validateResult: func(t *testing.T, result any) {
				user := result.(*model.User)
				require.NotNil(t, user)
				require.Equal(t, "test@example.com", user.Email)
				require.Equal(t, s.tenantID, user.TenantID)
				// Password hash should be empty for security
				require.Empty(t, user.PasswordHash)
			},
		},
		{
			name:       "IAM-REPO-002_ListByStatus_FiltersCorrectly",
			queryType:  "by_status",
			queryParam: model.UserAccountStatusActive,
			setupMocks: func() {
				s.store.EXPECT().
					ListUsersByStatus(gomock.Any(), string(model.UserAccountStatusActive)).
					Return([]db.User{
						{ID: uuid.New(), TenantID: s.tenantID, AccountStatus: string(model.UserAccountStatusActive)},
						{ID: uuid.New(), TenantID: s.tenantID, AccountStatus: string(model.UserAccountStatusActive)},
					}, nil).
					Times(1)
			},
			expectError: false,
			validateResult: func(t *testing.T, result any) {
				users := result.([]*model.User)
				require.Len(t, users, 2)
				for _, user := range users {
					require.Equal(t, model.UserAccountStatusActive, user.AccountStatus)
					require.Equal(t, s.tenantID, user.TenantID)
				}
			},
		},
		{
			name:       "IAM-REPO-002_CountUsers_ReturnsCorrectCount",
			queryType:  "count",
			queryParam: nil,
			setupMocks: func() {
				s.store.EXPECT().
					CountUsers(gomock.Any()).
					Return(int64(42), nil).
					Times(1)
			},
			expectError: false,
			validateResult: func(t *testing.T, result any) {
				count := result.(int64)
				require.Equal(t, int64(42), count)
			},
		},
	}

	for _, tc := range testCases {
		s.Run(tc.name, func() {
			// Setup tracing mocks
			s.tracing.EXPECT().
				StartSpan(gomock.Any(), gomock.Any()).
				Return(s.ctx, &tracing.MockSpan{}).
				AnyTimes()

			// Setup mock behavior
			tc.setupMocks()

			// Act
			var result any
			var err error
			switch tc.queryType {
			case "by_email":
				result, err = s.repo.GetByEmail(s.ctx, tc.queryParam.(string))
			case "by_status":
				result, err = s.repo.ListByStatus(s.ctx, tc.queryParam.(model.UserAccountStatus))
			case "count":
				result, err = s.repo.Count(s.ctx)
			}

			// Assert
			if tc.expectError {
				require.Error(s.T(), err)
				if tc.errorContains != "" {
					require.Contains(s.T(), err.Error(), tc.errorContains)
				}
				require.Nil(s.T(), result)
			} else {
				require.NoError(s.T(), err)
				require.NotNil(s.T(), result)
				if tc.validateResult != nil {
					tc.validateResult(s.T(), result)
				}
			}
		})
	}
}
