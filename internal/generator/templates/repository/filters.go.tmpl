{{comment "AddDateRangeCondition adds date range condition"}}
func (qb *{{.EntityName}}QueryBuilder) AddDateRangeCondition(field string, after, before *string) *{{.EntityName}}QueryBuilder {
	if after != nil {
		qb.addCondition(field+" >= $%d", *after)
	}
	if before != nil {
		qb.addCondition(field+" <= $%d", *before)
	}
	return qb
}

{{comment "AddSearchCondition adds full-text search condition"}}
func (qb *{{.EntityName}}QueryBuilder) AddSearchCondition(query string, fields []string) *{{.EntityName}}QueryBuilder {
	if query != "" && len(fields) > 0 {
		var searchConditions []string
		
		for _, field := range fields {
			searchConditions = append(searchConditions, 
				fmt.Sprintf("%s ILIKE $%d", field, qb.argIndex))
			qb.args = append(qb.args, "%"+query+"%")
			qb.argIndex++
		}
		
		if len(searchConditions) > 0 {
			qb.conditions = append(qb.conditions, 
				"("+strings.Join(searchConditions, " OR ")+")")
		}
	}
	return qb
}

{{comment "addCondition is a helper to add a condition with argument"}}
func (qb *{{.EntityName}}QueryBuilder) addCondition(condition string, args ...interface{}) {
	if len(args) > 0 {
		qb.conditions = append(qb.conditions, fmt.Sprintf(condition, qb.argIndex))
		qb.args = append(qb.args, args[0])
		qb.argIndex++
	} else {
		qb.conditions = append(qb.conditions, condition)
	}
}

{{comment "BuildWhereClause builds the WHERE clause and returns conditions and arguments"}}
func (qb *{{.EntityName}}QueryBuilder) BuildWhereClause() (string, []interface{}) {
	if len(qb.conditions) == 0 {
		return "", nil
	}
	
	whereClause := "WHERE " + strings.Join(qb.conditions, " AND ")
	return whereClause, qb.args
}

{{comment "BuildOrderByClause builds the ORDER BY clause"}}
func (qb *{{.EntityName}}QueryBuilder) BuildOrderByClause(sortBy, sortOrder string) string {
	// Validate sort field
	validSortFields := []string{
		"{{snakeCase .EntityName}}_code",
		"{{snakeCase .EntityName}}_name",
		"{{snakeCase .EntityName}}_type",
		"status",
		"created_at",
		"updated_at",
		"display_order",
		{{- if contains .ModuleName "finance"}}
		"level",
		"path",
		{{- end}}
	}
	
	// Default sorting
	if sortBy == "" {
		sortBy = "{{snakeCase .EntityName}}_code"
	}
	
	// Validate sort field
	isValidField := false
	for _, field := range validSortFields {
		if field == sortBy {
			isValidField = true
			break
		}
	}
	
	if !isValidField {
		sortBy = "{{snakeCase .EntityName}}_code"
	}
	
	// Validate sort order
	if sortOrder != "desc" {
		sortOrder = "asc"
	}
	
	return fmt.Sprintf("ORDER BY %s %s", sortBy, strings.ToUpper(sortOrder))
}

{{comment "BuildLimitOffsetClause builds the LIMIT and OFFSET clause"}}
func (qb *{{.EntityName}}QueryBuilder) BuildLimitOffsetClause(limit, offset int32) string {
	if limit <= 0 {
		limit = 20 // Default limit
	}
	if limit > 1000 {
		limit = 1000 // Max limit
	}
	if offset < 0 {
		offset = 0
	}
	
	return fmt.Sprintf("LIMIT %d OFFSET %d", limit, offset)
}

