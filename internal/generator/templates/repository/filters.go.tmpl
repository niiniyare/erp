{{comment (printf "%sQueryBuilder builds SQL query conditions for %s filtering" .EntityName (lowerCase .EntityName))}}
type {{.EntityName}}QueryBuilder struct {
	conditions []string
	args       []interface{}
	argIndex   int
}

{{comment (printf "New%sQueryBuilder creates a new query builder" .EntityName)}}
func New{{.EntityName}}QueryBuilder() *{{.EntityName}}QueryBuilder {
	return &{{.EntityName}}QueryBuilder{
		conditions: make([]string, 0),
		args:       make([]interface{}, 0),
		argIndex:   1,
	}
}

{{comment "AddTenantIDCondition adds tenant ID condition (always required)"}}
func (qb *{{.EntityName}}QueryBuilder) AddTenantIDCondition(tenantID uuid.UUID) *{{.EntityName}}QueryBuilder {
	qb.addCondition("tenant_id = $%d", tenantID)
	return qb
}

{{comment "AddEntityIDCondition adds entity ID condition if provided"}}
func (qb *{{.EntityName}}QueryBuilder) AddEntityIDCondition(entityID *uuid.UUID) *{{.EntityName}}QueryBuilder {
	if entityID != nil {
		qb.addCondition("entity_id = $%d", *entityID)
	}
	return qb
}

{{comment "AddActiveCondition adds active status condition"}}
func (qb *{{.EntityName}}QueryBuilder) AddActiveCondition(isActive *bool) *{{.EntityName}}QueryBuilder {
	if isActive != nil {
		qb.addCondition("is_active = $%d", *isActive)
	}
	return qb
}

{{comment "AddDeletedCondition adds deleted_at condition"}}
func (qb *{{.EntityName}}QueryBuilder) AddDeletedCondition(includeDeleted bool) *{{.EntityName}}QueryBuilder {
	if !includeDeleted {
		qb.addCondition("deleted_at IS NULL")
	}
	return qb
}

{{comment (printf "AddCodeCondition adds %s code condition" (lowerCase .EntityName))}}
func (qb *{{.EntityName}}QueryBuilder) AddCodeCondition(code *string, matchType string) *{{.EntityName}}QueryBuilder {
	if code != nil {
		switch strings.ToLower(matchType) {
		case "exact":
			qb.addCondition("{{snakeCase .EntityName}}_code = $%d", *code)
		case "prefix":
			qb.addCondition("{{snakeCase .EntityName}}_code ILIKE $%d", *code+"%")
		case "contains":
			qb.addCondition("{{snakeCase .EntityName}}_code ILIKE $%d", "%"+*code+"%")
		default:
			qb.addCondition("{{snakeCase .EntityName}}_code ILIKE $%d", "%"+*code+"%")
		}
	}
	return qb
}

{{comment (printf "AddNameCondition adds %s name condition" (lowerCase .EntityName))}}
func (qb *{{.EntityName}}QueryBuilder) AddNameCondition(name *string, matchType string) *{{.EntityName}}QueryBuilder {
	if name != nil {
		switch strings.ToLower(matchType) {
		case "exact":
			qb.addCondition("{{snakeCase .EntityName}}_name = $%d", *name)
		case "prefix":
			qb.addCondition("{{snakeCase .EntityName}}_name ILIKE $%d", *name+"%")
		case "contains":
			qb.addCondition("{{snakeCase .EntityName}}_name ILIKE $%d", "%"+*name+"%")
		default:
			qb.addCondition("{{snakeCase .EntityName}}_name ILIKE $%d", "%"+*name+"%")
		}
	}
	return qb
}

{{comment (printf "AddTypeCondition adds %s type condition" (lowerCase .EntityName))}}
