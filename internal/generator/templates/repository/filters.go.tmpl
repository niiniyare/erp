{{comment "Build returns the constructed filter and any validation errors"}}
func (b *{{.EntityName}}FilterBuilder) Build() (*domain.{{.EntityName}}Filter, error) {
	if len(b.errors) > 0 {
		return nil, fmt.Errorf("filter validation errors: %v", b.errors)
	}
	
	// Validate date ranges
	if err := b.validateDateRanges(); err != nil {
		return nil, err
	}
	
	// Validate pagination
	if err := b.validatePagination(); err != nil {
		return nil, err
	}
	
	return b.filter, nil
}

{{comment "validateDateRanges validates that date ranges are logical"}}
func (b *{{.EntityName}}FilterBuilder) validateDateRanges() error {
	// Validate created date range
	if b.filter.CreatedAfter != nil && b.filter.CreatedBefore != nil {
		after, err1 := time.Parse("2006-01-02", *b.filter.CreatedAfter)
		before, err2 := time.Parse("2006-01-02", *b.filter.CreatedBefore)
		
		if err1 != nil || err2 != nil {
			return fmt.Errorf("invalid date format in created date range")
		}
		
		if after.After(before) {
			return fmt.Errorf("created_after cannot be after created_before")
		}
	}
	
	// Validate updated date range
	if b.filter.UpdatedAfter != nil && b.filter.UpdatedBefore != nil {
		after, err1 := time.Parse("2006-01-02", *b.filter.UpdatedAfter)
		before, err2 := time.Parse("2006-01-02", *b.filter.UpdatedBefore)
		
		if err1 != nil || err2 != nil {
			return fmt.Errorf("invalid date format in updated date range")
		}
		
		if after.After(before) {
			return fmt.Errorf("updated_after cannot be after updated_before")
		}
	}
	
	return nil
}

{{comment "validatePagination validates pagination parameters"}}
func (b *{{.EntityName}}FilterBuilder) validatePagination() error {
	if b.filter.Page != nil && *b.filter.Page < 1 {
		return fmt.Errorf("page must be greater than 0")
	}
	
	if b.filter.Limit != nil && (*b.filter.Limit < 1 || *b.filter.Limit > 1000) {
		return fmt.Errorf("limit must be between 1 and 1000")
	}
	
	return nil
}

