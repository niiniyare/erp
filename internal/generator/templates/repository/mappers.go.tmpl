// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

{{comment "getDisplayOrder returns display order with default"}}
func getDisplayOrder(order *int32) int32 {
	if order != nil {
		return *order
	}
	return 0 // Default display order
}

{{comment "getShowInReports returns show in reports flag with default"}}
func getShowInReports(show *bool) bool {
	if show != nil {
		return *show
	}
	return true // Default to showing in reports
}

{{comment (printf "CalculatePaginationMeta calculates pagination metadata")}}
func CalculatePaginationMeta(totalItems, page, pageSize int32) domain.PaginationMeta {
	totalPages := (totalItems + pageSize - 1) / pageSize
	if totalPages == 0 {
		totalPages = 1
	}
	
	return domain.PaginationMeta{
		CurrentPage: page,
		PageSize:    pageSize,
		TotalItems:  totalItems,
		TotalPages:  totalPages,
		HasNext:     page < totalPages,
		HasPrev:     page > 1,
	}
}

{{comment "ValidateUUIDSlice validates that all UUIDs in slice are non-nil"}}
func ValidateUUIDSlice(ids []uuid.UUID) error {
	for i, id := range ids {
		if id == uuid.Nil {
			return domain.New{{.EntityName}}ValidationError("ID", "UUID at index %d is nil", i)
		}
	}
	return nil
}

{{comment "DeduplicateUUIDs removes duplicate UUIDs from slice"}}
func DeduplicateUUIDs(ids []uuid.UUID) []uuid.UUID {
	seen := make(map[uuid.UUID]bool)
	result := make([]uuid.UUID, 0, len(ids))
	
	for _, id := range ids {
		if !seen[id] {
			seen[id] = true
			result = append(result, id)
		}
	}
	
	return result
}

