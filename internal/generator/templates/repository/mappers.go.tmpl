// =============================================================================
// DOMAIN TO SQLC MAPPERS
// =============================================================================

{{comment (printf "ToSQLC%s converts a domain %s to SQLC create params" .EntityName (lowerCase .EntityName))}}
func ToSQLC{{.EntityName}}({{camelCase .EntityName}} *domain.{{.EntityName}}) sqlc.Create{{.EntityName}}Params {
	return sqlc.Create{{.EntityName}}Params{
		ID:       {{camelCase .EntityName}}.ID,
		TenantID: {{camelCase .EntityName}}.TenantID,
		EntityID: {{camelCase .EntityName}}.EntityID,
		
		{{.EntityName}}Code:        {{camelCase .EntityName}}.{{.EntityName}}Code,
		{{.EntityName}}Name:        {{camelCase .EntityName}}.{{.EntityName}}Name,
		{{.EntityName}}Description: {{camelCase .EntityName}}.{{.EntityName}}Description,
		{{.EntityName}}Type:        {{camelCase .EntityName}}.{{.EntityName}}Type,
		{{.EntityName}}Category:    {{camelCase .EntityName}}.{{.EntityName}}Category,
		
		Status: string({{camelCase .EntityName}}.Status),
		
		{{- if contains .ModuleName "finance"}}
		ParentID:    {{camelCase .EntityName}}.ParentID,
		Level:       {{camelCase .EntityName}}.Level,
		Path:        {{camelCase .EntityName}}.Path,
		HasChildren: {{camelCase .EntityName}}.HasChildren,
		{{- end}}
		
		IsActive:           {{camelCase .EntityName}}.IsActive,
		IsSystemDefined:    {{camelCase .EntityName}}.IsSystemDefined,
		AllowManualEntries: {{camelCase .EntityName}}.AllowManualEntries,
		
		DisplayOrder:   {{camelCase .EntityName}}.DisplayOrder,
		ShowInReports:  {{camelCase .EntityName}}.ShowInReports,
		ReportCategory: {{camelCase .EntityName}}.ReportCategory,
		
		Version:           {{camelCase .EntityName}}.Version,
		ValidationStatus:  string({{camelCase .EntityName}}.ValidationStatus),
		
		CreatedAt: {{camelCase .EntityName}}.CreatedAt,
		UpdatedAt: {{camelCase .EntityName}}.UpdatedAt,
		CreatedBy: {{camelCase .EntityName}}.CreatedBy,
		UpdatedBy: {{camelCase .EntityName}}.UpdatedBy,
	}
}

{{comment (printf "ToSQLC%sUpdate converts a domain %s to SQLC update params" .EntityName (lowerCase .EntityName))}}
func ToSQLC{{.EntityName}}Update({{camelCase .EntityName}} *domain.{{.EntityName}}) sqlc.Update{{.EntityName}}Params {
	return sqlc.Update{{.EntityName}}Params{
		ID:       {{camelCase .EntityName}}.ID,
		TenantID: {{camelCase .EntityName}}.TenantID,
		
		{{.EntityName}}Name:        &{{camelCase .EntityName}}.{{.EntityName}}Name,
		{{.EntityName}}Description: {{camelCase .EntityName}}.{{.EntityName}}Description,
		{{.EntityName}}Type:        &{{camelCase .EntityName}}.{{.EntityName}}Type,
		{{.EntityName}}Category:    {{camelCase .EntityName}}.{{.EntityName}}Category,
		
		Status: (*string)(&{{camelCase .EntityName}}.Status),
		
		IsActive:           &{{camelCase .EntityName}}.IsActive,
		DisplayOrder:       &{{camelCase .EntityName}}.DisplayOrder,
		ShowInReports:      &{{camelCase .EntityName}}.ShowInReports,
		ReportCategory:     {{camelCase .EntityName}}.ReportCategory,
		AllowManualEntries: &{{camelCase .EntityName}}.AllowManualEntries,
		
		UpdatedBy: {{camelCase .EntityName}}.UpdatedBy,
	}
}

{{comment (printf "ToSQLCFilter converts a domain %sFilter to SQLC list params" .EntityName)}}
func ToSQLCFilter(filter *domain.{{.EntityName}}Filter, tenantID uuid.UUID) sqlc.List{{.EntityNamePlural}}Params {
	params := sqlc.List{{.EntityNamePlural}}Params{
		TenantID: tenantID,
		Limit:    filter.GetLimit(),
		Offset:   filter.GetOffset(),
	}
	
	if filter.EntityID != nil {
		params.EntityID = filter.EntityID
	}
	
	if filter.IsActive != nil {
		params.IsActive = filter.IsActive
	}
	
	if filter.{{.EntityName}}Code != nil {
		params.{{.EntityName}}Code = filter.{{.EntityName}}Code
	}
	
	if filter.{{.EntityName}}Name != nil {
		params.{{.EntityName}}Name = filter.{{.EntityName}}Name
	}
	
	return params
}

// =============================================================================
// SQLC TO DOMAIN MAPPERS
// =============================================================================

{{comment (printf "FromSQLC%s converts a SQLC %s to domain model" .EntityName (lowerCase .EntityName))}}
func FromSQLC{{.EntityName}}(row sqlc.{{.EntityName}}) *domain.{{.EntityName}} {
	return &domain.{{.EntityName}}{
		ID:       row.ID,
		TenantID: row.TenantID,
		EntityID: row.EntityID,
		
		{{.EntityName}}Code:        row.{{.EntityName}}Code,
		{{.EntityName}}Name:        row.{{.EntityName}}Name,
		{{.EntityName}}Description: row.{{.EntityName}}Description,
		{{.EntityName}}Type:        row.{{.EntityName}}Type,
		{{.EntityName}}Category:    row.{{.EntityName}}Category,
		
		Status: domain.{{.EntityName}}Status(row.Status),
		
		{{- if contains .ModuleName "finance"}}
		ParentID:    row.ParentID,
		Level:       row.Level,
		Path:        row.Path,
		HasChildren: row.HasChildren,
		{{- end}}
		
		IsActive:           row.IsActive,
		IsSystemDefined:    row.IsSystemDefined,
		AllowManualEntries: row.AllowManualEntries,
		
		DisplayOrder:   row.DisplayOrder,
		ShowInReports:  row.ShowInReports,
		ReportCategory: row.ReportCategory,
		
		Version:            row.Version,
		LastValidationRun:  row.LastValidationRun,
		ValidationStatus:   domain.ValidationStatus(row.ValidationStatus),
		
		CreatedAt: row.CreatedAt,
		UpdatedAt: row.UpdatedAt,
		DeletedAt: row.DeletedAt,
		CreatedBy: row.CreatedBy,
		UpdatedBy: row.UpdatedBy,
	}
}

{{comment (printf "FromSQLC%sList converts a slice of SQLC %s to domain models" .EntityName (pluralize (lowerCase .EntityName)))}}
func FromSQLC{{.EntityName}}List(rows []sqlc.{{.EntityName}}) []*domain.{{.EntityName}} {
	{{pluralize (camelCase .EntityName)}} := make([]*domain.{{.EntityName}}, len(rows))
	for i, row := range rows {
		{{pluralize (camelCase .EntityName)}}[i] = FromSQLC{{.EntityName}}(row)
	}
	return {{pluralize (camelCase .EntityName)}}
}

// =============================================================================
// REQUEST MAPPERS
// =============================================================================

{{comment (printf "FromCreate%sRequest converts a create request to domain model" .EntityName)}}
func FromCreate{{.EntityName}}Request(req *domain.Create{{.EntityName}}Request, tenantID, createdBy uuid.UUID) *domain.{{.EntityName}} {
	{{camelCase .EntityName}} := &domain.{{.EntityName}}{
		ID:       uuid.New(),
		TenantID: tenantID,
		EntityID: req.EntityID,
		
		{{.EntityName}}Code:        req.{{.EntityName}}Code,
		{{.EntityName}}Name:        req.{{.EntityName}}Name,
		{{.EntityName}}Description: req.{{.EntityName}}Description,
		{{.EntityName}}Type:        req.{{.EntityName}}Type,
		{{.EntityName}}Category:    req.{{.EntityName}}Category,
		
		Status: domain.{{.EntityName}}StatusActive, // Default status
		
		{{- if contains .ModuleName "finance"}}
		ParentID: req.ParentID,
		Level:    1, // Will be calculated if parent exists
		{{- end}}
		
		IsActive:           req.IsActive,
		IsSystemDefined:    false, // User-created entities are not system-defined
		AllowManualEntries: true,  // Default to allowing manual entries
		
		DisplayOrder:  getDisplayOrder(req.DisplayOrder),
		ShowInReports: getShowInReports(req.ShowInReports),
		ReportCategory: req.ReportCategory,
		
		Version:          1,
		ValidationStatus: domain.ValidationStatusPending,
		
		CreatedBy: createdBy,
	}
	
	// Apply optional configuration
	if req.AllowManualEntries != nil {
		{{camelCase .EntityName}}.AllowManualEntries = *req.AllowManualEntries
	}
	
	return {{camelCase .EntityName}}
}

{{comment (printf "ApplyUpdate%sRequest applies update request changes to existing domain model" .EntityName)}}
func ApplyUpdate{{.EntityName}}Request({{camelCase .EntityName}} *domain.{{.EntityName}}, req *domain.Update{{.EntityName}}Request, updatedBy uuid.UUID) {
	// Update only provided fields
	if req.{{.EntityName}}Name != nil {
		{{camelCase .EntityName}}.{{.EntityName}}Name = *req.{{.EntityName}}Name
	}
	
	if req.{{.EntityName}}Description != nil {
		{{camelCase .EntityName}}.{{.EntityName}}Description = req.{{.EntityName}}Description
	}
	
	if req.{{.EntityName}}Type != nil {
		{{camelCase .EntityName}}.{{.EntityName}}Type = *req.{{.EntityName}}Type
	}
	
	if req.{{.EntityName}}Category != nil {
		{{camelCase .EntityName}}.{{.EntityName}}Category = req.{{.EntityName}}Category
	}
	
	{{- if contains .ModuleName "finance"}}
	if req.ParentID != nil {
		{{camelCase .EntityName}}.ParentID = req.ParentID
		// Note: Level and Path should be recalculated when parent changes
	}
	{{- end}}
	
	if req.IsActive != nil {
		{{camelCase .EntityName}}.IsActive = *req.IsActive
	}
	
	if req.DisplayOrder != nil {
		{{camelCase .EntityName}}.DisplayOrder = *req.DisplayOrder
	}
	
	if req.ShowInReports != nil {
		{{camelCase .EntityName}}.ShowInReports = *req.ShowInReports
	}
	
	if req.ReportCategory != nil {
		{{camelCase .EntityName}}.ReportCategory = req.ReportCategory
	}
	
	if req.AllowManualEntries != nil {
		{{camelCase .EntityName}}.AllowManualEntries = *req.AllowManualEntries
	}
	
	// Always update metadata
	{{camelCase .EntityName}}.UpdatedBy = &updatedBy
	{{camelCase .EntityName}}.Version++
	{{camelCase .EntityName}}.ValidationStatus = domain.ValidationStatusPending
}

