package service

import (
	"context"

	"github.com/google/uuid"
	"awo/internal/core/{{.PackageName}}/domain"
)

{{comment (printf "%sService defines the interface for %s business operations" .EntityName (lowerCase .EntityName))}}
type {{.EntityName}}Service interface {
	{{comment "Core CRUD operations"}}
	Create{{.EntityName}}(ctx context.Context, req domain.Create{{.EntityName}}Request) (*domain.{{.EntityName}}, error)
	Get{{.EntityName}}ByID(ctx context.Context, id uuid.UUID) (*domain.{{.EntityName}}, error)
	Get{{.EntityName}}ByCode(ctx context.Context, code string) (*domain.{{.EntityName}}, error)
	Update{{.EntityName}}(ctx context.Context, id uuid.UUID, req domain.Update{{.EntityName}}Request) (*domain.{{.EntityName}}, error)
	Delete{{.EntityName}}(ctx context.Context, id uuid.UUID) error
	
	{{comment "List and search operations"}}
	List{{.EntityNamePlural}}(ctx context.Context, filter *domain.{{.EntityName}}Filter) ([]*domain.{{.EntityName}}, error)
	Search{{.EntityNamePlural}}(ctx context.Context, query string, limit int) ([]*domain.{{.EntityName}}, error)
	GetActive{{.EntityNamePlural}}(ctx context.Context) ([]*domain.{{.EntityName}}, error)
	
	{{comment "Validation operations"}}
	Validate{{.EntityName}}Code(ctx context.Context, code string, excludeID *uuid.UUID) error
	Validate{{.EntityName}}(ctx context.Context, {{camelCase .EntityName}} *domain.{{.EntityName}}) error
	
	{{comment "Business operations"}}
	Activate{{.EntityName}}(ctx context.Context, id uuid.UUID) error
	Deactivate{{.EntityName}}(ctx context.Context, id uuid.UUID) error
	{{- if contains .ModuleName "finance"}}
	
	{{comment "Financial operations"}}
	GetBalance(ctx context.Context, id uuid.UUID) (*domain.{{.EntityName}}Balance, error)
	UpdateBalance(ctx context.Context, id uuid.UUID, balance *domain.{{.EntityName}}Balance) error
	{{- end}}
	
	{{comment "Hierarchy operations (if applicable)"}}
	Get{{.EntityName}}Hierarchy(ctx context.Context, rootID uuid.UUID) ([]*domain.{{.EntityName}}, error)
	Get{{.EntityName}}Children(ctx context.Context, parentID uuid.UUID) ([]*domain.{{.EntityName}}, error)
	Move{{.EntityName}}(ctx context.Context, id uuid.UUID, newParentID *uuid.UUID) error
	
	{{comment "Bulk operations"}}
	Create{{.EntityNamePlural}}Bulk(ctx context.Context, requests []domain.Create{{.EntityName}}Request) ([]*domain.{{.EntityName}}, error)
	Update{{.EntityNamePlural}}Bulk(ctx context.Context, updates map[uuid.UUID]domain.Update{{.EntityName}}Request) ([]*domain.{{.EntityName}}, error)
	Delete{{.EntityNamePlural}}Bulk(ctx context.Context, ids []uuid.UUID) error
	
	{{comment "Status management"}}
	Change{{.EntityName}}Status(ctx context.Context, id uuid.UUID, status domain.{{.EntityName}}Status, reason string) error
	Get{{.EntityNamePlural}}ByStatus(ctx context.Context, status domain.{{.EntityName}}Status) ([]*domain.{{.EntityName}}, error)
	
	{{comment "Audit and reporting"}}
	Get{{.EntityName}}AuditTrail(ctx context.Context, id uuid.UUID) ([]*domain.AuditEntry, error)
	Get{{.EntityName}}UsageStats(ctx context.Context, id uuid.UUID) (*domain.UsageStats, error)
	
	{{comment "Import/Export operations"}}
	Export{{.EntityNamePlural}}(ctx context.Context, filter *domain.{{.EntityName}}Filter, format string) ([]byte, error)
	Import{{.EntityNamePlural}}(ctx context.Context, data []byte, format string) ([]*domain.{{.EntityName}}, error)
	Validate{{.EntityNamePlural}}Import(ctx context.Context, data []byte, format string) ([]domain.ValidationError, error)
}

{{comment (printf "%sServiceExtended defines extended operations for %s management" .EntityName (lowerCase .EntityName))}}
type {{.EntityName}}ServiceExtended interface {
	{{.EntityName}}Service
	
	{{comment "Advanced analytics"}}
	Get{{.EntityName}}Analytics(ctx context.Context, filter *domain.{{.EntityName}}AnalyticsFilter) (*domain.{{.EntityName}}Analytics, error)
	Get{{.EntityName}}Trends(ctx context.Context, period string) (*domain.{{.EntityName}}Trends, error)
	
	{{comment "Workflow integration"}}
	Submit{{.EntityName}}ForApproval(ctx context.Context, id uuid.UUID, approvalRequest *domain.ApprovalRequest) error
	Approve{{.EntityName}}(ctx context.Context, id uuid.UUID, approvalDecision *domain.ApprovalDecision) error
	Reject{{.EntityName}}(ctx context.Context, id uuid.UUID, rejectionReason string) error
	
	{{comment "Template operations"}}
	Create{{.EntityName}}Template(ctx context.Context, {{camelCase .EntityName}}ID uuid.UUID, templateName string) (*domain.{{.EntityName}}Template, error)
	Apply{{.EntityName}}Template(ctx context.Context, templateID uuid.UUID, customizations map[string]any) (*domain.{{.EntityName}}, error)
	
	{{comment "Integration hooks"}}
	Register{{.EntityName}}Hook(ctx context.Context, eventType string, handler func(ctx context.Context, event *domain.{{.EntityName}}Event) error) error
	Trigger{{.EntityName}}Event(ctx context.Context, event *domain.{{.EntityName}}Event) error
}

{{comment (printf "%sRepository defines the data access interface for %s" .EntityName (lowerCase .EntityName))}}
type {{.EntityName}}Repository interface {
	{{comment "Basic CRUD operations"}}
	Create(ctx context.Context, {{camelCase .EntityName}} *domain.{{.EntityName}}) error
	GetByID(ctx context.Context, id uuid.UUID) (*domain.{{.EntityName}}, error)
	GetByCode(ctx context.Context, entityID *uuid.UUID, code string) (*domain.{{.EntityName}}, error)
	Update(ctx context.Context, {{camelCase .EntityName}} *domain.{{.EntityName}}) error
	Delete(ctx context.Context, id uuid.UUID) error
	
	{{comment "Query operations"}}
	List(ctx context.Context, filter *domain.{{.EntityName}}Filter) ([]*domain.{{.EntityName}}, error)
	Count(ctx context.Context, filter *domain.{{.EntityName}}Filter) (int64, error)
	Search(ctx context.Context, query string, limit int) ([]*domain.{{.EntityName}}, error)
	
	{{comment "Existence checks"}}
	Exists(ctx context.Context, id uuid.UUID) (bool, error)
	ExistsByCode(ctx context.Context, entityID *uuid.UUID, code string) (bool, error)
	
	{{comment "Validation helpers"}}
	ValidateCode(ctx context.Context, code string, excludeID *uuid.UUID) error
	ValidateUniqueConstraints(ctx context.Context, {{camelCase .EntityName}} *domain.{{.EntityName}}) error
	
	{{comment "Hierarchy operations"}}
	GetHierarchy(ctx context.Context, rootID uuid.UUID) ([]*domain.{{.EntityName}}, error)
	GetChildren(ctx context.Context, parentID uuid.UUID) ([]*domain.{{.EntityName}}, error)
	GetDescendants(ctx context.Context, ancestorID uuid.UUID) ([]*domain.{{.EntityName}}, error)
	GetAncestors(ctx context.Context, descendantID uuid.UUID) ([]*domain.{{.EntityName}}, error)
	
	{{comment "Status and filtering"}}
	GetByStatus(ctx context.Context, status domain.{{.EntityName}}Status) ([]*domain.{{.EntityName}}, error)
	GetActive(ctx context.Context, entityID *uuid.UUID) ([]*domain.{{.EntityName}}, error)
	GetInactive(ctx context.Context, entityID *uuid.UUID) ([]*domain.{{.EntityName}}, error)
	
	{{comment "Business rule checks"}}
	HasDependencies(ctx context.Context, id uuid.UUID) (bool, error)
	HasChildren(ctx context.Context, id uuid.UUID) (bool, error)
	{{- if or (contains .ModuleName "finance") (contains .ModuleName "account")}}
	HasTransactions(ctx context.Context, id uuid.UUID) (bool, error)
	GetBalance(ctx context.Context, id uuid.UUID) (*domain.{{.EntityName}}Balance, error)
	UpdateBalance(ctx context.Context, id uuid.UUID, balance *domain.{{.EntityName}}Balance) error
	{{- end}}
	
	{{comment "Batch operations"}}
	CreateBatch(ctx context.Context, {{pluralize (camelCase .EntityName)}} []*domain.{{.EntityName}}) error
	UpdateBatch(ctx context.Context, {{pluralize (camelCase .EntityName)}} []*domain.{{.EntityName}}) error
	DeleteBatch(ctx context.Context, ids []uuid.UUID) error
	
	{{comment "Audit operations"}}
	GetAuditTrail(ctx context.Context, id uuid.UUID) ([]*domain.AuditEntry, error)
	RecordAuditEntry(ctx context.Context, entry *domain.AuditEntry) error
}

