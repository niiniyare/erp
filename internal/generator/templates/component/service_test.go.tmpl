func Test{{.ComponentNamePascal}}Service_Create{{.EntityNamePascal}}_Success(t *testing.T) {
	service, mockRepo := setup{{.ComponentNamePascal}}ServiceTest()
	ctx := context.Background()
	
	req := domain.Create{{.EntityNamePascal}}Request{
		Name:        "Test {{.EntityNamePascal}}",
		Description: stringPtr("Test description"),
	}
	
	mockRepo.On("Create", ctx, mock.AnythingOfType("*domain.{{.EntityNamePascal}}")).Return(nil)
	
	result, err := service.Create{{.EntityNamePascal}}(ctx, req)
	
	require.NoError(t, err)
	assert.NotNil(t, result)
	assert.Equal(t, req.Name, result.Name)
	assert.Equal(t, req.Description, result.Description)
	assert.Equal(t, domain.{{.EntityNamePascal}}StatusActive, result.Status)
	assert.NotEmpty(t, result.ID)
	
	mockRepo.AssertExpectations(t)
}

