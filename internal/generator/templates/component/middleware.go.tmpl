// validateHeaders validates required headers
func (m *{{.ComponentNamePascal}}Middleware) validateHeaders(c *fiber.Ctx) error {
	// Validate required headers
	requiredHeaders := []string{
		"Content-Type",
		"Accept",
	}
	
	for _, header := range requiredHeaders {
		if c.Get(header) == "" {
			return fiber.NewError(fiber.StatusBadRequest, "Missing required header: "+header)
		}
	}
	
	return nil
}

// validateContentType validates the content type for requests with body
func (m *{{.ComponentNamePascal}}Middleware) validateContentType(c *fiber.Ctx) error {
	contentType := c.Get("Content-Type")
	if contentType != "application/json" {
		return fiber.NewError(fiber.StatusUnsupportedMediaType, "Content-Type must be application/json")
	}
	return nil
}