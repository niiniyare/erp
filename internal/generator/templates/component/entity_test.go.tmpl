			}
			require.NoError(t, err)
			assert.Equal(t, tt.want, got)
		})
	}
}

func Test{{.EntityNamePascal}}_Validate(t *testing.T) {
	now := time.Now()
	validID := domain.New{{.EntityNamePascal}}ID()
	
	tests := []struct {
		name     string
		{{.EntityNameCamel}} *domain.{{.EntityNamePascal}}
		wantErr  bool
	}{
