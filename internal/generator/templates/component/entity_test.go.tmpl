func Test{{.EntityNamePascal}}Filter_ApplyDefaults(t *testing.T) {
	filter := &domain.{{.EntityNamePascal}}Filter{}
	filter.ApplyDefaults()
	
	assert.Equal(t, int64(20), filter.Limit)
	assert.Equal(t, int64(0), filter.Offset)
	assert.NotNil(t, filter.SortBy)
	assert.Equal(t, "created_at", *filter.SortBy)
	assert.NotNil(t, filter.SortOrder)
	assert.Equal(t, "desc", *filter.SortOrder)
}

