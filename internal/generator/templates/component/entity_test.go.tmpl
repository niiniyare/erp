func Test{{.EntityNamePascal}}_ParseID(t *testing.T) {
	validID := domain.New{{.EntityNamePascal}}ID()
	
	tests := []struct {
		name    string
		input   string
		want    domain.{{.EntityNamePascal}}ID
		wantErr bool
	}{
		{
			name:    "valid UUID string",
			input:   validID.String(),
			want:    validID,
			wantErr: false,
		},
		{
			name:    "invalid UUID string",
			input:   "invalid-uuid",
			want:    domain.{{.EntityNamePascal}}ID{},
			wantErr: true,
		},
		{
			name:    "empty string",
			input:   "",
			want:    domain.{{.EntityNamePascal}}ID{},
			wantErr: true,
		},
	}
	
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got, err := domain.Parse{{.EntityNamePascal}}ID(tt.input)
			if tt.wantErr {
				assert.Error(t, err)
				return
			}
			require.NoError(t, err)
			assert.Equal(t, tt.want, got)
		})
	}
}

func Test{{.EntityNamePascal}}_Status(t *testing.T) {
	tests := []struct {
		name   string
		status string
		want   domain.{{.EntityNamePascal}}Status
		valid  bool
	}{
		{
			name:   "active status",
			status: "active",
			want:   domain.{{.EntityNamePascal}}StatusActive,
			valid:  true,
		},
		{
			name:   "inactive status",
			status: "inactive",
			want:   domain.{{.EntityNamePascal}}StatusInactive,
			valid:  true,
		},
		{
			name:   "pending status",
			status: "pending",
			want:   domain.{{.EntityNamePascal}}StatusPending,
			valid:  true,
		},
		{
			name:   "archived status",
			status: "archived",
			want:   domain.{{.EntityNamePascal}}StatusArchived,
			valid:  true,
		},
		{
			name:   "invalid status",
			status: "unknown",
			want:   domain.{{.EntityNamePascal}}Status(""),
			valid:  false,
		},
	}
	
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got, err := domain.Parse{{.EntityNamePascal}}Status(tt.status)
			if !tt.valid {
				assert.Error(t, err)
