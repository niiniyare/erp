				ID:        validID,
				Name:      "Test {{.EntityNamePascal}}",
				Status:    domain.{{.EntityNamePascal}}StatusActive,
				CreatedAt: now,
				UpdatedAt: now,
				TenantID:  "tenant-123",
			},
			wantErr: false,
		},
		{
			name: "missing name",
			{{.EntityNameCamel}}: &domain.{{.EntityNamePascal}}{
				ID:        validID,
				Name:      "",
				Status:    domain.{{.EntityNamePascal}}StatusActive,
				CreatedAt: now,
				UpdatedAt: now,
				TenantID:  "tenant-123",
			},
			wantErr: true,
		},
		{
			name: "invalid status",
			{{.EntityNameCamel}}: &domain.{{.EntityNamePascal}}{
				ID:        validID,
				Name:      "Test {{.EntityNamePascal}}",
				Status:    domain.{{.EntityNamePascal}}Status("invalid"),
				CreatedAt: now,
				UpdatedAt: now,
				TenantID:  "tenant-123",
			},
			wantErr: true,
		},
		{
			name: "missing tenant ID",
			{{.EntityNameCamel}}: &domain.{{.EntityNamePascal}}{
				ID:        validID,
				Name:      "Test {{.EntityNamePascal}}",
				Status:    domain.{{.EntityNamePascal}}StatusActive,
				CreatedAt: now,
				UpdatedAt: now,
				TenantID:  "",
			},
			wantErr: true,
		},
		{
			name: "name too long",
			{{.EntityNameCamel}}: &domain.{{.EntityNamePascal}}{
				ID:        validID,
				Name:      string(make([]byte, 256)), // Too long
				Status:    domain.{{.EntityNamePascal}}StatusActive,
				CreatedAt: now,
				UpdatedAt: now,
				TenantID:  "tenant-123",
			},
			wantErr: true,
		},
	}
	
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			err := tt.{{.EntityNameCamel}}.Validate()
			if tt.wantErr {
				assert.Error(t, err)
			} else {
				assert.NoError(t, err)
			}
		})
	}
}

