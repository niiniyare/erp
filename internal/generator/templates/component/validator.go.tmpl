// {{.ComponentNamePascal}}Validator provides validation for {{.ComponentName}}-related operations
type {{.ComponentNamePascal}}Validator struct {
	validator *validator.Validate
}

// New{{.ComponentNamePascal}}Validator creates a new {{.ComponentNamePascal}}Validator
func New{{.ComponentNamePascal}}Validator() *{{.ComponentNamePascal}}Validator {
	v := validator.New()
	
	// Register custom validation functions
	v.RegisterValidation("{{.ComponentNameSnake}}_name", validate{{.ComponentNamePascal}}Name)
	v.RegisterValidation("{{.ComponentNameSnake}}_status", validate{{.ComponentNamePascal}}Status)
	
	return &{{.ComponentNamePascal}}Validator{
		validator: v,
	}
}

// ValidateCreate{{.EntityNamePascal}} validates a create {{.EntityNameCamel}} request
func (v *{{.ComponentNamePascal}}Validator) ValidateCreate{{.EntityNamePascal}}(req Create{{.EntityNamePascal}}Request) error {
	if err := v.validator.Struct(req); err != nil {
		return v.formatValidationError(err)
	}

	// Additional business rule validations
	if err := v.validateBusinessRules(req.Name, req.Description); err != nil {
		return err
	}

	return nil
}

// ValidateUpdate{{.EntityNamePascal}} validates an update {{.EntityNameCamel}} request
func (v *{{.ComponentNamePascal}}Validator) ValidateUpdate{{.EntityNamePascal}}(req Update{{.EntityNamePascal}}Request) error {
	if err := v.validator.Struct(req); err != nil {
		return v.formatValidationError(err)
	}

	// Additional business rule validations
	if req.Name != nil {
		if err := v.validateBusinessRules(*req.Name, req.Description); err != nil {
			return err
		}
	}

	return nil
}

// Validate{{.EntityNamePascal}}Filter validates a {{.EntityNameCamel}} filter
func (v *{{.ComponentNamePascal}}Validator) Validate{{.EntityNamePascal}}Filter(filter {{.EntityNamePascal}}Filter) error {
	filter.ApplyDefaults()
	return v.validator.Struct(filter)
}

// validateBusinessRules validates business-specific rules
func (v *{{.ComponentNamePascal}}Validator) validateBusinessRules(name string, description *string) error {
	// Validate name format
	if err := v.validateNameFormat(name); err != nil {
		return err
	}

	// Validate description if provided
	if description != nil && *description != "" {
		if err := v.validateDescriptionFormat(*description); err != nil {
			return err
		}
	}

	return nil
}

// validateNameFormat validates the name format
func (v *{{.ComponentNamePascal}}Validator) validateNameFormat(name string) error {
	// Remove leading/trailing whitespace
	name = strings.TrimSpace(name)

	// Check if empty after trimming
	if name == "" {
		return fmt.Errorf("name cannot be empty or only whitespace")
	}

	// Check for invalid characters
	if !v.isValidNameCharacters(name) {
		return fmt.Errorf("name contains invalid characters (only letters, numbers, spaces, hyphens, and underscores allowed)")
	}

	// Check for reserved names
	if v.isReservedName(name) {
		return fmt.Errorf("name '%s' is reserved and cannot be used", name)
	}

	return nil
}

// validateDescriptionFormat validates the description format
func (v *{{.ComponentNamePascal}}Validator) validateDescriptionFormat(description string) error {
	// Remove leading/trailing whitespace
	description = strings.TrimSpace(description)

	// Check for minimum meaningful length
	if len(description) > 0 && len(description) < 3 {
		return fmt.Errorf("description must be at least 3 characters long if provided")
	}

	// Check for excessive repetition
	if v.hasExcessiveRepetition(description) {
		return fmt.Errorf("description contains excessive character repetition")
	}

	return nil
}

// isValidNameCharacters checks if the name contains only valid characters
func (v *{{.ComponentNamePascal}}Validator) isValidNameCharacters(name string) bool {
	for _, r := range name {
		if !unicode.IsLetter(r) && !unicode.IsDigit(r) && r != ' ' && r != '-' && r != '_' {
			return false
		}
	}
	return true
}

// isReservedName checks if the name is in the reserved list
func (v *{{.ComponentNamePascal}}Validator) isReservedName(name string) bool {
	reserved := []string{
		"admin", "root", "system", "default", "null", "undefined",
		"true", "false", "test", "temp", "temporary", "sample",
	}

	lowerName := strings.ToLower(strings.TrimSpace(name))
	for _, reservedName := range reserved {
		if lowerName == reservedName {
			return true
		}
	}
	return false
}

// hasExcessiveRepetition checks for excessive character repetition
func (v *{{.ComponentNamePascal}}Validator) hasExcessiveRepetition(text string) bool {
	// Check for more than 3 consecutive identical characters
	pattern := `(.)\1{3,}`
	matched, _ := regexp.MatchString(pattern, text)
	return matched
}

// formatValidationError formats validation errors into user-friendly messages
func (v *{{.ComponentNamePascal}}Validator) formatValidationError(err error) error {
	if validationErrors, ok := err.(validator.ValidationErrors); ok {
		var messages []string
		for _, fieldError := range validationErrors {
			message := v.getFieldErrorMessage(fieldError)
			messages = append(messages, message)
		}
		return fmt.Errorf("validation failed: %s", strings.Join(messages, "; "))
	}
	return err
}

// getFieldErrorMessage returns a user-friendly error message for a field validation error
func (v *{{.ComponentNamePascal}}Validator) getFieldErrorMessage(fieldError validator.FieldError) string {
	field := fieldError.Field()
	tag := fieldError.Tag()
	param := fieldError.Param()

	switch tag {
	case "required":
		return fmt.Sprintf("%s is required", field)
	case "min":
		return fmt.Sprintf("%s must be at least %s characters long", field, param)
	case "max":
		return fmt.Sprintf("%s must be at most %s characters long", field, param)
	case "{{.ComponentNameSnake}}_name":
		return fmt.Sprintf("%s has invalid format", field)
	case "{{.ComponentNameSnake}}_status":
		return fmt.Sprintf("%s has invalid status value", field)
	case "oneof":
		return fmt.Sprintf("%s must be one of: %s", field, param)
	default:
		return fmt.Sprintf("%s is invalid", field)
	}
}

