// List lists {{.EntityNamePlural}} with filtering and pagination
func (r *{{.ComponentNamePascal}}Repository) List(ctx context.Context, filter domain.{{.EntityNamePascal}}Filter) ([]domain.{{.EntityNamePascal}}, *domain.PaginationResult, error) {
	ctx, span := r.tracer.Start(ctx, "{{.ComponentNamePascal}}Repository.List")
	defer span.End()

	// Build query with filters
	baseQuery := `
		SELECT id, name, description, status, 
			   created_at, updated_at, tenant_id
		FROM {{.ModuleNameSnake}}_{{.ComponentNameSnake}}
		WHERE tenant_id = current_tenant_id()`
	
	countQuery := `
		SELECT COUNT(*)
		FROM {{.ModuleNameSnake}}_{{.ComponentNameSnake}}
		WHERE tenant_id = current_tenant_id()`

	var conditions []string
	var args []interface{}
	argIndex := 1

	// Add status filter
	if filter.Status != nil {
		conditions = append(conditions, fmt.Sprintf("status = $%d", argIndex))
		args = append(args, *filter.Status)
		argIndex++
	}

	// Add name filter
	if filter.Name != nil {
		conditions = append(conditions, fmt.Sprintf("name ILIKE $%d", argIndex))
		args = append(args, "%"+*filter.Name+"%")
		argIndex++
	}

	// Apply conditions
	if len(conditions) > 0 {
		conditionStr := " AND " + fmt.Sprintf("(%s)", fmt.Sprintf(" AND %s", conditions))
		baseQuery += conditionStr
		countQuery += conditionStr
	}

	// Get total count
	var totalCount int64
	err := r.db.QueryRowContext(ctx, countQuery, args...).Scan(&totalCount)
	if err != nil {
		r.logger.Error("Failed to get {{.EntityNameCamel}} count", "error", err)
		span.RecordError(err)
		return nil, nil, errors.NewInternalError("failed to count {{.EntityNamePlural}}", err)
	}

	// Add pagination
	baseQuery += fmt.Sprintf(" ORDER BY created_at DESC LIMIT $%d OFFSET $%d", argIndex, argIndex+1)
	args = append(args, filter.Limit, filter.Offset)

	// Execute query
	rows, err := r.db.QueryContext(ctx, baseQuery, args...)
	if err != nil {
		r.logger.Error("Failed to list {{.EntityNamePlural}}", "error", err)
		span.RecordError(err)
		return nil, nil, errors.NewInternalError("failed to list {{.EntityNamePlural}}", err)
	}
	defer rows.Close()

	var {{.EntityNamePlural}} []domain.{{.EntityNamePascal}}
	for rows.Next() {
		var {{.EntityNameCamel}} domain.{{.EntityNamePascal}}
		err := rows.Scan(
			&{{.EntityNameCamel}}.ID,
			&{{.EntityNameCamel}}.Name,
			&{{.EntityNameCamel}}.Description,
			&{{.EntityNameCamel}}.Status,
			&{{.EntityNameCamel}}.CreatedAt,
			&{{.EntityNameCamel}}.UpdatedAt,
			&{{.EntityNameCamel}}.TenantID,
		)
		if err != nil {
			r.logger.Error("Failed to scan {{.EntityNameCamel}} row", "error", err)
			span.RecordError(err)
			return nil, nil, errors.NewInternalError("failed to scan {{.EntityNameCamel}}", err)
		}
		{{.EntityNamePlural}} = append({{.EntityNamePlural}}, {{.EntityNameCamel}})
	}

	if err = rows.Err(); err != nil {
		r.logger.Error("Error iterating {{.EntityNameCamel}} rows", "error", err)
		span.RecordError(err)
		return nil, nil, errors.NewInternalError("failed to iterate {{.EntityNamePlural}}", err)
	}

	// Calculate pagination
	pagination := &domain.PaginationResult{
		Total:       totalCount,
		Count:       int64(len({{.EntityNamePlural}})),
		Limit:       filter.Limit,
		Offset:      filter.Offset,
		HasNext:     filter.Offset+filter.Limit < totalCount,
		HasPrevious: filter.Offset > 0,
	}

	span.SetAttributes(attribute.Int("{{.EntityNameSnake}}.count", len({{.EntityNamePlural}})))
	return {{.EntityNamePlural}}, pagination, nil
}
