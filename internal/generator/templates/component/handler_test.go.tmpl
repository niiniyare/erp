	{{.EntityNamePlural}} := []domain.{{.EntityNamePascal}}{
		*createTest{{.EntityNamePascal}}(),
	}
	
	pagination := &domain.PaginationResult{
		Total:       1,
		Count:       1,
		Limit:       10,
		Offset:      0,
		HasNext:     false,
		HasPrevious: false,
	}
	
	mockService.On("List{{.EntityNamePlural}}", mock.Anything, mock.MatchedBy(func(filter domain.{{.EntityNamePascal}}Filter) bool {
		return filter.Limit == 10 && filter.Offset == 0 && 
			   filter.Status != nil && *filter.Status == domain.{{.EntityNamePascal}}StatusActive &&
			   filter.Name != nil && *filter.Name == "test"
	})).Return({{.EntityNamePlural}}, pagination, nil)
	
	req := httptest.NewRequest(http.MethodGet, "/api/v1/{{.ModuleNameKebab}}/{{.ComponentNameKebab}}/?limit=10&offset=0&status=active&name=test", nil)
	
	resp, err := app.Test(req)
	require.NoError(t, err)
	
	assert.Equal(t, http.StatusOK, resp.StatusCode)
	
	mockService.AssertExpectations(t)
}

