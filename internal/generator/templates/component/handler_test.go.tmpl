func setup{{.ComponentNamePascal}}HandlerTest() (*fiber.App, *handlers.{{.ComponentNamePascal}}Handler, *Mock{{.ComponentNamePascal}}Service) {
	app := fiber.New()
	
	mockService := &Mock{{.ComponentNamePascal}}Service{}
	logger := logging.NewNopLogger()
	tracer := tracing.NewNopTracer()
	
	handler := handlers.New{{.ComponentNamePascal}}Handler(mockService, logger, tracer)
	
	// Setup routes
	api := app.Group("/api/v1")
	{{.ComponentNameSnake}} := api.Group("/{{.ModuleNameKebab}}/{{.ComponentNameKebab}}")
	{{.ComponentNameSnake}}.Post("/", handler.Create{{.EntityNamePascal}})
	{{.ComponentNameSnake}}.Get("/:id", handler.Get{{.EntityNamePascal}})
	{{.ComponentNameSnake}}.Put("/:id", handler.Update{{.EntityNamePascal}})
	{{.ComponentNameSnake}}.Delete("/:id", handler.Delete{{.EntityNamePascal}})
	{{.ComponentNameSnake}}.Get("/", handler.List{{.EntityNamePlural}})
	
	return app, handler, mockService
}

func createTest{{.EntityNamePascal}}() *domain.{{.EntityNamePascal}} {
	now := time.Now()
	return &domain.{{.EntityNamePascal}}{
		ID:          domain.New{{.EntityNamePascal}}ID(),
		Name:        "Test {{.EntityNamePascal}}",
		Description: stringPtr("Test description"),
		Status:      domain.{{.EntityNamePascal}}StatusActive,
		CreatedAt:   now,
		UpdatedAt:   now,
		TenantID:    "test-tenant-id",
	}
}

func Test{{.ComponentNamePascal}}Handler_Create{{.EntityNamePascal}}_Success(t *testing.T) {
	app, _, mockService := setup{{.ComponentNamePascal}}HandlerTest()
	
	payload := map[string]interface{}{
		"name":        "Test {{.EntityNamePascal}}",
		"description": "Test description",
	}
	
	expected{{.EntityNamePascal}} := createTest{{.EntityNamePascal}}()
	expected{{.EntityNamePascal}}.Name = payload["name"].(string)
	expected{{.EntityNamePascal}}.Description = stringPtr(payload["description"].(string))
	
	mockService.On("Create{{.EntityNamePascal}}", mock.Anything, mock.AnythingOfType("domain.Create{{.EntityNamePascal}}Request")).
		Return(expected{{.EntityNamePascal}}, nil)
	
	body, _ := json.Marshal(payload)
	req := httptest.NewRequest(http.MethodPost, "/api/v1/{{.ModuleNameKebab}}/{{.ComponentNameKebab}}/", bytes.NewReader(body))
	req.Header.Set("Content-Type", "application/json")
	
	resp, err := app.Test(req)
	require.NoError(t, err)
	
	assert.Equal(t, http.StatusCreated, resp.StatusCode)
	
	var response map[string]interface{}
	err = json.NewDecoder(resp.Body).Decode(&response)
	require.NoError(t, err)
	
	assert.Equal(t, expected{{.EntityNamePascal}}.ID.String(), response["id"])
	assert.Equal(t, expected{{.EntityNamePascal}}.Name, response["name"])
	
	mockService.AssertExpectations(t)
}

