	assert.Equal(t, test{{.EntityNamePascal}}.Name, result.Name)
	assert.Equal(t, test{{.EntityNamePascal}}.Description, result.Description)
	assert.Equal(t, test{{.EntityNamePascal}}.Status, result.Status)
	assert.NoError(t, mock.ExpectationsWereMet())
}

