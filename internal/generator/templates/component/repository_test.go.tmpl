func setup{{.ComponentNamePascal}}RepositoryTest(t *testing.T) (*repository.{{.ComponentNamePascal}}Repository, sqlmock.Sqlmock, func()) {
	db, mock, err := sqlmock.New()
	require.NoError(t, err)
	
	dbWrapper := &database.DB{DB: db}
	logger := logging.NewNopLogger()
	tracer := tracing.NewNopTracer()
	
	repo := repository.New{{.ComponentNamePascal}}Repository(dbWrapper, logger, tracer).(*repository.{{.ComponentNamePascal}}Repository)
	
	cleanup := func() {
		db.Close()
	}
	
	return repo, mock, cleanup
}

