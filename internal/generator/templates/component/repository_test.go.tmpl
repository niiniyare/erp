func Test{{.ComponentNamePascal}}Repository_List_Success(t *testing.T) {
	repo, mock, cleanup := setup{{.ComponentNamePascal}}RepositoryTest(t)
	defer cleanup()
	
	ctx := context.Background()
	filter := domain.{{.EntityNamePascal}}Filter{
		Limit:  20,
		Offset: 0,
	}
	
	// Mock count query
	countRows := sqlmock.NewRows([]string{"count"}).AddRow(2)
	mock.ExpectQuery(`SELECT COUNT`).
		WillReturnRows(countRows)
	
	// Mock list query
	test{{.EntityNamePascal}}1 := createTest{{.EntityNamePascal}}()
	test{{.EntityNamePascal}}2 := createTest{{.EntityNamePascal}}()
	test{{.EntityNamePascal}}2.ID = domain.New{{.EntityNamePascal}}ID()
	test{{.EntityNamePascal}}2.Name = "Test {{.EntityNamePascal}} 2"
	
	listRows := sqlmock.NewRows([]string{
		"id", "name", "description", "status", "created_at", "updated_at", "tenant_id",
	}).
		AddRow(
			test{{.EntityNamePascal}}1.ID.String(),
			test{{.EntityNamePascal}}1.Name,
			test{{.EntityNamePascal}}1.Description,
			string(test{{.EntityNamePascal}}1.Status),
			test{{.EntityNamePascal}}1.CreatedAt,
			test{{.EntityNamePascal}}1.UpdatedAt,
			test{{.EntityNamePascal}}1.TenantID,
		).
		AddRow(
			test{{.EntityNamePascal}}2.ID.String(),
			test{{.EntityNamePascal}}2.Name,
			test{{.EntityNamePascal}}2.Description,
			string(test{{.EntityNamePascal}}2.Status),
			test{{.EntityNamePascal}}2.CreatedAt,
			test{{.EntityNamePascal}}2.UpdatedAt,
			test{{.EntityNamePascal}}2.TenantID,
		)
	
	mock.ExpectQuery(`SELECT id, name, description, status, created_at, updated_at, tenant_id FROM {{.ModuleNameSnake}}_{{.ComponentNameSnake}}`).
		WithArgs(filter.Limit, filter.Offset).
		WillReturnRows(listRows)
	
	result, pagination, err := repo.List(ctx, filter)
	
	require.NoError(t, err)
	assert.Len(t, result, 2)
	assert.Equal(t, test{{.EntityNamePascal}}1.Name, result[0].Name)
	assert.Equal(t, test{{.EntityNamePascal}}2.Name, result[1].Name)
	
	assert.NotNil(t, pagination)
	assert.Equal(t, int64(2), pagination.Total)
	assert.Equal(t, int64(2), pagination.Count)
	assert.Equal(t, filter.Limit, pagination.Limit)
	assert.Equal(t, filter.Offset, pagination.Offset)
	assert.False(t, pagination.HasNext)
	assert.False(t, pagination.HasPrevious)
	
	assert.NoError(t, mock.ExpectationsWereMet())
}

func Test{{.ComponentNamePascal}}Repository_List_WithFilters(t *testing.T) {
	repo, mock, cleanup := setup{{.ComponentNamePascal}}RepositoryTest(t)
	defer cleanup()
	
	ctx := context.Background()
	status := domain.{{.EntityNamePascal}}StatusActive
	name := "Test"
	
	filter := domain.{{.EntityNamePascal}}Filter{
		Status: &status,
		Name:   &name,
		Limit:  10,
		Offset: 5,
	}
	
	// Mock count query with filters
	countRows := sqlmock.NewRows([]string{"count"}).AddRow(1)
	mock.ExpectQuery(`SELECT COUNT.*WHERE.*status.*name`).
		WithArgs(string(status), "%"+name+"%").
		WillReturnRows(countRows)
	
	// Mock list query with filters
	test{{.EntityNamePascal}} := createTest{{.EntityNamePascal}}()
	listRows := sqlmock.NewRows([]string{
		"id", "name", "description", "status", "created_at", "updated_at", "tenant_id",
	}).AddRow(
		test{{.EntityNamePascal}}.ID.String(),
		test{{.EntityNamePascal}}.Name,
		test{{.EntityNamePascal}}.Description,
		string(test{{.EntityNamePascal}}.Status),
		test{{.EntityNamePascal}}.CreatedAt,
		test{{.EntityNamePascal}}.UpdatedAt,
		test{{.EntityNamePascal}}.TenantID,
	)
	
	mock.ExpectQuery(`SELECT.*WHERE.*status.*name.*LIMIT.*OFFSET`).
		WithArgs(string(status), "%"+name+"%", filter.Limit, filter.Offset).
		WillReturnRows(listRows)
	
	result, pagination, err := repo.List(ctx, filter)
	
	require.NoError(t, err)
	assert.Len(t, result, 1)
	assert.NotNil(t, pagination)
	assert.Equal(t, int64(1), pagination.Total)
	assert.NoError(t, mock.ExpectationsWereMet())
}

