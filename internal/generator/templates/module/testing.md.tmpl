## Multi-tenancy Tests

### Tenant Isolation Verification
```go
func TestMultiTenancy_{{.EntityNamePascal}}Isolation(t *testing.T) {
    service := setupTestService(t)
    
    // Create {{.EntityNamePlural}} for different tenants
    tenant1Ctx := withTenant(context.Background(), "tenant-1")
    tenant2Ctx := withTenant(context.Background(), "tenant-2")
    
    {{.EntityNameCamel}}1, err := service.Create{{.EntityNamePascal}}(tenant1Ctx, Create{{.EntityNamePascal}}Request{
        Name: "Tenant 1 {{.EntityNamePascal}}",
    })
    assert.NoError(t, err)
    
    {{.EntityNameCamel}}2, err := service.Create{{.EntityNamePascal}}(tenant2Ctx, Create{{.EntityNamePascal}}Request{
        Name: "Tenant 2 {{.EntityNamePascal}}",
    })
    assert.NoError(t, err)
    
    // Verify cross-tenant access is blocked
    _, err = service.Get{{.EntityNamePascal}}ByID(tenant1Ctx, {{.EntityNameCamel}}2.ID)
    assert.Error(t, err)
    assert.IsType(t, &NotFoundError{}, err)
    
    _, err = service.Get{{.EntityNamePascal}}ByID(tenant2Ctx, {{.EntityNameCamel}}1.ID)
    assert.Error(t, err)
    assert.IsType(t, &NotFoundError{}, err)
}
```

