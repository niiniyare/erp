    updateResp := performRequest(app, "PUT", fmt.Sprintf("/api/v1/{{.ModuleNameKebab}}/{{.EntityNameSnake}}/%s", created{{.EntityNamePascal}}.ID), updatePayload)
    assert.Equal(t, 200, updateResp.Code)
    
    // 4. List {{.EntityNamePlural}} (should include our {{.EntityNameSnake}})
