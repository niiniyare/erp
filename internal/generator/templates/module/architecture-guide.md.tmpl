        Currency:    {{.EntityNameCamel}}.Currency,
        {{end}}
        Tags:         {{.EntityNameCamel}}.Tags,
        CustomFields: {{.EntityNameCamel}}.CustomFields,
        CreatedAt:    {{.EntityNameCamel}}.CreatedAt,
        UpdatedAt:    {{.EntityNameCamel}}.UpdatedAt,
        CreatedBy:    {{.EntityNameCamel}}.CreatedBy,
        UpdatedBy:    {{.EntityNameCamel}}.UpdatedBy,
        Version:      {{.EntityNameCamel}}.Version,
    })
    
    if err != nil {
        span.RecordError(err)
        return nil, r.handleDBError(err)
    }
    
    return r.mapToEntity(created), nil
}

func (r *{{.EntityNameCamel}}Repository) handleDBError(err error) error {
    var pgErr *pgconn.PgError
    if errors.As(err, &pgErr) {
        switch pgErr.Code {
        case "23505": // unique_violation
            if strings.Contains(pgErr.ConstraintName, "name") {
                return ErrNameAlreadyExists
            }
            return ErrDuplicate{{.EntityNamePascal}}
        case "23503": // foreign_key_violation
            return ErrInvalidReference
        }
    }
    return fmt.Errorf("database error: %w", err)
}
