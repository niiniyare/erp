func (suite *{{.EntityName}}IntegrationTestSuite) TestBusinessWorkflow_CompleteLifecycle() {
	// This test demonstrates a complete business workflow
	
	// Step 1: Create {{.EntityName}}
	createRequest := &goa{{.ModuleNamePascal}}.Create{{.EntityName}}Payload{
		Name:        "Workflow Test {{.EntityName}}",
		{{- if contains .ModuleName "finance"}}
		Code:        "WORKFLOW001",
		{{- end}}
		Description: strPtr("Complete workflow test"),
		IsActive:    true,
	}

	createResp, err := suite.makeRequest("POST", "/api/v1/{{pluralize (snakeCase .EntityName)}}", createRequest)
	require.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusCreated, createResp.StatusCode)

	var created goa{{.ModuleNamePascal}}.{{.EntityName}}Result
	err = json.NewDecoder(createResp.Body).Decode(&created)
	require.NoError(suite.T(), err)

	// Step 2: Read {{.EntityName}}
	getResp, err := suite.makeRequest("GET", fmt.Sprintf("/api/v1/{{pluralize (snakeCase .EntityName)}}/%s", created.ID), nil)
	require.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusOK, getResp.StatusCode)

	// Step 3: Update {{.EntityName}}
	updateRequest := &goa{{.ModuleNamePascal}}.Update{{.EntityName}}Payload{
		Name:        strPtr("Updated Workflow {{.EntityName}}"),
		Description: strPtr("Updated description"),
	}

	updateResp, err := suite.makeRequest("PUT", fmt.Sprintf("/api/v1/{{pluralize (snakeCase .EntityName)}}/%s", created.ID), updateRequest)
	require.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusOK, updateResp.StatusCode)

	// Step 4: List to verify
	listResp, err := suite.makeRequest("GET", "/api/v1/{{pluralize (snakeCase .EntityName)}}", nil)
	require.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusOK, listResp.StatusCode)

	var listResult goa{{.ModuleNamePascal}}.{{.EntityName}}ListResult
	err = json.NewDecoder(listResp.Body).Decode(&listResult)
	require.NoError(suite.T(), err)
	assert.GreaterOrEqual(suite.T(), len(listResult.{{.EntityNamePlural}}), 1)

	// Step 5: Search for updated entity
	searchResp, err := suite.makeRequest("GET", "/api/v1/{{pluralize (snakeCase .EntityName)}}/search?query=Updated&limit=10", nil)
	require.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusOK, searchResp.StatusCode)

	var searchResult goa{{.ModuleNamePascal}}.Search{{.EntityNamePlural}}Result
	err = json.NewDecoder(searchResp.Body).Decode(&searchResult)
	require.NoError(suite.T(), err)
	assert.GreaterOrEqual(suite.T(), len(searchResult.Results), 1)

	// Step 6: Delete {{.EntityName}}
	deleteResp, err := suite.makeRequest("DELETE", fmt.Sprintf("/api/v1/{{pluralize (snakeCase .EntityName)}}/%s", created.ID), nil)
	require.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusNoContent, deleteResp.StatusCode)

	// Step 7: Verify deletion
	finalGetResp, err := suite.makeRequest("GET", fmt.Sprintf("/api/v1/{{pluralize (snakeCase .EntityName)}}/%s", created.ID), nil)
	require.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusNotFound, finalGetResp.StatusCode)
}

