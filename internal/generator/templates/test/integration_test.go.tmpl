		ShowInReports:     true,
		Version:           1,
		ValidationStatus:  domain.ValidationStatusPending,
		CreatedAt:         time.Now(),
		UpdatedAt:         time.Now(),
		CreatedBy:         suite.userID,
	}

	err := suite.service.Create{{.EntityName}}(suite.ctx, &domain.Create{{.EntityName}}Request{
