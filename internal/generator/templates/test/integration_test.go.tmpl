type {{.EntityName}}IntegrationTestSuite struct {
	suite.Suite
	app       *fiber.App
	db        *sqlc.Queries
	service   *{{.PackageName}}Service.{{.EntityName}}Service
	handler   goa{{.ModuleNamePascal}}.Service
	ctx       context.Context
	tenantID  uuid.UUID
	userID    uuid.UUID
	authToken string
	cleanup   func()
}

func (suite *{{.EntityName}}IntegrationTestSuite) SetupSuite() {
	// Setup test database and dependencies
	testDB, cleanup, err := testutil.SetupTestDB()
	require.NoError(suite.T(), err)
	
	suite.cleanup = cleanup
	suite.db = sqlc.New(testDB)
	suite.tenantID = uuid.New()
	suite.userID = uuid.New()
	
	// Setup context with authentication
	suite.ctx = auth.WithTenantID(context.Background(), suite.tenantID)
	suite.ctx = auth.WithUserID(suite.ctx, suite.userID)
	
	// Setup service layer
	repo := {{.PackageName}}Repository.New{{.EntityName}}Repository(suite.db)
	mockABAC := testutil.NewMockABACService()
	mockFeatureFlags := testutil.NewMockFeatureFlagService()
	mockMetrics := testutil.NewMockMetricsProvider()
	mockLogger := testutil.NewMockLogger()
	
	suite.service = {{.PackageName}}Service.New{{.EntityName}}Service(
		repo,
		mockABAC,
		mockFeatureFlags,
		mockMetrics,
		mockLogger,
	)
	
	// Setup API handler
	suite.handler = {{.PackageName}}.New{{.EntityName}}Handler(
		{{.PackageName}}Service.Services{
			{{.EntityName}}Service: suite.service,
		},
		testutil.NewMockTracingService(),
		mockMetrics,
	)
	
	// Setup Fiber app
	suite.app = testutil.SetupTestApp()
	suite.setupRoutes()
	
	// Setup authentication token
	suite.authToken = testutil.GenerateTestJWT(suite.userID, suite.tenantID)
}

func (suite *{{.EntityName}}IntegrationTestSuite) TearDownSuite() {
	if suite.cleanup != nil {
		suite.cleanup()
	}
}

func (suite *{{.EntityName}}IntegrationTestSuite) SetupTest() {
	// Clean up test data before each test
	suite.cleanupTestData()
}

func (suite *{{.EntityName}}IntegrationTestSuite) TearDownTest() {
	// Clean up test data after each test
	suite.cleanupTestData()
}

func (suite *{{.EntityName}}IntegrationTestSuite) setupRoutes() {
	api := suite.app.Group("/api/v1")
	
	// Add authentication middleware
	api.Use(testutil.AuthMiddleware(suite.tenantID, suite.userID))
	
	// Register {{.EntityName}} routes
	{{pluralize (camelCase .EntityName)}}Group := api.Group("/{{pluralize (snakeCase .EntityName)}}")
	{{pluralize (camelCase .EntityName)}}Group.Post("/", suite.create{{.EntityName}}Handler)
	{{pluralize (camelCase .EntityName)}}Group.Get("/:id", suite.get{{.EntityName}}Handler)
	{{pluralize (camelCase .EntityName)}}Group.Put("/:id", suite.update{{.EntityName}}Handler)
	{{pluralize (camelCase .EntityName)}}Group.Delete("/:id", suite.delete{{.EntityName}}Handler)
	{{pluralize (camelCase .EntityName)}}Group.Get("/", suite.list{{.EntityNamePlural}}Handler)
	{{pluralize (camelCase .EntityName)}}Group.Get("/search", suite.search{{.EntityNamePlural}}Handler)
}

func (suite *{{.EntityName}}IntegrationTestSuite) cleanupTestData() {
	// Delete all test data for this tenant
	testutil.CleanupTenantData(suite.db, suite.tenantID, "{{snakeCase (pluralize .EntityName)}}")
}

