func (suite *{{.EntityName}}IntegrationTestSuite) createMultipleTestEntities(count int) []*domain.{{.EntityName}} {
	entities := make([]*domain.{{.EntityName}}, count)
	for i := 0; i < count; i++ {
		entities[i] = suite.createTestEntity()
		entities[i].{{.EntityName}}Code = fmt.Sprintf("INTTEST%03d", i+1)
		entities[i].{{.EntityName}}Name = fmt.Sprintf("Integration Test {{.EntityName}} %d", i+1)
	}
	return entities
}

// Handler wrapper functions (these would be implemented to call the actual handlers)
func (suite *{{.EntityName}}IntegrationTestSuite) create{{.EntityName}}Handler(c *fiber.Ctx) error {
	var payload goa{{.ModuleNamePascal}}.Create{{.EntityName}}Payload
	if err := c.BodyParser(&payload); err != nil {
		return c.Status(400).JSON(fiber.Map{"error": "invalid request"})
	}
	
	result, err := suite.handler.Create{{.EntityName}}(c.Context(), &payload)
	if err != nil {
		return testutil.HandleError(c, err)
	}
	
	return c.Status(201).JSON(result)
}

func (suite *{{.EntityName}}IntegrationTestSuite) get{{.EntityName}}Handler(c *fiber.Ctx) error {
	id := c.Params("id")
	
	result, err := suite.handler.Get{{.EntityName}}(c.Context(), &goa{{.ModuleNamePascal}}.Get{{.EntityName}}ByIDPayload{ID: id})
	if err != nil {
		return testutil.HandleError(c, err)
	}
	
	return c.JSON(result)
}

func (suite *{{.EntityName}}IntegrationTestSuite) update{{.EntityName}}Handler(c *fiber.Ctx) error {
	id := c.Params("id")
	var payload goa{{.ModuleNamePascal}}.Update{{.EntityName}}Payload
