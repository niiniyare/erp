func Test{{.EntityName}}_Validate(t *testing.T) {
	validEntity := func() *{{.EntityName}} {
		return &{{.EntityName}}{
			ID:                uuid.New(),
			TenantID:          uuid.New(),
			{{.EntityName}}Code:        "TEST001",
			{{.EntityName}}Name:        "Test {{.EntityName}}",
			{{.EntityName}}Type:        "STANDARD",
			Status:            {{.EntityName}}StatusActive,
			IsActive:          true,
			IsSystemDefined:   false,
			AllowManualEntries: true,
			DisplayOrder:      0,
			ShowInReports:     true,
			Version:           1,
			ValidationStatus:  ValidationStatusPending,
			CreatedAt:         time.Now(),
			UpdatedAt:         time.Now(),
			CreatedBy:         uuid.New(),
		}
	}

	t.Run("valid entity", func(t *testing.T) {
		entity := validEntity()
		err := entity.Validate()
		assert.NoError(t, err)
	})

	t.Run("nil tenant ID", func(t *testing.T) {
		entity := validEntity()
		entity.TenantID = uuid.Nil
		err := entity.Validate()
		assert.Error(t, err)
		assert.Contains(t, err.Error(), "tenant_id")
	})

	t.Run("nil created by", func(t *testing.T) {
		entity := validEntity()
		entity.CreatedBy = uuid.Nil
		err := entity.Validate()
		assert.Error(t, err)
		assert.Contains(t, err.Error(), "created_by")
	})

	t.Run("invalid status", func(t *testing.T) {
		entity := validEntity()
		entity.Status = {{.EntityName}}Status("INVALID")
		err := entity.Validate()
		assert.Error(t, err)
		assert.Contains(t, err.Error(), "status")
	})

	t.Run("negative version", func(t *testing.T) {
		entity := validEntity()
		entity.Version = -1
		err := entity.Validate()
		assert.Error(t, err)
		assert.Contains(t, err.Error(), "version")
	})

	{{- if contains .ModuleName "finance"}}
	t.Run("invalid parent hierarchy", func(t *testing.T) {
		entity := validEntity()
		entity.ParentID = &entity.ID // Self-reference
		err := entity.Validate()
		assert.Error(t, err)
		assert.Contains(t, err.Error(), "parent")
	})
	{{- end}}
}

