func Test{{.EntityName}}_CanBeDeleted(t *testing.T) {
	entity := &{{.EntityName}}{
		ID:                uuid.New(),
		TenantID:          uuid.New(),
		{{.EntityName}}Code:        "TEST001",
		{{.EntityName}}Name:        "Test {{.EntityName}}",
		{{.EntityName}}Type:        "STANDARD",
		Status:            {{.EntityName}}StatusActive,
		IsActive:          true,
		IsSystemDefined:   false,
		AllowManualEntries: true,
		DisplayOrder:      0,
		ShowInReports:     true,
		Version:           1,
		ValidationStatus:  ValidationStatusPending,
		CreatedAt:         time.Now(),
		UpdatedAt:         time.Now(),
		CreatedBy:         uuid.New(),
	}

	t.Run("can delete non-system entity", func(t *testing.T) {
		canDelete := entity.CanBeDeleted()
		assert.True(t, canDelete)
	})

	t.Run("cannot delete system entity", func(t *testing.T) {
		entity.IsSystemDefined = true
		canDelete := entity.CanBeDeleted()
		assert.False(t, canDelete)
	})

	{{- if contains .ModuleName "finance"}}
	t.Run("cannot delete entity with children", func(t *testing.T) {
		entity.IsSystemDefined = false
		entity.HasChildren = true
		canDelete := entity.CanBeDeleted()
		assert.False(t, canDelete)
	})
	{{- end}}
}

func Test{{.EntityName}}_UpdateVersion(t *testing.T) {
	entity := &{{.EntityName}}{
		Version: 1,
	}

	oldVersion := entity.Version
	entity.UpdateVersion()
	
	assert.Equal(t, oldVersion+1, entity.Version)
}

func Test{{.EntityName}}_SetStatus(t *testing.T) {
	entity := &{{.EntityName}}{
		Status: {{.EntityName}}StatusActive,
	}

	t.Run("valid status change", func(t *testing.T) {
		err := entity.SetStatus({{.EntityName}}StatusInactive)
		assert.NoError(t, err)
		assert.Equal(t, {{.EntityName}}StatusInactive, entity.Status)
	})

	t.Run("invalid status", func(t *testing.T) {
		err := entity.SetStatus({{.EntityName}}Status("INVALID"))
		assert.Error(t, err)
		assert.Equal(t, {{.EntityName}}StatusInactive, entity.Status) // Should remain unchanged
	})
}

