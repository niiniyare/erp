func Test{{.EntityName}}_Hierarchy(t *testing.T) {
	parent := &{{.EntityName}}{
		ID:       uuid.New(),
		TenantID: uuid.New(),
		{{.EntityName}}Code: "PARENT",
		{{.EntityName}}Name: "Parent {{.EntityName}}",
		{{.EntityName}}Type: "PARENT",
		Level:    1,
		Path:     strPtr("PARENT"),
		HasChildren: true,
	}

	child := &{{.EntityName}}{
		ID:       uuid.New(),
		TenantID: parent.TenantID,
		{{.EntityName}}Code: "CHILD",
		{{.EntityName}}Name: "Child {{.EntityName}}",
		{{.EntityName}}Type: "CHILD",
		ParentID: &parent.ID,
		Level:    2,
		Path:     strPtr("PARENT/CHILD"),
		HasChildren: false,
	}

	t.Run("valid hierarchy", func(t *testing.T) {
		err := child.ValidateHierarchy()
		assert.NoError(t, err)
	})

	t.Run("self-parent", func(t *testing.T) {
		child.ParentID = &child.ID
		err := child.ValidateHierarchy()
		assert.Error(t, err)
		assert.Contains(t, err.Error(), "self-reference")
	})

	t.Run("level consistency", func(t *testing.T) {
		child.ParentID = &parent.ID
		child.Level = 1 // Should be 2 for child
		err := child.ValidateHierarchy()
		assert.Error(t, err)
		assert.Contains(t, err.Error(), "level")
	})
}

func Test{{.EntityName}}_CalculatePath(t *testing.T) {
	tests := []struct {
		name       string
		code       string
		parentPath *string
		expected   string
	}{
		{
			name:       "root level",
			code:       "ROOT",
			parentPath: nil,
			expected:   "ROOT",
		},
		{
			name:       "child level",
			code:       "CHILD",
			parentPath: strPtr("ROOT"),
			expected:   "ROOT/CHILD",
		},
		{
			name:       "grandchild level",
			code:       "GRANDCHILD",
			parentPath: strPtr("ROOT/CHILD"),
			expected:   "ROOT/CHILD/GRANDCHILD",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			entity := &{{.EntityName}}{
				{{.EntityName}}Code: tt.code,
			}
			
			path := entity.CalculatePath(tt.parentPath)
			assert.Equal(t, tt.expected, path)
		})
	}
}

