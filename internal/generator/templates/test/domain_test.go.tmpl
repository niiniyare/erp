func Test{{.EntityName}}Filter_Pagination(t *testing.T) {
	tests := []struct {
		name         string
		filter       {{.EntityName}}Filter
		expectedPage int32
		expectedLimit int32
		expectedOffset int32
	}{
		{
			name:           "default pagination",
			filter:         {{.EntityName}}Filter{},
			expectedPage:   1,
			expectedLimit:  20,
			expectedOffset: 0,
		},
		{
			name: "custom pagination",
			filter: {{.EntityName}}Filter{
				Page:  int32Ptr(3),
				Limit: int32Ptr(50),
			},
			expectedPage:   3,
			expectedLimit:  50,
			expectedOffset: 100,
		},
		{
			name: "limit too high",
			filter: {{.EntityName}}Filter{
				Limit: int32Ptr(200),
			},
			expectedPage:   1,
			expectedLimit:  100, // Should be capped
			expectedOffset: 0,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			assert.Equal(t, tt.expectedPage, tt.filter.GetPage())
			assert.Equal(t, tt.expectedLimit, tt.filter.GetLimit())
			assert.Equal(t, tt.expectedOffset, tt.filter.GetOffset())
		})
	}
}

func Test{{.EntityName}}Filter_Sorting(t *testing.T) {
	tests := []struct {
		name              string
		filter            {{.EntityName}}Filter
		expectedSortBy    string
		expectedSortOrder string
	}{
		{
			name:              "default sorting",
			filter:            {{.EntityName}}Filter{},
			expectedSortBy:    "{{camelCase .EntityName}}_code",
			expectedSortOrder: "asc",
		},
		{
			name: "custom sorting",
			filter: {{.EntityName}}Filter{
				SortBy:    strPtr("{{camelCase .EntityName}}_name"),
				SortOrder: strPtr("desc"),
			},
			expectedSortBy:    "{{camelCase .EntityName}}_name",
			expectedSortOrder: "desc",
		},
		{
			name: "invalid sort order",
			filter: {{.EntityName}}Filter{
				SortOrder: strPtr("invalid"),
			},
			expectedSortBy:    "{{camelCase .EntityName}}_code",
			expectedSortOrder: "asc", // Should default
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			assert.Equal(t, tt.expectedSortBy, tt.filter.GetSortBy())
			assert.Equal(t, tt.expectedSortOrder, tt.filter.GetSortOrder())
		})
	}
}

