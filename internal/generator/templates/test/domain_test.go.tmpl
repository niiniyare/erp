func Test{{.EntityName}}_NewEntity(t *testing.T) {
	tests := []struct {
		name        string
		{{camelCase .EntityName}}Code string
		{{camelCase .EntityName}}Name string
		{{camelCase .EntityName}}Type string
		wantErr     bool
		errField    string
	}{
		{
			name:        "valid {{lowerCase .EntityName}}",
			{{camelCase .EntityName}}Code: "TEST001",
			{{camelCase .EntityName}}Name: "Test {{.EntityName}}",
			{{camelCase .EntityName}}Type: "STANDARD",
			wantErr:     false,
		},
		{
			name:        "empty code",
			{{camelCase .EntityName}}Code: "",
			{{camelCase .EntityName}}Name: "Test {{.EntityName}}",
			{{camelCase .EntityName}}Type: "STANDARD",
			wantErr:     true,
			errField:    "{{.EntityName}}Code",
		},
		{
			name:        "empty name",
			{{camelCase .EntityName}}Code: "TEST001",
			{{camelCase .EntityName}}Name: "",
			{{camelCase .EntityName}}Type: "STANDARD",
			wantErr:     true,
			errField:    "{{.EntityName}}Name",
		},
		{
			name:        "empty type",
			{{camelCase .EntityName}}Code: "TEST001",
			{{camelCase .EntityName}}Name: "Test {{.EntityName}}",
			{{camelCase .EntityName}}Type: "",
			wantErr:     true,
			errField:    "{{.EntityName}}Type",
		},
		{
			name:        "code too long",
			{{camelCase .EntityName}}Code: "THIS_IS_A_VERY_LONG_CODE_THAT_EXCEEDS_THE_MAXIMUM_LENGTH_ALLOWED",
			{{camelCase .EntityName}}Name: "Test {{.EntityName}}",
			{{camelCase .EntityName}}Type: "STANDARD",
			wantErr:     true,
			errField:    "{{.EntityName}}Code",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			{{camelCase .EntityName}} := &{{.EntityName}}{
				ID:                uuid.New(),
				TenantID:          uuid.New(),
				{{.EntityName}}Code:        tt.{{camelCase .EntityName}}Code,
				{{.EntityName}}Name:        tt.{{camelCase .EntityName}}Name,
				{{.EntityName}}Type:        tt.{{camelCase .EntityName}}Type,
				Status:            {{.EntityName}}StatusActive,
				IsActive:          true,
				IsSystemDefined:   false,
				AllowManualEntries: true,
				DisplayOrder:      0,
				ShowInReports:     true,
				Version:           1,
				ValidationStatus:  ValidationStatusPending,
				CreatedAt:         time.Now(),
				UpdatedAt:         time.Now(),
				CreatedBy:         uuid.New(),
			}

			err := {{camelCase .EntityName}}.Validate()
			
			if tt.wantErr {
				assert.Error(t, err)
				if tt.errField != "" {
					validationErr, ok := err.(*{{.EntityName}}ValidationError)
					require.True(t, ok, "expected {{.EntityName}}ValidationError")
					assert.Equal(t, tt.errField, validationErr.Field)
				}
			} else {
				assert.NoError(t, err)
			}
		})
	}
}

