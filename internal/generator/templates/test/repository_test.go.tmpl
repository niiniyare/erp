func (suite *{{.EntityName}}RepositoryTestSuite) TestDelete() {
	// Arrange
	entity := suite.createValid{{.EntityName}}()
	err := suite.repo.Create(suite.ctx, entity)
	require.NoError(suite.T(), err)

	// Act
	err = suite.repo.Delete(suite.ctx, entity.ID)

	// Assert
	require.NoError(suite.T(), err)

	// Verify soft delete - entity should not be retrievable
	retrieved, err := suite.repo.GetByID(suite.ctx, entity.ID)
	assert.Error(suite.T(), err)
	assert.Nil(suite.T(), retrieved)
	assert.Equal(suite.T(), domain.ErrNotFound, err)

	// Verify entity still exists in database with deleted_at set
	var deletedAt sql.NullTime
	err = suite.db.QueryRow(`
		SELECT deleted_at FROM {{snakeCase (pluralize .EntityName)}} 
		WHERE id = $1 AND tenant_id = $2
	`, entity.ID, suite.tenantID).Scan(&deletedAt)
	require.NoError(suite.T(), err)
	assert.True(suite.T(), deletedAt.Valid)
}

