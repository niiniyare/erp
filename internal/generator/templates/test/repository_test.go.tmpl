// =============================================================================
// TEST SUITE SETUP
// =============================================================================

type {{.EntityName}}RepositoryTestSuite struct {
	suite.Suite
	db         *sql.DB
	queries    *sqlc.Queries
	repo       domain.{{.EntityName}}Repository
	ctx        context.Context
	tenantID   uuid.UUID
	entityID   uuid.UUID
	cleanup    func()
}

func (suite *{{.EntityName}}RepositoryTestSuite) SetupSuite() {
	// Setup test database
	db, cleanup, err := testutil.SetupTestDB()
	require.NoError(suite.T(), err)
	
	suite.db = db
	suite.queries = sqlc.New(db)
	suite.repo = New{{.EntityName}}Repository(suite.queries)
	suite.cleanup = cleanup
	
	// Set tenant context for multi-tenancy
	suite.tenantID = uuid.New()
	suite.entityID = uuid.New()
	suite.ctx = database.WithTenantID(context.Background(), suite.tenantID)
}

func (suite *{{.EntityName}}RepositoryTestSuite) TearDownSuite() {
	if suite.cleanup != nil {
		suite.cleanup()
	}
}

func (suite *{{.EntityName}}RepositoryTestSuite) SetupTest() {
	// Clean up data before each test
	suite.cleanupTestData()
}

func (suite *{{.EntityName}}RepositoryTestSuite) TearDownTest() {
	// Clean up data after each test
	suite.cleanupTestData()
}

func (suite *{{.EntityName}}RepositoryTestSuite) cleanupTestData() {
	// Delete test data for this tenant
	_, err := suite.db.Exec(`
		DELETE FROM {{snakeCase (pluralize .EntityName)}} 
		WHERE tenant_id = $1
	`, suite.tenantID)
	require.NoError(suite.T(), err)
}

func TestRun{{.EntityName}}RepositoryTestSuite(t *testing.T) {
	suite.Run(t, new({{.EntityName}}RepositoryTestSuite))
}

