func (suite *{{.EntityName}}RepositoryTestSuite) TestGetHierarchy() {
	// Arrange
	parent := suite.create{{.EntityName}}WithDetails("PARENT", "Parent {{.EntityName}}", "Parent description")
	parent.Level = 1
	parent.Path = strPtr("PARENT")
	parent.HasChildren = true

	child1 := suite.create{{.EntityName}}WithDetails("CHILD1", "Child One", "First child")
	child1.ParentID = &parent.ID
	child1.Level = 2
	child1.Path = strPtr("PARENT/CHILD1")
	child1.HasChildren = false

	child2 := suite.create{{.EntityName}}WithDetails("CHILD2", "Child Two", "Second child")
	child2.ParentID = &parent.ID
	child2.Level = 2
	child2.Path = strPtr("PARENT/CHILD2")
	child2.HasChildren = false

	entities := []*domain.{{.EntityName}}{parent, child1, child2}
	for _, entity := range entities {
		err := suite.repo.Create(suite.ctx, entity)
		require.NoError(suite.T(), err)
	}

	// Act
	hierarchy, err := suite.repo.GetHierarchy(suite.ctx, parent.ID)

	// Assert
	require.NoError(suite.T(), err)
	assert.Len(suite.T(), hierarchy, 3) // parent + 2 children
	
	// Verify ordering (by level, then code)
	assert.Equal(suite.T(), parent.ID, hierarchy[0].ID)
	assert.Equal(suite.T(), int32(1), hierarchy[0].Level)
	assert.Equal(suite.T(), int32(2), hierarchy[1].Level)
	assert.Equal(suite.T(), int32(2), hierarchy[2].Level)
}

func (suite *{{.EntityName}}RepositoryTestSuite) TestGetChildren() {
	// Arrange
	parent := suite.createValid{{.EntityName}}()
	parent.HasChildren = true
	err := suite.repo.Create(suite.ctx, parent)
	require.NoError(suite.T(), err)

	// Create children
	child1 := suite.createValid{{.EntityName}}()
	child1.{{.EntityName}}Code = "CHILD001"
	child1.ParentID = &parent.ID

	child2 := suite.createValid{{.EntityName}}()
	child2.{{.EntityName}}Code = "CHILD002"
	child2.ParentID = &parent.ID

	err = suite.repo.Create(suite.ctx, child1)
	require.NoError(suite.T(), err)
	err = suite.repo.Create(suite.ctx, child2)
	require.NoError(suite.T(), err)

	// Act
	children, err := suite.repo.GetChildren(suite.ctx, parent.ID)

	// Assert
	require.NoError(suite.T(), err)
	assert.Len(suite.T(), children, 2)
	
	for _, child := range children {
		assert.Equal(suite.T(), parent.ID, *child.ParentID)
	}
}

func (suite *{{.EntityName}}RepositoryTestSuite) TestHasChildren() {
	// Arrange
	parent := suite.createValid{{.EntityName}}()
	err := suite.repo.Create(suite.ctx, parent)
	require.NoError(suite.T(), err)

	// Initially no children
	hasChildren, err := suite.repo.HasChildren(suite.ctx, parent.ID)
	require.NoError(suite.T(), err)
	assert.False(suite.T(), hasChildren)

	// Add a child
	child := suite.createValid{{.EntityName}}()
	child.{{.EntityName}}Code = "CHILD001"
	child.ParentID = &parent.ID
	err = suite.repo.Create(suite.ctx, child)
	require.NoError(suite.T(), err)

	// Now should have children
	hasChildren, err = suite.repo.HasChildren(suite.ctx, parent.ID)
	require.NoError(suite.T(), err)
	assert.True(suite.T(), hasChildren)
}

