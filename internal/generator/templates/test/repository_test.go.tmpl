func (suite *{{.EntityName}}RepositoryTestSuite) TestSearch() {
	// Arrange
	entities := []*domain.{{.EntityName}}{
		suite.create{{.EntityName}}WithDetails("SEARCH001", "Searchable Item One", "First test item"),
		suite.create{{.EntityName}}WithDetails("SEARCH002", "Searchable Item Two", "Second test item"),
		suite.create{{.EntityName}}WithDetails("OTHER001", "Different Item", "Not matching"),
	}

	for _, entity := range entities {
		err := suite.repo.Create(suite.ctx, entity)
		require.NoError(suite.T(), err)
	}

	// Act
	results, err := suite.repo.Search(suite.ctx, "Searchable", 10)

	// Assert
	require.NoError(suite.T(), err)
	assert.Len(suite.T(), results, 2)
	
	// Verify relevance ordering (exact matches first)
	for _, result := range results {
		assert.Contains(suite.T(), result.{{.EntityName}}Name, "Searchable")
