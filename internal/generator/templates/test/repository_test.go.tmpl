func (suite *{{.EntityName}}RepositoryTestSuite) TestList() {
	// Arrange
	entities := suite.createMultiple{{.EntityNamePlural}}(5)
	for _, entity := range entities {
		err := suite.repo.Create(suite.ctx, entity)
		require.NoError(suite.T(), err)
	}

	filter := &domain.{{.EntityName}}Filter{
		Page:  int32Ptr(1),
		Limit: int32Ptr(10),
	}

	// Act
	result, err := suite.repo.List(suite.ctx, filter)

	// Assert
	require.NoError(suite.T(), err)
	assert.Len(suite.T(), result, 5)
	
	// Verify order (should be by {{camelCase .EntityName}}_code by default)
	for i := 1; i < len(result); i++ {
		assert.LessOrEqual(suite.T(), result[i-1].{{.EntityName}}Code, result[i].{{.EntityName}}Code)
	}
}

func (suite *{{.EntityName}}RepositoryTestSuite) TestList_WithFilters() {
	// Arrange
	activeEntity := suite.createValid{{.EntityName}}()
	activeEntity.{{.EntityName}}Code = "ACTIVE001"
	activeEntity.IsActive = true

	inactiveEntity := suite.createValid{{.EntityName}}()
	inactiveEntity.{{.EntityName}}Code = "INACTIVE001"
	inactiveEntity.IsActive = false

	err := suite.repo.Create(suite.ctx, activeEntity)
	require.NoError(suite.T(), err)
	err = suite.repo.Create(suite.ctx, inactiveEntity)
	require.NoError(suite.T(), err)

	// Test active filter
	activeFilter := &domain.{{.EntityName}}Filter{
		IsActive: boolPtr(true),
	}

	// Act
	activeResults, err := suite.repo.List(suite.ctx, activeFilter)

	// Assert
	require.NoError(suite.T(), err)
	assert.Len(suite.T(), activeResults, 1)
	assert.True(suite.T(), activeResults[0].IsActive)

	// Test inactive filter
	inactiveFilter := &domain.{{.EntityName}}Filter{
		IsActive: boolPtr(false),
	}

	inactiveResults, err := suite.repo.List(suite.ctx, inactiveFilter)
	require.NoError(suite.T(), err)
	assert.Len(suite.T(), inactiveResults, 1)
	assert.False(suite.T(), inactiveResults[0].IsActive)
}

func (suite *{{.EntityName}}RepositoryTestSuite) TestList_Pagination() {
	// Arrange
	entities := suite.createMultiple{{.EntityNamePlural}}(25)
	for _, entity := range entities {
		err := suite.repo.Create(suite.ctx, entity)
		require.NoError(suite.T(), err)
	}

	// Test first page
	filter1 := &domain.{{.EntityName}}Filter{
		Page:  int32Ptr(1),
		Limit: int32Ptr(10),
	}

	// Act
	page1, err := suite.repo.List(suite.ctx, filter1)

	// Assert
	require.NoError(suite.T(), err)
	assert.Len(suite.T(), page1, 10)

	// Test second page
	filter2 := &domain.{{.EntityName}}Filter{
		Page:  int32Ptr(2),
		Limit: int32Ptr(10),
	}

	page2, err := suite.repo.List(suite.ctx, filter2)
	require.NoError(suite.T(), err)
	assert.Len(suite.T(), page2, 10)

	// Verify no overlap
	for _, p1Entity := range page1 {
		for _, p2Entity := range page2 {
			assert.NotEqual(suite.T(), p1Entity.ID, p2Entity.ID)
		}
	}
}

