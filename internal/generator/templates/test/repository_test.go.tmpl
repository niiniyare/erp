func (suite *{{.EntityName}}RepositoryTestSuite) TestUpdate() {
	// Arrange
	entity := suite.createValid{{.EntityName}}()
	err := suite.repo.Create(suite.ctx, entity)
	require.NoError(suite.T(), err)

	// Modify entity
	entity.{{.EntityName}}Name = "Updated Name"
	entity.{{.EntityName}}Description = strPtr("Updated Description")
	originalVersion := entity.Version
	entity.Version++

	// Act
	err = suite.repo.Update(suite.ctx, entity)

	// Assert
	require.NoError(suite.T(), err)

	// Verify update in database
	retrieved, err := suite.repo.GetByID(suite.ctx, entity.ID)
	require.NoError(suite.T(), err)
	assert.Equal(suite.T(), "Updated Name", retrieved.{{.EntityName}}Name)
	assert.Equal(suite.T(), "Updated Description", *retrieved.{{.EntityName}}Description)
	assert.Equal(suite.T(), originalVersion+1, retrieved.Version)
}

