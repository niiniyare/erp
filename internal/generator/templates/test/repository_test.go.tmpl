func (suite *{{.EntityName}}RepositoryTestSuite) createValid{{.EntityName}}() *domain.{{.EntityName}} {
	return &domain.{{.EntityName}}{
		ID:                uuid.New(),
		TenantID:          suite.tenantID,
		EntityID:          &suite.entityID,
		{{.EntityName}}Code:        "TEST" + uuid.New().String()[:8],
		{{.EntityName}}Name:        "Test {{.EntityName}}",
		{{.EntityName}}Description: strPtr("Test description"),
		{{.EntityName}}Type:        "STANDARD",
		{{.EntityName}}Category:    strPtr("TEST"),
		Status:            domain.{{.EntityName}}StatusActive,
		{{- if contains .ModuleName "finance"}}
		Level:             1,
		Path:              strPtr("TEST"),
		HasChildren:       false,
		{{- end}}
		IsActive:          true,
		IsSystemDefined:   false,
		AllowManualEntries: true,
		DisplayOrder:      0,
		ShowInReports:     true,
		Version:           1,
		ValidationStatus:  domain.ValidationStatusPending,
		CreatedAt:         time.Now(),
		UpdatedAt:         time.Now(),
		CreatedBy:         uuid.New(),
	}
}

func (suite *{{.EntityName}}RepositoryTestSuite) create{{.EntityName}}WithDetails(code, name, description string) *domain.{{.EntityName}} {
	entity := suite.createValid{{.EntityName}}()
	entity.{{.EntityName}}Code = code
	entity.{{.EntityName}}Name = name
	entity.{{.EntityName}}Description = &description
	return entity
}

func (suite *{{.EntityName}}RepositoryTestSuite) createMultiple{{.EntityNamePlural}}(count int) []*domain.{{.EntityName}} {
	entities := make([]*domain.{{.EntityName}}, count)
	for i := 0; i < count; i++ {
		entities[i] = suite.createValid{{.EntityName}}()
		entities[i].{{.EntityName}}Code = "TEST" + fmt.Sprintf("%03d", i+1)
		entities[i].{{.EntityName}}Name = "Test {{.EntityName}} " + fmt.Sprintf("%d", i+1)
	}
	return entities
}

func strPtr(s string) *string {
	return &s
}

func int32Ptr(i int32) *int32 {
	return &i
}

func boolPtr(b bool) *bool {
	return &b
}

