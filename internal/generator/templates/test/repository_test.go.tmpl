func (suite *{{.EntityName}}RepositoryTestSuite) TestCreate() {
	// Arrange
	entity := suite.createValid{{.EntityName}}()

	// Act
	err := suite.repo.Create(suite.ctx, entity)

	// Assert
	require.NoError(suite.T(), err)
	
	// Verify entity was created in database
	retrieved, err := suite.repo.GetByID(suite.ctx, entity.ID)
	require.NoError(suite.T(), err)
	assert.Equal(suite.T(), entity.{{.EntityName}}Code, retrieved.{{.EntityName}}Code)
	assert.Equal(suite.T(), entity.{{.EntityName}}Name, retrieved.{{.EntityName}}Name)
	assert.Equal(suite.T(), entity.TenantID, retrieved.TenantID)
}

func (suite *{{.EntityName}}RepositoryTestSuite) TestCreate_DuplicateCode() {
	// Arrange
	entity1 := suite.createValid{{.EntityName}}()
	entity2 := suite.createValid{{.EntityName}}()
	entity2.{{.EntityName}}Code = entity1.{{.EntityName}}Code // Same code

	// Act
	err1 := suite.repo.Create(suite.ctx, entity1)
	err2 := suite.repo.Create(suite.ctx, entity2)

	// Assert
	require.NoError(suite.T(), err1)
	require.Error(suite.T(), err2)
	assert.Contains(suite.T(), err2.Error(), "duplicate")
}

func (suite *{{.EntityName}}RepositoryTestSuite) TestCreate_TenantIsolation() {
	// Arrange
	entity1 := suite.createValid{{.EntityName}}()
	entity1.TenantID = suite.tenantID

	// Create entity with different tenant
	otherTenantID := uuid.New()
	entity2 := suite.createValid{{.EntityName}}()
	entity2.TenantID = otherTenantID
	entity2.{{.EntityName}}Code = entity1.{{.EntityName}}Code // Same code, different tenant

	// Act
	err1 := suite.repo.Create(suite.ctx, entity1)
	
	// Switch context to other tenant
	otherCtx := database.WithTenantID(context.Background(), otherTenantID)
	err2 := suite.repo.Create(otherCtx, entity2)

	// Assert
	require.NoError(suite.T(), err1)
	require.NoError(suite.T(), err2) // Should succeed due to tenant isolation
}

