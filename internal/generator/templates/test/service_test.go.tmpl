				HasChildren: true,
			},
			{
				ID:          uuid.New(),
				TenantID:    suite.tenantID,
				{{.EntityName}}Code: "CHILD",
				{{.EntityName}}Name: "Child {{.EntityName}}",
				ParentID:    &rootID,
				Level:       2,
				Path:        strPtr("ROOT/CHILD"),
				HasChildren: false,
			},
		}

		// Setup mocks
		suite.mockABAC.EXPECT().
			CheckPermission(gomock.Any(), suite.userID, "{{snakeCase .EntityName}}.read", gomock.Any()).
			Return(true, nil)

		suite.mockRepo.EXPECT().
			GetHierarchy(gomock.Any(), rootID).
			Return(hierarchy, nil)

		// Act
		result, err := suite.service.Get{{.EntityName}}Hierarchy(suite.ctx, rootID)

		// Assert
		require.NoError(t, err)
		assert.NotNil(t, result)
		assert.Len(t, result, 2)
		assert.True(t, result[0].HasChildren)
		assert.False(t, result[1].HasChildren)
	})
}

