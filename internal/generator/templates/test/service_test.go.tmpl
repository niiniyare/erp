func TestValidate{{.EntityName}}Code(t *testing.T) {
	suite := setup{{.EntityName}}ServiceTest(t)
	defer suite.tearDown()

	t.Run("unique code", func(t *testing.T) {
		// Arrange
		code := "UNIQUE001"

		// Setup mocks
		suite.mockRepo.EXPECT().
			ExistsByCode(gomock.Any(), code, nil).
			Return(false, nil)

		// Act
		err := suite.service.Validate{{.EntityName}}Code(suite.ctx, code, nil)

		// Assert
		assert.NoError(t, err)
	})

	t.Run("duplicate code", func(t *testing.T) {
		// Arrange
		code := "DUPLICATE001"

		// Setup mocks
		suite.mockRepo.EXPECT().
			ExistsByCode(gomock.Any(), code, nil).
			Return(true, nil)

		// Act
		err := suite.service.Validate{{.EntityName}}Code(suite.ctx, code, nil)

		// Assert
		assert.Error(t, err)
		assert.Contains(t, err.Error(), "already exists")
	})

	t.Run("code with exclusion", func(t *testing.T) {
		// Arrange
		code := "UPDATE001"
		excludeID := uuid.New()

		// Setup mocks
		suite.mockRepo.EXPECT().
			ExistsByCode(gomock.Any(), code, &excludeID).
			Return(false, nil)

		// Act
		err := suite.service.Validate{{.EntityName}}Code(suite.ctx, code, &excludeID)

		// Assert
		assert.NoError(t, err)
	})
}

