func TestCreate{{.EntityName}}(t *testing.T) {
	suite := setup{{.EntityName}}ServiceTest(t)
	defer suite.tearDown()

	t.Run("successful creation", func(t *testing.T) {
		// Arrange
		request := &domain.Create{{.EntityName}}Request{
			{{.EntityName}}Code: "TEST001",
			{{.EntityName}}Name: "Test {{.EntityName}}",
			{{.EntityName}}Type: "STANDARD",
			IsActive: true,
		}

		expectedEntity := &domain.{{.EntityName}}{
			ID:       uuid.New(),
			TenantID: suite.tenantID,
			{{.EntityName}}Code: request.{{.EntityName}}Code,
			{{.EntityName}}Name: request.{{.EntityName}}Name,
			{{.EntityName}}Type: request.{{.EntityName}}Type,
			Status:   domain.{{.EntityName}}StatusActive,
			IsActive: request.IsActive,
			CreatedBy: suite.userID,
		}

		// Setup mocks
		suite.mockABAC.EXPECT().
			CheckPermission(gomock.Any(), suite.userID, "{{snakeCase .EntityName}}.create", gomock.Any()).
			Return(true, nil)

		suite.mockFeatureFlags.EXPECT().
			IsEnabled(gomock.Any(), "{{snakeCase .ModuleName}}.{{snakeCase .EntityName}}.create").
			Return(true, nil)

		suite.mockRepo.EXPECT().
			ExistsByCode(gomock.Any(), request.{{.EntityName}}Code, nil).
			Return(false, nil)

		suite.mockRepo.EXPECT().
			Create(gomock.Any(), gomock.Any()).
			DoAndReturn(func(ctx context.Context, entity *domain.{{.EntityName}}) error {
				assert.Equal(t, request.{{.EntityName}}Code, entity.{{.EntityName}}Code)
				assert.Equal(t, request.{{.EntityName}}Name, entity.{{.EntityName}}Name)
				assert.Equal(t, suite.tenantID, entity.TenantID)
				assert.Equal(t, suite.userID, entity.CreatedBy)
				return nil
			})

		suite.mockMetrics.EXPECT().
			Counter(gomock.Any(), gomock.Any()).
			Return(&metrics.MockCounter{}).
			AnyTimes()

		// Act
		result, err := suite.service.Create{{.EntityName}}(suite.ctx, request)

		// Assert
		require.NoError(t, err)
		assert.NotNil(t, result)
		assert.Equal(t, request.{{.EntityName}}Code, result.{{.EntityName}}Code)
		assert.Equal(t, request.{{.EntityName}}Name, result.{{.EntityName}}Name)
		assert.Equal(t, suite.tenantID, result.TenantID)
	})

	t.Run("permission denied", func(t *testing.T) {
		// Arrange
		request := &domain.Create{{.EntityName}}Request{
			{{.EntityName}}Code: "TEST001",
			{{.EntityName}}Name: "Test {{.EntityName}}",
			{{.EntityName}}Type: "STANDARD",
			IsActive: true,
		}

		// Setup mocks
		suite.mockABAC.EXPECT().
			CheckPermission(gomock.Any(), suite.userID, "{{snakeCase .EntityName}}.create", gomock.Any()).
			Return(false, nil)

		// Act
		result, err := suite.service.Create{{.EntityName}}(suite.ctx, request)

		// Assert
		assert.Error(t, err)
		assert.Nil(t, result)
		assert.Contains(t, err.Error(), "permission denied")
	})

	t.Run("feature disabled", func(t *testing.T) {
		// Arrange
		request := &domain.Create{{.EntityName}}Request{
			{{.EntityName}}Code: "TEST001",
			{{.EntityName}}Name: "Test {{.EntityName}}",
			{{.EntityName}}Type: "STANDARD",
			IsActive: true,
		}

		// Setup mocks
		suite.mockABAC.EXPECT().
			CheckPermission(gomock.Any(), suite.userID, "{{snakeCase .EntityName}}.create", gomock.Any()).
			Return(true, nil)

		suite.mockFeatureFlags.EXPECT().
			IsEnabled(gomock.Any(), "{{snakeCase .ModuleName}}.{{snakeCase .EntityName}}.create").
			Return(false, nil)

		// Act
		result, err := suite.service.Create{{.EntityName}}(suite.ctx, request)

		// Assert
		assert.Error(t, err)
		assert.Nil(t, result)
		assert.Contains(t, err.Error(), "feature disabled")
	})

	t.Run("duplicate code", func(t *testing.T) {
		// Arrange
		request := &domain.Create{{.EntityName}}Request{
			{{.EntityName}}Code: "TEST001",
			{{.EntityName}}Name: "Test {{.EntityName}}",
			{{.EntityName}}Type: "STANDARD",
			IsActive: true,
		}

		// Setup mocks
		suite.mockABAC.EXPECT().
			CheckPermission(gomock.Any(), suite.userID, "{{snakeCase .EntityName}}.create", gomock.Any()).
			Return(true, nil)

		suite.mockFeatureFlags.EXPECT().
			IsEnabled(gomock.Any(), "{{snakeCase .ModuleName}}.{{snakeCase .EntityName}}.create").
			Return(true, nil)

		suite.mockRepo.EXPECT().
			ExistsByCode(gomock.Any(), request.{{.EntityName}}Code, nil).
			Return(true, nil)

		// Act
		result, err := suite.service.Create{{.EntityName}}(suite.ctx, request)

		// Assert
		assert.Error(t, err)
		assert.Nil(t, result)
		assert.Contains(t, err.Error(), "already exists")
	})

	t.Run("invalid request", func(t *testing.T) {
		// Arrange
		request := &domain.Create{{.EntityName}}Request{
			{{.EntityName}}Code: "", // Invalid: empty code
			{{.EntityName}}Name: "Test {{.EntityName}}",
			{{.EntityName}}Type: "STANDARD",
			IsActive: true,
		}

		// Act
		result, err := suite.service.Create{{.EntityName}}(suite.ctx, request)

		// Assert
		assert.Error(t, err)
		assert.Nil(t, result)
		assert.Contains(t, err.Error(), "validation")
	})
}

