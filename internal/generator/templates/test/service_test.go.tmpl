func TestList{{.EntityNamePlural}}(t *testing.T) {
	suite := setup{{.EntityName}}ServiceTest(t)
	defer suite.tearDown()

	t.Run("successful list", func(t *testing.T) {
		// Arrange
		filter := &domain.{{.EntityName}}Filter{
			IsActive: boolPtr(true),
		}

		expected{{.EntityNamePlural}} := []*domain.{{.EntityName}}{
			{
				ID:          uuid.New(),
				TenantID:    suite.tenantID,
				{{.EntityName}}Code: "TEST001",
				{{.EntityName}}Name: "Test {{.EntityName}} 1",
				IsActive:    true,
			},
			{
				ID:          uuid.New(),
				TenantID:    suite.tenantID,
				{{.EntityName}}Code: "TEST002",
				{{.EntityName}}Name: "Test {{.EntityName}} 2",
				IsActive:    true,
			},
		}

		expectedPagination := domain.PaginationMeta{
			CurrentPage: 1,
			PageSize:    20,
			TotalItems:  2,
			TotalPages:  1,
			HasNext:     false,
			HasPrev:     false,
		}

		// Setup mocks
		suite.mockABAC.EXPECT().
			CheckPermission(gomock.Any(), suite.userID, "{{snakeCase .EntityName}}.list", gomock.Any()).
			Return(true, nil)

		suite.mockRepo.EXPECT().
			List(gomock.Any(), filter).
			Return(expected{{.EntityNamePlural}}, nil)

		suite.mockRepo.EXPECT().
			Count(gomock.Any(), filter).
			Return(int64(2), nil)

		// Act
		result, err := suite.service.List{{.EntityNamePlural}}(suite.ctx, filter)

		// Assert
		require.NoError(t, err)
		assert.NotNil(t, result)
		assert.Len(t, result.{{.EntityNamePlural}}, 2)
		assert.Equal(t, expectedPagination.TotalItems, result.Pagination.TotalItems)
	})

	t.Run("empty result", func(t *testing.T) {
		// Arrange
		filter := &domain.{{.EntityName}}Filter{}

		// Setup mocks
		suite.mockABAC.EXPECT().
			CheckPermission(gomock.Any(), suite.userID, "{{snakeCase .EntityName}}.list", gomock.Any()).
			Return(true, nil)

		suite.mockRepo.EXPECT().
			List(gomock.Any(), filter).
			Return([]*domain.{{.EntityName}}{}, nil)

		suite.mockRepo.EXPECT().
			Count(gomock.Any(), filter).
			Return(int64(0), nil)

		// Act
		result, err := suite.service.List{{.EntityNamePlural}}(suite.ctx, filter)

		// Assert
		require.NoError(t, err)
		assert.NotNil(t, result)
		assert.Empty(t, result.{{.EntityNamePlural}})
		assert.Equal(t, int32(0), result.Pagination.TotalItems)
	})
}

