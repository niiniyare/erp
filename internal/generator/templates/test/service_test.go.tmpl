func TestDelete{{.EntityName}}(t *testing.T) {
	suite := setup{{.EntityName}}ServiceTest(t)
	defer suite.tearDown()

	t.Run("successful deletion", func(t *testing.T) {
		// Arrange
		entityID := uuid.New()
		existingEntity := &domain.{{.EntityName}}{
			ID:              entityID,
			TenantID:        suite.tenantID,
			{{.EntityName}}Code:         "TEST001",
			{{.EntityName}}Name:         "Test {{.EntityName}}",
			IsSystemDefined: false,
			{{- if contains .ModuleName "finance"}}
			HasChildren:     false,
			{{- end}}
		}

		// Setup mocks
		suite.mockABAC.EXPECT().
			CheckPermission(gomock.Any(), suite.userID, "{{snakeCase .EntityName}}.delete", gomock.Any()).
			Return(true, nil)

		suite.mockRepo.EXPECT().
			GetByID(gomock.Any(), entityID).
			Return(existingEntity, nil)

		{{- if contains .ModuleName "finance"}}
		suite.mockRepo.EXPECT().
			HasDependencies(gomock.Any(), entityID).
			Return(false, nil)

		suite.mockRepo.EXPECT().
			HasChildren(gomock.Any(), entityID).
			Return(false, nil)
		{{- end}}

		suite.mockRepo.EXPECT().
			Delete(gomock.Any(), entityID).
			Return(nil)

		suite.mockMetrics.EXPECT().
			Counter(gomock.Any(), gomock.Any()).
			Return(&metrics.MockCounter{}).
			AnyTimes()

		// Act
		err := suite.service.Delete{{.EntityName}}(suite.ctx, entityID)

		// Assert
		assert.NoError(t, err)
	})

	t.Run("cannot delete system entity", func(t *testing.T) {
		// Arrange
		entityID := uuid.New()
		existingEntity := &domain.{{.EntityName}}{
			ID:              entityID,
			TenantID:        suite.tenantID,
			{{.EntityName}}Code:         "SYS001",
			{{.EntityName}}Name:         "System {{.EntityName}}",
			IsSystemDefined: true, // System entity
		}

		// Setup mocks
		suite.mockABAC.EXPECT().
			CheckPermission(gomock.Any(), suite.userID, "{{snakeCase .EntityName}}.delete", gomock.Any()).
			Return(true, nil)

		suite.mockRepo.EXPECT().
			GetByID(gomock.Any(), entityID).
			Return(existingEntity, nil)

		// Act
		err := suite.service.Delete{{.EntityName}}(suite.ctx, entityID)

		// Assert
		assert.Error(t, err)
		assert.Contains(t, err.Error(), "system-defined")
	})

	{{- if contains .ModuleName "finance"}}
	t.Run("cannot delete entity with children", func(t *testing.T) {
		// Arrange
		entityID := uuid.New()
		existingEntity := &domain.{{.EntityName}}{
			ID:              entityID,
			TenantID:        suite.tenantID,
			{{.EntityName}}Code:         "PARENT001",
			{{.EntityName}}Name:         "Parent {{.EntityName}}",
			IsSystemDefined: false,
			HasChildren:     true, // Has children
		}

		// Setup mocks
		suite.mockABAC.EXPECT().
			CheckPermission(gomock.Any(), suite.userID, "{{snakeCase .EntityName}}.delete", gomock.Any()).
			Return(true, nil)

		suite.mockRepo.EXPECT().
			GetByID(gomock.Any(), entityID).
			Return(existingEntity, nil)

		suite.mockRepo.EXPECT().
			HasDependencies(gomock.Any(), entityID).
			Return(false, nil)

		suite.mockRepo.EXPECT().
			HasChildren(gomock.Any(), entityID).
			Return(true, nil)

		// Act
		err := suite.service.Delete{{.EntityName}}(suite.ctx, entityID)

		// Assert
		assert.Error(t, err)
		assert.Contains(t, err.Error(), "children")
	})
	{{- end}}
}

