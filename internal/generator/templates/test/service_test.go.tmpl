type {{camelCase .EntityName}}ServiceTestSuite struct {
	ctrl           *gomock.Controller
	mockRepo       *mocks.Mock{{.EntityName}}Repository
	mockABAC       *mocks.MockABACService
	mockFeatureFlags *mocks.MockFeatureFlagService
	mockMetrics    *mocks.MockMetricsProvider
	service        *{{.EntityName}}Service
	ctx            context.Context
	tenantID       uuid.UUID
	userID         uuid.UUID
}

func setup{{.EntityName}}ServiceTest(t *testing.T) *{{camelCase .EntityName}}ServiceTestSuite {
	ctrl := gomock.NewController(t)
	
	suite := &{{camelCase .EntityName}}ServiceTestSuite{
		ctrl:           ctrl,
		mockRepo:       mocks.NewMock{{.EntityName}}Repository(ctrl),
		mockABAC:       mocks.NewMockABACService(ctrl),
		mockFeatureFlags: mocks.NewMockFeatureFlagService(ctrl),
		mockMetrics:    mocks.NewMockMetricsProvider(ctrl),
		tenantID:       uuid.New(),
		userID:         uuid.New(),
	}
	
	// Create service with mocks
	suite.service = New{{.EntityName}}Service(
		suite.mockRepo,
		suite.mockABAC,
		suite.mockFeatureFlags,
		suite.mockMetrics,
		logger.NewNullLogger(),
	)
	
	// Setup context with tenant and user
	suite.ctx = auth.WithTenantID(context.Background(), suite.tenantID)
	suite.ctx = auth.WithUserID(suite.ctx, suite.userID)
	
	return suite
}

func (suite *{{camelCase .EntityName}}ServiceTestSuite) tearDown() {
	suite.ctrl.Finish()
}

