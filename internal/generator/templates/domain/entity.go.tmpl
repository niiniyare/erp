{{comment "Business methods"}}

{{comment (printf "CanAcceptTransactions determines if the %s can accept transactions" (lowerCase .EntityName))}}
func (e *{{.EntityName}}) CanAcceptTransactions() bool {
	return e.Status == {{.EntityName}}StatusActive &&
		e.IsActive &&
		e.AllowManualEntries &&
		e.DeletedAt == nil &&
		e.ValidationStatus == ValidationStatusValid
}

{{comment (printf "CanBeUsedInReports determines if the %s should be included in reports" (lowerCase .EntityName))}}
func (e *{{.EntityName}}) CanBeUsedInReports() bool {
	return e.ShowInReports &&
		e.DeletedAt == nil &&
		e.Status != {{.EntityName}}StatusDraft
}

{{comment (printf "RequiresApproval checks if the %s is in a state requiring approval" (lowerCase .EntityName))}}
func (e *{{.EntityName}}) RequiresApproval() bool {
	return e.Status == {{.EntityName}}StatusPendingApproval ||
		e.Status == {{.EntityName}}StatusUnderReview
}

{{comment "Validate validates the entity"}}
func (e *{{.EntityName}}) Validate() []ValidationError {
	var errors []ValidationError

	// Validate required fields
	if e.TenantID == uuid.Nil {
		errors = append(errors, ValidationError{
			Field:   "tenant_id",
			Message: "Tenant ID is required",
			Code:    "REQUIRED_FIELD",
		})
	}

	if strings.TrimSpace(e.{{.EntityName}}Code) == "" {
		errors = append(errors, ValidationError{
			Field:   "{{snakeCase .EntityName}}_code",
			Message: "{{.EntityName}} code is required",
			Code:    "REQUIRED_FIELD",
		})
	} else if len(e.{{.EntityName}}Code) > 50 {
		errors = append(errors, ValidationError{
			Field:   "{{snakeCase .EntityName}}_code",
			Message: "{{.EntityName}} code must be 50 characters or less",
			Code:    "MAX_LENGTH_EXCEEDED",
		})
	}

	// Validate code format
	if !isValid{{.EntityName}}Code(e.{{.EntityName}}Code) {
		errors = append(errors, ValidationError{
			Field:   "{{snakeCase .EntityName}}_code",
			Message: "{{.EntityName}} code must contain only alphanumeric characters and hyphens",
			Code:    "INVALID_FORMAT",
		})
	}

	if strings.TrimSpace(e.{{.EntityName}}Name) == "" {
		errors = append(errors, ValidationError{
			Field:   "{{snakeCase .EntityName}}_name",
			Message: "{{.EntityName}} name is required",
			Code:    "REQUIRED_FIELD",
		})
	} else if len(e.{{.EntityName}}Name) > 200 {
		errors = append(errors, ValidationError{
			Field:   "{{snakeCase .EntityName}}_name",
			Message: "{{.EntityName}} name must be 200 characters or less",
			Code:    "MAX_LENGTH_EXCEEDED",
		})
	}

	// Validate status
	if !e.Status.IsValid() {
		errors = append(errors, ValidationError{
			Field:   "status",
			Message: "Invalid status",
			Code:    "INVALID_VALUE",
		})
	}

	{{- if or (contains .ModuleName "finance") (contains .ModuleName "account") (contains .ModuleName "budget")}}
	// Validate currency code format if provided
	if e.CurrencyCode != nil && len(*e.CurrencyCode) != 3 {
		errors = append(errors, ValidationError{
			Field:   "currency_code",
			Message: "Currency code must be exactly 3 characters (ISO 4217)",
			Code:    "INVALID_FORMAT",
		})
	}

	// Validate amount
	if e.Amount.IsNegative() {
		errors = append(errors, ValidationError{
			Field:   "amount",
			Message: "Amount cannot be negative",
			Code:    "VALUE_OUT_OF_RANGE",
		})
	}
	{{- end}}

	// Business rule validations
	if e.ParentID != nil && *e.ParentID == e.ID {
		errors = append(errors, ValidationError{
			Field:   "parent_id",
			Message: "Entity cannot be its own parent",
			Code:    "BUSINESS_RULE_VIOLATION",
		})
	}

	// Validate hierarchy level consistency
	if e.ParentID == nil && e.Level != 0 {
		errors = append(errors, ValidationError{
			Field:   "level",
			Message: "Root entities must have level 0",
			Code:    "INCONSISTENT_VALUE",
		})
	}

	if e.ParentID != nil && e.Level <= 0 {
		errors = append(errors, ValidationError{
			Field:   "level",
			Message: "Child entities must have level > 0",
			Code:    "INCONSISTENT_VALUE",
		})
	}

	return errors
}

{{comment (printf "isValid%sCode validates the %s code format" .EntityName (lowerCase .EntityName))}}
func isValid{{.EntityName}}Code(code string) bool {
	// Allow alphanumeric characters and hyphens
	matched, _ := regexp.MatchString(`^[A-Za-z0-9\-]+$`, code)
	return matched
}

{{comment (printf "IsDescendantOf checks if this %s is a descendant of the specified parent" (lowerCase .EntityName))}}
func (e *{{.EntityName}}) IsDescendantOf(parentID uuid.UUID) bool {
	if e.Path == nil {
		return false
	}
	parentPath := fmt.Sprintf("/%s/", parentID.String())
	return strings.Contains(*e.Path, parentPath)
}

{{comment (printf "CanBeDeactivated checks if the %s can be marked as inactive" (lowerCase .EntityName))}}
func (e *{{.EntityName}}) CanBeDeactivated() bool {
	// Cannot deactivate system entities
	if e.IsSystemDefined {
		return false
	}

	// Cannot deactivate if it has children
	if e.HasChildren {
		return false
	}

	return true
}

{{comment (printf "Marshal%sAttributes marshals entity attributes to JSON" .EntityName)}}
func (e *{{.EntityName}}) Marshal{{.EntityName}}Attributes() ([]byte, error) {
	if e.{{.EntityName}}Attributes == nil {
		return []byte("{}"), nil
	}
	return json.Marshal(e.{{.EntityName}}Attributes)
}

{{comment (printf "Unmarshal%sAttributes unmarshals entity attributes from JSON" .EntityName)}}
func (e *{{.EntityName}}) Unmarshal{{.EntityName}}Attributes(data []byte) error {
	if len(data) == 0 {
		e.{{.EntityName}}Attributes = make(map[string]any)
		return nil
	}
	return json.Unmarshal(data, &e.{{.EntityName}}Attributes)
}

