{{comment "Validate validates the update request"}}
func (r *Update{{.EntityName}}Request) Validate() []ValidationError {
	var errors []ValidationError

	if r.{{.EntityName}}Name != nil {
		if strings.TrimSpace(*r.{{.EntityName}}Name) == "" {
			errors = append(errors, ValidationError{
				Field:   "{{snakeCase .EntityName}}_name",
				Message: "{{.EntityName}} name cannot be empty",
				Code:    "REQUIRED_FIELD",
			})
		} else if len(*r.{{.EntityName}}Name) > 200 {
			errors = append(errors, ValidationError{
				Field:   "{{snakeCase .EntityName}}_name",
				Message: "{{.EntityName}} name must be 200 characters or less",
				Code:    "MAX_LENGTH_EXCEEDED",
			})
		}
	}

	if r.DisplayOrder != nil && *r.DisplayOrder < 0 {
		errors = append(errors, ValidationError{
			Field:   "display_order",
			Message: "Display order must be non-negative",
			Code:    "VALUE_OUT_OF_RANGE",
		})
	}

	{{- if or (contains .ModuleName "finance") (contains .ModuleName "account") (contains .ModuleName "budget")}}
	if r.Amount != nil && r.Amount.IsNegative() {
		errors = append(errors, ValidationError{
			Field:   "amount",
			Message: "Amount cannot be negative",
			Code:    "VALUE_OUT_OF_RANGE",
		})
	}

	if r.CurrencyCode != nil && len(*r.CurrencyCode) != 3 {
		errors = append(errors, ValidationError{
			Field:   "currency_code",
			Message: "Currency code must be exactly 3 characters (ISO 4217)",
			Code:    "INVALID_FORMAT",
		})
	}
	{{- end}}

	return errors
}

{{comment "Validate validates the filter"}}
func (f *{{.EntityName}}Filter) Validate() []ValidationError {
	var errors []ValidationError

	if f.Status != nil && !f.Status.IsValid() {
		errors = append(errors, ValidationError{
			Field:   "status",
			Message: "Invalid status",
			Code:    "INVALID_VALUE",
		})
	}

	if f.Limit != nil && *f.Limit < 0 {
		errors = append(errors, ValidationError{
			Field:   "limit",
			Message: "Limit must be non-negative",
			Code:    "INVALID_VALUE",
		})
	}

	if f.Offset != nil && *f.Offset < 0 {
		errors = append(errors, ValidationError{
			Field:   "offset",
			Message: "Offset must be non-negative",
			Code:    "INVALID_VALUE",
		})
	}

	return errors
}

