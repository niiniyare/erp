{{comment "Normal balance types"}}
type NormalBalance string

const (
	NormalBalanceDebit  NormalBalance = "debit"
	NormalBalanceCredit NormalBalance = "credit"
)

{{comment "IsValid checks if the normal balance is valid"}}
func (n NormalBalance) IsValid() bool {
	switch n {
	case NormalBalanceDebit, NormalBalanceCredit:
		return true
	default:
		return false
	}
}

{{comment "GetNormalBalanceForRootType returns the expected normal balance for a root type"}}
func GetNormalBalanceForRootType(rootType RootType) NormalBalance {
	switch rootType {
	case RootTypeAsset, RootTypeExpense:
		return NormalBalanceDebit
	case RootTypeLiability, RootTypeEquity, RootTypeRevenue:
		return NormalBalanceCredit
	default:
		return NormalBalanceDebit
	}
}
