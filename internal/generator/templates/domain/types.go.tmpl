{{comment (printf "%sStatus represents the status of a %s" .EntityName (lowerCase .EntityName))}}
type {{.EntityName}}Status string

{{comment (printf "%s status constants" .EntityName)}}
const (
	{{.EntityName}}StatusDraft            {{.EntityName}}Status = "draft"
	{{.EntityName}}StatusPendingApproval  {{.EntityName}}Status = "pending_approval"
	{{.EntityName}}StatusActive           {{.EntityName}}Status = "active"
	{{.EntityName}}StatusInactive         {{.EntityName}}Status = "inactive"
	{{.EntityName}}StatusSuspended        {{.EntityName}}Status = "suspended"
	{{.EntityName}}StatusUnderReview      {{.EntityName}}Status = "under_review"
	{{.EntityName}}StatusRestricted       {{.EntityName}}Status = "restricted"
	{{.EntityName}}StatusFrozen           {{.EntityName}}Status = "frozen"
	{{.EntityName}}StatusClosed           {{.EntityName}}Status = "closed"
	{{.EntityName}}StatusArchived         {{.EntityName}}Status = "archived"
)

{{comment "IsValid checks if the status is valid"}}
func (s {{.EntityName}}Status) IsValid() bool {
	switch s {
	case {{.EntityName}}StatusDraft, {{.EntityName}}StatusPendingApproval, {{.EntityName}}StatusActive,
		 {{.EntityName}}StatusInactive, {{.EntityName}}StatusSuspended, {{.EntityName}}StatusUnderReview,
		 {{.EntityName}}StatusRestricted, {{.EntityName}}StatusFrozen, {{.EntityName}}StatusClosed,
		 {{.EntityName}}StatusArchived:
		return true
	default:
		return false
	}
}

{{comment "String returns the string representation of the status"}}
func (s {{.EntityName}}Status) String() string {
	return string(s)
}

{{comment "Value implements the driver.Valuer interface for database storage"}}
func (s {{.EntityName}}Status) Value() (driver.Value, error) {
	if !s.IsValid() {
		return nil, fmt.Errorf("invalid {{lowerCase .EntityName}} status: %s", s)
	}
	return string(s), nil
}

{{comment "Scan implements the sql.Scanner interface for database retrieval"}}
func (s *{{.EntityName}}Status) Scan(value interface{}) error {
	if value == nil {
		*s = {{.EntityName}}StatusDraft
		return nil
	}
	
	switch v := value.(type) {
	case string:
		*s = {{.EntityName}}Status(v)
	case []byte:
		*s = {{.EntityName}}Status(v)
	default:
		return fmt.Errorf("cannot scan %T into {{.EntityName}}Status", value)
	}
	
	if !s.IsValid() {
		return fmt.Errorf("invalid {{lowerCase .EntityName}} status: %s", *s)
	}
	
	return nil
}

{{comment "All{{.EntityName}}Statuses returns all possible statuses"}}
func All{{.EntityName}}Statuses() []{{.EntityName}}Status {
	return []{{.EntityName}}Status{
		{{.EntityName}}StatusDraft,
		{{.EntityName}}StatusPendingApproval,
		{{.EntityName}}StatusActive,
		{{.EntityName}}StatusInactive,
		{{.EntityName}}StatusSuspended,
		{{.EntityName}}StatusUnderReview,
		{{.EntityName}}StatusRestricted,
		{{.EntityName}}StatusFrozen,
		{{.EntityName}}StatusClosed,
		{{.EntityName}}StatusArchived,
	}
}

{{comment "ValidationStatus represents the validation state of an entity"}}
type ValidationStatus string

{{comment "Validation status constants"}}
const (
	ValidationStatusValid     ValidationStatus = "valid"
	ValidationStatusInvalid   ValidationStatus = "invalid"
	ValidationStatusPending   ValidationStatus = "pending"
	ValidationStatusWarning   ValidationStatus = "warning"
	ValidationStatusUnknown   ValidationStatus = "unknown"
)

{{comment "IsValid checks if the validation status is valid"}}
func (v ValidationStatus) IsValid() bool {
	switch v {
	case ValidationStatusValid, ValidationStatusInvalid, ValidationStatusPending,
		 ValidationStatusWarning, ValidationStatusUnknown:
		return true
	default:
		return false
	}
}

{{comment "String returns the string representation of the validation status"}}
func (v ValidationStatus) String() string {
	return string(v)
}

{{comment "ValidationError represents a validation error"}}
type ValidationError struct {
	Field   string `json:"field"`
	Message string `json:"message"`
	Code    string `json:"code"`
	Value   any    `json:"value,omitempty"`
}

{{comment "Error implements the error interface"}}
func (e ValidationError) Error() string {
	return fmt.Sprintf("%s: %s", e.Field, e.Message)
}

{{comment "ValidationErrors represents a collection of validation errors"}}
type ValidationErrors []ValidationError

{{comment "Error implements the error interface"}}
func (e ValidationErrors) Error() string {
	if len(e) == 0 {
		return ""
	}
	
	var messages []string
	for _, err := range e {
		messages = append(messages, err.Error())
	}
	
	return strings.Join(messages, "; ")
}

{{comment "HasErrors checks if there are any validation errors"}}
func (e ValidationErrors) HasErrors() bool {
	return len(e) > 0
}

{{comment "Add adds a validation error"}}
func (e *ValidationErrors) Add(field, message string) {
	*e = append(*e, ValidationError{
		Field:   field,
		Message: message,
		Code:    "VALIDATION_ERROR",
	})
}

{{comment "AddWithCode adds a validation error with a specific code"}}
func (e *ValidationErrors) AddWithCode(field, message, code string) {
	*e = append(*e, ValidationError{
		Field:   field,
		Message: message,
		Code:    code,
	})
}

{{comment "AddWithValue adds a validation error with a value"}}
func (e *ValidationErrors) AddWithValue(field, message, code string, value any) {
	*e = append(*e, ValidationError{
		Field:   field,
		Message: message,
		Code:    code,
		Value:   value,
	})
}

