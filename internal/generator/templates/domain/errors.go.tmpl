{{comment (printf "%sError represents a domain-specific error with context" .EntityName)}}
type {{.EntityName}}Error struct {
	Code     string
	Message  string
	Field    string
	Value    any
	Cause    error
	{{.EntityName}}ID *string
}

{{comment "Error implements the error interface"}}
func (e *{{.EntityName}}Error) Error() string {
	if e.{{.EntityName}}ID != nil {
		return fmt.Sprintf("{{lowerCase .EntityName}} error [%s]: %s ({{lowerCase .EntityName}}_id: %s)", e.Code, e.Message, *e.{{.EntityName}}ID)
	}
	return fmt.Sprintf("{{lowerCase .EntityName}} error [%s]: %s", e.Code, e.Message)
}

{{comment "Unwrap returns the underlying error"}}
func (e *{{.EntityName}}Error) Unwrap() error {
	return e.Cause
}

{{comment "Is checks if the error matches the target"}}
func (e *{{.EntityName}}Error) Is(target error) bool {
	if t, ok := target.(*{{.EntityName}}Error); ok {
		return e.Code == t.Code
	}
	return false
}

{{comment (printf "New%sError creates a new %s error" .EntityName (lowerCase .EntityName))}}
func New{{.EntityName}}Error(code, message string) *{{.EntityName}}Error {
	return &{{.EntityName}}Error{
		Code:    code,
		Message: message,
	}
}

{{comment (printf "New%sErrorWithField creates a new %s error with field context" .EntityName (lowerCase .EntityName))}}
func New{{.EntityName}}ErrorWithField(code, message, field string, value any) *{{.EntityName}}Error {
	return &{{.EntityName}}Error{
		Code:    code,
		Message: message,
		Field:   field,
		Value:   value,
	}
}

{{comment (printf "New%sErrorWithCause creates a new %s error with underlying cause" .EntityName (lowerCase .EntityName))}}
func New{{.EntityName}}ErrorWithCause(code, message string, cause error) *{{.EntityName}}Error {
	return &{{.EntityName}}Error{
		Code:    code,
		Message: message,
		Cause:   cause,
	}
}

{{comment (printf "New%sErrorWithID creates a new %s error with entity ID" .EntityName (lowerCase .EntityName))}}
func New{{.EntityName}}ErrorWithID(code, message string, {{camelCase .EntityName}}ID string) *{{.EntityName}}Error {
	return &{{.EntityName}}Error{
		Code:       code,
		Message:    message,
		{{.EntityName}}ID: &{{camelCase .EntityName}}ID,
	}
}

{{comment "Business rule validation errors"}}

{{comment (printf "ValidateNotFound checks if %s was not found" (lowerCase .EntityName))}}
func ValidateNotFound({{camelCase .EntityName}}ID string) error {
	return New{{.EntityName}}ErrorWithID("NOT_FOUND", "{{.EntityName}} not found", {{camelCase .EntityName}}ID)
}

{{comment (printf "ValidateAlreadyExists checks if %s already exists" (lowerCase .EntityName))}}
func ValidateAlreadyExists(code string) error {
	return New{{.EntityName}}ErrorWithField("ALREADY_EXISTS", "{{.EntityName}} with this code already exists", "{{snakeCase .EntityName}}_code", code)
}

{{comment (printf "ValidateCannotDelete checks if %s can be deleted" (lowerCase .EntityName))}}
func ValidateCannotDelete({{camelCase .EntityName}}ID string, reason string) error {
	message := fmt.Sprintf("{{.EntityName}} cannot be deleted: %s", reason)
	return New{{.EntityName}}ErrorWithID("CANNOT_DELETE", message, {{camelCase .EntityName}}ID)
}

{{comment (printf "ValidateInvalidTransition checks state transition validity for %s" (lowerCase .EntityName))}}
func ValidateInvalidTransition(from, to {{.EntityName}}Status) error {
	message := fmt.Sprintf("Invalid transition from %s to %s", from, to)
	return New{{.EntityName}}Error("INVALID_TRANSITION", message)
}

{{comment (printf "ValidateCircularReference checks for circular references in %s hierarchy" (lowerCase .EntityName))}}
func ValidateCircularReference({{camelCase .EntityName}}ID, parentID string) error {
	message := fmt.Sprintf("Circular reference detected: {{lowerCase .EntityName}} %s cannot be parent of %s", parentID, {{camelCase .EntityName}}ID)
	return New{{.EntityName}}Error("CIRCULAR_REFERENCE", message)
}

{{comment (printf "ValidateMaxDepth checks hierarchy depth for %s" (lowerCase .EntityName))}}
func ValidateMaxDepth(currentDepth, maxDepth int) error {
	message := fmt.Sprintf("Maximum hierarchy depth (%d) exceeded, current depth: %d", maxDepth, currentDepth)
	return New{{.EntityName}}Error("MAX_DEPTH_EXCEEDED", message)
}

{{comment (printf "ValidateSystemEntity checks if %s is system-defined" (lowerCase .EntityName))}}
func ValidateSystemEntity({{camelCase .EntityName}}ID string) error {
	return New{{.EntityName}}ErrorWithID("SYSTEM_ENTITY", "Cannot modify system-defined {{lowerCase .EntityName}}", {{camelCase .EntityName}}ID)
}

{{- if or (contains .ModuleName "finance") (contains .ModuleName "account") (contains .ModuleName "budget")}}
