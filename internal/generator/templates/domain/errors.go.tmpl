{{comment "Error classification helpers"}}

{{comment (printf "Is%sNotFoundError checks if error is a not found error" .EntityName)}}
func Is{{.EntityName}}NotFoundError(err error) bool {
	var {{camelCase .EntityName}}Err *{{.EntityName}}Error
	if errors.As(err, &{{camelCase .EntityName}}Err) {
		return {{camelCase .EntityName}}Err.Code == "NOT_FOUND"
	}
	return errors.Is(err, Err{{.EntityName}}NotFound)
}

{{comment (printf "Is%sValidationError checks if error is a validation error" .EntityName)}}
func Is{{.EntityName}}ValidationError(err error) bool {
	var {{camelCase .EntityName}}Err *{{.EntityName}}Error
	if errors.As(err, &{{camelCase .EntityName}}Err) {
		return {{camelCase .EntityName}}Err.Code == "VALIDATION_ERROR" || 
			   {{camelCase .EntityName}}Err.Code == "INVALID_TRANSITION" ||
			   {{camelCase .EntityName}}Err.Code == "CIRCULAR_REFERENCE"
	}
	return false
}

{{comment (printf "Is%sBusinessRuleError checks if error is a business rule violation" .EntityName)}}
func Is{{.EntityName}}BusinessRuleError(err error) bool {
	var {{camelCase .EntityName}}Err *{{.EntityName}}Error
	if errors.As(err, &{{camelCase .EntityName}}Err) {
		return {{camelCase .EntityName}}Err.Code == "ALREADY_EXISTS" ||
			   {{camelCase .EntityName}}Err.Code == "CANNOT_DELETE" ||
			   {{camelCase .EntityName}}Err.Code == "SYSTEM_ENTITY" ||
			   {{camelCase .EntityName}}Err.Code == "MAX_DEPTH_EXCEEDED"
	}
	return false
}

{{comment (printf "Is%sPermissionError checks if error is a permission error" .EntityName)}}
func Is{{.EntityName}}PermissionError(err error) bool {
	var {{camelCase .EntityName}}Err *{{.EntityName}}Error
	if errors.As(err, &{{camelCase .EntityName}}Err) {
		return {{camelCase .EntityName}}Err.Code == "PERMISSION_DENIED" ||
			   {{camelCase .EntityName}}Err.Code == "READ_ONLY"
	}
	return false
}

{{comment (printf "Is%sConcurrencyError checks if error is a concurrency error" .EntityName)}}
func Is{{.EntityName}}ConcurrencyError(err error) bool {
	var {{camelCase .EntityName}}Err *{{.EntityName}}Error
	if errors.As(err, &{{camelCase .EntityName}}Err) {
		return {{camelCase .EntityName}}Err.Code == "VERSION_MISMATCH" ||
			   {{camelCase .EntityName}}Err.Code == "CONCURRENT_MODIFICATION"
	}
	return false
}

