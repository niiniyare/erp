{{comment "Concurrency validation errors"}}

{{comment (printf "ValidateVersionMismatch checks optimistic locking for %s" (lowerCase .EntityName))}}
func ValidateVersionMismatch({{camelCase .EntityName}}ID string, expected, actual int32) error {
