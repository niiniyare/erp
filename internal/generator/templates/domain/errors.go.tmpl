{{comment (printf "ValidateInsufficientBalance checks %s balance" (lowerCase .EntityName))}}
func ValidateInsufficientBalance({{camelCase .EntityName}}ID string, required, available string) error {
	message := fmt.Sprintf("Insufficient balance: required %s, available %s", required, available)
	return New{{.EntityName}}ErrorWithID("INSUFFICIENT_BALANCE", message, {{camelCase .EntityName}}ID)
}

{{comment (printf "ValidateCurrencyMismatch checks currency consistency for %s" (lowerCase .EntityName))}}
func ValidateCurrencyMismatch(expected, actual string) error {
	message := fmt.Sprintf("Currency mismatch: expected %s, got %s", expected, actual)
	return New{{.EntityName}}ErrorWithField("CURRENCY_MISMATCH", message, "currency_code", actual)
}

{{comment (printf "ValidateNegativeAmount checks for negative amounts in %s" (lowerCase .EntityName))}}
func ValidateNegativeAmount(amount string) error {
	message := fmt.Sprintf("Amount cannot be negative: %s", amount)
	return New{{.EntityName}}ErrorWithField("NEGATIVE_AMOUNT", message, "amount", amount)
}
