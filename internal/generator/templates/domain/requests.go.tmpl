{{comment (printf "%sSearchRequest represents a search request for %s" .EntityName (pluralize (lowerCase .EntityName)))}}
type {{.EntityName}}SearchRequest struct {
	// Search query
	Query string `json:"query" {{generateValidationTags "Query" "string"}}`
	
	// Entity context
	EntityID *uuid.UUID `json:"entity_id,omitempty"`
	
	// Search options
	Limit        *int32    `json:"limit,omitempty"`         // Max results (default: 10, max: 50)
	MatchType    *string   `json:"match_type,omitempty"`    // "exact", "prefix", "contains" (default: "contains")
	SearchFields []string  `json:"search_fields,omitempty"` // Fields to search in
	
	// Filters to apply to search results
	IsActive *bool `json:"is_active,omitempty"`
	{{- if contains .ModuleName "finance"}}
	ParentID *uuid.UUID `json:"parent_id,omitempty"`
	{{- end}}
}

{{comment (printf "Validate validates the search request")}}
func (r *{{.EntityName}}SearchRequest) Validate() error {
	if r.Query == "" {
		return New{{.EntityName}}ValidationError("Query", "search query is required")
	}
	
	if len(r.Query) > 255 {
		return New{{.EntityName}}ValidationError("Query", "search query too long (max 255 characters)")
	}
	
	return nil
}

{{comment (printf "GetLimit returns the search limit (default: 10, max: 50)")}}
func (r *{{.EntityName}}SearchRequest) GetLimit() int32 {
	if r.Limit == nil {
		return 10
	}
	if *r.Limit > 50 {
		return 50
	}
	if *r.Limit < 1 {
		return 1
	}
	return *r.Limit
}

{{comment (printf "GetMatchType returns the match type (default: contains)")}}
func (r *{{.EntityName}}SearchRequest) GetMatchType() string {
	if r.MatchType == nil {
		return "contains"
	}
	
	switch *r.MatchType {
	case "exact", "prefix", "contains":
		return *r.MatchType
	default:
		return "contains"
	}
}

{{comment (printf "GetSearchFields returns the fields to search in")}}
func (r *{{.EntityName}}SearchRequest) GetSearchFields() []string {
	if len(r.SearchFields) == 0 {
		return []string{"{{camelCase .EntityName}}_code", "{{camelCase .EntityName}}_name", "{{camelCase .EntityName}}_description"}
	}
	return r.SearchFields
}

