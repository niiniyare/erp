{{comment (printf "Validate validates the update %s request" (lowerCase .EntityName))}}
func (r *Update{{.EntityName}}Request) Validate() error {
	if r.ID == uuid.Nil {
		return New{{.EntityName}}ValidationError("ID", "id is required")
	}
	
	// At least one field must be provided for update
	hasUpdate := r.{{.EntityName}}Name != nil || 
		r.{{.EntityName}}Description != nil || 
		r.{{.EntityName}}Type != nil || 
		r.{{.EntityName}}Category != nil || 
		r.IsActive != nil || 
		r.DisplayOrder != nil || 
		r.ShowInReports != nil || 
		r.ReportCategory != nil || 
		r.AllowManualEntries != nil
		{{- if contains .ModuleName "finance"}} ||
		r.ParentID != nil ||
		r.Amount != nil ||
		r.CurrencyCode != nil
		{{- end}}
	
	if !hasUpdate {
		return New{{.EntityName}}ValidationError("Update", "at least one field must be provided for update")
	}
	
	// Validate non-empty strings
	if r.{{.EntityName}}Name != nil && *r.{{.EntityName}}Name == "" {
		return New{{.EntityName}}ValidationError("{{.EntityName}}Name", "{{camelCase .EntityName}}_name cannot be empty")
	}
	
	if r.{{.EntityName}}Type != nil && *r.{{.EntityName}}Type == "" {
		return New{{.EntityName}}ValidationError("{{.EntityName}}Type", "{{camelCase .EntityName}}_type cannot be empty")
	}
	
	return nil
}

