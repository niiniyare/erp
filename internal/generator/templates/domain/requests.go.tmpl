}

{{comment (printf "GetPage returns the page number (default: 1)" )}}
func (f *{{.EntityName}}Filter) GetPage() int32 {
	if f.Page == nil || *f.Page < 1 {
		return 1
	}
	return *f.Page
}

{{comment (printf "GetLimit returns the limit (default: 20, max: 100)")}}
func (f *{{.EntityName}}Filter) GetLimit() int32 {
	if f.Limit == nil {
		return 20
	}
	if *f.Limit > 100 {
		return 100
	}
	if *f.Limit < 1 {
		return 1
	}
	return *f.Limit
}

{{comment (printf "GetOffset returns the offset for pagination")}}
func (f *{{.EntityName}}Filter) GetOffset() int32 {
	return (f.GetPage() - 1) * f.GetLimit()
}

{{comment (printf "GetSortBy returns the sort field (default: {{camelCase .EntityName}}_code)")}}
func (f *{{.EntityName}}Filter) GetSortBy() string {
	if f.SortBy == nil {
		return "{{camelCase .EntityName}}_code"
	}
	return *f.SortBy
}

{{comment (printf "GetSortOrder returns the sort order (default: asc)")}}
func (f *{{.EntityName}}Filter) GetSortOrder() string {
	if f.SortOrder == nil {
		return "asc"
	}
	if *f.SortOrder != "desc" {
		return "asc"
	}
	return *f.SortOrder
}

