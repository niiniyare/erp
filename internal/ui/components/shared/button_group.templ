package shared

import "strings"

// ButtonGroupItem represents a single button in a group
type ButtonGroupItem struct {
	Text        string `json:"text" validate:"required"`
	Href        string `json:"href"`
	Icon        string `json:"icon"`
	Badge       string `json:"badge"`
	Active      bool   `json:"active"`
	Disabled    bool   `json:"disabled"`
	ID          string `json:"id"`
	AriaLabel   string `json:"aria_label"`
}

// ButtonGroupProps defines the properties for the ButtonGroup component
type ButtonGroupProps struct {
	Items       []ButtonGroupItem `json:"items" validate:"required,min=1"`
	Size        string            `json:"size" validate:"oneof=xs sm base lg xl"`
	Variant     string            `json:"variant" validate:"oneof=default outline"`
	Color       string            `json:"color" validate:"oneof=blue gray red green yellow indigo purple pink"`
	Orientation string            `json:"orientation" validate:"oneof=horizontal vertical"`
	FullWidth   bool              `json:"full_width"`
	ID          string            `json:"id"`
	Class       string            `json:"class"`
	AriaLabel   string            `json:"aria_label"`
}

// ButtonGroup renders a Flowbite-styled button group component
templ ButtonGroup(props ButtonGroupProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getButtonGroupClasses(props.Orientation, props.FullWidth) + " " + props.Class }
		role="group"
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
	>
		for i, item := range props.Items {
			if item.Href != "" {
				<a
					if item.ID != "" {
						id={ item.ID }
					}
					href={ item.Href }
					class={ getButtonGroupItemClasses(props.Size, props.Variant, props.Color, props.Orientation, i, len(props.Items), item.Active, item.Disabled) }
					if item.AriaLabel != "" {
						aria-label={ item.AriaLabel }
					}
					if item.Disabled {
						aria-disabled="true"
						tabindex="-1"
					}
				>
					@ButtonGroupItemContent(item)
				</a>
			} else {
				<button
					if item.ID != "" {
						id={ item.ID }
					}
					type="button"
					class={ getButtonGroupItemClasses(props.Size, props.Variant, props.Color, props.Orientation, i, len(props.Items), item.Active, item.Disabled) }
					if item.AriaLabel != "" {
						aria-label={ item.AriaLabel }
					}
					if item.Disabled {
						disabled
						aria-disabled="true"
					}
				>
					@ButtonGroupItemContent(item)
				</button>
			}
		}
	</div>
}

// ButtonGroupItemContent renders the content of a button group item
templ ButtonGroupItemContent(item ButtonGroupItem) {
	<div class="flex items-center">
		if item.Icon != "" {
			<span class={ getButtonGroupIconClasses() }>
				{ item.Icon }
			</span>
		}
		
		<span>{ item.Text }</span>
		
		if item.Badge != "" {
			<span class={ getButtonGroupBadgeClasses() }>
				{ item.Badge }
			</span>
		}
	</div>
}

// Helper functions for button group styling
func getButtonGroupClasses(orientation string, fullWidth bool) string {
	base := "inline-flex"
	
	if orientation == "vertical" {
		base = "inline-flex flex-col"
	}
	
	if fullWidth {
		base = "flex w-full"
		if orientation == "vertical" {
			base = "flex flex-col w-full"
		}
	}
	
	return base + " shadow-sm"
}

func getButtonGroupItemClasses(size, variant, color, orientation string, index, total int, active, disabled bool) string {
	base := "relative inline-flex items-center justify-center font-medium focus:z-10 transition-colors duration-200"
	
	// Size classes
	var sizeClass string
	switch size {
	case "xs":
		sizeClass = "px-2 py-1 text-xs"
	case "sm":
		sizeClass = "px-3 py-1.5 text-sm"
	case "lg":
		sizeClass = "px-4 py-2.5 text-sm"
	case "xl":
		sizeClass = "px-5 py-3 text-base"
	default: // base
		sizeClass = "px-3 py-2 text-sm"
	}
	
	// Position classes (rounded corners and borders)
	var positionClass string
	if orientation == "vertical" {
		if index == 0 {
			positionClass = "rounded-t-lg border"
		} else if index == total-1 {
			positionClass = "rounded-b-lg border border-t-0"
		} else {
			positionClass = "border border-t-0"
		}
	} else { // horizontal
		if index == 0 {
			positionClass = "rounded-s-lg border"
		} else if index == total-1 {
			positionClass = "rounded-e-lg border border-s-0"
		} else {
			positionClass = "border border-s-0"
		}
	}
	
	// Variant and color classes
	var variantClass string
	if variant == "outline" {
		variantClass = getButtonGroupOutlineClasses(color, active, disabled)
	} else {
		variantClass = getButtonGroupDefaultClasses(color, active, disabled)
	}
	
	// Focus classes
	focusClass := "focus:ring-2 focus:ring-offset-2"
	switch color {
	case "gray":
		focusClass += " focus:ring-gray-500"
	case "red":
		focusClass += " focus:ring-red-500"
	case "green":
		focusClass += " focus:ring-green-500"
	case "yellow":
		focusClass += " focus:ring-yellow-500"
	case "indigo":
		focusClass += " focus:ring-indigo-500"
	case "purple":
		focusClass += " focus:ring-purple-500"
	case "pink":
		focusClass += " focus:ring-pink-500"
	default: // blue
		focusClass += " focus:ring-blue-500"
	}
	
	classes := []string{base, sizeClass, positionClass, variantClass, focusClass}
	return strings.Join(classes, " ")
}

func getButtonGroupDefaultClasses(color string, active, disabled bool) string {
	if disabled {
		return "text-gray-400 bg-gray-100 cursor-not-allowed border-primary-200 dark:bg-gray-700 dark:text-gray-500 dark:border-gray-600"
	}
	
	if active {
		switch color {
		case "gray":
			return "text-white bg-gray-900 border-gray-900 dark:bg-gray-600 dark:border-gray-600"
		case "red":
			return "text-white bg-red-700 border-red-700 dark:bg-red-600 dark:border-red-600"
		case "green":
			return "text-white bg-green-700 border-green-700 dark:bg-green-600 dark:border-green-600"
		case "yellow":
			return "text-white bg-yellow-400 border-yellow-400 dark:bg-yellow-300 dark:border-yellow-300"
		case "indigo":
			return "text-white bg-indigo-700 border-indigo-700 dark:bg-indigo-600 dark:border-indigo-600"
		case "purple":
			return "text-white bg-purple-700 border-purple-700 dark:bg-purple-600 dark:border-purple-600"
		case "pink":
			return "text-white bg-pink-700 border-pink-700 dark:bg-pink-600 dark:border-pink-600"
		default: // blue
			return "text-white bg-blue-700 border-blue-700 dark:bg-blue-600 dark:border-blue-600"
		}
	}
	
	// Default state
	switch color {
	case "gray":
		return "text-gray-900 bg-white border-primary-200 hover:bg-gray-100 hover:text-blue-700 dark:bg-gray-700 dark:border-gray-600 dark:text-white dark:hover:text-white dark:hover:bg-gray-600"
	case "red":
		return "text-red-900 bg-white border-red-200 hover:bg-red-100 hover:text-red-700 dark:bg-gray-700 dark:border-red-600 dark:text-red-400 dark:hover:text-white dark:hover:bg-red-600"
	case "green":
		return "text-green-900 bg-white border-green-200 hover:bg-green-100 hover:text-green-700 dark:bg-gray-700 dark:border-green-600 dark:text-green-400 dark:hover:text-white dark:hover:bg-green-600"
	case "yellow":
		return "text-yellow-900 bg-white border-yellow-200 hover:bg-yellow-100 hover:text-yellow-700 dark:bg-gray-700 dark:border-yellow-600 dark:text-yellow-400 dark:hover:text-white dark:hover:bg-yellow-600"
	case "indigo":
		return "text-indigo-900 bg-white border-indigo-200 hover:bg-indigo-100 hover:text-indigo-700 dark:bg-gray-700 dark:border-indigo-600 dark:text-indigo-400 dark:hover:text-white dark:hover:bg-indigo-600"
	case "purple":
		return "text-purple-900 bg-white border-purple-200 hover:bg-purple-100 hover:text-purple-700 dark:bg-gray-700 dark:border-purple-600 dark:text-purple-400 dark:hover:text-white dark:hover:bg-purple-600"
	case "pink":
		return "text-pink-900 bg-white border-pink-200 hover:bg-pink-100 hover:text-pink-700 dark:bg-gray-700 dark:border-pink-600 dark:text-pink-400 dark:hover:text-white dark:hover:bg-pink-600"
	default: // blue
		return "text-blue-900 bg-white border-blue-200 hover:bg-blue-100 hover:text-blue-700 dark:bg-gray-700 dark:border-blue-600 dark:text-blue-400 dark:hover:text-white dark:hover:bg-blue-600"
	}
}

func getButtonGroupOutlineClasses(color string, active, disabled bool) string {
	if disabled {
		return "text-gray-400 bg-transparent cursor-not-allowed border-primary-200 dark:text-gray-500 dark:border-gray-600"
	}
	
	if active {
		switch color {
		case "gray":
			return "text-white bg-gray-900 border-gray-900 dark:bg-gray-600 dark:border-gray-600"
		case "red":
			return "text-white bg-red-600 border-red-600 dark:bg-red-500 dark:border-red-500"
		case "green":
			return "text-white bg-green-600 border-green-600 dark:bg-green-500 dark:border-green-500"
		case "yellow":
			return "text-gray-900 bg-yellow-400 border-yellow-400 dark:bg-yellow-300 dark:border-yellow-300"
		case "indigo":
			return "text-white bg-indigo-600 border-indigo-600 dark:bg-indigo-500 dark:border-indigo-500"
		case "purple":
			return "text-white bg-purple-600 border-purple-600 dark:bg-purple-500 dark:border-purple-500"
		case "pink":
			return "text-white bg-pink-600 border-pink-600 dark:bg-pink-500 dark:border-pink-500"
		default: // blue
			return "text-white bg-blue-600 border-blue-600 dark:bg-blue-500 dark:border-blue-500"
		}
	}
	
	// Default outline state
	switch color {
	case "gray":
		return "text-gray-900 bg-transparent border-gray-900 hover:bg-gray-900 hover:text-white dark:border-gray-600 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-600"
	case "red":
		return "text-red-600 bg-transparent border-red-600 hover:bg-red-600 hover:text-white dark:border-red-500 dark:text-red-500 dark:hover:text-white dark:hover:bg-red-600"
	case "green":
		return "text-green-600 bg-transparent border-green-600 hover:bg-green-600 hover:text-white dark:border-green-500 dark:text-green-500 dark:hover:text-white dark:hover:bg-green-600"
	case "yellow":
		return "text-yellow-600 bg-transparent border-yellow-600 hover:bg-yellow-600 hover:text-white dark:border-yellow-500 dark:text-yellow-500 dark:hover:text-white dark:hover:bg-yellow-600"
	case "indigo":
		return "text-indigo-600 bg-transparent border-indigo-600 hover:bg-indigo-600 hover:text-white dark:border-indigo-500 dark:text-indigo-500 dark:hover:text-white dark:hover:bg-indigo-600"
	case "purple":
		return "text-purple-600 bg-transparent border-purple-600 hover:bg-purple-600 hover:text-white dark:border-purple-500 dark:text-purple-500 dark:hover:text-white dark:hover:bg-purple-600"
	case "pink":
		return "text-pink-600 bg-transparent border-pink-600 hover:bg-pink-600 hover:text-white dark:border-pink-500 dark:text-pink-500 dark:hover:text-white dark:hover:bg-pink-600"
	default: // blue
		return "text-blue-600 bg-transparent border-blue-600 hover:bg-blue-600 hover:text-white dark:border-blue-500 dark:text-blue-500 dark:hover:text-white dark:hover:bg-blue-600"
	}
}

func getButtonGroupIconClasses() string {
	return "w-4 h-4 me-2"
}

func getButtonGroupBadgeClasses() string {
	return "inline-flex items-center justify-center w-4 h-4 ms-2 text-xs font-semibold text-blue-800 bg-blue-200 rounded-full"
}