package shared

import "strings"

// ServiceTheme represents the available service themes
type ServiceTheme string

const (
	ConsoleTheme   ServiceTheme = "console"
	WorkspaceTheme ServiceTheme = "workspace"
	PortalTheme    ServiceTheme = "portal"
)

// ThemeConfig holds theme configuration for components
type ThemeConfig struct {
	Service ServiceTheme `json:"service"`
	Classes []string     `json:"classes"`
}

// ThemeProvider wraps content with service-specific theme
templ ThemeProvider(theme ServiceTheme) {
	<div class={ getThemeClasses(theme) }>
		{ children... }
	</div>
}

// ThemedContainer renders a container with service theme
templ ThemedContainer(theme ServiceTheme, class string) {
	<div class={ getThemedContainerClasses(theme, class) }>
		{ children... }
	</div>
}

// ThemedButton renders a button with service theme
templ ThemedButton(theme ServiceTheme, variant string, text string, onclick string) {
	<button 
		class={ getThemedButtonClasses(theme, variant) }
		if onclick != "" {
			@click={ onclick }
		}
	>
		{ text }
	</button>
}

// ThemedCard renders a card with service theme
templ ThemedCard(theme ServiceTheme, title string, class string) {
	<div class={ getThemedCardClasses(theme, class) }>
		if title != "" {
			<div class="erp-card-header">
				<h3 class="text-xl font-semibold gradient-text">{ title }</h3>
			</div>
		}
		<div class="erp-card-body">
			{ children... }
		</div>
	</div>
}

// ThemedDataTable renders a data table with service theme
templ ThemedDataTable(theme ServiceTheme, title string, subtitle string) {
	<div class={ getThemedDataTableClasses(theme) }>
		<div class="erp-datatable-header">
			<div>
				<h2 class="text-2xl font-bold gradient-text">{ title }</h2>
				if subtitle != "" {
					<p class="text-gray-600 mt-1">{ subtitle }</p>
				}
			</div>
			<div class="flex items-center space-x-4">
				{ children... }
			</div>
		</div>
	</div>
}

// Helper functions for theme application

func getThemeClasses(theme ServiceTheme) string {
	switch theme {
	case ConsoleTheme:
		return "console-theme"
	case WorkspaceTheme:
		return "workspace-theme"
	case PortalTheme:
		return "portal-theme"
	default:
		return "console-theme"
	}
}

func getThemedContainerClasses(theme ServiceTheme, class string) string {
	base := "erp-container " + getThemeClasses(theme)
	if class != "" {
		return base + " " + class
	}
	return base
}

func getThemedButtonClasses(theme ServiceTheme, variant string) string {
	base := "erp-btn erp-btn-" + variant
	themeClass := getThemeClasses(theme)
	return strings.Join([]string{base, themeClass}, " ")
}

func getThemedCardClasses(theme ServiceTheme, class string) string {
	base := "erp-card " + getThemeClasses(theme)
	if class != "" {
		return base + " " + class
	}
	return base
}

func getThemedDataTableClasses(theme ServiceTheme) string {
	base := "erp-datatable " + getThemeClasses(theme)
	return base
}

// Service-specific theme utilities

// GetServiceFromPath determines service theme from URL path
func GetServiceFromPath(path string) ServiceTheme {
	if strings.HasPrefix(path, "/console") {
		return ConsoleTheme
	}
	if strings.HasPrefix(path, "/workspace") {
		return WorkspaceTheme
	}
	if strings.HasPrefix(path, "/portal") {
		return PortalTheme
	}
	return ConsoleTheme
}

// GetServiceColors returns the primary colors for a service
func GetServiceColors(theme ServiceTheme) map[string]string {
	switch theme {
	case ConsoleTheme:
		return map[string]string{
			"primary":   "#2563eb",
			"secondary": "#1d4ed8",
			"accent":    "#3b82f6",
		}
	case WorkspaceTheme:
		return map[string]string{
			"primary":   "#059669",
			"secondary": "#047857",
			"accent":    "#10b981",
		}
	case PortalTheme:
		return map[string]string{
			"primary":   "#7c3aed",
			"secondary": "#6d28d9",
			"accent":    "#a855f7",
		}
	default:
		return map[string]string{
			"primary":   "#2563eb",
			"secondary": "#1d4ed8",
			"accent":    "#3b82f6",
		}
	}
}

// Theme animation helpers

// AnimatedEntry renders content with entrance animation
templ AnimatedEntry(animation string, delay string) {
	<div 
		class={ getAnimationClasses(animation) }
		if delay != "" {
			style={ "animation-delay: " + delay }
		}
	>
		{ children... }
	</div>
}

func getAnimationClasses(animation string) string {
	switch animation {
	case "fade-in":
		return "animate-fade-in"
	case "scale-in":
		return "animate-scale-in"
	case "slide-in":
		return "animate-slide-in"
	default:
		return "animate-fade-in"
	}
}