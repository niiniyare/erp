package core

// CheckboxProps defines the properties for the Checkbox component
type CheckboxProps struct {
	ID       string `json:"id"`
	Name     string `json:"name" validate:"required"`
	Value    string `json:"value"`
	Label    string `json:"label"`
	Checked  bool   `json:"checked"`
	Disabled bool   `json:"disabled"`
	Required bool   `json:"required"`
	HelpText string `json:"help_text"`
	Class    string `json:"class"`
}

// Checkbox renders a checkbox input component
templ Checkbox(props CheckboxProps) {
	<div class="flex items-center">
		<input
			type="checkbox"
			id={ getCheckboxID(props.ID, props.Name) }
			name={ props.Name }
			if props.Value != "" {
				value={ props.Value }
			}
			class={ "w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600 " + props.Class }
			if props.Checked {
				checked
			}
			if props.Disabled {
				disabled
			}
			if props.Required {
				required
			}
		/>
		if props.Label != "" {
			<label 
				for={ getCheckboxID(props.ID, props.Name) }
				class="ml-2 text-sm font-medium text-gray-900 dark:text-gray-300"
			>
				{ props.Label }
			</label>
		}
	</div>
	if props.HelpText != "" {
		<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
			{ props.HelpText }
		</p>
	}
}

// Helper function for checkbox ID
func getCheckboxID(id, name string) string {
	if id != "" {
		return id
	}
	return name
}