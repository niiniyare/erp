package atoms

// This file provides easy imports for all atomic components
// Atoms are the smallest building blocks - buttons, inputs, labels, etc.

// Available Atoms:
// - Badge: @badge.templ - Status and category badges
// - Button: @button.templ - Interactive buttons with variants
// - Container: @container.templ - Layout containers with responsive behavior
// - Input: @input.templ - Form input fields with validation
// - Link: @link.templ - Navigation and action links  
// - Progress: @progress.templ - Progress bars and indicators
// - Select: @select.templ - Dropdown select components
// - Spinner: @spinner.templ - Loading spinners and indicators
// - Textarea: @textarea.templ - Multi-line text input areas

// Usage example:
// @atoms.Button(types.ButtonProps{Text: "Click me", Variant: "primary"})