package layout

// BottomNavItem represents a single navigation item
type BottomNavItem struct {
	Text      string `json:"text" validate:"required"`
	Href      string `json:"href"`
	Icon      string `json:"icon"`
	Badge     string `json:"badge"`
	BadgeType string `json:"badge_type" validate:"oneof=count notification dot"`
	Active    bool   `json:"active"`
	Disabled  bool   `json:"disabled"`
	ID        string `json:"id"`
	AriaLabel string `json:"aria_label"`
}

// BottomNavigationProps defines the properties for the BottomNavigation component
type BottomNavigationProps struct {
	Items         []BottomNavItem `json:"items" validate:"required,min=1,max=5"`
	ShowLabels    bool            `json:"show_labels"`
	Fixed         bool            `json:"fixed"`
	BackgroundBlur bool           `json:"background_blur"`
	ID            string          `json:"id"`
	Class         string          `json:"class"`
	AriaLabel     string          `json:"aria_label"`
}

// BottomNavigation renders a Flowbite-styled bottom navigation component
templ BottomNavigation(props BottomNavigationProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getBottomNavClasses(props.Fixed, props.BackgroundBlur) + " " + props.Class }
		role="navigation"
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		} else {
			aria-label="Bottom navigation"
		}
	>
		<div class={ getBottomNavContainerClasses() }>
			for _, item := range props.Items {
				<div class={ getBottomNavItemClasses() }>
					if item.Href != "" {
						<a
							if item.ID != "" {
								id={ item.ID }
							}
							href={ item.Href }
							class={ getBottomNavLinkClasses(item.Active, item.Disabled) }
							if item.AriaLabel != "" {
								aria-label={ item.AriaLabel }
							}
							if item.Disabled {
								aria-disabled="true"
								tabindex="-1"
							}
						>
							@BottomNavItemContent(item, props.ShowLabels)
						</a>
					} else {
						<button
							if item.ID != "" {
								id={ item.ID }
							}
							type="button"
							class={ getBottomNavLinkClasses(item.Active, item.Disabled) }
							if item.AriaLabel != "" {
								aria-label={ item.AriaLabel }
							}
							if item.Disabled {
								disabled
								aria-disabled="true"
							}
						>
							@BottomNavItemContent(item, props.ShowLabels)
						</button>
					}
				</div>
			}
		</div>
	</div>
}

// BottomNavItemContent renders the content of a navigation item
templ BottomNavItemContent(item BottomNavItem, showLabels bool) {
	<div class={ getBottomNavItemContentClasses() }>
		<!-- Icon with badge -->
		<div class="relative">
			if item.Icon != "" {
				<div class={ getBottomNavIconClasses() }>
					{ item.Icon }
				</div>
			}
			
			<!-- Badge -->
			if item.Badge != "" {
				if item.BadgeType == "dot" {
					<div class={ getBottomNavDotBadgeClasses() }></div>
				} else if item.BadgeType == "notification" {
					<div class={ getBottomNavNotificationBadgeClasses() }>
						<div class="w-1 h-1 bg-white rounded-full"></div>
					</div>
				} else {
					<span class={ getBottomNavCountBadgeClasses() }>
						{ item.Badge }
					</span>
				}
			}
		</div>
		
		<!-- Label -->
		if showLabels {
			<span class={ getBottomNavLabelClasses() }>
				{ item.Text }
			</span>
		}
	</div>
}

// Helper functions for bottom navigation styling
func getBottomNavClasses(fixed, backgroundBlur bool) string {
	base := "w-full bg-white border-t border-gray-200 dark:bg-gray-700 dark:border-gray-600"
	
	if fixed {
		base += " fixed bottom-0 left-0 z-50"
	}
	
	if backgroundBlur {
		base += " backdrop-blur-sm bg-white/95 dark:bg-gray-700/95"
	}
	
	return base
}

func getBottomNavContainerClasses() string {
	return "grid h-full max-w-lg grid-cols-3 mx-auto font-medium"
}

func getBottomNavItemClasses() string {
	return "inline-flex flex-col items-center justify-center"
}

func getBottomNavLinkClasses(active, disabled bool) string {
	base := "inline-flex flex-col items-center justify-center px-5 py-2 hover:bg-gray-50 dark:hover:bg-gray-800 group transition-colors duration-200"
	
	if disabled {
		return base + " cursor-not-allowed opacity-50"
	}
	
	if active {
		return base + " text-blue-600 dark:text-blue-500"
	}
	
	return base + " text-gray-500 dark:text-gray-400"
}

func getBottomNavItemContentClasses() string {
	return "flex flex-col items-center"
}

func getBottomNavIconClasses() string {
	return "w-5 h-5 mb-2 text-gray-500 dark:text-gray-400 group-hover:text-blue-600 dark:group-hover:text-blue-500"
}

func getBottomNavLabelClasses() string {
	return "text-xs text-gray-500 dark:text-gray-400 group-hover:text-blue-600 dark:group-hover:text-blue-500"
}

func getBottomNavDotBadgeClasses() string {
	return "absolute -top-1 -right-1 w-3 h-3 bg-red-500 border-2 border-white rounded-full dark:border-gray-900"
}

func getBottomNavNotificationBadgeClasses() string {
	return "absolute -top-1 -right-1 flex items-center justify-center w-5 h-5 bg-red-500 border-2 border-white rounded-full dark:border-gray-900"
}

func getBottomNavCountBadgeClasses() string {
	return "absolute -top-2 -right-2 inline-flex items-center justify-center w-6 h-6 text-xs font-bold text-white bg-red-500 border-2 border-white rounded-full dark:border-gray-900"
}