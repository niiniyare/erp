package helpers

import (
	"fmt"
	"strconv"
	"strings"
)

// CacheManagerProps defines properties for cache management
type CacheManagerProps struct {
	DefaultTTL     int                    `json:"default_ttl"`      // Default TTL in seconds
	MaxSize        int                    `json:"max_size"`         // Maximum cache size
	StorageType    string                 `json:"storage_type" validate:"oneof=memory localStorage sessionStorage"`
	Namespaces     []string               `json:"namespaces"`       // Cache namespaces
	EnableMetrics  bool                   `json:"enable_metrics"`   // Enable cache performance metrics
	DebugMode      bool                   `json:"debug_mode"`       // Enable debug logging
	AutoCleanup    bool                   `json:"auto_cleanup"`     // Enable automatic cleanup
	CleanupInterval int                   `json:"cleanup_interval"` // Cleanup interval in seconds
	Compression    bool                   `json:"compression"`      // Enable data compression
	Encryption     bool                   `json:"encryption"`       // Enable data encryption
	Strategies     map[string]interface{} `json:"strategies"`       // Cache strategies by key pattern
}

// CachedApiCallProps defines properties for cached API calls
type CachedApiCallProps struct {
	Endpoint       string            `json:"endpoint" validate:"required"`
	Method         string            `json:"method" validate:"oneof=GET POST PUT DELETE PATCH"`
	Headers        map[string]string `json:"headers"`
	Body           string            `json:"body"`
	CacheKey       string            `json:"cache_key"`
	TTL            int               `json:"ttl"`           // Cache TTL in seconds
	StaleWhileRevalidate int         `json:"swr"`          // Stale-while-revalidate time
	FreshFor       int               `json:"fresh_for"`    // Time data is considered fresh
	Background     bool              `json:"background"`   // Load in background
	RetryCount     int               `json:"retry_count"`  // Number of retries on failure
	RetryDelay     int               `json:"retry_delay"`  // Delay between retries (ms)
	Transform      string            `json:"transform"`    // Data transformation function name
	OnSuccess      string            `json:"on_success"`   // Success callback function
	OnError        string            `json:"on_error"`     // Error callback function
	LoadingState   string            `json:"loading_state"` // Alpine.js property to track loading
}

// ResourcePreloadProps defines properties for resource preloading
type ResourcePreloadProps struct {
	Resources      []PreloadResource `json:"resources" validate:"required"`
	Strategy       string            `json:"strategy" validate:"oneof=eager lazy idle"`
	Priority       string            `json:"priority" validate:"oneof=high normal low"`
	CacheBusting   bool              `json:"cache_busting"`   // Add cache busting parameters
	Compression    bool              `json:"compression"`     // Prefer compressed resources
	Preconnect     []string          `json:"preconnect"`      // Domains to preconnect
	DNSPrefetch    []string          `json:"dns_prefetch"`    // Domains for DNS prefetch
	MaxConcurrent  int               `json:"max_concurrent"`  // Maximum concurrent requests
	Timeout        int               `json:"timeout"`         // Request timeout in milliseconds
	RetryPolicy    RetryPolicy       `json:"retry_policy"`    // Retry configuration
}

// PreloadResource represents a resource to preload
type PreloadResource struct {
	URL          string `json:"url" validate:"required"`
	Type         string `json:"type" validate:"oneof=script style image font document"`
	Crossorigin  string `json:"crossorigin" validate:"oneof=anonymous use-credentials"`
	As           string `json:"as"`           // Resource destination
	Media        string `json:"media"`        // Media query for conditional loading
	Critical     bool   `json:"critical"`     // Mark as critical resource
	Integrity    string `json:"integrity"`    // Subresource integrity hash
	Referrer     string `json:"referrer"`     // Referrer policy
}

// RetryPolicy defines retry behavior
type RetryPolicy struct {
	MaxRetries    int   `json:"max_retries"`
	InitialDelay  int   `json:"initial_delay"`  // ms
	MaxDelay      int   `json:"max_delay"`      // ms  
	BackoffFactor float64 `json:"backoff_factor"` // Exponential backoff multiplier
}

// CacheManager renders the cache management store and utilities
templ CacheManager(props CacheManagerProps) {
	<script>
		document.addEventListener('alpine:init', () => {
			// Enhanced cache store with advanced features
			Alpine.store('cache', {
				// Configuration
				config: {
					defaultTTL: { getDefaultTTL(props.DefaultTTL) },
					maxSize: { getMaxSize(props.MaxSize) },
					storageType: '{ getStorageType(props.StorageType) }',
					enableMetrics: { getBoolString(props.EnableMetrics) },
					debugMode: { getBoolString(props.DebugMode) },
					autoCleanup: { getBoolString(props.AutoCleanup) },
					cleanupInterval: { getCleanupInterval(props.CleanupInterval) },
					compression: { getBoolString(props.Compression) },
					encryption: { getBoolString(props.Encryption) }
				},
				
				// Cache data structures
				data: {},
				timestamps: {},
				accessCounts: {},
				hitCounts: {},
				missCounts: {},
				metadata: {},
				namespaces: { getNamespacesJSON(props.Namespaces) },
				strategies: { getStrategiesJSON(props.Strategies) },
				
				// Performance metrics
				metrics: {
					hits: 0,
					misses: 0,
					evictions: 0,
					totalRequests: 0,
					averageAccessTime: 0,
					memoryUsage: 0
				},
				
				// Cleanup timer
				cleanupTimer: null,
				
				// Initialize cache system
				init() {
					this.loadFromPersistentStorage();
					this.startAutoCleanup();
					this.setupPerformanceMonitoring();
					
					if (this.config.debugMode) {
						console.log('Cache Manager initialized:', this.config);
					}
				},
				
				// Core cache operations
				set(key, value, options = {}) {
					const startTime = performance.now();
					
					try {
						const fullKey = this.buildKey(key, options.namespace);
						const ttl = options.ttl || this.config.defaultTTL;
						const now = Date.now();
						
						// Check if we need to evict items
						if (this.shouldEvict()) {
							this.evictLRU();
						}
						
						// Process value (compression, encryption)
						const processedValue = this.processValue(value, options);
						
						// Store data
						this.data[fullKey] = processedValue;
						this.timestamps[fullKey] = now;
						this.accessCounts[fullKey] = 0;
						this.metadata[fullKey] = {
							ttl: ttl,
							size: this.calculateSize(processedValue),
							compressed: options.compress || this.config.compression,
							encrypted: options.encrypt || this.config.encryption,
							namespace: options.namespace,
							strategy: this.getStrategy(key)
						};
						
						// Persist to storage if configured
						this.persistToStorage(fullKey, {
							value: processedValue,
							timestamp: now,
							metadata: this.metadata[fullKey]
						});
						
						this.updateMetrics('set', performance.now() - startTime);
						
						if (this.config.debugMode) {
							console.log(`Cache SET: ${fullKey}`, { value, options });
						}
						
						return true;
					} catch (error) {
						console.error('Cache set error:', error);
						return false;
					}
				},
				
				get(key, options = {}) {
					const startTime = performance.now();
					
					try {
						const fullKey = this.buildKey(key, options.namespace);
						const now = Date.now();
						
						// Check if key exists
						if (!this.has(fullKey)) {
							this.metrics.misses++;
							this.missCounts[fullKey] = (this.missCounts[fullKey] || 0) + 1;
							return null;
						}
						
						// Check TTL
						const timestamp = this.timestamps[fullKey];
						const metadata = this.metadata[fullKey];
						const isExpired = now - timestamp > metadata.ttl * 1000;
						
						if (isExpired) {
							this.delete(fullKey);
							this.metrics.misses++;
							return null;
						}
						
						// Update access statistics
						this.accessCounts[fullKey]++;
						this.hitCounts[fullKey] = (this.hitCounts[fullKey] || 0) + 1;
						this.metrics.hits++;
						
						// Process value (decompression, decryption)
						const value = this.unprocessValue(this.data[fullKey], metadata);
						
						this.updateMetrics('get', performance.now() - startTime);
						
						if (this.config.debugMode) {
							console.log(`Cache GET: ${fullKey}`, { value, hit: true });
						}
						
						return value;
					} catch (error) {
						console.error('Cache get error:', error);
						return null;
					}
				},
				
				// Async cache operations for API calls
				async fetch(key, fetcher, options = {}) {
					const cached = this.get(key, options);
					
					if (cached !== null) {
						// Handle stale-while-revalidate
						if (options.swr && this.isStale(key, options.swr)) {
							this.refreshInBackground(key, fetcher, options);
						}
						return cached;
					}
					
					// Fetch and cache
					try {
						const value = await fetcher();
						this.set(key, value, options);
						return value;
					} catch (error) {
						// Return stale data if available
						const stale = this.getStale(key, options);
						if (stale) {
							return stale;
						}
						throw error;
					}
				},
				
				// Advanced cache operations
				delete(key, options = {}) {
					const fullKey = this.buildKey(key, options.namespace);
					const existed = this.has(fullKey);
					
					delete this.data[fullKey];
					delete this.timestamps[fullKey];
					delete this.accessCounts[fullKey];
					delete this.hitCounts[fullKey];
					delete this.missCounts[fullKey];
					delete this.metadata[fullKey];
					
					this.removeFromPersistentStorage(fullKey);
					
					if (existed) {
						this.metrics.evictions++;
					}
					
					return existed;
				},
				
				clear(namespace = null) {
					if (namespace) {
						const keys = Object.keys(this.data).filter(key => 
							this.metadata[key]?.namespace === namespace
						);
						keys.forEach(key => this.delete(key.split(':').pop(), { namespace }));
					} else {
						this.data = {};
						this.timestamps = {};
						this.accessCounts = {};
						this.hitCounts = {};
						this.missCounts = {};
						this.metadata = {};
						this.clearPersistentStorage();
					}
				},
				
				// Cache management
				has(key, options = {}) {
					const fullKey = this.buildKey(key, options.namespace);
					return fullKey in this.data;
				},
				
				keys(namespace = null) {
					if (namespace) {
						return Object.keys(this.data)
							.filter(key => this.metadata[key]?.namespace === namespace)
							.map(key => key.split(':').pop());
					}
					return Object.keys(this.data);
				},
				
				size(namespace = null) {
					if (namespace) {
						return this.keys(namespace).length;
					}
					return Object.keys(this.data).length;
				},
				
				// Utility methods
				buildKey(key, namespace) {
					return namespace ? `${namespace}:${key}` : key;
				},
				
				shouldEvict() {
					return this.config.maxSize > 0 && this.size() >= this.config.maxSize;
				},
				
				evictLRU() {
					const keys = Object.keys(this.data);
					if (keys.length === 0) return;
					
					// Find least recently used key
					let lruKey = keys[0];
					let lruTime = this.timestamps[lruKey];
					let lruAccess = this.accessCounts[lruKey];
					
					keys.forEach(key => {
						const time = this.timestamps[key];
						const access = this.accessCounts[key];
						
						if (access < lruAccess || (access === lruAccess && time < lruTime)) {
							lruKey = key;
							lruTime = time;
							lruAccess = access;
						}
					});
					
					this.delete(lruKey.split(':').pop(), { 
						namespace: this.metadata[lruKey]?.namespace 
					});
				},
				
				cleanup() {
					const now = Date.now();
					const expired = [];
					
					Object.keys(this.data).forEach(key => {
						const timestamp = this.timestamps[key];
						const metadata = this.metadata[key];
						
						if (now - timestamp > metadata.ttl * 1000) {
							expired.push(key);
						}
					});
					
					expired.forEach(key => {
						this.delete(key.split(':').pop(), { 
							namespace: this.metadata[key]?.namespace 
						});
					});
					
					if (this.config.debugMode && expired.length > 0) {
						console.log(`Cache cleanup: removed ${expired.length} expired items`);
					}
				},
				
				startAutoCleanup() {
					if (!this.config.autoCleanup) return;
					
					this.cleanupTimer = setInterval(() => {
						this.cleanup();
					}, this.config.cleanupInterval * 1000);
				},
				
				stopAutoCleanup() {
					if (this.cleanupTimer) {
						clearInterval(this.cleanupTimer);
						this.cleanupTimer = null;
					}
				},
				
				// Performance monitoring
				setupPerformanceMonitoring() {
					if (!this.config.enableMetrics) return;
					
					setInterval(() => {
						this.updateMemoryUsage();
					}, 10000); // Update every 10 seconds
				},
				
				updateMetrics(operation, duration) {
					if (!this.config.enableMetrics) return;
					
					this.metrics.totalRequests++;
					this.metrics.averageAccessTime = 
						(this.metrics.averageAccessTime + duration) / 2;
				},
				
				updateMemoryUsage() {
					let totalSize = 0;
					Object.keys(this.data).forEach(key => {
						totalSize += this.metadata[key]?.size || 0;
					});
					this.metrics.memoryUsage = totalSize;
				},
				
				getStats() {
					const hitRate = this.metrics.totalRequests > 0 
						? (this.metrics.hits / this.metrics.totalRequests * 100).toFixed(2)
						: 0;
					
					return {
						...this.metrics,
						hitRate: hitRate + '%',
						cacheSize: this.size(),
						memoryUsage: this.formatBytes(this.metrics.memoryUsage)
					};
				},
				
				// Storage operations
				loadFromPersistentStorage() {
					if (this.config.storageType === 'memory') return;
					
					try {
						const storage = this.getStorage();
						const keys = Object.keys(storage).filter(key => 
							key.startsWith('cache:')
						);
						
						keys.forEach(storageKey => {
							const data = JSON.parse(storage.getItem(storageKey));
							const cacheKey = storageKey.replace('cache:', '');
							
							this.data[cacheKey] = data.value;
							this.timestamps[cacheKey] = data.timestamp;
							this.metadata[cacheKey] = data.metadata;
							this.accessCounts[cacheKey] = 0;
						});
					} catch (error) {
						console.error('Failed to load from persistent storage:', error);
					}
				},
				
				persistToStorage(key, data) {
					if (this.config.storageType === 'memory') return;
					
					try {
						const storage = this.getStorage();
						storage.setItem(`cache:${key}`, JSON.stringify(data));
					} catch (error) {
						if (error.name === 'QuotaExceededError') {
							console.warn('Storage quota exceeded, clearing old cache entries');
							this.clearOldEntries();
						} else {
							console.error('Failed to persist to storage:', error);
						}
					}
				},
				
				removeFromPersistentStorage(key) {
					if (this.config.storageType === 'memory') return;
					
					try {
						const storage = this.getStorage();
						storage.removeItem(`cache:${key}`);
					} catch (error) {
						console.error('Failed to remove from storage:', error);
					}
				},
				
				clearPersistentStorage() {
					if (this.config.storageType === 'memory') return;
					
					try {
						const storage = this.getStorage();
						const keys = Object.keys(storage).filter(key => 
							key.startsWith('cache:')
						);
						keys.forEach(key => storage.removeItem(key));
					} catch (error) {
						console.error('Failed to clear storage:', error);
					}
				},
				
				getStorage() {
					switch (this.config.storageType) {
						case 'localStorage':
							return localStorage;
						case 'sessionStorage':
							return sessionStorage;
						default:
							throw new Error('Invalid storage type');
					}
				},
				
				// Helper methods
				processValue(value, options) {
					let processed = value;
					
					// Compression
					if (options.compress || this.config.compression) {
						processed = this.compress(processed);
					}
					
					// Encryption
					if (options.encrypt || this.config.encryption) {
						processed = this.encrypt(processed);
					}
					
					return processed;
				},
				
				unprocessValue(value, metadata) {
					let processed = value;
					
					// Decryption
					if (metadata.encrypted) {
						processed = this.decrypt(processed);
					}
					
					// Decompression
					if (metadata.compressed) {
						processed = this.decompress(processed);
					}
					
					return processed;
				},
				
				compress(data) {
					// Simple compression placeholder
					return JSON.stringify(data);
				},
				
				decompress(data) {
					// Simple decompression placeholder
					return JSON.parse(data);
				},
				
				encrypt(data) {
					// Simple encryption placeholder
					return btoa(JSON.stringify(data));
				},
				
				decrypt(data) {
					// Simple decryption placeholder
					return JSON.parse(atob(data));
				},
				
				calculateSize(value) {
					return new Blob([JSON.stringify(value)]).size;
				},
				
				formatBytes(bytes) {
					if (bytes === 0) return '0 Bytes';
					const k = 1024;
					const sizes = ['Bytes', 'KB', 'MB', 'GB'];
					const i = Math.floor(Math.log(bytes) / Math.log(k));
					return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
				},
				
				getStrategy(key) {
					// Implementation for cache strategy detection
					return 'default';
				},
				
				isStale(key, swr) {
					const fullKey = this.buildKey(key);
					if (!this.has(fullKey)) return false;
					
					const timestamp = this.timestamps[fullKey];
					return Date.now() - timestamp > swr * 1000;
				},
				
				getStale(key, options) {
					const fullKey = this.buildKey(key, options.namespace);
					return this.data[fullKey] || null;
				},
				
				async refreshInBackground(key, fetcher, options) {
					try {
						const value = await fetcher();
						this.set(key, value, options);
					} catch (error) {
						console.error('Background refresh failed:', error);
					}
				}
			});
			
			// API Cache utility store
			Alpine.store('apiCache', {
				async cachedFetch(url, options = {}) {
					const cacheKey = this.buildCacheKey(url, options);
					const cache = Alpine.store('cache');
					
					return cache.fetch(cacheKey, async () => {
						const response = await fetch(url, options);
						if (!response.ok) {
							throw new Error(`HTTP error! status: ${response.status}`);
						}
						return response.json();
					}, {
						ttl: options.cacheTTL || 300, // 5 minutes default
						namespace: 'api',
						swr: options.swr || 60 // 1 minute stale-while-revalidate
					});
				},
				
				buildCacheKey(url, options) {
					const method = options.method || 'GET';
					const body = options.body ? JSON.stringify(options.body) : '';
					return `${method}:${url}:${body}`.replace(/[^a-zA-Z0-9:]/g, '_');
				},
				
				invalidate(pattern) {
					const cache = Alpine.store('cache');
					const keys = cache.keys('api');
					const matching = keys.filter(key => key.includes(pattern));
					matching.forEach(key => cache.delete(key, { namespace: 'api' }));
				}
			});
		});
	</script>
}

// CachedApiCall renders a cached API call component
templ CachedApiCall(props CachedApiCallProps) {
	<div 
		x-data={ getCachedApiCallData(props) }
		x-init="initCachedCall()"
		class="cached-api-call"
	>
		{ children... }
	</div>
}

// ResourcePreloader renders resource preloading functionality
templ ResourcePreloader(props ResourcePreloadProps) {
	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const preloader = {
				resources: { getResourcesJSON(props.Resources) },
				strategy: '{ props.Strategy }',
				priority: '{ props.Priority }',
				maxConcurrent: { getMaxConcurrent(props.MaxConcurrent) },
				timeout: { getTimeout(props.Timeout) },
				
				async init() {
					// Preconnect to domains
					{ getPreconnectJSON(props.Preconnect) }.forEach(domain => {
						const link = document.createElement('link');
						link.rel = 'preconnect';
						link.href = domain;
						document.head.appendChild(link);
					});
					
					// DNS prefetch
					{ getDNSPrefetchJSON(props.DNSPrefetch) }.forEach(domain => {
						const link = document.createElement('link');
						link.rel = 'dns-prefetch';
						link.href = domain;
						document.head.appendChild(link);
					});
					
					// Load resources based on strategy
					switch (this.strategy) {
						case 'eager':
							await this.loadAll();
							break;
						case 'lazy':
							this.setupLazyLoading();
							break;
						case 'idle':
							this.loadOnIdle();
							break;
					}
				},
				
				async loadAll() {
					const critical = this.resources.filter(r => r.critical);
					const nonCritical = this.resources.filter(r => !r.critical);
					
					// Load critical resources first
					await this.loadResources(critical);
					
					// Load non-critical resources
					await this.loadResources(nonCritical);
				},
				
				async loadResources(resources) {
					const chunks = this.chunk(resources, this.maxConcurrent);
					
					for (const chunk of chunks) {
						await Promise.all(chunk.map(resource => this.loadResource(resource)));
					}
				},
				
				async loadResource(resource) {
					return new Promise((resolve, reject) => {
						const timeout = setTimeout(() => {
							reject(new Error('Resource load timeout'));
						}, this.timeout);
						
						switch (resource.type) {
							case 'script':
								this.loadScript(resource, resolve, reject, timeout);
								break;
							case 'style':
								this.loadStyle(resource, resolve, reject, timeout);
								break;
							case 'image':
								this.loadImage(resource, resolve, reject, timeout);
								break;
							case 'font':
								this.loadFont(resource, resolve, reject, timeout);
								break;
							default:
								this.loadGeneric(resource, resolve, reject, timeout);
								break;
						}
					});
				},
				
				loadScript(resource, resolve, reject, timeout) {
					const script = document.createElement('script');
					script.src = resource.url;
					script.async = true;
					script.defer = true;
					
					if (resource.integrity) script.integrity = resource.integrity;
					if (resource.crossorigin) script.crossorigin = resource.crossorigin;
					
					script.onload = () => {
						clearTimeout(timeout);
						resolve();
					};
					script.onerror = () => {
						clearTimeout(timeout);
						reject(new Error('Script load failed'));
					};
					
					document.head.appendChild(script);
				},
				
				loadStyle(resource, resolve, reject, timeout) {
					const link = document.createElement('link');
					link.rel = 'stylesheet';
					link.href = resource.url;
					
					if (resource.media) link.media = resource.media;
					if (resource.integrity) link.integrity = resource.integrity;
					if (resource.crossorigin) link.crossorigin = resource.crossorigin;
					
					link.onload = () => {
						clearTimeout(timeout);
						resolve();
					};
					link.onerror = () => {
						clearTimeout(timeout);
						reject(new Error('Style load failed'));
					};
					
					document.head.appendChild(link);
				},
				
				loadImage(resource, resolve, reject, timeout) {
					const img = new Image();
					img.onload = () => {
						clearTimeout(timeout);
						resolve();
					};
					img.onerror = () => {
						clearTimeout(timeout);
						reject(new Error('Image load failed'));
					};
					img.src = resource.url;
				},
				
				loadFont(resource, resolve, reject, timeout) {
					const font = new FontFace('preload-font', `url(${resource.url})`);
					font.load().then(() => {
						document.fonts.add(font);
						clearTimeout(timeout);
						resolve();
					}).catch(() => {
						clearTimeout(timeout);
						reject(new Error('Font load failed'));
					});
				},
				
				loadGeneric(resource, resolve, reject, timeout) {
					fetch(resource.url)
						.then(() => {
							clearTimeout(timeout);
							resolve();
						})
						.catch(() => {
							clearTimeout(timeout);
							reject(new Error('Resource load failed'));
						});
				},
				
				chunk(array, size) {
					const chunks = [];
					for (let i = 0; i < array.length; i += size) {
						chunks.push(array.slice(i, i + size));
					}
					return chunks;
				},
				
				setupLazyLoading() {
					// Implementation for lazy loading strategy
					console.log('Lazy loading strategy not yet implemented');
				},
				
				loadOnIdle() {
					if ('requestIdleCallback' in window) {
						requestIdleCallback(() => this.loadAll());
					} else {
						setTimeout(() => this.loadAll(), 100);
					}
				}
			};
			
			preloader.init();
		});
	</script>
}

// Helper functions for caching
func getCachedApiCallData(props CachedApiCallProps) string {
	method := "GET"
	if props.Method != "" {
		method = props.Method
	}

	return fmt.Sprintf(`{
		endpoint: '%s',
		method: '%s',
		cacheKey: '%s',
		ttl: %d,
		data: null,
		loading: false,
		error: null,
		
		async initCachedCall() {
			const apiCache = Alpine.store('apiCache');
			
			try {
				this.loading = true;
				this.data = await apiCache.cachedFetch(this.endpoint, {
					method: this.method,
					cacheTTL: this.ttl,
					swr: %d
				});
			} catch (error) {
				this.error = error.message;
			} finally {
				this.loading = false;
			}
		}
	}`, props.Endpoint, method, props.CacheKey, props.TTL, props.StaleWhileRevalidate)
}

func getDefaultTTL(ttl int) int {
	if ttl > 0 {
		return ttl
	}
	return 300 // 5 minutes default
}

func getMaxSize(size int) int {
	if size > 0 {
		return size
	}
	return 100 // Default max 100 items
}

func getStorageType(storage string) string {
	if storage != "" {
		return storage
	}
	return "memory"
}

func getCleanupInterval(interval int) int {
	if interval > 0 {
		return interval
	}
	return 300 // 5 minutes default
}

func getBoolString(b bool) string {
	return strconv.FormatBool(b)
}

func getNamespacesJSON(namespaces []string) string {
	if len(namespaces) == 0 {
		return "['default']"
	}
	return "['" + strings.Join(namespaces, "','") + "']"
}

func getStrategiesJSON(strategies map[string]interface{}) string {
	if len(strategies) == 0 {
		return "{}"
	}
	// In a real implementation, marshal to JSON
	return "{}"
}

func getResourcesJSON(resources []PreloadResource) string {
	if len(resources) == 0 {
		return "[]"
	}
	// In a real implementation, marshal to JSON
	return "[]"
}

func getPreconnectJSON(domains []string) string {
	if len(domains) == 0 {
		return "[]"
	}
	return "['" + strings.Join(domains, "','") + "']"
}

func getDNSPrefetchJSON(domains []string) string {
	if len(domains) == 0 {
		return "[]"
	}
	return "['" + strings.Join(domains, "','") + "']"
}

func getMaxConcurrent(max int) int {
	if max > 0 {
		return max
	}
	return 4
}

func getTimeout(timeout int) int {
	if timeout > 0 {
		return timeout
	}
	return 5000 // 5 seconds
}