package data

import (
	"context"
)

// ConsoleDataTable renders DataTable with Console service context and admin capabilities
templ ConsoleDataTable(ctx context.Context, props DataTableProps) {
	@DataTable(ctx, enhanceForConsole(props))
}

// WorkspaceDataTable renders DataTable with Workspace service context and tenant isolation
templ WorkspaceDataTable(ctx context.Context, props DataTableProps) {
	@DataTable(ctx, enhanceForWorkspace(props))
}

// PortalDataTable renders DataTable with Portal service context and limited actions
templ PortalDataTable(ctx context.Context, props DataTableProps) {
	@DataTable(ctx, enhanceForPortal(props))
}

// Standard bulk action configurations for different services
func getStandardConsoleBulkActions() []BulkActionProps {
	return []BulkActionProps{
		{
			ID:          "bulk_suspend",
			Text:        "Suspend Selected",
			Icon:        "fas fa-user-lock",
			Variant:     "warning",
			Permission:  "user:suspend",
			Confirm:     true,
			ConfirmText: "Are you sure you want to suspend the selected users?",
			Endpoint:    "/console/api/bulk/users/suspend",
			Method:      "POST",
		},
		{
			ID:          "bulk_activate",
			Text:        "Activate Selected",
			Icon:        "fas fa-user-check",
			Variant:     "primary",
			Permission:  "user:activate",
			Confirm:     true,
			ConfirmText: "Are you sure you want to activate the selected users?",
			Endpoint:    "/console/api/bulk/users/activate",
			Method:      "POST",
		},
		{
			ID:          "bulk_delete",
			Text:        "Delete Selected",
			Icon:        "fas fa-trash",
			Variant:     "danger",
			Permission:  "user:delete",
			Confirm:     true,
			ConfirmText: "Are you sure you want to permanently delete the selected users? This action cannot be undone.",
			Endpoint:    "/console/api/bulk/users/delete",
			Method:      "DELETE",
		},
		{
			ID:       "bulk_export",
			Text:     "Export Selected",
			Icon:     "fas fa-download",
			Variant:  "secondary",
			Endpoint: "/console/api/bulk/users/export",
			Method:   "POST",
		},
	}
}

