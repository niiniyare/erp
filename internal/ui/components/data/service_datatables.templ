// Service enhancement functions
func enhanceForConsole(props DataTableProps) DataTableProps {
	props.ServiceContext = ServiceContextProps{
		Service: "console",
	}
	props.Theme = "console"
	props.PermissionCheck = true
	props.AuditLog = true
	
	// Add standard console bulk actions if none provided
	if len(props.BulkActions) == 0 {
		props.BulkActions = getStandardConsoleBulkActions()
	}
	
	return props
}

func enhanceForWorkspace(props DataTableProps) DataTableProps {
	props.ServiceContext = ServiceContextProps{
		Service: "workspace",
	}
	props.Theme = "workspace"
	props.PermissionCheck = true
	
	// Add standard workspace bulk actions if none provided
	if len(props.BulkActions) == 0 {
		props.BulkActions = getStandardWorkspaceBulkActions()
	}
	
	return props
}

func enhanceForPortal(props DataTableProps) DataTableProps {
	props.ServiceContext = ServiceContextProps{
		Service: "portal",
	}
	props.Theme = "portal"
	props.PermissionCheck = false // Portal users have limited permissions
	
	// Add standard portal bulk actions if none provided
	if len(props.BulkActions) == 0 {
		props.BulkActions = getStandardPortalBulkActions()
	}
	
	return props
}