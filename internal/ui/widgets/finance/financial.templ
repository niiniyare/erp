package widgets

import (
	"fmt"
	"strconv"
	"strings"
)

// FinancialSummaryProps defines properties for financial summary widgets
type FinancialSummaryProps struct {
	Title            string                 `json:"title" validate:"required"`
	Period           string                 `json:"period"`
	Revenue          float64                `json:"revenue"`
	Expenses         float64                `json:"expenses"`
	NetIncome        float64                `json:"net_income"`
	Growth           float64                `json:"growth"`
	Currency         string                 `json:"currency"`
	PreviousPeriod   FinancialPeriodData    `json:"previous_period"`
	Breakdown        []FinancialBreakdown   `json:"breakdown"`
	ShowChart        bool                   `json:"show_chart"`
	CompactView      bool                   `json:"compact_view"`
	ID               string                 `json:"id"`
	Class            string                 `json:"class"`
}

// FinancialPeriodData represents financial data for a specific period
type FinancialPeriodData struct {
	Revenue   float64 `json:"revenue"`
	Expenses  float64 `json:"expenses"`
	NetIncome float64 `json:"net_income"`
}

// FinancialBreakdown represents a category breakdown
type FinancialBreakdown struct {
	Category string  `json:"category"`
	Amount   float64 `json:"amount"`
	Percent  float64 `json:"percent"`
	Color    string  `json:"color"`
}

// CashFlowProps defines properties for cash flow widgets
type CashFlowProps struct {
	Title         string           `json:"title"`
	CurrentCash   float64          `json:"current_cash"`
	Inflows       []CashFlowItem   `json:"inflows"`
	Outflows      []CashFlowItem   `json:"outflows"`
	Projections   []CashFlowItem   `json:"projections"`
	Currency      string           `json:"currency"`
	ShowForecast  bool             `json:"show_forecast"`
	TimeFrame     string           `json:"time_frame"`
	ID            string           `json:"id"`
	Class         string           `json:"class"`
}

// CashFlowItem represents a cash flow entry
type CashFlowItem struct {
	Date        string  `json:"date"`
	Description string  `json:"description"`
	Amount      float64 `json:"amount"`
	Category    string  `json:"category"`
	Type        string  `json:"type" validate:"oneof=inflow outflow"`
}

// InvoiceStatusProps defines properties for invoice status widgets
type InvoiceStatusProps struct {
	Title        string              `json:"title"`
	TotalAmount  float64             `json:"total_amount"`
	PaidAmount   float64             `json:"paid_amount"`
	OverdueAmount float64            `json:"overdue_amount"`
	PendingCount int                 `json:"pending_count"`
	OverdueCount int                 `json:"overdue_count"`
	RecentItems  []InvoiceStatusItem `json:"recent_items"`
	Currency     string              `json:"currency"`
	ShowActions  bool                `json:"show_actions"`
	ID           string              `json:"id"`
	Class        string              `json:"class"`
}

// InvoiceStatusItem represents an invoice in the status widget
type InvoiceStatusItem struct {
	ID          string  `json:"id"`
	CustomerName string `json:"customer_name"`
	Amount      float64 `json:"amount"`
	DueDate     string  `json:"due_date"`
	Status      string  `json:"status" validate:"oneof=draft pending paid overdue cancelled"`
	DaysOverdue int     `json:"days_overdue"`
}

// FinancialSummary renders a comprehensive financial summary widget
templ FinancialSummary(props FinancialSummaryProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getFinancialSummaryClasses(props.CompactView) + " " + props.Class }
	>
		<!-- Header -->
		<div class={ getFinancialHeaderClasses() }>
			<div>
				<h3 class={ getFinancialTitleClasses() }>
					{ props.Title }
				</h3>
				if props.Period != "" {
					<p class={ getFinancialPeriodClasses() }>
						{ props.Period }
					</p>
				}
			</div>
			if props.Growth != 0 {
				<div class={ getFinancialGrowthClasses(props.Growth >= 0) }>
					<span class="text-sm font-medium">
						if props.Growth >= 0 {
							<svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M3.293 9.707a1 1 0 010-1.414l6-6a1 1 0 011.414 0l6 6a1 1 0 01-1.414 1.414L11 5.414V17a1 1 0 11-2 0V5.414L4.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
							</svg>
						} else {
							<svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M16.707 10.293a1 1 0 010 1.414l-6 6a1 1 0 01-1.414 0l-6-6a1 1 0 111.414-1.414L9 14.586V3a1 1 0 012 0v11.586l4.293-4.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
							</svg>
						}
						{ formatPercentage(props.Growth) }%
					</span>
				</div>
			}
		</div>

		if !props.CompactView {
			<!-- Main Financial Metrics -->
			<div class={ getFinancialMetricsClasses() }>
				<!-- Revenue -->
				<div class={ getFinancialMetricClasses() }>
					<div class={ getFinancialMetricIconClasses("green") }>
						💰
					</div>
					<div>
						<p class={ getFinancialMetricLabelClasses() }>Revenue</p>
						<p class={ getFinancialMetricValueClasses() }>
							{ formatCurrency(props.Revenue, props.Currency) }
						</p>
						if props.PreviousPeriod.Revenue != 0 {
							<p class={ getFinancialMetricChangeClasses(props.Revenue >= props.PreviousPeriod.Revenue) }>
								{ formatFinancialChange(props.Revenue, props.PreviousPeriod.Revenue) }
							</p>
						}
					</div>
				</div>

				<!-- Expenses -->
				<div class={ getFinancialMetricClasses() }>
					<div class={ getFinancialMetricIconClasses("red") }>
						📊
					</div>
					<div>
						<p class={ getFinancialMetricLabelClasses() }>Expenses</p>
						<p class={ getFinancialMetricValueClasses() }>
							{ formatCurrency(props.Expenses, props.Currency) }
						</p>
						if props.PreviousPeriod.Expenses != 0 {
							<p class={ getFinancialMetricChangeClasses(props.Expenses <= props.PreviousPeriod.Expenses) }>
								{ formatFinancialChange(props.Expenses, props.PreviousPeriod.Expenses) }
							</p>
						}
					</div>
				</div>

				<!-- Net Income -->
				<div class={ getFinancialMetricClasses() }>
					<div class={ getFinancialMetricIconClasses(getIncomeColor(props.NetIncome)) }>
						📈
					</div>
					<div>
						<p class={ getFinancialMetricLabelClasses() }>Net Income</p>
						<p class={ getFinancialMetricValueClasses() }>
							{ formatCurrency(props.NetIncome, props.Currency) }
						</p>
						if props.PreviousPeriod.NetIncome != 0 {
							<p class={ getFinancialMetricChangeClasses(props.NetIncome >= props.PreviousPeriod.NetIncome) }>
								{ formatFinancialChange(props.NetIncome, props.PreviousPeriod.NetIncome) }
							</p>
						}
					</div>
				</div>
			</div>

			<!-- Breakdown Chart -->
			if len(props.Breakdown) > 0 {
				<div class={ getFinancialBreakdownClasses() }>
					<h4 class={ getFinancialBreakdownTitleClasses() }>Expense Breakdown</h4>
					<div class={ getFinancialBreakdownListClasses() }>
						for _, item := range props.Breakdown {
							<div class={ getFinancialBreakdownItemClasses() }>
								<div class="flex items-center">
									<div class={ "w-3 h-3 rounded-full mr-2 bg-" + item.Color + "-500" }></div>
									<span class={ getFinancialBreakdownLabelClasses() }>{ item.Category }</span>
								</div>
								<div class="text-right">
									<p class={ getFinancialBreakdownAmountClasses() }>
										{ formatCurrency(item.Amount, props.Currency) }
									</p>
									<p class={ getFinancialBreakdownPercentClasses() }>
										{ formatPercentage(item.Percent) }%
									</p>
								</div>
							</div>
						}
					</div>
				</div>
			}
		} else {
			<!-- Compact View -->
			<div class={ getFinancialCompactClasses() }>
				<div class={ getFinancialCompactItemClasses() }>
					<span class="text-sm text-gray-600 dark:text-gray-400">Revenue</span>
					<span class="font-semibold text-green-600">{ formatCurrency(props.Revenue, props.Currency) }</span>
				</div>
				<div class={ getFinancialCompactItemClasses() }>
					<span class="text-sm text-gray-600 dark:text-gray-400">Net Income</span>
					<span class={ getFinancialCompactValueClasses(props.NetIncome >= 0) }>
						{ formatCurrency(props.NetIncome, props.Currency) }
					</span>
				</div>
			</div>
		}
	</div>
}

// CashFlowWidget renders a cash flow monitoring widget
templ CashFlowWidget(props CashFlowProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getCashFlowWidgetClasses() + " " + props.Class }
	>
		<!-- Header -->
		<div class={ getWidgetHeaderClasses() }>
			<h3 class={ getWidgetTitleClasses() }>
				{ props.Title }
			</h3>
			if props.TimeFrame != "" {
				<span class={ getCashFlowTimeFrameClasses() }>
					{ props.TimeFrame }
				</span>
			}
		</div>

		<!-- Current Cash Position -->
		<div class={ getCashFlowCurrentClasses() }>
			<div class={ getCashFlowCurrentIconClasses() }>
				💵
			</div>
			<div>
				<p class="text-sm text-gray-600 dark:text-gray-400">Current Cash</p>
				<p class="text-2xl font-bold text-gray-900 dark:text-white">
					{ formatCurrency(props.CurrentCash, props.Currency) }
				</p>
			</div>
		</div>

		<!-- Inflows and Outflows -->
		<div class={ getCashFlowSummaryClasses() }>
			<!-- Inflows -->
			<div class={ getCashFlowSummaryItemClasses() }>
				<div class="flex items-center mb-2">
					<div class={ getCashFlowInflowIconClasses() }>
						⬆️
					</div>
					<span class="text-sm font-medium text-gray-700 dark:text-gray-300">Inflows</span>
				</div>
				<p class="text-lg font-semibold text-green-600">
					{ formatCurrency(calculateTotal(props.Inflows), props.Currency) }
				</p>
				<p class="text-xs text-gray-500">{ strconv.Itoa(len(props.Inflows)) } transactions</p>
			</div>

			<!-- Outflows -->
			<div class={ getCashFlowSummaryItemClasses() }>
				<div class="flex items-center mb-2">
					<div class={ getCashFlowOutflowIconClasses() }>
						⬇️
					</div>
					<span class="text-sm font-medium text-gray-700 dark:text-gray-300">Outflows</span>
				</div>
				<p class="text-lg font-semibold text-red-600">
					{ formatCurrency(calculateTotal(props.Outflows), props.Currency) }
				</p>
				<p class="text-xs text-gray-500">{ strconv.Itoa(len(props.Outflows)) } transactions</p>
			</div>
		</div>

		<!-- Recent Transactions -->
		<div class={ getCashFlowTransactionsClasses() }>
			<h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Recent Transactions</h4>
			<div class="space-y-2">
				for _, item := range getCombinedTransactions(props.Inflows, props.Outflows, 5) {
					<div class={ getCashFlowTransactionItemClasses() }>
						<div class="flex items-center">
							<div class={ getCashFlowTransactionIconClasses(item.Type) }>
								if item.Type == "inflow" {
									⬆️
								} else {
									⬇️
								}
							</div>
							<div class="flex-1 min-w-0">
								<p class="text-sm font-medium text-gray-900 dark:text-white truncate">
									{ item.Description }
								</p>
								<p class="text-xs text-gray-500">{ item.Date } • { item.Category }</p>
							</div>
						</div>
						<div class="text-right">
							<p class={ getCashFlowTransactionAmountClasses(item.Type) }>
								if item.Type == "inflow" {
									+{ formatCurrency(item.Amount, props.Currency) }
								} else {
									-{ formatCurrency(item.Amount, props.Currency) }
								}
							</p>
						</div>
					</div>
				}
			</div>
		</div>

		if props.ShowForecast && len(props.Projections) > 0 {
			<!-- Cash Flow Forecast -->
			<div class={ getCashFlowForecastClasses() }>
				<h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">7-Day Forecast</h4>
				<div class="space-y-1">
					for _, projection := range props.Projections {
						<div class="flex justify-between items-center">
							<span class="text-xs text-gray-500">{ projection.Date }</span>
							<span class={ getCashFlowProjectionAmountClasses(projection.Amount >= 0) }>
								{ formatCurrency(projection.Amount, props.Currency) }
							</span>
						</div>
					}
				</div>
			</div>
		}
	</div>
}

// InvoiceStatusWidget renders an invoice status overview widget
templ InvoiceStatusWidget(props InvoiceStatusProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getInvoiceStatusWidgetClasses() + " " + props.Class }
	>
		<!-- Header -->
		<div class={ getWidgetHeaderClasses() }>
			<h3 class={ getWidgetTitleClasses() }>
				{ props.Title }
			</h3>
			if props.ShowActions {
				<a href="/invoices/new" class={ getWidgetActionLinkClasses() }>
					Create Invoice
				</a>
			}
		</div>

		<!-- Summary Stats -->
		<div class={ getInvoiceStatusSummaryClasses() }>
			<!-- Total Amount -->
			<div class={ getInvoiceStatusStatClasses() }>
				<div class={ getInvoiceStatusStatIconClasses("blue") }>
					📄
				</div>
				<div>
					<p class="text-sm text-gray-600 dark:text-gray-400">Total Outstanding</p>
					<p class="text-xl font-bold text-gray-900 dark:text-white">
						{ formatCurrency(props.TotalAmount, props.Currency) }
					</p>
				</div>
			</div>

			<!-- Paid Amount -->
			<div class={ getInvoiceStatusStatClasses() }>
				<div class={ getInvoiceStatusStatIconClasses("green") }>
					✅
				</div>
				<div>
					<p class="text-sm text-gray-600 dark:text-gray-400">Paid</p>
					<p class="text-xl font-bold text-green-600">
						{ formatCurrency(props.PaidAmount, props.Currency) }
					</p>
				</div>
			</div>

			<!-- Overdue Amount -->
			<div class={ getInvoiceStatusStatClasses() }>
				<div class={ getInvoiceStatusStatIconClasses("red") }>
					⚠️
				</div>
				<div>
					<p class="text-sm text-gray-600 dark:text-gray-400">Overdue</p>
					<p class="text-xl font-bold text-red-600">
						{ formatCurrency(props.OverdueAmount, props.Currency) }
					</p>
				</div>
			</div>
		</div>

		<!-- Status Counts -->
		<div class={ getInvoiceStatusCountsClasses() }>
			<div class={ getInvoiceStatusCountItemClasses() }>
				<span class="text-sm text-gray-600 dark:text-gray-400">Pending</span>
				<span class="text-lg font-semibold text-yellow-600">{ strconv.Itoa(props.PendingCount) }</span>
			</div>
			<div class={ getInvoiceStatusCountItemClasses() }>
				<span class="text-sm text-gray-600 dark:text-gray-400">Overdue</span>
				<span class="text-lg font-semibold text-red-600">{ strconv.Itoa(props.OverdueCount) }</span>
			</div>
		</div>

		<!-- Recent Invoices -->
		if len(props.RecentItems) > 0 {
			<div class={ getInvoiceStatusRecentClasses() }>
				<h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Recent Invoices</h4>
				<div class="space-y-2">
					for _, invoice := range props.RecentItems {
						<div class={ getInvoiceStatusItemClasses() }>
							<div class="flex items-center justify-between">
								<div class="flex-1 min-w-0">
									<p class="text-sm font-medium text-gray-900 dark:text-white truncate">
										{ invoice.CustomerName }
									</p>
									<p class="text-xs text-gray-500">
										Invoice #{ invoice.ID } • Due { invoice.DueDate }
									</p>
								</div>
								<div class="text-right">
									<p class="text-sm font-semibold text-gray-900 dark:text-white">
										{ formatCurrency(invoice.Amount, props.Currency) }
									</p>
									<span class={ getInvoiceStatusBadgeClasses(invoice.Status) }>
										{ strings.Title(invoice.Status) }
									</span>
								</div>
							</div>
							if invoice.Status == "overdue" && invoice.DaysOverdue > 0 {
								<p class="text-xs text-red-600 mt-1">
									{ strconv.Itoa(invoice.DaysOverdue) } days overdue
								</p>
							}
						</div>
					}
				</div>
			</div>
		}
	</div>
}

// Helper functions for financial widgets
func formatCurrency(amount float64, currency string) string {
	if currency == "" {
		currency = "USD"
	}
	return fmt.Sprintf("$%.2f", amount)
}

func formatPercentage(value float64) string {
	return fmt.Sprintf("%.1f", value)
}

func formatFinancialChange(current, previous float64) string {
	if previous == 0 {
		return ""
	}
	change := ((current - previous) / previous) * 100
	if change >= 0 {
		return fmt.Sprintf("+%.1f%%", change)
	}
	return fmt.Sprintf("%.1f%%", change)
}

func getIncomeColor(netIncome float64) string {
	if netIncome >= 0 {
		return "green"
	}
	return "red"
}

func calculateTotal(items []CashFlowItem) float64 {
	total := 0.0
	for _, item := range items {
		total += item.Amount
	}
	return total
}

func getCombinedTransactions(inflows, outflows []CashFlowItem, limit int) []CashFlowItem {
	var combined []CashFlowItem
	
	// Add inflows
	for _, item := range inflows {
		item.Type = "inflow"
		combined = append(combined, item)
	}
	
	// Add outflows
	for _, item := range outflows {
		item.Type = "outflow"
		combined = append(combined, item)
	}
	
	// Return limited results (would normally sort by date)
	if len(combined) > limit {
		return combined[:limit]
	}
	return combined
}

// Styling helper functions
func getFinancialSummaryClasses(compact bool) string {
	base := "bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700"
	if compact {
		return base + " p-4"
	}
	return base + " p-6"
}

func getFinancialHeaderClasses() string {
	return "flex items-center justify-between mb-6"
}

func getFinancialTitleClasses() string {
	return "text-lg font-semibold text-gray-900 dark:text-white"
}

func getFinancialPeriodClasses() string {
	return "text-sm text-gray-500 dark:text-gray-400"
}

func getFinancialGrowthClasses(positive bool) string {
	base := "flex items-center"
	if positive {
		return base + " text-green-600"
	}
	return base + " text-red-600"
}

func getFinancialMetricsClasses() string {
	return "grid grid-cols-1 md:grid-cols-3 gap-6 mb-6"
}

func getFinancialMetricClasses() string {
	return "flex items-center space-x-3"
}

func getFinancialMetricIconClasses(color string) string {
	base := "p-2 rounded-lg text-lg"
	switch color {
	case "green":
		return base + " bg-green-100 dark:bg-green-900"
	case "red":
		return base + " bg-red-100 dark:bg-red-900"
	default:
		return base + " bg-blue-100 dark:bg-blue-900"
	}
}

func getFinancialMetricLabelClasses() string {
	return "text-sm font-medium text-gray-600 dark:text-gray-400"
}

func getFinancialMetricValueClasses() string {
	return "text-xl font-bold text-gray-900 dark:text-white"
}

func getFinancialMetricChangeClasses(positive bool) string {
	base := "text-xs font-medium"
	if positive {
		return base + " text-green-600"
	}
	return base + " text-red-600"
}

func getFinancialBreakdownClasses() string {
	return "border-t border-gray-200 dark:border-gray-700 pt-6"
}

func getFinancialBreakdownTitleClasses() string {
	return "text-sm font-medium text-gray-700 dark:text-gray-300 mb-4"
}

func getFinancialBreakdownListClasses() string {
	return "space-y-3"
}

func getFinancialBreakdownItemClasses() string {
	return "flex items-center justify-between"
}

func getFinancialBreakdownLabelClasses() string {
	return "text-sm text-gray-600 dark:text-gray-400"
}

func getFinancialBreakdownAmountClasses() string {
	return "text-sm font-medium text-gray-900 dark:text-white"
}

func getFinancialBreakdownPercentClasses() string {
	return "text-xs text-gray-500"
}

func getFinancialCompactClasses() string {
	return "space-y-2"
}

func getFinancialCompactItemClasses() string {
	return "flex justify-between items-center"
}

func getFinancialCompactValueClasses(positive bool) string {
	base := "font-semibold"
	if positive {
		return base + " text-green-600"
	}
	return base + " text-red-600"
}

func getCashFlowWidgetClasses() string {
	return "bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6"
}

func getCashFlowTimeFrameClasses() string {
	return "text-sm text-gray-500 dark:text-gray-400"
}

func getCashFlowCurrentClasses() string {
	return "flex items-center space-x-3 mb-6"
}

func getCashFlowCurrentIconClasses() string {
	return "p-2 bg-blue-100 dark:bg-blue-900 rounded-lg text-lg"
}

func getCashFlowSummaryClasses() string {
	return "grid grid-cols-2 gap-4 mb-6"
}

func getCashFlowSummaryItemClasses() string {
	return "p-3 bg-gray-50 dark:bg-gray-700 rounded-lg"
}

func getCashFlowInflowIconClasses() string {
	return "p-1 bg-green-100 dark:bg-green-900 rounded mr-2"
}

func getCashFlowOutflowIconClasses() string {
	return "p-1 bg-red-100 dark:bg-red-900 rounded mr-2"
}

func getCashFlowTransactionsClasses() string {
	return "mb-6"
}

func getCashFlowTransactionItemClasses() string {
	return "flex items-center justify-between p-2 hover:bg-gray-50 dark:hover:bg-gray-700 rounded"
}

func getCashFlowTransactionIconClasses(transactionType string) string {
	base := "p-1 rounded mr-3"
	if transactionType == "inflow" {
		return base + " bg-green-100 dark:bg-green-900"
	}
	return base + " bg-red-100 dark:bg-red-900"
}

func getCashFlowTransactionAmountClasses(transactionType string) string {
	base := "text-sm font-medium"
	if transactionType == "inflow" {
		return base + " text-green-600"
	}
	return base + " text-red-600"
}

func getCashFlowForecastClasses() string {
	return "border-t border-gray-200 dark:border-gray-700 pt-4"
}

func getCashFlowProjectionAmountClasses(positive bool) string {
	base := "text-xs font-medium"
	if positive {
		return base + " text-green-600"
	}
	return base + " text-red-600"
}

func getInvoiceStatusWidgetClasses() string {
	return "bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6"
}

func getWidgetActionLinkClasses() string {
	return "text-sm text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300"
}

func getInvoiceStatusSummaryClasses() string {
	return "grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6"
}

func getInvoiceStatusStatClasses() string {
	return "flex items-center space-x-3"
}

func getInvoiceStatusStatIconClasses(color string) string {
	base := "p-2 rounded-lg text-lg"
	switch color {
	case "green":
		return base + " bg-green-100 dark:bg-green-900"
	case "red":
		return base + " bg-red-100 dark:bg-red-900"
	case "blue":
		return base + " bg-blue-100 dark:bg-blue-900"
	default:
		return base + " bg-gray-100 dark:bg-gray-900"
	}
}

func getInvoiceStatusCountsClasses() string {
	return "flex justify-between p-3 bg-gray-50 dark:bg-gray-700 rounded-lg mb-6"
}

func getInvoiceStatusCountItemClasses() string {
	return "flex flex-col items-center"
}

func getInvoiceStatusRecentClasses() string {
	return ""
}

func getInvoiceStatusItemClasses() string {
	return "p-3 border border-gray-200 dark:border-gray-600 rounded-lg"
}

func getInvoiceStatusBadgeClasses(status string) string {
	base := "inline-flex items-center px-2 py-1 rounded-full text-xs font-medium"
	
	switch status {
	case "paid":
		return base + " bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200"
	case "pending":
		return base + " bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200"
	case "overdue":
		return base + " bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200"
	case "draft":
		return base + " bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200"
	default:
		return base + " bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200"
	}
}