package examples

import (
	"context"
	"github.com/google/uuid"
	"github.com/niiniyare/erp/internal/ui/templates/helpers"
	webComponents "github.com/niiniyare/erp/web/admin/templates/components"
)

// UserManagementPage demonstrates ABAC permission integration
templ UserManagementPage(ctx context.Context, users []UserInfo) {
	<div class="space-y-6">
		<div class="flex justify-between items-center">
			<h1 class="text-2xl font-bold text-gray-900">User Management</h1>
			
			<!-- Create button only visible to users with create permission -->
			@helpers.CanCreate(ctx, "user") {
				<button 
					class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700"
					hx-get="/admin/users/create"
					hx-target="#main-content">
					<i class="fas fa-plus mr-2"></i>
					Create User
				</button>
			}
		</div>

		<!-- User table with permission-based actions -->
		<div class="bg-white shadow rounded-lg overflow-hidden">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Active</th>
						
						<!-- Actions column only visible to users with management permissions -->
						@helpers.HasPermission(ctx, "user", "manage", nil) {
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
						}
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					for _, user := range users {
						<tr class="hover:bg-gray-50">
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="flex items-center">
									<div class="flex-shrink-0 h-10 w-10">
										<img class="h-10 w-10 rounded-full" src={ user.Avatar } alt={ user.Name }/>
									</div>
									<div class="ml-4">
										<div class="text-sm font-medium text-gray-900">{ user.Name }</div>
										<div class="text-sm text-gray-500">{ user.Email }</div>
									</div>
								</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								@webComponents.StatusBadge(user.Status)
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
								{ user.Role }
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
								{ user.LastActive }
							</td>
							
							<!-- Action buttons with granular permissions -->
							@helpers.HasPermission(ctx, "user", "manage", nil) {
								<td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
									
									<!-- View button for users with read permission -->
									@helpers.CanRead(ctx, "user", &user.ID) {
										<button 
											class="text-blue-600 hover:text-blue-900"
											hx-get={ "/admin/users/" + user.ID.String() }
											hx-target="#main-content">
											<i class="fas fa-eye"></i>
										</button>
									}
									
									<!-- Edit button for users with write permission -->
									@helpers.CanWrite(ctx, "user", &user.ID) {
										<button 
											class="text-indigo-600 hover:text-indigo-900"
											hx-get={ "/admin/users/" + user.ID.String() + "/edit" }
											hx-target="#main-content">
											<i class="fas fa-edit"></i>
										</button>
									}
									
									<!-- Delete button for users with delete permission -->
									@helpers.CanDelete(ctx, "user", &user.ID) {
										<button 
											class="text-red-600 hover:text-red-900"
											data-user-id={ user.ID.String() }
											data-user-name={ user.Name }
											onclick="confirmDelete('user', this.dataset.userId, this.dataset.userName)">
											<i class="fas fa-trash"></i>
										</button>
									}
									
									<!-- Reset password for system admins only -->
									@helpers.IsSystemAdmin(ctx) {
										<button 
											class="text-yellow-600 hover:text-yellow-900"
											hx-post={ "/admin/users/" + user.ID.String() + "/reset-password" }
											hx-confirm={ "Reset password for " + user.Name + "?" }>
											<i class="fas fa-key"></i>
										</button>
									}
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>

		<!-- Bulk actions for system administrators -->
		@helpers.IsSystemAdmin(ctx) {
			<div class="bg-white p-4 rounded-lg shadow">
				<h3 class="text-lg font-medium text-gray-900 mb-4">Bulk Actions</h3>
				<div class="flex space-x-4">
					<button class="bg-yellow-600 text-white px-4 py-2 rounded hover:bg-yellow-700">
						<i class="fas fa-user-lock mr-2"></i>
						Bulk Suspend
					</button>
					<button class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
						<i class="fas fa-user-check mr-2"></i>
						Bulk Activate
					</button>
					<button class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
						<i class="fas fa-envelope mr-2"></i>
						Send Bulk Email
					</button>
				</div>
			</div>
		}

		<!-- Audit trail section for users with audit permissions -->
		@helpers.HasPermission(ctx, "audit", "read", nil) {
			<div class="bg-white p-6 rounded-lg shadow">
				<h3 class="text-lg font-medium text-gray-900 mb-4">Recent User Activities</h3>
				<div class="space-y-2">
					<div class="flex justify-between items-center py-2 border-b">
						<span class="text-sm text-gray-600">John Doe logged in</span>
						<span class="text-xs text-gray-400">2 hours ago</span>
					</div>
					<div class="flex justify-between items-center py-2 border-b">
						<span class="text-sm text-gray-600">Jane Smith updated profile</span>
						<span class="text-xs text-gray-400">4 hours ago</span>
					</div>
					<div class="flex justify-between items-center py-2">
						<span class="text-sm text-gray-600">Admin created new user</span>
						<span class="text-xs text-gray-400">6 hours ago</span>
					</div>
				</div>
			</div>
		}
	</div>

	<!-- JavaScript for delete confirmation -->
	<script>
		function confirmDelete(resourceType, id, name) {
			if (confirm(`Are you sure you want to delete ${name}? This action cannot be undone.`)) {
				htmx.ajax('DELETE', `/admin/${resourceType}s/${id}`, {
					target: '#main-content',
					swap: 'innerHTML'
				});
			}
		}
	</script>
}

// UserInfo represents user data for the management interface
type UserInfo struct {
	ID         uuid.UUID `json:"id"`
	Name       string    `json:"name"`
	Email      string    `json:"email"`
	Avatar     string    `json:"avatar"`
	Status     string    `json:"status"`
	Role       string    `json:"role"`
	LastActive string    `json:"last_active"`
}