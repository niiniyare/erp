package elements

import "strings"

// BadgeProps defines the properties for the Badge component
type BadgeProps struct {
	Text     string `json:"text" validate:"required"`
	Variant  string `json:"variant" validate:"oneof=default dark red green yellow indigo purple pink blue"`
	Size     string `json:"size" validate:"oneof=xs sm base lg"`
	Outlined bool   `json:"outlined"`
	Pill     bool   `json:"pill"`
	Icon     string `json:"icon"`
	ID       string `json:"id"`
	Class    string `json:"class"`
}

// Badge renders a Flowbite-styled badge component
templ Badge(props BadgeProps) {
	<span
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getBadgeClasses(props.Variant, props.Size, props.Outlined, props.Pill) + " " + props.Class }
	>
		if props.Icon != "" {
			<span class="mr-1">{ props.Icon }</span>
		}
		{ props.Text }
	</span>
}

// Helper functions for badge styling
func getBadgeClasses(variant, size string, outlined, pill bool) string {
	base := "inline-flex items-center font-medium"
	
	// Size classes
	var sizeClass string
	switch size {
	case "xs":
		sizeClass = "px-2 py-0.5 text-xs"
	case "sm":
		sizeClass = "px-2.5 py-0.5 text-xs"
	case "lg":
		sizeClass = "px-3 py-0.5 text-base"
	default: // base
		sizeClass = "px-2.5 py-0.5 text-sm"
	}
	
	// Shape classes
	var shapeClass string
	if pill {
		shapeClass = "rounded-full"
	} else {
		shapeClass = "rounded"
	}
	
	// Variant classes
	var variantClass string
	if outlined {
		switch variant {
		case "dark":
			variantClass = "text-gray-800 border border-gray-300 bg-white dark:bg-gray-900 dark:text-gray-300 dark:border-gray-600"
		case "red":
			variantClass = "text-red-800 border border-red-300 bg-red-50 dark:bg-gray-900 dark:text-red-300 dark:border-red-600"
		case "green":
			variantClass = "text-green-800 border border-green-300 bg-green-50 dark:bg-gray-900 dark:text-green-300 dark:border-green-600"
		case "yellow":
			variantClass = "text-yellow-800 border border-yellow-300 bg-yellow-50 dark:bg-gray-900 dark:text-yellow-300 dark:border-yellow-600"
		case "indigo":
			variantClass = "text-indigo-800 border border-indigo-300 bg-indigo-50 dark:bg-gray-900 dark:text-indigo-300 dark:border-indigo-600"
		case "purple":
			variantClass = "text-purple-800 border border-purple-300 bg-purple-50 dark:bg-gray-900 dark:text-purple-300 dark:border-purple-600"
		case "pink":
			variantClass = "text-pink-800 border border-pink-300 bg-pink-50 dark:bg-gray-900 dark:text-pink-300 dark:border-pink-600"
		case "blue":
			variantClass = "text-blue-800 border border-blue-300 bg-blue-50 dark:bg-gray-900 dark:text-blue-300 dark:border-blue-600"
		default: // default
			variantClass = "text-gray-800 border border-gray-300 bg-white dark:bg-gray-900 dark:text-gray-300 dark:border-gray-600"
		}
	} else {
		switch variant {
		case "dark":
			variantClass = "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300"
		case "red":
			variantClass = "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300"
		case "green":
			variantClass = "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300"
		case "yellow":
			variantClass = "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300"
		case "indigo":
			variantClass = "bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-300"
		case "purple":
			variantClass = "bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-300"
		case "pink":
			variantClass = "bg-pink-100 text-pink-800 dark:bg-pink-900 dark:text-pink-300"
		case "blue":
			variantClass = "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300"
		default: // default
			variantClass = "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300"
		}
	}
	
	return strings.Join([]string{base, sizeClass, shapeClass, variantClass}, " ")
}