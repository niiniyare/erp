package atoms

import "strings"

// SpinnerProps defines the properties for the Spinner component
type SpinnerProps struct {
	Size     string `json:"size" validate:"oneof=xs sm base lg xl"`                    // Size variant
	Color    string `json:"color" validate:"oneof=blue gray red green yellow indigo purple pink"` // Color variant
	Type     string `json:"type" validate:"oneof=border dots pulse"`                  // Animation type
	Text     string `json:"text"`                                                     // Loading text
	Center   bool   `json:"center"`                                                   // Center the spinner
	ID       string `json:"id"`
	Class    string `json:"class"`
	AriaLabel string `json:"aria_label"`
}

// Spinner renders a Flowbite-styled spinner component
templ Spinner(props SpinnerProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getSpinnerContainerClasses(props.Center) + " " + props.Class }
		role="status"
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		} else {
			aria-label="Loading"
		}
	>
		if props.Type == "dots" {
			@SpinnerDots(props)
		} else if props.Type == "pulse" {
			@SpinnerPulse(props)
		} else {
			@SpinnerBorder(props)
		}
		
		if props.Text != "" {
			<span class={ getSpinnerTextClasses() }>{ props.Text }</span>
		} else {
			<span class="sr-only">Loading...</span>
		}
	</div>
}

// SpinnerBorder renders a border spinner (default)
templ SpinnerBorder(props SpinnerProps) {
	<svg 
		class={ getSpinnerClasses(props.Size, props.Color, "border") }
		aria-hidden="true" 
		viewBox="0 0 100 101" 
		fill="none" 
		xmlns="http://www.w3.org/2000/svg"
	>
		<path d="m100 50.5908c0 27.2899-22.1781 50.4092-50.4092 50.4092s-50.4092-23.1193-50.4092-50.4092c0-27.2899 22.1781-50.4092 50.4092-50.4092s50.4092 22.1781 50.4092 50.4092zm-90.2044 0c0 21.9773 17.8261 39.8034 39.8034 39.8034s39.8034-17.8261 39.8034-39.8034c0-21.9773-17.8261-39.8034-39.8034-39.8034s-39.8034 17.8261-39.8034 39.8034z" fill="currentFill"/>
	</svg>
}

// SpinnerDots renders a dots spinner
templ SpinnerDots(props SpinnerProps) {
	<div class={ getSpinnerDotsContainerClasses(props.Size) }>
		<div class={ getSpinnerDotClasses(props.Color, "1") }></div>
		<div class={ getSpinnerDotClasses(props.Color, "2") }></div>
		<div class={ getSpinnerDotClasses(props.Color, "3") }></div>
	</div>
}

// SpinnerPulse renders a pulse spinner
templ SpinnerPulse(props SpinnerProps) {
	<div class={ getSpinnerPulseClasses(props.Size, props.Color) }></div>
}

// Helper functions for spinner styling
func getSpinnerContainerClasses(center bool) string {
	base := "inline-flex items-center"
	
	if center {
		return base + " justify-center"
	}
	
	return base
}

func getSpinnerClasses(size, color, spinnerType string) string {
	base := "animate-spin"
	
	// Size classes
	var sizeClass string
	switch size {
	case "xs":
		sizeClass = "w-3 h-3"
	case "sm":
		sizeClass = "w-4 h-4"
	case "lg":
		sizeClass = "w-6 h-6"
	case "xl":
		sizeClass = "w-8 h-8"
	default: // base
		sizeClass = "w-5 h-5"
	}
	
	// Color classes
	var colorClass string
	switch color {
	case "blue":
		colorClass = "text-blue-600 fill-blue-100 dark:text-blue-500 dark:fill-blue-900"
	case "gray":
		colorClass = "text-gray-600 fill-gray-100 dark:text-gray-400 dark:fill-gray-800"
	case "red":
		colorClass = "text-red-600 fill-red-100 dark:text-red-500 dark:fill-red-900"
	case "green":
		colorClass = "text-green-600 fill-green-100 dark:text-green-500 dark:fill-green-900"
	case "yellow":
		colorClass = "text-yellow-600 fill-yellow-100 dark:text-yellow-500 dark:fill-yellow-900"
	case "indigo":
		colorClass = "text-indigo-600 fill-indigo-100 dark:text-indigo-500 dark:fill-indigo-900"
	case "purple":
		colorClass = "text-purple-600 fill-purple-100 dark:text-purple-500 dark:fill-purple-900"
	case "pink":
		colorClass = "text-pink-600 fill-pink-100 dark:text-pink-500 dark:fill-pink-900"
	default: // blue
		colorClass = "text-blue-600 fill-blue-100 dark:text-blue-500 dark:fill-blue-900"
	}
	
	return strings.Join([]string{base, sizeClass, colorClass}, " ")
}

func getSpinnerDotsContainerClasses(size string) string {
	base := "flex space-x-1"
	
	switch size {
	case "xs":
		return base + " space-x-0.5"
	case "sm":
		return base + " space-x-1"
	case "lg":
		return base + " space-x-1.5"
	case "xl":
		return base + " space-x-2"
	default: // base
		return base + " space-x-1"
	}
}

func getSpinnerDotClasses(color, dotNumber string) string {
	base := "rounded-full animate-pulse"
	
	// Size is handled by the container, dots are consistent
	sizeClass := "w-2 h-2"
	
	// Color classes
	var colorClass string
	switch color {
	case "blue":
		colorClass = "bg-blue-600 dark:bg-blue-500"
	case "gray":
		colorClass = "bg-gray-600 dark:bg-gray-400"
	case "red":
		colorClass = "bg-red-600 dark:bg-red-500"
	case "green":
		colorClass = "bg-green-600 dark:bg-green-500"
	case "yellow":
		colorClass = "bg-yellow-600 dark:bg-yellow-500"
	case "indigo":
		colorClass = "bg-indigo-600 dark:bg-indigo-500"
	case "purple":
		colorClass = "bg-purple-600 dark:bg-purple-500"
	case "pink":
		colorClass = "bg-pink-600 dark:bg-pink-500"
	default: // blue
		colorClass = "bg-blue-600 dark:bg-blue-500"
	}
	
	// Animation delay for staggered effect
	var delayClass string
	switch dotNumber {
	case "1":
		delayClass = "animation-delay-0"
	case "2":
		delayClass = "animation-delay-75"
	case "3":
		delayClass = "animation-delay-150"
	}
	
	return strings.Join([]string{base, sizeClass, colorClass, delayClass}, " ")
}

func getSpinnerPulseClasses(size, color string) string {
	base := "animate-pulse rounded-full"
	
	// Size classes
	var sizeClass string
	switch size {
	case "xs":
		sizeClass = "w-3 h-3"
	case "sm":
		sizeClass = "w-4 h-4"
	case "lg":
		sizeClass = "w-6 h-6"
	case "xl":
		sizeClass = "w-8 h-8"
	default: // base
		sizeClass = "w-5 h-5"
	}
	
	// Color classes
	var colorClass string
	switch color {
	case "blue":
		colorClass = "bg-blue-600 dark:bg-blue-500"
	case "gray":
		colorClass = "bg-gray-600 dark:bg-gray-400"
	case "red":
		colorClass = "bg-red-600 dark:bg-red-500"
	case "green":
		colorClass = "bg-green-600 dark:bg-green-500"
	case "yellow":
		colorClass = "bg-yellow-600 dark:bg-yellow-500"
	case "indigo":
		colorClass = "bg-indigo-600 dark:bg-indigo-500"
	case "purple":
		colorClass = "bg-purple-600 dark:bg-purple-500"
	case "pink":
		colorClass = "bg-pink-600 dark:bg-pink-500"
	default: // blue
		colorClass = "bg-blue-600 dark:bg-blue-500"
	}
	
	return strings.Join([]string{base, sizeClass, colorClass}, " ")
}

func getSpinnerTextClasses() string {
	return "ml-2 text-sm font-medium text-gray-500 dark:text-gray-400"
}