package components

import "github.com/niiniyare/erp/internal/ui/types"

// BaseModal provides the foundation for all modal dialogs with accessibility and animation
templ BaseModal(props types.ModalProps) {
	<div 
		id={ "modal-" + props.ID }
		class="fixed inset-0 z-50 overflow-y-auto"
		x-data="modalState()"
		x-show="show"
		x-transition:enter="ease-out duration-300"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="ease-in duration-200"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		@keydown.escape.window="closeModal()"
		aria-labelledby={ "modal-title-" + props.ID }
		aria-describedby={ "modal-description-" + props.ID }
		role="dialog"
		aria-modal="true"
		style="display: none;">
		
		<!-- Background overlay -->
		<div 
			class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"
			@click="closeModal()">
		</div>

		<!-- Modal container -->
		<div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
			<div 
				class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 w-full"
				:class="{
					'sm:max-w-sm': size === 'sm',
					'sm:max-w-lg': size === 'md',
					'sm:max-w-2xl': size === 'lg',
					'sm:max-w-4xl': size === 'xl',
					'sm:max-w-6xl': size === '2xl'
				}"
				x-transition:enter="ease-out duration-300"
				x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
				x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
				x-transition:leave="ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
				x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
				@click.stop>
				
				<!-- Modal header -->
				if props.Title != "" || props.ShowCloseButton {
					<div class="flex items-start justify-between p-4 border-b border-gray-200">
						<div class="flex-1">
							if props.Title != "" {
								<h3 
									id={ "modal-title-" + props.ID }
									class="text-lg font-semibold text-gray-900">
									{ props.Title }
								</h3>
							}
							if props.Subtitle != "" {
								<p 
									id={ "modal-description-" + props.ID }
									class="mt-1 text-sm text-gray-500">
									{ props.Subtitle }
								</p>
							}
						</div>
						
						if props.ShowCloseButton {
							<button 
								@click="closeModal()"
								type="button"
								class="ml-3 text-gray-400 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
								aria-label="Close modal">
								<i class="fas fa-times h-5 w-5"></i>
							</button>
						}
					</div>
				}

				<!-- Modal body -->
				<div class="px-4 py-5 sm:p-6">
					{ children... }
				</div>

				<!-- Modal footer with actions -->
				if props.Actions != nil && len(props.Actions) > 0 {
					<div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
						for i, action := range props.Actions {
							@ModalAction(action, i == 0)
						}
					</div>
				}
			</div>
		</div>
	</div>
}

// ModalAction renders individual action buttons with proper styling
templ ModalAction(action types.ModalAction, isPrimary bool) {
	if action.Type == "submit" {
		<button 
			type="submit"
			form={ action.FormID }
			class={
				templ.Classes(
					"inline-flex w-full justify-center rounded-md px-3 py-2 text-sm font-semibold shadow-sm sm:ml-3 sm:w-auto",
					templ.KV("bg-blue-600 text-white hover:bg-blue-500 focus:ring-blue-600", isPrimary),
					templ.KV("bg-white text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:ring-gray-500", !isPrimary),
				)
			}
			:disabled="loading"
			@click={ action.OnClick }>
			<span x-show="!loading">{ action.Label }</span>
			<span x-show="loading" class="flex items-center">
				<i class="fas fa-spinner fa-spin mr-2"></i>
				{ action.LoadingText }
			</span>
		</button>
	} else if action.Type == "button" {
		<button 
			type="button"
			class={
				templ.Classes(
					"inline-flex w-full justify-center rounded-md px-3 py-2 text-sm font-semibold shadow-sm sm:ml-3 sm:w-auto",
					templ.KV("bg-blue-600 text-white hover:bg-blue-500 focus:ring-blue-600", isPrimary),
					templ.KV("bg-white text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:ring-gray-500", !isPrimary),
				)
			}
			@click={ action.OnClick }>
			{ action.Label }
		</button>
	} else if action.Type == "htmx" {
		<button 
			type="button"
			hx-post={ action.URL }
			hx-target={ action.Target }
			hx-swap={ action.Swap }
			hx-headers='{"X-CSRF-Token": document.querySelector("meta[name=csrf-token]").content}'
			class={
				templ.Classes(
					"inline-flex w-full justify-center rounded-md px-3 py-2 text-sm font-semibold shadow-sm sm:ml-3 sm:w-auto",
					templ.KV("bg-blue-600 text-white hover:bg-blue-500 focus:ring-blue-600", isPrimary),
					templ.KV("bg-white text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:ring-gray-500", !isPrimary),
				)
			}
			@click={ action.OnClick }>
			{ action.Label }
		</button>
	}
}

// ConfirmDialog creates a confirmation modal for destructive actions
templ ConfirmDialog(props types.ConfirmDialogProps) {
	@BaseModal(types.ModalProps{
		ID: props.ID,
		Title: props.Title,
		Subtitle: props.Message,
		Size: "sm",
		ShowCloseButton: true,
		Actions: []types.ModalAction{
			{
				Type: "button",
				Label: props.CancelText,
				OnClick: "closeModal()",
			},
			{
				Type: "htmx",
				Label: props.ConfirmText,
				URL: props.ActionURL,
				Target: props.Target,
				Swap: props.Swap,
				OnClick: "closeModal()",
			},
		},
	}) {
		<div class="flex">
			<div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
				<i class="fas fa-exclamation-triangle h-6 w-6 text-red-600"></i>
			</div>
			<div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
				<h3 class="text-base font-semibold leading-6 text-gray-900">
					{ props.Title }
				</h3>
				<div class="mt-2">
					<p class="text-sm text-gray-500">
						{ props.Message }
					</p>
				</div>
			</div>
		</div>
	}
}

// FormModal creates a modal specifically for forms with validation
templ FormModal(props types.FormModalProps) {
	@BaseModal(types.ModalProps{
		ID: props.ID,
		Title: props.Title,
		Subtitle: props.Subtitle,
		Size: props.Size,
		ShowCloseButton: true,
		Actions: []types.ModalAction{
			{
				Type: "button",
				Label: "Cancel",
				OnClick: "closeModal()",
			},
			{
				Type: "submit",
				Label: props.SubmitText,
				LoadingText: "Saving...",
				FormID: props.FormID,
			},
		},
	}) {
		<form 
			id={ props.FormID }
			hx-post={ props.ActionURL }
			hx-target={ props.Target }
			hx-swap={ props.Swap }
			hx-headers='{"X-CSRF-Token": document.querySelector("meta[name=csrf-token]").content}'
			@submit="loading = true"
			@htmx:afterSwap="closeModal()"
			@htmx:responseError="loading = false"
			x-data="{ loading: false }">
			
			{ children... }
		</form>
	}
}

// InfoModal creates an informational modal for displaying content
templ InfoModal(props types.InfoModalProps) {
	@BaseModal(types.ModalProps{
		ID: props.ID,
		Title: props.Title,
		Subtitle: props.Subtitle,
		Size: props.Size,
		ShowCloseButton: true,
		Actions: []types.ModalAction{
			{
				Type: "button",
				Label: "Close",
				OnClick: "closeModal()",
			},
		},
	}) {
		<div class="space-y-4">
			{ children... }
		</div>
	}
}

