package components

import "github.com/niiniyare/erp/internal/ui/types"

// BaseInput provides enhanced input fields with validation, help text, and accessibility
templ BaseInput(props types.InputProps) {
	<div 
		class="mb-4" 
		x-data="{ focused: false, hasError: false }" 
		x-init="initFieldValidation('{ props.Name }')">
		
		<!-- Label with tooltip support -->
		if props.Label != "" {
			<label 
				class="block text-sm font-medium text-gray-700 mb-2"
				for={ props.ID }>
				{ props.Label }
				if props.Required {
					<span class="text-red-500 ml-1" aria-label="required">*</span>
				}
				if props.Tooltip != "" {
					<button 
						type="button"
						class="ml-1 text-gray-400 hover:text-gray-600 focus:outline-none"
						x-data="tooltip('{ props.Tooltip }')"
						@click="show = !show"
						@blur="show = false"
						aria-describedby={ "tooltip-" + props.ID }>
						<i class="fas fa-info-circle text-xs"></i>
					</button>
					<!-- Tooltip -->
					<div 
						x-show="show"
						x-transition:enter="transition ease-out duration-100"
						x-transition:enter-start="transform opacity-0 scale-95"
						x-transition:enter-end="transform opacity-100 scale-100"
						x-transition:leave="transition ease-in duration-75"
						x-transition:leave-start="transform opacity-100 scale-100"
						x-transition:leave-end="transform opacity-0 scale-95"
						id={ "tooltip-" + props.ID }
						role="tooltip"
						class="absolute z-10 px-3 py-2 text-sm text-white bg-gray-900 rounded-lg shadow-sm mt-1"
						style="display: none;">
						{ props.Tooltip }
					</div>
				}
			</label>
		}
		
		<!-- Input wrapper with validation indicators -->
		<div class="relative">
			<input
				id={ props.ID }
				name={ props.Name }
				type={ props.Type }
				value={ props.Value }
				placeholder={ props.Placeholder }
				required?={ props.Required }
				disabled?={ props.Disabled }
				readonly?={ props.ReadOnly }
				autocomplete={ props.Autocomplete }
				class={
					templ.Classes(
						"block w-full rounded-md border px-3 py-2 text-sm placeholder-gray-500 focus:outline-none focus:ring-1",
						templ.KV("border-gray-300 focus:border-blue-500 focus:ring-blue-500", !props.HasError),
						templ.KV("border-red-300 focus:border-red-500 focus:ring-red-500", props.HasError),
						templ.KV("bg-gray-50 cursor-not-allowed", props.Disabled),
						templ.KV("bg-gray-50", props.ReadOnly),
					)
				}
				@focus="focused = true"
				@blur="focused = false; validateField('{ props.Name }', $el.value)"
				@input="
					if (props.ValidateOnInput) {
						debouncedValidation('{ props.Name }', $el.value, 300)
					}
					if (props.MaxLength > 0) {
						$store.forms.updateCharCount('{ props.Name }', $el.value.length)
					}
					$store.forms.saveDraft('{ props.FormID }', getFormData($el.closest('form')))
				"
				hx-post={ props.ValidationURL }
				hx-trigger="blur changed delay:500ms"
				hx-target={ "#validation-" + props.Name }
				hx-swap="innerHTML"
				hx-include="[name='csrf_token']"
				hx-indicator={ "#loading-" + props.Name }
				hx-headers='{"X-CSRF-Token": document.querySelector("meta[name=csrf-token]").content}'
			/>
			
			<!-- Loading spinner for async validation -->
			<div 
				id={ "loading-" + props.Name }
				class="htmx-indicator absolute right-3 top-1/2 transform -translate-y-1/2"
				role="status"
				aria-label="Validating">
				<i class="fas fa-spinner fa-spin text-gray-400"></i>
			</div>
			
			<!-- Success indicator -->
			<div 
				x-show="$store.forms.getFieldState('{ props.Name }') === 'valid'" 
				class="absolute right-3 top-1/2 transform -translate-y-1/2">
				<i class="fas fa-check text-green-500"></i>
			</div>
			
			<!-- Error indicator -->
			<div 
				x-show="$store.forms.getFieldState('{ props.Name }') === 'error'" 
				class="absolute right-3 top-1/2 transform -translate-y-1/2">
				<i class="fas fa-exclamation-circle text-red-500"></i>
			</div>
		</div>
		
		<!-- Validation message container -->
		<div id={ "validation-" + props.Name } class="mt-1">
			<!-- Server-side validation messages will be loaded here -->
		</div>
		
		<!-- Client-side error message -->
		<div 
			x-show="$store.forms.getFieldError('{ props.Name }')" 
			x-text="$store.forms.getFieldError('{ props.Name }')"
			class="text-red-500 text-sm mt-1"
			role="alert"
			aria-live="polite">
		</div>
		
		<!-- Help text -->
		if props.HelpText != "" {
			<div id={ "help-" + props.ID } class="text-gray-500 text-sm mt-1">
				{ props.HelpText }
			</div>
		}
		
		<!-- Character counter for text inputs -->
		if props.MaxLength > 0 {
			<div class="text-xs text-gray-400 mt-1 text-right">
				<span x-text="$store.forms.getCharCount('{ props.Name }') || 0"></span>
				<span>/{ templ.JSONString(props.MaxLength) }</span>
			</div>
		}
	</div>
}

// SelectInput provides enhanced select fields with search and validation
templ SelectInput(props types.SelectProps) {
	<div 
		class="mb-4" 
		x-data="selectField('{ props.Name }', { props.Multiple })"
		x-init="initFieldValidation('{ props.Name }')">
		
		<!-- Label -->
		if props.Label != "" {
			<label 
				class="block text-sm font-medium text-gray-700 mb-2"
				for={ props.ID }>
				{ props.Label }
				if props.Required {
					<span class="text-red-500 ml-1" aria-label="required">*</span>
				}
			</label>
		}
		
		<!-- Select wrapper -->
		<div class="relative">
			if props.Searchable {
				<!-- Searchable select with dropdown -->
				<div class="relative">
					<input
						id={ props.ID }
						type="text"
						placeholder={ props.Placeholder }
						x-model="searchTerm"
						@focus="isOpen = true"
						@blur="setTimeout(() => isOpen = false, 150)"
						@input="filterOptions()"
						class="block w-full rounded-md border border-gray-300 px-3 py-2 text-sm placeholder-gray-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
					/>
					
					<!-- Dropdown arrow -->
					<div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
						<i class="fas fa-chevron-down text-gray-400"></i>
					</div>
					
					<!-- Options dropdown -->
					<div 
						x-show="isOpen && filteredOptions.length > 0"
						x-transition:enter="transition ease-out duration-100"
						x-transition:enter-start="transform opacity-0 scale-95"
						x-transition:enter-end="transform opacity-100 scale-100"
						x-transition:leave="transition ease-in duration-75"
						x-transition:leave-start="transform opacity-100 scale-100"
						x-transition:leave-end="transform opacity-0 scale-95"
						class="absolute z-10 mt-1 max-h-60 w-full overflow-auto rounded-md bg-white py-1 text-base shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none"
						style="display: none;">
						
						<template x-for="option in filteredOptions" :key="option.value">
							<div 
								@click="selectOption(option)"
								class="cursor-pointer select-none relative py-2 pl-3 pr-9 text-gray-900 hover:bg-blue-50"
								:class="{ 'bg-blue-100': isSelected(option.value) }">
								<span x-text="option.label" class="block truncate"></span>
								<span x-show="isSelected(option.value)" class="absolute inset-y-0 right-0 flex items-center pr-4 text-blue-600">
									<i class="fas fa-check"></i>
								</span>
							</div>
						</template>
					</div>
				</div>
				
				<!-- Hidden input for form submission -->
				<input 
					type="hidden" 
					:name="props.Name"
					:value="selectedValue"
				/>
			} else {
				<!-- Standard select -->
				<select
					id={ props.ID }
					name={ props.Name }
					required?={ props.Required }
					disabled?={ props.Disabled }
					multiple?={ props.Multiple }
					class={
						templ.Classes(
							"block w-full rounded-md border px-3 py-2 text-sm focus:outline-none focus:ring-1",
							templ.KV("border-gray-300 focus:border-blue-500 focus:ring-blue-500", !props.HasError),
							templ.KV("border-red-300 focus:border-red-500 focus:ring-red-500", props.HasError),
							templ.KV("bg-gray-50 cursor-not-allowed", props.Disabled),
						)
					}
					@change="validateField('{ props.Name }', $el.value)">
					
					if props.Placeholder != "" && !props.Multiple {
						<option value="">{ props.Placeholder }</option>
					}
					
					for _, option := range props.Options {
						<option 
							value={ option.Value }
							selected?={ option.Selected }>
							{ option.Label }
						</option>
					}
				</select>
			}
		</div>
		
		<!-- Error message -->
		<div 
			x-show="$store.forms.getFieldError('{ props.Name }')" 
			x-text="$store.forms.getFieldError('{ props.Name }')"
			class="text-red-500 text-sm mt-1"
			role="alert"
			aria-live="polite">
		</div>
		
		<!-- Help text -->
		if props.HelpText != "" {
			<div class="text-gray-500 text-sm mt-1">
				{ props.HelpText }
			</div>
		}
	</div>
}

// TextareaInput provides enhanced textarea fields with auto-resize and validation
templ TextareaInput(props types.TextareaProps) {
	<div 
		class="mb-4" 
		x-data="textareaField('{ props.Name }')"
		x-init="initFieldValidation('{ props.Name }')">
		
		<!-- Label -->
		if props.Label != "" {
			<label 
				class="block text-sm font-medium text-gray-700 mb-2"
				for={ props.ID }>
				{ props.Label }
				if props.Required {
					<span class="text-red-500 ml-1" aria-label="required">*</span>
				}
			</label>
		}
		
		<!-- Textarea wrapper -->
		<div class="relative">
			<textarea
				id={ props.ID }
				name={ props.Name }
				placeholder={ props.Placeholder }
				required?={ props.Required }
				disabled?={ props.Disabled }
				readonly?={ props.ReadOnly }
				rows={ templ.JSONString(props.Rows) }
				class={
					templ.Classes(
						"block w-full rounded-md border px-3 py-2 text-sm placeholder-gray-500 focus:outline-none focus:ring-1 resize-none",
						templ.KV("border-gray-300 focus:border-blue-500 focus:ring-blue-500", !props.HasError),
						templ.KV("border-red-300 focus:border-red-500 focus:ring-red-500", props.HasError),
						templ.KV("bg-gray-50 cursor-not-allowed", props.Disabled),
						templ.KV("bg-gray-50", props.ReadOnly),
					)
				}
				@input="
					if (props.AutoResize) {
						autoResize($el)
					}
					if (props.MaxLength > 0) {
						$store.forms.updateCharCount('{ props.Name }', $el.value.length)
					}
					$store.forms.saveDraft('{ props.FormID }', getFormData($el.closest('form')))
				"
				@blur="validateField('{ props.Name }', $el.value)"
				x-ref="textarea">{ props.Value }</textarea>
		</div>
		
		<!-- Error message -->
		<div 
			x-show="$store.forms.getFieldError('{ props.Name }')" 
			x-text="$store.forms.getFieldError('{ props.Name }')"
			class="text-red-500 text-sm mt-1"
			role="alert"
			aria-live="polite">
		</div>
		
		<!-- Help text and character counter -->
		<div class="flex justify-between items-center mt-1">
			if props.HelpText != "" {
				<div class="text-gray-500 text-sm">
					{ props.HelpText }
				</div>
			}
			
			if props.MaxLength > 0 {
				<div class="text-xs text-gray-400">
					<span x-text="$store.forms.getCharCount('{ props.Name }') || 0"></span>
					<span>/{ templ.JSONString(props.MaxLength) }</span>
				</div>
			}
		</div>
	</div>
}

// CheckboxInput provides enhanced checkbox fields with validation
templ CheckboxInput(props types.CheckboxProps) {
	<div 
		class="mb-4" 
		x-data="checkboxField('{ props.Name }')"
		x-init="initFieldValidation('{ props.Name }')">
		
		<div class="flex items-start">
			<div class="flex items-center h-5">
				<input
					id={ props.ID }
					name={ props.Name }
					type="checkbox"
					value={ props.Value }
					checked?={ props.Checked }
					required?={ props.Required }
					disabled?={ props.Disabled }
					class="focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 rounded"
					@change="validateField('{ props.Name }', $el.checked)"
				/>
			</div>
			
			<div class="ml-3 text-sm">
				if props.Label != "" {
					<label for={ props.ID } class="font-medium text-gray-700">
						{ props.Label }
						if props.Required {
							<span class="text-red-500 ml-1" aria-label="required">*</span>
						}
					</label>
				}
				
				if props.HelpText != "" {
					<p class="text-gray-500 mt-1">{ props.HelpText }</p>
				}
			</div>
		</div>
		
		<!-- Error message -->
		<div 
			x-show="$store.forms.getFieldError('{ props.Name }')" 
			x-text="$store.forms.getFieldError('{ props.Name }')"
			class="text-red-500 text-sm mt-1 ml-7"
			role="alert"
			aria-live="polite">
		</div>
	</div>
}

