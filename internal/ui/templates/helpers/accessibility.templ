package helpers

import (
	"github.com/niiniyare/erp/internal/ui/helpers"
)

// Global accessibility helper instance (to be injected)
var accessibilityHelper *helpers.AccessibilityHelper

// SetAccessibilityHelper sets the global accessibility helper instance
func SetAccessibilityHelper(helper *helpers.AccessibilityHelper) {
	accessibilityHelper = helper
}

// Template helper functions for accessibility features

// AccessibleButton creates an accessible button with proper ARIA attributes
templ AccessibleButton(config *helpers.ButtonConfig, label string) {
	<button 
		type="button"
		class="focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
		if config != nil && config.Disabled {
			disabled
			aria-disabled="true"
		}
		if config != nil && config.Pressed != nil {
			aria-pressed={ templ.JSONString(*config.Pressed) }
		}
		if config != nil && config.Expanded != nil {
			aria-expanded={ templ.JSONString(*config.Expanded) }
		}
		if config != nil && config.Controls != "" {
			aria-controls={ config.Controls }
		}
		if config != nil && config.HasPopup {
			aria-haspopup="true"
		}>
		<span class="sr-only">{ getScreenReaderText(label) }</span>
		{ children... }
	</button>
}

// AccessibleLink creates an accessible link with proper attributes
templ AccessibleLink(href, label string, external bool) {
	<a 
		href={ templ.URL(href) }
		if external {
			target="_blank"
			rel="noopener noreferrer"
			aria-label={ label + " (opens in new tab)" }
		} else {
			aria-label={ label }
		}
		class="focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 underline hover:no-underline">
		{ children... }
		if external {
			<span class="sr-only"> (opens in new tab)</span>
			<i class="fas fa-external-link-alt ml-1 text-sm" aria-hidden="true"></i>
		}
	</a>
}

// AccessibleForm creates a form with proper accessibility attributes
templ AccessibleForm(id, action, method string) {
	<form 
		id={ id }
		action={ action }
		method={ method }
		novalidate
		aria-live="polite"
		class="space-y-6">
		{ children... }
	</form>
}

// AccessibleInput creates an accessible form input
templ AccessibleInput(config *AccessibleInputConfig) {
	<div class="form-field">
		if config.Label != "" {
			<label 
				for={ config.ID }
				class="block text-sm font-medium text-gray-700 mb-1">
				{ config.Label }
				if config.Required {
					<span class="text-red-500 ml-1" aria-label="required">*</span>
				}
			</label>
		}
		
		<input 
			id={ config.ID }
			name={ config.Name }
			type={ config.Type }
			value={ config.Value }
			placeholder={ config.Placeholder }
			if config.Required {
				required
				aria-required="true"
			}
			if config.HasError {
				aria-invalid="true"
				aria-describedby={ config.ID + "-error" }
			}
			if config.AriaDescribedBy != "" {
				aria-describedby={ config.AriaDescribedBy }
			}
			class={ getInputClasses(config.HasError) }
		/>
		
		if config.HelpText != "" {
			<div id={ config.ID + "-help" } class="mt-1 text-sm text-gray-500">
				{ config.HelpText }
			</div>
		}
		
		if config.HasError && config.ErrorMessage != "" {
			<div 
				id={ config.ID + "-error" } 
				class="mt-1 text-sm text-red-600"
				role="alert"
				aria-live="polite">
				<i class="fas fa-exclamation-circle mr-1" aria-hidden="true"></i>
				{ config.ErrorMessage }
			</div>
		}
	</div>
}

// AccessibleSelect creates an accessible select dropdown
templ AccessibleSelect(config *AccessibleSelectConfig, options []SelectOption) {
	<div class="form-field">
		if config.Label != "" {
			<label 
				for={ config.ID }
				class="block text-sm font-medium text-gray-700 mb-1">
				{ config.Label }
				if config.Required {
					<span class="text-red-500 ml-1" aria-label="required">*</span>
				}
			</label>
		}
		
		<select 
			id={ config.ID }
			name={ config.Name }
			if config.Required {
				required
				aria-required="true"
			}
			if config.HasError {
				aria-invalid="true"
				aria-describedby={ config.ID + "-error" }
			}
			class={ getInputClasses(config.HasError) }>
			
			if config.Placeholder != "" {
				<option value="" disabled selected>{ config.Placeholder }</option>
			}
			
			for _, option := range options {
				<option 
					value={ option.Value }
					if option.Selected {
						selected
					}
					if option.Disabled {
						disabled
					}>
					{ option.Label }
				</option>
			}
		</select>
		
		if config.HasError && config.ErrorMessage != "" {
			<div 
				id={ config.ID + "-error" } 
				class="mt-1 text-sm text-red-600"
				role="alert"
				aria-live="polite">
				<i class="fas fa-exclamation-circle mr-1" aria-hidden="true"></i>
				{ config.ErrorMessage }
			</div>
		}
	</div>
}

// AccessibleTable creates an accessible data table
templ AccessibleTable(config *AccessibleTableConfig) {
	<div class="overflow-x-auto">
		if config.Caption != "" {
			<div class="sr-only">{ config.Caption }</div>
		}
		
		<table 
			class="min-w-full divide-y divide-gray-200"
			role="table"
			if config.Caption != "" {
				aria-label={ config.Caption }
			}>
			
			if config.ShowCaption && config.Caption != "" {
				<caption class="text-lg font-medium text-gray-900 mb-4">
					{ config.Caption }
				</caption>
			}
			
			{ children... }
		</table>
	</div>
}

// AccessibleTableHeader creates accessible table headers
templ AccessibleTableHeader(headers []TableHeader) {
	<thead class="bg-gray-50">
		<tr>
			for _, header := range headers {
				<th 
					scope="col"
					class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
					if header.Sortable {
						tabindex="0"
						role="columnheader"
						aria-sort={ header.SortDirection }
					}>
					
					if header.Sortable {
						<button 
							class="group inline-flex items-center focus:outline-none focus:ring-2 focus:ring-blue-500"
							aria-label={ "Sort by " + header.Label }>
							{ header.Label }
							<span class="ml-2 flex-none rounded text-gray-400 group-hover:text-gray-500">
								if header.SortDirection == "ascending" {
									<i class="fas fa-chevron-up" aria-hidden="true"></i>
								} else if header.SortDirection == "descending" {
									<i class="fas fa-chevron-down" aria-hidden="true"></i>
								} else {
									<i class="fas fa-chevron-up opacity-0 group-hover:opacity-100" aria-hidden="true"></i>
								}
							</span>
						</button>
					} else {
						{ header.Label }
					}
				</th>
			}
		</tr>
	</thead>
}

// AccessibleModal creates an accessible modal dialog
templ AccessibleModal(config *AccessibleModalConfig) {
	<!-- Modal backdrop -->
	<div 
		class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50"
		aria-hidden="true"
		onclick="closeModal()">
	</div>
	
	<!-- Modal dialog -->
	<div 
		class="relative top-20 mx-auto p-5 border w-11/12 md:w-3/4 lg:w-1/2 shadow-lg rounded-md bg-white z-50"
		role="dialog"
		aria-modal="true"
		aria-labelledby={ config.ID + "-title" }
		if config.Description != "" {
			aria-describedby={ config.ID + "-description" }
		}>
		
		<!-- Modal header -->
		<div class="flex justify-between items-center pb-3">
			<h3 id={ config.ID + "-title" } class="text-lg font-bold text-gray-900">
				{ config.Title }
			</h3>
			<button 
				onclick="closeModal()"
				class="text-gray-400 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
				aria-label="Close dialog">
				<i class="fas fa-times" aria-hidden="true"></i>
			</button>
		</div>
		
		<!-- Modal content -->
		<div class="mt-3">
			if config.Description != "" {
				<div id={ config.ID + "-description" } class="text-sm text-gray-600 mb-4">
					{ config.Description }
				</div>
			}
			{ children... }
		</div>
	</div>
}

// AccessibleNotification creates an accessible notification/alert
templ AccessibleNotification(config *AccessibleNotificationConfig) {
	<div 
		class={ "rounded-md p-4 " + getNotificationClasses(config.Type) }
		role={ getNotificationRole(config.Type) }
		aria-live={ getNotificationAriaLive(config.Type) }>
		
		<div class="flex">
			<div class="flex-shrink-0">
				<i class={ getNotificationIcon(config.Type) + " h-5 w-5" } aria-hidden="true"></i>
			</div>
			<div class="ml-3">
				if config.Title != "" {
					<h3 class="text-sm font-medium">
						{ config.Title }
					</h3>
				}
				<div class={ getNotificationContentClasses(config.Title != "") }>
					{ children... }
				</div>
			</div>
			if config.Dismissible {
				<div class="ml-auto pl-3">
					<button 
						class="inline-flex rounded-md p-1.5 focus:outline-none focus:ring-2 focus:ring-offset-2"
						onclick="this.parentElement.parentElement.parentElement.remove()"
						aria-label="Dismiss notification">
						<i class="fas fa-times h-4 w-4" aria-hidden="true"></i>
					</button>
				</div>
			}
		</div>
	</div>
}

// SkipLink creates a skip navigation link for keyboard users
templ SkipLink(target, label string) {
	<a 
		href={ templ.URL(target) }
		class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-blue-600 text-white px-4 py-2 rounded-md z-50 focus:outline-none focus:ring-2 focus:ring-white">
		{ label }
	</a>
}

// ScreenReaderOnly creates content only visible to screen readers
templ ScreenReaderOnly(text string) {
	<span class="sr-only">{ text }</span>
}

// ProgressiveEnhancement wraps content with progressive enhancement attributes
templ ProgressiveEnhancement(config *helpers.ProgressiveConfig) {
	<div 
		class="progressive-enhancement"
		if config != nil && config.NoJSFallback {
			data-nojs-fallback="true"
		}
		if config != nil && config.EnhancedBehavior != "" {
			data-enhanced={ config.EnhancedBehavior }
		}
		if config != nil && config.LoadingState {
			data-loading="false"
			aria-busy="false"
		}>
		{ children... }
	</div>
}

// Configuration types for accessibility components

type AccessibleInputConfig struct {
	ID              string
	Name            string
	Type            string
	Value           string
	Label           string
	Placeholder     string
	HelpText        string
	Required        bool
	HasError        bool
	ErrorMessage    string
	AriaDescribedBy string
}

type AccessibleSelectConfig struct {
	ID           string
	Name         string
	Label        string
	Placeholder  string
	Required     bool
	HasError     bool
	ErrorMessage string
}

type SelectOption struct {
	Value    string
	Label    string
	Selected bool
	Disabled bool
}

type AccessibleTableConfig struct {
	Caption     string
	ShowCaption bool
	Sortable    bool
}

type TableHeader struct {
	Label         string
	Sortable      bool
	SortDirection string // "ascending", "descending", or ""
}

type AccessibleModalConfig struct {
	ID          string
	Title       string
	Description string
}

type AccessibleNotificationConfig struct {
	Type        string // "success", "error", "warning", "info"
	Title       string
	Dismissible bool
}

// Helper functions for accessibility components

func getNotificationClasses(notificationType string) string {
	switch notificationType {
	case "success":
		return "bg-green-50 border border-green-200 text-green-800"
	case "error":
		return "bg-red-50 border border-red-200 text-red-800"
	case "warning":
		return "bg-yellow-50 border border-yellow-200 text-yellow-800"
	case "info":
		return "bg-blue-50 border border-blue-200 text-blue-800"
	default:
		return "bg-gray-50 border border-gray-200 text-gray-800"
	}
}

func getNotificationRole(notificationType string) string {
	if notificationType == "error" {
		return "alert"
	}
	return "status"
}

func getNotificationAriaLive(notificationType string) string {
	if notificationType == "error" {
		return "assertive"
	}
	return "polite"
}

func getNotificationIcon(notificationType string) string {
	switch notificationType {
	case "success":
		return "fas fa-check-circle text-green-400"
	case "error":
		return "fas fa-exclamation-circle text-red-400"
	case "warning":
		return "fas fa-exclamation-triangle text-yellow-400"
	case "info":
		return "fas fa-info-circle text-blue-400"
	default:
		return "fas fa-info-circle text-gray-400"
	}
}

func getScreenReaderText(text string) string {
	if accessibilityHelper == nil {
		return text
	}
	return accessibilityHelper.GenerateScreenReaderText(text)
}

func getInputClasses(hasError bool) string {
	base := "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
	if hasError {
		return base + " border-red-300 focus:border-red-500 focus:ring-red-500"
	}
	return base
}

func getNotificationContentClasses(hasTitle bool) string {
	if hasTitle {
		return "mt-2 text-sm"
	}
	return "text-sm"
}