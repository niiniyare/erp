package examples

import (
	"context"
	"github.com/niiniyare/erp/internal/ui/templates/helpers"
)

// AccessibilityDemoPage demonstrates accessibility features and progressive enhancement
templ AccessibilityDemoPage(ctx context.Context) {
	<div class="space-y-8 respect-motion-preference">
		<!-- Page Header with proper heading hierarchy -->
		<div class="bg-white p-6 rounded-lg shadow">
			<h1 class="text-3xl font-bold text-gray-900 mb-2">
				Accessibility & Progressive Enhancement Demo
			</h1>
			<p class="text-gray-600 text-lg">
				Demonstrating WCAG 2.1 AA compliance and progressive enhancement patterns
			</p>
		</div>

		<!-- Skip Links Demo -->
		<section class="bg-white p-6 rounded-lg shadow" aria-labelledby="skip-links-heading">
			<h2 id="skip-links-heading" class="text-xl font-semibold text-gray-900 mb-4">
				Skip Navigation Links
			</h2>
			<p class="text-gray-600 mb-4">
				Press Tab to see skip links that help keyboard users navigate quickly.
			</p>
			<div class="bg-blue-50 p-4 rounded-lg">
				<p class="text-blue-800 text-sm">
					<i class="fas fa-info-circle mr-2" aria-hidden="true"></i>
					<strong>Try it:</strong> Press Tab when this page loads to see skip links appear.
				</p>
			</div>
		</section>

		<!-- Accessible Forms Demo -->
		<section class="bg-white p-6 rounded-lg shadow" aria-labelledby="forms-heading">
			<h2 id="forms-heading" class="text-xl font-semibold text-gray-900 mb-4">
				Accessible Forms
			</h2>
			
			@helpers.AccessibleForm("demo-form", "/api/demo", "POST") {
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					@helpers.AccessibleInput(&helpers.AccessibleInputConfig{
						ID:          "full-name",
						Name:        "full_name",
						Type:        "text",
						Label:       "Full Name",
						Placeholder: "Enter your full name",
						Required:    true,
						HelpText:    "Enter your first and last name",
					})

					@helpers.AccessibleInput(&helpers.AccessibleInputConfig{
						ID:          "email",
						Name:        "email",
						Type:        "email",
						Label:       "Email Address",
						Placeholder: "user@example.com",
						Required:    true,
						HelpText:    "We'll use this to send you important updates",
					})

					@helpers.AccessibleSelect(&helpers.AccessibleSelectConfig{
						ID:          "department",
						Name:        "department",
						Label:       "Department",
						Placeholder: "Select your department",
						Required:    true,
					}, []helpers.SelectOption{
						{Value: "finance", Label: "Finance", Selected: false, Disabled: false},
						{Value: "hr", Label: "Human Resources", Selected: false, Disabled: false},
						{Value: "it", Label: "Information Technology", Selected: true, Disabled: false},
						{Value: "sales", Label: "Sales", Selected: false, Disabled: false},
					})

					@helpers.AccessibleInput(&helpers.AccessibleInputConfig{
						ID:           "phone",
						Name:         "phone",
						Type:         "tel",
						Label:        "Phone Number",
						Placeholder:  "(555) 123-4567",
						Required:     false,
						HelpText:     "Optional: 10-digit phone number",
					})
				</div>

				<!-- Error State Demo -->
				<div class="mt-6">
					<h3 class="text-lg font-medium text-gray-900 mb-4">Error State Example</h3>
					@helpers.AccessibleInput(&helpers.AccessibleInputConfig{
						ID:           "invalid-email",
						Name:         "invalid_email",
						Type:         "email",
						Label:        "Email with Error",
						Value:        "invalid-email",
						Required:     true,
						HasError:     true,
						ErrorMessage: "Please enter a valid email address",
						HelpText:     "This field shows how errors are announced to screen readers",
					})
				</div>

				<div class="mt-6">
					<button 
						type="submit"
						class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
						<i class="fas fa-paper-plane mr-2" aria-hidden="true"></i>
						Submit Form
					</button>
				</div>
			}
		</section>

		<!-- Accessible Data Table Demo -->
		<section class="bg-white p-6 rounded-lg shadow" aria-labelledby="table-heading">
			<h2 id="table-heading" class="text-xl font-semibold text-gray-900 mb-4">
				Accessible Data Table
			</h2>
			
			@helpers.AccessibleTable(&helpers.AccessibleTableConfig{
				Caption:     "Employee Information with sortable columns",
				ShowCaption: true,
				Sortable:    true,
			}) {
				@helpers.AccessibleTableHeader([]helpers.TableHeader{
					{Label: "Name", Sortable: true, SortDirection: "ascending"},
					{Label: "Department", Sortable: true, SortDirection: ""},
					{Label: "Role", Sortable: true, SortDirection: ""},
					{Label: "Status", Sortable: false, SortDirection: ""},
					{Label: "Actions", Sortable: false, SortDirection: ""},
				})
				
				<tbody class="bg-white divide-y divide-gray-200">
					<tr class="hover:bg-gray-50">
						<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
							John Doe
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
							Engineering
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
							Senior Developer
						</td>
						<td class="px-6 py-4 whitespace-nowrap">
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
								Active
							</span>
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
							<button 
								class="text-blue-600 hover:text-blue-900 focus:outline-none focus:ring-2 focus:ring-blue-500"
								aria-label="Edit John Doe">
								<i class="fas fa-edit" aria-hidden="true"></i>
							</button>
						</td>
					</tr>
					<tr class="hover:bg-gray-50">
						<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
							Jane Smith
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
							Marketing
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
							Marketing Manager
						</td>
						<td class="px-6 py-4 whitespace-nowrap">
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
								Away
							</span>
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
							<button 
								class="text-blue-600 hover:text-blue-900 focus:outline-none focus:ring-2 focus:ring-blue-500"
								aria-label="Edit Jane Smith">
								<i class="fas fa-edit" aria-hidden="true"></i>
							</button>
						</td>
					</tr>
				</tbody>
			}
		</section>

		<!-- Notifications Demo -->
		<section class="bg-white p-6 rounded-lg shadow" aria-labelledby="notifications-heading">
			<h2 id="notifications-heading" class="text-xl font-semibold text-gray-900 mb-4">
				Accessible Notifications
			</h2>
			
			<div class="space-y-4">
				@helpers.AccessibleNotification(&helpers.AccessibleNotificationConfig{
					Type:        "success",
					Title:       "Success",
					Dismissible: true,
				}) {
					Your changes have been saved successfully.
				}

				@helpers.AccessibleNotification(&helpers.AccessibleNotificationConfig{
					Type:        "warning",
					Title:       "Warning",
					Dismissible: true,
				}) {
					This action cannot be undone. Please proceed with caution.
				}

				@helpers.AccessibleNotification(&helpers.AccessibleNotificationConfig{
					Type:        "error",
					Title:       "Error",
					Dismissible: false,
				}) {
					There was an error processing your request. Please try again.
				}

				@helpers.AccessibleNotification(&helpers.AccessibleNotificationConfig{
					Type:        "info",
					Title:       "Information",
					Dismissible: true,
				}) {
					New features are available. Check out the latest updates.
				}
			</div>
		</section>

		<!-- Modal Demo -->
		<section class="bg-white p-6 rounded-lg shadow" aria-labelledby="modal-heading">
			<h2 id="modal-heading" class="text-xl font-semibold text-gray-900 mb-4">
				Accessible Modal Dialog
			</h2>
			
			<p class="text-gray-600 mb-4">
				Modal dialogs with proper focus management and keyboard navigation.
			</p>
			
			<button 
				onclick="showModal()"
				class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
				<i class="fas fa-window-restore mr-2" aria-hidden="true"></i>
				Open Modal
			</button>

			<!-- Hidden modal that would be shown via JavaScript -->
			<div id="demo-modal" class="hidden">
				@helpers.AccessibleModal(&helpers.AccessibleModalConfig{
					ID:          "demo-modal",
					Title:       "Demo Modal",
					Description: "This is an accessible modal dialog demonstrating proper ARIA attributes and focus management.",
				}) {
					<div class="space-y-4">
						<p class="text-gray-600">
							This modal demonstrates:
						</p>
						<ul class="list-disc list-inside space-y-2 text-gray-600">
							<li>Proper ARIA roles and properties</li>
							<li>Focus trap within modal</li>
							<li>Keyboard navigation (Tab, Shift+Tab, Escape)</li>
							<li>Screen reader announcements</li>
						</ul>
						<div class="flex justify-end space-x-3 mt-6">
							<button 
								onclick="closeModal()"
								class="bg-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-500">
								Cancel
							</button>
							<button 
								onclick="closeModal()"
								class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
								Confirm
							</button>
						</div>
					</div>
				}
			</div>
		</section>

		<!-- Progressive Enhancement Demo -->
		<section class="bg-white p-6 rounded-lg shadow" aria-labelledby="progressive-heading">
			<h2 id="progressive-heading" class="text-xl font-semibold text-gray-900 mb-4">
				Progressive Enhancement
			</h2>
			
			<div class="space-y-4">
				<!-- JavaScript-enhanced content -->
				<div class="js-only bg-green-50 border border-green-200 p-4 rounded-lg">
					<h3 class="text-green-800 font-medium mb-2">
						<i class="fas fa-check-circle mr-2" aria-hidden="true"></i>
						JavaScript Enhanced
					</h3>
					<p class="text-green-700">
						This content is only visible when JavaScript is enabled, demonstrating progressive enhancement.
					</p>
				</div>

				<!-- No-JavaScript fallback -->
				<div class="no-js-only bg-yellow-50 border border-yellow-200 p-4 rounded-lg">
					<h3 class="text-yellow-800 font-medium mb-2">
						<i class="fas fa-exclamation-triangle mr-2" aria-hidden="true"></i>
						Fallback Mode
					</h3>
					<p class="text-yellow-700">
						JavaScript is disabled. The site works but with reduced functionality.
					</p>
				</div>

				<!-- Always visible content -->
				<div class="bg-blue-50 border border-blue-200 p-4 rounded-lg">
					<h3 class="text-blue-800 font-medium mb-2">
						<i class="fas fa-info-circle mr-2" aria-hidden="true"></i>
						Core Functionality
					</h3>
					<p class="text-blue-700">
						This content is always visible and functional regardless of JavaScript availability.
					</p>
				</div>
			</div>
		</section>

		<!-- Keyboard Navigation Demo -->
		<section class="bg-white p-6 rounded-lg shadow" aria-labelledby="keyboard-heading">
			<h2 id="keyboard-heading" class="text-xl font-semibold text-gray-900 mb-4">
				Keyboard Navigation
			</h2>
			
			<div class="bg-gray-50 p-4 rounded-lg mb-4">
				<h3 class="font-medium text-gray-900 mb-2">Keyboard Shortcuts</h3>
				<dl class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
					<div class="flex justify-between">
						<dt class="text-gray-600">Navigate links/buttons:</dt>
						<dd class="font-mono bg-white px-2 py-1 rounded">Tab / Shift+Tab</dd>
					</div>
					<div class="flex justify-between">
						<dt class="text-gray-600">Activate element:</dt>
						<dd class="font-mono bg-white px-2 py-1 rounded">Enter / Space</dd>
					</div>
					<div class="flex justify-between">
						<dt class="text-gray-600">Close modal:</dt>
						<dd class="font-mono bg-white px-2 py-1 rounded">Escape</dd>
					</div>
					<div class="flex justify-between">
						<dt class="text-gray-600">Skip to content:</dt>
						<dd class="font-mono bg-white px-2 py-1 rounded">Tab (on page load)</dd>
					</div>
				</dl>
			</div>

			<p class="text-gray-600">
				All interactive elements are keyboard accessible and provide visible focus indicators.
			</p>
		</section>

		<!-- Screen Reader Information -->
		<section class="bg-white p-6 rounded-lg shadow" aria-labelledby="screen-reader-heading">
			<h2 id="screen-reader-heading" class="text-xl font-semibold text-gray-900 mb-4">
				Screen Reader Support
			</h2>
			
			<div class="space-y-4">
				<p class="text-gray-600">
					This application includes comprehensive screen reader support:
				</p>
				
				<ul class="list-disc list-inside space-y-2 text-gray-600">
					<li>Semantic HTML structure with proper heading hierarchy</li>
					<li>ARIA labels and descriptions for complex interactions</li>
					<li>Live regions for dynamic content updates</li>
					<li>Alternative text for images and icons</li>
					<li>Form labels and error announcements</li>
					<li>Table headers and captions</li>
				</ul>

				<div class="bg-purple-50 border border-purple-200 p-4 rounded-lg">
					<h3 class="text-purple-800 font-medium mb-2">
						<i class="fas fa-universal-access mr-2" aria-hidden="true"></i>
						Accessibility Standards
					</h3>
					<p class="text-purple-700 text-sm">
						This application follows WCAG 2.1 AA guidelines and is tested with popular screen readers including NVDA, JAWS, and VoiceOver.
					</p>
				</div>
			</div>
		</section>
	</div>

	<!-- JavaScript for modal demo -->
	<script>
		function showModal() {
			const modal = document.getElementById('demo-modal');
			modal.classList.remove('hidden');
			// Focus the first focusable element in modal
			const firstFocusable = modal.querySelector('button');
			if (firstFocusable) {
				firstFocusable.focus();
			}
		}

		function closeModal() {
			const modal = document.getElementById('demo-modal');
			modal.classList.add('hidden');
		}

		// Escape key to close modal
		document.addEventListener('keydown', function(e) {
			if (e.key === 'Escape') {
				const modal = document.getElementById('demo-modal');
				if (!modal.classList.contains('hidden')) {
					closeModal();
				}
			}
		});
	</script>
}