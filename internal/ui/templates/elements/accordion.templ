package elements

import "strings"

// AccordionItem represents a single accordion panel
type AccordionItem struct {
	ID          string `json:"id" validate:"required"`
	Title       string `json:"title" validate:"required"`
	Content     string `json:"content" validate:"required"`
	DefaultOpen bool   `json:"default_open"`
	Disabled    bool   `json:"disabled"`
}

// AccordionProps defines the properties for the Accordion component
type AccordionProps struct {
	Items        []AccordionItem `json:"items" validate:"required,min=1"`
	Flush        bool            `json:"flush"`        // Remove borders for flush design
	AlwaysOpen   bool            `json:"always_open"`  // Allow multiple panels open
	Collapsible  bool            `json:"collapsible"`  // Allow all panels to be closed
	ID           string          `json:"id"`
	Class        string          `json:"class"`
	AriaLabel    string          `json:"aria_label"`
}

// Accordion renders a Flowbite-styled accordion component
templ Accordion(props AccordionProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getAccordionClasses(props.Flush) + " " + props.Class }
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		x-data={ getAccordionData(props.Items, props.AlwaysOpen, props.Collapsible) }
	>
		for i, item := range props.Items {
			<div class={ getAccordionItemClasses(props.Flush, i == len(props.Items)-1) }>
				<!-- Accordion Header -->
				<h2 if !props.Flush {
					id={ "accordion-heading-" + item.ID }
				}>
					<button
						type="button"
						class={ getAccordionButtonClasses(props.Flush, item.Disabled) }
						if !item.Disabled {
							@click={ "togglePanel('" + item.ID + "')" }
						}
						aria-expanded={ getAriaExpanded(item.DefaultOpen) }
						aria-controls={ "accordion-body-" + item.ID }
						if item.Disabled {
							disabled
							aria-disabled="true"
						}
					>
						<span class={ getAccordionTitleClasses(item.Disabled) }>
							{ item.Title }
						</span>
						<!-- Accordion Icon -->
						<svg 
							class={ getAccordionIconClasses() }
							:class={ "{ 'rotate-180': openPanels.includes('" + item.ID + "') }" }
							aria-hidden="true" 
							xmlns="http://www.w3.org/2000/svg" 
							fill="none" 
							viewBox="0 0 10 6"
						>
							<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5 5 1 1 5"/>
						</svg>
					</button>
				</h2>
				
				<!-- Accordion Body -->
				<div
					id={ "accordion-body-" + item.ID }
					x-show={ "openPanels.includes('" + item.ID + "')" }
					x-collapse
					aria-labelledby={ "accordion-heading-" + item.ID }
					class={ getAccordionBodyClasses(props.Flush) }
				>
					<div class={ getAccordionContentClasses(props.Flush) }>
						{ item.Content }
					</div>
				</div>
			</div>
		}
	</div>
}

// Helper functions for accordion styling
func getAccordionClasses(flush bool) string {
	if flush {
		return "border-gray-200 dark:border-gray-700"
	}
	return ""
}

func getAccordionItemClasses(flush bool, isLast bool) string {
	if flush {
		if isLast {
			return "border-b border-gray-200 dark:border-gray-700"
		}
		return "border-b border-gray-200 dark:border-gray-700"
	}
	
	base := "border border-gray-200 dark:border-gray-700"
	if isLast {
		return base + " rounded-b-lg"
	}
	return base + " border-b-0 first:rounded-t-lg"
}

func getAccordionButtonClasses(flush bool, disabled bool) string {
	base := "flex items-center justify-between w-full font-medium text-left"
	
	var spacing string
	if flush {
		spacing = "py-5"
	} else {
		spacing = "p-5"
	}
	
	var interactive string
	if disabled {
		interactive = "text-gray-400 cursor-not-allowed dark:text-gray-600"
	} else {
		interactive = "text-gray-500 hover:bg-gray-100 focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-800 dark:text-gray-400 dark:hover:bg-gray-800"
	}
	
	return strings.Join([]string{base, spacing, interactive}, " ")
}

func getAccordionTitleClasses(disabled bool) string {
	if disabled {
		return "text-gray-400 dark:text-gray-600"
	}
	return "text-gray-900 dark:text-white"
}

func getAccordionIconClasses() string {
	return "w-3 h-3 transform transition-transform duration-200 shrink-0"
}

func getAccordionBodyClasses(flush bool) string {
	if flush {
		return ""
	}
	return "border-b border-gray-200 dark:border-gray-700"
}

func getAccordionContentClasses(flush bool) string {
	if flush {
		return "pb-5 text-gray-500 dark:text-gray-400"
	}
	return "p-5 text-gray-500 dark:text-gray-400"
}

func getAriaExpanded(defaultOpen bool) string {
	if defaultOpen {
		return "true"
	}
	return "false"
}

func getAccordionData(items []AccordionItem, alwaysOpen bool, collapsible bool) string {
	openPanels := "["
	for i, item := range items {
		if item.DefaultOpen {
			if i > 0 {
				openPanels += ", "
			}
			openPanels += "'" + item.ID + "'"
		}
	}
	openPanels += "]"
	
	data := "{ "
	data += "openPanels: " + openPanels + ", "
	data += "alwaysOpen: " + getBoolString(alwaysOpen) + ", "
	data += "collapsible: " + getBoolString(collapsible) + ", "
	data += "togglePanel(panelId) { "
	
	if alwaysOpen {
		// Multiple panels can be open
		data += "if (this.openPanels.includes(panelId)) { "
		if collapsible {
			data += "this.openPanels = this.openPanels.filter(id => id !== panelId); "
		}
		data += "} else { "
		data += "this.openPanels.push(panelId); "
		data += "} "
	} else {
		// Only one panel can be open (accordion behavior)
		data += "if (this.openPanels.includes(panelId)) { "
		if collapsible {
			data += "this.openPanels = []; "
		}
		data += "} else { "
		data += "this.openPanels = [panelId]; "
		data += "} "
	}
	
	data += "} }"
	
	return data
}

func getBoolString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}