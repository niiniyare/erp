package elements

import (
	"strings"
	"strconv"
)

// ProgressBarProps defines properties for individual progress bars
type ProgressBarProps struct {
	Value       float64 `json:"value" validate:"min=0,max=100"`                       // Progress value (0-100)
	Color       string  `json:"color" validate:"oneof=blue gray red green yellow indigo purple pink"` // Color variant
	Label       string  `json:"label"`                                                // Label text
	ShowPercent bool    `json:"show_percent"`                                         // Show percentage
}

// ProgressProps defines the properties for the Progress component
type ProgressProps struct {
	Bars        []ProgressBarProps `json:"bars" validate:"required,min=1"`           // Progress bars (for multi-bar)
	Value       float64            `json:"value" validate:"min=0,max=100"`           // Single bar value
	Color       string             `json:"color" validate:"oneof=blue gray red green yellow indigo purple pink"` // Single bar color
	Size        string             `json:"size" validate:"oneof=xs sm base lg xl"`   // Size variant
	Label       string             `json:"label"`                                    // Label text
	ShowPercent bool               `json:"show_percent"`                             // Show percentage
	Striped     bool               `json:"striped"`                                  // Striped pattern
	Animated    bool               `json:"animated"`                                 // Animated stripes
	ID          string             `json:"id"`
	Class       string             `json:"class"`
	AriaLabel   string             `json:"aria_label"`
}

// Progress renders a Flowbite-styled progress component
templ Progress(props ProgressProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ props.Class }
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
	>
		<!-- Progress Label -->
		if props.Label != "" || (props.ShowPercent && len(props.Bars) <= 1) {
			<div class="flex justify-between mb-1">
				if props.Label != "" {
					<span class="text-base font-medium text-blue-700 dark:text-white">
						{ props.Label }
					</span>
				}
				if props.ShowPercent && len(props.Bars) <= 1 {
					<span class="text-sm font-medium text-blue-700 dark:text-white">
						{ getProgressPercentage(props.Value) }%
					</span>
				}
			</div>
		}
		
		<!-- Progress Bar Container -->
		<div class={ getProgressContainerClasses(props.Size) }>
			if len(props.Bars) > 1 {
				<!-- Multiple Progress Bars -->
				for _, bar := range props.Bars {
					<div 
						class={ getProgressBarClasses(bar.Color, props.Striped, props.Animated) }
						style={ "width: " + getProgressPercentage(bar.Value) + "%" }
						role="progressbar"
						aria-valuenow={ getProgressPercentage(bar.Value) }
						aria-valuemin="0"
						aria-valuemax="100"
						if bar.Label != "" {
							aria-label={ bar.Label }
						}
					>
						if bar.ShowPercent {
							<span class={ getProgressTextClasses() }>
								{ getProgressPercentage(bar.Value) }%
							</span>
						}
					</div>
				}
			} else {
				<!-- Single Progress Bar -->
				<div 
					class={ getProgressBarClasses(props.Color, props.Striped, props.Animated) }
					style={ "width: " + getProgressPercentage(props.Value) + "%" }
					role="progressbar"
					aria-valuenow={ getProgressPercentage(props.Value) }
					aria-valuemin="0"
					aria-valuemax="100"
					if props.Label != "" {
						aria-label={ props.Label }
					}
				>
					if props.ShowPercent {
						<span class={ getProgressTextClasses() }>
							{ getProgressPercentage(props.Value) }%
						</span>
					}
				</div>
			}
		</div>
	</div>
}

// ProgressCircular renders a circular progress indicator
templ ProgressCircular(props ProgressProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ "relative " + props.Class }
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
	>
		<svg class={ getCircularProgressClasses(props.Size) } aria-hidden="true">
			<!-- Background circle -->
			<circle 
				cx="50%" 
				cy="50%" 
				r={ getCircularRadius(props.Size) }
				stroke="currentColor" 
				stroke-width={ getCircularStrokeWidth(props.Size) }
				fill="transparent" 
				class="text-gray-200 dark:text-gray-700"
			></circle>
			<!-- Progress circle -->
			<circle 
				cx="50%" 
				cy="50%" 
				r={ getCircularRadius(props.Size) }
				stroke="currentColor" 
				stroke-width={ getCircularStrokeWidth(props.Size) }
				fill="transparent" 
				stroke-dasharray={ getCircularDashArray(props.Size) }
				stroke-dashoffset={ getCircularDashOffset(props.Size, props.Value) }
				stroke-linecap="round" 
				class={ getCircularProgressColor(props.Color) }
				style="transform: rotate(-90deg); transform-origin: 50% 50%;"
			></circle>
		</svg>
		
		<!-- Center content -->
		<div class="absolute inset-0 flex items-center justify-center">
			if props.ShowPercent {
				<span class={ getCircularTextClasses(props.Size) }>
					{ getProgressPercentage(props.Value) }%
				</span>
			} else if props.Label != "" {
				<span class={ getCircularTextClasses(props.Size) }>
					{ props.Label }
				</span>
			}
		</div>
	</div>
}

// Helper functions for progress styling
func getProgressContainerClasses(size string) string {
	base := "w-full bg-gray-200 rounded-full dark:bg-gray-700"
	
	switch size {
	case "xs":
		return base + " h-1"
	case "sm":
		return base + " h-1.5"
	case "lg":
		return base + " h-4"
	case "xl":
		return base + " h-6"
	default: // base
		return base + " h-2.5"
	}
}

func getProgressBarClasses(color string, striped, animated bool) string {
	base := "h-full rounded-full transition-all duration-300"
	
	// Color classes
	var colorClass string
	switch color {
	case "blue":
		colorClass = "bg-blue-600 dark:bg-blue-500"
	case "gray":
		colorClass = "bg-gray-600 dark:bg-gray-400"
	case "red":
		colorClass = "bg-red-600 dark:bg-red-500"
	case "green":
		colorClass = "bg-green-600 dark:bg-green-500"
	case "yellow":
		colorClass = "bg-yellow-400 dark:bg-yellow-300"
	case "indigo":
		colorClass = "bg-indigo-600 dark:bg-indigo-500"
	case "purple":
		colorClass = "bg-purple-600 dark:bg-purple-500"
	case "pink":
		colorClass = "bg-pink-600 dark:bg-pink-500"
	default: // blue
		colorClass = "bg-blue-600 dark:bg-blue-500"
	}
	
	var patternClass string
	if striped {
		patternClass = "bg-gradient-to-r from-transparent via-white to-transparent bg-[length:30px_100%] opacity-20"
		if animated {
			patternClass += " animate-pulse"
		}
	}
	
	classes := []string{base, colorClass}
	if patternClass != "" {
		classes = append(classes, patternClass)
	}
	
	return strings.Join(classes, " ")
}

func getProgressTextClasses() string {
	return "px-2 text-xs font-medium text-white leading-none text-center"
}

func getCircularProgressClasses(size string) string {
	switch size {
	case "xs":
		return "w-8 h-8"
	case "sm":
		return "w-10 h-10"
	case "lg":
		return "w-16 h-16"
	case "xl":
		return "w-20 h-20"
	default: // base
		return "w-12 h-12"
	}
}

func getCircularRadius(size string) string {
	switch size {
	case "xs":
		return "12"
	case "sm":
		return "16"
	case "lg":
		return "28"
	case "xl":
		return "36"
	default: // base
		return "20"
	}
}

func getCircularStrokeWidth(size string) string {
	switch size {
	case "xs":
		return "2"
	case "sm":
		return "2"
	case "lg":
		return "3"
	case "xl":
		return "4"
	default: // base
		return "2"
	}
}

func getCircularProgressColor(color string) string {
	switch color {
	case "blue":
		return "text-blue-600 dark:text-blue-500"
	case "gray":
		return "text-gray-600 dark:text-gray-400"
	case "red":
		return "text-red-600 dark:text-red-500"
	case "green":
		return "text-green-600 dark:text-green-500"
	case "yellow":
		return "text-yellow-400 dark:text-yellow-300"
	case "indigo":
		return "text-indigo-600 dark:text-indigo-500"
	case "purple":
		return "text-purple-600 dark:text-purple-500"
	case "pink":
		return "text-pink-600 dark:text-pink-500"
	default: // blue
		return "text-blue-600 dark:text-blue-500"
	}
}

func getCircularTextClasses(size string) string {
	base := "font-medium text-gray-800 dark:text-white"
	
	switch size {
	case "xs":
		return base + " text-xs"
	case "sm":
		return base + " text-xs"
	case "lg":
		return base + " text-sm"
	case "xl":
		return base + " text-base"
	default: // base
		return base + " text-xs"
	}
}

func getCircularDashArray(size string) string {
	switch size {
	case "xs":
		return "75.4" // 2 * π * 12
	case "sm":
		return "100.5" // 2 * π * 16
	case "lg":
		return "175.9" // 2 * π * 28
	case "xl":
		return "226.2" // 2 * π * 36
	default: // base
		return "125.7" // 2 * π * 20
	}
}

func getCircularDashOffset(size string, value float64) string {
	circumference := getCircularDashArray(size)
	circumferenceFloat, _ := strconv.ParseFloat(circumference, 64)
	offset := circumferenceFloat - (value / 100.0 * circumferenceFloat)
	return strconv.FormatFloat(offset, 'f', 1, 64)
}

func getProgressPercentage(value float64) string {
	if value < 0 {
		return "0"
	}
	if value > 100 {
		return "100"
	}
	return strconv.FormatFloat(value, 'f', 0, 64)
}