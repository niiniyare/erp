package console

import (
	"fmt"
	"github.com/niiniyare/erp/internal/ui/types"
)

templ DashboardPage(data types.DashboardData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ data.Title }</title>
		<script src="https://unpkg.com/htmx.org@1.9.6"></script>
		<script src="https://cdn.tailwindcss.com"></script>
		<meta name="csrf-token" content={ data.CSRFToken }/>
	</head>
	<body class="bg-gray-50">
		@DashboardLayout(data) {
			<div class="space-y-6">
				<!-- Welcome Section -->
				<div class="bg-white shadow rounded-lg p-6">
					<h1 class="text-2xl font-bold text-gray-900">
						Welcome back, { data.User.Name }
					</h1>
					<p class="mt-1 text-sm text-gray-600">
						Last login: { data.User.Role } • Tenant: { data.User.TenantID }
					</p>
				</div>

				<!-- System Stats -->
				<div id="system-stats" hx-get="/console/api/stats" hx-trigger="load, every 30s">
					@SystemStatsComponent(data.SystemStats)
				</div>

				<!-- Quick Actions -->
				<div class="bg-white shadow rounded-lg p-6">
					<h2 class="text-lg font-medium text-gray-900 mb-4">Quick Actions</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
						for _, action := range data.QuickActions {
							@QuickActionCard(action)
						}
					</div>
				</div>

				<!-- Recent Activity -->
				<div class="bg-white shadow rounded-lg p-6">
					<div class="flex items-center justify-between mb-4">
						<h2 class="text-lg font-medium text-gray-900">Recent Activity</h2>
						<button 
							hx-get="/console/api/activity" 
							hx-target="#recent-activity"
							class="text-sm text-indigo-600 hover:text-indigo-500"
						>
							Refresh
						</button>
					</div>
					<div id="recent-activity">
						@RecentActivityComponent(data.RecentActivity)
					</div>
				</div>
			</div>
		}
	</body>
	</html>
}

templ DashboardLayout(data types.DashboardData) {
	<div class="min-h-screen bg-gray-50">
		<!-- Navigation -->
		<nav class="bg-white shadow-sm border-b border-gray-200">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between h-16">
					<div class="flex items-center">
						<h1 class="text-xl font-semibold text-gray-900">Admin Console</h1>
					</div>
					<div class="flex items-center space-x-4">
						<!-- Notifications -->
						<div class="relative">
							<button class="p-2 text-gray-400 hover:text-gray-500">
								<span class="sr-only">View notifications</span>
								🔔
								if len(data.Notifications) > 0 {
									<span class="absolute top-0 right-0 block h-2 w-2 rounded-full bg-red-400"></span>
								}
							</button>
						</div>
						
						<!-- User Menu -->
						<div class="relative">
							<button class="flex items-center text-sm text-gray-700 hover:text-gray-900">
								<span>{ data.User.Name }</span>
								<span class="ml-2">▼</span>
							</button>
							<!-- Dropdown would go here -->
						</div>
						
						<!-- Logout -->
						<button 
							hx-post="/console/auth/logout"
							class="text-sm text-gray-500 hover:text-gray-700"
						>
							Logout
						</button>
					</div>
				</div>
			</div>
		</nav>

		<!-- Main Content -->
		<main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
			{ children... }
		</main>
	</div>
}

templ SystemStatsComponent(stats types.SystemStats) {
	<div class="bg-white shadow rounded-lg p-6">
		<h2 class="text-lg font-medium text-gray-900 mb-4">System Overview</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
			<div class="bg-blue-50 p-4 rounded-lg">
				<div class="text-2xl font-bold text-blue-600">{ fmt.Sprintf("%d", stats.TotalTenants) }</div>
				<div class="text-sm text-blue-600">Total Tenants</div>
			</div>
			<div class="bg-green-50 p-4 rounded-lg">
				<div class="text-2xl font-bold text-green-600">{ fmt.Sprintf("%d", stats.ActiveUsers) }</div>
				<div class="text-sm text-green-600">Active Users</div>
			</div>
			<div class="bg-purple-50 p-4 rounded-lg">
				<div class="text-2xl font-bold text-purple-600">{ fmt.Sprintf("%d", stats.TotalTransactions) }</div>
				<div class="text-sm text-purple-600">Total Transactions</div>
			</div>
			<div class="bg-yellow-50 p-4 rounded-lg">
				<div class="text-2xl font-bold text-yellow-600">{ stats.SystemHealth }</div>
				<div class="text-sm text-yellow-600">System Status</div>
			</div>
		</div>
	</div>
}

templ QuickActionCard(action types.QuickAction) {
	<a 
		href={ templ.URL(action.URL) }
		class="block p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors"
	>
		<div class="flex items-start">
			<div class="flex-shrink-0">
				<span class="text-2xl">
					if action.Icon == "building" {
						🏢
					} else if action.Icon == "users" {
						👥
					} else if action.Icon == "settings" {
						⚙️
					} else if action.Icon == "shield" {
						🛡️
					} else if action.Icon == "chart" {
						📊
					} else {
						📋
					}
				</span>
			</div>
			<div class="ml-3">
				<h3 class="text-sm font-medium text-gray-900">{ action.Title }</h3>
				<p class="mt-1 text-sm text-gray-500">{ action.Description }</p>
			</div>
		</div>
	</a>
}

templ RecentActivityComponent(activities []types.ActivityItem) {
	<div class="space-y-3">
		for _, activity := range activities {
			<div class="flex items-start space-x-3 py-2">
				<div class="flex-shrink-0">
					if activity.Severity == "error" {
						<span class="inline-block h-2 w-2 rounded-full bg-red-400"></span>
					} else if activity.Severity == "warning" {
						<span class="inline-block h-2 w-2 rounded-full bg-yellow-400"></span>
					} else {
						<span class="inline-block h-2 w-2 rounded-full bg-green-400"></span>
					}
				</div>
				<div class="flex-1 min-w-0">
					<p class="text-sm text-gray-900">{ activity.Description }</p>
					<p class="text-sm text-gray-500">
						{ activity.UserName } • { activity.Timestamp.Format("Jan 2, 2006 3:04 PM") }
					</p>
				</div>
			</div>
		}
		
		if len(activities) == 0 {
			<p class="text-sm text-gray-500 text-center py-4">No recent activity</p>
		}
	</div>
}