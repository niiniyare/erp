package forms

import (
	"github.com/niiniyare/erp/internal/ui/types"
	"github.com/niiniyare/erp/internal/ui/templates/components"
)

// TenantForm renders the tenant creation/edit form with real-time validation
templ TenantForm(data types.CreateTenantPageData) {
	@components.FormModal(types.FormModalProps{
		ID:         "tenant-form-modal",
		Title:      func() string { if data.Tenant.ID == "" { return "Create New Tenant" } else { return "Edit Tenant" } }(),
		Subtitle:   "Configure tenant settings and access permissions",
		Size:       "lg",
		FormID:     "tenant-form",
		SubmitText: func() string { if data.Tenant.ID == "" { return "Create Tenant" } else { return "Update Tenant" } }(),
		ActionURL:  func() string { if data.Tenant.ID == "" { return "/console/tenants" } else { return "/console/tenants/" + data.Tenant.ID } }(),
		Target:     "#main-content",
		Swap:       "innerHTML",
	}) {
		<div 
			class="space-y-6"
			x-data="tenantForm()"
			x-init="initForm()">
			
			<!-- Hidden fields -->
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			if data.Tenant.ID != "" {
				<input type="hidden" name="tenant_id" value={ data.Tenant.ID }/>
				<input type="hidden" name="_method" value="PUT"/>
			}
			
			<!-- Basic Information Section -->
			<div>
				<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">
					Basic Information
				</h3>
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
					<!-- Tenant Name -->
					@components.BaseInput(types.InputProps{
						ID:              "tenant-name",
						Name:            "name",
						Type:            "text",
						Label:           "Tenant Name",
						Value:           data.Form.Name,
						Placeholder:     "Enter tenant name",
						Required:        true,
						ValidateOnInput: true,
						ValidationURL:   "/validate/tenant-name",
						FormID:          "tenant-form",
						HelpText:        "This will be displayed as the organization name",
					})
					
					<!-- Email -->
					@components.BaseInput(types.InputProps{
						ID:              "tenant-email",
						Name:            "email",
						Type:            "email",
						Label:           "Primary Email",
						Value:           data.Form.Email,
						Placeholder:     "admin@company.com",
						Required:        true,
						ValidateOnInput: true,
						ValidationURL:   "/validate/email",
						FormID:          "tenant-form",
						HelpText:        "Primary contact email for this tenant",
					})
				</div>
			</div>
			
			<!-- Subdomain Section -->
			<div>
				<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">
					Subdomain Configuration
				</h3>
				<div class="grid grid-cols-1 gap-6">
					<!-- Subdomain -->
					<div class="relative">
						@components.BaseInput(types.InputProps{
							ID:              "tenant-subdomain",
							Name:            "subdomain",
							Type:            "text",
							Label:           "Subdomain",
							Value:           func() string { if data.Form.Subdomain != nil { return *data.Form.Subdomain } else { return "" } }(),
							Placeholder:     "mycompany",
							ValidateOnInput: true,
							ValidationURL:   "/validate/subdomain",
							FormID:          "tenant-form",
							HelpText:        "This will be used as: mycompany.erp-system.com",
						})
						
						<!-- Subdomain Preview -->
						<div 
							class="mt-2 p-3 bg-gray-50 dark:bg-gray-800 rounded-lg border"
							x-show="$el.closest('form').subdomain && $el.closest('form').subdomain.value">
							<div class="flex items-center space-x-2">
								<i class="fas fa-globe text-gray-400"></i>
								<span class="text-sm text-gray-600 dark:text-gray-400">
									Your tenant will be accessible at: 
								</span>
								<strong 
									class="text-blue-600 dark:text-blue-400"
									x-text="($el.closest('form').subdomain?.value || 'subdomain') + '.erp-system.com'">
								</strong>
							</div>
						</div>
					</div>
				</div>
			</div>
			
			<!-- Organization Details Section -->
			<div>
				<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">
					Organization Details
				</h3>
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
					<!-- Industry -->
					@components.SelectInput(types.SelectProps{
						ID:          "tenant-industry",
						Name:        "industry",
						Label:       "Industry",
						Required:    true,
						Placeholder: "Select industry",
						Options:     data.Industries,
						HelpText:    "Select the primary industry for this organization",
					})
					
					<!-- Company Size -->
					@components.SelectInput(types.SelectProps{
						ID:          "tenant-company-size",
						Name:        "company_size",
						Label:       "Company Size",
						Required:    true,
						Placeholder: "Select company size",
						Options:     data.CompanySizes,
						HelpText:    "Number of employees in the organization",
					})
				</div>
			</div>
			
			<!-- Advanced Settings Section -->
			<div x-data="{ showAdvanced: false }">
				<button 
					type="button"
					@click="showAdvanced = !showAdvanced"
					class="flex items-center space-x-2 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300">
					<i 
						class="fas fa-chevron-right transition-transform duration-200"
						:class="{ 'rotate-90': showAdvanced }">
					</i>
					<span>Advanced Settings</span>
				</button>
				
				<div 
					x-show="showAdvanced"
					x-transition:enter="transition ease-out duration-200"
					x-transition:enter-start="opacity-0 max-h-0"
					x-transition:enter-end="opacity-100 max-h-96"
					x-transition:leave="transition ease-in duration-200"
					x-transition:leave-start="opacity-100 max-h-96"
					x-transition:leave-end="opacity-0 max-h-0"
					class="mt-4 space-y-6 overflow-hidden"
					style="display: none;">
					
					<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
						<!-- Timezone -->
						@components.SelectInput(types.SelectProps{
							ID:          "tenant-timezone",
							Name:        "timezone",
							Label:       "Default Timezone",
							Placeholder: "Select timezone",
							Options:     []types.SelectOption{
								{Value: "UTC", Label: "UTC"},
								{Value: "America/New_York", Label: "Eastern Time (ET)"},
								{Value: "America/Chicago", Label: "Central Time (CT)"},
								{Value: "America/Denver", Label: "Mountain Time (MT)"},
								{Value: "America/Los_Angeles", Label: "Pacific Time (PT)"},
								{Value: "Europe/London", Label: "Greenwich Mean Time (GMT)"},
								{Value: "Europe/Paris", Label: "Central European Time (CET)"},
							},
							HelpText: "Default timezone for this tenant",
						})
						
						<!-- Currency -->
						@components.SelectInput(types.SelectProps{
							ID:          "tenant-currency",
							Name:        "currency",
							Label:       "Default Currency",
							Placeholder: "Select currency",
							Options:     []types.SelectOption{
								{Value: "USD", Label: "US Dollar (USD)"},
								{Value: "EUR", Label: "Euro (EUR)"},
								{Value: "GBP", Label: "British Pound (GBP)"},
								{Value: "CAD", Label: "Canadian Dollar (CAD)"},
								{Value: "AUD", Label: "Australian Dollar (AUD)"},
								{Value: "JPY", Label: "Japanese Yen (JPY)"},
							},
							HelpText: "Default currency for financial transactions",
						})
					</div>
					
					<!-- Feature Flags -->
					<div>
						<h4 class="text-base font-medium text-gray-900 dark:text-white mb-3">
							Feature Access
						</h4>
						<div class="space-y-3">
							@components.CheckboxInput(types.CheckboxProps{
								ID:       "feature-analytics",
								Name:     "features[]",
								Value:    "analytics",
								Label:    "Advanced Analytics",
								HelpText: "Enable advanced reporting and analytics features",
							})
							
							@components.CheckboxInput(types.CheckboxProps{
								ID:       "feature-api",
								Name:     "features[]",
								Value:    "api_access",
								Label:    "API Access",
								HelpText: "Allow this tenant to access REST and GraphQL APIs",
							})
							
							@components.CheckboxInput(types.CheckboxProps{
								ID:       "feature-integrations",
								Name:     "features[]",
								Value:    "integrations",
								Label:    "Third-party Integrations",
								HelpText: "Enable integrations with external services",
							})
							
							@components.CheckboxInput(types.CheckboxProps{
								ID:       "feature-custom-branding",
								Name:     "features[]",
								Value:    "custom_branding",
								Label:    "Custom Branding",
								HelpText: "Allow custom logos, colors, and branding",
							})
						</div>
					</div>
				</div>
			</div>
			
			<!-- Error Display -->
			if data.Error != "" {
				<div class="bg-red-50 dark:bg-red-900 border border-red-200 dark:border-red-700 rounded-lg p-4">
					<div class="flex">
						<div class="flex-shrink-0">
							<i class="fas fa-exclamation-circle h-5 w-5 text-red-400"></i>
						</div>
						<div class="ml-3">
							<h3 class="text-sm font-medium text-red-800 dark:text-red-200">
								Validation Error
							</h3>
							<div class="mt-2 text-sm text-red-700 dark:text-red-300">
								{ data.Error }
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
}

