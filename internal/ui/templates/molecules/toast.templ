package molecules

import (
	"strings"
	"strconv"
)

// ToastProps defines the properties for individual toast notifications
type ToastProps struct {
	ID          string `json:"id" validate:"required"`
	Title       string `json:"title"`
	Message     string `json:"message" validate:"required"`
	Type        string `json:"type" validate:"oneof=info success warning error"`
	Duration    int    `json:"duration"` // Duration in milliseconds, 0 for persistent
	Dismissible bool   `json:"dismissible"`
	Icon        bool   `json:"icon"`
	Actions     []ToastAction `json:"actions"`
	Position    string `json:"position" validate:"oneof=top-left top-right bottom-left bottom-right top-center bottom-center"`
}

// ToastAction defines action buttons in toast notifications
type ToastAction struct {
	Text    string `json:"text" validate:"required"`
	Action  string `json:"action"` // dismiss, custom
	Variant string `json:"variant" validate:"oneof=primary secondary"`
}

// ToastContainerProps defines the container for all toasts
type ToastContainerProps struct {
	Position string `json:"position" validate:"oneof=top-left top-right bottom-left bottom-right top-center bottom-center"`
	MaxToasts int   `json:"max_toasts"` // Maximum number of toasts to show
	ID       string `json:"id"`
	Class    string `json:"class"`
}

// Toast renders a single toast notification
templ Toast(props ToastProps) {
	<div
		id={ props.ID }
		class={ getToastClasses(props.Type) }
		role="alert"
		x-data={ getToastData(props.Duration, props.Dismissible) }
		x-show="show"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 transform translate-y-2"
		x-transition:enter-end="opacity-100 transform translate-y-0"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100 transform translate-y-0"
		x-transition:leave-end="opacity-0 transform translate-y-2"
		@toast-dismiss.window={ "if ($event.detail === '" + props.ID + "') dismissToast()" }
	>
		<div class={ getToastContentClasses() }>
			<!-- Icon -->
			if props.Icon {
				<div class={ getToastIconClasses() }>
					if props.Type == "success" {
						@ToastSuccessIcon()
					} else if props.Type == "warning" {
						@ToastWarningIcon()
					} else if props.Type == "error" {
						@ToastErrorIcon()
					} else {
						@ToastInfoIcon()
					}
				</div>
			}

			<!-- Content -->
			<div class={ getToastTextClasses() }>
				if props.Title != "" {
					<div class={ getToastTitleClasses() }>
						{ props.Title }
					</div>
				}
				<div class={ getToastMessageClasses() }>
					{ props.Message }
				</div>

				<!-- Actions -->
				if len(props.Actions) > 0 {
					<div class={ getToastActionsClasses() }>
						for _, action := range props.Actions {
							<button
								type="button"
								class={ getToastActionClasses(action.Variant) }
								if action.Action == "dismiss" {
									@click="dismissToast()"
								}
							>
								{ action.Text }
							</button>
						}
					</div>
				}
			</div>

			<!-- Dismiss button -->
			if props.Dismissible {
				<button
					type="button"
					class={ getToastDismissClasses() }
					@click="dismissToast()"
					aria-label="Close notification"
				>
					<svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
						<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
					</svg>
					<span class="sr-only">Close notification</span>
				</button>
			}
		</div>
	</div>
}

// ToastContainer renders a container for managing multiple toasts
templ ToastContainer(props ToastContainerProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getToastContainerClasses(props.Position) + " " + props.Class }
		x-data={ getToastContainerData(props.MaxToasts) }
		@toast-add.window="addToast($event.detail)"
		@toast-remove.window="removeToast($event.detail)"
		@toast-clear.window="clearToasts()"
	>
		<template x-for="toast in toasts" :key="toast.id">
			<div
				class={ getToastItemClasses() }
				x-show="toast.show"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 transform translate-y-2"
				x-transition:enter-end="opacity-100 transform translate-y-0"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 transform translate-y-0"
				x-transition:leave-end="opacity-0 transform translate-y-2"
			>
				<!-- Toast content will be injected here -->
				<div x-html="toast.html"></div>
			</div>
		</template>
	</div>
}

// Toast icon templates
templ ToastInfoIcon() {
	<svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
		<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
	</svg>
}

templ ToastSuccessIcon() {
	<svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
		<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z"/>
	</svg>
}

templ ToastWarningIcon() {
	<svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
		<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM10 15a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm0-4a1 1 0 0 1-1-1V6a1 1 0 0 1 2 0v4a1 1 0 0 1-1 1Z"/>
	</svg>
}

templ ToastErrorIcon() {
	<svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
		<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 11.793a1 1 0 1 1-1.414 1.414L10 11.414l-2.293 2.293a1 1 0 0 1-1.414-1.414L8.586 10 6.293 7.707a1 1 0 0 1 1.414-1.414L10 8.586l2.293-2.293a1 1 0 0 1 1.414 1.414L11.414 10l2.293 2.293Z"/>
	</svg>
}

// Helper functions for toast styling
func getToastData(duration int, dismissible bool) string {
	durationStr := "0"
	if duration > 0 {
		durationStr = strconv.Itoa(duration)
	}
	
	return `{
		show: true,
		init() {
			` + func() string {
				if duration > 0 {
					return `setTimeout(() => {
						if (this.show) this.dismissToast();
					}, ` + durationStr + `);`
				}
				return ""
			}() + `
		},
		dismissToast() {
			this.show = false;
			setTimeout(() => {
				this.$el.remove();
			}, 200);
		}
	}`
}

func getToastContainerData(maxToasts int) string {
	maxStr := "5"
	if maxToasts > 0 {
		maxStr = strconv.Itoa(maxToasts)
	}
	
	return `{
		toasts: [],
		maxToasts: ` + maxStr + `,
		addToast(toast) {
			if (this.toasts.length >= this.maxToasts) {
				this.toasts.shift();
			}
			this.toasts.push({
				...toast,
				show: true,
				id: toast.id || Date.now()
			});
		},
		removeToast(id) {
			const index = this.toasts.findIndex(t => t.id === id);
			if (index !== -1) {
				this.toasts[index].show = false;
				setTimeout(() => {
					this.toasts.splice(index, 1);
				}, 200);
			}
		},
		clearToasts() {
			this.toasts.forEach(toast => toast.show = false);
			setTimeout(() => {
				this.toasts = [];
			}, 200);
		}
	}`
}

func getToastClasses(toastType string) string {
	base := "flex w-full max-w-xs p-4 mb-4 text-gray-500 bg-white rounded-lg shadow dark:text-gray-400 dark:bg-gray-800"
	
	var typeClass string
	switch toastType {
	case "success":
		typeClass = "border-l-4 border-green-500"
	case "warning":
		typeClass = "border-l-4 border-yellow-500"
	case "error":
		typeClass = "border-l-4 border-red-500"
	default: // info
		typeClass = "border-l-4 border-blue-500"
	}
	
	return strings.Join([]string{base, typeClass}, " ")
}

func getToastContentClasses() string {
	return "flex items-center w-full"
}

func getToastIconClasses() string {
	return "inline-flex items-center justify-center flex-shrink-0 w-8 h-8 rounded-lg"
}

func getToastTextClasses() string {
	return "ml-3 text-sm font-normal flex-1"
}

func getToastTitleClasses() string {
	return "text-sm font-semibold text-gray-900 dark:text-white mb-1"
}

func getToastMessageClasses() string {
	return "text-sm font-normal"
}

func getToastActionsClasses() string {
	return "flex space-x-2 mt-2"
}

func getToastActionClasses(variant string) string {
	base := "text-xs font-medium px-2 py-1 rounded focus:outline-none focus:ring-2 transition-colors duration-200"
	
	switch variant {
	case "primary":
		return base + " text-white bg-blue-600 hover:bg-blue-700 focus:ring-blue-300 dark:bg-blue-500 dark:hover:bg-blue-600"
	default: // secondary
		return base + " text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-900 focus:ring-gray-200 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-600 dark:hover:bg-gray-600 dark:hover:text-white"
	}
}

func getToastDismissClasses() string {
	return "ml-auto -mx-1.5 -my-1.5 bg-white text-gray-400 hover:text-gray-900 rounded-lg focus:ring-2 focus:ring-gray-300 p-1.5 hover:bg-gray-100 inline-flex items-center justify-center h-8 w-8 dark:text-gray-500 dark:hover:text-white dark:bg-gray-800 dark:hover:bg-gray-700"
}

func getToastContainerClasses(position string) string {
	base := "fixed z-50 flex flex-col space-y-2"
	
	var positionClass string
	switch position {
	case "top-left":
		positionClass = "top-5 left-5"
	case "top-right":
		positionClass = "top-5 right-5"
	case "bottom-left":
		positionClass = "bottom-5 left-5"
	case "bottom-right":
		positionClass = "bottom-5 right-5"
	case "top-center":
		positionClass = "top-5 left-1/2 transform -translate-x-1/2"
	case "bottom-center":
		positionClass = "bottom-5 left-1/2 transform -translate-x-1/2"
	default: // top-right
		positionClass = "top-5 right-5"
	}
	
	return strings.Join([]string{base, positionClass}, " ")
}

func getToastItemClasses() string {
	return "w-full max-w-xs"
}

// Toast store initialization script for Alpine.js
templ ToastStore() {
	<script>
		document.addEventListener('alpine:init', () => {
			Alpine.store('toast', {
				show(type, message, options = {}) {
					const toast = {
						id: Date.now(),
						type: type,
						message: message,
						title: options.title || '',
						duration: options.duration || 5000,
						dismissible: options.dismissible !== false,
						icon: options.icon !== false,
						actions: options.actions || []
					};
					
					window.dispatchEvent(new CustomEvent('toast-add', {
						detail: toast
					}));
				},
				
				success(message, options = {}) {
					this.show('success', message, options);
				},
				
				error(message, options = {}) {
					this.show('error', message, options);
				},
				
				warning(message, options = {}) {
					this.show('warning', message, options);
				},
				
				info(message, options = {}) {
					this.show('info', message, options);
				},
				
				dismiss(id) {
					window.dispatchEvent(new CustomEvent('toast-remove', {
						detail: id
					}));
				},
				
				clear() {
					window.dispatchEvent(new CustomEvent('toast-clear'));
				}
			});
		});
	</script>
}