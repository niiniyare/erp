package elements

import (
	"strings"
	"strconv"
)

// TooltipProps defines the properties for the Tooltip component
type TooltipProps struct {
	Content   string `json:"content" validate:"required"`
	Position  string `json:"position" validate:"oneof=top bottom left right"`
	Trigger   string `json:"trigger" validate:"oneof=hover click focus"`
	Style     string `json:"style" validate:"oneof=dark light"`
	Arrow     bool   `json:"arrow"`
	Delay     int    `json:"delay"` // Delay in milliseconds
	ID        string `json:"id"`
	Class     string `json:"class"`
	AriaLabel string `json:"aria_label"`
}

// PopoverProps defines the properties for the Popover component
type PopoverProps struct {
	Title     string `json:"title"`
	Content   string `json:"content" validate:"required"`
	Position  string `json:"position" validate:"oneof=top bottom left right auto"`
	Trigger   string `json:"trigger" validate:"oneof=hover click focus"`
	Dismissible bool `json:"dismissible"`
	Arrow     bool   `json:"arrow"`
	MaxWidth  string `json:"max_width" validate:"oneof=xs sm base lg xl 2xl"`
	ID        string `json:"id"`
	Class     string `json:"class"`
	AriaLabel string `json:"aria_label"`
}

// Tooltip renders a Flowbite-styled tooltip component
templ Tooltip(content templ.Component, props TooltipProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ "relative inline-block " + props.Class }
		x-data={ getTooltipData(props.Trigger, props.Delay) }
		if props.Trigger == "hover" {
			@mouseenter="showTooltip()"
			@mouseleave="hideTooltip()"
		} else if props.Trigger == "click" {
			@click="toggleTooltip()"
			@click.away="hideTooltip()"
		} else if props.Trigger == "focus" {
			@focusin="showTooltip()"
			@focusout="hideTooltip()"
		}
	>
		<!-- Trigger element -->
		<div
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			} else {
				aria-describedby={ props.ID + "-tooltip" }
			}
		>
			@content
		</div>

		<!-- Tooltip -->
		<div
			if props.ID != "" {
				id={ props.ID + "-tooltip" }
			}
			class={ getTooltipClasses(props.Position, props.Style) }
			x-show="show"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 transform scale-95"
			x-transition:enter-end="opacity-100 transform scale-100"
			x-transition:leave="transition ease-in duration-75"
			x-transition:leave-start="opacity-100 transform scale-100"
			x-transition:leave-end="opacity-0 transform scale-95"
			role="tooltip"
		>
			{ props.Content }
			
			if props.Arrow {
				<div class={ getTooltipArrowClasses(props.Position, props.Style) }></div>
			}
		</div>
	</div>
}

// Popover renders a Flowbite-styled popover component
templ Popover(content templ.Component, props PopoverProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ "relative inline-block " + props.Class }
		x-data={ getPopoverData(props.Trigger, props.Dismissible) }
		if props.Trigger == "hover" {
			@mouseenter="showPopover()"
			@mouseleave="hidePopover()"
		} else if props.Trigger == "click" {
			@click="togglePopover()"
			if props.Dismissible {
				@click.away="hidePopover()"
			}
		} else if props.Trigger == "focus" {
			@focusin="showPopover()"
			@focusout="hidePopover()"
		}
	>
		<!-- Trigger element -->
		<div
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			} else {
				aria-describedby={ props.ID + "-popover" }
			}
		>
			@content
		</div>

		<!-- Popover -->
		<div
			if props.ID != "" {
				id={ props.ID + "-popover" }
			}
			class={ getPopoverClasses(props.Position, props.MaxWidth) }
			x-show="show"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 transform scale-95"
			x-transition:enter-end="opacity-100 transform scale-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 transform scale-100"
			x-transition:leave-end="opacity-0 transform scale-95"
			role="tooltip"
			aria-expanded="false"
			:aria-expanded="show"
		>
			<div class={ getPopoverContentClasses() }>
				if props.Title != "" {
					<div class={ getPopoverHeaderClasses() }>
						<h3 class={ getPopoverTitleClasses() }>
							{ props.Title }
						</h3>
						if props.Dismissible {
							<button
								type="button"
								class={ getPopoverCloseClasses() }
								@click="hidePopover()"
								aria-label="Close popover"
							>
								<svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
									<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
								</svg>
								<span class="sr-only">Close popover</span>
							</button>
						}
					</div>
				}
				
				<div class={ getPopoverBodyClasses() }>
					{ props.Content }
				</div>
			</div>
			
			if props.Arrow {
				<div class={ getPopoverArrowClasses(props.Position) }></div>
			}
		</div>
	</div>
}

// TooltipSimple renders a simple tooltip without wrapping content
templ TooltipSimple(props TooltipProps) {
	@Tooltip(tooltipTriggerContent(props), props)
}

// tooltipTriggerContent provides default trigger content for simple tooltips
templ tooltipTriggerContent(props TooltipProps) {
	<button
		type="button"
		class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
	>
		<svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
			<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
		</svg>
	</button>
}

// Helper functions for tooltip and popover styling
func getTooltipData(trigger string, delay int) string {
	delayStr := "0"
	if delay > 0 {
		delayStr = strconv.Itoa(delay)
	}
	
	return `{
		show: false,
		timer: null,
		showTooltip() {
			if (this.timer) clearTimeout(this.timer);
			this.timer = setTimeout(() => {
				this.show = true;
			}, ` + delayStr + `);
		},
		hideTooltip() {
			if (this.timer) clearTimeout(this.timer);
			this.show = false;
		},
		toggleTooltip() {
			this.show = !this.show;
		}
	}`
}

func getPopoverData(trigger string, dismissible bool) string {
	return `{
		show: false,
		showPopover() {
			this.show = true;
		},
		hidePopover() {
			this.show = false;
		},
		togglePopover() {
			this.show = !this.show;
		}
	}`
}

func getTooltipClasses(position, style string) string {
	base := "absolute z-10 px-3 py-2 text-sm font-medium rounded-lg shadow-sm pointer-events-none"
	
	// Style classes
	var styleClass string
	switch style {
	case "light":
		styleClass = "text-gray-500 bg-white border border-gray-200 dark:text-gray-400 dark:bg-gray-800 dark:border-gray-600"
	default: // dark
		styleClass = "text-white bg-gray-900 dark:bg-gray-700"
	}
	
	// Position classes
	var positionClass string
	switch position {
	case "top":
		positionClass = "bottom-full left-1/2 transform -translate-x-1/2 mb-2"
	case "bottom":
		positionClass = "top-full left-1/2 transform -translate-x-1/2 mt-2"
	case "left":
		positionClass = "right-full top-1/2 transform -translate-y-1/2 mr-2"
	case "right":
		positionClass = "left-full top-1/2 transform -translate-y-1/2 ml-2"
	default: // top
		positionClass = "bottom-full left-1/2 transform -translate-x-1/2 mb-2"
	}
	
	return strings.Join([]string{base, styleClass, positionClass}, " ")
}

func getTooltipArrowClasses(position, style string) string {
	base := "absolute w-2 h-2 transform rotate-45"
	
	// Style classes
	var styleClass string
	switch style {
	case "light":
		styleClass = "bg-white border border-gray-200 dark:bg-gray-800 dark:border-gray-600"
	default: // dark
		styleClass = "bg-gray-900 dark:bg-gray-700"
	}
	
	// Position classes
	var positionClass string
	switch position {
	case "top":
		positionClass = "top-full left-1/2 -translate-x-1/2 -mt-1"
	case "bottom":
		positionClass = "bottom-full left-1/2 -translate-x-1/2 -mb-1"
	case "left":
		positionClass = "left-full top-1/2 -translate-y-1/2 -ml-1"
	case "right":
		positionClass = "right-full top-1/2 -translate-y-1/2 -mr-1"
	default: // top
		positionClass = "top-full left-1/2 -translate-x-1/2 -mt-1"
	}
	
	return strings.Join([]string{base, styleClass, positionClass}, " ")
}

func getPopoverClasses(position, maxWidth string) string {
	base := "absolute z-10 text-sm text-gray-500 bg-white border border-gray-200 rounded-lg shadow-lg dark:text-gray-400 dark:border-gray-600 dark:bg-gray-800"
	
	// Position classes
	var positionClass string
	switch position {
	case "top":
		positionClass = "bottom-full left-1/2 transform -translate-x-1/2 mb-2"
	case "bottom":
		positionClass = "top-full left-1/2 transform -translate-x-1/2 mt-2"
	case "left":
		positionClass = "right-full top-1/2 transform -translate-y-1/2 mr-2"
	case "right":
		positionClass = "left-full top-1/2 transform -translate-y-1/2 ml-2"
	default: // auto or bottom
		positionClass = "top-full left-1/2 transform -translate-x-1/2 mt-2"
	}
	
	// Max width classes
	var maxWidthClass string
	switch maxWidth {
	case "xs":
		maxWidthClass = "max-w-xs"
	case "sm":
		maxWidthClass = "max-w-sm"
	case "lg":
		maxWidthClass = "max-w-lg"
	case "xl":
		maxWidthClass = "max-w-xl"
	case "2xl":
		maxWidthClass = "max-w-2xl"
	default: // base
		maxWidthClass = "max-w-sm"
	}
	
	return strings.Join([]string{base, positionClass, maxWidthClass}, " ")
}

func getPopoverContentClasses() string {
	return "p-3"
}

func getPopoverHeaderClasses() string {
	return "flex items-center justify-between p-3 border-b border-gray-200 dark:border-gray-600"
}

func getPopoverTitleClasses() string {
	return "font-semibold text-gray-900 dark:text-white"
}

func getPopoverCloseClasses() string {
	return "text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ml-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white"
}

func getPopoverBodyClasses() string {
	return "p-3"
}

func getPopoverArrowClasses(position string) string {
	base := "absolute w-2 h-2 bg-white border border-gray-200 transform rotate-45 dark:bg-gray-800 dark:border-gray-600"
	
	// Position classes
	var positionClass string
	switch position {
	case "top":
		positionClass = "top-full left-1/2 -translate-x-1/2 -mt-1"
	case "bottom":
		positionClass = "bottom-full left-1/2 -translate-x-1/2 -mb-1"
	case "left":
		positionClass = "left-full top-1/2 -translate-y-1/2 -ml-1"
	case "right":
		positionClass = "right-full top-1/2 -translate-y-1/2 -mr-1"
	default: // auto or bottom
		positionClass = "bottom-full left-1/2 -translate-x-1/2 -mb-1"
	}
	
	return strings.Join([]string{base, positionClass}, " ")
}