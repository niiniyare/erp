package molecules

import "strings"

// AlertProps defines the properties for the Alert component
type AlertProps struct {
	Message     string          `json:"message" validate:"required"`
	Title       string          `json:"title"`
	Variant     string          `json:"variant" validate:"oneof=info success warning error"`
	Dismissible bool            `json:"dismissible"`
	Icon        bool            `json:"icon"`
	Border      bool            `json:"border"`
	Actions     templ.Component `json:"-"`
	ID          string          `json:"id"`
	Class       string          `json:"class"`
}

// Alert renders a Flowbite-styled alert component
templ Alert(props AlertProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getAlertClasses(props.Variant, props.Border) + " " + props.Class }
		role="alert"
	>
		<div class="flex items-center">
			if props.Icon {
				<div class="flex-shrink-0">
					@getAlertIcon(props.Variant)
				</div>
			}
			<div class={ getAlertContentClasses(props.Icon) }>
				if props.Title != "" {
					<h3 class="text-lg font-medium text-gray-800 dark:text-white">
						{ props.Title }
					</h3>
				}
				<div class={ getAlertMessageClasses(props.Title != "") }>
					{ props.Message }
				</div>
				if props.Actions != nil {
					<div class="mt-4">
						@props.Actions
					</div>
				}
			</div>
			if props.Dismissible {
				<button
					type="button"
					class="ml-auto -mx-1.5 -my-1.5 bg-white text-gray-400 hover:text-gray-900 rounded-lg focus:ring-2 focus:ring-gray-300 p-1.5 hover:bg-gray-100 inline-flex h-8 w-8 dark:bg-gray-800 dark:text-gray-300 dark:hover:text-white dark:hover:bg-gray-700"
					onclick="this.parentElement.parentElement.style.display='none'"
					aria-label="Close"
				>
					<span class="sr-only">Close</span>
					<svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
						<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
					</svg>
				</button>
			}
		</div>
	</div>
}

// Helper functions for alert styling
func getAlertClasses(variant string, border bool) string {
	base := "flex p-4 rounded-lg"
	
	var variantClass string
	switch variant {
	case "info":
		if border {
			variantClass = "text-blue-800 border border-blue-300 bg-blue-50 dark:bg-gray-800 dark:text-blue-400 dark:border-blue-800"
		} else {
			variantClass = "text-blue-800 bg-blue-50 dark:bg-gray-800 dark:text-blue-400"
		}
	case "success":
		if border {
			variantClass = "text-green-800 border border-green-300 bg-green-50 dark:bg-gray-800 dark:text-green-400 dark:border-green-800"
		} else {
			variantClass = "text-green-800 bg-green-50 dark:bg-gray-800 dark:text-green-400"
		}
	case "warning":
		if border {
			variantClass = "text-yellow-800 border border-yellow-300 bg-yellow-50 dark:bg-gray-800 dark:text-yellow-300 dark:border-yellow-800"
		} else {
			variantClass = "text-yellow-800 bg-yellow-50 dark:bg-gray-800 dark:text-yellow-300"
		}
	case "error":
		if border {
			variantClass = "text-red-800 border border-red-300 bg-red-50 dark:bg-gray-800 dark:text-red-400 dark:border-red-800"
		} else {
			variantClass = "text-red-800 bg-red-50 dark:bg-gray-800 dark:text-red-400"
		}
	default: // info
		if border {
			variantClass = "text-blue-800 border border-blue-300 bg-blue-50 dark:bg-gray-800 dark:text-blue-400 dark:border-blue-800"
		} else {
			variantClass = "text-blue-800 bg-blue-50 dark:bg-gray-800 dark:text-blue-400"
		}
	}
	
	return strings.Join([]string{base, variantClass}, " ")
}

func getAlertContentClasses(hasIcon bool) string {
	if hasIcon {
		return "ml-3 text-sm font-medium"
	}
	return "text-sm font-medium"
}

func getAlertMessageClasses(hasTitle bool) string {
	if hasTitle {
		return "mt-2 text-sm"
	}
	return "text-sm"
}

// getAlertIcon returns the appropriate icon for each alert variant
templ getAlertIcon(variant string) {
	switch variant {
	case "info":
		<svg class="flex-shrink-0 w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
			<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
		</svg>
	case "success":
		<svg class="flex-shrink-0 w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
			<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z"/>
		</svg>
	case "warning":
		<svg class="flex-shrink-0 w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
			<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM10 15a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm0-4a1 1 0 0 1-1-1V6a1 1 0 0 1 2 0v4a1 1 0 0 1-1 1Z"/>
		</svg>
	case "error":
		<svg class="flex-shrink-0 w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
			<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 11.793a1 1 0 1 1-1.414 1.414L10 11.414l-2.293 2.293a1 1 0 0 1-1.414-1.414L8.586 10 6.293 7.707a1 1 0 0 1 1.414-1.414L10 8.586l2.293-2.293a1 1 0 0 1 1.414 1.414L11.414 10l2.293 2.293Z"/>
		</svg>
	default:
		<svg class="flex-shrink-0 w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
			<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
		</svg>
	}
}