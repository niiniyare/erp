package elements

import "strings"

// CardProps defines the properties for the Card component
type CardProps struct {
	Title     string          `json:"title"`
	Subtitle  string          `json:"subtitle"`
	Content   templ.Component `json:"-"`
	Footer    templ.Component `json:"-"`
	Image     string          `json:"image"`
	ImageAlt  string          `json:"image_alt"`
	Bordered  bool            `json:"bordered"`
	Shadow    string          `json:"shadow" validate:"oneof=none sm base md lg xl"`
	Padding   string          `json:"padding" validate:"oneof=none sm base lg xl"`
	Clickable bool            `json:"clickable"`
	MaxWidth  string          `json:"max_width"`
	ID        string          `json:"id"`
	Class     string          `json:"class"`
}

// Card renders a Flowbite-styled card component
templ Card(props CardProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getCardClasses(props.Shadow, props.Bordered, props.Clickable, props.MaxWidth) + " " + props.Class }
		if props.Clickable {
			role="button"
			tabindex="0"
		}
	>
		if props.Image != "" {
			<div class="rounded-t-lg overflow-hidden">
				<img 
					class="w-full h-48 object-cover" 
					src={ props.Image } 
					alt={ props.ImageAlt }
				/>
			</div>
		}
		
		if props.Title != "" || props.Subtitle != "" {
			<div class={ getCardHeaderClasses(props.Padding) }>
				if props.Title != "" {
					<h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
						{ props.Title }
					</h5>
				}
				if props.Subtitle != "" {
					<p class="text-sm text-gray-500 dark:text-gray-400">
						{ props.Subtitle }
					</p>
				}
			</div>
		}
		
		if props.Content != nil {
			<div class={ getCardContentClasses(props.Padding) }>
				@props.Content
			</div>
		}
		
		if props.Footer != nil {
			<div class={ getCardFooterClasses(props.Padding) }>
				@props.Footer
			</div>
		}
	</div>
}

// Helper functions for card styling
func getCardClasses(shadow string, bordered, clickable bool, maxWidth string) string {
	base := "bg-white rounded-lg dark:bg-gray-800"
	
	// Shadow classes
	var shadowClass string
	switch shadow {
	case "sm":
		shadowClass = "shadow-sm"
	case "base":
		shadowClass = "shadow"
	case "md":
		shadowClass = "shadow-md"
	case "lg":
		shadowClass = "shadow-lg"
	case "xl":
		shadowClass = "shadow-xl"
	default: // none
		shadowClass = ""
	}
	
	// Border class
	var borderClass string
	if bordered {
		borderClass = "border border-gray-200 dark:border-gray-700"
	}
	
	// Clickable class
	var clickableClass string
	if clickable {
		clickableClass = "cursor-pointer hover:shadow-lg transition-shadow duration-200"
	}
	
	// Max width class
	var maxWidthClass string
	if maxWidth != "" {
		maxWidthClass = "max-w-" + maxWidth
	}
	
	classes := []string{base}
	if shadowClass != "" {
		classes = append(classes, shadowClass)
	}
	if borderClass != "" {
		classes = append(classes, borderClass)
	}
	if clickableClass != "" {
		classes = append(classes, clickableClass)
	}
	if maxWidthClass != "" {
		classes = append(classes, maxWidthClass)
	}
	
	return strings.Join(classes, " ")
}

func getCardHeaderClasses(padding string) string {
	base := "px-6"
	
	switch padding {
	case "none":
		return "px-0 pt-0"
	case "sm":
		return base + " pt-4"
	case "lg":
		return base + " pt-8"
	case "xl":
		return base + " pt-10"
	default: // base
		return base + " pt-6"
	}
}

func getCardContentClasses(padding string) string {
	base := "px-6"
	
	switch padding {
	case "none":
		return "px-0 py-0"
	case "sm":
		return base + " py-3"
	case "lg":
		return base + " py-6"
	case "xl":
		return base + " py-8"
	default: // base
		return base + " py-4"
	}
}

func getCardFooterClasses(padding string) string {
	base := "px-6 border-t border-gray-200 dark:border-gray-700"
	
	switch padding {
	case "none":
		return "px-0 pb-0 pt-4 border-t border-gray-200 dark:border-gray-700"
	case "sm":
		return base + " pb-4 pt-3"
	case "lg":
		return base + " pb-8 pt-6"
	case "xl":
		return base + " pb-10 pt-8"
	default: // base
		return base + " pb-6 pt-4"
	}
}