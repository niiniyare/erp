package organisms

import (
	"strings"
	"strconv"
)

// DataTableColumn defines a table column
type DataTableColumn struct {
	Key       string `json:"key" validate:"required"`
	Title     string `json:"title" validate:"required"`
	Sortable  bool   `json:"sortable"`
	Width     string `json:"width"`
	Align     string `json:"align" validate:"oneof=left center right"`
	Type      string `json:"type" validate:"oneof=text number date currency badge action"`
	Format    string `json:"format"` // For date/currency formatting
}

// DataTableRow represents a table row with data
type DataTableRow struct {
	ID       string                 `json:"id" validate:"required"`
	Data     map[string]interface{} `json:"data" validate:"required"`
	Selected bool                   `json:"selected"`
	Actions  []DataTableAction      `json:"actions"`
}

// DataTableAction defines row-level actions
type DataTableAction struct {
	Text    string `json:"text" validate:"required"`
	Icon    string `json:"icon"`
	Variant string `json:"variant" validate:"oneof=primary secondary danger"`
	Href    string `json:"href"`
	Action  string `json:"action"`
}

// DataTableProps defines the properties for the DataTable component
type DataTableProps struct {
	Columns      []DataTableColumn `json:"columns" validate:"required,min=1"`
	Rows         []DataTableRow    `json:"rows"`
	Selectable   bool              `json:"selectable"`
	Searchable   bool              `json:"searchable"`
	Sortable     bool              `json:"sortable"`
	Pagination   bool              `json:"pagination"`
	PageSize     int               `json:"page_size"`
	TotalRows    int               `json:"total_rows"`
	CurrentPage  int               `json:"current_page"`
	Loading      bool              `json:"loading"`
	EmptyMessage string            `json:"empty_message"`
	BulkActions  []DataTableAction `json:"bulk_actions"`
	ID           string            `json:"id"`
	Class        string            `json:"class"`
	AriaLabel    string            `json:"aria_label"`
}

// DataTable renders a Flowbite-styled data table component
templ DataTable(props DataTableProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getDataTableContainerClasses() + " " + props.Class }
		x-data={ getDataTableData(props) }
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
	>
		<!-- Table header with search and bulk actions -->
		<div class={ getDataTableHeaderClasses() }>
			<!-- Search -->
			if props.Searchable {
				<div class={ getDataTableSearchClasses() }>
					<input
						type="text"
						placeholder="Search..."
						class={ getDataTableSearchInputClasses() }
						x-model="searchQuery"
						@input="handleSearch()"
					/>
					<svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
						<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
					</svg>
				</div>
			}

			<!-- Bulk actions -->
			if len(props.BulkActions) > 0 {
				<div class={ getDataTableBulkActionsClasses() } x-show="selectedRows.length > 0">
					<span class="text-sm text-gray-700 dark:text-gray-300" x-text="`${selectedRows.length} selected`"></span>
					for _, action := range props.BulkActions {
						<button
							type="button"
							class={ getDataTableBulkActionClasses(action.Variant) }
							@click={ getBulkActionHandler(action) }
						>
							if action.Icon != "" {
								<span class="mr-2">{ action.Icon }</span>
							}
							{ action.Text }
						</button>
					}
				</div>
			}
		</div>

		<!-- Table -->
		<div class={ getDataTableWrapperClasses() }>
			if props.Loading {
				@DataTableLoading()
			} else {
				<table class={ getDataTableClasses() }>
					<!-- Table head -->
					<thead class={ getDataTableHeadClasses() }>
						<tr>
							if props.Selectable {
								<th scope="col" class={ getDataTableCheckboxCellClasses() }>
									<input
										type="checkbox"
										class={ getDataTableCheckboxClasses() }
										@change="toggleSelectAll()"
										:checked="allSelected"
										:indeterminate="someSelected && !allSelected"
									/>
								</th>
							}
							
							for _, column := range props.Columns {
								<th 
									scope="col" 
									class={ getDataTableHeaderCellClasses(column.Align, column.Width) }
									if column.Sortable {
										@click={ "sort('" + column.Key + "')" }
										style="cursor: pointer;"
									}
								>
									<div class="flex items-center">
										{ column.Title }
										if column.Sortable {
											<svg class="w-3 h-3 ml-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
												<path d="M8.574 11.024h6.852a2.075 2.075 0 0 0 1.847-1.086 1.9 1.9 0 0 0-.11-1.986L13.736 2.9a2.122 2.122 0 0 0-3.472 0L6.837 7.952a1.9 1.9 0 0 0-.11 1.986 2.074 2.074 0 0 0 1.847 1.086Zm6.852 1.952H8.574a2.072 2.072 0 0 0-1.847 1.087 1.9 1.9 0 0 0 .11 1.985l3.426 5.05a2.123 2.123 0 0 0 3.472 0l3.427-5.05a1.9 1.9 0 0 0 .11-1.985 2.074 2.074 0 0 0-1.846-1.087Z"/>
											</svg>
										}
									</div>
								</th>
							}
							
							if hasRowActions(props.Rows) {
								<th scope="col" class={ getDataTableActionsCellClasses() }>
									Actions
								</th>
							}
						</tr>
					</thead>

					<!-- Table body -->
					<tbody class={ getDataTableBodyClasses() }>
						<template x-for="row in paginatedRows" :key="row.id">
							<tr class={ getDataTableRowClasses() }>
								if props.Selectable {
									<td class={ getDataTableCheckboxCellClasses() }>
										<input
											type="checkbox"
											class={ getDataTableCheckboxClasses() }
											:value="row.id"
											x-model="selectedRows"
										/>
									</td>
								}
								
								for _, column := range props.Columns {
									<td class={ getDataTableCellClasses(column.Align) }>
										@DataTableCellContent(column)
									</td>
								}
								
								if hasRowActions(props.Rows) {
									<td class={ getDataTableActionsCellClasses() }>
										@DataTableRowActions()
									</td>
								}
							</tr>
						</template>
						
						<!-- Empty state -->
						<tr x-show="paginatedRows.length === 0">
							<td :colspan="totalColumns" class={ getDataTableEmptyClasses() }>
								{ getEmptyMessage(props.EmptyMessage) }
							</td>
						</tr>
					</tbody>
				</table>
			}
		</div>

		<!-- Pagination -->
		if props.Pagination {
			@DataTablePagination()
		}
	</div>
}

// DataTableCellContent renders cell content based on column type
templ DataTableCellContent(column DataTableColumn) {
	<span x-html={ getCellContentExpression(column) }></span>
}

// DataTableRowActions renders row action buttons
templ DataTableRowActions() {
	<div class="flex items-center space-x-2">
		<template x-for="action in row.actions" :key="action.text">
			<button
				type="button"
				class={ getDataTableRowActionClasses() }
				:class={ "getActionVariantClasses(action.variant)" }
				@click={ "handleRowAction(action, row)" }
			>
				<span x-show="action.icon" x-html="action.icon" class="mr-1"></span>
				<span x-text="action.text"></span>
			</button>
		</template>
	</div>
}

// DataTableLoading renders loading state
templ DataTableLoading() {
	<div class={ getDataTableLoadingClasses() }>
		<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
		<span class="ml-2 text-gray-500 dark:text-gray-400">Loading...</span>
	</div>
}

// DataTablePagination renders pagination controls
templ DataTablePagination() {
	<div class={ getDataTablePaginationClasses() }>
		<!-- Pagination info -->
		<span class="text-sm text-gray-700 dark:text-gray-300">
			Showing <span x-text="startIndex"></span> to <span x-text="endIndex"></span> of <span x-text="totalRows"></span> results
		</span>

		<!-- Pagination buttons -->
		<div class="flex items-center space-x-2">
			<button
				type="button"
				class={ getDataTablePaginationButtonClasses() }
				@click="prevPage()"
				:disabled="currentPage === 1"
				:class="{ 'opacity-50 cursor-not-allowed': currentPage === 1 }"
			>
				Previous
			</button>
			
			<template x-for="page in visiblePages" :key="page">
				<button
					type="button"
					class={ getDataTablePaginationButtonClasses() }
					:class="{ 'bg-blue-600 text-white': page === currentPage }"
					@click="goToPage(page)"
					x-text="page"
				></button>
			</template>
			
			<button
				type="button"
				class={ getDataTablePaginationButtonClasses() }
				@click="nextPage()"
				:disabled="currentPage === totalPages"
				:class="{ 'opacity-50 cursor-not-allowed': currentPage === totalPages }"
			>
				Next
			</button>
		</div>
	</div>
}

// Helper functions for data table styling and logic
func getDataTableData(props DataTableProps) string {
	pageSize := 10
	if props.PageSize > 0 {
		pageSize = props.PageSize
	}
	
	currentPage := 1
	if props.CurrentPage > 0 {
		currentPage = props.CurrentPage
	}
	
	return `{
		rows: ` + getRowsJSON(props.Rows) + `,
		filteredRows: [],
		paginatedRows: [],
		selectedRows: [],
		searchQuery: '',
		sortColumn: '',
		sortDirection: 'asc',
		currentPage: ` + strconv.Itoa(currentPage) + `,
		pageSize: ` + strconv.Itoa(pageSize) + `,
		totalRows: 0,
		totalPages: 0,
		totalColumns: ` + strconv.Itoa(getTotalColumns(props)) + `,

		init() {
			this.filteredRows = [...this.rows];
			this.updatePagination();
		},

		handleSearch() {
			if (this.searchQuery.trim() === '') {
				this.filteredRows = [...this.rows];
			} else {
				this.filteredRows = this.rows.filter(row => {
					return Object.values(row.data).some(value =>
						String(value).toLowerCase().includes(this.searchQuery.toLowerCase())
					);
				});
			}
			this.currentPage = 1;
			this.updatePagination();
		},

		sort(column) {
			if (this.sortColumn === column) {
				this.sortDirection = this.sortDirection === 'asc' ? 'desc' : 'asc';
			} else {
				this.sortColumn = column;
				this.sortDirection = 'asc';
			}

			this.filteredRows.sort((a, b) => {
				const aVal = a.data[column];
				const bVal = b.data[column];
				
				if (aVal < bVal) return this.sortDirection === 'asc' ? -1 : 1;
				if (aVal > bVal) return this.sortDirection === 'asc' ? 1 : -1;
				return 0;
			});

			this.updatePagination();
		},

		updatePagination() {
			this.totalRows = this.filteredRows.length;
			this.totalPages = Math.ceil(this.totalRows / this.pageSize);
			
			const start = (this.currentPage - 1) * this.pageSize;
			const end = start + this.pageSize;
			this.paginatedRows = this.filteredRows.slice(start, end);
		},

		toggleSelectAll() {
			if (this.allSelected) {
				this.selectedRows = [];
			} else {
				this.selectedRows = this.paginatedRows.map(row => row.id);
			}
		},

		prevPage() {
			if (this.currentPage > 1) {
				this.currentPage--;
				this.updatePagination();
			}
		},

		nextPage() {
			if (this.currentPage < this.totalPages) {
				this.currentPage++;
				this.updatePagination();
			}
		},

		goToPage(page) {
			this.currentPage = page;
			this.updatePagination();
		},

		get allSelected() {
			return this.paginatedRows.length > 0 && 
				   this.selectedRows.length === this.paginatedRows.length;
		},

		get someSelected() {
			return this.selectedRows.length > 0 && 
				   this.selectedRows.length < this.paginatedRows.length;
		},

		get startIndex() {
			return this.totalRows === 0 ? 0 : (this.currentPage - 1) * this.pageSize + 1;
		},

		get endIndex() {
			return Math.min(this.currentPage * this.pageSize, this.totalRows);
		},

		get visiblePages() {
			const pages = [];
			const start = Math.max(1, this.currentPage - 2);
			const end = Math.min(this.totalPages, this.currentPage + 2);
			
			for (let i = start; i <= end; i++) {
				pages.push(i);
			}
			return pages;
		}
	}`
}

func getDataTableContainerClasses() string {
	return "relative overflow-x-auto shadow-md sm:rounded-lg"
}

func getDataTableHeaderClasses() string {
	return "flex items-center justify-between p-4 bg-white dark:bg-gray-900"
}

func getDataTableSearchClasses() string {
	return "relative"
}

func getDataTableSearchInputClasses() string {
	return "block p-2 pl-10 text-sm text-gray-900 border border-gray-300 rounded-lg w-80 bg-gray-50 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
}

func getDataTableBulkActionsClasses() string {
	return "flex items-center space-x-3"
}

func getDataTableBulkActionClasses(variant string) string {
	base := "px-3 py-2 text-sm font-medium rounded-lg transition-colors duration-200"
	
	switch variant {
	case "danger":
		return base + " text-white bg-red-600 hover:bg-red-700 focus:ring-4 focus:ring-red-300 dark:bg-red-500 dark:hover:bg-red-600"
	case "secondary":
		return base + " text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-900 focus:ring-4 focus:ring-gray-200 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-600 dark:hover:bg-gray-600 dark:hover:text-white"
	default: // primary
		return base + " text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 dark:bg-blue-500 dark:hover:bg-blue-600"
	}
}

func getDataTableWrapperClasses() string {
	return "relative overflow-x-auto"
}

func getDataTableClasses() string {
	return "w-full text-sm text-left text-gray-500 dark:text-gray-400"
}

func getDataTableHeadClasses() string {
	return "text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400"
}

func getDataTableHeaderCellClasses(align, width string) string {
	base := "px-6 py-3"
	
	var alignClass string
	switch align {
	case "center":
		alignClass = "text-center"
	case "right":
		alignClass = "text-right"
	default:
		alignClass = "text-left"
	}
	
	var widthClass string
	if width != "" {
		widthClass = "w-" + width
	}
	
	return strings.Join([]string{base, alignClass, widthClass}, " ")
}

func getDataTableCheckboxCellClasses() string {
	return "w-4 p-4"
}

func getDataTableCheckboxClasses() string {
	return "w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 dark:focus:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600"
}

func getDataTableActionsCellClasses() string {
	return "px-6 py-4 text-right"
}

func getDataTableBodyClasses() string {
	return ""
}

func getDataTableRowClasses() string {
	return "bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600"
}

func getDataTableCellClasses(align string) string {
	base := "px-6 py-4"
	
	switch align {
	case "center":
		return base + " text-center"
	case "right":
		return base + " text-right"
	default:
		return base
	}
}

func getDataTableRowActionClasses() string {
	return "px-2 py-1 text-xs font-medium rounded transition-colors duration-200"
}

func getDataTableEmptyClasses() string {
	return "px-6 py-4 text-center text-gray-500 dark:text-gray-400"
}

func getDataTableLoadingClasses() string {
	return "flex items-center justify-center p-8"
}

func getDataTablePaginationClasses() string {
	return "flex items-center justify-between p-4 bg-white dark:bg-gray-900"
}

func getDataTablePaginationButtonClasses() string {
	return "px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white"
}

func getCellContentExpression(column DataTableColumn) string {
	switch column.Type {
	case "badge":
		return "getBadgeContent(row.data['" + column.Key + "'])"
	case "currency":
		return "formatCurrency(row.data['" + column.Key + "'])"
	case "date":
		return "formatDate(row.data['" + column.Key + "'])"
	default:
		return "row.data['" + column.Key + "']"
	}
}

func getBulkActionHandler(action DataTableAction) string {
	if action.Action != "" {
		return "handleBulkAction('" + action.Action + "')"
	}
	return "console.log('Bulk action: " + action.Text + "')"
}

func hasRowActions(rows []DataTableRow) bool {
	for _, row := range rows {
		if len(row.Actions) > 0 {
			return true
		}
	}
	return false
}

func getTotalColumns(props DataTableProps) int {
	total := len(props.Columns)
	if props.Selectable {
		total++
	}
	if hasRowActions(props.Rows) {
		total++
	}
	return total
}

func getRowsJSON(rows []DataTableRow) string {
	// This would normally be generated dynamically
	// For now, return empty array as placeholder
	return "[]"
}

func getEmptyMessage(message string) string {
	if message != "" {
		return message
	}
	return "No data available"
}