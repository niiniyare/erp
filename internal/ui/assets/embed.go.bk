package assets

import (
	"embed"
	"io/fs"
	"net/http"
	"path/filepath"
	"strings"
)

// Embedded assets for each UI service
//
//go:embed all:console/dist/*
var consoleAssets embed.FS

//go:embed all:workspace/dist/*
var workspaceAssets embed.FS

//go:embed all:portal/dist/*
var portalAssets embed.FS

//go:embed all:shared/dist/*
var sharedAssets embed.FS

// AssetManager handles serving of embedded assets for UI services
type AssetManager struct {
	consoleFS   fs.FS
	workspaceFS fs.FS
	portalFS    fs.FS
	sharedFS    fs.FS
}

// NewAssetManager creates a new asset manager
func NewAssetManager() *AssetManager {
	// Create sub-filesystems for each UI service
	consoleFS, _ := fs.Sub(consoleAssets, "console/dist")
	workspaceFS, _ := fs.Sub(workspaceAssets, "workspace/dist")
	portalFS, _ := fs.Sub(portalAssets, "portal/dist")
	sharedFS, _ := fs.Sub(sharedAssets, "shared/dist")

	return &AssetManager{
		consoleFS:   consoleFS,
		workspaceFS: workspaceFS,
		portalFS:    portalFS,
		sharedFS:    sharedFS,
	}
}

// ConsoleHandler returns HTTP handler for console assets
func (am *AssetManager) ConsoleHandler() http.Handler {
	return am.createAssetHandler(am.consoleFS, am.sharedFS, "console")
}

// WorkspaceHandler returns HTTP handler for workspace assets
func (am *AssetManager) WorkspaceHandler() http.Handler {
	return am.createAssetHandler(am.workspaceFS, am.sharedFS, "workspace")
}

// PortalHandler returns HTTP handler for portal assets
func (am *AssetManager) PortalHandler() http.Handler {
	return am.createAssetHandler(am.portalFS, am.sharedFS, "portal")
}

// createAssetHandler creates an HTTP handler that serves assets with fallback to shared assets
func (am *AssetManager) createAssetHandler(serviceFS, sharedFS fs.FS, serviceName string) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		path := strings.TrimPrefix(r.URL.Path, "/")

		// Set appropriate headers
		am.setAssetHeaders(w, path)

		// Try to serve from service-specific assets first
		if am.serveFromFS(w, r, serviceFS, path) {
			return
		}

		// Fallback to shared assets
		if am.serveFromFS(w, r, sharedFS, path) {
			return
		}

		// Asset not found
		http.NotFound(w, r)
	})
}

// serveFromFS attempts to serve a file from the given filesystem
func (am *AssetManager) serveFromFS(w http.ResponseWriter, r *http.Request, fsys fs.FS, path string) bool {
	file, err := fsys.Open(path)
	if err != nil {
		return false
	}
	defer file.Close()

	stat, err := file.Stat()
	if err != nil {
		return false
	}

	if stat.IsDir() {
		return false
	}

	http.ServeContent(w, r, stat.Name(), stat.ModTime(), file.(http.ReadSeeker))
	return true
}

// setAssetHeaders sets appropriate headers for different asset types
func (am *AssetManager) setAssetHeaders(w http.ResponseWriter, path string) {
	ext := filepath.Ext(path)

	// Set content type
	switch ext {
	case ".css":
		w.Header().Set("Content-Type", "text/css")
	case ".js":
		w.Header().Set("Content-Type", "application/javascript")
	case ".png":
		w.Header().Set("Content-Type", "image/png")
	case ".jpg", ".jpeg":
		w.Header().Set("Content-Type", "image/jpeg")
	case ".svg":
		w.Header().Set("Content-Type", "image/svg+xml")
	case ".woff", ".woff2":
		w.Header().Set("Content-Type", "font/woff2")
	}

	// Set caching headers
	if strings.Contains(path, ".min.") || strings.Contains(path, "-") {
		// Versioned assets - cache for 1 year
		w.Header().Set("Cache-Control", "public, max-age=31536000, immutable")
	} else {
		// Non-versioned assets - cache for 1 hour
		w.Header().Set("Cache-Control", "public, max-age=3600")
	}

	// Security headers for assets
	w.Header().Set("X-Content-Type-Options", "nosniff")
}
