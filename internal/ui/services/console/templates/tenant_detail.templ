package console

import (
	"fmt"
	"github.com/niiniyare/erp/internal/ui/types"
)

templ TenantDetailPage(data types.TenantDetailPageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.Title } - Admin Console</title>
			<script src="https://cdn.tailwindcss.com"></script>
			<script src="https://unpkg.com/htmx.org@1.9.6"></script>
			<link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.8.1/flowbite.min.css" rel="stylesheet"/>
		</head>
		<body class="bg-gray-50 dark:bg-gray-900">
			<div class="flex h-screen">
				<!-- Sidebar -->
				@consoleSidebar()
				<!-- Main Content -->
				<div class="flex-1 flex flex-col overflow-hidden">
					<!-- Header -->
					@consoleHeader()
					<!-- Page Content -->
					<main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-50 dark:bg-gray-900">
						<div class="container mx-auto px-6 py-8">
							<!-- Page Header -->
							<div class="mb-8">
								<div class="flex items-center space-x-3 mb-4">
									<a
										href="/console/tenants"
										class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-300"
									>
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
										</svg>
									</a>
									<h1 class="text-3xl font-bold text-gray-900 dark:text-white">{ data.Tenant.Name }</h1>
									@tenantStatusBadge(data.Tenant.Status)
								</div>
								<p class="text-gray-600 dark:text-gray-400">Tenant Details and Management</p>
							</div>
							<!-- Tenant Information -->
							<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
								<!-- Main Information -->
								<div class="lg:col-span-2">
									<div class="bg-white dark:bg-gray-800 shadow-xl rounded-lg">
										<div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
											<h3 class="text-lg font-medium text-gray-900 dark:text-white">Tenant Information</h3>
										</div>
										<div class="p-6">
											<dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
												<div>
													<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Tenant Name</dt>
													<dd class="mt-1 text-sm text-gray-900 dark:text-white">{ data.Tenant.Name }</dd>
												</div>
												<div>
													<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Contact Email</dt>
													<dd class="mt-1 text-sm text-gray-900 dark:text-white">{ data.Tenant.Email }</dd>
												</div>
												<div>
													<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Subdomain</dt>
													<dd class="mt-1 text-sm text-gray-900 dark:text-white">
														if data.Tenant.Subdomain != nil {
															{ *data.Tenant.Subdomain }.yourdomain.com
														} else {
															<span class="text-gray-500 dark:text-gray-400">Not configured</span>
														}
													</dd>
												</div>
												<div>
													<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Status</dt>
													<dd class="mt-1">
														@tenantStatusBadge(data.Tenant.Status)
													</dd>
												</div>
												<div>
													<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Industry</dt>
													<dd class="mt-1 text-sm text-gray-900 dark:text-white">
														if data.Tenant.Industry != "" {
															{ data.Tenant.Industry }
														} else {
															<span class="text-gray-500 dark:text-gray-400">Not specified</span>
														}
													</dd>
												</div>
												<div>
													<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Company Size</dt>
													<dd class="mt-1 text-sm text-gray-900 dark:text-white">
														if data.Tenant.CompanySize != "" {
															{ data.Tenant.CompanySize } employees
														} else {
															<span class="text-gray-500 dark:text-gray-400">Not specified</span>
														}
													</dd>
												</div>
												<div>
													<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Timezone</dt>
													<dd class="mt-1 text-sm text-gray-900 dark:text-white">{ data.Tenant.Timezone }</dd>
												</div>
												<div>
													<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Currency</dt>
													<dd class="mt-1 text-sm text-gray-900 dark:text-white">{ data.Tenant.Currency }</dd>
												</div>
												<div>
													<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Created</dt>
													<dd class="mt-1 text-sm text-gray-900 dark:text-white">
														{ data.Tenant.CreatedAt.Format("January 02, 2006 at 15:04") }
													</dd>
												</div>
												<div>
													<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Last Updated</dt>
													<dd class="mt-1 text-sm text-gray-900 dark:text-white">
														{ data.Tenant.UpdatedAt.Format("January 02, 2006 at 15:04") }
													</dd>
												</div>
											</dl>
										</div>
									</div>
								</div>
								<!-- Actions Panel -->
								<div class="lg:col-span-1">
									<div class="bg-white dark:bg-gray-800 shadow-xl rounded-lg">
										<div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
											<h3 class="text-lg font-medium text-gray-900 dark:text-white">Actions</h3>
										</div>
										<div class="p-6 space-y-4">
											<!-- Status Actions -->
											<div>
												<h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Status Management</h4>
												<div class="space-y-2">
													if data.Tenant.Status == "active" {
														<button
															hx-post="/console/tenants/status"
															hx-vals={ fmt.Sprintf("{\"tenant_id\": \"%s\", \"action\": \"suspend\"}", data.Tenant.ID) }
															hx-confirm="Are you sure you want to suspend this tenant?"
															hx-swap="none"
															hx-on::after-request="location.reload()"
															class="w-full inline-flex justify-center items-center px-3 py-2 border border-red-300 rounded-md text-sm font-medium text-red-700 bg-red-50 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 dark:bg-red-900/50 dark:border-red-800 dark:text-red-300"
														>
															<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
																<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
															</svg>
															Suspend Tenant
														</button>
													} else if data.Tenant.Status == "suspended" {
														<button
															hx-post="/console/tenants/status"
															hx-vals={ fmt.Sprintf("{\"tenant_id\": \"%s\", \"action\": \"activate\"}", data.Tenant.ID) }
															hx-confirm="Are you sure you want to activate this tenant?"
															hx-swap="none"
															hx-on::after-request="location.reload()"
															class="w-full inline-flex justify-center items-center px-3 py-2 border border-green-300 rounded-md text-sm font-medium text-green-700 bg-green-50 hover:bg-green-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 dark:bg-green-900/50 dark:border-green-800 dark:text-green-300"
														>
															<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
																<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1a3 3 0 000-6h-1m1 6V4a2 2 0 00-2-2H4a2 2 0 00-2 2v6m3 0h2m0 0V8a2 2 0 012-2h4a2 2 0 012 2v2m0 0h1"></path>
															</svg>
															Activate Tenant
														</button>
													}
												</div>
											</div>
											<!-- Navigation Actions -->
											<div>
												<h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Navigation</h4>
												<div class="space-y-2">
													<a
														href="/console/tenants"
														class="w-full inline-flex justify-center items-center px-3 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-600"
													>
														<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
															<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
														</svg>
														Back to Tenants
													</a>
													<a
														href="/console/users?tenant_id={ data.Tenant.ID }"
														class="w-full inline-flex justify-center items-center px-3 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-600"
													>
														<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
															<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"></path>
														</svg>
														View Users
													</a>
												</div>
											</div>
										</div>
									</div>
									<!-- Quick Stats -->
									<div class="bg-white dark:bg-gray-800 shadow-xl rounded-lg mt-6">
										<div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
											<h3 class="text-lg font-medium text-gray-900 dark:text-white">Quick Stats</h3>
										</div>
										<div class="p-6">
											<dl class="space-y-4">
												<div class="flex justify-between">
													<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Total Users</dt>
													<dd class="text-sm text-gray-900 dark:text-white">-</dd>
												</div>
												<div class="flex justify-between">
													<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Active Sessions</dt>
													<dd class="text-sm text-gray-900 dark:text-white">-</dd>
												</div>
												<div class="flex justify-between">
													<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Storage Used</dt>
													<dd class="text-sm text-gray-900 dark:text-white">-</dd>
												</div>
											</dl>
										</div>
									</div>
								</div>
							</div>
						</div>
					</main>
				</div>
			</div>
			<script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.8.1/flowbite.min.js"></script>
		</body>
	</html>
}