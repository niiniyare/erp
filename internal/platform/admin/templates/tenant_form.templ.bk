package templates

import (
	"awo/internal/core/tenant"
)

// Helper functions for template values
func getTenantValue(t *tenant.Tenant, field string) string {
	if t == nil {
		return ""
	}
	switch field {
	case "name":
		return t.Name
	case "slug":
		return t.Slug
	case "email":
		return t.Email
	case "subdomain":
		if t.Subdomain != nil {
			return *t.Subdomain
		}
		return ""
	case "timezone":
		return t.Timezone
	case "currency_code":
		return t.CurrencyCode
	}
	return ""
}

func getTenantStatus(t *tenant.Tenant) string {
	if t == nil {
		return "active"
	}
	return string(t.Status)
}

func isStatusSelected(t *tenant.Tenant, status string) bool {
	if t == nil {
		return status == "active"
	}
	return string(t.Status) == status
}

func isTimezoneSelected(t *tenant.Tenant, timezone string) bool {
	if t == nil {
		return timezone == "UTC"
	}
	return t.Timezone == timezone
}

func isCurrencySelected(t *tenant.Tenant, currency string) bool {
	if t == nil {
		return currency == "USD"
	}
	return t.CurrencyCode == currency
}

type TenantFormData struct {
	Tenant  *tenant.Tenant
	IsEdit  bool
	Errors  map[string]string
}

templ TenantForm(data TenantFormData) {
	if data.IsEdit {
		@Layout("Edit Tenant", TenantFormContent(data))
	} else {
		@Layout("Create Tenant", TenantFormContent(data))
	}
}

templ TenantFormContent(data TenantFormData) {
	<div class="py-10">
		<header>
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="flex items-center space-x-4">
					<a href="/admin/tenants" class="text-gray-500 hover:text-gray-700">
						<i class="fas fa-arrow-left"></i>
					</a>
					<h1 class="text-3xl font-bold leading-tight tracking-tight text-gray-900">
						if data.IsEdit {
							Edit Tenant
						} else {
							Create Tenant
						}
					</h1>
				</div>
			</div>
		</header>
		<main>
			<div class="mx-auto max-w-7xl sm:px-6 lg:px-8">
				<div class="mt-8">
					<div class="bg-white shadow rounded-lg">
						<form 
							if data.IsEdit {
								action={ templ.SafeURL("/admin/tenants/" + data.Tenant.ID.String()) }
								method="POST"
							} else {
								action="/admin/tenants"
								method="POST"
							}
							class="space-y-6 p-6"
						>
							if data.IsEdit {
								<input type="hidden" name="_method" value="PUT"/>
							}
							
							<!-- Name Field -->
							<div>
								<label for="name" class="block text-sm font-medium text-gray-700">
									Tenant Name <span class="text-red-500">*</span>
								</label>
								<div class="mt-1">
									<input
										type="text"
										name="name"
										id="name"
										value={ getTenantValue(data.Tenant, "name") }
										required
										class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
										placeholder="Enter tenant name"
									/>
								</div>
								if data.Errors["name"] != "" {
									<p class="mt-1 text-sm text-red-600">{ data.Errors["name"] }</p>
								}
							</div>

							<!-- Slug Field -->
							<div>
								<label for="slug" class="block text-sm font-medium text-gray-700">
									Slug <span class="text-red-500">*</span>
								</label>
								<div class="mt-1">
									<input
										type="text"
										name="slug"
										id="slug"
										value={ getTenantValue(data.Tenant, "slug") }
										required
										class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
										placeholder="tenant-slug"
									/>
								</div>
								<p class="mt-1 text-sm text-gray-500">Used for URLs and identification. Only lowercase letters, numbers, and hyphens allowed.</p>
								if data.Errors["slug"] != "" {
									<p class="mt-1 text-sm text-red-600">{ data.Errors["slug"] }</p>
								}
							</div>

							<!-- Email Field -->
							<div>
								<label for="email" class="block text-sm font-medium text-gray-700">
									Contact Email <span class="text-red-500">*</span>
								</label>
								<div class="mt-1">
									<input
										type="email"
										name="email"
										id="email"
										value={ getTenantValue(data.Tenant, "email") }
										required
										class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
										placeholder="contact@company.com"
									/>
								</div>
								if data.Errors["email"] != "" {
									<p class="mt-1 text-sm text-red-600">{ data.Errors["email"] }</p>
								}
							</div>

							<!-- Subdomain Field -->
							<div>
								<label for="subdomain" class="block text-sm font-medium text-gray-700">
									Subdomain
								</label>
								<div class="mt-1">
									<input
										type="text"
										name="subdomain"
										id="subdomain"
										value={ getTenantValue(data.Tenant, "subdomain") }
										class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
										placeholder="company"
									/>
								</div>
								<p class="mt-1 text-sm text-gray-500">Optional custom subdomain for this tenant.</p>
								if data.Errors["subdomain"] != "" {
									<p class="mt-1 text-sm text-red-600">{ data.Errors["subdomain"] }</p>
								}
							</div>

							<!-- Status Field -->
							<div>
								<label for="status" class="block text-sm font-medium text-gray-700">
									Status
								</label>
								<div class="mt-1">
									<select
										name="status"
										id="status"
										class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
									>
										<option value="ACTIVE" selected?={ isStatusSelected(data.Tenant, "ACTIVE") }>Active</option>
										<option value="PENDING" selected?={ isStatusSelected(data.Tenant, "PENDING") }>Pending</option>
										<option value="SUSPENDED" selected?={ isStatusSelected(data.Tenant, "SUSPENDED") }>Suspended</option>
										<option value="ARCHIVED" selected?={ isStatusSelected(data.Tenant, "ARCHIVED") }>Archived</option>
									</select>
								</div>
								if data.Errors["status"] != "" {
									<p class="mt-1 text-sm text-red-600">{ data.Errors["status"] }</p>
								}
							</div>

							<!-- Timezone Field -->
							<div>
								<label for="timezone" class="block text-sm font-medium text-gray-700">
									Timezone
								</label>
								<div class="mt-1">
									<select
										name="timezone"
										id="timezone"
										class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
									>
										<option value="UTC" selected?={ isTimezoneSelected(data.Tenant, "UTC") }>UTC</option>
										<option value="America/New_York" selected?={ isTimezoneSelected(data.Tenant, "America/New_York") }>Eastern Time (America/New_York)</option>
										<option value="America/Chicago" selected?={ isTimezoneSelected(data.Tenant, "America/Chicago") }>Central Time (America/Chicago)</option>
										<option value="America/Denver" selected?={ isTimezoneSelected(data.Tenant, "America/Denver") }>Mountain Time (America/Denver)</option>
										<option value="America/Los_Angeles" selected?={ isTimezoneSelected(data.Tenant, "America/Los_Angeles") }>Pacific Time (America/Los_Angeles)</option>
										<option value="Europe/London" selected?={ isTimezoneSelected(data.Tenant, "Europe/London") }>London (Europe/London)</option>
									</select>
								</div>
								if data.Errors["timezone"] != "" {
									<p class="mt-1 text-sm text-red-600">{ data.Errors["timezone"] }</p>
								}
							</div>

							<!-- Currency Code Field -->
							<div>
								<label for="currency_code" class="block text-sm font-medium text-gray-700">
									Currency Code
								</label>
								<div class="mt-1">
									<select
										name="currency_code"
										id="currency_code"
										class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
									>
										<option value="USD" selected?={ isCurrencySelected(data.Tenant, "USD") }>USD - US Dollar</option>
										<option value="EUR" selected?={ isCurrencySelected(data.Tenant, "EUR") }>EUR - Euro</option>
										<option value="GBP" selected?={ isCurrencySelected(data.Tenant, "GBP") }>GBP - British Pound</option>
										<option value="CAD" selected?={ isCurrencySelected(data.Tenant, "CAD") }>CAD - Canadian Dollar</option>
									</select>
								</div>
								if data.Errors["currency_code"] != "" {
									<p class="mt-1 text-sm text-red-600">{ data.Errors["currency_code"] }</p>
								}
							</div>

							<!-- Form Actions -->
							<div class="flex justify-end space-x-3 pt-6 border-t border-gray-200">
								<a
									href="/admin/tenants"
									class="inline-flex justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
								>
									Cancel
								</a>
								<button
									type="submit"
									class="inline-flex justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
								>
									if data.IsEdit {
										Update Tenant
									} else {
										Create Tenant
									}
								</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</main>
	</div>
}