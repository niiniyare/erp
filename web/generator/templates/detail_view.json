{
  "id": "detail-view-template",
  "version": "1.0.0",
  "layout": "app",
  "title": "${entityTitle} Details",
  "description": "Comprehensive detail view for ${entityTitle} with related data and actions",
  "components": [
    {
      "id": "page-header",
      "type": "organisms.siteheader",
      "props": {
        "title": "${data.name || data.title || entityTitle}",
        "subtitle": "${entityTitle} Details",
        "breadcrumbs": [
          { "label": "Dashboard", "href": "/" },
          { "label": "${entityTitle}", "href": "/${entityPath}" },
          { "label": "${data.name || data.title || 'Details'}", "current": true }
        ],
        "actions": [
          {
            "id": "edit-record",
            "actionType": "url",
            "label": "Edit",
            "icon": "edit",
            "level": "primary",
            "link": "/${entityPath}/${data.id}/edit",
            "permissions": ["${entityName}:update"],
            "visibleOn": "${!readonly}"
          },
          {
            "id": "duplicate-record",
            "actionType": "url",
            "label": "Duplicate",
            "icon": "copy",
            "level": "secondary",
            "link": "/${entityPath}/create?duplicate=${data.id}",
            "permissions": ["${entityName}:create"]
          },
          {
            "id": "delete-record",
            "actionType": "ajax",
            "label": "Delete",
            "icon": "trash",
            "level": "danger",
            "confirmText": "Are you sure you want to delete this ${entityTitle}? This action cannot be undone.",
            "api": {
              "method": "DELETE",
              "url": "/api/${entityPath}/${data.id}"
            },
            "permissions": ["${entityName}:delete"],
            "toast": {
              "title": "Deleted",
              "body": "${entityTitle} has been deleted successfully",
              "level": "success"
            },
            "redirect": "/${entityPath}"
          }
        ]
      },
      "dataSource": "detail-data",
      "layout": {
        "container": "flex",
        "classes": ["mb-6"]
      }
    },
    {
      "id": "detail-content",
      "type": "organisms.detail-view",
      "props": {
        "layout": "sections",
        "showAuditTrail": "${hasAuditTrail}",
        "sections": [
          {
            "id": "basic-info",
            "title": "Basic Information",
            "icon": "info-circle",
            "collapsible": false,
            "fields": "${basicFields}"
          },
          {
            "id": "contact-info", 
            "title": "Contact Information",
            "icon": "mail",
            "collapsible": true,
            "collapsed": false,
            "fields": "${contactFields}",
            "visibleOn": "${hasContactFields}"
          },
          {
            "id": "additional-details",
            "title": "Additional Details",
            "icon": "list",
            "collapsible": true,
            "collapsed": true,
            "fields": "${additionalFields}",
            "visibleOn": "${hasAdditionalFields}"
          },
          {
            "id": "system-info",
            "title": "System Information",
            "icon": "server",
            "collapsible": true,
            "collapsed": true,
            "fields": "${systemFields}",
            "permissions": ["${entityName}:admin"]
          }
        ]
      },
      "dataSource": "detail-data",
      "layout": {
        "container": "grid",
        "grid": {
          "columns": "2fr 1fr",
          "gap": "1.5rem"
        },
        "responsive": {
          "sm": "1fr",
          "md": "1fr", 
          "lg": "2fr 1fr"
        },
        "classes": ["max-w-7xl", "mx-auto"]
      }
    },
    {
      "id": "sidebar-widgets",
      "type": "layout.sidebar",
      "children": [
        {
          "id": "quick-actions",
          "type": "molecules.base-card",
          "props": {
            "title": "Quick Actions",
            "variant": "default"
          },
          "children": [
            {
              "id": "action-buttons",
              "type": "molecules.button-group",
              "props": {
                "orientation": "vertical",
                "actions": [
                  {
                    "id": "print-record",
                    "actionType": "ajax",
                    "label": "Print",
                    "icon": "printer",
                    "level": "secondary",
                    "size": "sm",
                    "api": {
                      "method": "GET",
                      "url": "/api/${entityPath}/${data.id}/print"
                    }
                  },
                  {
                    "id": "export-record",
                    "actionType": "ajax",
                    "label": "Export",
                    "icon": "download",
                    "level": "secondary", 
                    "size": "sm",
                    "api": {
                      "method": "GET",
                      "url": "/api/${entityPath}/${data.id}/export"
                    }
                  },
                  {
                    "id": "share-record",
                    "actionType": "dialog",
                    "label": "Share",
                    "icon": "share",
                    "level": "secondary",
                    "size": "sm",
                    "dialog": {
                      "title": "Share ${entityTitle}",
                      "size": "md",
                      "body": {
                        "type": "form",
                        "form": {
                          "body": [
                            {
                              "type": "atoms.input",
                              "name": "email",
                              "label": "Email Address",
                              "placeholder": "Enter email address",
                              "validations": [{"isEmail": true, "required": true}]
                            },
                            {
                              "type": "atoms.textarea",
                              "name": "message",
                              "label": "Message (Optional)",
                              "placeholder": "Add a personal message"
                            }
                          ]
                        }
                      },
                      "actions": [
                        {
                          "id": "send-share",
                          "actionType": "ajax",
                          "label": "Send",
                          "level": "primary",
                          "api": {
                            "method": "POST",
                            "url": "/api/${entityPath}/${data.id}/share"
                          },
                          "close": true
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "related-data",
          "type": "molecules.base-card",
          "props": {
            "title": "Related Data",
            "variant": "default"
          },
          "children": [
            {
              "id": "relationships-list",
              "type": "organisms.relationship-list",
              "props": {
                "relationships": "${relationshipData}",
                "compact": true
              },
              "dataSource": "relationships-data"
            }
          ],
          "visibleOn": "${hasRelationships}"
        },
        {
          "id": "activity-timeline",
          "type": "molecules.base-card",
          "props": {
            "title": "Recent Activity",
            "variant": "default"
          },
          "children": [
            {
              "id": "activity-feed",
              "type": "organisms.activity-timeline",
              "props": {
                "limit": 10,
                "showMore": true,
                "compact": true
              },
              "dataSource": "activity-data"
            }
          ],
          "visibleOn": "${hasAuditTrail}",
          "permissions": ["${entityName}:audit"]
        },
        {
          "id": "status-widget",
          "type": "molecules.base-card",
          "props": {
            "title": "Status",
            "variant": "default"
          },
          "children": [
            {
              "id": "status-display",
              "type": "atoms.badge",
              "props": {
                "text": "${data.status}",
                "variant": "${getStatusVariant(data.status)}",
                "size": "lg"
              }
            },
            {
              "id": "status-actions",
              "type": "molecules.button-group",
              "props": {
                "orientation": "vertical",
                "size": "sm",
                "actions": "${statusActions}"
              },
              "permissions": ["${entityName}:update"],
              "visibleOn": "${hasWorkflow && !readonly}"
            }
          ],
          "visibleOn": "${hasStatus}"
        }
      ],
      "layout": {
        "container": "flex",
        "flex": {
          "direction": "column",
          "gap": "1.5rem"
        }
      }
    }
  ],
  "dataSources": [
    {
      "id": "detail-data",
      "type": "api",
      "endpoint": "/api/${entityPath}/${id}",
      "method": "GET",
      "cache": {
        "ttl": "5m",
        "key": "${entityName}-detail-${id}"
      },
      "refresh": {
        "interval": "30s",
        "trigger": "visibility"
      }
    },
    {
      "id": "relationships-data",
      "type": "api",
      "endpoint": "/api/${entityPath}/${id}/relationships",
      "method": "GET",
      "cache": {
        "ttl": "10m",
        "key": "${entityName}-relationships-${id}"
      }
    },
    {
      "id": "activity-data",
      "type": "api", 
      "endpoint": "/api/${entityPath}/${id}/activity",
      "method": "GET",
      "parameters": {
        "limit": "10"
      },
      "cache": {
        "ttl": "2m",
        "key": "${entityName}-activity-${id}"
      }
    }
  ],
  "actions": [
    {
      "id": "refresh-all",
      "actionType": "reload",
      "label": "Refresh",
      "icon": "refresh",
      "reload": ["detail-data", "relationships-data", "activity-data"]
    }
  ],
  "permissions": {
    "requiredPermissions": ["${entityName}:read"]
  },
  "htmx": {
    "timeout": 10000,
    "historyEnabled": true,
    "defaultSwapStyle": "innerHTML"
  },
  "alpine": {
    "stores": {
      "detailState": "{ activeTab: 'basic-info', showSidebar: true }"
    }
  },
  "meta": {
    "template": "detail_view",
    "version": "1.0.0",
    "capabilities": [
      "sectioned_layout",
      "audit_trail",
      "relationship_display",
      "activity_timeline",
      "quick_actions",
      "status_management",
      "print_export",
      "sharing",
      "responsive_design"
    ],
    "field_types": [
      "text",
      "number",
      "date",
      "datetime",
      "boolean",
      "email",
      "url",
      "phone",
      "currency",
      "percentage",
      "image",
      "file",
      "rich_text",
      "json",
      "array",
      "relationship"
    ],
    "responsive": true,
    "accessibility": {
      "screen_reader": true,
      "keyboard_navigation": true,
      "aria_labels": true,
      "focus_management": true,
      "skip_links": true
    }
  }
}