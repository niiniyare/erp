package layout

templ Base(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - Awo ERP Admin</title>
		<script src="https://unpkg.com/htmx.org@1.9.10"></script>
		<script src="https://cdn.tailwindcss.com"></script>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
		<style>
			.htmx-request { opacity: 0.5; }
			.htmx-swapping { opacity: 0; }
		</style>
	</head>
	<body class="bg-gray-50">
		@Header()
		<div class="flex">
			@Sidebar()
			<main class="flex-1 p-6">
				@content
			</main>
		</div>
		@Footer()
	</body>
	</html>
}

templ Header() {
	<header class="bg-gradient-to-r from-blue-600 to-purple-600 text-white shadow-lg">
		<div class="px-6 py-4">
			<div class="flex justify-between items-center">
				<h1 class="text-xl font-bold">
					<i class="fas fa-cogs mr-2"></i>
					Awo ERP Admin Dashboard
				</h1>
				<div class="flex items-center space-x-4">
					<button class="text-white hover:bg-white hover:bg-opacity-20 px-3 py-2 rounded">
						<i class="fas fa-bell"></i>
					</button>
					<div class="relative group">
						<button class="flex items-center space-x-2 text-white hover:bg-white hover:bg-opacity-20 px-3 py-2 rounded">
							<i class="fas fa-user"></i>
							<span>Admin</span>
							<i class="fas fa-chevron-down"></i>
						</button>
						<div class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50 hidden group-hover:block">
							<a href="/admin/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Profile</a>
							<a href="/admin/settings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Settings</a>
							<div class="border-t border-gray-100"></div>
							<a href="/logout" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Logout</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</header>
}

templ Sidebar() {
	<aside class="w-64 bg-white shadow-lg h-screen">
		<nav class="mt-8">
			@SidebarItem("/admin/dashboard", "fas fa-tachometer-alt", "Dashboard", true)
			@SidebarGroup("Tenant Management", "fas fa-building", []SidebarLink{
				{URL: "/admin/tenants", Label: "All Tenants"},
				{URL: "/admin/tenants/create", Label: "Create Tenant"},
				{URL: "/admin/tenants/analytics", Label: "Analytics"},
			})
			@SidebarGroup("User Management", "fas fa-users", []SidebarLink{
				{URL: "/admin/users", Label: "All Users"},
				{URL: "/admin/users/roles", Label: "User Roles"},
				{URL: "/admin/users/permissions", Label: "Permissions"},
			})
			@SidebarGroup("Finance", "fas fa-chart-line", []SidebarLink{
				{URL: "/admin/finance/accounts", Label: "Accounts"},
				{URL: "/admin/finance/transactions", Label: "Transactions"},
				{URL: "/admin/finance/reports", Label: "Reports"},
			})
			@SidebarGroup("System", "fas fa-cog", []SidebarLink{
				{URL: "/admin/system/flags", Label: "Feature Flags"},
				{URL: "/admin/system/audit", Label: "Audit Logs"},
				{URL: "/admin/system/settings", Label: "Settings"},
			})
		</nav>
	</aside>
}

type SidebarLink struct {
	URL   string
	Label string
}

templ SidebarItem(url, icon, label string, active bool) {
	<a href={ templ.URL(url) } class={ "flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 hover:text-blue-600", templ.KV("bg-blue-50 text-blue-600 border-r-2 border-blue-600", active) }>
		<i class={ icon, "mr-3" }></i>
		<span>{ label }</span>
	</a>
}

templ SidebarGroup(title, icon string, links []SidebarLink) {
	<div x-data="{ open: false }">
		<button @click="open = !open" class="w-full flex items-center justify-between px-6 py-3 text-gray-700 hover:bg-gray-100 hover:text-blue-600">
			<div class="flex items-center">
				<i class={ icon, "mr-3" }></i>
				<span>{ title }</span>
			</div>
			<i class="fas fa-chevron-down transform transition-transform" :class="{'rotate-180': open}"></i>
		</button>
		<div x-show="open" x-transition class="bg-gray-50">
			for _, link := range links {
				<a href={ templ.URL(link.URL) } class="block pl-12 pr-6 py-2 text-sm text-gray-600 hover:bg-gray-100 hover:text-blue-600">
					{ link.Label }
				</a>
			}
		</div>
	</div>
}

templ Footer() {
	<script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
}