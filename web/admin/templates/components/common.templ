package components

templ StatCard(title, subtitle, value, icon, color string) {
	<div class="bg-white rounded-lg shadow p-6">
		<div class="flex items-center">
			<div class="flex-shrink-0">
				<div class={ "w-12 h-12 rounded-full flex items-center justify-center", getColorClass(color) }>
					<i class={ icon, "text-white text-xl" }></i>
				</div>
			</div>
			<div class="ml-4 flex-1">
				<div class="text-2xl font-bold text-gray-900">{ value }</div>
				<div class="text-sm font-medium text-gray-900">{ title }</div>
				<div class="text-sm text-gray-500">{ subtitle }</div>
			</div>
		</div>
	</div>
}

templ StatusBadge(status string) {
	<span class={ "inline-flex px-2 py-1 text-xs font-semibold rounded-full", getStatusClass(status) }>
		{ status }
	</span>
}

templ LoadingSpinner() {
	<div class="flex justify-center items-center p-4">
		<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
	</div>
}

templ ErrorMessage(message string) {
	<div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
		<div class="flex">
			<i class="fas fa-exclamation-triangle text-red-500 mr-2"></i>
			<span class="text-red-800">{ message }</span>
		</div>
	</div>
}

templ SuccessMessage(message string) {
	<div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
		<div class="flex">
			<i class="fas fa-check-circle text-green-500 mr-2"></i>
			<span class="text-green-800">{ message }</span>
		</div>
	</div>
}

templ Button(text, variant, size string, disabled bool) {
	<button 
		class={ getButtonClass(variant, size), templ.KV("opacity-50 cursor-not-allowed", disabled) }
		if disabled {
			disabled
		}
	>
		{ text }
	</button>
}

templ ButtonWithIcon(text, icon, variant, size string, disabled bool) {
	<button 
		class={ getButtonClass(variant, size), templ.KV("opacity-50 cursor-not-allowed", disabled) }
		if disabled {
			disabled
		}
	>
		<i class={ icon, "mr-2" }></i>
		{ text }
	</button>
}

templ Modal(id, title string, content templ.Component) {
	<div id={ id } class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
		<div class="relative top-20 mx-auto p-5 border w-11/12 md:w-3/4 lg:w-1/2 shadow-lg rounded-md bg-white">
			<div class="flex justify-between items-center pb-3">
				<h3 class="text-lg font-bold text-gray-900">{ title }</h3>
				<button onclick={ "document.getElementById('" + id + "').classList.add('hidden')" } class="text-gray-400 hover:text-gray-600">
					<i class="fas fa-times"></i>
				</button>
			</div>
			<div class="mt-3">
				@content
			</div>
		</div>
	</div>
}

func getColorClass(color string) string {
	switch color {
	case "blue":
		return "bg-blue-600"
	case "green":
		return "bg-green-600"
	case "yellow":
		return "bg-yellow-600"
	case "red":
		return "bg-red-600"
	case "indigo":
		return "bg-indigo-600"
	case "purple":
		return "bg-purple-600"
	default:
		return "bg-gray-600"
	}
}

func getStatusClass(status string) string {
	switch status {
	case "success", "Success", "ACTIVE", "Active":
		return "bg-green-100 text-green-800"
	case "warning", "Warning", "PENDING", "Pending":
		return "bg-yellow-100 text-yellow-800"
	case "error", "Error", "SUSPENDED", "Suspended":
		return "bg-red-100 text-red-800"
	case "info", "Info", "complete", "Complete":
		return "bg-blue-100 text-blue-800"
	default:
		return "bg-gray-100 text-gray-800"
	}
}

func getButtonClass(variant, size string) string {
	baseClass := "inline-flex items-center border font-medium rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors"
	
	var variantClass string
	switch variant {
	case "primary":
		variantClass = "border-transparent bg-blue-600 text-white hover:bg-blue-700 focus:ring-blue-500"
	case "secondary":
		variantClass = "border-gray-300 bg-white text-gray-700 hover:bg-gray-50 focus:ring-blue-500"
	case "danger":
		variantClass = "border-transparent bg-red-600 text-white hover:bg-red-700 focus:ring-red-500"
	case "success":
		variantClass = "border-transparent bg-green-600 text-white hover:bg-green-700 focus:ring-green-500"
	default:
		variantClass = "border-gray-300 bg-white text-gray-700 hover:bg-gray-50 focus:ring-blue-500"
	}
	
	var sizeClass string
	switch size {
	case "sm":
		sizeClass = "px-3 py-2 text-sm"
	case "lg":
		sizeClass = "px-6 py-3 text-lg"
	default:
		sizeClass = "px-4 py-2 text-sm"
	}
	
	return baseClass + " " + variantClass + " " + sizeClass
}