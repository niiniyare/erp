package pages

import "github.com/niiniyare/erp/web/admin/templates/layout"
import "github.com/niiniyare/erp/web/admin/templates/components"

type Tenant struct {
	ID          string
	Name        string
	Subdomain   string
	Status      string
	PlanType    string
	Industry    string
	CreatedAt   string
	UpdatedAt   string
	Email       string
	ContactEmail string
}

templ TenantList(tenants []Tenant) {
	@layout.Base("Tenant Management", TenantListContent(tenants))
}

templ TenantListContent(tenants []Tenant) {
	<div class="space-y-6">
		<div class="flex justify-between items-center">
			<div>
				<h1 class="text-2xl font-bold text-gray-900">Tenant Management</h1>
				<p class="text-gray-600">Manage all tenants in the system</p>
			</div>
			<div class="flex space-x-2">
				<button 
					onclick="document.getElementById('createTenantModal').classList.remove('hidden')"
					class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 flex items-center"
				>
					<i class="fas fa-plus mr-2"></i>
					Create Tenant
				</button>
				<button class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 flex items-center">
					<i class="fas fa-download mr-2"></i>
					Export
				</button>
			</div>
		</div>

		<!-- Search and Filters -->
		<div class="bg-white rounded-lg shadow p-4">
			<div class="flex flex-wrap gap-4 items-center">
				<div class="flex-1 min-w-64">
					<input 
						type="text" 
						placeholder="Search tenants..." 
						class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
						hx-get="/admin/tenants/search"
						hx-trigger="keyup changed delay:300ms"
						hx-target="#tenantTable"
					/>
				</div>
				<select class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
					<option value="">All Status</option>
					<option value="ACTIVE">Active</option>
					<option value="PENDING">Pending</option>
					<option value="SUSPENDED">Suspended</option>
					<option value="ARCHIVED">Archived</option>
				</select>
				<button 
					class="bg-gray-100 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-200"
					hx-get="/admin/tenants"
					hx-target="#tenantTable"
				>
					<i class="fas fa-sync-alt mr-2"></i>
					Refresh
				</button>
			</div>
		</div>

		<!-- Tenant Table -->
		<div class="bg-white rounded-lg shadow">
			<div id="tenantTable">
				@TenantTable(tenants)
			</div>
		</div>
	</div>

	<!-- Create Tenant Modal -->
	@components.Modal("createTenantModal", "Create New Tenant", CreateTenantForm())
}

templ TenantTable(tenants []Tenant) {
	<div class="overflow-x-auto">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tenant</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subdomain</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Plan</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				for _, tenant := range tenants {
					<tr class="hover:bg-gray-50">
						<td class="px-6 py-4 whitespace-nowrap">
							<div class="flex items-center">
								<div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
									<i class="fas fa-building text-blue-600"></i>
								</div>
								<div class="ml-4">
									<div class="text-sm font-medium text-gray-900">{ tenant.Name }</div>
									<div class="text-sm text-gray-500">{ tenant.ID }</div>
								</div>
							</div>
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{ tenant.Subdomain }</td>
						<td class="px-6 py-4 whitespace-nowrap">
							@components.StatusBadge(tenant.Status)
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{ tenant.PlanType }</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ tenant.CreatedAt }</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
							<div class="flex items-center space-x-2">
								<button 
									class="text-blue-600 hover:text-blue-900"
									hx-get={ "/admin/tenants/" + tenant.ID }
									hx-target="#viewTenantModal .modal-content"
									onclick="document.getElementById('viewTenantModal').classList.remove('hidden')"
								>
									<i class="fas fa-eye"></i>
								</button>
								<button 
									class="text-indigo-600 hover:text-indigo-900"
									hx-get={ "/admin/tenants/" + tenant.ID + "/edit" }
									hx-target="#editTenantModal .modal-content"
									onclick="document.getElementById('editTenantModal').classList.remove('hidden')"
								>
									<i class="fas fa-edit"></i>
								</button>
								<div class="relative group">
									<button class="text-gray-400 hover:text-gray-600">
										<i class="fas fa-ellipsis-v"></i>
									</button>
									<div class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-10 hidden group-hover:block">
										if tenant.Status == "ACTIVE" {
											<button 
												class="block w-full text-left px-4 py-2 text-sm text-yellow-700 hover:bg-yellow-50"
												hx-post={ "/admin/tenants/" + tenant.ID + "/suspend" }
												hx-confirm="Are you sure you want to suspend this tenant?"
												hx-target="#tenantTable"
											>
												<i class="fas fa-pause mr-2"></i>Suspend
											</button>
										}
										if tenant.Status == "SUSPENDED" {
											<button 
												class="block w-full text-left px-4 py-2 text-sm text-green-700 hover:bg-green-50"
												hx-post={ "/admin/tenants/" + tenant.ID + "/reactivate" }
												hx-confirm="Are you sure you want to reactivate this tenant?"
												hx-target="#tenantTable"
											>
												<i class="fas fa-play mr-2"></i>Reactivate
											</button>
										}
										<a href={ templ.URL("/admin/tenants/" + tenant.ID + "/analytics") } class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
											<i class="fas fa-chart-bar mr-2"></i>Analytics
										</a>
									</div>
								</div>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ CreateTenantForm() {
	<form 
		hx-post="/admin/tenants" 
		hx-target="#tenantTable"
		hx-on="htmx:afterRequest: if(event.detail.successful) document.getElementById('createTenantModal').classList.add('hidden')"
		class="space-y-4"
	>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Tenant Name</label>
				<input 
					type="text" 
					name="name" 
					required 
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
					placeholder="Enter tenant name"
				/>
			</div>
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Subdomain</label>
				<input 
					type="text" 
					name="subdomain" 
					required 
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
					placeholder="Enter subdomain"
				/>
			</div>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Admin Email</label>
				<input 
					type="email" 
					name="email" 
					required 
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
					placeholder="admin@tenant.com"
				/>
			</div>
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Contact Email</label>
				<input 
					type="email" 
					name="contact_email" 
					required 
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
					placeholder="contact@tenant.com"
				/>
			</div>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
				<select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
					<option value="ACTIVE">Active</option>
					<option value="PENDING">Pending</option>
					<option value="SUSPENDED">Suspended</option>
				</select>
			</div>
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Company Size</label>
				<select name="company_size" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
					<option value="Startup">Startup</option>
					<option value="Small">Small</option>
					<option value="Medium">Medium</option>
					<option value="Large">Large</option>
					<option value="Enterprise">Enterprise</option>
				</select>
			</div>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Country Code</label>
				<input 
					type="text" 
					name="country_code" 
					value="US" 
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
					placeholder="US"
				/>
			</div>
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Currency</label>
				<input 
					type="text" 
					name="currency_code" 
					value="USD" 
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
					placeholder="USD"
				/>
			</div>
		</div>

		<div>
			<label class="block text-sm font-medium text-gray-700 mb-1">Industry</label>
			<input 
				type="text" 
				name="industry" 
				class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
				placeholder="Technology, Healthcare, etc."
			/>
		</div>

		<div>
			<label class="block text-sm font-medium text-gray-700 mb-1">Timezone</label>
			<input 
				type="text" 
				name="timezone" 
				value="UTC" 
				class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
				placeholder="UTC"
			/>
		</div>

		<div class="flex justify-end space-x-2 pt-4">
			<button 
				type="button" 
				onclick="document.getElementById('createTenantModal').classList.add('hidden')"
				class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50"
			>
				Cancel
			</button>
			<button 
				type="submit" 
				class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700"
			>
				Create Tenant
			</button>
		</div>
	</form>
}