// RenderSchemaTable demonstrates table rendering from schema
templ RenderSchemaTable() {
	{{ 
		ctx := context.Background()
		registry, _ := engine.NewEnhancedComponentRegistry("docs/ui/Schema")
		props := map[string]interface{}{
			"columns": []interface{}{
				map[string]interface{}{"name": "id", "label": "ID"},
				map[string]interface{}{"name": "name", "label": "Name"},
				map[string]interface{}{"name": "email", "label": "Email"},
			},
		}
		component, err := registry.RenderToTempl(ctx, "TableSchema", props)
		if err != nil {
			// Fallback rendering
		}
	}}
	if component != nil {
		@component
	} else {
		<table class="table table-striped mb-4">
			<thead>
				<tr>
					<th>ID</th>
					<th>Name</th>
					<th>Email</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td>1</td>
					<td>John Doe</td>
					<td>john@example.com</td>
					<td><button class="btn btn-sm btn-primary">Edit</button></td>
				</tr>
			</tbody>
		</table>
	}
}

