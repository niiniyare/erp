		props := map[string]interface{}{
			"items": []interface{}{
				"Schema-driven list item 1",
				"Schema-driven list item 2", 
				"Schema-driven list item 3",
			},
		}
		component, err := registry.RenderToTempl(ctx, "ListSchema", props)
