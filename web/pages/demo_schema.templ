	}}
	if component != nil {
		@component
	} else {
		<ul class="list-group">
			<li class="list-group-item">Schema-driven list item 1</li>
			<li class="list-group-item">Schema-driven list item 2</li>
			<li class="list-group-item">Schema-driven list item 3</li>
		</ul>
	}
}