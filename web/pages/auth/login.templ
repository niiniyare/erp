package auth

import (
	"github.com/niiniyare/erp/web/components/atoms"
	"github.com/niiniyare/erp/web/components/molecules"
	"github.com/niiniyare/erp/web/layouts"
)

// LoginPageProps defines properties for the login page
type LoginPageProps struct {
	Title           string            `json:"title"`
	Subtitle        string            `json:"subtitle,omitempty"`
	RedirectURL     string            `json:"redirectUrl,omitempty"`
	Errors          map[string]string `json:"errors,omitempty"`
	ShowRememberMe  bool              `json:"showRememberMe"`
	ShowForgotLink  bool              `json:"showForgotLink"`
	ShowRegisterLink bool             `json:"showRegisterLink"`
	OrganizationName string           `json:"organizationName,omitempty"`
	LogoURL         string            `json:"logoUrl,omitempty"`
	HxPost          string            `json:"hxPost,omitempty"`
	HxTarget        string            `json:"hxTarget,omitempty"`
}

// LoginPage renders the complete login page with auth layout
templ LoginPage(props LoginPageProps) {
	@layouts.AuthLayout(layouts.AuthLayoutProps{
		Base: layouts.BaseLayoutProps{
			Title:       getPageTitle(props.Title),
			Description: "Secure login to your ERP account",
			ThemeMode:   "system",
		},
		FormTitle:   props.Title,
		AppName:     props.OrganizationName,
		AppLogo:     props.LogoURL,
	}, LoginForm(props))
}

// LoginForm renders the login form component
templ LoginForm(props LoginPageProps) {
	<div class="w-full max-w-md space-y-6">
		<!-- Header -->
		<div class="text-center">
			<h2 class="text-3xl font-bold text-gray-900 dark:text-white">
				{ props.Title }
			</h2>
			if props.Subtitle != "" {
				<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
					{ props.Subtitle }
				</p>
			}
		</div>

		<!-- Login Form -->
		<form 
			class="space-y-6" 
			action="/auth/login" 
			method="POST"
			if props.HxPost != "" {
				hx-post={ props.HxPost }
			}
			if props.HxTarget != "" {
				hx-target={ props.HxTarget }
			}
			hx-swap="innerHTML"
			hx-indicator="#login-loading"
		>
			<!-- CSRF Token -->
			<input type="hidden" name="csrf_token" value="__CSRF_TOKEN__" />
			
			if props.RedirectURL != "" {
				<input type="hidden" name="redirect_url" value={ props.RedirectURL } />
			}

			<!-- Email Field -->
			<div>
				@molecules.Field(molecules.FieldProps{
					Type:        molecules.FieldTypeInput,
					Label:       "Email Address",
					Name:        "email",
					Placeholder: "Enter your email",
					Required:    true,
					InputType:   atoms.InputEmail,
					ID:          "email",
					ErrorText:   getFieldError(props.Errors, "email"),
					Class:       "w-full",
				})
			</div>

			<!-- Password Field -->
			<div>
				@molecules.Field(molecules.FieldProps{
					Type:        molecules.FieldTypeInput,
					Label:       "Password", 
					Name:        "password",
					Placeholder: "Enter your password",
					Required:    true,
					InputType:   atoms.InputPassword,
					ID:          "password",
					ErrorText:   getFieldError(props.Errors, "password"),
					Class:       "w-full",
				})
			</div>

			<!-- Remember Me & Forgot Password -->
			<div class="flex items-center justify-between">
				if props.ShowRememberMe {
					<div class="flex items-center">
						@atoms.Checkbox(atoms.CheckboxProps{
							ID:    "remember_me",
							Name:  "remember_me",
							Value: "true",
							Label: "Remember me",
						})
					</div>
				}

				if props.ShowForgotLink {
					<div class="text-sm">
						<a 
							href="/auth/forgot-password" 
							class="font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300"
						>
							Forgot your password?
						</a>
					</div>
				}
			</div>

			<!-- General Error Display -->
			if getFieldError(props.Errors, "general") != "" {
				<div class="rounded-md bg-red-50 dark:bg-red-900/50 p-4">
					<div class="text-sm text-red-700 dark:text-red-200">
						{ getFieldError(props.Errors, "general") }
					</div>
				</div>
			}

			<!-- Submit Button -->
			<div>
				@atoms.Button(atoms.ButtonProps{
					Text:     "Sign In",
					Type:     "submit",
					Variant:  atoms.ButtonPrimary,
					Size:     atoms.ButtonSizeLG,
					Class:    "w-full",
					Loading:  false,
				})
			</div>

			<!-- Loading Indicator -->
			<div id="login-loading" class="htmx-indicator">
				<div class="flex items-center justify-center">
					@atoms.Spinner(atoms.SpinnerProps{
						Size:  atoms.SpinnerSizeSM,
						Color: "blue",
					})
					<span class="ml-2 text-sm text-gray-600 dark:text-gray-400">
						Signing you in...
					</span>
				</div>
			</div>
		</form>

		<!-- Register Link -->
		if props.ShowRegisterLink {
			<div class="text-center">
				<p class="text-sm text-gray-600 dark:text-gray-400">
					Don't have an account?
					<a 
						href="/auth/register" 
						class="font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300"
					>
						Sign up
					</a>
				</p>
			</div>
		}
	</div>
}

// Helper functions
func getPageTitle(title string) string {
	if title == "" {
		return "Sign In - ERP System"
	}
	return title + " - ERP System"
}

func getFieldError(errors map[string]string, field string) string {
	if errors == nil {
		return ""
	}
	return errors[field]
}