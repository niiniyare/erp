package auth

import (
	"github.com/niiniyare/erp/web/components/atoms"
	"github.com/niiniyare/erp/web/components/molecules"
	"github.com/niiniyare/erp/web/layouts"
)

// ForgotPasswordPageProps defines properties for the forgot password page
type ForgotPasswordPageProps struct {
	Title            string            `json:"title"`
	Subtitle         string            `json:"subtitle,omitempty"`
	Errors           map[string]string `json:"errors,omitempty"`
	Success          bool              `json:"success"`
	SuccessMessage   string            `json:"successMessage,omitempty"`
	ShowLoginLink    bool              `json:"showLoginLink"`
	OrganizationName string            `json:"organizationName,omitempty"`
	LogoURL          string            `json:"logoUrl,omitempty"`
	HxPost           string            `json:"hxPost,omitempty"`
	HxTarget         string            `json:"hxTarget,omitempty"`
}

// ForgotPasswordPage renders the complete forgot password page with auth layout
templ ForgotPasswordPage(props ForgotPasswordPageProps) {
	@layouts.AuthLayout(layouts.AuthLayoutProps{
		Base: layouts.BaseLayoutProps{
			Title:       getForgotPasswordPageTitle(props.Title),
			Description: "Reset your ERP account password",
			ThemeMode:   "system",
		},
		FormTitle:   props.Title,
		AppName:     props.OrganizationName,
		AppLogo:     props.LogoURL,
	}, ForgotPasswordForm(props))
}

// ForgotPasswordForm renders the forgot password form component
templ ForgotPasswordForm(props ForgotPasswordPageProps) {
	<div class="w-full max-w-md space-y-6">
		<!-- Header -->
		<div class="text-center">
			<h2 class="text-3xl font-bold text-gray-900 dark:text-white">
				{ props.Title }
			</h2>
			if props.Subtitle != "" {
				<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
					{ props.Subtitle }
				</p>
			}
		</div>

		if props.Success {
			<!-- Success State -->
			<div class="rounded-md bg-green-50 dark:bg-green-900/50 p-4">
				<div class="flex">
					<div class="flex-shrink-0">
						@atoms.Icon(atoms.IconProps{
							Name:  "check-circle",
							Size:  atoms.IconSizeSM,
							Class: "text-green-400",
						})
					</div>
					<div class="ml-3">
						<h3 class="text-sm font-medium text-green-800 dark:text-green-200">
							Email sent successfully
						</h3>
						<div class="mt-2 text-sm text-green-700 dark:text-green-300">
							{ getSuccessMessage(props.SuccessMessage) }
						</div>
					</div>
				</div>
			</div>

			<!-- Login Link -->
			if props.ShowLoginLink {
				<div class="text-center">
					<p class="text-sm text-gray-600 dark:text-gray-400">
						Remember your password?
						<a 
							href="/auth/login" 
							class="font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300"
						>
							Sign in
						</a>
					</p>
				</div>
			}
		} else {
			<!-- Form State -->
			<form 
				class="space-y-6" 
				action="/auth/forgot-password" 
				method="POST"
				if props.HxPost != "" {
					hx-post={ props.HxPost }
				}
				if props.HxTarget != "" {
					hx-target={ props.HxTarget }
				}
				hx-swap="innerHTML"
				hx-indicator="#reset-loading"
			>
				<!-- CSRF Token -->
				<input type="hidden" name="csrf_token" value="__CSRF_TOKEN__" />

				<!-- Email Field -->
				<div>
					@molecules.Field(molecules.FieldProps{
						Type:        molecules.FieldTypeInput,
						Label:       "Email Address",
						Name:        "email",
						Placeholder: "Enter your email address",
						Required:    true,
						InputType:   atoms.InputEmail,
						ID:          "email",
						ErrorText:   getFieldError(props.Errors, "email"),
						HelpText:    "We'll send you a link to reset your password",
						Class:       "w-full",
					})
				</div>

				<!-- General Error Display -->
				if getFieldError(props.Errors, "general") != "" {
					<div class="rounded-md bg-red-50 dark:bg-red-900/50 p-4">
						<div class="text-sm text-red-700 dark:text-red-200">
							{ getFieldError(props.Errors, "general") }
						</div>
					</div>
				}

				<!-- Submit Button -->
				<div>
					@atoms.Button(atoms.ButtonProps{
						Text:     "Send Reset Link",
						Type:     "submit",
						Variant:  atoms.ButtonPrimary,
						Size:     atoms.ButtonSizeLG,
						Class:    "w-full",
						Loading:  false,
					})
				</div>

				<!-- Loading Indicator -->
				<div id="reset-loading" class="htmx-indicator">
					<div class="flex items-center justify-center">
						@atoms.Spinner(atoms.SpinnerProps{
							Size:  atoms.SpinnerSizeSM,
							Color: "blue",
						})
						<span class="ml-2 text-sm text-gray-600 dark:text-gray-400">
							Sending reset link...
						</span>
					</div>
				</div>
			</form>

			<!-- Login Link -->
			if props.ShowLoginLink {
				<div class="text-center">
					<p class="text-sm text-gray-600 dark:text-gray-400">
						Remember your password?
						<a 
							href="/auth/login" 
							class="font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300"
						>
							Back to sign in
						</a>
					</p>
				</div>
			}
		}
	</div>
}

// Helper functions
func getForgotPasswordPageTitle(title string) string {
	if title == "" {
		return "Reset Password - ERP System"
	}
	return title + " - ERP System"
}

func getSuccessMessage(message string) string {
	if message == "" {
		return "We've sent a password reset link to your email address. Please check your inbox and follow the instructions to reset your password."
	}
	return message
}