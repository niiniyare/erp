package dashboard

import (
	"github.com/niiniyare/erp/web/components/features/dashboard"
	"github.com/niiniyare/erp/web/layouts"
)

// DashboardIndexProps defines properties for the main dashboard page
type DashboardIndexProps struct {
	// Page metadata
	Title       string `json:"title"`
	Subtitle    string `json:"subtitle,omitempty"`
	
	// Dashboard widgets
	SummaryCards  dashboard.SummaryCardsProps  `json:"summaryCards"`
	RecentActivity dashboard.RecentActivityProps `json:"recentActivity"`
	QuickActions  dashboard.QuickActionsProps  `json:"quickActions"`
	
	// Layout props
	LayoutProps layouts.AppLayoutProps `json:"layoutProps"`
	
	// Permissions
	CanViewAnalytics bool `json:"canViewAnalytics"`
	CanManageUsers   bool `json:"canManageUsers"`
	CanExportData    bool `json:"canExportData"`
}

// DashboardIndexPage renders the main dashboard page
templ DashboardIndexPage(props DashboardIndexProps) {
	@layouts.AppLayout(props.LayoutProps, DashboardContent(props))
}

// DashboardContent renders the dashboard main content
templ DashboardContent(props DashboardIndexProps) {
	<div class="space-y-6">
		<!-- Page Header -->
		<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
			<div>
				<h1 class="text-2xl font-bold text-gray-900 dark:text-white">
					{ props.Title }
				</h1>
				if props.Subtitle != "" {
					<p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
						{ props.Subtitle }
					</p>
				}
			</div>
			
			<!-- Quick Actions in Header -->
			<div class="mt-4 sm:mt-0">
				@dashboard.QuickActions(dashboard.QuickActionsProps{
					Title: "Quick Actions",
					Categories: []dashboard.ActionCategory{
						{
							Name: "Common Tasks",
							Actions: getHeaderQuickActions(props.CanManageUsers, props.CanExportData),
						},
					},
					Layout: "compact",
					Compact: true,
				})
			</div>
		</div>

		<!-- Summary Cards Section -->
		<div class="grid grid-cols-1 gap-6">
			<div>
				<h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
					Overview
				</h2>
				@dashboard.SummaryCards(props.SummaryCards)
			</div>
		</div>

		<!-- Main Dashboard Grid -->
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<!-- Recent Activity Section (Left Column) -->
			<div class="lg:col-span-2">
				<div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
					<div class="p-6">
						<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
							Recent Activity
						</h3>
						@dashboard.RecentActivity(props.RecentActivity)
					</div>
				</div>
			</div>

			<!-- Quick Actions Section (Right Column) -->
			<div class="lg:col-span-1">
				<div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
					<div class="p-6">
						<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
							Quick Actions
						</h3>
						@dashboard.QuickActions(props.QuickActions)
					</div>
				</div>
			</div>
		</div>

		<!-- Analytics Section (if permitted) -->
		if props.CanViewAnalytics {
			<div class="grid grid-cols-1 gap-6">
				<div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
					<div class="p-6">
						<div class="flex items-center justify-between mb-4">
							<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
								Analytics Overview
							</h3>
							<a 
								href="/dashboard/analytics" 
								class="text-sm text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300"
							>
								View detailed analytics →
							</a>
						</div>
						
						<!-- Placeholder for analytics widgets -->
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
							<div class="p-4 bg-gray-50 dark:bg-gray-700 rounded-lg text-center">
								<div class="text-2xl font-bold text-gray-900 dark:text-white">
									$0
								</div>
								<div class="text-sm text-gray-600 dark:text-gray-400">
									Monthly Revenue
								</div>
							</div>
							<div class="p-4 bg-gray-50 dark:bg-gray-700 rounded-lg text-center">
								<div class="text-2xl font-bold text-gray-900 dark:text-white">
									0
								</div>
								<div class="text-sm text-gray-600 dark:text-gray-400">
									Active Users
								</div>
							</div>
							<div class="p-4 bg-gray-50 dark:bg-gray-700 rounded-lg text-center">
								<div class="text-2xl font-bold text-gray-900 dark:text-white">
									0
								</div>
								<div class="text-sm text-gray-600 dark:text-gray-400">
									Open Tasks
								</div>
							</div>
							<div class="p-4 bg-gray-50 dark:bg-gray-700 rounded-lg text-center">
								<div class="text-2xl font-bold text-gray-900 dark:text-white">
									0%
								</div>
								<div class="text-sm text-gray-600 dark:text-gray-400">
									System Health
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}

// Helper function to get header quick actions based on permissions
func getHeaderQuickActions(canManageUsers, canExportData bool) []dashboard.QuickAction {
	actions := []dashboard.QuickAction{
		{
			Text:     "New Invoice",
			Icon:     "plus",
			Color:    "blue",
			HxGet:    "/invoices/new",
			HxTarget: "#main-modal",
		},
	}
	
	if canManageUsers {
		actions = append(actions, dashboard.QuickAction{
			Text:     "Add User",
			Icon:     "user-plus",
			Color:    "green",
			HxGet:    "/users/new",
			HxTarget: "#main-modal",
		})
	}
	
	if canExportData {
		actions = append(actions, dashboard.QuickAction{
			Text:     "Export Data",
			Icon:     "download",
			Color:    "purple",
			OnClick:  "showExportModal()",
		})
	}
	
	return actions
}