package tenants

import (
	"fmt"
	"strings"
	"github.com/niiniyare/erp/web/layouts"
	"github.com/niiniyare/erp/web/components/features/tenant-management"
	"github.com/niiniyare/erp/web/components/atoms"
)

// DetailPageProps defines properties for the tenant detail page
type DetailPageProps struct {
	// Layout props
	Layout layouts.AppLayoutProps `json:"layout"`
	
	// Tenant data
	Tenant TenantDetail `json:"tenant"`
	
	// Related data
	Users    []TenantUser    `json:"users,omitempty"`
	Activity []TenantActivity `json:"activity,omitempty"`
	Usage    TenantUsage     `json:"usage"`
	
	// Permissions
	Permissions TenantPermissions `json:"permissions"`
	
	// Configuration
	ShowUsers    bool `json:"showUsers"`
	ShowActivity bool `json:"showActivity"`
	ShowUsage    bool `json:"showUsage"`
	ShowBilling  bool `json:"showBilling"`
}

// TenantDetail represents detailed tenant information
type TenantDetail struct {
	ID           string                 `json:"id"`
	Slug         string                 `json:"slug"`
	Name         string                 `json:"name"`
	Email        string                 `json:"email"`
	Subdomain    string                 `json:"subdomain,omitempty"`
	Status       string                 `json:"status"`
	Timezone     string                 `json:"timezone"`
	CurrencyCode string                 `json:"currency_code"`
	Industry     string                 `json:"industry,omitempty"`
	CompanySize  string                 `json:"company_size,omitempty"`
	Description  string                 `json:"description,omitempty"`
	Website      string                 `json:"website,omitempty"`
	Phone        string                 `json:"phone,omitempty"`
	Address      tenant_management.TenantAddress  `json:"address,omitempty"`
	Billing      tenant_management.TenantBilling  `json:"billing,omitempty"`
	Settings     tenant_management.TenantSettings `json:"settings,omitempty"`
	Metadata     map[string]interface{} `json:"metadata,omitempty"`
	CreatedAt    string                 `json:"created_at"`
	UpdatedAt    string                 `json:"updated_at"`
	LastLogin    string                 `json:"last_login,omitempty"`
}

// TenantUser represents a user within the tenant
type TenantUser struct {
	ID        string `json:"id"`
	Name      string `json:"name"`
	Email     string `json:"email"`
	Role      string `json:"role"`
	Status    string `json:"status"`
	LastLogin string `json:"last_login,omitempty"`
	Avatar    string `json:"avatar,omitempty"`
}

// TenantActivity represents tenant activity log
type TenantActivity struct {
	ID          string `json:"id"`
	Type        string `json:"type"`        // user_created, login, setting_changed, etc.
	Description string `json:"description"`
	UserName    string `json:"user_name,omitempty"`
	UserEmail   string `json:"user_email,omitempty"`
	IPAddress   string `json:"ip_address,omitempty"`
	Timestamp   string `json:"timestamp"`
	Metadata    map[string]interface{} `json:"metadata,omitempty"`
}

// TenantUsage represents tenant usage statistics
type TenantUsage struct {
	Users       TenantUsageMetric `json:"users"`
	Storage     TenantUsageMetric `json:"storage"`
	APIRequests TenantUsageMetric `json:"api_requests"`
	Logins      TenantUsageMetric `json:"logins"`
}

// TenantUsageMetric represents a usage metric
type TenantUsageMetric struct {
	Current int64 `json:"current"`
	Limit   int64 `json:"limit"`
	Unit    string `json:"unit"`
}

// Helper functions
func getInitials(name string) string {
	if name == "" {
		return ""
	}
	
	words := strings.Fields(name)
	if len(words) == 0 {
		return ""
	}
	
	var initials strings.Builder
	for i, word := range words {
		if i >= 2 { // Limit to 2 initials
			break
		}
		if len(word) > 0 {
			initials.WriteString(strings.ToUpper(string(word[0])))
		}
	}
	
	result := initials.String()
	if result == "" {
		return strings.ToUpper(string(name[0]))
	}
	return result
}

func formatNumber(num interface{}) string {
	switch v := num.(type) {
	case int:
		if v == 0 {
			return "Unlimited"
		}
		return fmt.Sprintf("%d", v)
	case int64:
		if v == 0 {
			return "Unlimited"
		}
		return fmt.Sprintf("%d", v)
	case float64:
		if v == 0 {
			return "Unlimited"
		}
		return fmt.Sprintf("%.0f", v)
	default:
		return fmt.Sprintf("%v", v)
	}
}

func formatFloat(f float64) string {
	return fmt.Sprintf("%.1f", f)
}

// TenantDetailPage renders the tenant detail page
templ TenantDetailPage(props DetailPageProps) {
	@layouts.AppLayout(props.Layout, TenantDetailContent(props))
}

// TenantDetailContent renders the tenant detail content
templ TenantDetailContent(props DetailPageProps) {
	<div class="space-y-6">
		<!-- Tenant Header -->
		@TenantDetailHeader(props.Tenant, props.Permissions)
		
		<!-- Main Content Grid -->
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<!-- Left Column: Main Information -->
			<div class="lg:col-span-2 space-y-6">
				<!-- Basic Information -->
				@TenantBasicInfoSection(props.Tenant)
				
				<!-- Users Section -->
				if props.ShowUsers && len(props.Users) > 0 {
					@TenantUsersSection(props.Users, props.Permissions)
				}
				
				<!-- Activity Section -->
				if props.ShowActivity && len(props.Activity) > 0 {
					@TenantActivitySection(props.Activity)
				}
			</div>
			
			<!-- Right Column: Sidebar Information -->
			<div class="space-y-6">
				<!-- Status & Quick Stats -->
				@TenantStatusSection(props.Tenant)
				
				<!-- Usage Metrics -->
				if props.ShowUsage {
					@TenantUsageSection(props.Usage)
				}
				
				<!-- Billing Information -->
				if props.ShowBilling && props.Tenant.Billing.PlanID != "" {
					@TenantBillingSection(props.Tenant.Billing)
				}
				
				<!-- Settings Summary -->
				@TenantSettingsSection(props.Tenant.Settings)
			</div>
		</div>
	</div>
}

// TenantDetailHeader renders the tenant header with actions
templ TenantDetailHeader(tenant TenantDetail, permissions TenantPermissions) {
	<div class="bg-white dark:bg-gray-800 shadow-sm rounded-lg border border-gray-200 dark:border-gray-700">
		<div class="px-6 py-4">
			<div class="flex items-center justify-between">
				<div class="flex items-center space-x-4">
					<!-- Tenant Avatar -->
					<div class="flex-shrink-0 h-16 w-16">
						<div class="h-16 w-16 rounded-lg bg-gray-300 dark:bg-gray-600 flex items-center justify-center">
							<span class="text-xl font-medium text-gray-700 dark:text-gray-300">
								{ getInitials(tenant.Name) }
							</span>
						</div>
					</div>
					
					<!-- Tenant Info -->
					<div>
						<div class="flex items-center space-x-3">
							<h1 class="text-2xl font-bold text-gray-900 dark:text-white">
								{ tenant.Name }
							</h1>
							@tenant_management.TenantStatusBadge(tenant.Status)
						</div>
						<div class="mt-1 flex items-center space-x-4 text-sm text-gray-500 dark:text-gray-400">
							<span class="flex items-center">
								@atoms.Icon(atoms.IconProps{
									Name:  "envelope",
									Size:  atoms.IconSizeXS,
									Class: "mr-1",
								})
								{ tenant.Email }
							</span>
							<span class="flex items-center">
								@atoms.Icon(atoms.IconProps{
									Name:  "globe-alt",
									Size:  atoms.IconSizeXS,
									Class: "mr-1",
								})
								{ tenant.Slug }
							</span>
							if tenant.Subdomain != "" {
								<span class="flex items-center">
									@atoms.Icon(atoms.IconProps{
										Name:  "link",
										Size:  atoms.IconSizeXS,
										Class: "mr-1",
									})
									{ tenant.Subdomain }.app.com
								</span>
							}
						</div>
					</div>
				</div>
				
				<!-- Actions -->
				<div class="flex items-center space-x-3">
					if permissions.CanEdit {
						@atoms.Button(atoms.ButtonProps{
							Text:     "Edit",
							Icon:     "pencil",
							Variant:  atoms.ButtonSecondary,
							Size:     atoms.ButtonSizeMD,
							HxGet:    "/tenants/" + tenant.ID + "/edit",
							HxTarget: "#modal-container",
							HxSwap:   "innerHTML",
						})
					}
					
					<!-- More Actions Dropdown -->
					<div class="relative" x-data="{ open: false }">
						@atoms.Button(atoms.ButtonProps{
							Icon:    "ellipsis-horizontal",
							Variant: atoms.ButtonSecondary,
							Size:    atoms.ButtonSizeMD,
							OnClick: "open = !open",
							Class:   "px-3",
						})
						
						<!-- Dropdown Menu -->
						<div 
							class="absolute right-0 mt-2 w-48 bg-white dark:bg-gray-800 rounded-md shadow-lg border border-gray-200 dark:border-gray-700 z-10"
							x-show="open"
							@click.outside="open = false"
							x-transition
						>
							<div class="py-1">
								if permissions.CanEdit {
									<button
										type="button"
										class="flex items-center w-full px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700"
										hx-get={ "/tenants/" + tenant.ID + "/impersonate" }
									>
										@atoms.Icon(atoms.IconProps{
											Name:  "arrow-right-on-rectangle",
											Size:  atoms.IconSizeXS,
											Class: "mr-2",
										})
										Login as Tenant
									</button>
								}
								
								<button
									type="button"
									class="flex items-center w-full px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700"
									hx-get={ "/tenants/" + tenant.ID + "/export" }
								>
									@atoms.Icon(atoms.IconProps{
										Name:  "arrow-down-tray",
										Size:  atoms.IconSizeXS,
										Class: "mr-2",
									})
									Export Data
								</button>
								
								if permissions.CanDelete && tenant.Status != "ACTIVE" {
									<hr class="my-1 border-gray-200 dark:border-gray-600" />
									<button
										type="button"
										class="flex items-center w-full px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20"
										hx-delete={ "/tenants/" + tenant.ID }
										hx-confirm="Are you sure you want to delete this tenant? This action cannot be undone."
									>
										@atoms.Icon(atoms.IconProps{
											Name:  "trash",
											Size:  atoms.IconSizeXS,
											Class: "mr-2",
										})
										Delete Tenant
									</button>
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// TenantBasicInfoSection renders basic tenant information
templ TenantBasicInfoSection(tenant TenantDetail) {
	<div class="bg-white dark:bg-gray-800 shadow-sm rounded-lg border border-gray-200 dark:border-gray-700">
		<div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
			<h3 class="text-lg font-medium text-gray-900 dark:text-white">
				Organization Details
			</h3>
		</div>
		<div class="px-6 py-4">
			<dl class="grid grid-cols-1 gap-6 sm:grid-cols-2">
				<!-- Basic Info -->
				@TenantDetailField("Industry", tenant.Industry, "briefcase")
				@TenantDetailField("Company Size", tenant.CompanySize, "users")
				@TenantDetailField("Timezone", tenant.Timezone, "clock")
				@TenantDetailField("Currency", tenant.CurrencyCode, "currency-dollar")
				
				if tenant.Website != "" {
					@TenantDetailFieldLink("Website", tenant.Website, tenant.Website, "globe-alt")
				}
				
				if tenant.Phone != "" {
					@TenantDetailFieldLink("Phone", tenant.Phone, "tel:"+tenant.Phone, "phone")
				}
				
				<!-- Address -->
				if tenant.Address.Street != "" || tenant.Address.City != "" {
					@TenantDetailFieldAddress("Address", tenant.Address)
				}
				
				<!-- Dates -->
				@TenantDetailField("Created", formatDateTime(tenant.CreatedAt), "calendar")
				@TenantDetailField("Last Updated", formatDateTime(tenant.UpdatedAt), "pencil")
				
				if tenant.LastLogin != "" {
					@TenantDetailField("Last Login", formatRelativeDateTime(tenant.LastLogin), "arrow-right-on-rectangle")
				}
			</dl>
			
			<!-- Description -->
			if tenant.Description != "" {
				<div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
					<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Description</dt>
					<dd class="mt-1 text-sm text-gray-900 dark:text-white">
						{ tenant.Description }
					</dd>
				</div>
			}
			
			<!-- Metadata -->
			if len(tenant.Metadata) > 0 {
				<div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
					<dt class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">Custom Fields</dt>
					<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
						for key, value := range tenant.Metadata {
							<div>
								<dt class="text-xs font-medium text-gray-400 dark:text-gray-500 uppercase tracking-wide">
									{ key }
								</dt>
								<dd class="mt-1 text-sm text-gray-900 dark:text-white">
									{ formatMetadataValue(value) }
								</dd>
							</div>
						}
					</div>
				</div>
			}
		</div>
	</div>
}

// TenantDetailField renders a simple detail field
templ TenantDetailField(label, value, icon string) {
	<div>
		<dt class="flex items-center text-sm font-medium text-gray-500 dark:text-gray-400">
			if icon != "" {
				@atoms.Icon(atoms.IconProps{
					Name:  icon,
					Size:  atoms.IconSizeXS,
					Class: "mr-2",
				})
			}
			{ label }
		</dt>
		<dd class="mt-1 text-sm text-gray-900 dark:text-white">
			if value != "" {
				{ value }
			} else {
				<span class="text-gray-400 dark:text-gray-500">—</span>
			}
		</dd>
	</div>
}

// TenantDetailFieldLink renders a detail field with a link
templ TenantDetailFieldLink(label, value, href, icon string) {
	<div>
		<dt class="flex items-center text-sm font-medium text-gray-500 dark:text-gray-400">
			if icon != "" {
				@atoms.Icon(atoms.IconProps{
					Name:  icon,
					Size:  atoms.IconSizeXS,
					Class: "mr-2",
				})
			}
			{ label }
		</dt>
		<dd class="mt-1 text-sm">
			<a 
				href={ href }
				class="text-blue-600 dark:text-blue-400 hover:text-blue-500 dark:hover:text-blue-300"
				target="_blank"
				rel="noopener noreferrer"
			>
				{ value }
			</a>
		</dd>
	</div>
}

// TenantDetailFieldAddress renders an address field
templ TenantDetailFieldAddress(label string, address tenant_management.TenantAddress) {
	<div class="sm:col-span-2">
		<dt class="flex items-center text-sm font-medium text-gray-500 dark:text-gray-400">
			@atoms.Icon(atoms.IconProps{
				Name:  "map-pin",
				Size:  atoms.IconSizeXS,
				Class: "mr-2",
			})
			{ label }
		</dt>
		<dd class="mt-1 text-sm text-gray-900 dark:text-white">
			{ formatAddress(address) }
		</dd>
	</div>
}

// TenantStatusSection renders status and quick stats
templ TenantStatusSection(tenant TenantDetail) {
	<div class="bg-white dark:bg-gray-800 shadow-sm rounded-lg border border-gray-200 dark:border-gray-700">
		<div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
			<h3 class="text-lg font-medium text-gray-900 dark:text-white">
				Status & Overview
			</h3>
		</div>
		<div class="px-6 py-4 space-y-4">
			<!-- Current Status -->
			<div class="flex items-center justify-between">
				<span class="text-sm text-gray-500 dark:text-gray-400">Status</span>
				@tenant_management.TenantStatusBadge(tenant.Status)
			</div>
			
			<!-- Tenant ID -->
			<div class="flex items-center justify-between">
				<span class="text-sm text-gray-500 dark:text-gray-400">Tenant ID</span>
				<code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded font-mono">
					{ tenant.ID }
				</code>
			</div>
			
			<!-- Quick Actions -->
			<div class="pt-4 border-t border-gray-200 dark:border-gray-700">
				<div class="space-y-2">
					@atoms.Button(atoms.ButtonProps{
						Text:    "View Activity",
						Icon:    "clock",
						Variant: atoms.ButtonSecondary,
						Size:    atoms.ButtonSizeSM,
						Class:   "w-full justify-center",
						HxGet:   "/tenants/" + tenant.ID + "/activity",
					})
					
					@atoms.Button(atoms.ButtonProps{
						Text:    "Download Report",
						Icon:    "document-arrow-down",
						Variant: atoms.ButtonSecondary,
						Size:    atoms.ButtonSizeSM,
						Class:   "w-full justify-center",
						HxGet:   "/tenants/" + tenant.ID + "/report",
					})
				</div>
			</div>
		</div>
	</div>
}

// TenantUsageSection renders usage metrics
templ TenantUsageSection(usage TenantUsage) {
	<div class="bg-white dark:bg-gray-800 shadow-sm rounded-lg border border-gray-200 dark:border-gray-700">
		<div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
			<h3 class="text-lg font-medium text-gray-900 dark:text-white">
				Usage Metrics
			</h3>
		</div>
		<div class="px-6 py-4 space-y-4">
			@TenantUsageMetricDisplay("Users", usage.Users)
			@TenantUsageMetricDisplay("Storage", usage.Storage)
			@TenantUsageMetricDisplay("API Requests", usage.APIRequests)
			@TenantUsageMetricDisplay("Monthly Logins", usage.Logins)
		</div>
	</div>
}

// TenantUsageMetricDisplay renders a single usage metric
templ TenantUsageMetricDisplay(label string, metric TenantUsageMetric) {
	<div>
		<div class="flex items-center justify-between text-sm mb-1">
			<span class="text-gray-500 dark:text-gray-400">{ label }</span>
			<span class="text-gray-900 dark:text-white">
				{ formatUsageValue(metric.Current, metric.Unit) }
				if metric.Limit > 0 {
					<span class="text-gray-400 dark:text-gray-500">
						/ { formatUsageValue(metric.Limit, metric.Unit) }
					</span>
				}
			</span>
		</div>
		if metric.Limit > 0 {
			<div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
				<div 
					class={ "h-2 rounded-full", getUsageBarColor(metric.Current, metric.Limit) }
					style={ "width: " + formatUsagePercentage(metric.Current, metric.Limit) + "%" }
				></div>
			</div>
		}
	</div>
}

// TenantBillingSection renders billing information
templ TenantBillingSection(billing tenant_management.TenantBilling) {
	<div class="bg-white dark:bg-gray-800 shadow-sm rounded-lg border border-gray-200 dark:border-gray-700">
		<div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
			<h3 class="text-lg font-medium text-gray-900 dark:text-white">
				Billing Information
			</h3>
		</div>
		<div class="px-6 py-4 space-y-3">
			<div class="flex items-center justify-between">
				<span class="text-sm text-gray-500 dark:text-gray-400">Plan</span>
				<span class="text-sm text-gray-900 dark:text-white font-medium">
					{ formatPlanName(billing.PlanID) }
				</span>
			</div>
			
			<div class="flex items-center justify-between">
				<span class="text-sm text-gray-500 dark:text-gray-400">Billing Cycle</span>
				<span class="text-sm text-gray-900 dark:text-white">
					{ formatBillingCycle(billing.BillingCycle) }
				</span>
			</div>
			
			if billing.NextBillingDate != "" {
				<div class="flex items-center justify-between">
					<span class="text-sm text-gray-500 dark:text-gray-400">Next Billing</span>
					<span class="text-sm text-gray-900 dark:text-white">
						{ formatDate(billing.NextBillingDate) }
					</span>
				</div>
			}
			
			if billing.PaymentMethod != "" {
				<div class="flex items-center justify-between">
					<span class="text-sm text-gray-500 dark:text-gray-400">Payment Method</span>
					<span class="text-sm text-gray-900 dark:text-white">
						{ formatPaymentMethod(billing.PaymentMethod) }
					</span>
				</div>
			}
		</div>
	</div>
}

// TenantSettingsSection renders settings summary
templ TenantSettingsSection(settings tenant_management.TenantSettings) {
	<div class="bg-white dark:bg-gray-800 shadow-sm rounded-lg border border-gray-200 dark:border-gray-700">
		<div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
			<h3 class="text-lg font-medium text-gray-900 dark:text-white">
				Configuration
			</h3>
		</div>
		<div class="px-6 py-4 space-y-3">
			@TenantSettingItem("User Signup", settings.AllowSignup)
			@TenantSettingItem("Email Verification", settings.RequireEmailVerification)
			@TenantSettingItem("SSO Enabled", settings.EnableSSO)
			@TenantSettingItem("API Access", settings.EnableAPI)
			
			if settings.MaxUsers > 0 {
				<div class="flex items-center justify-between">
					<span class="text-sm text-gray-500 dark:text-gray-400">User Limit</span>
					<span class="text-sm text-gray-900 dark:text-white">
						{ formatNumber(settings.MaxUsers) }
					</span>
				</div>
			}
			
			if settings.MaxStorage > 0 {
				<div class="flex items-center justify-between">
					<span class="text-sm text-gray-500 dark:text-gray-400">Storage Limit</span>
					<span class="text-sm text-gray-900 dark:text-white">
						{ formatBytes(settings.MaxStorage) }
					</span>
				</div>
			}
		</div>
	</div>
}

// TenantSettingItem renders a boolean setting
templ TenantSettingItem(label string, enabled bool) {
	<div class="flex items-center justify-between">
		<span class="text-sm text-gray-500 dark:text-gray-400">{ label }</span>
		<span class={ "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium", getBooleanSettingClasses(enabled) }>
			@atoms.Icon(atoms.IconProps{
				Name: getBooleanSettingIcon(enabled),
				Size: atoms.IconSizeXS,
				Class: "mr-1",
			})
			{ getBooleanSettingText(enabled) }
		</span>
	</div>
}

// TenantUsersSection renders the users list
templ TenantUsersSection(users []TenantUser, permissions TenantPermissions) {
	<div class="bg-white dark:bg-gray-800 shadow-sm rounded-lg border border-gray-200 dark:border-gray-700">
		<div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
			<div class="flex items-center justify-between">
				<h3 class="text-lg font-medium text-gray-900 dark:text-white">
					Users ({ formatNumber(len(users)) })
				</h3>
				if permissions.CanCreate {
					@atoms.Button(atoms.ButtonProps{
						Text:    "Add User",
						Icon:    "plus",
						Variant: atoms.ButtonPrimary,
						Size:    atoms.ButtonSizeSM,
					})
				}
			</div>
		</div>
		<div class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, user := range users {
				@TenantUserItem(user)
			}
		</div>
	</div>
}

// TenantUserItem renders a single user item
templ TenantUserItem(user TenantUser) {
	<div class="px-6 py-4 flex items-center justify-between">
		<div class="flex items-center space-x-3">
			<div class="flex-shrink-0 h-8 w-8">
				if user.Avatar != "" {
					<img class="h-8 w-8 rounded-full" src={ user.Avatar } alt={ user.Name } />
				} else {
					<div class="h-8 w-8 rounded-full bg-gray-300 dark:bg-gray-600 flex items-center justify-center">
						<span class="text-xs font-medium text-gray-700 dark:text-gray-300">
							{ getInitials(user.Name) }
						</span>
					</div>
				}
			</div>
			<div>
				<div class="text-sm font-medium text-gray-900 dark:text-white">
					{ user.Name }
				</div>
				<div class="text-xs text-gray-500 dark:text-gray-400">
					{ user.Email } • { user.Role }
				</div>
			</div>
		</div>
		<div class="flex items-center space-x-2">
			<span class={ "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium", getUserStatusClasses(user.Status) }>
				{ formatUserStatus(user.Status) }
			</span>
		</div>
	</div>
}

// TenantActivitySection renders activity log
templ TenantActivitySection(activities []TenantActivity) {
	<div class="bg-white dark:bg-gray-800 shadow-sm rounded-lg border border-gray-200 dark:border-gray-700">
		<div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
			<h3 class="text-lg font-medium text-gray-900 dark:text-white">
				Recent Activity
			</h3>
		</div>
		<div class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, activity := range activities {
				@TenantActivityItem(activity)
			}
		</div>
	</div>
}

// TenantActivityItem renders a single activity item
templ TenantActivityItem(activity TenantActivity) {
	<div class="px-6 py-4">
		<div class="flex items-start space-x-3">
			<div class="flex-shrink-0">
				<div class={ "w-6 h-6 rounded-full flex items-center justify-center", getActivityTypeClasses(activity.Type) }>
					@atoms.Icon(atoms.IconProps{
						Name:  getActivityTypeIcon(activity.Type),
						Size:  atoms.IconSizeXS,
						Class: "text-white",
					})
				</div>
			</div>
			<div class="flex-1 min-w-0">
				<p class="text-sm text-gray-900 dark:text-white">
					{ activity.Description }
				</p>
				<div class="mt-1 text-xs text-gray-500 dark:text-gray-400">
					{ formatRelativeDateTime(activity.Timestamp) }
					if activity.UserName != "" {
						by { activity.UserName }
					}
					if activity.IPAddress != "" {
						from { activity.IPAddress }
					}
				</div>
			</div>
		</div>
	</div>
}

// Helper functions
func formatDateTime(dateTime string) string {
	// Format datetime string
	return dateTime
}

func formatRelativeDateTime(dateTime string) string {
	// Format relative datetime
	return dateTime
}

func formatDate(date string) string {
	// Format date string
	return date
}

func formatAddress(address tenant_management.TenantAddress) string {
	parts := []string{}
	if address.Street != "" {
		parts = append(parts, address.Street)
	}
	if address.City != "" {
		parts = append(parts, address.City)
	}
	if address.State != "" {
		parts = append(parts, address.State)
	}
	if address.PostalCode != "" {
		parts = append(parts, address.PostalCode)
	}
	if address.Country != "" {
		parts = append(parts, address.Country)
	}
	
	result := ""
	for i, part := range parts {
		if i > 0 {
			result += ", "
		}
		result += part
	}
	return result
}

func formatMetadataValue(value interface{}) string {
	// Convert interface{} to string representation
	return "value"
}

func formatUsageValue(value int64, unit string) string {
	switch unit {
	case "bytes":
		return formatBytes(value)
	case "requests":
		return formatStatNumber(value)
	default:
		return formatStatNumber(value)
	}
}

func formatBytes(bytes int64) string {
	const unit = 1024
	if bytes < unit {
		return formatInt64(bytes) + " B"
	}
	div, exp := int64(unit), 0
	for n := bytes / unit; n >= unit; n /= unit {
		div *= unit
		exp++
	}
	return formatFloat(float64(bytes)/float64(div)) + " " + "KMGTPE"[exp:exp+1] + "B"
}

func formatUsagePercentage(current, limit int64) string {
	if limit == 0 {
		return "0"
	}
	percentage := float64(current) / float64(limit) * 100
	return formatFloat(percentage)
}

func getUsageBarColor(current, limit int64) string {
	if limit == 0 {
		return "bg-gray-300"
	}
	
	percentage := float64(current) / float64(limit) * 100
	
	if percentage >= 90 {
		return "bg-red-500"
	} else if percentage >= 75 {
		return "bg-yellow-500"
	} else {
		return "bg-blue-500"
	}
}

func formatPlanName(planID string) string {
	switch planID {
	case "basic":
		return "Basic Plan"
	case "pro":
		return "Pro Plan"
	case "enterprise":
		return "Enterprise Plan"
	default:
		return planID
	}
}

func formatBillingCycle(cycle string) string {
	switch cycle {
	case "monthly":
		return "Monthly"
	case "annually":
		return "Annually"
	default:
		return cycle
	}
}

func formatPaymentMethod(method string) string {
	// Format payment method display
	return method
}

func getBooleanSettingClasses(enabled bool) string {
	if enabled {
		return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200"
	}
	return "bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200"
}

func getBooleanSettingIcon(enabled bool) string {
	if enabled {
		return "check"
	}
	return "x"
}

func getBooleanSettingText(enabled bool) string {
	if enabled {
		return "Enabled"
	}
	return "Disabled"
}

func getUserStatusClasses(status string) string {
	switch status {
	case "active":
		return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200"
	case "pending":
		return "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200"
	case "suspended":
		return "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200"
	default:
		return "bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200"
	}
}

func formatUserStatus(status string) string {
	switch status {
	case "active":
		return "Active"
	case "pending":
		return "Pending"
	case "suspended":
		return "Suspended"
	default:
		return status
	}
}

func getActivityTypeClasses(activityType string) string {
	switch activityType {
	case "user_created", "user_login":
		return "bg-green-500"
	case "setting_changed", "config_updated":
		return "bg-blue-500"
	case "user_suspended", "error":
		return "bg-red-500"
	default:
		return "bg-gray-500"
	}
}

func getActivityTypeIcon(activityType string) string {
	switch activityType {
	case "user_created":
		return "user-plus"
	case "user_login":
		return "arrow-right-on-rectangle"
	case "setting_changed":
		return "cog-6-tooth"
	case "user_suspended":
		return "no-symbol"
	default:
		return "information-circle"
	}
}