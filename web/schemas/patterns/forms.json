{
  "id": "form-patterns",
  "version": "1.0.0",
  "title": "Form & Input Patterns",
  "description": "Comprehensive patterns for data entry, filtering, and form management",
  "patterns": {
    "multi-section-form": {
      "id": "multi-section-form",
      "title": "Multi-Section Form",
      "description": "Complex forms with grouped sections and progressive disclosure",
      "schema": {
        "type": "organisms.sectioned-form",
        "props": {
          "title": "Campaign Configuration",
          "subtitle": "Set up your marketing campaign parameters",
          "layout": "vertical",
          "sections": [
            {
              "id": "basic-info",
              "title": "Basic Information",
              "description": "Campaign name, description, and basic settings",
              "icon": "info",
              "required": true,
              "expanded": true,
              "fields": [
                {
                  "type": "input",
                  "name": "name",
                  "label": "Campaign Name",
                  "placeholder": "Enter campaign name",
                  "required": true,
                  "validation": {
                    "minLength": 3,
                    "maxLength": 100
                  },
                  "layout": {
                    "span": 2
                  }
                },
                {
                  "type": "textarea",
                  "name": "description",
                  "label": "Description",
                  "placeholder": "Describe your campaign goals and strategy",
                  "rows": 4,
                  "maxLength": 500,
                  "showCharCount": true,
                  "layout": {
                    "span": 2
                  }
                },
                {
                  "type": "select",
                  "name": "type",
                  "label": "Campaign Type",
                  "required": true,
                  "options": [
                    { "value": "email", "label": "Email Marketing" },
                    { "value": "social", "label": "Social Media" },
                    { "value": "paid_ads", "label": "Paid Advertising" },
                    { "value": "content", "label": "Content Marketing" }
                  ]
                },
                {
                  "type": "select",
                  "name": "status",
                  "label": "Status",
                  "required": true,
                  "options": [
                    { "value": "draft", "label": "Draft", "description": "Campaign is being prepared" },
                    { "value": "scheduled", "label": "Scheduled", "description": "Ready to launch" },
                    { "value": "active", "label": "Active", "description": "Currently running" },
                    { "value": "paused", "label": "Paused", "description": "Temporarily stopped" }
                  ],
                  "variant": "card"
                }
              ],
              "layout": {
                "columns": 2,
                "gap": "1.5rem"
              }
            },
            {
              "id": "targeting",
              "title": "Target Audience",
              "description": "Define your campaign audience and segmentation",
              "icon": "users",
              "required": true,
              "fields": [
                {
                  "type": "audience-selector",
                  "name": "audience",
                  "label": "Select Audience",
                  "required": true,
                  "props": {
                    "searchable": true,
                    "createNew": true,
                    "showCustomerCount": true,
                    "multiSelect": true
                  }
                },
                {
                  "type": "filter-builder",
                  "name": "filters",
                  "label": "Additional Filters",
                  "props": {
                    "availableFields": [
                      {
                        "key": "age",
                        "label": "Age",
                        "type": "number",
                        "operators": ["eq", "gt", "lt", "between"]
                      },
                      {
                        "key": "location",
                        "label": "Location",
                        "type": "select",
                        "options": "locations",
                        "operators": ["eq", "in"]
                      },
                      {
                        "key": "purchase_history",
                        "label": "Purchase History",
                        "type": "select",
                        "options": [
                          { "value": "none", "label": "No purchases" },
                          { "value": "recent", "label": "Recent customer" },
                          { "value": "frequent", "label": "Frequent buyer" }
                        ],
                        "operators": ["eq"]
                      }
                    ]
                  }
                },
                {
                  "type": "info-display",
                  "content": {
                    "type": "metric-card",
                    "title": "Estimated Reach",
                    "value": "{audience.estimatedCount}",
                    "format": "number",
                    "subtitle": "people will receive this campaign",
                    "icon": "users",
                    "color": "blue"
                  }
                }
              ]
            },
            {
              "id": "schedule",
              "title": "Schedule & Timing",
              "description": "Set campaign timeline and delivery schedule",
              "icon": "calendar",
              "fields": [
                {
                  "type": "radio-group",
                  "name": "schedule_type",
                  "label": "Send Schedule",
                  "required": true,
                  "options": [
                    {
                      "value": "immediate",
                      "label": "Send Immediately",
                      "description": "Campaign will start as soon as it's published"
                    },
                    {
                      "value": "scheduled",
                      "label": "Schedule for Later",
                      "description": "Choose specific date and time"
                    },
                    {
                      "value": "recurring",
                      "label": "Recurring Campaign",
                      "description": "Repeat automatically"
                    }
                  ],
                  "layout": "vertical"
                },
                {
                  "type": "datetime",
                  "name": "start_date",
                  "label": "Start Date & Time",
                  "required": true,
                  "conditions": [
                    {
                      "field": "schedule_type",
                      "operator": "in",
                      "value": ["scheduled", "recurring"]
                    }
                  ]
                },
                {
                  "type": "datetime",
                  "name": "end_date",
                  "label": "End Date",
                  "conditions": [
                    {
                      "field": "schedule_type",
                      "operator": "eq",
                      "value": "recurring"
                    }
                  ]
                },
                {
                  "type": "recurrence-picker",
                  "name": "recurrence",
                  "label": "Repeat Settings",
                  "conditions": [
                    {
                      "field": "schedule_type",
                      "operator": "eq",
                      "value": "recurring"
                    }
                  ]
                }
              ]
            },
            {
              "id": "budget",
              "title": "Budget & Rules",
              "description": "Set spending limits and campaign rules",
              "icon": "dollar-sign",
              "collapsible": true,
              "fields": [
                {
                  "type": "budget-allocator",
                  "name": "budget",
                  "label": "Campaign Budget",
                  "props": {
                    "currency": "USD",
                    "showDailyLimit": true,
                    "showTotalBudget": true,
                    "presets": [100, 500, 1000, 5000]
                  }
                },
                {
                  "type": "rules-engine",
                  "name": "rules",
                  "label": "Campaign Rules",
                  "props": {
                    "ruleTypes": [
                      {
                        "id": "frequency_cap",
                        "label": "Frequency Cap",
                        "description": "Limit how often users see this campaign"
                      },
                      {
                        "id": "time_restrictions",
                        "label": "Time Restrictions",
                        "description": "Only send during specific hours"
                      },
                      {
                        "id": "exclude_recent",
                        "label": "Exclude Recent Recipients",
                        "description": "Don't send to users who received recent campaigns"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "content",
              "title": "Content & Creative",
              "description": "Upload and configure campaign content",
              "icon": "image",
              "fields": [
                {
                  "type": "file-upload",
                  "name": "creative_assets",
                  "label": "Creative Assets",
                  "multiple": true,
                  "accept": "image/*,.pdf",
                  "maxSize": "5MB",
                  "maxFiles": 10,
                  "props": {
                    "preview": true,
                    "dragDrop": true,
                    "showProgress": true
                  }
                },
                {
                  "type": "rich-text-editor",
                  "name": "content",
                  "label": "Campaign Content",
                  "props": {
                    "toolbar": ["bold", "italic", "link", "image", "list"],
                    "placeholder": "Write your campaign content...",
                    "variables": [
                      { "key": "first_name", "label": "First Name" },
                      { "key": "company", "label": "Company" },
                      { "key": "custom_field", "label": "Custom Field" }
                    ]
                  }
                },
                {
                  "type": "preview-panel",
                  "name": "preview",
                  "label": "Preview",
                  "props": {
                    "devices": ["desktop", "mobile"],
                    "realtime": true
                  }
                }
              ]
            }
          ],
          "navigation": {
            "type": "stepper",
            "position": "top",
            "showProgress": true,
            "allowSkip": false
          },
          "validation": {
            "mode": "progressive",
            "showSummary": true,
            "validateOnSubmit": true
          },
          "actions": {
            "primary": [
              {
                "text": "Save Draft",
                "variant": "secondary",
                "action": "save-draft"
              },
              {
                "text": "Launch Campaign",
                "variant": "primary",
                "action": "submit",
                "confirm": {
                  "title": "Launch Campaign",
                  "message": "Are you sure you want to launch this campaign?",
                  "confirmText": "Launch"
                }
              }
            ],
            "secondary": [
              {
                "text": "Cancel",
                "variant": "ghost",
                "action": "cancel"
              }
            ]
          }
        }
      }
    },
    "advanced-filters": {
      "id": "advanced-filters",
      "title": "Advanced Filter System",
      "description": "Multi-criteria filtering with quick toggles and custom ranges",
      "schema": {
        "type": "organisms.filter-system",
        "props": {
          "title": "Filter Results",
          "layout": "sidebar",
          "collapsible": true,
          "saveableFilters": true,
          "sections": [
            {
              "id": "quick-filters",
              "title": "Quick Filters",
              "type": "toggle-group",
              "filters": [
                {
                  "id": "favorites",
                  "label": "Favorites Only",
                  "icon": "star",
                  "filter": "favorite:true"
                },
                {
                  "id": "recent",
                  "label": "Recent",
                  "icon": "clock",
                  "filter": "updated_at:last_7_days"
                },
                {
                  "id": "assigned-to-me",
                  "label": "Assigned to Me",
                  "icon": "user",
                  "filter": "assignee:current_user"
                },
                {
                  "id": "high-priority",
                  "label": "High Priority",
                  "icon": "alert-triangle",
                  "filter": "priority:high,urgent"
                }
              ]
            },
            {
              "id": "status-filters",
              "title": "Status",
              "type": "checkbox-group",
              "field": "status",
              "options": [
                {
                  "value": "draft",
                  "label": "Draft",
                  "count": "{filters.counts.draft}",
                  "color": "gray"
                },
                {
                  "value": "in_progress",
                  "label": "In Progress",
                  "count": "{filters.counts.in_progress}",
                  "color": "blue"
                },
                {
                  "value": "review",
                  "label": "Under Review",
                  "count": "{filters.counts.review}",
                  "color": "yellow"
                },
                {
                  "value": "completed",
                  "label": "Completed",
                  "count": "{filters.counts.completed}",
                  "color": "green"
                }
              ],
              "showCounts": true,
              "selectAll": true
            },
            {
              "id": "date-filters",
              "title": "Date Range",
              "type": "date-range",
              "field": "created_at",
              "presets": [
                {
                  "label": "Today",
                  "value": "today"
                },
                {
                  "label": "Yesterday",
                  "value": "yesterday"
                },
                {
                  "label": "Last 7 days",
                  "value": "last_7_days"
                },
                {
                  "label": "Last 30 days",
                  "value": "last_30_days"
                },
                {
                  "label": "This month",
                  "value": "this_month"
                },
                {
                  "label": "Last month",
                  "value": "last_month"
                },
                {
                  "label": "Custom range",
                  "value": "custom"
                }
              ],
              "defaultValue": "last_7_days"
            },
            {
              "id": "category-filters",
              "title": "Category",
              "type": "hierarchical-select",
              "field": "category",
              "dataSource": "categories",
              "searchable": true,
              "multiSelect": true,
              "showPath": true
            },
            {
              "id": "assignee-filters",
              "title": "Assignee",
              "type": "user-select",
              "field": "assignee",
              "props": {
                "searchable": true,
                "showAvatars": true,
                "showOnlineStatus": true,
                "groupBy": "department"
              }
            },
            {
              "id": "priority-filters",
              "title": "Priority",
              "type": "range-slider",
              "field": "priority_score",
              "min": 0,
              "max": 100,
              "step": 10,
              "showLabels": true,
              "labels": {
                "0": "Low",
                "50": "Medium",
                "100": "High"
              }
            },
            {
              "id": "tags-filters",
              "title": "Tags",
              "type": "tag-select",
              "field": "tags",
              "props": {
                "searchable": true,
                "createNew": true,
                "colorCoded": true,
                "showCounts": true
              }
            }
          ],
          "search": {
            "enabled": true,
            "placeholder": "Search by keyword...",
            "fields": ["title", "description", "tags"],
            "autocomplete": true,
            "history": true
          },
          "savedFilters": {
            "enabled": true,
            "presets": [
              {
                "id": "my-active-tasks",
                "name": "My Active Tasks",
                "filters": {
                  "assignee": "current_user",
                  "status": ["in_progress", "review"]
                },
                "icon": "user"
              },
              {
                "id": "urgent-items",
                "name": "Urgent Items",
                "filters": {
                  "priority": ["high", "urgent"],
                  "status": ["draft", "in_progress"]
                },
                "icon": "alert-triangle",
                "color": "red"
              }
            ]
          },
          "actions": [
            {
              "text": "Clear All",
              "variant": "ghost",
              "action": "clear-filters"
            },
            {
              "text": "Save Filter",
              "variant": "secondary",
              "action": "save-filter"
            },
            {
              "text": "Apply Filters",
              "variant": "primary",
              "action": "apply-filters"
            }
          ]
        }
      }
    },
    "dynamic-form-builder": {
      "id": "dynamic-form-builder",
      "title": "Dynamic Form Builder",
      "description": "Runtime form generation with conditional logic",
      "schema": {
        "type": "organisms.dynamic-form",
        "props": {
          "schema": "{form.schema}",
          "data": "{form.data}",
          "validation": {
            "strategy": "progressive",
            "showInlineErrors": true,
            "debounceMs": 300
          },
          "features": {
            "conditionalFields": true,
            "fieldDependencies": true,
            "autoSave": {
              "enabled": true,
              "interval": 30000,
              "endpoint": "/api/forms/autosave"
            },
            "fieldValidation": {
              "realtime": true,
              "showSuccess": true
            }
          },
          "fieldTypes": {
            "text": {
              "component": "atoms.input",
              "props": {
                "type": "text"
              }
            },
            "email": {
              "component": "atoms.input",
              "props": {
                "type": "email"
              },
              "validation": {
                "pattern": "email"
              }
            },
            "phone": {
              "component": "molecules.phone-input",
              "props": {
                "format": "international",
                "validation": true
              }
            },
            "currency": {
              "component": "molecules.currency-input",
              "props": {
                "showSymbol": true,
                "decimalPlaces": 2
              }
            },
            "rich-text": {
              "component": "molecules.rich-editor",
              "props": {
                "toolbar": "minimal"
              }
            },
            "file-upload": {
              "component": "molecules.file-dropzone",
              "props": {
                "multiple": false,
                "preview": true
              }
            },
            "signature": {
              "component": "molecules.signature-pad",
              "props": {
                "width": 400,
                "height": 200
              }
            }
          },
          "layout": {
            "type": "responsive",
            "breakpoints": {
              "sm": 1,
              "md": 2,
              "lg": 3
            }
          }
        }
      }
    },
    "search-interface": {
      "id": "search-interface",
      "title": "Advanced Search Interface",
      "description": "Global search with autocomplete and keyboard shortcuts",
      "schema": {
        "type": "organisms.search-interface",
        "props": {
          "placeholder": "Search anything... (⌘K)",
          "keyboard": {
            "shortcut": "cmd+k",
            "global": true
          },
          "autocomplete": {
            "enabled": true,
            "minChars": 2,
            "maxResults": 10,
            "categories": [
              {
                "id": "pages",
                "label": "Pages",
                "icon": "file-text",
                "endpoint": "/api/search/pages"
              },
              {
                "id": "users",
                "label": "People",
                "icon": "users",
                "endpoint": "/api/search/users"
              },
              {
                "id": "documents",
                "label": "Documents",
                "icon": "file",
                "endpoint": "/api/search/documents"
              },
              {
                "id": "commands",
                "label": "Commands",
                "icon": "terminal",
                "static": [
                  {
                    "title": "Create New Project",
                    "action": "create-project",
                    "shortcut": "⌘⇧P"
                  },
                  {
                    "title": "Open Settings",
                    "action": "open-settings",
                    "shortcut": "⌘,"
                  }
                ]
              }
            ]
          },
          "recentSearches": {
            "enabled": true,
            "maxItems": 5,
            "clearable": true
          },
          "filters": {
            "enabled": true,
            "quick": [
              {
                "label": "Modified today",
                "filter": "modified:today"
              },
              {
                "label": "Created by me",
                "filter": "author:me"
              },
              {
                "label": "Shared with me",
                "filter": "shared:true"
              }
            ]
          },
          "modal": {
            "enabled": true,
            "size": "lg",
            "backdrop": true
          }
        }
      }
    }
  },
  "design_tokens": {
    "form_spacing": {
      "field_gap": "1rem",
      "section_gap": "2rem",
      "group_gap": "1.5rem"
    },
    "validation_colors": {
      "error": "#EF4444",
      "warning": "#F59E0B",
      "success": "#10B981",
      "info": "#3B82F6"
    },
    "input_states": {
      "default": {
        "border": "#D1D5DB",
        "background": "#FFFFFF"
      },
      "focus": {
        "border": "#3B82F6",
        "shadow": "0 0 0 3px rgba(59, 130, 246, 0.1)"
      },
      "error": {
        "border": "#EF4444",
        "background": "#FEF2F2"
      },
      "success": {
        "border": "#10B981",
        "background": "#F0FDF4"
      }
    }
  }
}