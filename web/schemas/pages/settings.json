{
  "type": "page",
  "title": "Settings",
  "body": [
    {
      "type": "panel",
      "title": "General Settings",
      "body": {
        "type": "form",
        "mode": "horizontal",
        "api": "post:/settings/general",
        "initApi": "/settings/general",
        "body": [
          {"type": "input-text", "name": "site_name", "label": "Site Name", "required": true},
          {"type": "textarea", "name": "site_description", "label": "Description"},
          {
            "type": "select", "name": "language", "label": "Language",
            "options": [{"label": "English", "value": "en"}, {"label": "Chinese", "value": "zh"}]
          },
          {
            "type": "select", "name": "theme", "label": "Theme",
            "options": [{"label": "Default (CXD)", "value": "cxd"}, {"label": "Ant Design", "value": "antd"}, {"label": "Dark", "value": "dark"}]
          },
          {"type": "input-number", "name": "items_per_page", "label": "Items Per Page", "min": 5, "max": 100, "step": 5},
          {"type": "switch", "name": "enable_notifications", "label": "Notifications"},
          {"type": "switch", "name": "enable_debug", "label": "Debug Mode"}
        ]
      }
    },
    {
      "type": "panel",
      "title": "Profile",
      "body": {
        "type": "form",
        "mode": "horizontal",
        "api": "post:/settings/profile",
        "initApi": "/settings/profile",
        "body": [
          {"type": "input-text", "name": "display_name", "label": "Display Name", "required": true},
          {"type": "input-email", "name": "admin_email", "label": "Email", "required": true},
          {"type": "input-password", "name": "current_password", "label": "Current Password"},
          {"type": "input-password", "name": "new_password", "label": "New Password"}
        ]
      }
    }
  ]
}
