{
  "type": "page",
  "title": "Organizations",
  "subTitle": "Manage tenant organizations, lifecycle, and settings",
  "remark": "All multi-tenant organizations are managed here. Use filters to narrow results or create new organizations with the toolbar.",
  "toolbar": [
    {
      "type": "button",
      "label": "New Organization",
      "level": "primary",
      "icon": "fa fa-plus",
      "actionType": "dialog",
      "dialog": {
        "title": "Create Organization",
        "size": "lg",
        "closeOnEsc": true,
        "actions": [
          {"type": "button", "label": "Cancel", "actionType": "close"},
          {"type": "button", "label": "Submit", "actionType": "confirm", "level": "primary"}
        ],
        "body": {
          "type": "wizard",
          "api": "post:/api/v1/organizations",
          "actionPrevLabel": "Previous",
          "actionNextLabel": "Next",
          "actionFinishLabel": "Create",
          "steps": [
            {
              "title": "Basic Info",
              "body": [
                {
                  "type": "group",
                  "body": [
                    {
                      "type": "input-text",
                      "name": "name",
                      "label": "Organization Name",
                      "required": true,
                      "placeholder": "e.g. Acme Corporation",
                      "validations": {"minLength": 2, "maxLength": 255},
                      "validationErrors": {
                        "minLength": "Name must be at least 2 characters",
                        "maxLength": "Name must not exceed 255 characters"
                      }
                    },
                    {
                      "type": "input-text",
                      "name": "slug",
                      "label": "Slug",
                      "placeholder": "e.g. acme-corp",
                      "description": "URL-friendly identifier. Auto-generated from name if left blank.",
                      "validations": {"matchRegexp": "/^[a-z0-9]+(?:-[a-z0-9]+)*$/"},
                      "validationErrors": {"matchRegexp": "Slug must be lowercase alphanumeric with hyphens only"}
                    }
                  ]
                },
                {
                  "type": "input-email",
                  "name": "email",
                  "label": "Primary Email",
                  "required": true,
                  "placeholder": "admin@example.com",
                  "description": "Main contact email for this organization"
                }
              ]
            },
            {
              "title": "Region & Currency",
              "body": [
                {
                  "type": "group",
                  "body": [
                    {
                      "type": "select",
                      "name": "country_code",
                      "label": "Country",
                      "required": true,
                      "searchable": true,
                      "clearable": true,
                      "options": [
                        {"label": "United States", "value": "US"},
                        {"label": "United Kingdom", "value": "GB"},
                        {"label": "Kenya", "value": "KE"},
                        {"label": "Somalia", "value": "SO"},
                        {"label": "Canada", "value": "CA"},
                        {"label": "Germany", "value": "DE"},
                        {"label": "France", "value": "FR"},
                        {"label": "India", "value": "IN"},
                        {"label": "Australia", "value": "AU"},
                        {"label": "Japan", "value": "JP"},
                        {"label": "United Arab Emirates", "value": "AE"},
                        {"label": "Saudi Arabia", "value": "SA"},
                        {"label": "Nigeria", "value": "NG"},
                        {"label": "South Africa", "value": "ZA"},
                        {"label": "Ethiopia", "value": "ET"},
                        {"label": "Tanzania", "value": "TZ"},
                        {"label": "Uganda", "value": "UG"},
                        {"label": "Djibouti", "value": "DJ"}
                      ]
                    },
                    {
                      "type": "select",
                      "name": "currency_code",
                      "label": "Currency",
                      "required": true,
                      "searchable": true,
                      "clearable": true,
                      "options": [
                        {"label": "USD — US Dollar", "value": "USD"},
                        {"label": "GBP — British Pound", "value": "GBP"},
                        {"label": "KES — Kenyan Shilling", "value": "KES"},
                        {"label": "EUR — Euro", "value": "EUR"},
                        {"label": "CAD — Canadian Dollar", "value": "CAD"},
                        {"label": "AUD — Australian Dollar", "value": "AUD"},
                        {"label": "INR — Indian Rupee", "value": "INR"},
                        {"label": "JPY — Japanese Yen", "value": "JPY"},
                        {"label": "AED — UAE Dirham", "value": "AED"},
                        {"label": "SAR — Saudi Riyal", "value": "SAR"},
                        {"label": "NGN — Nigerian Naira", "value": "NGN"},
                        {"label": "ZAR — South African Rand", "value": "ZAR"},
                        {"label": "ETB — Ethiopian Birr", "value": "ETB"},
                        {"label": "TZS — Tanzanian Shilling", "value": "TZS"},
                        {"label": "UGX — Ugandan Shilling", "value": "UGX"},
                        {"label": "DJF — Djiboutian Franc", "value": "DJF"}
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "Details",
              "body": [
                {
                  "type": "group",
                  "body": [
                    {
                      "type": "input-text",
                      "name": "industry",
                      "label": "Industry",
                      "placeholder": "e.g. Technology, Healthcare, Finance"
                    },
                    {
                      "type": "select",
                      "name": "company_size",
                      "label": "Company Size",
                      "clearable": true,
                      "searchable": true,
                      "options": [
                        {"label": "Startup (1–10)", "value": "STARTUP"},
                        {"label": "Small (11–50)", "value": "SMALL"},
                        {"label": "Medium (51–200)", "value": "MEDIUM"},
                        {"label": "Large (201–1000)", "value": "LARGE"},
                        {"label": "Enterprise (1000+)", "value": "ENTERPRISE"}
                      ]
                    }
                  ]
                },
                {
                  "type": "group",
                  "body": [
                    {
                      "type": "input-text",
                      "name": "tax_id",
                      "label": "Tax ID",
                      "placeholder": "e.g. EIN, VAT number"
                    },
                    {
                      "type": "input-text",
                      "name": "registration_number",
                      "label": "Registration Number",
                      "placeholder": "Business registration number"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "button",
      "label": "Refresh",
      "icon": "fa fa-sync",
      "level": "default",
      "actionType": "reload",
      "target": "org-crud"
    }
  ],
  "body": [
    {
      "type": "crud",
      "name": "org-crud",
      "api": "/api/v1/organizations",
      "syncLocation": false,
      "autoFillHeight": true,
      "perPageAvailable": [10, 20, 50],
      "defaultParams": {
        "limit": 20,
        "offset": 0
      },
      "pageField": "offset",
      "perPageField": "limit",
      "headerToolbar": [
        "bulkActions",
        {
          "type": "pagination",
          "align": "left"
        },
        {
          "type": "columns-toggler",
          "align": "right",
          "label": "Columns"
        },
        {
          "type": "tpl",
          "tpl": "<span class='text-muted text-sm'>${count} of ${total} organizations</span>",
          "className": "m-l-sm",
          "align": "right"
        }
      ],
      "footerToolbar": [
        {
          "type": "tpl",
          "tpl": "Showing ${count} records"
        },
        {
          "type": "switch-per-page",
          "label": "Per page"
        },
        {
          "type": "pagination",
          "layout": ["pager", "go"],
          "actionPerPage": "Per page"
        }
      ],
      "bulkActions": [
        {
          "label": "Bulk Activate",
          "actionType": "ajax",
          "level": "success",
          "icon": "fa fa-check",
          "api": "post:/api/v1/organizations/${ids|raw}/activate",
          "confirmText": "Activate ${selectedItems.length} selected organizations?"
        },
        {
          "label": "Bulk Suspend",
          "actionType": "ajax",
          "level": "warning",
          "icon": "fa fa-pause",
          "api": "post:/api/v1/organizations/${ids|raw}/suspend",
          "confirmText": "Suspend ${selectedItems.length} selected organizations?"
        }
      ],
      "filter": {
        "title": "",
        "submitText": "Search",
        "body": [
          {
            "type": "group",
            "body": [
              {
                "type": "input-text",
                "name": "search",
                "placeholder": "Search by name or slug...",
                "clearable": true,
                "addOn": {
                  "type": "button",
                  "icon": "fa fa-search",
                  "actionType": "submit",
                  "level": "primary"
                }
              },
              {
                "type": "select",
                "name": "status",
                "placeholder": "All Statuses",
                "clearable": true,
                "searchable": true,
                "options": [
                  {"label": "Active", "value": "ACTIVE"},
                  {"label": "Suspended", "value": "SUSPENDED"},
                  {"label": "Pending", "value": "PENDING"},
                  {"label": "Archived", "value": "ARCHIVED"}
                ]
              },
              {
                "type": "select",
                "name": "sort_by",
                "placeholder": "Sort by...",
                "clearable": true,
                "searchable": true,
                "value": "created_at",
                "options": [
                  {"label": "Created Date", "value": "created_at"},
                  {"label": "Name", "value": "name"},
                  {"label": "Status", "value": "status"}
                ]
              }
            ]
          }
        ],
        "actions": [
          {"type": "reset", "label": "Clear"},
          {"type": "submit", "label": "Apply Filters", "level": "primary"}
        ]
      },
      "columns": [
        {
          "name": "name",
          "label": "Organization",
          "sortable": true,
          "type": "tpl",
          "tpl": "<div><strong>${name}</strong><br/><small class='text-muted'>${slug}</small></div>"
        },
        {
          "name": "email",
          "label": "Email",
          "type": "tpl",
          "tpl": "<a href='mailto:${email}'>${email}</a>",
          "toggled": true
        },
        {
          "name": "status",
          "label": "Status",
          "sortable": true,
          "type": "mapping",
          "map": {
            "ACTIVE": "<span class='label label-success'><i class='fa fa-check-circle'></i> Active</span>",
            "SUSPENDED": "<span class='label label-warning'><i class='fa fa-pause-circle'></i> Suspended</span>",
            "PENDING": "<span class='label label-info'><i class='fa fa-clock'></i> Pending</span>",
            "ARCHIVED": "<span class='label label-default'><i class='fa fa-archive'></i> Archived</span>",
            "*": "<span class='label label-default'>${status}</span>"
          }
        },
        {
          "name": "preferences.currency_code",
          "label": "Currency",
          "toggled": true
        },
        {
          "name": "timestamps.created_at",
          "label": "Created",
          "type": "date",
          "format": "YYYY-MM-DD",
          "sortable": true
        },
        {
          "type": "operation",
          "label": "Actions",
          "width": 180,
          "buttons": [
            {
              "label": "View",
              "type": "button",
              "level": "link",
              "icon": "fa fa-eye",
              "actionType": "dialog",
              "dialog": {
                "title": "${name}",
                "size": "lg",
                "actions": [
                  {"type": "button", "label": "Close", "actionType": "close"}
                ],
                "body": {
                  "type": "service",
                  "api": "/api/v1/organizations/${id}?view=detailed",
                  "body": [
                    {
                      "type": "tabs",
                      "tabs": [
                        {
                          "title": "Overview",
                          "icon": "fa fa-info-circle",
                          "body": [
                            {
                              "type": "grid",
                              "columns": [
                                {
                                  "md": 6,
                                  "body": {
                                    "type": "property",
                                    "title": "Identity",
                                    "column": 1,
                                    "items": [
                                      {"label": "ID", "content": "${id}", "span": 1},
                                      {"label": "Name", "content": "${name}"},
                                      {"label": "Slug", "content": "${slug}"},
                                      {"label": "Email", "content": "${email}"},
                                      {"label": "Status", "content": "${status}"}
                                    ]
                                  }
                                },
                                {
                                  "md": 6,
                                  "body": {
                                    "type": "property",
                                    "title": "Business",
                                    "column": 1,
                                    "items": [
                                      {"label": "Industry", "content": "${industry|default:-}"},
                                      {"label": "Company Size", "content": "${company_size|default:-}"},
                                      {"label": "Currency", "content": "${preferences.currency_code}"},
                                      {"label": "Timezone", "content": "${preferences.timezone|default:-}"}
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "title": "Timeline",
                          "icon": "fa fa-clock",
                          "body": {
                            "type": "property",
                            "title": "Timestamps",
                            "column": 2,
                            "items": [
                              {"label": "Created", "content": "${timestamps.created_at}"},
                              {"label": "Updated", "content": "${timestamps.updated_at}"},
                              {"label": "Last Activity", "content": "${timestamps.last_activity_at|default:N/A}"},
                              {"label": "Deleted", "content": "${timestamps.deleted_at|default:N/A}"}
                            ]
                          }
                        },
                        {
                          "title": "Settings",
                          "icon": "fa fa-cog",
                          "body": {
                            "type": "json",
                            "value": "${settings|json}",
                            "placeholder": "No custom settings configured"
                          }
                        },
                        {
                          "title": "Metadata",
                          "icon": "fa fa-database",
                          "body": {
                            "type": "json",
                            "value": "${metadata|json}",
                            "placeholder": "No metadata"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "label": "Edit",
              "type": "button",
              "level": "link",
              "icon": "fa fa-pen",
              "actionType": "dialog",
              "dialog": {
                "title": "Edit — ${name}",
                "size": "md",
                "closeOnEsc": true,
                "body": {
                  "type": "form",
                  "api": "put:/api/v1/organizations/${id}",
                  "initApi": "/api/v1/organizations/${id}?view=detailed",
                  "submitText": "Save",
                  "resetAfterSubmit": false,
                  "body": [
                    {
                      "type": "tabs",
                      "tabs": [
                        {
                          "title": "General",
                          "body": [
                            {
                              "type": "input-text",
                              "name": "name",
                              "label": "Name",
                              "required": true,
                              "validations": {"minLength": 2, "maxLength": 255}
                            },
                            {
                              "type": "static",
                              "name": "slug",
                              "label": "Slug",
                              "copyable": true
                            },
                            {
                              "type": "input-email",
                              "name": "email",
                              "label": "Email"
                            }
                          ]
                        },
                        {
                          "title": "Business Details",
                          "body": [
                            {
                              "type": "input-text",
                              "name": "industry",
                              "label": "Industry"
                            },
                            {
                              "type": "select",
                              "name": "company_size",
                              "label": "Company Size",
                              "clearable": true,
                              "searchable": true,
                              "options": [
                                {"label": "Startup (1–10)", "value": "STARTUP"},
                                {"label": "Small (11–50)", "value": "SMALL"},
                                {"label": "Medium (51–200)", "value": "MEDIUM"},
                                {"label": "Large (201–1000)", "value": "LARGE"},
                                {"label": "Enterprise (1000+)", "value": "ENTERPRISE"}
                              ]
                            },
                            {
                              "type": "input-text",
                              "name": "subdomain",
                              "label": "Subdomain",
                              "description": "Custom subdomain for this organization"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "type": "dropdown-button",
              "label": "",
              "icon": "fa fa-ellipsis-v",
              "level": "link",
              "buttons": [
                {
                  "label": "Activate",
                  "type": "button",
                  "icon": "fa fa-check text-success",
                  "actionType": "ajax",
                  "api": "post:/api/v1/organizations/${id}/activate",
                  "confirmText": "Activate '${name}'?",
                  "visibleOn": "this.status !== 'ACTIVE'"
                },
                {
                  "label": "Suspend",
                  "type": "button",
                  "icon": "fa fa-pause text-warning",
                  "actionType": "dialog",
                  "visibleOn": "this.status === 'ACTIVE'",
                  "dialog": {
                    "title": "Suspend — ${name}",
                    "actions": [
                      {"type": "button", "label": "Cancel", "actionType": "close"},
                      {"type": "button", "label": "Confirm Suspend", "actionType": "confirm", "level": "warning"}
                    ],
                    "body": {
                      "type": "form",
                      "api": "post:/api/v1/organizations/${id}/suspend",
                      "submitText": "Suspend",
                      "body": [
                        {
                          "type": "alert",
                          "level": "warning",
                          "body": "Suspending will immediately restrict access for all users in this organization."
                        },
                        {
                          "type": "textarea",
                          "name": "reason",
                          "label": "Suspension Reason",
                          "required": true,
                          "validations": {"minLength": 10},
                          "validationErrors": {"minLength": "Please provide at least 10 characters explaining the reason"},
                          "placeholder": "Why is this organization being suspended?",
                          "rows": 3
                        }
                      ]
                    }
                  }
                },
                {
                  "label": "Archive",
                  "type": "button",
                  "icon": "fa fa-archive text-muted",
                  "actionType": "ajax",
                  "api": "post:/api/v1/organizations/${id}/archive",
                  "confirmText": "Archive '${name}'? This is a permanent action that cannot be easily undone.",
                  "visibleOn": "this.status !== 'ARCHIVED'"
                },
                {"type": "divider"},
                {
                  "label": "Copy ID",
                  "type": "button",
                  "icon": "fa fa-copy",
                  "actionType": "copy",
                  "content": "${id}"
                },
                {"type": "divider"},
                {
                  "label": "Delete",
                  "type": "button",
                  "icon": "fa fa-trash text-danger",
                  "className": "text-danger",
                  "actionType": "ajax",
                  "api": "delete:/api/v1/organizations/${id}",
                  "confirmText": "Permanently delete '${name}'? This action cannot be undone and all associated data will be lost."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
