{
  "id": "main-dashboard",
  "version": "1.0.0",
  "layout": "app",
  "title": "Dashboard",
  "description": "Overview of key metrics and recent activity",
  "components": [
    {
      "id": "dashboard-header",
      "type": "molecules.base-card",
      "props": {
        "variant": "header",
        "title": "Welcome back, {user.firstName}!",
        "subtitle": "Here's what's happening with your business today.",
        "headerActions": [
          {
            "text": "Add Widget",
            "icon": "plus",
            "variant": "secondary",
            "action": "add-widget"
          },
          {
            "text": "Refresh",
            "icon": "refresh",
            "variant": "ghost",
            "action": "refresh-dashboard"
          }
        ]
      },
      "layout": {
        "container": "block",
        "spacing": {
          "marginBottom": "2rem"
        }
      }
    },
    {
      "id": "summary-cards",
      "type": "features.dashboard.summary-cards",
      "props": {
        "title": "Key Metrics",
        "cards": [
          {
            "title": "Total Revenue",
            "value": "{metrics.totalRevenue}",
            "currency": true,
            "trend": {
              "value": "{metrics.revenueTrend}",
              "direction": "up",
              "period": "vs last month"
            },
            "icon": "currency-dollar",
            "color": "green",
            "action": "view-revenue-details"
          },
          {
            "title": "Active Users",
            "value": "{metrics.activeUsers}",
            "format": "number",
            "trend": {
              "value": "{metrics.usersTrend}",
              "direction": "up",
              "period": "vs last week"
            },
            "icon": "users",
            "color": "blue",
            "action": "view-user-analytics"
          },
          {
            "title": "Pending Orders",
            "value": "{metrics.pendingOrders}",
            "format": "number",
            "trend": {
              "value": "{metrics.ordersTrend}",
              "direction": "down",
              "period": "vs yesterday"
            },
            "icon": "shopping-cart",
            "color": "yellow",
            "action": "view-pending-orders"
          },
          {
            "title": "System Health",
            "value": "{metrics.systemHealth}",
            "format": "percentage",
            "trend": {
              "value": "99.9%",
              "direction": "stable",
              "period": "uptime"
            },
            "icon": "cpu-chip",
            "color": "green",
            "action": "view-system-status"
          }
        ],
        "layout": "grid",
        "columns": 4,
        "responsive": true
      },
      "dataSource": "metrics",
      "layout": {
        "container": "block",
        "spacing": {
          "marginBottom": "2rem"
        }
      }
    },
    {
      "id": "dashboard-grid",
      "type": "container",
      "layout": {
        "container": "grid",
        "grid": {
          "columns": "1fr 1fr 1fr",
          "gap": "1.5rem"
        },
        "responsive": {
          "lg": "grid-cols-3",
          "md": "grid-cols-2",
          "sm": "grid-cols-1"
        }
      },
      "children": [
        {
          "id": "recent-activity",
          "type": "features.dashboard.recent-activity",
          "props": {
            "title": "Recent Activity",
            "subtitle": "Latest updates from your team",
            "activities": "{recentActivity}",
            "maxItems": 8,
            "showMore": true,
            "moreAction": "view-all-activity",
            "emptyState": {
              "title": "No recent activity",
              "description": "Activity will appear here as your team works",
              "icon": "clock"
            }
          },
          "dataSource": "recentActivity",
          "layout": {
            "grid": {
              "columnSpan": 2
            }
          }
        },
        {
          "id": "quick-actions",
          "type": "features.dashboard.quick-actions",
          "props": {
            "title": "Quick Actions",
            "layout": "grid",
            "gridCols": 2,
            "showIcons": true,
            "showLabels": true,
            "actions": [
              {
                "id": "create-invoice",
                "text": "New Invoice",
                "icon": "document-plus",
                "color": "blue",
                "href": "/invoices/new",
                "requiredPermission": "invoices.create"
              },
              {
                "id": "add-customer",
                "text": "Add Customer",
                "icon": "user-plus",
                "color": "green",
                "hxGet": "/customers/new",
                "hxTarget": "#main-modal",
                "requiredPermission": "customers.create"
              },
              {
                "id": "create-quote",
                "text": "New Quote",
                "icon": "document-text",
                "color": "purple",
                "href": "/quotes/new",
                "requiredPermission": "quotes.create"
              },
              {
                "id": "view-reports",
                "text": "Reports",
                "icon": "chart-bar",
                "color": "yellow",
                "href": "/reports",
                "requiredPermission": "reports.view"
              },
              {
                "id": "manage-inventory",
                "text": "Inventory",
                "icon": "cube",
                "color": "indigo",
                "href": "/inventory",
                "requiredPermission": "inventory.view"
              },
              {
                "id": "settings",
                "text": "Settings",
                "icon": "cog",
                "color": "gray",
                "href": "/settings",
                "requiredPermission": "settings.view"
              }
            ]
          }
        },
        {
          "id": "notifications-widget",
          "type": "features.notifications.notification-center",
          "props": {
            "title": "Notifications",
            "subtitle": "Stay updated with important alerts",
            "notifications": "{notifications}",
            "maxItems": 5,
            "showActions": true,
            "compact": true,
            "markAllReadURL": "/api/notifications/mark-all-read",
            "viewAllURL": "/notifications"
          },
          "dataSource": "notifications",
          "layout": {
            "grid": {
              "columnSpan": 1
            }
          }
        },
        {
          "id": "team-performance",
          "type": "molecules.base-card",
          "props": {
            "title": "Team Performance",
            "subtitle": "This week's highlights"
          },
          "children": [
            {
              "id": "performance-chart",
              "type": "molecules.chart",
              "props": {
                "type": "bar",
                "data": "{teamPerformance}",
                "height": "200px",
                "options": {
                  "responsive": true,
                  "plugins": {
                    "legend": {
                      "display": false
                    }
                  }
                }
              },
              "dataSource": "teamPerformance"
            }
          ],
          "layout": {
            "grid": {
              "columnSpan": 2
            }
          }
        },
        {
          "id": "upcoming-tasks",
          "type": "molecules.base-card",
          "props": {
            "title": "Upcoming Tasks",
            "subtitle": "Your schedule for today",
            "headerActions": [
              {
                "text": "View All",
                "icon": "arrow-right",
                "variant": "ghost",
                "size": "sm",
                "href": "/tasks"
              }
            ]
          },
          "children": [
            {
              "id": "tasks-list",
              "type": "molecules.list",
              "props": {
                "items": "{upcomingTasks}",
                "itemTemplate": "task-item",
                "emptyState": {
                  "title": "No upcoming tasks",
                  "description": "You're all caught up!",
                  "icon": "check-circle"
                }
              },
              "dataSource": "upcomingTasks"
            }
          ],
          "layout": {
            "grid": {
              "columnSpan": 1
            }
          }
        }
      ]
    }
  ],
  "dataSources": [
    {
      "id": "metrics",
      "type": "api",
      "endpoint": "/api/dashboard/metrics",
      "method": "GET",
      "cache": {
        "ttl": "5m",
        "key": "dashboard-metrics"
      },
      "refresh": {
        "interval": "30s",
        "trigger": "visibility"
      }
    },
    {
      "id": "recentActivity",
      "type": "api",
      "endpoint": "/api/dashboard/activity",
      "method": "GET",
      "parameters": {
        "limit": "10"
      },
      "cache": {
        "ttl": "2m",
        "key": "recent-activity"
      },
      "refresh": {
        "interval": "60s"
      }
    },
    {
      "id": "notifications",
      "type": "api",
      "endpoint": "/api/notifications",
      "method": "GET",
      "parameters": {
        "unread": "true",
        "limit": "5"
      },
      "cache": {
        "ttl": "1m",
        "key": "notifications-unread"
      },
      "refresh": {
        "interval": "30s"
      }
    },
    {
      "id": "teamPerformance",
      "type": "api",
      "endpoint": "/api/dashboard/team-performance",
      "method": "GET",
      "cache": {
        "ttl": "1h",
        "key": "team-performance"
      }
    },
    {
      "id": "upcomingTasks",
      "type": "api",
      "endpoint": "/api/tasks/upcoming",
      "method": "GET",
      "parameters": {
        "limit": "5",
        "due": "today"
      },
      "cache": {
        "ttl": "5m",
        "key": "upcoming-tasks"
      }
    }
  ],
  "actions": [
    {
      "id": "add-widget",
      "type": "api",
      "label": "Add Widget",
      "target": "/dashboard/widgets/add",
      "method": "GET",
      "success": {
        "type": "update",
        "target": "#main-modal"
      },
      "permissions": ["dashboard.customize"]
    },
    {
      "id": "refresh-dashboard",
      "type": "event",
      "label": "Refresh Dashboard",
      "target": "refresh-all-data",
      "success": {
        "type": "toast",
        "message": "Dashboard refreshed",
        "duration": "2s"
      }
    },
    {
      "id": "view-revenue-details",
      "type": "navigate",
      "target": "/reports/revenue"
    },
    {
      "id": "view-user-analytics",
      "type": "navigate",
      "target": "/analytics/users"
    },
    {
      "id": "view-pending-orders",
      "type": "navigate",
      "target": "/orders?status=pending"
    },
    {
      "id": "view-system-status",
      "type": "navigate",
      "target": "/admin/system-status"
    },
    {
      "id": "view-all-activity",
      "type": "navigate",
      "target": "/activity"
    }
  ],
  "permissions": {
    "requiredPermissions": ["dashboard.view"]
  },
  "meta": {
    "refreshInterval": "30s",
    "autoRefresh": true,
    "layout": {
      "customizable": true,
      "widgets": [
        "summary-cards",
        "recent-activity",
        "quick-actions",
        "notifications-widget",
        "team-performance",
        "upcoming-tasks"
      ]
    },
    "category": "dashboard",
    "tags": ["overview", "metrics", "widgets"]
  }
}