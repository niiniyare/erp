package demo

import (
	"github.com/niiniyare/erp/web/builder/core"
)

// Canvas renders a simple design canvas for the demo
templ Canvas(registry *core.ComponentRegistry) {
	<div class="flex-1 bg-gray-50 relative overflow-hidden">
		<!-- Canvas Background -->
		<div class="absolute inset-0 bg-white m-8 rounded-lg shadow-inner border-2 border-dashed border-gray-200">
			<!-- Grid Pattern -->
			<div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, #000 1px, transparent 1px); background-size: 20px 20px;"></div>
			
			<!-- Canvas Content Area -->
			<div id="canvas-content" class="relative w-full h-full p-4">
				<!-- Welcome Message -->
				<div class="flex items-center justify-center h-full text-center" id="welcome-message">
					<div class="max-w-md">
						<div class="text-4xl mb-4">🎨</div>
						<h3 class="text-xl font-semibold text-gray-700 mb-2">Welcome to the Visual Builder</h3>
						<p class="text-gray-500 mb-4">Drag components from the toolbox to start building your interface</p>
						<button 
							class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors"
							onclick="startBuilding()"
						>
							Start Building
						</button>
					</div>
				</div>
				
				<!-- Components will be added here dynamically -->
			</div>
		</div>
		
		<!-- Canvas Controls -->
		<div class="absolute top-4 right-4 flex space-x-2">
			<button 
				class="bg-white p-2 rounded shadow border hover:bg-gray-50"
				title="Zoom In"
				onclick="zoomCanvas(1.1)"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
				</svg>
			</button>
			<button 
				class="bg-white p-2 rounded shadow border hover:bg-gray-50"
				title="Zoom Out"
				onclick="zoomCanvas(0.9)"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"></path>
				</svg>
			</button>
			<button 
				class="bg-white p-2 rounded shadow border hover:bg-gray-50"
				title="Reset View"
				onclick="resetCanvas()"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
				</svg>
			</button>
		</div>
	</div>
	
	<script>
		// Canvas state
		let canvasZoom = 1;
		let componentCount = 0;
		
		function startBuilding() {
			document.getElementById('welcome-message').style.display = 'none';
			// In a real implementation, this would activate building mode
			console.log('Building mode activated');
		}
		
		function zoomCanvas(factor) {
			canvasZoom *= factor;
			canvasZoom = Math.max(0.25, Math.min(2, canvasZoom));
			
			const content = document.getElementById('canvas-content');
			content.style.transform = 'scale(' + canvasZoom + ')';
			content.style.transformOrigin = 'top left';
			
			console.log('Canvas zoom:', canvasZoom);
		}
		
		function resetCanvas() {
			canvasZoom = 1;
			const content = document.getElementById('canvas-content');
			content.style.transform = 'scale(1)';
			console.log('Canvas reset');
		}
		
		function addComponentToCanvas(componentType) {
			const content = document.getElementById('canvas-content');
			const welcomeMsg = document.getElementById('welcome-message');
			
			// Hide welcome message if visible
			if (welcomeMsg.style.display !== 'none') {
				welcomeMsg.style.display = 'none';
			}
			
			// Create component element
			const component = document.createElement('div');
			component.className = 'absolute bg-white border border-gray-300 rounded p-2 cursor-move shadow-sm hover:shadow-md transition-shadow';
			component.style.left = (50 + componentCount * 20) + 'px';
			component.style.top = (50 + componentCount * 20) + 'px';
			component.innerHTML = '<div class="text-sm font-medium">' + componentType + '</div><div class="text-xs text-gray-500">Component #' + (++componentCount) + '</div>';
			
			// Add basic drag functionality for demo
			component.addEventListener('mousedown', function(e) {
				let startX = e.clientX - component.offsetLeft;
				let startY = e.clientY - component.offsetTop;
				
				function mouseMoveHandler(e) {
					component.style.left = (e.clientX - startX) + 'px';
					component.style.top = (e.clientY - startY) + 'px';
				}
				
				function mouseUpHandler() {
					document.removeEventListener('mousemove', mouseMoveHandler);
					document.removeEventListener('mouseup', mouseUpHandler);
				}
				
				document.addEventListener('mousemove', mouseMoveHandler);
				document.addEventListener('mouseup', mouseUpHandler);
			});
			
			content.appendChild(component);
		}
		
		// Make the function globally available
		window.addComponentToCanvas = addComponentToCanvas;
	</script>
}