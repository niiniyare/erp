package demo

import (
	"github.com/niiniyare/erp/web/builder/core"
)

// PropertyEditor renders a simple property editor for the demo
templ PropertyEditor(registry *core.ComponentRegistry) {
	<div class="bg-white p-4 rounded-lg shadow">
		<h4 class="font-semibold text-gray-900 mb-3">Property Editor</h4>
		
		<div id="property-editor-content">
			<!-- Default state when no component is selected -->
			<div id="no-selection" class="text-center py-8">
				<div class="text-gray-400 mb-2">
					<svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
					</svg>
				</div>
				<p class="text-gray-500 text-sm">Select a component to edit its properties</p>
			</div>
			
			<!-- Properties form will be populated here when component is selected -->
			<div id="properties-form" class="hidden">
				<div class="mb-4">
					<label class="block text-sm font-medium text-gray-700 mb-1">Component ID</label>
					<input 
						type="text" 
						id="prop-id" 
						class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm"
						readonly
					>
				</div>
				
				<div class="mb-4">
					<label class="block text-sm font-medium text-gray-700 mb-1">Component Type</label>
					<input 
						type="text" 
						id="prop-type" 
						class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm"
						readonly
					>
				</div>
				
				<div class="mb-4">
					<label class="block text-sm font-medium text-gray-700 mb-1">Position</label>
					<div class="grid grid-cols-2 gap-2">
						<div>
							<label class="block text-xs text-gray-500 mb-1">X</label>
							<input 
								type="number" 
								id="prop-x" 
								class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
								onchange="updateProperty('position', 'x', this.value)"
							>
						</div>
						<div>
							<label class="block text-xs text-gray-500 mb-1">Y</label>
							<input 
								type="number" 
								id="prop-y" 
								class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
								onchange="updateProperty('position', 'y', this.value)"
							>
						</div>
					</div>
				</div>
				
				<div class="mb-4">
					<label class="block text-sm font-medium text-gray-700 mb-1">Size</label>
					<div class="grid grid-cols-2 gap-2">
						<div>
							<label class="block text-xs text-gray-500 mb-1">Width</label>
							<input 
								type="number" 
								id="prop-width" 
								class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
								onchange="updateProperty('size', 'width', this.value)"
							>
						</div>
						<div>
							<label class="block text-xs text-gray-500 mb-1">Height</label>
							<input 
								type="number" 
								id="prop-height" 
								class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
								onchange="updateProperty('size', 'height', this.value)"
							>
						</div>
					</div>
				</div>
				
				<div class="mb-4">
					<label class="block text-sm font-medium text-gray-700 mb-1">Custom Properties</label>
					<div id="custom-props" class="space-y-2">
						<!-- Dynamic properties will be added here -->
					</div>
					<button 
						class="mt-2 text-blue-600 text-sm hover:text-blue-800"
						onclick="addCustomProperty()"
					>
						+ Add Property
					</button>
				</div>
			</div>
		</div>
	</div>
	
	<script>
		let selectedComponent = null;
		
		function selectComponent(component) {
			selectedComponent = component;
			showPropertiesForm();
			populateProperties(component);
		}
		
		function showPropertiesForm() {
			document.getElementById('no-selection').classList.add('hidden');
			document.getElementById('properties-form').classList.remove('hidden');
		}
		
		function hidePropertiesForm() {
			document.getElementById('no-selection').classList.remove('hidden');
			document.getElementById('properties-form').classList.add('hidden');
			selectedComponent = null;
		}
		
		function populateProperties(component) {
			document.getElementById('prop-id').value = component.id || '';
			document.getElementById('prop-type').value = component.type || '';
			document.getElementById('prop-x').value = component.x || 0;
			document.getElementById('prop-y').value = component.y || 0;
			document.getElementById('prop-width').value = component.width || 100;
			document.getElementById('prop-height').value = component.height || 50;
			
			// Clear and populate custom properties
			const customProps = document.getElementById('custom-props');
			customProps.innerHTML = '';
			
			if (component.props) {
				Object.entries(component.props).forEach(([key, value]) => {
					addCustomPropertyRow(key, value);
				});
			}
		}
		
		function updateProperty(category, property, value) {
			if (!selectedComponent) return;
			
			if (category === 'position') {
				selectedComponent[property === 'x' ? 'x' : 'y'] = parseFloat(value) || 0;
			} else if (category === 'size') {
				selectedComponent[property === 'width' ? 'width' : 'height'] = parseFloat(value) || 0;
			}
			
			// In a real implementation, this would update the component on the canvas
			console.log('Updated component property:', category, property, value);
		}
		
		function addCustomProperty() {
			addCustomPropertyRow('', '');
		}
		
		function addCustomPropertyRow(key, value) {
			const container = document.getElementById('custom-props');
			const row = document.createElement('div');
			row.className = 'flex gap-2';
			row.innerHTML = 
				'<input type="text" placeholder="Property name" value="' + key + '" class="flex-1 px-2 py-1 border border-gray-300 rounded text-sm">' +
				'<input type="text" placeholder="Value" value="' + value + '" class="flex-1 px-2 py-1 border border-gray-300 rounded text-sm">' +
				'<button onclick="this.parentElement.remove()" class="text-red-500 hover:text-red-700 text-sm px-2">×</button>';
			container.appendChild(row);
		}
		
		// Make functions globally available
		window.selectComponent = selectComponent;
		window.hidePropertiesForm = hidePropertiesForm;
	</script>
}