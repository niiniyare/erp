		</main>

		<!-- Import Wizard Modal -->
		if library != nil {
			@ui.ImportWizard(library)
		}

		<!-- Demo JavaScript -->
		<script>
			// Demo state
			const demoState = {
				currentDemo: 'tutorial',
				currentStep: 1,
				selectedTemplate: null,
				builderData: null
			};

			// Initialize demo
			document.addEventListener('DOMContentLoaded', function() {
				initializeDemo();
			});

			function initializeDemo() {
				// Show tutorial by default
				switchDemo('tutorial');
				
				// Setup event listeners
				setupDemoEvents();
			}

			function setupDemoEvents() {
				// Tutorial step navigation
				window.nextTutorialStep = nextTutorialStep;
				window.previousTutorialStep = previousTutorialStep;
				window.selectTemplate = selectTemplate;
				window.startBuilder = startBuilder;
				
				// Demo navigation
				window.switchDemo = switchDemo;
				window.resetDemo = resetDemo;
				window.downloadSchema = downloadSchema;
			}

			function switchDemo(demoType) {
				demoState.currentDemo = demoType;
				
				// Update navigation
				document.querySelectorAll('.demo-nav-btn').forEach(btn => {
					btn.classList.remove('active');
				});
				document.querySelector(`[data-demo="${demoType}"]`).classList.add('active');
				
				// Show selected demo section
				document.querySelectorAll('.demo-section').forEach(section => {
					section.classList.add('hidden');
				});
				document.getElementById(`demo-${demoType}`).classList.remove('hidden');
				
				// Initialize demo-specific functionality
				switch (demoType) {
					case 'builder':
						initializeBuilder();
						break;
					case 'templates':
						initializeTemplates();
						break;
					case 'import':
						initializeImport();
						break;
					case 'showcase':
						initializeShowcase();
						break;
				}
			}

			function nextTutorialStep() {
				if (demoState.currentStep < 4) {
					// Hide current step
					document.getElementById(`tutorial-step-${demoState.currentStep}`).classList.add('hidden');
					
					// Update step indicator
					document.querySelector(`[data-step="${demoState.currentStep}"]`).classList.remove('active');
					document.querySelector(`[data-step="${demoState.currentStep}"]`).classList.add('completed');
					document.querySelector(`[data-step="${demoState.currentStep}"] .w-16`).classList.remove('bg-blue-600', 'text-white');
					document.querySelector(`[data-step="${demoState.currentStep}"] .w-16`).classList.add('bg-green-600', 'text-white');
					
					// Move to next step
					demoState.currentStep++;
					
					// Show next step
					document.getElementById(`tutorial-step-${demoState.currentStep}`).classList.remove('hidden');
					document.querySelector(`[data-step="${demoState.currentStep}"]`).classList.add('active');
					document.querySelector(`[data-step="${demoState.currentStep}"] .w-16`).classList.remove('bg-gray-300', 'text-gray-600');
					document.querySelector(`[data-step="${demoState.currentStep}"] .w-16`).classList.add('bg-blue-600', 'text-white');
				}
			}

			function previousTutorialStep() {
				if (demoState.currentStep > 1) {
					// Hide current step
					document.getElementById(`tutorial-step-${demoState.currentStep}`).classList.add('hidden');
					
					// Update step indicator
					document.querySelector(`[data-step="${demoState.currentStep}"]`).classList.remove('active');
					document.querySelector(`[data-step="${demoState.currentStep}"] .w-16`).classList.remove('bg-blue-600', 'text-white');
					document.querySelector(`[data-step="${demoState.currentStep}"] .w-16`).classList.add('bg-gray-300', 'text-gray-600');
					
					// Move to previous step
					demoState.currentStep--;
					
					// Show previous step
					document.getElementById(`tutorial-step-${demoState.currentStep}`).classList.remove('hidden');
					document.querySelector(`[data-step="${demoState.currentStep}"]`).classList.add('active');
					document.querySelector(`[data-step="${demoState.currentStep}"]`).classList.remove('completed');
					document.querySelector(`[data-step="${demoState.currentStep}"] .w-16`).classList.remove('bg-green-600', 'bg-gray-300', 'text-gray-600');
					document.querySelector(`[data-step="${demoState.currentStep}"] .w-16`).classList.add('bg-blue-600', 'text-white');
				}
			}

			function selectTemplate(templateType) {
				demoState.selectedTemplate = templateType;
				
				// Update UI to show selection
				document.querySelectorAll('.feature-card').forEach(card => {
					card.classList.remove('border-blue-500', 'bg-blue-50');
				});
				
				event.target.closest('.feature-card').classList.add('border-blue-500', 'bg-blue-50');
				
				showNotification(`Selected ${templateType} template!`, 'success');
			}

			function startBuilder() {
				switchDemo('builder');
				showNotification('Welcome to the Visual Builder!', 'success');
			}

			function initializeBuilder() {
				// Initialize builder components if needed
				console.log('Initializing builder demo...');
			}

			function initializeTemplates() {
				// Initialize template gallery if needed
				console.log('Initializing templates demo...');
			}

			function initializeImport() {
				// Initialize import demo if needed
				console.log('Initializing import demo...');
			}

			function initializeShowcase() {
				// Initialize showcase animations if needed
				console.log('Initializing showcase demo...');
			}

			function resetDemo() {
				// Reset demo state
				demoState.currentStep = 1;
				demoState.selectedTemplate = null;
				demoState.builderData = null;
				
				// Reset tutorial steps
				document.querySelectorAll('.tutorial-step').forEach(step => {
					step.classList.add('hidden');
				});
				document.getElementById('tutorial-step-1').classList.remove('hidden');
				
				// Reset step indicators
				document.querySelectorAll('.step-indicator').forEach((indicator, index) => {
					indicator.classList.remove('active', 'completed');
					const stepNumber = indicator.querySelector('.w-16');
					stepNumber.classList.remove('bg-blue-600', 'bg-green-600', 'text-white');
					stepNumber.classList.add('bg-gray-300', 'text-gray-600');
					
					if (index === 0) {
						indicator.classList.add('active');
						stepNumber.classList.remove('bg-gray-300', 'text-gray-600');
						stepNumber.classList.add('bg-blue-600', 'text-white');
					}
				});
				
				// Switch back to tutorial
				switchDemo('tutorial');
				
				showNotification('Demo reset successfully!', 'info');
			}

			function downloadSchema() {
				// Generate sample schema for download
				const schema = {
					id: 'demo-schema',
					name: 'Demo Schema',
					description: 'Schema created in the visual builder demo',
					version: '1.0.0',
					createdAt: new Date().toISOString(),
					components: [
						{
							id: 'header',
							type: 'atoms.text',
							properties: {
								text: 'Demo Header',
								size: 'large'
							},
							position: { x: 0, y: 0 },
							size: { width: 400, height: 50 }
						}
					],
					layout: {
						type: 'flex',
						direction: 'column',
						gap: 16
					}
				};
				
				// Create download link
				const blob = new Blob([JSON.stringify(schema, null, 2)], { type: 'application/json' });
				const url = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = 'demo-schema.json';
				a.click();
				URL.revokeObjectURL(url);
				
				showNotification('Schema downloaded successfully!', 'success');
			}

			function showNotification(message, type = 'info') {
				// Create notification element
				const notification = document.createElement('div');
				notification.className = `fixed top-4 right-4 px-6 py-3 rounded-lg shadow-lg z-50 text-white font-medium`;
				
				switch (type) {
					case 'success':
						notification.classList.add('bg-green-600');
						break;
					case 'error':
						notification.classList.add('bg-red-600');
						break;
					case 'warning':
						notification.classList.add('bg-yellow-600');
						break;
					default:
						notification.classList.add('bg-blue-600');
				}
				
				notification.textContent = message;
				document.body.appendChild(notification);
				
				// Auto remove after 3 seconds
				setTimeout(() => {
					notification.remove();
				}, 3000);
			}
		</script>

		<!-- Demo Styles -->
		<style>
			.demo-nav-btn {
				@apply px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 border-b-2 border-transparent hover:border-gray-300 transition-colors;
			}
			
			.demo-nav-btn.active {
				@apply text-blue-600 border-blue-600;
			}
			
			.demo-section {
				@apply min-h-screen;
			}
			
			.tutorial-step {
				@apply min-h-64;
			}
		</style>
	</body>
	</html>
}