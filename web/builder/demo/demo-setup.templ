package demo

import (
	"github.com/niiniyare/erp/web/builder/core"
	"github.com/niiniyare/erp/web/builder/templates"
	"github.com/niiniyare/erp/web/builder/ui"
)

// DemoSetup renders the complete visual builder demo interface
templ DemoSetup(registry *core.ComponentRegistry, library *templates.TemplateLibrary) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Visual Schema Builder - Interactive Demo</title>
		<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
		<script src="https://unpkg.com/htmx.org@1.9.10"></script>
		<script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
		<style>
			/* Custom styles for the demo */
			.demo-panel {
				background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			}
			
			.feature-card {
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			
			.feature-card:hover {
				transform: translateY(-2px);
				box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
			}
			
			.demo-workspace {
				background: #f8fafc;
				min-height: calc(100vh - 200px);
			}
			
			.step-indicator {
				position: relative;
			}
			
			.step-indicator::after {
				content: '';
				position: absolute;
				top: 50%;
				right: -50%;
				width: 100%;
				height: 2px;
				background: #e2e8f0;
				z-index: -1;
			}
			
			.step-indicator.completed::after {
				background: #10b981;
			}
		</style>
	</head>
	<body class="bg-gray-50">
		<!-- Demo Header -->
		<header class="demo-panel text-white">
			<div class="container mx-auto px-4 py-8">
				<div class="text-center">
					<h1 class="text-4xl font-bold mb-4">Visual Schema Builder</h1>
					<p class="text-xl opacity-90 mb-6">Interactive Demo - Phase 4.4 MVP Complete</p>
					<div class="flex items-center justify-center space-x-6">
						<div class="flex items-center space-x-2">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
							</svg>
							<span>Live Preview</span>
						</div>
						<div class="flex items-center space-x-2">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
							</svg>
							<span>Device Emulation</span>
						</div>
						<div class="flex items-center space-x-2">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
							</svg>
							<span>Template Library</span>
						</div>
						<div class="flex items-center space-x-2">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
							</svg>
							<span>Schema Import</span>
						</div>
					</div>
				</div>
			</div>
		</header>

		<!-- Demo Navigation -->
		<nav class="bg-white shadow-sm border-b">
			<div class="container mx-auto px-4">
				<div class="flex items-center justify-between h-16">
					<div class="flex items-center space-x-8">
						<button 
							class="demo-nav-btn active" 
							data-demo="tutorial"
							onclick="switchDemo('tutorial')"
						>
							📚 Tutorial
						</button>
						<button 
							class="demo-nav-btn" 
							data-demo="builder"
							onclick="switchDemo('builder')"
						>
							🎨 Visual Builder
						</button>
						<button 
							class="demo-nav-btn" 
							data-demo="templates"
							onclick="switchDemo('templates')"
						>
							📋 Templates
						</button>
						<button 
							class="demo-nav-btn" 
							data-demo="import"
							onclick="switchDemo('import')"
						>
							📥 Import
						</button>
						<button 
							class="demo-nav-btn" 
							data-demo="showcase"
							onclick="switchDemo('showcase')"
						>
							✨ Showcase
						</button>
					</div>
					
					<div class="flex items-center space-x-4">
						<button 
							class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
							onclick="resetDemo()"
						>
							Reset Demo
						</button>
						<button 
							class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700"
							onclick="downloadSchema()"
						>
							Download Schema
						</button>
					</div>
				</div>
			</div>
		</nav>

		<!-- Demo Content -->
		<main class="demo-workspace">
			<!-- Tutorial Demo -->
			<div class="demo-section active" id="demo-tutorial">
				<div class="container mx-auto px-4 py-8">
					<div class="max-w-4xl mx-auto">
						<h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Interactive Tutorial</h2>
						
						<!-- Tutorial Steps -->
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
							<div class="step-indicator text-center" data-step="1">
								<div class="w-16 h-16 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold">1</div>
								<h3 class="font-semibold text-gray-900">Choose Template</h3>
								<p class="text-sm text-gray-600 mt-1">Start with a pre-built template or create from scratch</p>
							</div>
							<div class="step-indicator text-center" data-step="2">
								<div class="w-16 h-16 bg-gray-300 text-gray-600 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold">2</div>
								<h3 class="font-semibold text-gray-900">Drag & Drop</h3>
								<p class="text-sm text-gray-600 mt-1">Add components to your canvas using drag and drop</p>
							</div>
							<div class="step-indicator text-center" data-step="3">
								<div class="w-16 h-16 bg-gray-300 text-gray-600 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold">3</div>
								<h3 class="font-semibold text-gray-900">Customize</h3>
								<p class="text-sm text-gray-600 mt-1">Edit properties, styles, and behavior</p>
							</div>
							<div class="step-indicator text-center" data-step="4">
								<div class="w-16 h-16 bg-gray-300 text-gray-600 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold">4</div>
								<h3 class="font-semibold text-gray-900">Preview & Export</h3>
								<p class="text-sm text-gray-600 mt-1">Test responsiveness and export your schema</p>
							</div>
						</div>
						
						<!-- Tutorial Content -->
						<div class="bg-white rounded-lg shadow-lg p-8">
							<div class="tutorial-step active" id="tutorial-step-1">
								<h3 class="text-2xl font-bold text-gray-900 mb-4">Step 1: Choose Your Starting Point</h3>
								<p class="text-gray-600 mb-6">Begin your journey by selecting a template that matches your needs, or start with a blank canvas for complete creative freedom.</p>
								
								<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
									<div class="feature-card border border-gray-200 rounded-lg p-4 cursor-pointer hover:border-blue-500" onclick="selectTemplate('dashboard')">
										<div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-3">
											<span class="text-2xl">📊</span>
										</div>
										<h4 class="font-semibold text-gray-900">Dashboard Template</h4>
										<p class="text-sm text-gray-600 mt-1">Perfect for admin panels and data visualization</p>
									</div>
									
									<div class="feature-card border border-gray-200 rounded-lg p-4 cursor-pointer hover:border-blue-500" onclick="selectTemplate('form')">
										<div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-3">
											<span class="text-2xl">📝</span>
										</div>
										<h4 class="font-semibold text-gray-900">Form Template</h4>
										<p class="text-sm text-gray-600 mt-1">Great for contact forms and data collection</p>
									</div>
									
									<div class="feature-card border border-gray-200 rounded-lg p-4 cursor-pointer hover:border-blue-500" onclick="selectTemplate('blank')">
										<div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center mb-3">
											<span class="text-2xl">🎨</span>
										</div>
										<h4 class="font-semibold text-gray-900">Blank Canvas</h4>
										<p class="text-sm text-gray-600 mt-1">Start from scratch with complete freedom</p>
									</div>
								</div>
								
								<div class="flex justify-between">
									<button class="px-6 py-2 bg-gray-300 text-gray-600 rounded cursor-not-allowed" disabled>Previous</button>
									<button class="px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" onclick="nextTutorialStep()">Next Step</button>
								</div>
							</div>
							
							<div class="tutorial-step hidden" id="tutorial-step-2">
								<h3 class="text-2xl font-bold text-gray-900 mb-4">Step 2: Add Components</h3>
								<p class="text-gray-600 mb-6">Drag components from the toolbox onto your canvas. Components are organized by atomic design principles.</p>
								
								<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
									<div class="text-center">
										<div class="w-16 h-16 bg-red-100 rounded-lg flex items-center justify-center mx-auto mb-2">
											<span class="text-2xl">⚛️</span>
										</div>
										<h4 class="font-semibold text-sm">Atoms</h4>
										<p class="text-xs text-gray-600">Basic elements like buttons, inputs</p>
									</div>
									<div class="text-center">
										<div class="w-16 h-16 bg-orange-100 rounded-lg flex items-center justify-center mx-auto mb-2">
											<span class="text-2xl">🧬</span>
										</div>
										<h4 class="font-semibold text-sm">Molecules</h4>
										<p class="text-xs text-gray-600">Combined atoms like forms, cards</p>
									</div>
									<div class="text-center">
										<div class="w-16 h-16 bg-yellow-100 rounded-lg flex items-center justify-center mx-auto mb-2">
											<span class="text-2xl">🦠</span>
										</div>
										<h4 class="font-semibold text-sm">Organisms</h4>
										<p class="text-xs text-gray-600">Complex components like headers, tables</p>
									</div>
									<div class="text-center">
										<div class="w-16 h-16 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-2">
											<span class="text-2xl">📐</span>
										</div>
										<h4 class="font-semibold text-sm">Templates</h4>
										<p class="text-xs text-gray-600">Page-level layouts and structures</p>
									</div>
								</div>
								
								<div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
									<div class="flex items-start">
										<svg class="w-5 h-5 text-blue-600 mt-0.5 mr-2" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
										</svg>
										<div>
											<h4 class="font-semibold text-blue-900">Pro Tip</h4>
											<p class="text-blue-800 text-sm">You can also double-click components to add them to the center of your canvas.</p>
										</div>
									</div>
								</div>
								
								<div class="flex justify-between">
									<button class="px-6 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" onclick="previousTutorialStep()">Previous</button>
									<button class="px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" onclick="nextTutorialStep()">Next Step</button>
								</div>
							</div>
							
							<div class="tutorial-step hidden" id="tutorial-step-3">
								<h3 class="text-2xl font-bold text-gray-900 mb-4">Step 3: Customize Properties</h3>
								<p class="text-gray-600 mb-6">Fine-tune your components using the property editor. Modify text, colors, sizes, and behavior.</p>
								
								<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
									<div>
										<h4 class="font-semibold text-gray-900 mb-3">Available Editors</h4>
										<ul class="space-y-2">
											<li class="flex items-center">
												<span class="w-2 h-2 bg-blue-500 rounded-full mr-2"></span>
												<span class="text-sm">Properties Editor - Basic component settings</span>
											</li>
											<li class="flex items-center">
												<span class="w-2 h-2 bg-green-500 rounded-full mr-2"></span>
												<span class="text-sm">Layout Editor - Positioning and sizing</span>
											</li>
											<li class="flex items-center">
												<span class="w-2 h-2 bg-yellow-500 rounded-full mr-2"></span>
												<span class="text-sm">Style Editor - Colors, fonts, and appearance</span>
											</li>
											<li class="flex items-center">
												<span class="w-2 h-2 bg-purple-500 rounded-full mr-2"></span>
												<span class="text-sm">Data Editor - Dynamic content and binding</span>
											</li>
											<li class="flex items-center">
												<span class="w-2 h-2 bg-red-500 rounded-full mr-2"></span>
												<span class="text-sm">Event Editor - Interactions and behavior</span>
											</li>
										</ul>
									</div>
									<div>
										<h4 class="font-semibold text-gray-900 mb-3">Key Features</h4>
										<ul class="space-y-2">
											<li class="flex items-center">
												<svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
													<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
												</svg>
												<span class="text-sm">Real-time preview updates</span>
											</li>
											<li class="flex items-center">
												<svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
													<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
												</svg>
												<span class="text-sm">Undo/redo functionality</span>
											</li>
											<li class="flex items-center">
												<svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
													<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
												</svg>
												<span class="text-sm">Property validation</span>
											</li>
											<li class="flex items-center">
												<svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
													<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
												</svg>
												<span class="text-sm">Copy/paste properties</span>
											</li>
										</ul>
									</div>
								</div>
								
								<div class="flex justify-between">
									<button class="px-6 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" onclick="previousTutorialStep()">Previous</button>
									<button class="px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" onclick="nextTutorialStep()">Next Step</button>
								</div>
							</div>
							
							<div class="tutorial-step hidden" id="tutorial-step-4">
								<h3 class="text-2xl font-bold text-gray-900 mb-4">Step 4: Preview & Export</h3>
								<p class="text-gray-600 mb-6">Test your design across different devices and export the schema for production use.</p>
								
								<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
									<div>
										<h4 class="font-semibold text-gray-900 mb-3">Device Testing</h4>
										<div class="space-y-3">
											<div class="flex items-center justify-between p-3 border border-gray-200 rounded">
												<div class="flex items-center">
													<span class="text-2xl mr-3">🖥️</span>
													<span class="text-sm font-medium">Desktop</span>
												</div>
												<span class="text-xs text-gray-500">1920×1080</span>
											</div>
											<div class="flex items-center justify-between p-3 border border-gray-200 rounded">
												<div class="flex items-center">
													<span class="text-2xl mr-3">📱</span>
													<span class="text-sm font-medium">Tablet</span>
												</div>
												<span class="text-xs text-gray-500">768×1024</span>
											</div>
											<div class="flex items-center justify-between p-3 border border-gray-200 rounded">
												<div class="flex items-center">
													<span class="text-2xl mr-3">📲</span>
													<span class="text-sm font-medium">Mobile</span>
												</div>
												<span class="text-xs text-gray-500">375×667</span>
											</div>
										</div>
									</div>
									<div>
										<h4 class="font-semibold text-gray-900 mb-3">Export Options</h4>
										<div class="space-y-3">
											<div class="flex items-center p-3 border border-gray-200 rounded">
												<span class="text-2xl mr-3">📄</span>
												<div>
													<span class="text-sm font-medium block">JSON Schema</span>
													<span class="text-xs text-gray-500">For integration with your app</span>
												</div>
											</div>
											<div class="flex items-center p-3 border border-gray-200 rounded">
												<span class="text-2xl mr-3">🎨</span>
												<div>
													<span class="text-sm font-medium block">HTML Preview</span>
													<span class="text-xs text-gray-500">Standalone HTML file</span>
												</div>
											</div>
											<div class="flex items-center p-3 border border-gray-200 rounded">
												<span class="text-2xl mr-3">📋</span>
												<div>
													<span class="text-sm font-medium block">Template</span>
													<span class="text-xs text-gray-500">Save as reusable template</span>
												</div>
											</div>
										</div>
									</div>
								</div>
								
								<div class="flex justify-between">
									<button class="px-6 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" onclick="previousTutorialStep()">Previous</button>
									<button class="px-6 py-2 bg-green-600 text-white rounded hover:bg-green-700" onclick="startBuilder()">Start Building!</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Visual Builder Demo -->
			<div class="demo-section hidden" id="demo-builder">
				<div class="h-full flex">
					<!-- Component Toolbox -->
					<div class="w-80 bg-white border-r border-gray-200 overflow-y-auto">
						if registry != nil {
							@Toolbox(registry)
						}
					</div>
					
					<!-- Main Canvas Area -->
					<div class="flex-1 flex flex-col">
						<!-- Canvas Toolbar -->
						<div class="bg-white border-b border-gray-200 p-4">
							<div class="flex items-center justify-between">
								<div class="flex items-center space-x-4">
									<h3 class="font-semibold text-gray-900">Canvas</h3>
									<div class="flex items-center space-x-2">
										<button class="p-1 hover:bg-gray-100 rounded" title="Undo">
											<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
											</svg>
										</button>
										<button class="p-1 hover:bg-gray-100 rounded" title="Redo">
											<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 10h-10a8 8 0 00-8 8v2m18-10l-6-6m6 6l-6 6"></path>
											</svg>
										</button>
									</div>
								</div>
								<div class="flex items-center space-x-2">
									<select class="text-sm border border-gray-300 rounded px-2 py-1">
										<option value="100">100%</option>
										<option value="75">75%</option>
										<option value="50">50%</option>
										<option value="25">25%</option>
									</select>
									<button class="px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">Preview</button>
								</div>
							</div>
						</div>
						
						<!-- Canvas -->
						<div class="flex-1 bg-gray-100 overflow-auto">
							if registry != nil {
								@Canvas(registry)
							}
						</div>
					</div>
					
					<!-- Property Editor -->
