							<!-- Component Registry -->
							<div class="feature-card bg-white rounded-lg shadow-lg p-6">
								<div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center mb-4">
									<svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14-7H3a2 2 0 00-2 2v8a2 2 0 002 2h2l3-3 3 3h2a2 2 0 002-2V6a2 2 0 00-2-2z"></path>
