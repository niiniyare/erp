								</ul>
							</div>
							
							<!-- Device Emulation -->
							<div class="feature-card bg-white rounded-lg shadow-lg p-6">
								<div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
									<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a1 1 0 001-1V4a1 1 0 00-1-1H8a1 1 0 00-1 1v16a1 1 0 001 1z"></path>
									</svg>
								</div>
								<h3 class="text-xl font-bold text-gray-900 mb-2">Device Emulation</h3>
								<p class="text-gray-600 mb-4">Test your designs across multiple devices with built-in emulation and responsive testing.</p>
								<ul class="text-sm text-gray-600 space-y-1">
									<li>• Multiple device presets</li>
