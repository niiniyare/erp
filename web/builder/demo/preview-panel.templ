package demo

import (
	"github.com/niiniyare/erp/web/builder/core"
)

// PreviewPanel renders a simple preview panel for the demo
templ PreviewPanel(registry *core.ComponentRegistry) {
	<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
		<!-- Preview Header -->
		<div class="bg-gray-50 px-4 py-3 border-b border-gray-200">
			<div class="flex items-center justify-between">
				<h4 class="font-semibold text-gray-900">Live Preview</h4>
				<div class="flex items-center space-x-2">
					<!-- Device selector -->
					<select 
						id="device-selector"
						class="text-sm border border-gray-300 rounded px-2 py-1"
						onchange="changeDevice(this.value)"
					>
						<option value="desktop">Desktop</option>
						<option value="tablet">Tablet</option>
						<option value="mobile">Mobile</option>
					</select>
					
					<!-- Refresh button -->
					<button 
						class="p-1 hover:bg-gray-200 rounded"
						onclick="refreshPreview()"
						title="Refresh Preview"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
						</svg>
					</button>
				</div>
			</div>
		</div>
		
		<!-- Preview Content -->
		<div class="relative bg-gray-100" style="height: 400px;">
			<!-- Device Frame -->
			<div id="preview-frame" class="absolute inset-4 bg-white rounded-lg shadow-inner overflow-hidden transition-all duration-300">
				<div id="preview-content" class="w-full h-full relative">
					<!-- Default preview content -->
					<div class="flex items-center justify-center h-full text-center" id="preview-placeholder">
						<div>
							<div class="text-4xl mb-2">📱</div>
							<p class="text-gray-500">Preview will appear here</p>
							<p class="text-sm text-gray-400 mt-1">Add components to see the live preview</p>
						</div>
					</div>
					
					<!-- Dynamic content will be inserted here -->
				</div>
			</div>
			
			<!-- Loading overlay -->
			<div id="preview-loading" class="absolute inset-0 bg-white bg-opacity-75 flex items-center justify-center hidden">
				<div class="flex items-center space-x-2">
					<div class="animate-spin rounded-full h-4 w-4 border-b-2 border-blue-600"></div>
					<span class="text-sm text-gray-600">Updating preview...</span>
				</div>
			</div>
		</div>
		
		<!-- Preview Footer -->
		<div class="bg-gray-50 px-4 py-2 border-t border-gray-200">
			<div class="flex items-center justify-between text-xs text-gray-500">
				<span id="preview-stats">0 components</span>
				<span id="preview-dimensions">1200 × 800</span>
			</div>
		</div>
	</div>
	
	<script>
		// Preview state
		let currentDevice = 'desktop';
		let componentCount = 0;
		
		const deviceSizes = {
			desktop: { width: '100%', height: '100%', label: '1200 × 800' },
			tablet: { width: '768px', height: '1024px', label: '768 × 1024' },
			mobile: { width: '375px', height: '667px', label: '375 × 667' }
		};
		
		function changeDevice(device) {
			currentDevice = device;
			const frame = document.getElementById('preview-frame');
			const size = deviceSizes[device];
			
			if (device === 'desktop') {
				frame.style.width = size.width;
				frame.style.height = size.height;
				frame.style.maxWidth = 'none';
				frame.style.maxHeight = 'none';
			} else {
				frame.style.width = size.width;
				frame.style.height = size.height;
				frame.style.maxWidth = size.width;
				frame.style.maxHeight = size.height;
				frame.style.margin = 'auto';
				frame.style.top = '50%';
				frame.style.left = '50%';
				frame.style.transform = 'translate(-50%, -50%)';
			}
			
			updateDimensions(size.label);
		}
		
		function refreshPreview() {
			showLoading();
			// Simulate preview refresh
			setTimeout(() => {
				hideLoading();
				console.log('Preview refreshed for device:', currentDevice);
			}, 500);
		}
		
		function showLoading() {
			document.getElementById('preview-loading').classList.remove('hidden');
		}
		
		function hideLoading() {
			document.getElementById('preview-loading').classList.add('hidden');
		}
		
		function updateComponentCount(count) {
			componentCount = count;
			document.getElementById('preview-stats').textContent = count + ' component' + (count !== 1 ? 's' : '');
		}
		
		function updateDimensions(dimensions) {
			document.getElementById('preview-dimensions').textContent = dimensions;
		}
		
		function addComponentToPreview(componentType, componentData) {
			const content = document.getElementById('preview-content');
			const placeholder = document.getElementById('preview-placeholder');
			
			// Hide placeholder if this is the first component
			if (componentCount === 0) {
				placeholder.style.display = 'none';
			}
			
			// Create component preview element
			const component = document.createElement('div');
			component.className = 'absolute border border-blue-200 bg-blue-50 p-2 text-sm rounded';
			component.style.left = (componentData.x || 10) + 'px';
			component.style.top = (componentData.y || 10) + 'px';
			component.style.width = (componentData.width || 120) + 'px';
			component.style.height = (componentData.height || 60) + 'px';
			component.innerHTML = '<strong>' + componentType + '</strong><br><span class="text-xs text-gray-600">Demo Component</span>';
			
			content.appendChild(component);
			updateComponentCount(componentCount + 1);
		}
		
		function clearPreview() {
			const content = document.getElementById('preview-content');
			const placeholder = document.getElementById('preview-placeholder');
			
			// Remove all components except placeholder
			const components = content.querySelectorAll('div:not(#preview-placeholder)');
			components.forEach(comp => comp.remove());
			
			// Show placeholder
			placeholder.style.display = 'flex';
			updateComponentCount(0);
		}
		
		// Make functions globally available
		window.addComponentToPreview = addComponentToPreview;
		window.clearPreview = clearPreview;
		window.updateComponentCount = updateComponentCount;
	</script>
}