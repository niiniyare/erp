package demo

import (
	"github.com/niiniyare/erp/web/builder/core"
)

// Toolbox renders a simple component toolbox for the demo
templ Toolbox(registry *core.ComponentRegistry) {
	<div class="bg-white p-4 rounded-lg shadow">
		<h4 class="font-semibold text-gray-900 mb-3">Component Toolbox</h4>
		<div class="space-y-2">
			for _, category := range registry.GetCategories() {
				<div class="border rounded p-2">
					<div class="font-medium text-sm text-gray-700 mb-1">{ category.Name }</div>
					<div class="grid grid-cols-2 gap-1">
						for _, component := range registry.GetComponentsByCategory(category.ID) {
							<button 
								class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 px-2 py-1 rounded border border-blue-200 transition-colors"
								data-component-type={ component.Type }
								onclick="addComponent(this.dataset.componentType)"
							>
								{ component.Name }
							</button>
						}
					</div>
				</div>
			}
		</div>
	</div>
	
	<script>
		function addComponent(componentType) {
			// Simple demo function - in real implementation this would
			// interact with the visual builder
			console.log('Adding component:', componentType);
			alert('Demo: Would add ' + componentType + ' component to the canvas');
		}
	</script>
}