package ui

import (
	"github.com/niiniyare/erp/web/builder/templates"
)

// TemplateGallery renders the template browser interface
templ TemplateGallery(library *templates.TemplateLibrary) {
	<div class="bg-white border-l border-gray-200 w-96 flex flex-col h-full">
		<!-- Template Gallery Header -->
		<div class="p-4 border-b border-gray-200">
			<div class="flex items-center justify-between mb-3">
				<h3 class="text-lg font-semibold text-gray-900">Template Gallery</h3>
				<button 
					class="p-1 hover:bg-gray-100 rounded"
					onclick="toggleTemplateGallery()"
					title="Toggle Template Gallery"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14-7H3a2 2 0 00-2 2v8a2 2 0 002 2h2l3-3 3 3h2a2 2 0 002-2V6a2 2 0 00-2-2z"></path>
					</svg>
				</button>
			</div>
			
			<!-- Search Bar -->
			<div class="relative mb-3">
				<input 
					type="text" 
					id="template-search"
					placeholder="Search templates..."
					class="w-full pl-8 pr-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
					oninput="searchTemplates(this.value)"
				/>
				<svg class="absolute left-2.5 top-2.5 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
				</svg>
			</div>
			
			<!-- Quick Filters -->
			<div class="flex items-center space-x-2 mb-3">
				<button 
					class="filter-btn active" 
					data-filter="all"
					onclick="setQuickFilter('all')"
				>
					All
				</button>
				<button 
					class="filter-btn" 
					data-filter="featured"
					onclick="setQuickFilter('featured')"
				>
					⭐ Featured
				</button>
				<button 
					class="filter-btn" 
					data-filter="popular"
					onclick="setQuickFilter('popular')"
				>
					🔥 Popular
				</button>
				<button 
					class="filter-btn" 
					data-filter="recent"
					onclick="setQuickFilter('recent')"
				>
					🆕 Recent
				</button>
			</div>
		</div>
		
		<!-- Filters Panel -->
		<div class="p-4 border-b border-gray-200 bg-gray-50" id="filters-panel">
			<!-- Category Filter -->
			<div class="mb-3">
				<label class="block text-xs font-medium text-gray-700 mb-1">Category</label>
				<select 
					id="category-filter"
					class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
					onchange="updateFilters()"
				>
					<option value="">All Categories</option>
					<option value="dashboard">📊 Dashboard</option>
					<option value="forms">📝 Forms</option>
					<option value="tables">📋 Tables</option>
					<option value="navigation">🧭 Navigation</option>
					<option value="auth">🔐 Authentication</option>
					<option value="ecommerce">🛒 E-commerce</option>
					<option value="admin">⚙️ Admin</option>
					<option value="landing">🎯 Landing Pages</option>
					<option value="crm">👥 CRM</option>
					<option value="finance">💰 Finance</option>
					<option value="healthcare">🏥 Healthcare</option>
					<option value="education">🎓 Education</option>
				</select>
			</div>
			
			<!-- Complexity Filter -->
			<div class="mb-3">
				<label class="block text-xs font-medium text-gray-700 mb-1">Complexity</label>
				<div class="flex space-x-1">
					<label class="flex items-center text-xs">
						<input type="checkbox" class="complexity-filter mr-1" value="simple" onchange="updateFilters()"/>
						Simple
					</label>
					<label class="flex items-center text-xs">
						<input type="checkbox" class="complexity-filter mr-1" value="intermediate" onchange="updateFilters()"/>
						Intermediate
					</label>
					<label class="flex items-center text-xs">
						<input type="checkbox" class="complexity-filter mr-1" value="advanced" onchange="updateFilters()"/>
						Advanced
					</label>
				</div>
			</div>
			
			<!-- Industry Filter -->
			<div class="mb-3">
				<label class="block text-xs font-medium text-gray-700 mb-1">Industry</label>
				<select 
					id="industry-filter"
					class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
					onchange="updateFilters()"
				>
					<option value="">All Industries</option>
					<option value="healthcare">Healthcare</option>
					<option value="finance">Finance</option>
					<option value="ecommerce">E-commerce</option>
					<option value="education">Education</option>
					<option value="manufacturing">Manufacturing</option>
					<option value="retail">Retail</option>
					<option value="technology">Technology</option>
				</select>
			</div>
			
			<!-- Sort Options -->
			<div class="mb-3">
				<label class="block text-xs font-medium text-gray-700 mb-1">Sort By</label>
				<select 
					id="sort-filter"
					class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
					onchange="updateFilters()"
				>
					<option value="name">Name</option>
					<option value="rating">Rating</option>
					<option value="usage">Popularity</option>
					<option value="created">Date Created</option>
					<option value="updated">Last Updated</option>
				</select>
			</div>
			
			<!-- Toggle Filters -->
			<div class="flex items-center justify-between">
				<button 
					class="text-xs text-blue-600 hover:text-blue-800"
					onclick="clearFilters()"
				>
					Clear Filters
				</button>
				<button 
					class="text-xs text-gray-600 hover:text-gray-800"
					onclick="toggleFiltersPanel()"
				>
					Hide Filters
				</button>
			</div>
		</div>
		
		<!-- Template Grid -->
		<div class="flex-1 overflow-y-auto p-4">
			<div id="template-grid" class="space-y-3">
				<!-- Templates will be loaded here -->
				<div class="text-center py-8 text-gray-500">
					<svg class="w-12 h-12 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14-7H3a2 2 0 00-2 2v8a2 2 0 002 2h2l3-3 3 3h2a2 2 0 002-2V6a2 2 0 00-2-2z"></path>
					</svg>
					<p class="text-sm">Loading templates...</p>
				</div>
			</div>
			
			<!-- Load More Button -->
			<div class="text-center mt-4">
				<button 
					id="load-more-btn"
					class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 text-sm hidden"
					onclick="loadMoreTemplates()"
				>
					Load More Templates
				</button>
			</div>
		</div>
		
		<!-- Template Favorites -->
		<div class="p-4 border-t border-gray-200 bg-gray-50">
			<h4 class="text-sm font-medium text-gray-700 mb-2">Your Favorites</h4>
			<div id="favorite-templates" class="flex space-x-2 overflow-x-auto">
				<!-- Favorite templates will be loaded here -->
				<div class="text-xs text-gray-500">No favorites yet</div>
			</div>
		</div>
	</div>
	
	<!-- Template Preview Modal -->
	<div id="template-preview-modal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden">
		<div class="flex items-center justify-center h-full p-4">
			<div class="bg-white rounded-lg shadow-xl max-w-4xl w-full max-h-90vh overflow-hidden">
				<!-- Modal Header -->
				<div class="p-6 border-b border-gray-200">
					<div class="flex items-center justify-between">
						<div>
							<h3 class="text-xl font-semibold text-gray-900" id="modal-template-title">Template Preview</h3>
							<p class="text-sm text-gray-600 mt-1" id="modal-template-description">Template description</p>
						</div>
						<button 
							class="p-2 hover:bg-gray-100 rounded"
							onclick="closeTemplatePreview()"
						>
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>
					
					<!-- Template Metadata -->
					<div class="flex items-center space-x-4 mt-3 text-sm text-gray-600">
						<span id="modal-template-author">By: Author</span>
						<span id="modal-template-category">Category</span>
						<div class="flex items-center">
							<span id="modal-template-rating">4.5</span>
							<svg class="w-4 h-4 text-yellow-400 ml-1" fill="currentColor" viewBox="0 0 20 20">
								<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
							</svg>
						</div>
						<span id="modal-template-usage">Usage: 0</span>
					</div>
				</div>
				
				<!-- Modal Content -->
				<div class="flex h-96">
					<!-- Template Preview -->
					<div class="flex-1 bg-gray-100 p-4">
						<div class="bg-white rounded shadow h-full overflow-hidden">
							<iframe 
								id="modal-preview-frame"
								class="w-full h-full border-0"
								src=""
							></iframe>
						</div>
					</div>
					
					<!-- Template Details -->
					<div class="w-80 border-l border-gray-200 p-4 overflow-y-auto">
						<!-- Template Tags -->
						<div class="mb-4">
							<h4 class="text-sm font-medium text-gray-700 mb-2">Tags</h4>
							<div id="modal-template-tags" class="flex flex-wrap gap-1">
								<!-- Tags will be loaded here -->
							</div>
						</div>
						
						<!-- Template Features -->
						<div class="mb-4">
							<h4 class="text-sm font-medium text-gray-700 mb-2">Features</h4>
							<ul id="modal-template-features" class="text-sm text-gray-600 space-y-1">
								<!-- Features will be loaded here -->
							</ul>
						</div>
						
						<!-- Customization Variables -->
						<div class="mb-4" id="template-variables-section">
							<h4 class="text-sm font-medium text-gray-700 mb-2">Customization</h4>
							<div id="template-variables" class="space-y-2">
								<!-- Variables will be loaded here -->
							</div>
						</div>
						
						<!-- Template Actions -->
						<div class="space-y-2">
							<button 
								class="w-full px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
								onclick="useTemplate()"
								id="use-template-btn"
							>
								Use This Template
							</button>
							
							<button 
								class="w-full px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300"
								onclick="previewTemplate()"
							>
								Live Preview
							</button>
							
							<div class="flex space-x-2">
								<button 
									class="flex-1 px-3 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600 text-sm"
									onclick="toggleTemplateFavorite()"
									id="favorite-btn"
								>
									⭐ Favorite
								</button>
								
								<button 
									class="flex-1 px-3 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm"
									onclick="cloneTemplate()"
								>
									📋 Clone
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	
	<!-- Template Gallery JavaScript -->
	<script>
		// Template gallery state
		const templateGalleryState = {
			currentFilter: 'all',
			currentPage: 1,
			pageSize: 12,
			totalPages: 1,
			templates: [],
			filteredTemplates: [],
			favorites: JSON.parse(localStorage.getItem('template-favorites') || '[]'),
			currentTemplate: null,
			searchQuery: '',
			filters: {
				category: '',
				complexity: [],
				industry: '',
				sortBy: 'name',
				sortOrder: 'asc'
			}
		};

		// Initialize template gallery
		document.addEventListener('DOMContentLoaded', function() {
			initializeTemplateGallery();
			loadTemplates();
			loadFavoriteTemplates();
		});

		function initializeTemplateGallery() {
			// Setup event listeners
			setupTemplateGalleryEvents();
			
			// Load initial data
			updateFilters();
		}

		function setupTemplateGalleryEvents() {
			// Close modal on escape key
			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape') {
					closeTemplatePreview();
				}
			});
			
			// Close modal on backdrop click
			document.getElementById('template-preview-modal').addEventListener('click', function(e) {
				if (e.target === this) {
					closeTemplatePreview();
				}
			});
		}

		async function loadTemplates() {
			try {
				// Simulate API call
				const response = await fetch('/api/builder/templates', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
					},
					body: JSON.stringify({
						query: templateGalleryState.searchQuery,
						...templateGalleryState.filters,
						limit: templateGalleryState.pageSize,
						offset: (templateGalleryState.currentPage - 1) * templateGalleryState.pageSize
					})
				});
				
				const data = await response.json();
				templateGalleryState.templates = data.templates;
				templateGalleryState.filteredTemplates = data.templates;
				templateGalleryState.totalPages = Math.ceil(data.total / templateGalleryState.pageSize);
				
				renderTemplateGrid();
			} catch (error) {
				console.error('Error loading templates:', error);
				// Show sample templates for demo
				loadSampleTemplates();
			}
		}

		function loadSampleTemplates() {
			templateGalleryState.templates = [
				{
					id: 'dashboard-basic',
					name: 'Basic Dashboard',
					description: 'A clean and simple dashboard layout with metrics and charts',
					category: 'dashboard',
					tags: ['dashboard', 'admin', 'overview'],
					author: 'System',
					rating: 4.5,
					usageCount: 245,
					complexity: 'simple',
					thumbnail: '/images/templates/dashboard-basic.png',
					isFeatured: true,
					license: 'free'
				},
				{
					id: 'form-contact',
					name: 'Contact Form',
					description: 'Professional contact form with validation and styling',
					category: 'forms',
					tags: ['form', 'contact', 'lead'],
					author: 'System',
					rating: 4.2,
					usageCount: 189,
					complexity: 'simple',
					thumbnail: '/images/templates/form-contact.png',
					isFeatured: false,
					license: 'free'
				},
				{
					id: 'table-users',
					name: 'User Management Table',
					description: 'Advanced data table with sorting, filtering, and pagination',
					category: 'tables',
					tags: ['table', 'users', 'admin'],
					author: 'System',
					rating: 4.7,
					usageCount: 156,
					complexity: 'intermediate',
					thumbnail: '/images/templates/table-users.png',
					isFeatured: true,
					license: 'free'
				},
				{
					id: 'nav-sidebar',
					name: 'Sidebar Navigation',
					description: 'Responsive sidebar navigation with icons and submenus',
					category: 'navigation',
					tags: ['navigation', 'sidebar', 'menu'],
					author: 'System',
					rating: 4.3,
					usageCount: 298,
					complexity: 'intermediate',
					thumbnail: '/images/templates/nav-sidebar.png',
					isFeatured: false,
					license: 'free'
				},
				{
					id: 'auth-login',
					name: 'Login Page',
					description: 'Modern login page with social authentication options',
					category: 'auth',
					tags: ['login', 'authentication', 'security'],
					author: 'System',
					rating: 4.6,
					usageCount: 234,
					complexity: 'simple',
					thumbnail: '/images/templates/auth-login.png',
					isFeatured: true,
					license: 'free'
				},
				{
					id: 'ecommerce-product',
					name: 'Product Catalog',
					description: 'E-commerce product listing with filters and cart integration',
					category: 'ecommerce',
					tags: ['product', 'catalog', 'shopping'],
					author: 'System',
					rating: 4.4,
					usageCount: 167,
					complexity: 'advanced',
					thumbnail: '/images/templates/ecommerce-product.png',
					isFeatured: false,
					license: 'free'
				}
			];
			
			templateGalleryState.filteredTemplates = templateGalleryState.templates;
			renderTemplateGrid();
		}

		function renderTemplateGrid() {
			const grid = document.getElementById('template-grid');
			
			if (templateGalleryState.filteredTemplates.length === 0) {
				grid.innerHTML = `
					<div class="text-center py-8 text-gray-500">
						<svg class="w-12 h-12 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
						</svg>
						<p class="text-sm">No templates found</p>
						<p class="text-xs text-gray-400 mt-1">Try adjusting your filters</p>
					</div>
				`;
				return;
			}
			
			grid.innerHTML = templateGalleryState.filteredTemplates.map(template => `
				<div class="template-card border border-gray-200 rounded-lg hover:shadow-md transition-shadow cursor-pointer" onclick="showTemplatePreview('${template.id}')">
					<div class="p-3">
						<!-- Template Thumbnail -->
						<div class="aspect-video bg-gray-100 rounded mb-3 overflow-hidden">
							<img src="${template.thumbnail || '/images/template-placeholder.png'}" alt="${template.name}" class="w-full h-full object-cover"/>
						</div>
						
						<!-- Template Info -->
						<div class="space-y-2">
							<div class="flex items-start justify-between">
								<h4 class="text-sm font-medium text-gray-900 truncate">${template.name}</h4>
								<button 
									class="template-favorite-btn ${templateGalleryState.favorites.includes(template.id) ? 'active' : ''}"
									onclick="toggleTemplateFavorite('${template.id}', event)"
									title="Add to Favorites"
								>
									⭐
								</button>
							</div>
							
							<p class="text-xs text-gray-600 line-clamp-2">${template.description}</p>
							
							<!-- Template Metadata -->
							<div class="flex items-center justify-between text-xs text-gray-500">
								<span class="complexity-badge complexity-${template.complexity}">${template.complexity}</span>
								<div class="flex items-center space-x-2">
									<span class="flex items-center">
										${template.rating} ⭐
									</span>
									<span>${template.usageCount} uses</span>
								</div>
							</div>
							
							<!-- Template Tags -->
							<div class="flex flex-wrap gap-1">
								' + template.tags.slice(0, 3).map(tag => 
									'<span class="inline-block px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">' + tag + '</span>'
								).join('') + 
								(template.tags.length > 3 ? '<span class="text-xs text-gray-400">+' + (template.tags.length - 3) + '</span>' : '') + '
							</div>
						</div>
					</div>
				</div>
			`).join('');
			
			// Update load more button
			const loadMoreBtn = document.getElementById('load-more-btn');
			if (templateGalleryState.currentPage < templateGalleryState.totalPages) {
				loadMoreBtn.classList.remove('hidden');
			} else {
				loadMoreBtn.classList.add('hidden');
			}
		}

		function searchTemplates(query) {
			templateGalleryState.searchQuery = query.toLowerCase();
			applyFilters();
		}

		function setQuickFilter(filter) {
			templateGalleryState.currentFilter = filter;
			
			// Update button states
			document.querySelectorAll('.filter-btn').forEach(btn => {
				btn.classList.remove('active');
			});
			document.querySelector(`[data-filter="${filter}"]`).classList.add('active');
			
			// Apply filter
			switch (filter) {
				case 'featured':
					templateGalleryState.filteredTemplates = templateGalleryState.templates.filter(t => t.isFeatured);
					break;
				case 'popular':
					templateGalleryState.filteredTemplates = [...templateGalleryState.templates].sort((a, b) => b.usageCount - a.usageCount);
					break;
				case 'recent':
					templateGalleryState.filteredTemplates = [...templateGalleryState.templates].sort((a, b) => new Date(b.createdAt || Date.now()) - new Date(a.createdAt || Date.now()));
					break;
				default:
					templateGalleryState.filteredTemplates = templateGalleryState.templates;
			}
			
			applyFilters();
		}

		function updateFilters() {
			// Get filter values
			templateGalleryState.filters.category = document.getElementById('category-filter').value;
			templateGalleryState.filters.industry = document.getElementById('industry-filter').value;
			templateGalleryState.filters.sortBy = document.getElementById('sort-filter').value;
			
			// Get complexity filters
			templateGalleryState.filters.complexity = Array.from(document.querySelectorAll('.complexity-filter:checked')).map(cb => cb.value);
			
			applyFilters();
		}

		function applyFilters() {
			let filtered = templateGalleryState.templates;
			
			// Apply search query
			if (templateGalleryState.searchQuery) {
				filtered = filtered.filter(template => 
					template.name.toLowerCase().includes(templateGalleryState.searchQuery) ||
					template.description.toLowerCase().includes(templateGalleryState.searchQuery) ||
					template.tags.some(tag => tag.toLowerCase().includes(templateGalleryState.searchQuery))
				);
			}
			
			// Apply category filter
			if (templateGalleryState.filters.category) {
				filtered = filtered.filter(template => template.category === templateGalleryState.filters.category);
			}
			
			// Apply complexity filter
			if (templateGalleryState.filters.complexity.length > 0) {
				filtered = filtered.filter(template => templateGalleryState.filters.complexity.includes(template.complexity));
			}
			
			// Apply industry filter
			if (templateGalleryState.filters.industry) {
				filtered = filtered.filter(template => 
					template.industries && template.industries.includes(templateGalleryState.filters.industry)
				);
			}
			
			// Apply sorting
			filtered.sort((a, b) => {
				let comparison = 0;
				switch (templateGalleryState.filters.sortBy) {
					case 'rating':
						comparison = b.rating - a.rating;
						break;
					case 'usage':
						comparison = b.usageCount - a.usageCount;
						break;
					case 'created':
						comparison = new Date(b.createdAt || 0) - new Date(a.createdAt || 0);
						break;
					case 'updated':
						comparison = new Date(b.updatedAt || 0) - new Date(a.updatedAt || 0);
						break;
					default:
						comparison = a.name.localeCompare(b.name);
				}
				return comparison;
			});
			
			templateGalleryState.filteredTemplates = filtered;
			renderTemplateGrid();
		}

		function showTemplatePreview(templateId) {
			const template = templateGalleryState.templates.find(t => t.id === templateId);
			if (!template) return;
			
			templateGalleryState.currentTemplate = template;
			
			// Update modal content
			document.getElementById('modal-template-title').textContent = template.name;
			document.getElementById('modal-template-description').textContent = template.description;
			document.getElementById('modal-template-author').textContent = `By: ${template.author}`;
			document.getElementById('modal-template-category').textContent = template.category;
			document.getElementById('modal-template-rating').textContent = template.rating;
			document.getElementById('modal-template-usage').textContent = `Usage: ${template.usageCount}`;
			
			// Update tags
			const tagsContainer = document.getElementById('modal-template-tags');
			tagsContainer.innerHTML = template.tags.map(tag => `
				<span class="inline-block px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded">${tag}</span>
			`).join('');
			
			// Update features
			const featuresContainer = document.getElementById('modal-template-features');
			const features = template.features || ['Responsive design', 'Cross-browser compatible', 'Accessibility compliant'];
			featuresContainer.innerHTML = features.map(feature => `<li>• ${feature}</li>`).join('');
			
			// Update favorite button
			const favoriteBtn = document.getElementById('favorite-btn');
			if (templateGalleryState.favorites.includes(template.id)) {
				favoriteBtn.textContent = '⭐ Favorited';
				favoriteBtn.classList.add('bg-yellow-600');
				favoriteBtn.classList.remove('bg-yellow-500');
			} else {
				favoriteBtn.textContent = '⭐ Favorite';
				favoriteBtn.classList.add('bg-yellow-500');
				favoriteBtn.classList.remove('bg-yellow-600');
			}
			
			// Show modal
			document.getElementById('template-preview-modal').classList.remove('hidden');
		}

		function closeTemplatePreview() {
			document.getElementById('template-preview-modal').classList.add('hidden');
			templateGalleryState.currentTemplate = null;
		}

		function useTemplate() {
			if (!templateGalleryState.currentTemplate) return;
			
			// Close modal
			closeTemplatePreview();
			
			// Notify main application
			window.dispatchEvent(new CustomEvent('templateSelected', {
				detail: { 
					template: templateGalleryState.currentTemplate,
					variables: getTemplateVariables()
				}
			}));
			
			showNotification(`Template "${templateGalleryState.currentTemplate.name}" applied!`, 'success');
		}

		function previewTemplate() {
			if (!templateGalleryState.currentTemplate) return;
			
			// Update preview frame
			const iframe = document.getElementById('modal-preview-frame');
			iframe.src = `/api/builder/templates/${templateGalleryState.currentTemplate.id}/preview`;
		}

		function cloneTemplate() {
			if (!templateGalleryState.currentTemplate) return;
			
			// TODO: Implement template cloning
			showNotification(`Template "${templateGalleryState.currentTemplate.name}" cloned!`, 'success');
		}

		function toggleTemplateFavorite(templateId, event) {
			if (event) event.stopPropagation();
			
			const index = templateGalleryState.favorites.indexOf(templateId);
			if (index > -1) {
				templateGalleryState.favorites.splice(index, 1);
			} else {
				templateGalleryState.favorites.push(templateId);
			}
			
			// Save to localStorage
			localStorage.setItem('template-favorites', JSON.stringify(templateGalleryState.favorites));
			
			// Update UI
			renderTemplateGrid();
			loadFavoriteTemplates();
			
			if (templateGalleryState.currentTemplate && templateGalleryState.currentTemplate.id === templateId) {
				// Update modal favorite button
				const favoriteBtn = document.getElementById('favorite-btn');
				if (templateGalleryState.favorites.includes(templateId)) {
					favoriteBtn.textContent = '⭐ Favorited';
					favoriteBtn.classList.add('bg-yellow-600');
					favoriteBtn.classList.remove('bg-yellow-500');
				} else {
					favoriteBtn.textContent = '⭐ Favorite';
					favoriteBtn.classList.add('bg-yellow-500');
					favoriteBtn.classList.remove('bg-yellow-600');
				}
			}
		}

		function loadFavoriteTemplates() {
			const favoritesContainer = document.getElementById('favorite-templates');
			const favoriteTemplates = templateGalleryState.templates.filter(t => 
				templateGalleryState.favorites.includes(t.id)
			);
			
			if (favoriteTemplates.length === 0) {
				favoritesContainer.innerHTML = '<div class="text-xs text-gray-500">No favorites yet</div>';
				return;
			}
			
			favoritesContainer.innerHTML = favoriteTemplates.map(template => `
				<div class="flex-shrink-0 w-16 cursor-pointer" onclick="showTemplatePreview('${template.id}')" title="${template.name}">
					<div class="aspect-square bg-gray-100 rounded mb-1 overflow-hidden">
						<img src="${template.thumbnail || '/images/template-placeholder.png'}" alt="${template.name}" class="w-full h-full object-cover"/>
					</div>
					<div class="text-xs text-gray-600 truncate">${template.name}</div>
				</div>
			`).join('');
		}

		function getTemplateVariables() {
			// Collect variable values from the modal form
			const variables = {};
			document.querySelectorAll('[data-template-variable]').forEach(input => {
				const varName = input.dataset.templateVariable;
				variables[varName] = input.value;
			});
			return variables;
		}

		function clearFilters() {
			document.getElementById('category-filter').value = '';
			document.getElementById('industry-filter').value = '';
			document.getElementById('sort-filter').value = 'name';
			document.querySelectorAll('.complexity-filter').forEach(cb => cb.checked = false);
			
			templateGalleryState.filters = {
				category: '',
				complexity: [],
				industry: '',
				sortBy: 'name',
				sortOrder: 'asc'
			};
			
			applyFilters();
		}

		function toggleFiltersPanel() {
			const panel = document.getElementById('filters-panel');
			panel.classList.toggle('hidden');
		}

		function toggleTemplateGallery() {
			const gallery = document.querySelector('.bg-white.border-l.w-96');
			gallery.classList.toggle('hidden');
		}

		function loadMoreTemplates() {
			templateGalleryState.currentPage++;
			loadTemplates();
		}

		function showNotification(message, type = 'info') {
			// Create notification element
			const notification = document.createElement('div');
			notification.className = `fixed top-4 right-4 px-4 py-2 rounded shadow-lg z-50 text-white text-sm`;
			
			switch (type) {
				case 'success':
					notification.classList.add('bg-green-600');
					break;
				case 'error':
					notification.classList.add('bg-red-600');
					break;
				case 'warning':
					notification.classList.add('bg-yellow-600');
					break;
				default:
					notification.classList.add('bg-blue-600');
			}
			
			notification.textContent = message;
			document.body.appendChild(notification);
			
			// Auto remove after 3 seconds
			setTimeout(() => {
				notification.remove();
			}, 3000);
		}

		// Export template gallery functions
		window.TemplateGallery = {
			showPreview: showTemplatePreview,
			useTemplate: useTemplate,
			toggleFavorite: toggleTemplateFavorite,
			search: searchTemplates,
			setFilter: setQuickFilter
		};
	</script>
	
	<!-- Template Gallery Styles -->
	<style>
		.filter-btn {
			@apply px-3 py-1 text-xs border border-gray-300 rounded hover:bg-gray-50 transition-colors;
		}
		
		.filter-btn.active {
			@apply bg-blue-600 text-white border-blue-600;
		}
		
		.template-card:hover {
			@apply transform scale-105 transition-transform;
		}
		
		.template-favorite-btn {
			@apply text-gray-400 hover:text-yellow-500 transition-colors;
		}
		
		.template-favorite-btn.active {
			@apply text-yellow-500;
		}
		
		.complexity-badge {
			@apply px-2 py-1 rounded text-xs font-medium;
		}
		
		.complexity-simple {
			@apply bg-green-100 text-green-800;
		}
		
		.complexity-intermediate {
			@apply bg-yellow-100 text-yellow-800;
		}
		
		.complexity-advanced {
			@apply bg-red-100 text-red-800;
		}
		
		.line-clamp-2 {
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		
		.max-h-90vh {
			max-height: 90vh;
		}
	</style>
}