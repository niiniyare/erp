package ui

import (
	"fmt"
	"strings"
	"github.com/niiniyare/erp/web/builder/core"
)

// Toolbox renders the component palette and tool controls
templ Toolbox(registry *core.ComponentRegistry) {
	<div class="w-80 bg-white border-r border-gray-200 flex flex-col h-full">
		<!-- Toolbox Header -->
		<div class="p-4 border-b border-gray-200">
			<div class="flex items-center justify-between mb-3">
				<h2 class="text-lg font-semibold text-gray-900">Components</h2>
				<button 
					class="p-1 hover:bg-gray-100 rounded"
					onclick="toggleToolboxCollapse()"
					title="Collapse Toolbox"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path>
					</svg>
				</button>
			</div>
			
			<!-- Search Bar -->
			<div class="relative">
				<input 
					type="text" 
					id="component-search"
					placeholder="Search components..."
					class="w-full pl-8 pr-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
					oninput="filterComponents(this.value)"
				/>
				<svg class="absolute left-2.5 top-2.5 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
				</svg>
			</div>
		</div>
		
		<!-- Component Categories -->
		<div class="flex-1 overflow-y-auto">
			for _, category := range registry.GetCategories() {
				@ComponentCategory(category, registry.GetComponentsByCategory(category.ID))
			}
		</div>
		
		<!-- Toolbox Footer -->
		<div class="p-4 border-t border-gray-200">
			<div class="flex items-center justify-between text-sm text-gray-500">
				<span>Drag to add components</span>
				<div class="flex items-center space-x-2">
					<!-- Favorites Toggle -->
					<button 
						class="p-1 hover:bg-gray-100 rounded"
						onclick="toggleFavorites()"
						title="Show Favorites"
						id="favorites-toggle"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
						</svg>
					</button>
					
					<!-- Recent Components Toggle -->
					<button 
						class="p-1 hover:bg-gray-100 rounded"
						onclick="toggleRecent()"
						title="Recently Used"
						id="recent-toggle"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					</button>
				</div>
			</div>
		</div>
	</div>
	
	<!-- Toolbox JavaScript -->
	<script>
		// Toolbox state
		const toolboxState = {
			searchQuery: '',
			showFavorites: false,
			showRecent: false,
			favorites: JSON.parse(localStorage.getItem('component-favorites') || '[]'),
			recent: JSON.parse(localStorage.getItem('component-recent') || '[]'),
			collapsedCategories: JSON.parse(localStorage.getItem('collapsed-categories') || '[]')
		};
		
		// Initialize toolbox
		document.addEventListener('DOMContentLoaded', function() {
			initializeToolbox();
			restoreToolboxState();
		});
		
		function initializeToolbox() {
			// Setup component dragging
			setupComponentDragging();
			
			// Setup category collapse/expand
			setupCategoryToggles();
			
			// Setup favorites and recent
			updateFavoritesUI();
			updateRecentUI();
		}
		
		function setupComponentDragging() {
			// Make all component items draggable
			document.querySelectorAll('.component-item').forEach(item => {
				item.draggable = true;
				
				item.addEventListener('dragstart', function(e) {
					const componentType = this.dataset.componentType;
					e.dataTransfer.setData('application/component-type', componentType);
					e.dataTransfer.effectAllowed = 'copy';
					
					// Add visual feedback
					this.classList.add('dragging');
					
					// Add to recent components
					addToRecent(componentType);
				});
				
				item.addEventListener('dragend', function(e) {
					this.classList.remove('dragging');
				});
				
				// Double-click to add to center of canvas
				item.addEventListener('dblclick', function(e) {
					e.preventDefault();
					const componentType = this.dataset.componentType;
					addComponentToCenter(componentType);
					addToRecent(componentType);
				});
			});
		}
		
		function setupCategoryToggles() {
			document.querySelectorAll('.category-toggle').forEach(toggle => {
				toggle.addEventListener('click', function() {
					const categoryId = this.dataset.categoryId;
					toggleCategory(categoryId);
				});
			});
		}
		
		function filterComponents(query) {
			toolboxState.searchQuery = query.toLowerCase();
			
			const categories = document.querySelectorAll('.component-category');
			
			if (query.trim() === '') {
				// Show all categories and components
				categories.forEach(category => {
					category.style.display = 'block';
					const items = category.querySelectorAll('.component-item');
					items.forEach(item => item.style.display = 'flex');
				});
				return;
			}
			
			categories.forEach(category => {
				const items = category.querySelectorAll('.component-item');
				let hasVisibleItems = false;
				
				items.forEach(item => {
					const name = item.dataset.componentName.toLowerCase();
					const type = item.dataset.componentType.toLowerCase();
					const description = item.dataset.componentDescription?.toLowerCase() || '';
					const tags = item.dataset.componentTags?.toLowerCase() || '';
					
					const matches = name.includes(query) || 
								   type.includes(query) || 
								   description.includes(query) ||
								   tags.includes(query);
					
					item.style.display = matches ? 'flex' : 'none';
					if (matches) hasVisibleItems = true;
				});
				
				category.style.display = hasVisibleItems ? 'block' : 'none';
			});
		}
		
		function toggleCategory(categoryId) {
			const category = document.querySelector(`[data-category-id="${categoryId}"]`);
			const content = category.querySelector('.category-content');
			const icon = category.querySelector('.category-toggle svg');
			
			const isCollapsed = content.classList.contains('hidden');
			
			if (isCollapsed) {
				content.classList.remove('hidden');
				icon.style.transform = 'rotate(90deg)';
				toolboxState.collapsedCategories = toolboxState.collapsedCategories.filter(id => id !== categoryId);
			} else {
				content.classList.add('hidden');
				icon.style.transform = 'rotate(0deg)';
				toolboxState.collapsedCategories.push(categoryId);
			}
			
			// Save state
			localStorage.setItem('collapsed-categories', JSON.stringify(toolboxState.collapsedCategories));
		}
		
		function restoreToolboxState() {
			// Restore collapsed categories
			toolboxState.collapsedCategories.forEach(categoryId => {
				const category = document.querySelector(`[data-category-id="${categoryId}"]`);
				if (category) {
					const content = category.querySelector('.category-content');
					const icon = category.querySelector('.category-toggle svg');
					content.classList.add('hidden');
					icon.style.transform = 'rotate(0deg)';
				}
			});
		}
		
		function addToFavorites(componentType) {
			if (!toolboxState.favorites.includes(componentType)) {
				toolboxState.favorites.push(componentType);
				localStorage.setItem('component-favorites', JSON.stringify(toolboxState.favorites));
				updateFavoritesUI();
			}
		}
		
		function removeFromFavorites(componentType) {
			toolboxState.favorites = toolboxState.favorites.filter(type => type !== componentType);
			localStorage.setItem('component-favorites', JSON.stringify(toolboxState.favorites));
			updateFavoritesUI();
		}
		
		function addToRecent(componentType) {
			// Remove if already exists
			toolboxState.recent = toolboxState.recent.filter(type => type !== componentType);
			
			// Add to beginning
			toolboxState.recent.unshift(componentType);
			
			// Keep only last 10
			toolboxState.recent = toolboxState.recent.slice(0, 10);
			
			localStorage.setItem('component-recent', JSON.stringify(toolboxState.recent));
			updateRecentUI();
		}
		
		function updateFavoritesUI() {
			// Update favorite icons
			document.querySelectorAll('.component-item').forEach(item => {
				const componentType = item.dataset.componentType;
				const favoriteBtn = item.querySelector('.favorite-btn');
				
				if (toolboxState.favorites.includes(componentType)) {
					favoriteBtn.classList.add('favorited');
					favoriteBtn.innerHTML = '❤️';
				} else {
					favoriteBtn.classList.remove('favorited');
					favoriteBtn.innerHTML = '🤍';
				}
			});
		}
		
		function updateRecentUI() {
			// Add recent indicators
			document.querySelectorAll('.component-item').forEach(item => {
				const componentType = item.dataset.componentType;
				const recentIndicator = item.querySelector('.recent-indicator');
				
				if (toolboxState.recent.includes(componentType)) {
					recentIndicator.classList.remove('hidden');
				} else {
					recentIndicator.classList.add('hidden');
				}
			});
		}
		
		function toggleFavorites() {
			toolboxState.showFavorites = !toolboxState.showFavorites;
			const toggle = document.getElementById('favorites-toggle');
			
			if (toolboxState.showFavorites) {
				toggle.classList.add('active');
				showOnlyFavorites();
			} else {
				toggle.classList.remove('active');
				showAllComponents();
			}
		}
		
		function toggleRecent() {
			toolboxState.showRecent = !toolboxState.showRecent;
			const toggle = document.getElementById('recent-toggle');
			
			if (toolboxState.showRecent) {
				toggle.classList.add('active');
				showOnlyRecent();
			} else {
				toggle.classList.remove('active');
				showAllComponents();
			}
		}
		
		function showOnlyFavorites() {
			document.querySelectorAll('.component-item').forEach(item => {
				const componentType = item.dataset.componentType;
				item.style.display = toolboxState.favorites.includes(componentType) ? 'flex' : 'none';
			});
			
			// Hide empty categories
			updateCategoryVisibility();
		}
		
		function showOnlyRecent() {
			document.querySelectorAll('.component-item').forEach(item => {
				const componentType = item.dataset.componentType;
				item.style.display = toolboxState.recent.includes(componentType) ? 'flex' : 'none';
			});
			
			// Hide empty categories
			updateCategoryVisibility();
		}
		
		function showAllComponents() {
			document.querySelectorAll('.component-item').forEach(item => {
				item.style.display = 'flex';
			});
			
			document.querySelectorAll('.component-category').forEach(category => {
				category.style.display = 'block';
			});
		}
		
		function updateCategoryVisibility() {
			document.querySelectorAll('.component-category').forEach(category => {
				const visibleItems = Array.from(category.querySelectorAll('.component-item'))
					.filter(item => item.style.display !== 'none');
				
				category.style.display = visibleItems.length > 0 ? 'block' : 'none';
			});
		}
		
		function addComponentToCenter(componentType) {
			const canvas = document.getElementById('canvas-content');
			const canvasRect = canvas.getBoundingClientRect();
			
			// Add to center of visible area
			const centerX = (canvasRect.width / 2) / canvasState.zoom;
			const centerY = (canvasRect.height / 2) / canvasState.zoom;
			
			// Offset slightly for multiple components
			const offset = toolboxState.recent.indexOf(componentType) * 20;
			
			addComponentToCanvas(componentType, centerX + offset, centerY + offset);
		}
		
		function toggleToolboxCollapse() {
			const toolbox = document.querySelector('.toolbox');
			toolbox.classList.toggle('collapsed');
			
			// Save state
			const isCollapsed = toolbox.classList.contains('collapsed');
			localStorage.setItem('toolbox-collapsed', isCollapsed);
		}
		
		// Import/Export functionality
		function importComponents() {
			const input = document.createElement('input');
			input.type = 'file';
			input.accept = '.json';
			input.onchange = function(e) {
				const file = e.target.files[0];
				if (file) {
					const reader = new FileReader();
					reader.onload = function(e) {
						try {
							const data = JSON.parse(e.target.result);
							// Handle component import
							console.log('Importing components:', data);
						} catch (error) {
							alert('Error importing components: ' + error.message);
						}
					};
					reader.readAsText(file);
				}
			};
			input.click();
		}
		
		function exportComponents() {
			// Get current schema
			fetch('/api/builder/export')
				.then(response => response.json())
				.then(data => {
					const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
					const url = URL.createObjectURL(blob);
					const a = document.createElement('a');
					a.href = url;
					a.download = 'components.json';
					a.click();
					URL.revokeObjectURL(url);
				})
				.catch(error => {
					console.error('Error exporting components:', error);
				});
		}
	</script>
	
	<!-- Toolbox Styles -->
	<style>
		.component-item.dragging {
			opacity: 0.5;
			transform: scale(0.95);
		}
		
		.component-item:hover {
			background-color: #f3f4f6;
		}
		
		.category-toggle svg {
			transition: transform 0.2s ease;
		}
		
		.favorite-btn.favorited {
			color: #ef4444;
		}
		
		.recent-indicator {
			position: absolute;
			top: 2px;
			right: 2px;
			width: 6px;
			height: 6px;
			background: #10b981;
			border-radius: 50%;
		}
		
		#favorites-toggle.active,
		#recent-toggle.active {
			background-color: #dbeafe;
			color: #2563eb;
		}
		
		.toolbox.collapsed {
			width: 48px;
		}
		
		.toolbox.collapsed .toolbox-content {
			display: none;
		}
	</style>
}

// ComponentCategory renders a category section in the toolbox
templ ComponentCategory(category *core.ComponentCategory, components []*core.ComponentDefinition) {
	<div class="component-category" data-category-id={ category.ID }>
		<!-- Category Header -->
		<div class="category-header px-4 py-2 bg-gray-50 border-b border-gray-200">
			<button 
				class="category-toggle flex items-center w-full text-left"
				data-category-id={ category.ID }
			>
				<svg class="w-4 h-4 mr-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
				</svg>
				<span class="flex items-center">
					if category.Icon != "" {
						<span class="mr-2">{ getCategoryIcon(category.Icon) }</span>
					}
					<span class="font-medium text-sm">{ category.Name }</span>
					<span class="ml-2 text-xs text-gray-500">({ fmt.Sprintf("%d", len(components)) })</span>
				</span>
			</button>
		</div>
		
		<!-- Category Content -->
		<div class="category-content">
			for _, component := range components {
				@ComponentItem(component)
			}
		</div>
	</div>
}

// ComponentItem renders a single component in the palette
templ ComponentItem(component *core.ComponentDefinition) {
	<div 
		class="component-item relative flex items-center p-3 border-b border-gray-100 cursor-move select-none"
		data-component-type={ component.Type }
		data-component-name={ component.Name }
		data-component-description={ component.Description }
		data-component-tags={ strings.Join(component.Tags, " ") }
		title={ fmt.Sprintf("%s - %s", component.Name, component.Description) }
	>
		<!-- Component Icon/Preview -->
		<div class="w-8 h-8 mr-3 flex-shrink-0 flex items-center justify-center bg-gray-100 rounded border">
			if component.Thumbnail != "" {
				<img src={ component.Thumbnail } alt={ component.Name } class="w-6 h-6"/>
			} else {
				<span class="text-sm">{ getComponentIcon(component.Type) }</span>
			}
		</div>
		
		<!-- Component Info -->
		<div class="flex-1 min-w-0">
			<div class="flex items-center">
				<h4 class="text-sm font-medium text-gray-900 truncate">{ component.Name }</h4>
				<div class="ml-2 flex items-center space-x-1">
					<!-- Favorite Button -->
					<button 
						class="favorite-btn text-xs hover:scale-110 transition-transform"
						data-component-type={ component.Type }
						onclick="event.stopPropagation(); toggleFavorite(this.dataset.componentType)"
						title="Add to Favorites"
					>
						🤍
					</button>
					
					<!-- Recent Indicator -->
					<div class="recent-indicator hidden"></div>
				</div>
			</div>
			
			if component.Description != "" {
				<p class="text-xs text-gray-500 truncate mt-0.5">{ component.Description }</p>
			}
			
			<!-- Component Tags -->
			if len(component.Tags) > 0 {
				<div class="flex flex-wrap gap-1 mt-1">
					for _, tag := range component.Tags[:min(3, len(component.Tags))] {
						<span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs bg-gray-100 text-gray-600">
							{ tag }
						</span>
					}
					if len(component.Tags) > 3 {
						<span class="text-xs text-gray-400">+{ fmt.Sprintf("%d", len(component.Tags)-3) }</span>
					}
				</div>
			}
		</div>
		
		<!-- Drag Handle -->
		<div class="ml-2 text-gray-400">
			<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
				<path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path>
			</svg>
		</div>
	</div>
	
	<script>
		function toggleFavorite(componentType) {
			if (toolboxState.favorites.includes(componentType)) {
				removeFromFavorites(componentType);
			} else {
				addToFavorites(componentType);
			}
		}
	</script>
}

// Helper functions for icons and display
func getCategoryIcon(iconName string) string {
	icons := map[string]string{
		"atom":       "⚛️",
		"molecule":   "🧬",
		"organism":   "🦠",
		"layout":     "📐",
		"form":       "📝",
		"table":      "📊",
		"navigation": "🧭",
		"bell":       "🔔",
	}
	
	if icon, exists := icons[iconName]; exists {
		return icon
	}
	return "📦"
}

func getComponentIcon(componentType string) string {
	// Map component types to emoji icons
	icons := map[string]string{
		"atoms.button":      "🔘",
		"atoms.input":       "📝",
		"atoms.text":        "📄",
		"molecules.card":    "🗃️",
		"molecules.form":    "📋",
		"organisms.table":   "📊",
		"organisms.nav":     "🧭",
		"layouts.grid":      "⚏",
		"layouts.flex":      "⚌",
	}
	
	if icon, exists := icons[componentType]; exists {
		return icon
	}
	return "📦"
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}