package ui

import (
	"fmt"
	"github.com/niiniyare/erp/web/builder/core"
)

// GridBackground renders the grid pattern for the canvas
templ GridBackground(gridSize int, zoom float64) {
	<div 
		class="absolute inset-0 pointer-events-none grid-background"
		style={ fmt.Sprintf(`
			background-image: 
				linear-gradient(to right, #e5e7eb 1px, transparent 1px),
				linear-gradient(to bottom, #e5e7eb 1px, transparent 1px);
			background-size: %dpx %dpx;
		`, int(float64(gridSize)*zoom), int(float64(gridSize)*zoom)) }
	></div>
}

// ComponentInstance renders a single component instance on the canvas
templ ComponentInstance(component core.ComponentInstance, registry *core.ComponentRegistry, zoom float64) {
	<div 
		class="component-instance"
		data-component-id={ component.ID }
		data-component-type={ component.Type }
		data-locked={ fmt.Sprintf("%t", component.Locked) }
		style={ fmt.Sprintf(`
			left: %fpx;
			top: %fpx;
			width: %fpx;
			height: %fpx;
			z-index: %d;
			%s
		`, 
			component.Position.X, component.Position.Y,
			component.Size.Width, component.Size.Height,
			component.ZIndex,
			conditionalStyle(component.Hidden, "display: none;", ""),
		) }
		if component.Selected {
			class="component-instance selected"
		}
	>
		<!-- Component Preview -->
		@ComponentPreview(component, registry)
		
		<!-- Component Label -->
		<div class="absolute -top-6 left-0 text-xs bg-blue-600 text-white px-1 py-0.5 rounded text-nowrap pointer-events-none">
			{ getComponentDisplayName(component, registry) }
		</div>
		
		<!-- Lock Indicator -->
		if component.Locked {
			<div class="absolute top-1 right-1 text-red-500 pointer-events-none">
				<svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
				</svg>
			</div>
		}
	</div>
}

// ComponentPreview renders a preview of the component based on its type
templ ComponentPreview(component core.ComponentInstance, registry *core.ComponentRegistry) {
	<div class="w-full h-full overflow-hidden bg-white border border-gray-200 rounded">
		switch component.Type {
			case "atoms.button":
				@ButtonPreview(component)
			case "atoms.input":
				@InputPreview(component)
			case "molecules.card":
				@CardPreview(component)
			case "organisms.table":
				@TablePreview(component)
			case "organisms.form":
				@FormPreview(component)
			case "layouts.grid":
				@GridPreview(component)
			default:
				@GenericPreview(component)
		}
	</div>
}

// Component-specific previews
templ ButtonPreview(component core.ComponentInstance) {
	<div class="flex items-center justify-center w-full h-full">
		<button 
			class={ getButtonClasses(component) }
			disabled={ getBoolProp(component, "disabled") }
		>
			if icon := getStringProp(component, "icon"); icon != "" {
				<span class="mr-2">🔹</span>
			}
			{ getStringProp(component, "label") }
		</button>
	</div>
}

templ InputPreview(component core.ComponentInstance) {
	<div class="p-2 space-y-1">
		if label := getStringProp(component, "label"); label != "" {
			<label class="block text-sm font-medium text-gray-700">{ label }</label>
		}
		<input 
			type={ getStringProp(component, "type") }
			placeholder={ getStringProp(component, "placeholder") }
			class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm"
			disabled={ getBoolProp(component, "disabled") }
			if getBoolProp(component, "required") {
				required
			}
		/>
	</div>
}

templ CardPreview(component core.ComponentInstance) {
	<div class="p-3 h-full">
		<div class={ getCardClasses(component) }>
			if title := getStringProp(component, "title"); title != "" {
				<h3 class="text-lg font-semibold mb-2">{ title }</h3>
			}
			if content := getStringProp(component, "content"); content != "" {
				<p class="text-sm text-gray-600">{ content }</p>
			}
		</div>
	</div>
}

templ TablePreview(component core.ComponentInstance) {
	<div class="p-2">
		if title := getStringProp(component, "title"); title != "" {
			<h3 class="text-sm font-semibold mb-2">{ title }</h3>
		}
		<div class="border rounded">
			<table class="w-full text-xs">
				<thead class="bg-gray-50">
					<tr>
						<th class="px-2 py-1 text-left">Column 1</th>
						<th class="px-2 py-1 text-left">Column 2</th>
						<th class="px-2 py-1 text-left">Column 3</th>
					</tr>
				</thead>
				<tbody>
					<tr class="border-t">
						<td class="px-2 py-1">Row 1</td>
						<td class="px-2 py-1">Data</td>
						<td class="px-2 py-1">Value</td>
					</tr>
					<tr class="border-t">
						<td class="px-2 py-1">Row 2</td>
						<td class="px-2 py-1">Data</td>
						<td class="px-2 py-1">Value</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
}

templ FormPreview(component core.ComponentInstance) {
	<div class="p-3">
		if title := getStringProp(component, "title"); title != "" {
			<h3 class="text-sm font-semibold mb-3">{ title }</h3>
		}
		<div class={ getFormLayoutClasses(component) }>
			<div class="space-y-2">
				<label class="block text-xs font-medium">Field 1</label>
				<input type="text" class="w-full px-2 py-1 border rounded text-xs" placeholder="Input field"/>
			</div>
			<div class="space-y-2">
				<label class="block text-xs font-medium">Field 2</label>
				<select class="w-full px-2 py-1 border rounded text-xs">
					<option>Select option</option>
				</select>
			</div>
		</div>
		<div class="mt-3">
			<button class="px-3 py-1 bg-blue-600 text-white rounded text-xs">Submit</button>
		</div>
	</div>
}

templ GridPreview(component core.ComponentInstance) {
	<div 
		class="p-2 grid h-full"
		style={ fmt.Sprintf(`
			grid-template-columns: %s;
			grid-template-rows: %s;
			gap: %s;
		`,
			getStringProp(component, "columns"),
			getStringProp(component, "rows"),
			getStringProp(component, "gap"),
		) }
	>
		<!-- Grid cells preview -->
		<div class="bg-gray-100 border-2 border-dashed border-gray-300 rounded flex items-center justify-center">
			<span class="text-xs text-gray-500">Cell 1</span>
		</div>
		<div class="bg-gray-100 border-2 border-dashed border-gray-300 rounded flex items-center justify-center">
			<span class="text-xs text-gray-500">Cell 2</span>
		</div>
		<div class="bg-gray-100 border-2 border-dashed border-gray-300 rounded flex items-center justify-center">
			<span class="text-xs text-gray-500">Cell 3</span>
		</div>
		<div class="bg-gray-100 border-2 border-dashed border-gray-300 rounded flex items-center justify-center">
			<span class="text-xs text-gray-500">Cell 4</span>
		</div>
	</div>
}

templ GenericPreview(component core.ComponentInstance) {
	<div class="flex items-center justify-center w-full h-full bg-gray-50 text-gray-500">
		<div class="text-center">
			<div class="text-lg mb-1">📦</div>
			<div class="text-xs">{ component.Type }</div>
		</div>
	</div>
}

// CanvasControls renders the canvas control toolbar
templ CanvasControls(canvas core.CanvasMetadata) {
	<div class="absolute top-4 right-4 flex items-center space-x-2 bg-white rounded-lg shadow-lg p-2">
		<!-- Zoom Controls -->
		<div class="flex items-center space-x-1">
			<button 
				class="p-1 hover:bg-gray-100 rounded"
				onclick="zoomOut()"
				title="Zoom Out"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H8"></path>
				</svg>
			</button>
			
			<span class="text-xs px-2 py-1 bg-gray-100 rounded min-w-12 text-center" id="zoom-display">
				{ fmt.Sprintf("%.0f%%", canvas.Zoom*100) }
			</span>
			
			<button 
				class="p-1 hover:bg-gray-100 rounded"
				onclick="zoomIn()"
				title="Zoom In"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 8v6m3-3H7"></path>
				</svg>
			</button>
			
			<button 
				class="p-1 hover:bg-gray-100 rounded"
				onclick="fitToScreen()"
				title="Fit to Screen"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
				</svg>
			</button>
		</div>
		
		<div class="w-px h-6 bg-gray-300"></div>
		
		<!-- Grid Controls -->
		<div class="flex items-center space-x-1">
			<button 
				class={ fmt.Sprintf("p-1 rounded %s", conditionalClass(canvas.ShowGrid, "bg-blue-100 text-blue-600", "hover:bg-gray-100")) }
				onclick="toggleGrid()"
				title="Toggle Grid"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
			
			<button 
				class={ fmt.Sprintf("p-1 rounded %s", conditionalClass(canvas.SnapToGrid, "bg-blue-100 text-blue-600", "hover:bg-gray-100")) }
				onclick="toggleSnap()"
				title="Snap to Grid"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
				</svg>
			</button>
		</div>
		
		<div class="w-px h-6 bg-gray-300"></div>
		
		<!-- View Mode Controls -->
		<div class="flex items-center space-x-1">
			<button 
				class={ fmt.Sprintf("p-1 rounded text-xs px-2 %s", conditionalClass(canvas.ViewMode == "design", "bg-blue-100 text-blue-600", "hover:bg-gray-100")) }
				onclick="setViewMode('design')"
			>
				Design
			</button>
			
			<button 
				class={ fmt.Sprintf("p-1 rounded text-xs px-2 %s", conditionalClass(canvas.ViewMode == "preview", "bg-blue-100 text-blue-600", "hover:bg-gray-100")) }
				onclick="setViewMode('preview')"
			>
				Preview
			</button>
		</div>
	</div>
	
	<script>
		function zoomIn() {
			const currentZoom = canvasState.zoom;
			const newZoom = Math.min(currentZoom * 1.2, 3.0);
			setZoom(newZoom);
		}
		
		function zoomOut() {
			const currentZoom = canvasState.zoom;
			const newZoom = Math.max(currentZoom / 1.2, 0.1);
			setZoom(newZoom);
		}
		
		function setZoom(zoom) {
			canvasState.zoom = zoom;
			const canvas = document.getElementById('visual-canvas');
			canvas.style.zoom = zoom;
			
			// Update zoom display
			document.getElementById('zoom-display').textContent = Math.round(zoom * 100) + '%';
			
			// Update grid background
			updateGridBackground();
		}
		
		function fitToScreen() {
			const canvas = document.getElementById('visual-canvas');
			const content = document.getElementById('canvas-content');
			const canvasRect = canvas.getBoundingClientRect();
			const contentRect = content.getBoundingClientRect();
			
			const scaleX = canvasRect.width / contentRect.width;
			const scaleY = canvasRect.height / contentRect.height;
			const scale = Math.min(scaleX, scaleY) * 0.9; // 90% to leave some margin
			
			setZoom(scale);
		}
		
		function toggleGrid() {
			canvasState.showGrid = !canvasState.showGrid;
			updateCanvasSettings({ showGrid: canvasState.showGrid });
			updateGridBackground();
		}
		
		function toggleSnap() {
			canvasState.snapToGrid = !canvasState.snapToGrid;
			updateCanvasSettings({ snapToGrid: canvasState.snapToGrid });
		}
		
		function setViewMode(mode) {
			canvasState.viewMode = mode;
			updateCanvasSettings({ viewMode: mode });
			
			// Update UI based on view mode
			const canvas = document.getElementById('visual-canvas');
			if (mode === 'preview') {
				canvas.classList.add('preview-mode');
				// Hide design-time elements
				document.querySelectorAll('.resize-handle, .component-label').forEach(el => {
					el.style.display = 'none';
				});
			} else {
				canvas.classList.remove('preview-mode');
				// Show design-time elements
				document.querySelectorAll('.resize-handle, .component-label').forEach(el => {
					el.style.display = '';
				});
			}
		}
		
		function updateGridBackground() {
			const gridBackground = document.querySelector('.grid-background');
			if (gridBackground) {
				if (canvasState.showGrid) {
					gridBackground.style.display = 'block';
					const gridSize = canvasState.gridSize * canvasState.zoom;
					gridBackground.style.backgroundSize = `${gridSize}px ${gridSize}px`;
				} else {
					gridBackground.style.display = 'none';
				}
			}
		}
		
		function updateCanvasSettings(settings) {
			fetch('/api/builder/canvas', {
				method: 'PATCH',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify(settings)
			})
			.catch(error => {
				console.error('Error updating canvas settings:', error);
			});
		}
	</script>
}

// ContextMenu renders the right-click context menu
templ ContextMenu() {
	<div 
		id="context-menu"
		class="fixed bg-white rounded-lg shadow-lg border py-2 z-50 hidden"
		style="min-width: 160px"
	>
		<button class="w-full px-4 py-2 text-left hover:bg-gray-100 text-sm" onclick="copySelectedComponents()">
			Copy
		</button>
		<button class="w-full px-4 py-2 text-left hover:bg-gray-100 text-sm" onclick="pasteComponents()">
			Paste
		</button>
		<hr class="my-1">
		<button class="w-full px-4 py-2 text-left hover:bg-gray-100 text-sm" onclick="duplicateSelectedComponents()">
			Duplicate
		</button>
		<hr class="my-1">
		<button class="w-full px-4 py-2 text-left hover:bg-gray-100 text-sm text-red-600" onclick="deleteSelectedComponents()">
			Delete
		</button>
	</div>
	
	<script>
		// Context menu handling
		document.addEventListener('contextmenu', function(e) {
			const component = e.target.closest('.component-instance');
			if (component) {
				e.preventDefault();
				showContextMenu(e.clientX, e.clientY, component.dataset.componentId);
			}
		});
		
		document.addEventListener('click', function(e) {
			if (!e.target.closest('#context-menu')) {
				hideContextMenu();
			}
		});
		
		function showContextMenu(x, y, componentId) {
			const menu = document.getElementById('context-menu');
			
			// Ensure component is selected
			if (!canvasState.selectedComponents.has(componentId)) {
				selectComponent(componentId, true);
			}
			
			// Position menu
			menu.style.left = x + 'px';
			menu.style.top = y + 'px';
			menu.classList.remove('hidden');
			
			// Adjust position if menu goes off-screen
			const rect = menu.getBoundingClientRect();
			if (rect.right > window.innerWidth) {
				menu.style.left = (x - rect.width) + 'px';
			}
			if (rect.bottom > window.innerHeight) {
				menu.style.top = (y - rect.height) + 'px';
			}
		}
		
		function hideContextMenu() {
			document.getElementById('context-menu').classList.add('hidden');
		}
		
		function duplicateSelectedComponents() {
			const selectedIds = Array.from(canvasState.selectedComponents);
			selectedIds.forEach(componentId => {
				const component = document.querySelector(`[data-component-id="${componentId}"]`);
				if (component) {
					addComponentToCanvas(
						component.dataset.componentType,
						parseFloat(component.style.left || 0) + 20,
						parseFloat(component.style.top || 0) + 20
					);
				}
			});
			hideContextMenu();
		}
	</script>
}

// Helper functions for template logic
func getComponentDisplayName(component core.ComponentInstance, registry *core.ComponentRegistry) string {
	if def := registry.GetComponent(component.Type); def != nil {
		return def.Name
	}
	return component.Type
}

func getStringProp(component core.ComponentInstance, key string) string {
	if val, exists := component.Props[key]; exists {
		if str, ok := val.(string); ok {
			return str
		}
	}
	return ""
}

func getBoolProp(component core.ComponentInstance, key string) bool {
	if val, exists := component.Props[key]; exists {
		if b, ok := val.(bool); ok {
			return b
		}
	}
	return false
}

func getButtonClasses(component core.ComponentInstance) string {
	variant := getStringProp(component, "variant")
	size := getStringProp(component, "size")
	
	classes := "px-3 py-2 rounded font-medium transition-colors "
	
	switch variant {
	case "primary":
		classes += "bg-blue-600 text-white hover:bg-blue-700"
	case "secondary":
		classes += "bg-gray-200 text-gray-900 hover:bg-gray-300"
	case "danger":
		classes += "bg-red-600 text-white hover:bg-red-700"
	case "ghost":
		classes += "bg-transparent text-gray-700 hover:bg-gray-100"
	default:
		classes += "bg-blue-600 text-white hover:bg-blue-700"
	}
	
	switch size {
	case "small":
		classes += " text-sm px-2 py-1"
	case "large":
		classes += " text-lg px-4 py-3"
	}
	
	return classes
}

func getCardClasses(component core.ComponentInstance) string {
	shadow := getStringProp(component, "shadow")
	
	classes := "w-full h-full border border-gray-200 rounded-lg p-3 "
	
	switch shadow {
	case "small":
		classes += "shadow-sm"
	case "medium":
		classes += "shadow-md"
	case "large":
		classes += "shadow-lg"
	case "none":
		classes += ""
	default:
		classes += "shadow-md"
	}
	
	return classes
}

func getFormLayoutClasses(component core.ComponentInstance) string {
	layout := getStringProp(component, "layout")
	
	switch layout {
	case "horizontal":
		return "grid grid-cols-2 gap-4"
	case "inline":
		return "flex space-x-4"
	default:
		return "space-y-3"
	}
}

func conditionalStyle(condition bool, trueStyle, falseStyle string) string {
	if condition {
		return trueStyle
	}
	return falseStyle
}

func conditionalClass(condition bool, trueClass, falseClass string) string {
	if condition {
		return trueClass
	}
	return falseClass
}