package ui

import (
	"fmt"
	"github.com/niiniyare/erp/web/builder/core"
)

// Canvas renders the main composition canvas for visual building
templ Canvas(schema *core.CompositionSchema, registry *core.ComponentRegistry) {
	<div 
		id="visual-canvas" 
		class="relative w-full h-full bg-white overflow-hidden select-none"
		style={ fmt.Sprintf("zoom: %f", schema.Canvas.Zoom) }
		data-grid-size={ fmt.Sprintf("%d", schema.Canvas.GridSize) }
		data-snap-to-grid={ fmt.Sprintf("%t", schema.Canvas.SnapToGrid) }
	>
		<!-- Grid Background -->
		if schema.Canvas.ShowGrid {
			@GridBackground(schema.Canvas.GridSize, schema.Canvas.Zoom)
		}
		
		<!-- Canvas Content Area -->
		<div 
			id="canvas-content"
			class="relative"
			style={ fmt.Sprintf("width: %dpx; height: %dpx; background: %s", 
				schema.Canvas.Width, schema.Canvas.Height, schema.Canvas.Background) }
			@drop="handleCanvasDrop($event)"
			@dragover="handleCanvasDragOver($event)"
		>
			<!-- Component Instances -->
			for _, component := range schema.Components {
				@ComponentInstance(component, registry, schema.Canvas.Zoom)
			}
			
			<!-- Selection Box for Multi-Select -->
			<div 
				id="selection-box"
				class="absolute border-2 border-blue-500 bg-blue-100 bg-opacity-20 hidden pointer-events-none"
				style="z-index: 10000"
			></div>
			
			<!-- Snap Guidelines -->
			<div id="snap-guidelines" class="absolute inset-0 pointer-events-none">
				<div id="vertical-guide" class="absolute w-0.5 bg-red-500 hidden" style="height: 100%; z-index: 9999"></div>
				<div id="horizontal-guide" class="absolute h-0.5 bg-red-500 hidden" style="width: 100%; z-index: 9999"></div>
			</div>
		</div>
		
		<!-- Canvas Controls -->
		@CanvasControls(schema.Canvas)
		
		<!-- Context Menu -->
		@ContextMenu()
	</div>
	
	<!-- Canvas JavaScript -->
	<script>
		// Canvas state
		const canvasState = {
			isDragging: false,
			isSelecting: false,
			draggedElement: null,
			selectedComponents: new Set(),
			selectionStart: null,
			zoom: { schema.Canvas.Zoom },
			gridSize: { schema.Canvas.GridSize },
			snapToGrid: { schema.Canvas.SnapToGrid }
		};
		
		// Initialize canvas
		document.addEventListener('DOMContentLoaded', function() {
			initializeCanvas();
			setupKeyboardShortcuts();
			setupCanvasEvents();
		});
		
		function initializeCanvas() {
			const canvas = document.getElementById('visual-canvas');
			
			// Make canvas focusable for keyboard events
			canvas.tabIndex = 0;
			
			// Setup component dragging
			setupComponentDragging();
			
			// Setup selection
			setupSelection();
			
			// Setup resize handles
			setupResizing();
		}
		
		function setupComponentDragging() {
			// Handle dragging from palette
			document.addEventListener('dragstart', function(e) {
				if (e.target.dataset.componentType) {
					e.dataTransfer.setData('application/component-type', e.target.dataset.componentType);
					e.dataTransfer.effectAllowed = 'copy';
				}
			});
			
			// Handle component movement within canvas
			document.addEventListener('mousedown', function(e) {
				const component = e.target.closest('.component-instance');
				if (component && !component.dataset.locked) {
					startDragComponent(e, component);
				}
			});
		}
		
		function startDragComponent(e, component) {
			if (e.button !== 0) return; // Only left mouse button
			
			canvasState.isDragging = true;
			canvasState.draggedElement = component;
			
			const rect = component.getBoundingClientRect();
			const canvasRect = document.getElementById('canvas-content').getBoundingClientRect();
			
			const offsetX = e.clientX - rect.left;
			const offsetY = e.clientY - rect.top;
			
			// Add dragging class
			component.classList.add('dragging');
			
			function onMouseMove(e) {
				if (!canvasState.isDragging) return;
				
				let newX = (e.clientX - canvasRect.left - offsetX) / canvasState.zoom;
				let newY = (e.clientY - canvasRect.top - offsetY) / canvasState.zoom;
				
				// Snap to grid
				if (canvasState.snapToGrid) {
					newX = Math.round(newX / canvasState.gridSize) * canvasState.gridSize;
					newY = Math.round(newY / canvasState.gridSize) * canvasState.gridSize;
				}
				
				// Update position
				component.style.left = newX + 'px';
				component.style.top = newY + 'px';
				
				// Show snap guidelines
				showSnapGuidelines(newX, newY, component);
				
				// Update component data
				updateComponentPosition(component.dataset.componentId, newX, newY);
			}
			
			function onMouseUp(e) {
				canvasState.isDragging = false;
				canvasState.draggedElement = null;
				component.classList.remove('dragging');
				hideSnapGuidelines();
				
				document.removeEventListener('mousemove', onMouseMove);
				document.removeEventListener('mouseup', onMouseUp);
			}
			
			document.addEventListener('mousemove', onMouseMove);
			document.addEventListener('mouseup', onMouseUp);
			
			e.preventDefault();
		}
		
		function setupSelection() {
			const canvas = document.getElementById('canvas-content');
			
			canvas.addEventListener('mousedown', function(e) {
				// Only start selection if clicking on empty canvas
				if (e.target === canvas) {
					startSelection(e);
				}
			});
			
			// Click to select individual components
			document.addEventListener('click', function(e) {
				const component = e.target.closest('.component-instance');
				if (component) {
					selectComponent(component.dataset.componentId, !e.ctrlKey && !e.metaKey);
				} else if (e.target.closest('#canvas-content')) {
					// Clicked on empty canvas - clear selection
					clearSelection();
				}
			});
		}
		
		function startSelection(e) {
			canvasState.isSelecting = true;
			const canvasRect = document.getElementById('canvas-content').getBoundingClientRect();
			
			canvasState.selectionStart = {
				x: (e.clientX - canvasRect.left) / canvasState.zoom,
				y: (e.clientY - canvasRect.top) / canvasState.zoom
			};
			
			const selectionBox = document.getElementById('selection-box');
			selectionBox.style.left = canvasState.selectionStart.x + 'px';
			selectionBox.style.top = canvasState.selectionStart.y + 'px';
			selectionBox.style.width = '0px';
			selectionBox.style.height = '0px';
			selectionBox.classList.remove('hidden');
			
			function onMouseMove(e) {
				if (!canvasState.isSelecting) return;
				
				const currentX = (e.clientX - canvasRect.left) / canvasState.zoom;
				const currentY = (e.clientY - canvasRect.top) / canvasState.zoom;
				
				const width = Math.abs(currentX - canvasState.selectionStart.x);
				const height = Math.abs(currentY - canvasState.selectionStart.y);
				const left = Math.min(currentX, canvasState.selectionStart.x);
				const top = Math.min(currentY, canvasState.selectionStart.y);
				
				selectionBox.style.left = left + 'px';
				selectionBox.style.top = top + 'px';
				selectionBox.style.width = width + 'px';
				selectionBox.style.height = height + 'px';
			}
			
			function onMouseUp(e) {
				canvasState.isSelecting = false;
				selectionBox.classList.add('hidden');
				
				// Select components within selection box
				selectComponentsInBox();
				
				document.removeEventListener('mousemove', onMouseMove);
				document.removeEventListener('mouseup', onMouseUp);
			}
			
			document.addEventListener('mousemove', onMouseMove);
			document.addEventListener('mouseup', onMouseUp);
		}
		
		function selectComponentsInBox() {
			const selectionBox = document.getElementById('selection-box');
			const boxRect = {
				left: parseFloat(selectionBox.style.left),
				top: parseFloat(selectionBox.style.top),
				right: parseFloat(selectionBox.style.left) + parseFloat(selectionBox.style.width),
				bottom: parseFloat(selectionBox.style.top) + parseFloat(selectionBox.style.height)
			};
			
			const components = document.querySelectorAll('.component-instance');
			const selectedIds = [];
			
			components.forEach(component => {
				const rect = {
					left: parseFloat(component.style.left || 0),
					top: parseFloat(component.style.top || 0),
					right: parseFloat(component.style.left || 0) + component.offsetWidth,
					bottom: parseFloat(component.style.top || 0) + component.offsetHeight
				};
				
				// Check if component intersects with selection box
				if (rect.left < boxRect.right && rect.right > boxRect.left &&
					rect.top < boxRect.bottom && rect.bottom > boxRect.top) {
					selectedIds.push(component.dataset.componentId);
				}
			});
			
			if (selectedIds.length > 0) {
				selectComponents(selectedIds, true);
			}
		}
		
		function setupResizing() {
			// Add resize handles to selected components
			document.addEventListener('componentselected', function(e) {
				addResizeHandles(e.detail.componentId);
			});
			
			document.addEventListener('componentdeselected', function(e) {
				removeResizeHandles(e.detail.componentId);
			});
		}
		
		function addResizeHandles(componentId) {
			const component = document.querySelector(`[data-component-id="${componentId}"]`);
			if (!component || component.dataset.locked) return;
			
			// Remove existing handles
			removeResizeHandles(componentId);
			
			// Add resize handles
			const handles = ['nw', 'n', 'ne', 'e', 'se', 's', 'sw', 'w'];
			handles.forEach(direction => {
				const handle = document.createElement('div');
				handle.className = `resize-handle resize-${direction}`;
				handle.dataset.direction = direction;
				handle.dataset.componentId = componentId;
				component.appendChild(handle);
				
				handle.addEventListener('mousedown', function(e) {
					startResize(e, component, direction);
				});
			});
		}
		
		function removeResizeHandles(componentId) {
			const component = document.querySelector(`[data-component-id="${componentId}"]`);
			if (component) {
				const handles = component.querySelectorAll('.resize-handle');
				handles.forEach(handle => handle.remove());
			}
		}
		
		function startResize(e, component, direction) {
			e.stopPropagation();
			
			const startX = e.clientX;
			const startY = e.clientY;
			const startWidth = component.offsetWidth;
			const startHeight = component.offsetHeight;
			const startLeft = parseFloat(component.style.left || 0);
			const startTop = parseFloat(component.style.top || 0);
			
			function onMouseMove(e) {
				const deltaX = (e.clientX - startX) / canvasState.zoom;
				const deltaY = (e.clientY - startY) / canvasState.zoom;
				
				let newWidth = startWidth;
				let newHeight = startHeight;
				let newLeft = startLeft;
				let newTop = startTop;
				
				// Calculate new dimensions based on direction
				if (direction.includes('e')) newWidth = startWidth + deltaX;
				if (direction.includes('w')) {
					newWidth = startWidth - deltaX;
					newLeft = startLeft + deltaX;
				}
				if (direction.includes('s')) newHeight = startHeight + deltaY;
				if (direction.includes('n')) {
					newHeight = startHeight - deltaY;
					newTop = startTop + deltaY;
				}
				
				// Apply minimum size constraints
				const minWidth = 50;
				const minHeight = 30;
				if (newWidth < minWidth) newWidth = minWidth;
				if (newHeight < minHeight) newHeight = minHeight;
				
				// Snap to grid
				if (canvasState.snapToGrid) {
					newWidth = Math.round(newWidth / canvasState.gridSize) * canvasState.gridSize;
					newHeight = Math.round(newHeight / canvasState.gridSize) * canvasState.gridSize;
					newLeft = Math.round(newLeft / canvasState.gridSize) * canvasState.gridSize;
					newTop = Math.round(newTop / canvasState.gridSize) * canvasState.gridSize;
				}
				
				// Apply changes
				component.style.width = newWidth + 'px';
				component.style.height = newHeight + 'px';
				component.style.left = newLeft + 'px';
				component.style.top = newTop + 'px';
				
				// Update component data
				updateComponentSize(component.dataset.componentId, newWidth, newHeight);
				if (newLeft !== startLeft || newTop !== startTop) {
					updateComponentPosition(component.dataset.componentId, newLeft, newTop);
				}
			}
			
			function onMouseUp(e) {
				document.removeEventListener('mousemove', onMouseMove);
				document.removeEventListener('mouseup', onMouseUp);
			}
			
			document.addEventListener('mousemove', onMouseMove);
			document.addEventListener('mouseup', onMouseUp);
		}
		
		function setupKeyboardShortcuts() {
			document.addEventListener('keydown', function(e) {
				// Only handle shortcuts when canvas is focused
				if (!document.getElementById('visual-canvas').contains(document.activeElement)) return;
				
				switch(e.key) {
					case 'Delete':
					case 'Backspace':
						deleteSelectedComponents();
						e.preventDefault();
						break;
					case 'a':
						if (e.ctrlKey || e.metaKey) {
							selectAllComponents();
							e.preventDefault();
						}
						break;
					case 'z':
						if (e.ctrlKey || e.metaKey) {
							if (e.shiftKey) {
								redo();
							} else {
								undo();
							}
							e.preventDefault();
						}
						break;
					case 'c':
						if (e.ctrlKey || e.metaKey) {
							copySelectedComponents();
							e.preventDefault();
						}
						break;
					case 'v':
						if (e.ctrlKey || e.metaKey) {
							pasteComponents();
							e.preventDefault();
						}
						break;
					case 'Escape':
						clearSelection();
						break;
				}
			});
		}
		
		// Canvas event handlers
		function handleCanvasDrop(e) {
			e.preventDefault();
			
			const componentType = e.dataTransfer.getData('application/component-type');
			if (!componentType) return;
			
			const canvasRect = document.getElementById('canvas-content').getBoundingClientRect();
			let x = (e.clientX - canvasRect.left) / canvasState.zoom;
			let y = (e.clientY - canvasRect.top) / canvasState.zoom;
			
			// Snap to grid
			if (canvasState.snapToGrid) {
				x = Math.round(x / canvasState.gridSize) * canvasState.gridSize;
				y = Math.round(y / canvasState.gridSize) * canvasState.gridSize;
			}
			
			// Add component to schema
			addComponentToCanvas(componentType, x, y);
		}
		
		function handleCanvasDragOver(e) {
			e.preventDefault();
			e.dataTransfer.dropEffect = 'copy';
		}
		
		// Utility functions
		function showSnapGuidelines(x, y, excludeComponent) {
			// Show guidelines when components align
			const components = document.querySelectorAll('.component-instance');
			const threshold = 5; // pixels
			
			let showVertical = false;
			let showHorizontal = false;
			let verticalX = 0;
			let horizontalY = 0;
			
			components.forEach(component => {
				if (component === excludeComponent) return;
				
				const rect = {
					left: parseFloat(component.style.left || 0),
					top: parseFloat(component.style.top || 0),
					width: component.offsetWidth,
					height: component.offsetHeight
				};
				
				// Vertical alignment
				if (Math.abs(x - rect.left) < threshold) {
					showVertical = true;
					verticalX = rect.left;
				} else if (Math.abs(x - (rect.left + rect.width / 2)) < threshold) {
					showVertical = true;
					verticalX = rect.left + rect.width / 2;
				} else if (Math.abs(x - (rect.left + rect.width)) < threshold) {
					showVertical = true;
					verticalX = rect.left + rect.width;
				}
				
				// Horizontal alignment
				if (Math.abs(y - rect.top) < threshold) {
					showHorizontal = true;
					horizontalY = rect.top;
				} else if (Math.abs(y - (rect.top + rect.height / 2)) < threshold) {
					showHorizontal = true;
					horizontalY = rect.top + rect.height / 2;
				} else if (Math.abs(y - (rect.top + rect.height)) < threshold) {
					showHorizontal = true;
					horizontalY = rect.top + rect.height;
				}
			});
			
			const verticalGuide = document.getElementById('vertical-guide');
			const horizontalGuide = document.getElementById('horizontal-guide');
			
			if (showVertical) {
				verticalGuide.style.left = verticalX + 'px';
				verticalGuide.classList.remove('hidden');
			} else {
				verticalGuide.classList.add('hidden');
			}
			
			if (showHorizontal) {
				horizontalGuide.style.top = horizontalY + 'px';
				horizontalGuide.classList.remove('hidden');
			} else {
				horizontalGuide.classList.add('hidden');
			}
		}
		
		function hideSnapGuidelines() {
			document.getElementById('vertical-guide').classList.add('hidden');
			document.getElementById('horizontal-guide').classList.add('hidden');
		}
		
		// Component management functions
		function selectComponent(componentId, clearOthers = true) {
			if (clearOthers) {
				clearSelection();
			}
			
			canvasState.selectedComponents.add(componentId);
			const component = document.querySelector(`[data-component-id="${componentId}"]`);
			if (component) {
				component.classList.add('selected');
				
				// Dispatch selection event
				const event = new CustomEvent('componentselected', {
					detail: { componentId }
				});
				document.dispatchEvent(event);
			}
			
			updatePropertyEditor();
		}
		
		function selectComponents(componentIds, clearOthers = true) {
			if (clearOthers) {
				clearSelection();
			}
			
			componentIds.forEach(id => selectComponent(id, false));
		}
		
		function clearSelection() {
			canvasState.selectedComponents.forEach(componentId => {
				const component = document.querySelector(`[data-component-id="${componentId}"]`);
				if (component) {
					component.classList.remove('selected');
					removeResizeHandles(componentId);
					
					// Dispatch deselection event
					const event = new CustomEvent('componentdeselected', {
						detail: { componentId }
					});
					document.dispatchEvent(event);
				}
			});
			
			canvasState.selectedComponents.clear();
			updatePropertyEditor();
		}
		
		function selectAllComponents() {
			const components = document.querySelectorAll('.component-instance');
			const componentIds = Array.from(components).map(c => c.dataset.componentId);
			selectComponents(componentIds, true);
		}
		
		function deleteSelectedComponents() {
			const selectedIds = Array.from(canvasState.selectedComponents);
			selectedIds.forEach(componentId => {
				deleteComponent(componentId);
			});
			clearSelection();
		}
		
		// API calls to backend
		function addComponentToCanvas(componentType, x, y) {
			fetch('/api/builder/components', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					type: componentType,
					position: { x, y },
					props: {}
				})
			})
			.then(response => response.json())
			.then(component => {
				// Component will be added via WebSocket update
				console.log('Component added:', component);
			})
			.catch(error => {
				console.error('Error adding component:', error);
			});
		}
		
		function updateComponentPosition(componentId, x, y) {
			fetch(`/api/builder/components/${componentId}`, {
				method: 'PATCH',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					position: { x, y }
				})
			})
			.catch(error => {
				console.error('Error updating component position:', error);
			});
		}
		
		function updateComponentSize(componentId, width, height) {
			fetch(`/api/builder/components/${componentId}`, {
				method: 'PATCH',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					size: { width, height }
				})
			})
			.catch(error => {
				console.error('Error updating component size:', error);
			});
		}
		
		function deleteComponent(componentId) {
			fetch(`/api/builder/components/${componentId}`, {
				method: 'DELETE'
			})
			.then(() => {
				// Component will be removed via WebSocket update
				console.log('Component deleted:', componentId);
			})
			.catch(error => {
				console.error('Error deleting component:', error);
			});
		}
		
		function updatePropertyEditor() {
			// Update the property editor based on current selection
			const selectedCount = canvasState.selectedComponents.size;
			
			if (selectedCount === 0) {
				// Show canvas properties
				window.dispatchEvent(new CustomEvent('showCanvasProperties'));
			} else if (selectedCount === 1) {
				// Show single component properties
				const componentId = Array.from(canvasState.selectedComponents)[0];
				window.dispatchEvent(new CustomEvent('showComponentProperties', {
					detail: { componentId }
				}));
			} else {
				// Show multi-selection properties
				window.dispatchEvent(new CustomEvent('showMultiSelectionProperties', {
					detail: { componentIds: Array.from(canvasState.selectedComponents) }
				}));
			}
		}
		
		// History functions
		function undo() {
			fetch('/api/builder/undo', { method: 'POST' })
				.then(response => response.json())
				.then(result => {
					console.log('Undo completed:', result);
				})
				.catch(error => {
					console.error('Error undoing:', error);
				});
		}
		
		function redo() {
			fetch('/api/builder/redo', { method: 'POST' })
				.then(response => response.json())
				.then(result => {
					console.log('Redo completed:', result);
				})
				.catch(error => {
					console.error('Error redoing:', error);
				});
		}
		
		// Clipboard functions
		let clipboardData = null;
		
		function copySelectedComponents() {
			const selectedIds = Array.from(canvasState.selectedComponents);
			if (selectedIds.length === 0) return;
			
			// Get component data
			const components = selectedIds.map(id => {
				const element = document.querySelector(`[data-component-id="${id}"]`);
				return {
					id,
					type: element.dataset.componentType,
					position: {
						x: parseFloat(element.style.left || 0),
						y: parseFloat(element.style.top || 0)
					},
					size: {
						width: element.offsetWidth,
						height: element.offsetHeight
					}
				};
			});
			
			clipboardData = { components };
			console.log('Copied components to clipboard:', clipboardData);
		}
		
		function pasteComponents() {
			if (!clipboardData || !clipboardData.components) return;
			
			// Paste at offset position
			const offset = 20;
			clipboardData.components.forEach(component => {
				addComponentToCanvas(
					component.type,
					component.position.x + offset,
					component.position.y + offset
				);
			});
		}
	</script>
	
	<!-- Canvas Styles -->
	<style>
		.component-instance {
			position: absolute;
			border: 2px solid transparent;
			cursor: move;
			transition: border-color 0.2s ease;
		}
		
		.component-instance:hover {
			border-color: #3b82f6;
		}
		
		.component-instance.selected {
			border-color: #2563eb;
			box-shadow: 0 0 0 1px #2563eb;
		}
		
		.component-instance.dragging {
			opacity: 0.8;
			z-index: 1000;
		}
		
		.resize-handle {
			position: absolute;
			background: #2563eb;
			border: 1px solid white;
			width: 8px;
			height: 8px;
			border-radius: 50%;
		}
		
		.resize-nw { top: -4px; left: -4px; cursor: nw-resize; }
		.resize-n { top: -4px; left: 50%; transform: translateX(-50%); cursor: n-resize; }
		.resize-ne { top: -4px; right: -4px; cursor: ne-resize; }
		.resize-e { top: 50%; right: -4px; transform: translateY(-50%); cursor: e-resize; }
		.resize-se { bottom: -4px; right: -4px; cursor: se-resize; }
		.resize-s { bottom: -4px; left: 50%; transform: translateX(-50%); cursor: s-resize; }
		.resize-sw { bottom: -4px; left: -4px; cursor: sw-resize; }
		.resize-w { top: 50%; left: -4px; transform: translateY(-50%); cursor: w-resize; }
		
		.grid-background {
			opacity: 0.3;
		}
		
		.snap-guide {
			position: absolute;
			background: #ef4444;
			z-index: 9999;
		}
	</style>
}