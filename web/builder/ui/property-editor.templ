package ui

import (
	"github.com/niiniyare/erp/web/builder/core"
)

// PropertyEditor renders the dynamic property editing panel
templ PropertyEditor(registry *core.ComponentRegistry) {
	<div class="w-80 bg-white border-l border-gray-200 flex flex-col h-full">
		<!-- Property Editor Header -->
		<div class="p-4 border-b border-gray-200">
			<div class="flex items-center justify-between">
				<h2 class="text-lg font-semibold text-gray-900">Properties</h2>
				<div class="flex items-center space-x-1">
					<!-- Reset Button -->
					<button 
						class="p-1 hover:bg-gray-100 rounded"
						onclick="resetProperties()"
						title="Reset to Defaults"
						id="reset-properties-btn"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
						</svg>
					</button>
					
					<!-- Copy Properties -->
					<button 
						class="p-1 hover:bg-gray-100 rounded"
						onclick="copyProperties()"
						title="Copy Properties"
						id="copy-properties-btn"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
						</svg>
					</button>
					
					<!-- Paste Properties -->
					<button 
						class="p-1 hover:bg-gray-100 rounded"
						onclick="pasteProperties()"
						title="Paste Properties"
						id="paste-properties-btn"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
						</svg>
					</button>
				</div>
			</div>
		</div>
		
		<!-- Property Editor Content -->
		<div class="flex-1 overflow-y-auto" id="property-editor-content">
			<!-- Default state - no selection -->
			<div id="no-selection" class="p-4 text-center text-gray-500">
				<svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
				</svg>
				<p class="text-sm">Select a component to edit its properties</p>
			</div>
			
			<!-- Canvas properties when no component selected -->
			<div id="canvas-properties" class="hidden">
				@CanvasProperties()
			</div>
			
			<!-- Single component properties -->
			<div id="component-properties" class="hidden">
				<!-- Populated dynamically -->
			</div>
			
			<!-- Multi-selection properties -->
			<div id="multi-selection-properties" class="hidden">
				@MultiSelectionProperties()
			</div>
		</div>
		
		<!-- Property Editor Footer -->
		<div class="p-4 border-t border-gray-200">
			<div class="text-xs text-gray-500">
				<div class="flex items-center justify-between">
					<span id="property-status">Ready</span>
					<button 
						class="text-blue-600 hover:text-blue-800"
						onclick="toggleAdvancedProperties()"
						id="advanced-toggle"
					>
						Advanced
					</button>
				</div>
			</div>
		</div>
	</div>
	
	<!-- Property Editor JavaScript -->
	<script>
		// Property editor state
		const propertyEditorState = {
			currentComponent: null,
			selectedComponents: [],
			showAdvanced: false,
			copiedProperties: null,
			isDirty: false
		};
		
		// Initialize property editor
		document.addEventListener('DOMContentLoaded', function() {
			initializePropertyEditor();
			setupPropertyEditorEvents();
		});
		
		function initializePropertyEditor() {
			// Show default state
			showNoSelection();
			
			// Setup auto-save
			setupAutoSave();
		}
		
		function setupPropertyEditorEvents() {
			// Listen for selection changes from canvas
			window.addEventListener('showComponentProperties', function(e) {
				showComponentProperties(e.detail.componentId);
			});
			
			window.addEventListener('showCanvasProperties', function(e) {
				showCanvasProperties();
			});
			
			window.addEventListener('showMultiSelectionProperties', function(e) {
				showMultiSelectionProperties(e.detail.componentIds);
			});
		}
		
		function showNoSelection() {
			hideAllPropertyPanels();
			document.getElementById('no-selection').classList.remove('hidden');
			propertyEditorState.currentComponent = null;
			propertyEditorState.selectedComponents = [];
		}
		
		function showCanvasProperties() {
			hideAllPropertyPanels();
			document.getElementById('canvas-properties').classList.remove('hidden');
			propertyEditorState.currentComponent = null;
			propertyEditorState.selectedComponents = [];
		}
		
		function showComponentProperties(componentId) {
			hideAllPropertyPanels();
			
			// Fetch component data and show properties
			fetchComponentProperties(componentId).then(data => {
				renderComponentProperties(data);
				document.getElementById('component-properties').classList.remove('hidden');
				propertyEditorState.currentComponent = componentId;
				propertyEditorState.selectedComponents = [componentId];
			});
		}
		
		function showMultiSelectionProperties(componentIds) {
			hideAllPropertyPanels();
			document.getElementById('multi-selection-properties').classList.remove('hidden');
			propertyEditorState.currentComponent = null;
			propertyEditorState.selectedComponents = componentIds;
		}
		
		function hideAllPropertyPanels() {
			document.getElementById('no-selection').classList.add('hidden');
			document.getElementById('canvas-properties').classList.add('hidden');
			document.getElementById('component-properties').classList.add('hidden');
			document.getElementById('multi-selection-properties').classList.add('hidden');
		}
		
		async function fetchComponentProperties(componentId) {
			try {
				const response = await fetch(`/api/builder/components/${componentId}/properties`);
				return await response.json();
			} catch (error) {
				console.error('Error fetching component properties:', error);
				return null;
			}
		}
		
		function renderComponentProperties(data) {
			if (!data) return;
			
			const container = document.getElementById('component-properties');
			container.innerHTML = '';
			
			// Component header
			const header = document.createElement('div');
			header.className = 'p-4 border-b border-gray-200';
			header.innerHTML = `
				<div class="flex items-center">
					<div class="w-8 h-8 bg-blue-100 rounded mr-3 flex items-center justify-center">
						<span class="text-sm">${getComponentIcon(data.type)}</span>
					</div>
					<div>
						<h3 class="font-medium text-gray-900">${data.name}</h3>
						<p class="text-xs text-gray-500">${data.type}</p>
					</div>
				</div>
			`;
			container.appendChild(header);
			
			// Property groups
			if (data.propSchema && data.propSchema.groups) {
				data.propSchema.groups.forEach(group => {
					renderPropertyGroup(container, group, data.propSchema.properties, data.currentProps);
				});
			} else if (data.propSchema && data.propSchema.properties) {
				// Render ungrouped properties
				const ungroupedGroup = {
					id: 'general',
					label: 'General',
					properties: Object.keys(data.propSchema.properties)
				};
				renderPropertyGroup(container, ungroupedGroup, data.propSchema.properties, data.currentProps);
			}
		}
		
		function renderPropertyGroup(container, group, allProperties, currentProps) {
			const groupElement = document.createElement('div');
			groupElement.className = 'border-b border-gray-200';
			
			// Group header
			const groupHeader = document.createElement('div');
			groupHeader.className = 'p-3 bg-gray-50 cursor-pointer';
			groupHeader.innerHTML = `
				<div class="flex items-center justify-between">
					<h4 class="text-sm font-medium text-gray-700">${group.label}</h4>
					<svg class="w-4 h-4 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</div>
			`;
			
			// Group content
			const groupContent = document.createElement('div');
			groupContent.className = 'p-3 space-y-3';
			
			// Render properties in group
			group.properties.forEach(propKey => {
				const propDef = allProperties[propKey];
				const currentValue = currentProps[propKey];
				
				if (propDef && (!propDef.advanced || propertyEditorState.showAdvanced)) {
					const propElement = renderPropertyField(propKey, propDef, currentValue);
					groupContent.appendChild(propElement);
				}
			});
			
			// Toggle group collapse
			groupHeader.addEventListener('click', function() {
				const isCollapsed = groupContent.classList.contains('hidden');
				const icon = groupHeader.querySelector('svg');
				
				if (isCollapsed) {
					groupContent.classList.remove('hidden');
					icon.style.transform = 'rotate(0deg)';
				} else {
					groupContent.classList.add('hidden');
					icon.style.transform = 'rotate(-90deg)';
				}
			});
			
			groupElement.appendChild(groupHeader);
			groupElement.appendChild(groupContent);
			container.appendChild(groupElement);
		}
		
		function renderPropertyField(propKey, propDef, currentValue) {
			const fieldContainer = document.createElement('div');
			fieldContainer.className = 'space-y-1';
			
			// Label
			const label = document.createElement('label');
			label.className = 'block text-sm font-medium text-gray-700';
			label.textContent = propDef.label || propKey;
			fieldContainer.appendChild(label);
			
			// Input field based on type
			const input = createPropertyInput(propKey, propDef, currentValue);
			fieldContainer.appendChild(input);
			
			// Help text
			if (propDef.help) {
				const help = document.createElement('p');
				help.className = 'text-xs text-gray-500';
				help.textContent = propDef.help;
				fieldContainer.appendChild(help);
			}
			
			return fieldContainer;
		}
		
		function createPropertyInput(propKey, propDef, currentValue) {
			const value = currentValue !== undefined ? currentValue : propDef.default;
			
			switch (propDef.type) {
				case 'string':
					return createTextInput(propKey, propDef, value);
				
				case 'textarea':
					return createTextareaInput(propKey, propDef, value);
				
				case 'number':
					return createNumberInput(propKey, propDef, value);
				
				case 'boolean':
					return createBooleanInput(propKey, propDef, value);
				
				case 'select':
					return createSelectInput(propKey, propDef, value);
				
				case 'color':
					return createColorInput(propKey, propDef, value);
				
				case 'range':
					return createRangeInput(propKey, propDef, value);
				
				default:
					return createTextInput(propKey, propDef, value);
			}
		}
		
		function createTextInput(propKey, propDef, value) {
			const input = document.createElement('input');
			input.type = 'text';
			input.className = 'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500';
			input.value = value || '';
			input.placeholder = propDef.placeholder || '';
			
			if (propDef.pattern) {
				input.pattern = propDef.pattern;
			}
			
			input.addEventListener('input', function() {
				updateProperty(propKey, this.value);
			});
			
			input.addEventListener('blur', function() {
				validateProperty(propKey, this.value, propDef);
			});
			
			return input;
		}
		
		function createTextareaInput(propKey, propDef, value) {
			const textarea = document.createElement('textarea');
			textarea.className = 'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500';
			textarea.value = value || '';
			textarea.placeholder = propDef.placeholder || '';
			textarea.rows = propDef.rows || 3;
			
			textarea.addEventListener('input', function() {
				updateProperty(propKey, this.value);
			});
			
			return textarea;
		}
		
		function createNumberInput(propKey, propDef, value) {
			const input = document.createElement('input');
			input.type = 'number';
			input.className = 'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500';
			input.value = value || '';
			
			if (propDef.min !== undefined) input.min = propDef.min;
			if (propDef.max !== undefined) input.max = propDef.max;
			if (propDef.step !== undefined) input.step = propDef.step;
			
			input.addEventListener('input', function() {
				const numValue = parseFloat(this.value);
				updateProperty(propKey, isNaN(numValue) ? null : numValue);
			});
			
			return input;
		}
		
		function createBooleanInput(propKey, propDef, value) {
			const container = document.createElement('div');
			container.className = 'flex items-center';
			
			const input = document.createElement('input');
			input.type = 'checkbox';
			input.className = 'h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded';
			input.checked = !!value;
			
			const label = document.createElement('label');
			label.className = 'ml-2 text-sm text-gray-700';
			label.textContent = propDef.label || 'Enable';
			
			input.addEventListener('change', function() {
				updateProperty(propKey, this.checked);
			});
			
			container.appendChild(input);
			container.appendChild(label);
			return container;
		}
		
		function createSelectInput(propKey, propDef, value) {
			const select = document.createElement('select');
			select.className = 'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500';
			
			// Add options
			if (propDef.options) {
				propDef.options.forEach(option => {
					const optionElement = document.createElement('option');
					optionElement.value = option.value;
					optionElement.textContent = option.label;
					optionElement.selected = option.value === value;
					select.appendChild(optionElement);
				});
			}
			
			select.addEventListener('change', function() {
				updateProperty(propKey, this.value);
			});
			
			return select;
		}
		
		function createColorInput(propKey, propDef, value) {
			const container = document.createElement('div');
			container.className = 'flex items-center space-x-2';
			
			const colorInput = document.createElement('input');
			colorInput.type = 'color';
			colorInput.className = 'h-8 w-16 border border-gray-300 rounded cursor-pointer';
			colorInput.value = value || '#000000';
			
			const textInput = document.createElement('input');
			textInput.type = 'text';
			textInput.className = 'flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500';
			textInput.value = value || '';
			textInput.placeholder = '#000000';
			
			// Sync inputs
			colorInput.addEventListener('input', function() {
				textInput.value = this.value;
				updateProperty(propKey, this.value);
			});
			
			textInput.addEventListener('input', function() {
				if (this.value.match(/^#[0-9A-Fa-f]{6}$/)) {
					colorInput.value = this.value;
				}
				updateProperty(propKey, this.value);
			});
			
			container.appendChild(colorInput);
			container.appendChild(textInput);
			return container;
		}
		
		function createRangeInput(propKey, propDef, value) {
			const container = document.createElement('div');
			container.className = 'space-y-2';
			
			const rangeInput = document.createElement('input');
			rangeInput.type = 'range';
			rangeInput.className = 'w-full';
			rangeInput.value = value || propDef.default || 0;
			
			if (propDef.min !== undefined) rangeInput.min = propDef.min;
			if (propDef.max !== undefined) rangeInput.max = propDef.max;
			if (propDef.step !== undefined) rangeInput.step = propDef.step;
			
			const valueDisplay = document.createElement('div');
			valueDisplay.className = 'text-xs text-gray-500 text-center';
			valueDisplay.textContent = rangeInput.value;
			
			rangeInput.addEventListener('input', function() {
				valueDisplay.textContent = this.value;
				updateProperty(propKey, parseFloat(this.value));
			});
			
			container.appendChild(rangeInput);
			container.appendChild(valueDisplay);
			return container;
		}
		
		function updateProperty(propKey, value) {
			if (!propertyEditorState.currentComponent) return;
			
			// Debounce updates
			clearTimeout(propertyEditorState.updateTimeout);
			propertyEditorState.updateTimeout = setTimeout(() => {
				sendPropertyUpdate(propKey, value);
			}, 300);
			
			// Mark as dirty
			propertyEditorState.isDirty = true;
			updatePropertyStatus('Modified');
		}
		
		function sendPropertyUpdate(propKey, value) {
			const componentId = propertyEditorState.currentComponent;
			
			fetch(`/api/builder/components/${componentId}/properties`, {
				method: 'PATCH',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					[propKey]: value
				})
			})
			.then(response => response.json())
			.then(result => {
				updatePropertyStatus('Saved');
				propertyEditorState.isDirty = false;
			})
			.catch(error => {
				console.error('Error updating property:', error);
				updatePropertyStatus('Error');
			});
		}
		
		function validateProperty(propKey, value, propDef) {
			const errors = [];
			
			// Required validation
			if (propDef.required && (!value || value.trim() === '')) {
				errors.push('This field is required');
			}
			
			// Pattern validation
			if (propDef.pattern && value && !new RegExp(propDef.pattern).test(value)) {
				errors.push('Invalid format');
			}
			
			// Range validation for numbers
			if (propDef.type === 'number' && value !== '') {
				const numValue = parseFloat(value);
				if (!isNaN(numValue)) {
					if (propDef.min !== undefined && numValue < propDef.min) {
						errors.push(`Minimum value is ${propDef.min}`);
					}
					if (propDef.max !== undefined && numValue > propDef.max) {
						errors.push(`Maximum value is ${propDef.max}`);
					}
				}
			}
			
			// Show validation errors
			showValidationErrors(propKey, errors);
		}
		
		function showValidationErrors(propKey, errors) {
			// Find the property field
			const input = document.querySelector(`[data-prop-key="${propKey}"]`);
			if (!input) return;
			
			const container = input.closest('.space-y-1');
			
			// Remove existing error messages
			const existingErrors = container.querySelectorAll('.validation-error');
			existingErrors.forEach(error => error.remove());
			
			// Add new error messages
			if (errors.length > 0) {
				input.classList.add('border-red-300', 'focus:ring-red-500', 'focus:border-red-500');
				
				errors.forEach(error => {
					const errorElement = document.createElement('p');
					errorElement.className = 'text-xs text-red-600 validation-error';
					errorElement.textContent = error;
					container.appendChild(errorElement);
				});
			} else {
				input.classList.remove('border-red-300', 'focus:ring-red-500', 'focus:border-red-500');
			}
		}
		
		function updatePropertyStatus(status) {
			document.getElementById('property-status').textContent = status;
		}
		
		function setupAutoSave() {
			// Auto-save every 5 seconds if there are unsaved changes
			setInterval(() => {
				if (propertyEditorState.isDirty) {
					// Auto-save logic could go here
				}
			}, 5000);
		}
		
		// Property editor actions
		function resetProperties() {
			if (!propertyEditorState.currentComponent) return;
			
			if (confirm('Reset all properties to their default values?')) {
				fetch(`/api/builder/components/${propertyEditorState.currentComponent}/reset`, {
					method: 'POST'
				})
				.then(() => {
					// Reload properties
					showComponentProperties(propertyEditorState.currentComponent);
				})
				.catch(error => {
					console.error('Error resetting properties:', error);
				});
			}
		}
		
		function copyProperties() {
			if (!propertyEditorState.currentComponent) return;
			
			fetchComponentProperties(propertyEditorState.currentComponent)
				.then(data => {
					propertyEditorState.copiedProperties = data.currentProps;
					updatePropertyStatus('Properties copied');
				});
		}
		
		function pasteProperties() {
			if (!propertyEditorState.copiedProperties || !propertyEditorState.currentComponent) return;
			
			fetch(`/api/builder/components/${propertyEditorState.currentComponent}/properties`, {
				method: 'PUT',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify(propertyEditorState.copiedProperties)
			})
			.then(() => {
				showComponentProperties(propertyEditorState.currentComponent);
				updatePropertyStatus('Properties pasted');
			})
			.catch(error => {
				console.error('Error pasting properties:', error);
			});
		}
		
		function toggleAdvancedProperties() {
			propertyEditorState.showAdvanced = !propertyEditorState.showAdvanced;
			const toggle = document.getElementById('advanced-toggle');
			
			if (propertyEditorState.showAdvanced) {
				toggle.textContent = 'Basic';
				toggle.classList.add('font-semibold');
			} else {
				toggle.textContent = 'Advanced';
				toggle.classList.remove('font-semibold');
			}
			
			// Refresh current view
			if (propertyEditorState.currentComponent) {
				showComponentProperties(propertyEditorState.currentComponent);
			}
		}
	</script>
}

// CanvasProperties renders properties for the canvas itself
templ CanvasProperties() {
	<div class="p-4 space-y-4">
		<div class="flex items-center">
			<div class="w-8 h-8 bg-gray-100 rounded mr-3 flex items-center justify-center">
				<svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path>
				</svg>
			</div>
			<div>
				<h3 class="font-medium text-gray-900">Canvas</h3>
				<p class="text-xs text-gray-500">Page layout settings</p>
			</div>
		</div>
		
		<!-- Canvas Size -->
		<div class="space-y-2">
			<label class="block text-sm font-medium text-gray-700">Canvas Size</label>
			<div class="grid grid-cols-2 gap-2">
				<div>
					<input type="number" placeholder="Width" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm" id="canvas-width"/>
					<label class="text-xs text-gray-500">Width (px)</label>
				</div>
				<div>
					<input type="number" placeholder="Height" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm" id="canvas-height"/>
					<label class="text-xs text-gray-500">Height (px)</label>
				</div>
			</div>
		</div>
		
		<!-- Background -->
		<div class="space-y-2">
			<label class="block text-sm font-medium text-gray-700">Background</label>
			<div class="flex items-center space-x-2">
				<input type="color" class="h-8 w-16 border border-gray-300 rounded cursor-pointer" id="canvas-background"/>
				<input type="text" placeholder="#ffffff" class="flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm" id="canvas-background-text"/>
			</div>
		</div>
		
		<!-- Grid Settings -->
		<div class="space-y-2">
			<label class="block text-sm font-medium text-gray-700">Grid</label>
			<div class="space-y-2">
				<div class="flex items-center">
					<input type="checkbox" class="h-4 w-4 text-blue-600 border-gray-300 rounded" id="show-grid"/>
					<label class="ml-2 text-sm text-gray-700">Show Grid</label>
				</div>
				<div class="flex items-center">
					<input type="checkbox" class="h-4 w-4 text-blue-600 border-gray-300 rounded" id="snap-to-grid"/>
					<label class="ml-2 text-sm text-gray-700">Snap to Grid</label>
				</div>
				<div>
					<input type="number" placeholder="8" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm" id="grid-size"/>
					<label class="text-xs text-gray-500">Grid Size (px)</label>
				</div>
			</div>
		</div>
		
		<!-- Page Settings -->
		<div class="space-y-2">
			<label class="block text-sm font-medium text-gray-700">Page</label>
			<div class="space-y-2">
				<input type="text" placeholder="Page Title" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm" id="page-title"/>
				<textarea placeholder="Page Description" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm" id="page-description"></textarea>
				<select class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm" id="page-layout">
					<option value="app">App Layout</option>
					<option value="auth">Auth Layout</option>
					<option value="minimal">Minimal Layout</option>
					<option value="base">Base Layout</option>
				</select>
			</div>
		</div>
	</div>
}

// MultiSelectionProperties renders properties for multiple selected components
templ MultiSelectionProperties() {
	<div class="p-4 space-y-4">
		<div class="flex items-center">
			<div class="w-8 h-8 bg-purple-100 rounded mr-3 flex items-center justify-center">
				<svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14-7H3a2 2 0 00-2 2v8a2 2 0 002 2h2l3-3 3 3h2a2 2 0 002-2V6a2 2 0 00-2-2z"></path>
				</svg>
			</div>
			<div>
				<h3 class="font-medium text-gray-900">Multiple Selection</h3>
				<p class="text-xs text-gray-500" id="selection-count">0 components selected</p>
			</div>
		</div>
		
		<!-- Common Properties -->
		<div class="space-y-3">
			<h4 class="text-sm font-medium text-gray-700">Common Properties</h4>
			
			<!-- Position -->
			<div class="space-y-2">
				<label class="block text-sm font-medium text-gray-700">Position</label>
				<div class="grid grid-cols-2 gap-2">
					<input type="number" placeholder="X" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm" id="multi-x"/>
					<input type="number" placeholder="Y" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm" id="multi-y"/>
				</div>
			</div>
			
			<!-- Size -->
			<div class="space-y-2">
				<label class="block text-sm font-medium text-gray-700">Size</label>
				<div class="grid grid-cols-2 gap-2">
					<input type="number" placeholder="Width" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm" id="multi-width"/>
					<input type="number" placeholder="Height" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm" id="multi-height"/>
				</div>
			</div>
			
			<!-- Alignment -->
			<div class="space-y-2">
				<label class="block text-sm font-medium text-gray-700">Alignment</label>
				<div class="grid grid-cols-3 gap-1">
					<button class="px-2 py-1 text-xs border border-gray-300 rounded hover:bg-gray-50" onclick="alignComponents('left')">Left</button>
					<button class="px-2 py-1 text-xs border border-gray-300 rounded hover:bg-gray-50" onclick="alignComponents('center')">Center</button>
					<button class="px-2 py-1 text-xs border border-gray-300 rounded hover:bg-gray-50" onclick="alignComponents('right')">Right</button>
					<button class="px-2 py-1 text-xs border border-gray-300 rounded hover:bg-gray-50" onclick="alignComponents('top')">Top</button>
					<button class="px-2 py-1 text-xs border border-gray-300 rounded hover:bg-gray-50" onclick="alignComponents('middle')">Middle</button>
					<button class="px-2 py-1 text-xs border border-gray-300 rounded hover:bg-gray-50" onclick="alignComponents('bottom')">Bottom</button>
				</div>
			</div>
			
			<!-- Distribution -->
			<div class="space-y-2">
				<label class="block text-sm font-medium text-gray-700">Distribution</label>
				<div class="grid grid-cols-2 gap-1">
					<button class="px-2 py-1 text-xs border border-gray-300 rounded hover:bg-gray-50" onclick="distributeComponents('horizontal')">Horizontal</button>
					<button class="px-2 py-1 text-xs border border-gray-300 rounded hover:bg-gray-50" onclick="distributeComponents('vertical')">Vertical</button>
				</div>
			</div>
			
			<!-- Z-Index -->
			<div class="space-y-2">
				<label class="block text-sm font-medium text-gray-700">Layer Order</label>
				<div class="grid grid-cols-2 gap-1">
					<button class="px-2 py-1 text-xs border border-gray-300 rounded hover:bg-gray-50" onclick="bringToFront()">Bring Forward</button>
					<button class="px-2 py-1 text-xs border border-gray-300 rounded hover:bg-gray-50" onclick="sendToBack()">Send Backward</button>
				</div>
			</div>
		</div>
	</div>
	
	<script>
		function alignComponents(alignment) {
			// Implementation for component alignment
			const componentIds = propertyEditorState.selectedComponents;
			
			fetch('/api/builder/components/align', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					componentIds,
					alignment
				})
			})
			.catch(error => {
				console.error('Error aligning components:', error);
			});
		}
		
		function distributeComponents(direction) {
			// Implementation for component distribution
			const componentIds = propertyEditorState.selectedComponents;
			
			fetch('/api/builder/components/distribute', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					componentIds,
					direction
				})
			})
			.catch(error => {
				console.error('Error distributing components:', error);
			});
		}
		
		function bringToFront() {
			// Implementation for z-index management
			const componentIds = propertyEditorState.selectedComponents;
			
			fetch('/api/builder/components/z-order', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					componentIds,
					direction: 'front'
				})
			})
			.catch(error => {
				console.error('Error changing z-order:', error);
			});
		}
		
		function sendToBack() {
			// Implementation for z-index management
			const componentIds = propertyEditorState.selectedComponents;
			
			fetch('/api/builder/components/z-order', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					componentIds,
					direction: 'back'
				})
			})
			.catch(error => {
				console.error('Error changing z-order:', error);
			});
		}
	</script>
}