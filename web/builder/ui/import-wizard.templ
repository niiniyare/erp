package ui

import (
	"github.com/niiniyare/erp/web/builder/templates"
)

// ImportWizard renders the template import wizard interface
templ ImportWizard(library *templates.TemplateLibrary) {
	<div class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden" id="import-wizard-modal">
		<div class="flex items-center justify-center h-full p-4">
			<div class="bg-white rounded-lg shadow-xl max-w-4xl w-full max-h-90vh overflow-hidden">
				<!-- Wizard Header -->
				<div class="p-6 border-b border-gray-200">
					<div class="flex items-center justify-between">
						<div>
							<h3 class="text-xl font-semibold text-gray-900">Template Import Wizard</h3>
							<p class="text-sm text-gray-600 mt-1">Import templates from various sources</p>
						</div>
						<button 
							class="p-2 hover:bg-gray-100 rounded"
							onclick="closeImportWizard()"
						>
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>
					
					<!-- Progress Steps -->
					<div class="mt-6">
						<div class="flex items-center justify-between">
							<div class="step-indicator active" data-step="1">
								<div class="step-number">1</div>
								<div class="step-label">Source</div>
							</div>
							<div class="step-line"></div>
							<div class="step-indicator" data-step="2">
								<div class="step-number">2</div>
								<div class="step-label">Configure</div>
							</div>
							<div class="step-line"></div>
							<div class="step-indicator" data-step="3">
								<div class="step-number">3</div>
								<div class="step-label">Mapping</div>
							</div>
							<div class="step-line"></div>
							<div class="step-indicator" data-step="4">
								<div class="step-number">4</div>
								<div class="step-label">Preview</div>
							</div>
							<div class="step-line"></div>
							<div class="step-indicator" data-step="5">
								<div class="step-number">5</div>
								<div class="step-label">Import</div>
							</div>
						</div>
					</div>
				</div>
				
				<!-- Wizard Content -->
				<div class="p-6 h-96 overflow-y-auto">
					<!-- Step 1: Source Selection -->
					<div class="wizard-step active" id="step-1">
						<h4 class="text-lg font-medium text-gray-900 mb-4">Select Import Source</h4>
						
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
							<!-- Phase 4.3 Schemas -->
							<div class="import-source-card" data-source="phase43" onclick="selectImportSource('phase43')">
								<div class="p-4 border-2 border-gray-200 rounded-lg hover:border-blue-500 cursor-pointer transition-colors">
									<div class="text-center">
										<div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-3">
											<svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
											</svg>
										</div>
										<h5 class="font-medium text-gray-900">Phase 4.3 Schemas</h5>
										<p class="text-sm text-gray-600 mt-1">Import auto-generated schemas from Phase 4.3</p>
										<div class="mt-2">
											<span class="inline-block px-2 py-1 bg-green-100 text-green-800 text-xs rounded">Recommended</span>
										</div>
									</div>
								</div>
							</div>
							
							<!-- Templ Files -->
							<div class="import-source-card" data-source="templ" onclick="selectImportSource('templ')">
								<div class="p-4 border-2 border-gray-200 rounded-lg hover:border-blue-500 cursor-pointer transition-colors">
									<div class="text-center">
										<div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-3">
											<svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
											</svg>
										</div>
										<h5 class="font-medium text-gray-900">Templ Files</h5>
										<p class="text-sm text-gray-600 mt-1">Convert existing Templ templates</p>
									</div>
								</div>
							</div>
							
							<!-- JSON Templates -->
							<div class="import-source-card" data-source="json" onclick="selectImportSource('json')">
								<div class="p-4 border-2 border-gray-200 rounded-lg hover:border-blue-500 cursor-pointer transition-colors">
									<div class="text-center">
										<div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mx-auto mb-3">
											<svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
											</svg>
										</div>
										<h5 class="font-medium text-gray-900">JSON Templates</h5>
										<p class="text-sm text-gray-600 mt-1">Import from JSON template files</p>
									</div>
								</div>
							</div>
							
							<!-- Directory Import -->
							<div class="import-source-card" data-source="directory" onclick="selectImportSource('directory')">
								<div class="p-4 border-2 border-gray-200 rounded-lg hover:border-blue-500 cursor-pointer transition-colors">
									<div class="text-center">
										<div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-3">
											<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
											</svg>
										</div>
										<h5 class="font-medium text-gray-900">Directory</h5>
										<p class="text-sm text-gray-600 mt-1">Batch import from folder</p>
									</div>
								</div>
							</div>
							
							<!-- URL Import -->
							<div class="import-source-card" data-source="url" onclick="selectImportSource('url')">
								<div class="p-4 border-2 border-gray-200 rounded-lg hover:border-blue-500 cursor-pointer transition-colors">
									<div class="text-center">
										<div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-3">
											<svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
											</svg>
										</div>
										<h5 class="font-medium text-gray-900">Remote URL</h5>
										<p class="text-sm text-gray-600 mt-1">Import from remote repository</p>
									</div>
								</div>
							</div>
							
							<!-- Upload Files -->
							<div class="import-source-card" data-source="upload" onclick="selectImportSource('upload')">
								<div class="p-4 border-2 border-gray-200 rounded-lg hover:border-blue-500 cursor-pointer transition-colors">
									<div class="text-center">
										<div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center mx-auto mb-3">
											<svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
											</svg>
										</div>
										<h5 class="font-medium text-gray-900">Upload Files</h5>
										<p class="text-sm text-gray-600 mt-1">Upload template files directly</p>
									</div>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Step 2: Configuration -->
					<div class="wizard-step hidden" id="step-2">
						<h4 class="text-lg font-medium text-gray-900 mb-4">Import Configuration</h4>
						
						<div class="space-y-6">
							<!-- Import Options -->
							<div>
								<h5 class="text-sm font-medium text-gray-700 mb-3">Import Options</h5>
								<div class="space-y-3">
									<label class="flex items-center">
										<input type="checkbox" id="overwrite-existing" class="h-4 w-4 text-blue-600" checked/>
										<span class="ml-2 text-sm text-gray-700">Overwrite existing templates</span>
									</label>
									<label class="flex items-center">
										<input type="checkbox" id="skip-duplicates" class="h-4 w-4 text-blue-600"/>
										<span class="ml-2 text-sm text-gray-700">Skip duplicate templates</span>
									</label>
									<label class="flex items-center">
										<input type="checkbox" id="validate-components" class="h-4 w-4 text-blue-600" checked/>
										<span class="ml-2 text-sm text-gray-700">Validate component dependencies</span>
									</label>
									<label class="flex items-center">
										<input type="checkbox" id="create-missing" class="h-4 w-4 text-blue-600"/>
										<span class="ml-2 text-sm text-gray-700">Create missing component types</span>
									</label>
								</div>
							</div>
							
							<!-- Default Values -->
							<div>
								<h5 class="text-sm font-medium text-gray-700 mb-3">Default Values</h5>
								<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
									<div>
										<label class="block text-xs text-gray-600 mb-1">Default Author</label>
										<input 
											type="text" 
											id="default-author"
											class="w-full px-3 py-2 border border-gray-300 rounded text-sm"
											placeholder="Author name"
											value="System"
										/>
									</div>
									<div>
										<label class="block text-xs text-gray-600 mb-1">Default Category</label>
										<select 
											id="default-category"
											class="w-full px-3 py-2 border border-gray-300 rounded text-sm"
										>
											<option value="">Select category...</option>
											<option value="dashboard">Dashboard</option>
											<option value="forms">Forms</option>
											<option value="tables">Tables</option>
											<option value="navigation">Navigation</option>
											<option value="auth">Authentication</option>
											<option value="ecommerce">E-commerce</option>
											<option value="admin">Admin</option>
											<option value="landing">Landing Pages</option>
										</select>
									</div>
									<div>
										<label class="block text-xs text-gray-600 mb-1">Tag Prefix</label>
										<input 
											type="text" 
											id="tag-prefix"
											class="w-full px-3 py-2 border border-gray-300 rounded text-sm"
											placeholder="imported"
										/>
									</div>
									<div>
										<label class="block text-xs text-gray-600 mb-1">Conflict Resolution</label>
										<select 
											id="conflict-resolution"
											class="w-full px-3 py-2 border border-gray-300 rounded text-sm"
										>
											<option value="skip">Skip conflicting templates</option>
											<option value="overwrite">Overwrite existing</option>
											<option value="rename">Rename conflicting</option>
											<option value="prompt">Prompt for each</option>
										</select>
									</div>
								</div>
							</div>
							
							<!-- File/Source Input -->
							<div id="source-input-section">
								<!-- Dynamic content based on selected source -->
							</div>
						</div>
					</div>
					
					<!-- Step 3: Component Mapping -->
					<div class="wizard-step hidden" id="step-3">
						<h4 class="text-lg font-medium text-gray-900 mb-4">Component Mapping</h4>
						
						<div class="space-y-4">
							<p class="text-sm text-gray-600">Map imported component types to your component registry:</p>
							
							<div id="component-mapping-list" class="space-y-3">
								<!-- Component mappings will be loaded here -->
								<div class="text-center py-8 text-gray-500">
									<p class="text-sm">Component mappings will appear here after analyzing the source</p>
								</div>
							</div>
							
							<div class="flex items-center justify-between pt-4 border-t">
								<button 
									class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300"
									onclick="autoMapComponents()"
								>
									Auto-Map Components
								</button>
								<button 
									class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
									onclick="addCustomMapping()"
								>
									Add Custom Mapping
								</button>
							</div>
						</div>
					</div>
					
					<!-- Step 4: Preview -->
					<div class="wizard-step hidden" id="step-4">
						<h4 class="text-lg font-medium text-gray-900 mb-4">Import Preview</h4>
						
						<div class="space-y-4">
							<!-- Import Summary -->
							<div class="bg-gray-50 rounded-lg p-4">
								<h5 class="text-sm font-medium text-gray-700 mb-2">Import Summary</h5>
								<div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
									<div>
										<span class="text-gray-600">Templates:</span>
										<span class="font-medium ml-1" id="preview-template-count">0</span>
									</div>
									<div>
										<span class="text-gray-600">Components:</span>
										<span class="font-medium ml-1" id="preview-component-count">0</span>
									</div>
									<div>
										<span class="text-gray-600">Conflicts:</span>
										<span class="font-medium ml-1 text-yellow-600" id="preview-conflict-count">0</span>
									</div>
									<div>
										<span class="text-gray-600">Errors:</span>
										<span class="font-medium ml-1 text-red-600" id="preview-error-count">0</span>
									</div>
								</div>
							</div>
							
							<!-- Preview List -->
							<div class="border border-gray-200 rounded-lg">
								<div class="p-3 border-b border-gray-200 bg-gray-50">
									<h5 class="text-sm font-medium text-gray-700">Templates to Import</h5>
								</div>
								<div id="preview-template-list" class="max-h-64 overflow-y-auto">
									<!-- Preview items will be loaded here -->
									<div class="text-center py-8 text-gray-500">
										<p class="text-sm">Preview will appear here after analysis</p>
									</div>
								</div>
							</div>
							
							<!-- Validation Results -->
							<div id="validation-results" class="hidden">
								<h5 class="text-sm font-medium text-gray-700 mb-2">Validation Results</h5>
								<div class="space-y-2">
									<div id="validation-errors" class="hidden">
										<div class="bg-red-50 border border-red-200 rounded p-3">
											<h6 class="text-sm font-medium text-red-800">Errors</h6>
											<ul class="text-sm text-red-700 mt-1 space-y-1" id="error-list">
												<!-- Errors will be listed here -->
											</ul>
										</div>
									</div>
									<div id="validation-warnings" class="hidden">
										<div class="bg-yellow-50 border border-yellow-200 rounded p-3">
											<h6 class="text-sm font-medium text-yellow-800">Warnings</h6>
											<ul class="text-sm text-yellow-700 mt-1 space-y-1" id="warning-list">
												<!-- Warnings will be listed here -->
											</ul>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Step 5: Import Progress -->
					<div class="wizard-step hidden" id="step-5">
						<h4 class="text-lg font-medium text-gray-900 mb-4">Importing Templates</h4>
						
						<div class="space-y-6">
							<!-- Progress Bar -->
							<div>
								<div class="flex items-center justify-between mb-2">
									<span class="text-sm text-gray-600">Import Progress</span>
									<span class="text-sm text-gray-600" id="import-progress-text">0%</span>
								</div>
								<div class="w-full bg-gray-200 rounded-full h-2">
									<div class="bg-blue-600 h-2 rounded-full transition-all duration-300" id="import-progress-bar" style="width: 0%"></div>
								</div>
							</div>
							
							<!-- Import Log -->
							<div>
								<h5 class="text-sm font-medium text-gray-700 mb-2">Import Log</h5>
								<div class="bg-gray-900 text-green-400 rounded p-4 h-48 overflow-y-auto font-mono text-xs" id="import-log">
									<div class="text-gray-500">Import log will appear here...</div>
								</div>
							</div>
							
							<!-- Import Results -->
							<div id="import-results" class="hidden">
								<h5 class="text-sm font-medium text-gray-700 mb-2">Import Complete</h5>
								<div class="bg-green-50 border border-green-200 rounded p-4">
									<div class="flex items-center">
										<svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
										</svg>
										<span class="text-sm text-green-800" id="import-success-message">Import completed successfully!</span>
									</div>
									<div class="mt-2 text-sm text-green-700" id="import-summary">
										<!-- Import summary will be shown here -->
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				
				<!-- Wizard Footer -->
				<div class="p-6 border-t border-gray-200 bg-gray-50">
					<div class="flex items-center justify-between">
						<button 
							class="px-4 py-2 text-gray-600 hover:text-gray-800"
							onclick="previousStep()"
							id="prev-btn"
							disabled
						>
							← Previous
						</button>
						
						<div class="flex space-x-3">
							<button 
								class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300"
								onclick="closeImportWizard()"
							>
								Cancel
							</button>
							<button 
								class="px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
								onclick="nextStep()"
								id="next-btn"
							>
								Next →
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	
	<!-- Import Wizard JavaScript -->
	<script>
		// Import wizard state
		const importWizardState = {
			currentStep: 1,
			totalSteps: 5,
			selectedSource: null,
			configuration: {},
			componentMappings: {},
			previewData: null,
			importOptions: {},
			validationResults: null,
			importProgress: 0,
			importComplete: false
		};

		// Initialize import wizard
		function initializeImportWizard() {
			// Setup event listeners
			setupImportWizardEvents();
			
			// Reset state
			resetImportWizard();
		}

		function setupImportWizardEvents() {
			// Close modal on escape key
			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape') {
					closeImportWizard();
				}
			});
			
			// Close modal on backdrop click
			document.getElementById('import-wizard-modal').addEventListener('click', function(e) {
				if (e.target === this) {
					closeImportWizard();
				}
			});
		}

		function showImportWizard() {
			document.getElementById('import-wizard-modal').classList.remove('hidden');
			initializeImportWizard();
		}

		function closeImportWizard() {
			document.getElementById('import-wizard-modal').classList.add('hidden');
			resetImportWizard();
		}

		function resetImportWizard() {
			importWizardState.currentStep = 1;
			importWizardState.selectedSource = null;
			importWizardState.configuration = {};
			importWizardState.componentMappings = {};
			importWizardState.previewData = null;
			importWizardState.importProgress = 0;
			importWizardState.importComplete = false;
			
			updateStepIndicators();
			showStep(1);
			updateNavigationButtons();
		}

		function selectImportSource(source) {
			importWizardState.selectedSource = source;
			
			// Update UI
			document.querySelectorAll('.import-source-card').forEach(card => {
				card.classList.remove('selected');
			});
			document.querySelector(`[data-source="${source}"]`).classList.add('selected');
			
			// Load source-specific input
			loadSourceInput(source);
			
			// Enable next button
			updateNavigationButtons();
		}

		function loadSourceInput(source) {
			const section = document.getElementById('source-input-section');
			
			switch (source) {
				case 'phase43':
					section.innerHTML = `
						<div>
							<h5 class="text-sm font-medium text-gray-700 mb-3">Phase 4.3 Schema Source</h5>
							<div class="space-y-3">
								<div>
									<label class="block text-xs text-gray-600 mb-1">Schema Directory</label>
									<input 
										type="text" 
										id="phase43-directory"
										class="w-full px-3 py-2 border border-gray-300 rounded text-sm"
										placeholder="/path/to/phase43/schemas"
										value="/data/data/com.termux/files/home/project/erp/schemas"
									/>
								</div>
								<div class="flex items-center space-x-2">
									<button 
										class="px-3 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm"
										onclick="browseForDirectory()"
									>
										Browse
									</button>
									<button 
										class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 text-sm"
										onclick="scanPhase43Directory()"
									>
										Scan Directory
									</button>
								</div>
							</div>
						</div>
					`;
					break;
					
				case 'templ':
					section.innerHTML = `
						<div>
							<h5 class="text-sm font-medium text-gray-700 mb-3">Templ File Source</h5>
							<div class="space-y-3">
								<div>
									<label class="block text-xs text-gray-600 mb-1">Templ Files</label>
									<input 
										type="file" 
										id="templ-files"
										class="w-full px-3 py-2 border border-gray-300 rounded text-sm"
										multiple
										accept=".templ,.go"
									/>
								</div>
								<p class="text-xs text-gray-500">Select one or more .templ files to import</p>
							</div>
						</div>
					`;
					break;
					
				case 'json':
					section.innerHTML = `
						<div>
							<h5 class="text-sm font-medium text-gray-700 mb-3">JSON Template Files</h5>
							<div class="space-y-3">
								<div>
									<label class="block text-xs text-gray-600 mb-1">JSON Files</label>
									<input 
										type="file" 
										id="json-files"
										class="w-full px-3 py-2 border border-gray-300 rounded text-sm"
										multiple
										accept=".json"
									/>
								</div>
								<p class="text-xs text-gray-500">Select template JSON files to import</p>
							</div>
						</div>
					`;
					break;
					
				case 'directory':
					section.innerHTML = `
						<div>
							<h5 class="text-sm font-medium text-gray-700 mb-3">Directory Import</h5>
							<div class="space-y-3">
								<div>
									<label class="block text-xs text-gray-600 mb-1">Directory Path</label>
									<input 
										type="text" 
										id="import-directory"
										class="w-full px-3 py-2 border border-gray-300 rounded text-sm"
										placeholder="/path/to/templates"
									/>
								</div>
								<div class="grid grid-cols-2 gap-3">
									<label class="flex items-center text-xs">
										<input type="checkbox" id="include-subdirs" class="mr-1" checked/>
										Include subdirectories
									</label>
									<label class="flex items-center text-xs">
										<input type="checkbox" id="filter-by-extension" class="mr-1"/>
										Filter by extension
									</label>
								</div>
							</div>
						</div>
					`;
					break;
					
				case 'url':
					section.innerHTML = `
						<div>
							<h5 class="text-sm font-medium text-gray-700 mb-3">Remote URL Import</h5>
							<div class="space-y-3">
								<div>
									<label class="block text-xs text-gray-600 mb-1">Repository URL</label>
									<input 
										type="url" 
										id="import-url"
										class="w-full px-3 py-2 border border-gray-300 rounded text-sm"
										placeholder="https://github.com/user/templates.git"
									/>
								</div>
								<div class="grid grid-cols-2 gap-3">
									<div>
										<label class="block text-xs text-gray-600 mb-1">Branch</label>
										<input 
											type="text" 
											id="url-branch"
											class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
											placeholder="main"
											value="main"
										/>
									</div>
									<div>
										<label class="block text-xs text-gray-600 mb-1">Path</label>
										<input 
											type="text" 
											id="url-path"
											class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
											placeholder="templates/"
										/>
									</div>
								</div>
							</div>
						</div>
					`;
					break;
					
				case 'upload':
					section.innerHTML = `
						<div>
							<h5 class="text-sm font-medium text-gray-700 mb-3">File Upload</h5>
							<div class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center">
								<svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
								</svg>
								<p class="text-sm text-gray-600 mb-2">Drop files here or click to browse</p>
								<input 
									type="file" 
									id="upload-files"
									class="hidden"
									multiple
									accept=".json,.templ,.go,.zip"
									onchange="handleFileUpload(this.files)"
								/>
								<button 
									class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm"
									onclick="document.getElementById('upload-files').click()"
								>
									Choose Files
								</button>
								<p class="text-xs text-gray-500 mt-2">Supported: JSON, Templ, ZIP archives</p>
							</div>
							<div id="upload-file-list" class="mt-3 space-y-1 hidden">
								<!-- Uploaded files will be listed here -->
							</div>
						</div>
					`;
					break;
			}
		}

		function nextStep() {
			if (importWizardState.currentStep < importWizardState.totalSteps) {
				// Validate current step
				if (!validateCurrentStep()) {
					return;
				}
				
				// Process step
				processCurrentStep();
				
				// Move to next step
				importWizardState.currentStep++;
				updateStepIndicators();
				showStep(importWizardState.currentStep);
				updateNavigationButtons();
			}
		}

		function previousStep() {
			if (importWizardState.currentStep > 1) {
				importWizardState.currentStep--;
				updateStepIndicators();
				showStep(importWizardState.currentStep);
				updateNavigationButtons();
			}
		}

		function validateCurrentStep() {
			switch (importWizardState.currentStep) {
				case 1:
					return importWizardState.selectedSource !== null;
				case 2:
					return validateConfiguration();
				case 3:
					return true; // Component mapping is optional
				case 4:
					return importWizardState.previewData !== null;
				default:
					return true;
			}
		}

		function validateConfiguration() {
			// Basic validation of required fields
			const author = document.getElementById('default-author').value;
			return author.trim() !== '';
		}

		function processCurrentStep() {
			switch (importWizardState.currentStep) {
				case 1:
					// Source selection completed
					break;
				case 2:
					collectConfiguration();
					break;
				case 3:
					collectComponentMappings();
					break;
				case 4:
					startImport();
					break;
			}
		}

		function collectConfiguration() {
			importWizardState.configuration = {
				overwriteExisting: document.getElementById('overwrite-existing').checked,
				skipDuplicates: document.getElementById('skip-duplicates').checked,
				validateComponents: document.getElementById('validate-components').checked,
				createMissing: document.getElementById('create-missing').checked,
				defaultAuthor: document.getElementById('default-author').value,
				defaultCategory: document.getElementById('default-category').value,
				tagPrefix: document.getElementById('tag-prefix').value,
				conflictResolution: document.getElementById('conflict-resolution').value
			};
			
			// Analyze source and load component mappings
			analyzeSourceAndLoadMappings();
		}

		function analyzeSourceAndLoadMappings() {
			// Simulate analysis
			setTimeout(() => {
				const sampleMappings = [
					{ source: 'CustomButton', target: 'atoms.button', status: 'auto' },
					{ source: 'DataTable', target: 'organisms.table', status: 'auto' },
					{ source: 'FormField', target: 'molecules.form-field', status: 'manual' },
					{ source: 'NavBar', target: 'organisms.nav', status: 'auto' }
				];
				
				renderComponentMappings(sampleMappings);
			}, 1000);
		}

		function renderComponentMappings(mappings) {
			const container = document.getElementById('component-mapping-list');
			
			if (mappings.length === 0) {
				container.innerHTML = '<div class="text-center py-8 text-gray-500"><p class="text-sm">No component mappings required</p></div>';
				return;
			}
			
			container.innerHTML = mappings.map((mapping, index) => `
				<div class="component-mapping-item flex items-center space-x-3 p-3 border border-gray-200 rounded">
					<div class="flex-1">
						<div class="flex items-center space-x-3">
							<div class="text-sm font-medium text-gray-900">${mapping.source}</div>
							<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
							</svg>
							<select class="mapping-target-select text-sm border border-gray-300 rounded px-2 py-1" data-source="${mapping.source}">
								<option value="${mapping.target}" selected>${mapping.target}</option>
								<option value="atoms.button">atoms.button</option>
								<option value="atoms.input">atoms.input</option>
								<option value="molecules.card">molecules.card</option>
								<option value="molecules.form">molecules.form</option>
								<option value="organisms.table">organisms.table</option>
								<option value="organisms.nav">organisms.nav</option>
							</select>
						</div>
					</div>
					<div class="flex items-center space-x-2">
						<span class="inline-block px-2 py-1 text-xs rounded ${mapping.status === 'auto' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}">
							${mapping.status === 'auto' ? 'Auto' : 'Manual'}
						</span>
						<button class="text-red-600 hover:text-red-800" onclick="removeMapping(${index})" title="Remove mapping">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>
				</div>
			`).join('');
		}

		function collectComponentMappings() {
			importWizardState.componentMappings = {};
			
			document.querySelectorAll('.mapping-target-select').forEach(select => {
				const source = select.dataset.source;
				const target = select.value;
				importWizardState.componentMappings[source] = target;
			});
			
			// Generate preview
			generateImportPreview();
		}

		function generateImportPreview() {
			// Simulate preview generation
			setTimeout(() => {
				const previewData = {
					templates: [
						{ name: 'Dashboard Layout', components: 5, status: 'ready', conflicts: 0 },
						{ name: 'Contact Form', components: 3, status: 'ready', conflicts: 0 },
						{ name: 'User Table', components: 2, status: 'warning', conflicts: 1 },
						{ name: 'Navigation Menu', components: 4, status: 'ready', conflicts: 0 }
					],
					summary: {
						templateCount: 4,
						componentCount: 14,
						conflictCount: 1,
						errorCount: 0
					}
				};
				
				importWizardState.previewData = previewData;
				renderImportPreview(previewData);
			}, 1000);
		}

		function renderImportPreview(data) {
			// Update summary
			document.getElementById('preview-template-count').textContent = data.summary.templateCount;
			document.getElementById('preview-component-count').textContent = data.summary.componentCount;
			document.getElementById('preview-conflict-count').textContent = data.summary.conflictCount;
			document.getElementById('preview-error-count').textContent = data.summary.errorCount;
			
			// Render template list
			const container = document.getElementById('preview-template-list');
			container.innerHTML = data.templates.map(template => `
				<div class="p-3 border-b border-gray-200 flex items-center justify-between">
					<div class="flex items-center space-x-3">
						<div class="flex-shrink-0">
							${template.status === 'ready' ? 
								'<svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>' :
								template.status === 'warning' ?
								'<svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>' :
								'<svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>'
							}
						</div>
						<div>
							<div class="text-sm font-medium text-gray-900">${template.name}</div>
							<div class="text-xs text-gray-600">${template.components} components</div>
						</div>
					</div>
					<div class="text-right">
						' + (template.conflicts > 0 ? '<span class="text-xs text-yellow-600">' + template.conflicts + ' conflicts</span>' : '') + '
					</div>
				</div>
			`).join('');
		}

		function startImport() {
			// Begin import process
			importWizardState.importProgress = 0;
			importWizardState.importComplete = false;
			
			// Simulate import progress
			simulateImportProgress();
		}

		function simulateImportProgress() {
			const log = document.getElementById('import-log');
			const progressBar = document.getElementById('import-progress-bar');
			const progressText = document.getElementById('import-progress-text');
			
			const steps = [
				'Initializing import process...',
				'Validating source files...',
				'Analyzing component dependencies...',
				'Converting template formats...',
				'Applying component mappings...',
				'Validating converted templates...',
				'Adding templates to library...',
				'Import completed successfully!'
			];
			
			let currentStep = 0;
			
			function nextImportStep() {
				if (currentStep < steps.length) {
					log.innerHTML += `<div class="text-green-400">[${new Date().toLocaleTimeString()}] ${steps[currentStep]}</div>`;
					log.scrollTop = log.scrollHeight;
					
					const progress = ((currentStep + 1) / steps.length) * 100;
					progressBar.style.width = progress + '%';
					progressText.textContent = Math.round(progress) + '%';
					
					currentStep++;
					
					if (currentStep < steps.length) {
						setTimeout(nextImportStep, 800 + Math.random() * 400);
					} else {
						completeImport();
					}
				}
			}
			
			nextImportStep();
		}

		function completeImport() {
			importWizardState.importComplete = true;
			
			// Show completion message
			document.getElementById('import-results').classList.remove('hidden');
			document.getElementById('import-success-message').textContent = 
				`Successfully imported ${importWizardState.previewData.summary.templateCount} templates`;
			document.getElementById('import-summary').innerHTML = `
				<div>Templates: ${importWizardState.previewData.summary.templateCount}</div>
				<div>Components: ${importWizardState.previewData.summary.componentCount}</div>
				<div>Conflicts resolved: ${importWizardState.previewData.summary.conflictCount}</div>
			`;
			
			// Update navigation
			updateNavigationButtons();
		}

		function updateStepIndicators() {
			document.querySelectorAll('.step-indicator').forEach((indicator, index) => {
				const stepNumber = index + 1;
				indicator.classList.remove('active', 'completed');
				
				if (stepNumber < importWizardState.currentStep) {
					indicator.classList.add('completed');
				} else if (stepNumber === importWizardState.currentStep) {
					indicator.classList.add('active');
				}
			});
		}

		function showStep(stepNumber) {
			document.querySelectorAll('.wizard-step').forEach(step => {
				step.classList.add('hidden');
			});
			document.getElementById(`step-${stepNumber}`).classList.remove('hidden');
		}

		function updateNavigationButtons() {
			const prevBtn = document.getElementById('prev-btn');
			const nextBtn = document.getElementById('next-btn');
			
			// Previous button
			prevBtn.disabled = importWizardState.currentStep === 1;
			
			// Next button
			const canProceed = validateCurrentStep();
			nextBtn.disabled = !canProceed;
			
			if (importWizardState.currentStep === importWizardState.totalSteps) {
				if (importWizardState.importComplete) {
					nextBtn.textContent = 'Finish';
					nextBtn.onclick = closeImportWizard;
				} else {
					nextBtn.textContent = 'Import';
					nextBtn.onclick = startImport;
				}
			} else {
				nextBtn.textContent = 'Next →';
				nextBtn.onclick = nextStep;
			}
		}

		// Utility functions
		function autoMapComponents() {
			// Auto-map based on naming conventions
			document.querySelectorAll('.mapping-target-select').forEach(select => {
				const sourceName = select.dataset.source.toLowerCase();
				
				if (sourceName.includes('button')) {
					select.value = 'atoms.button';
				} else if (sourceName.includes('table')) {
					select.value = 'organisms.table';
				} else if (sourceName.includes('form')) {
					select.value = 'molecules.form';
				} else if (sourceName.includes('nav')) {
					select.value = 'organisms.nav';
				}
			});
			
			showNotification('Components auto-mapped based on naming conventions', 'success');
		}

		function addCustomMapping() {
			const container = document.getElementById('component-mapping-list');
			const index = container.children.length;
			
			const mappingHTML = `
				<div class="component-mapping-item flex items-center space-x-3 p-3 border border-gray-200 rounded">
					<div class="flex-1">
						<div class="flex items-center space-x-3">
							<input type="text" placeholder="Source component" class="text-sm border border-gray-300 rounded px-2 py-1"/>
							<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
							</svg>
							<select class="mapping-target-select text-sm border border-gray-300 rounded px-2 py-1">
								<option value="">Select target...</option>
								<option value="atoms.button">atoms.button</option>
								<option value="atoms.input">atoms.input</option>
								<option value="molecules.card">molecules.card</option>
								<option value="molecules.form">molecules.form</option>
								<option value="organisms.table">organisms.table</option>
								<option value="organisms.nav">organisms.nav</option>
							</select>
						</div>
					</div>
					<button class="text-red-600 hover:text-red-800" onclick="removeMapping(${index})" title="Remove mapping">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
			`;
			
			container.insertAdjacentHTML('beforeend', mappingHTML);
		}

		function removeMapping(index) {
			const container = document.getElementById('component-mapping-list');
			const items = container.querySelectorAll('.component-mapping-item');
			if (items[index]) {
				items[index].remove();
			}
		}

		function handleFileUpload(files) {
			const listContainer = document.getElementById('upload-file-list');
			listContainer.classList.remove('hidden');
			listContainer.innerHTML = '';
			
			Array.from(files).forEach(file => {
				const fileItem = document.createElement('div');
				fileItem.className = 'flex items-center justify-between p-2 bg-gray-50 rounded text-sm';
				fileItem.innerHTML = `
					<span>${file.name} (${(file.size / 1024).toFixed(1)} KB)</span>
					<button class="text-red-600 hover:text-red-800">Remove</button>
				`;
				listContainer.appendChild(fileItem);
			});
		}

		function showNotification(message, type = 'info') {
			// Create notification element
			const notification = document.createElement('div');
			notification.className = `fixed top-4 right-4 px-4 py-2 rounded shadow-lg z-50 text-white text-sm`;
			
			switch (type) {
				case 'success':
					notification.classList.add('bg-green-600');
					break;
				case 'error':
					notification.classList.add('bg-red-600');
					break;
				case 'warning':
					notification.classList.add('bg-yellow-600');
					break;
				default:
					notification.classList.add('bg-blue-600');
			}
			
			notification.textContent = message;
			document.body.appendChild(notification);
			
			// Auto remove after 3 seconds
			setTimeout(() => {
				notification.remove();
			}, 3000);
		}

		// Export import wizard functions
		window.ImportWizard = {
			show: showImportWizard,
			close: closeImportWizard
		};
	</script>
	
	<!-- Import Wizard Styles -->
	<style>
		.step-indicator {
			@apply flex flex-col items-center text-center;
		}
		
		.step-number {
			@apply w-8 h-8 rounded-full border-2 border-gray-300 flex items-center justify-center text-sm font-medium text-gray-500 mb-1;
		}
		
		.step-label {
			@apply text-xs text-gray-500;
		}
		
		.step-indicator.active .step-number {
			@apply border-blue-600 bg-blue-600 text-white;
		}
		
		.step-indicator.active .step-label {
			@apply text-blue-600 font-medium;
		}
		
		.step-indicator.completed .step-number {
			@apply border-green-600 bg-green-600 text-white;
		}
		
		.step-indicator.completed .step-label {
			@apply text-green-600;
		}
		
		.step-line {
			@apply flex-1 h-px bg-gray-300 mx-2;
		}
		
		.import-source-card.selected > div {
			@apply border-blue-500 bg-blue-50;
		}
		
		.wizard-step {
			@apply min-h-64;
		}
		
		.max-h-90vh {
			max-height: 90vh;
		}
	</style>
}