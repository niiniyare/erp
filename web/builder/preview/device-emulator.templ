package preview

// DeviceEmulator renders the device emulation interface
templ DeviceEmulator() {
	<div class="bg-white border-l border-gray-200 w-80 flex flex-col h-full">
		<!-- Device Emulator Header -->
		<div class="p-4 border-b border-gray-200">
			<div class="flex items-center justify-between mb-3">
				<h3 class="text-lg font-semibold text-gray-900">Device Emulator</h3>
				<button 
					class="p-1 hover:bg-gray-100 rounded"
					onclick="toggleDeviceEmulator()"
					title="Toggle Device Emulator"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
					</svg>
				</button>
			</div>
		</div>
		
		<!-- Device Presets -->
		<div class="p-4 border-b border-gray-200">
			<h4 class="text-sm font-medium text-gray-700 mb-3">Device Presets</h4>
			<div class="grid grid-cols-2 gap-2">
				<!-- Desktop -->
				<button 
					class="device-preset-btn active"
					data-device="desktop"
					onclick="selectDevicePreset('desktop')"
				>
					<svg class="w-6 h-6 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
					</svg>
					<span class="text-xs">Desktop</span>
					<span class="text-xs text-gray-500 block">1920×1080</span>
				</button>
				
				<!-- Laptop -->
				<button 
					class="device-preset-btn"
					data-device="laptop"
					onclick="selectDevicePreset('laptop')"
				>
					<svg class="w-6 h-6 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM21 16a2 2 0 11-4 0 2 2 0 014 0z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14V5a2 2 0 012-2h4a2 2 0 012 2v9M8 14l-2 2m6-2l2 2m-6 0h4"></path>
					</svg>
					<span class="text-xs">Laptop</span>
					<span class="text-xs text-gray-500 block">1366×768</span>
				</button>
				
				<!-- Tablet Portrait -->
				<button 
					class="device-preset-btn"
					data-device="tablet-portrait"
					onclick="selectDevicePreset('tablet-portrait')"
				>
					<svg class="w-6 h-6 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a1 1 0 001-1V4a1 1 0 00-1-1H8a1 1 0 00-1 1v16a1 1 0 001 1z"></path>
					</svg>
					<span class="text-xs">Tablet</span>
					<span class="text-xs text-gray-500 block">768×1024</span>
				</button>
				
				<!-- Tablet Landscape -->
				<button 
					class="device-preset-btn"
					data-device="tablet-landscape"
					onclick="selectDevicePreset('tablet-landscape')"
				>
					<svg class="w-6 h-6 mx-auto mb-1 transform rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a1 1 0 001-1V4a1 1 0 00-1-1H8a1 1 0 00-1 1v16a1 1 0 001 1z"></path>
					</svg>
					<span class="text-xs">Tablet L</span>
					<span class="text-xs text-gray-500 block">1024×768</span>
				</button>
				
				<!-- Mobile Portrait -->
				<button 
					class="device-preset-btn"
					data-device="mobile-portrait"
					onclick="selectDevicePreset('mobile-portrait')"
				>
					<svg class="w-6 h-6 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
					</svg>
					<span class="text-xs">Mobile</span>
					<span class="text-xs text-gray-500 block">375×667</span>
				</button>
				
				<!-- Mobile Landscape -->
				<button 
					class="device-preset-btn"
					data-device="mobile-landscape"
					onclick="selectDevicePreset('mobile-landscape')"
				>
					<svg class="w-6 h-6 mx-auto mb-1 transform rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
					</svg>
					<span class="text-xs">Mobile L</span>
					<span class="text-xs text-gray-500 block">667×375</span>
				</button>
			</div>
		</div>
		
		<!-- Custom Dimensions -->
		<div class="p-4 border-b border-gray-200">
			<h4 class="text-sm font-medium text-gray-700 mb-3">Custom Size</h4>
			<div class="space-y-3">
				<div class="grid grid-cols-2 gap-2">
					<div>
						<label class="block text-xs text-gray-600 mb-1">Width</label>
						<input 
							type="number" 
							id="custom-width"
							class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
							value="1200"
							min="240"
							max="2560"
							onchange="updateCustomDimensions()"
						/>
					</div>
					<div>
						<label class="block text-xs text-gray-600 mb-1">Height</label>
						<input 
							type="number" 
							id="custom-height"
							class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
							value="800"
							min="240"
							max="1600"
							onchange="updateCustomDimensions()"
						/>
					</div>
				</div>
				
				<div class="flex items-center justify-between">
					<button 
						class="px-3 py-1 bg-blue-600 text-white text-xs rounded hover:bg-blue-700"
						onclick="applyCustomDimensions()"
					>
						Apply Custom
					</button>
					
					<button 
						class="p-1 hover:bg-gray-100 rounded"
						onclick="swapDimensions()"
						title="Rotate Dimensions"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
						</svg>
					</button>
				</div>
			</div>
		</div>
		
		<!-- Device Settings -->
		<div class="p-4 border-b border-gray-200">
			<h4 class="text-sm font-medium text-gray-700 mb-3">Device Settings</h4>
			<div class="space-y-3">
				<!-- Pixel Density -->
				<div>
					<label class="block text-xs text-gray-600 mb-1">Pixel Density</label>
					<select 
						id="pixel-density" 
						class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
						onchange="updatePixelDensity(this.value)"
					>
						<option value="1">1x (Standard)</option>
						<option value="1.5">1.5x (HD)</option>
						<option value="2" selected>2x (Retina)</option>
						<option value="3">3x (Retina HD)</option>
					</select>
				</div>
				
				<!-- User Agent -->
				<div>
					<label class="block text-xs text-gray-600 mb-1">User Agent</label>
					<select 
						id="user-agent" 
						class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
						onchange="updateUserAgent(this.value)"
					>
						<option value="desktop">Desktop Chrome</option>
						<option value="mobile-chrome">Mobile Chrome</option>
						<option value="mobile-safari">Mobile Safari</option>
						<option value="tablet-safari">Tablet Safari</option>
						<option value="custom">Custom</option>
					</select>
				</div>
				
				<!-- Touch Events -->
				<div class="flex items-center justify-between">
					<label class="text-xs text-gray-600">Touch Events</label>
					<input 
						type="checkbox" 
						id="touch-events"
						class="h-4 w-4 text-blue-600"
						onchange="toggleTouchEvents(this.checked)"
					/>
				</div>
			</div>
		</div>
		
		<!-- Performance Settings -->
		<div class="p-4 border-b border-gray-200">
			<h4 class="text-sm font-medium text-gray-700 mb-3">Performance</h4>
			<div class="space-y-3">
				<!-- Network Throttling -->
				<div>
					<label class="block text-xs text-gray-600 mb-1">Network</label>
					<select 
						id="network-throttling" 
						class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
						onchange="updateNetworkThrottling(this.value)"
					>
						<option value="online">Online</option>
						<option value="fast-3g">Fast 3G</option>
						<option value="slow-3g">Slow 3G</option>
						<option value="offline">Offline</option>
					</select>
				</div>
				
				<!-- CPU Throttling -->
				<div>
					<label class="block text-xs text-gray-600 mb-1">CPU Throttling</label>
					<select 
						id="cpu-throttling" 
						class="w-full px-2 py-1 border border-gray-300 rounded text-sm"
						onchange="updateCPUThrottling(this.value)"
					>
						<option value="1">No throttling</option>
						<option value="2">2x slowdown</option>
						<option value="4">4x slowdown</option>
						<option value="6">6x slowdown</option>
					</select>
				</div>
				
				<!-- Memory Pressure -->
				<div class="flex items-center justify-between">
					<label class="text-xs text-gray-600">Low Memory</label>
					<input 
						type="checkbox" 
						id="low-memory"
						class="h-4 w-4 text-blue-600"
						onchange="toggleLowMemory(this.checked)"
					/>
				</div>
			</div>
		</div>
		
		<!-- Current Status -->
		<div class="p-4 border-b border-gray-200">
			<h4 class="text-sm font-medium text-gray-700 mb-3">Current Status</h4>
			<div class="space-y-2 text-xs text-gray-600">
				<div class="flex justify-between">
					<span>Resolution:</span>
					<span id="current-resolution">1920×1080</span>
				</div>
				<div class="flex justify-between">
					<span>Viewport:</span>
					<span id="current-viewport">1200×800</span>
				</div>
				<div class="flex justify-between">
					<span>DPR:</span>
					<span id="current-dpr">2x</span>
				</div>
				<div class="flex justify-between">
					<span>Network:</span>
					<span id="current-network">Online</span>
				</div>
			</div>
		</div>
		
		<!-- Actions -->
		<div class="p-4">
			<div class="space-y-2">
				<button 
					class="w-full px-3 py-2 bg-green-600 text-white text-sm rounded hover:bg-green-700"
					onclick="takeScreenshot()"
				>
					📸 Take Screenshot
				</button>
				
				<button 
					class="w-full px-3 py-2 bg-purple-600 text-white text-sm rounded hover:bg-purple-700"
					onclick="runResponsiveTest()"
				>
					🔍 Responsive Test
				</button>
				
				<button 
					class="w-full px-3 py-2 bg-gray-600 text-white text-sm rounded hover:bg-gray-700"
					onclick="resetDeviceSettings()"
				>
					↺ Reset Settings
				</button>
			</div>
		</div>
	</div>
	
	<!-- Device Emulator JavaScript -->
	<script>
		// Device emulator state
		const deviceEmulatorState = {
			currentDevice: 'desktop',
			customWidth: 1200,
			customHeight: 800,
			pixelDensity: 2,
			userAgent: 'desktop',
			touchEvents: false,
			networkThrottling: 'online',
			cpuThrottling: 1,
			lowMemory: false,
			isActive: true
		};

		// Device presets configuration
		const devicePresets = {
			'desktop': {
				width: 1920,
				height: 1080,
				viewport: { width: 1200, height: 800 },
				dpr: 1,
				userAgent: 'desktop',
				touchEvents: false,
				orientation: 'landscape'
			},
			'laptop': {
				width: 1366,
				height: 768,
				viewport: { width: 1200, height: 600 },
				dpr: 1,
				userAgent: 'desktop',
				touchEvents: false,
				orientation: 'landscape'
			},
			'tablet-portrait': {
				width: 768,
				height: 1024,
				viewport: { width: 768, height: 1024 },
				dpr: 2,
				userAgent: 'tablet-safari',
				touchEvents: true,
				orientation: 'portrait'
			},
			'tablet-landscape': {
				width: 1024,
				height: 768,
				viewport: { width: 1024, height: 768 },
				dpr: 2,
				userAgent: 'tablet-safari',
				touchEvents: true,
				orientation: 'landscape'
			},
			'mobile-portrait': {
				width: 375,
				height: 667,
				viewport: { width: 375, height: 667 },
				dpr: 3,
				userAgent: 'mobile-safari',
				touchEvents: true,
				orientation: 'portrait'
			},
			'mobile-landscape': {
				width: 667,
				height: 375,
				viewport: { width: 667, height: 375 },
				dpr: 3,
				userAgent: 'mobile-safari',
				touchEvents: true,
				orientation: 'landscape'
			}
		};

		// User agent strings
		const userAgents = {
			'desktop': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36',
			'mobile-chrome': 'Mozilla/5.0 (Linux; Android 10; Pixel 3) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Mobile Safari/537.36',
			'mobile-safari': 'Mozilla/5.0 (iPhone; CPU iPhone OS 14_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/14.0 Mobile/15E148 Safari/604.1',
			'tablet-safari': 'Mozilla/5.0 (iPad; CPU OS 14_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/14.0 Mobile/15E148 Safari/604.1'
		};

		// Initialize device emulator
		document.addEventListener('DOMContentLoaded', function() {
			initializeDeviceEmulator();
		});

		function initializeDeviceEmulator() {
			// Apply default device preset
			selectDevicePreset('desktop');
			updateStatusDisplay();
		}

		function selectDevicePreset(deviceType) {
			const preset = devicePresets[deviceType];
			if (!preset) return;

			deviceEmulatorState.currentDevice = deviceType;

			// Update button states
			document.querySelectorAll('.device-preset-btn').forEach(btn => {
				btn.classList.remove('active');
			});
			document.querySelector(`[data-device="${deviceType}"]`).classList.add('active');

			// Apply preset settings
			applyDeviceSettings(preset);
			updateStatusDisplay();

			// Notify preview panel
			if (window.PreviewPanel) {
				window.PreviewPanel.setDevice(deviceType);
			}
		}

		function applyDeviceSettings(preset) {
			// Update form controls
			document.getElementById('custom-width').value = preset.viewport.width;
			document.getElementById('custom-height').value = preset.viewport.height;
			document.getElementById('pixel-density').value = preset.dpr;
			document.getElementById('user-agent').value = preset.userAgent;
			document.getElementById('touch-events').checked = preset.touchEvents;

			// Apply settings
			deviceEmulatorState.customWidth = preset.viewport.width;
			deviceEmulatorState.customHeight = preset.viewport.height;
			deviceEmulatorState.pixelDensity = preset.dpr;
			deviceEmulatorState.userAgent = preset.userAgent;
			deviceEmulatorState.touchEvents = preset.touchEvents;

			// Send to preview iframe
			sendDeviceSettingsToPreview();
		}

		function updateCustomDimensions() {
			deviceEmulatorState.customWidth = parseInt(document.getElementById('custom-width').value);
			deviceEmulatorState.customHeight = parseInt(document.getElementById('custom-height').value);
		}

		function applyCustomDimensions() {
			updateCustomDimensions();
			deviceEmulatorState.currentDevice = 'custom';

			// Update button states
			document.querySelectorAll('.device-preset-btn').forEach(btn => {
				btn.classList.remove('active');
			});

			// Apply custom viewport
			if (window.PreviewPanel) {
				window.PreviewPanel.setDevice('custom');
			}

			sendDeviceSettingsToPreview();
			updateStatusDisplay();
		}

		function swapDimensions() {
			const width = document.getElementById('custom-width').value;
			const height = document.getElementById('custom-height').value;
			
			document.getElementById('custom-width').value = height;
			document.getElementById('custom-height').value = width;
			
			updateCustomDimensions();
			
			if (deviceEmulatorState.currentDevice === 'custom') {
				applyCustomDimensions();
			}
		}

		function updatePixelDensity(density) {
			deviceEmulatorState.pixelDensity = parseFloat(density);
			sendDeviceSettingsToPreview();
			updateStatusDisplay();
		}

		function updateUserAgent(agent) {
			deviceEmulatorState.userAgent = agent;
			sendDeviceSettingsToPreview();
		}

		function toggleTouchEvents(enabled) {
			deviceEmulatorState.touchEvents = enabled;
			sendDeviceSettingsToPreview();
		}

		function updateNetworkThrottling(type) {
			deviceEmulatorState.networkThrottling = type;
			sendDeviceSettingsToPreview();
			updateStatusDisplay();
		}

		function updateCPUThrottling(multiplier) {
			deviceEmulatorState.cpuThrottling = parseInt(multiplier);
			sendDeviceSettingsToPreview();
		}

		function toggleLowMemory(enabled) {
			deviceEmulatorState.lowMemory = enabled;
			sendDeviceSettingsToPreview();
		}

		function sendDeviceSettingsToPreview() {
			const message = {
				type: 'deviceSettings',
				settings: {
					width: deviceEmulatorState.customWidth,
					height: deviceEmulatorState.customHeight,
					pixelDensity: deviceEmulatorState.pixelDensity,
					userAgent: userAgents[deviceEmulatorState.userAgent] || userAgents.desktop,
					touchEvents: deviceEmulatorState.touchEvents,
					networkThrottling: deviceEmulatorState.networkThrottling,
					cpuThrottling: deviceEmulatorState.cpuThrottling,
					lowMemory: deviceEmulatorState.lowMemory
				}
			};

			// Send to preview iframe
			const iframe = document.getElementById('preview-frame');
			if (iframe && iframe.contentWindow) {
				iframe.contentWindow.postMessage(message, '*');
			}

			// Send via WebSocket for server-side emulation
			if (window.previewState && window.previewState.websocket) {
				window.previewState.websocket.send(JSON.stringify(message));
			}
		}

		function updateStatusDisplay() {
			const preset = devicePresets[deviceEmulatorState.currentDevice];
			
			if (preset) {
				document.getElementById('current-resolution').textContent = 
					preset.width + '×' + preset.height;
			} else {
				document.getElementById('current-resolution').textContent = 'Custom';
			}

			document.getElementById('current-viewport').textContent = 
				deviceEmulatorState.customWidth + '×' + deviceEmulatorState.customHeight;
			
			document.getElementById('current-dpr').textContent = 
				deviceEmulatorState.pixelDensity + 'x';
			
			document.getElementById('current-network').textContent = 
				deviceEmulatorState.networkThrottling.charAt(0).toUpperCase() + 
				deviceEmulatorState.networkThrottling.slice(1);
		}

		function takeScreenshot() {
			// Capture screenshot of current preview
			const iframe = document.getElementById('preview-frame');
			if (!iframe) return;

			// Use html2canvas or similar to capture iframe content
			// For now, we'll simulate the action
			showNotification('📸 Screenshot captured!', 'success');
			
			// TODO: Implement actual screenshot functionality
			// This would typically involve:
			// 1. Capturing iframe content
			// 2. Generating image blob
			// 3. Downloading or storing the image
		}

		function runResponsiveTest() {
			showNotification('🔍 Running responsive test...', 'info');
			
			const testDevices = ['desktop', 'tablet-portrait', 'mobile-portrait'];
			let currentIndex = 0;
			
			function testNextDevice() {
				if (currentIndex >= testDevices.length) {
					showNotification('✅ Responsive test completed!', 'success');
					return;
				}
				
				const device = testDevices[currentIndex];
				selectDevicePreset(device);
				
				setTimeout(() => {
					currentIndex++;
					testNextDevice();
				}, 2000);
			}
			
			testNextDevice();
		}

		function resetDeviceSettings() {
			// Reset to desktop default
			selectDevicePreset('desktop');
			
			// Reset performance settings
			document.getElementById('network-throttling').value = 'online';
			document.getElementById('cpu-throttling').value = '1';
			document.getElementById('low-memory').checked = false;
			
			updateNetworkThrottling('online');
			updateCPUThrottling(1);
			toggleLowMemory(false);
			
			showNotification('↺ Device settings reset', 'info');
		}

		function toggleDeviceEmulator() {
			deviceEmulatorState.isActive = !deviceEmulatorState.isActive;
			
			const emulator = document.querySelector('.bg-white.border-l.w-80');
			if (deviceEmulatorState.isActive) {
				emulator.style.display = 'flex';
			} else {
				emulator.style.display = 'none';
			}
		}

		function showNotification(message, type = 'info') {
			// Create notification element
			const notification = document.createElement('div');
			notification.className = `fixed top-4 right-4 px-4 py-2 rounded shadow-lg z-50 text-white text-sm`;
			
			switch (type) {
				case 'success':
					notification.classList.add('bg-green-600');
					break;
				case 'error':
					notification.classList.add('bg-red-600');
					break;
				case 'warning':
					notification.classList.add('bg-yellow-600');
					break;
				default:
					notification.classList.add('bg-blue-600');
			}
			
			notification.textContent = message;
			document.body.appendChild(notification);
			
			// Auto remove after 3 seconds
			setTimeout(() => {
				notification.remove();
			}, 3000);
		}

		// Export device emulator functions
		window.DeviceEmulator = {
			selectPreset: selectDevicePreset,
			setCustomSize: applyCustomDimensions,
			takeScreenshot: takeScreenshot,
			runResponsiveTest: runResponsiveTest,
			reset: resetDeviceSettings,
			toggle: toggleDeviceEmulator
		};
	</script>
	
	<!-- Device Emulator Styles -->
	<style>
		.device-preset-btn {
			@apply flex flex-col items-center p-3 border border-gray-200 rounded-lg text-center hover:bg-gray-50 transition-colors cursor-pointer;
		}
		
