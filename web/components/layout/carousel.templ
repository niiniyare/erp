package layout

import (
	"strings"
	"strconv"
)

// CarouselItem represents a single carousel slide
type CarouselItem struct {
	ID       string `json:"id" validate:"required"`
	Content  string `json:"content"`
	Image    string `json:"image"`
	ImageAlt string `json:"image_alt"`
	Title    string `json:"title"`
	Caption  string `json:"caption"`
	Link     string `json:"link"`
	Active   bool   `json:"active"`
}

// CarouselProps defines the properties for the Carousel component
type CarouselProps struct {
	Items        []CarouselItem `json:"items" validate:"required,min=1"`
	AutoPlay     bool           `json:"auto_play"`
	Interval     int            `json:"interval"` // Interval in milliseconds
	Loop         bool           `json:"loop"`
	ShowDots     bool           `json:"show_dots"`
	ShowArrows   bool           `json:"show_arrows"`
	ShowCaptions bool           `json:"show_captions"`
	Fade         bool           `json:"fade"` // Fade transition instead of slide
	Height       string         `json:"height" validate:"oneof=auto sm base lg xl 2xl"`
	ID           string         `json:"id"`
	Class        string         `json:"class"`
	AriaLabel    string         `json:"aria_label"`
}

// Carousel renders a Flowbite-styled carousel component
templ Carousel(props CarouselProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getCarouselClasses(props.Height) + " " + props.Class }
		x-data={ getCarouselData(props.Items, props.AutoPlay, props.Interval, props.Loop) }
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		} else {
			aria-label="Image carousel"
		}
		role="region"
	>
		<!-- Carousel wrapper -->
		<div class={ getCarouselWrapperClasses() }>
			for i, item := range props.Items {
				<div
					class={ getCarouselSlideClasses(props.Fade) }
					x-show={ "currentSlide === " + strconv.Itoa(i) }
					if props.Fade {
						x-transition:enter="transition-opacity ease-linear duration-500"
						x-transition:enter-start="opacity-0"
						x-transition:enter-end="opacity-100"
						x-transition:leave="transition-opacity ease-linear duration-500"
						x-transition:leave-start="opacity-100"
						x-transition:leave-end="opacity-0"
					} else {
						x-transition:enter="transition transform ease-out duration-500"
						x-transition:enter-start="translate-x-full"
						x-transition:enter-end="translate-x-0"
						x-transition:leave="transition transform ease-in duration-500"
						x-transition:leave-start="translate-x-0"
						x-transition:leave-end="-translate-x-full"
					}
				>
					if item.Image != "" {
						@CarouselImageSlide(item, props.ShowCaptions)
					} else {
						@CarouselContentSlide(item)
					}
				</div>
			}
		</div>

		<!-- Slide indicators (dots) -->
		if props.ShowDots {
			<div class={ getCarouselDotsClasses() }>
				for i, _ := range props.Items {
					<button
						type="button"
						class={ getCarouselDotClasses() }
						:class={ "{ '" + getActiveDotClasses() + "': currentSlide === " + strconv.Itoa(i) + " }" }
						@click={ "goToSlide(" + strconv.Itoa(i) + ")" }
						aria-current="false"
						:aria-current={ "currentSlide === " + strconv.Itoa(i) + " ? 'true' : 'false'" }
						aria-label={ "Slide " + strconv.Itoa(i+1) }
					></button>
				}
			</div>
		}

		<!-- Previous/Next arrows -->
		if props.ShowArrows {
			<!-- Previous button -->
			<button
				type="button"
				class={ getCarouselPrevClasses() }
				@click="prevSlide()"
				aria-label="Previous slide"
			>
				<svg class="w-4 h-4 text-white dark:text-gray-800 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 1 1 5l4 4"/>
				</svg>
				<span class="sr-only">Previous</span>
			</button>

			<!-- Next button -->
			<button
				type="button"
				class={ getCarouselNextClasses() }
				@click="nextSlide()"
				aria-label="Next slide"
			>
				<svg class="w-4 h-4 text-white dark:text-gray-800 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
				</svg>
				<span class="sr-only">Next</span>
			</button>
		}
	</div>
}

// CarouselImageSlide renders an image slide
templ CarouselImageSlide(item CarouselItem, showCaptions bool) {
	if item.Link != "" {
		<a href={ item.Link } class={ getCarouselSlideContentClasses() }>
			@CarouselImageContent(item, showCaptions)
		</a>
	} else {
		<div class={ getCarouselSlideContentClasses() }>
			@CarouselImageContent(item, showCaptions)
		</div>
	}
}

// CarouselImageContent renders the image content
templ CarouselImageContent(item CarouselItem, showCaptions bool) {
	<img 
		src={ item.Image } 
		class={ getCarouselImageClasses() }
		alt={ item.ImageAlt }
	/>
	if showCaptions && (item.Title != "" || item.Caption != "") {
		<div class={ getCarouselCaptionClasses() }>
			if item.Title != "" {
				<h5 class={ getCarouselCaptionTitleClasses() }>
					{ item.Title }
				</h5>
			}
			if item.Caption != "" {
				<p class={ getCarouselCaptionTextClasses() }>
					{ item.Caption }
				</p>
			}
		</div>
	}
}

// CarouselContentSlide renders a content-only slide
templ CarouselContentSlide(item CarouselItem) {
	<div class={ getCarouselContentSlideClasses() }>
		if item.Content != "" {
			{ item.Content }
		} else {
			if item.Title != "" {
				<h3 class={ getCarouselContentTitleClasses() }>
					{ item.Title }
				</h3>
			}
			if item.Caption != "" {
				<p class={ getCarouselContentTextClasses() }>
					{ item.Caption }
				</p>
			}
		}
	</div>
}

// Helper functions for carousel styling
func getCarouselData(items []CarouselItem, autoPlay bool, interval int, loop bool) string {
	// Find the active slide or default to the first one
	activeSlide := 0
	for i, item := range items {
		if item.Active {
			activeSlide = i
			break
		}
	}
	
	intervalStr := "3000"
	if interval > 0 {
		intervalStr = strconv.Itoa(interval)
	}
	
	return `{
		currentSlide: ` + strconv.Itoa(activeSlide) + `,
		totalSlides: ` + strconv.Itoa(len(items)) + `,
		autoPlay: ` + getCarouselBoolString(autoPlay) + `,
		interval: ` + intervalStr + `,
		loop: ` + getCarouselBoolString(loop) + `,
		timer: null,
		
		init() {
			if (this.autoPlay) {
				this.startAutoPlay();
			}
		},
		
		startAutoPlay() {
			this.timer = setInterval(() => {
				this.nextSlide();
			}, this.interval);
		},
		
		stopAutoPlay() {
			if (this.timer) {
				clearInterval(this.timer);
				this.timer = null;
			}
		},
		
		goToSlide(index) {
			this.currentSlide = index;
			if (this.autoPlay) {
				this.stopAutoPlay();
				this.startAutoPlay();
			}
		},
		
		nextSlide() {
			if (this.currentSlide < this.totalSlides - 1) {
				this.currentSlide++;
			} else if (this.loop) {
				this.currentSlide = 0;
			}
		},
		
		prevSlide() {
			if (this.currentSlide > 0) {
				this.currentSlide--;
			} else if (this.loop) {
				this.currentSlide = this.totalSlides - 1;
			}
		}
	}`
}

func getCarouselClasses(height string) string {
	base := "relative w-full"
	
	var heightClass string
	switch height {
	case "sm":
		heightClass = "h-56"
	case "lg":
		heightClass = "h-96"
	case "xl":
		heightClass = "h-[32rem]"
	case "2xl":
		heightClass = "h-[40rem]"
	case "auto":
		heightClass = ""
	default: // base
		heightClass = "h-80"
	}
	
	if heightClass == "" {
		return base
	}
	return strings.Join([]string{base, heightClass}, " ")
}

func getCarouselWrapperClasses() string {
	return "relative h-full overflow-hidden rounded-lg"
}

func getCarouselSlideClasses(fade bool) string {
	if fade {
		return "absolute inset-0"
	}
	return "relative h-full"
}

func getCarouselSlideContentClasses() string {
	return "relative h-full"
}

func getCarouselImageClasses() string {
	return "absolute block w-full h-full object-cover"
}

func getCarouselCaptionClasses() string {
	return "absolute bottom-5 left-1/2 transform -translate-x-1/2 text-center"
}

func getCarouselCaptionTitleClasses() string {
	return "text-xl font-semibold text-white dark:text-gray-800"
}

func getCarouselCaptionTextClasses() string {
	return "font-normal text-gray-300 dark:text-gray-400"
}

func getCarouselContentSlideClasses() string {
	return "flex items-center justify-center h-full bg-gray-200 dark:bg-gray-800"
}

func getCarouselContentTitleClasses() string {
	return "text-2xl font-bold text-gray-900 dark:text-white mb-4"
}

func getCarouselContentTextClasses() string {
	return "text-lg text-gray-700 dark:text-gray-300"
}

func getCarouselDotsClasses() string {
	return "absolute z-30 flex space-x-3 -translate-x-1/2 bottom-5 left-1/2"
}

func getCarouselDotClasses() string {
	return "w-3 h-3 rounded-full bg-gradient-to-r from-white to-gray-50/50 hover:bg-gradient-to-r from-white to-gray-50 focus:outline-none focus:bg-gradient-to-r from-white to-gray-50 transition-colors duration-200"
}

func getActiveDotClasses() string {
	return "bg-gradient-to-r from-white to-gray-50"
}

func getCarouselPrevClasses() string {
	return "absolute top-0 left-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
}

func getCarouselNextClasses() string {
	return "absolute top-0 right-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
}

func getCarouselBoolString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}