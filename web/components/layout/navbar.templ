package layout

import "strings"

// NavbarNavItem represents a navigation item for navbar (different from types.NavItem)
type NavbarNavItem struct {
	Text     string `json:"text" validate:"required"`
	Href     string `json:"href"`
	Icon     string `json:"icon"`
	Active   bool   `json:"active"`
	Disabled bool   `json:"disabled"`
	Badge    string `json:"badge"`
	Children []NavbarNavItem `json:"children"` // For dropdown navigation
	ID       string `json:"id"`
}

// NavbarProps defines the properties for the Navbar component
type NavbarProps struct {
	Brand       NavbarBrand `json:"brand"`
	Items       []NavbarNavItem   `json:"items"`
	Actions     []NavbarAction `json:"actions"`
	Sticky      bool        `json:"sticky"`
	Transparent bool        `json:"transparent"`
	Border      bool        `json:"border"`
	Fluid       bool        `json:"fluid"`
	ID          string      `json:"id"`
	Class       string      `json:"class"`
}

// NavbarBrand defines the brand/logo area
type NavbarBrand struct {
	Text      string `json:"text"`
	Logo      string `json:"logo"`
	LogoAlt   string `json:"logo_alt"`
	Href      string `json:"href"`
	ID        string `json:"id"`
}

// NavbarAction defines action buttons in the navbar
type NavbarAction struct {
	Text     string `json:"text"`
	Icon     string `json:"icon"`
	Href     string `json:"href"`
	Variant  string `json:"variant" validate:"oneof=primary secondary ghost"`
	Size     string `json:"size" validate:"oneof=xs sm base lg"`
	Badge    string `json:"badge"`
	ID       string `json:"id"`
}

// Navbar renders a Flowbite-styled navbar component
templ Navbar(props NavbarProps) {
	<nav
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getNavbarClasses(props.Sticky, props.Transparent, props.Border) + " " + props.Class }
	>
		<div class={ getNavbarContainerClasses(props.Fluid) }>
			<!-- Brand -->
			if props.Brand.Text != "" || props.Brand.Logo != "" {
				<a 
					href={ getBrandHref(props.Brand.Href) }
					class={ getNavbarBrandClasses() }
					if props.Brand.ID != "" {
						id={ props.Brand.ID }
					}
				>
					if props.Brand.Logo != "" {
						<img 
							src={ props.Brand.Logo } 
							class={ getNavbarLogoClasses() }
							alt={ props.Brand.LogoAlt }
						/>
					}
					if props.Brand.Text != "" {
						<span class={ getNavbarBrandTextClasses() }>
							{ props.Brand.Text }
						</span>
					}
				</a>
			}

			<!-- Mobile menu button -->
			<button
				type="button"
				class={ getNavbarToggleClasses() }
				@click="$store.navbar.toggleMobile()"
				aria-controls="navbar-default"
				aria-expanded="false"
				:aria-expanded="$store.navbar.mobileOpen"
			>
				<span class="sr-only">Open main menu</span>
				<svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
				</svg>
			</button>

			<!-- Navigation items -->
			<div 
				class={ getNavbarMenuClasses() }
				id="navbar-default"
				x-show="$store.navbar.mobileOpen || window.innerWidth >= 768"
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="opacity-0 transform -translate-y-1"
				x-transition:enter-end="opacity-100 transform translate-y-0"
				x-transition:leave="transition ease-in duration-150"
				x-transition:leave-start="opacity-100 transform translate-y-0"
				x-transition:leave-end="opacity-0 transform -translate-y-1"
			>
				<!-- Main navigation -->
				if len(props.Items) > 0 {
					<ul class={ getNavbarListClasses() }>
						for _, item := range props.Items {
							<li>
								@NavbarItem(item)
							</li>
						}
					</ul>
				}

				<!-- Action buttons -->
				if len(props.Actions) > 0 {
					<div class={ getNavbarActionsClasses() }>
						for _, action := range props.Actions {
							@NavbarActionButton(action)
						}
					</div>
				}
			</div>
		</div>
	</nav>
}

// NavbarItem renders a single navigation item
templ NavbarItem(item NavbarNavItem) {
	if len(item.Children) > 0 {
		<!-- Dropdown navigation item -->
		<div 
			class="relative"
			x-data="{ open: false }"
			@click.away="open = false"
		>
			<button
				type="button"
				class={ getNavbarLinkClasses(item.Active, item.Disabled) }
				@click="open = !open"
				aria-expanded="false"
				:aria-expanded="open"
			>
				@NavbarItemContent(item)
				<svg class="w-2.5 h-2.5 ml-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
				</svg>
			</button>

			<!-- Dropdown menu -->
			<div 
				class={ getNavbarDropdownClasses() }
				x-show="open"
				x-transition:enter="transition ease-out duration-100"
				x-transition:enter-start="transform opacity-0 scale-95"
				x-transition:enter-end="transform opacity-100 scale-100"
				x-transition:leave="transition ease-in duration-75"
				x-transition:leave-start="transform opacity-100 scale-100"
				x-transition:leave-end="transform opacity-0 scale-95"
			>
				<ul class="py-2 text-sm">
					for _, child := range item.Children {
						<li>
							if child.Href != "" {
								<a 
									href={ child.Href }
									class={ getNavbarDropdownItemClasses(child.Disabled) }
									if child.Disabled {
										aria-disabled="true"
										tabindex="-1"
									}
								>
									@NavbarItemContent(child)
								</a>
							} else {
								<button
									type="button"
									class={ getNavbarDropdownItemClasses(child.Disabled) }
									if child.Disabled {
										disabled
										aria-disabled="true"
									}
								>
									@NavbarItemContent(child)
								</button>
							}
						</li>
					}
				</ul>
			</div>
		</div>
	} else {
		<!-- Regular navigation item -->
		if item.Href != "" {
			<a 
				href={ item.Href }
				class={ getNavbarLinkClasses(item.Active, item.Disabled) }
				if item.Disabled {
					aria-disabled="true"
					tabindex="-1"
				}
				if item.ID != "" {
					id={ item.ID }
				}
			>
				@NavbarItemContent(item)
			</a>
		} else {
			<button
				type="button"
				class={ getNavbarLinkClasses(item.Active, item.Disabled) }
				if item.Disabled {
					disabled
					aria-disabled="true"
				}
				if item.ID != "" {
					id={ item.ID }
				}
			>
				@NavbarItemContent(item)
			</button>
		}
	}
}

// NavbarItemContent renders the content of a navigation item
templ NavbarItemContent(item NavbarNavItem) {
	<div class="flex items-center">
		if item.Icon != "" {
			<span class="w-4 h-4 mr-2">{ item.Icon }</span>
		}
		<span>{ item.Text }</span>
		if item.Badge != "" {
			<span class={ getNavbarBadgeClasses() }>
				{ item.Badge }
			</span>
		}
	</div>
}

// NavbarActionButton renders an action button
templ NavbarActionButton(action NavbarAction) {
	if action.Href != "" {
		<a 
			href={ action.Href }
			class={ getNavbarActionClasses(action.Variant, action.Size) }
			if action.ID != "" {
				id={ action.ID }
			}
		>
			@NavbarActionContent(action)
		</a>
	} else {
		<button
			type="button"
			class={ getNavbarActionClasses(action.Variant, action.Size) }
			if action.ID != "" {
				id={ action.ID }
			}
		>
			@NavbarActionContent(action)
		</button>
	}
}

// NavbarActionContent renders the content of an action button
templ NavbarActionContent(action NavbarAction) {
	<div class="relative flex items-center">
		if action.Icon != "" {
			<span class="w-4 h-4">{ action.Icon }</span>
		}
		if action.Text != "" {
			<span if action.Icon != "" {class="ml-2"}>{ action.Text }</span>
		}
		if action.Badge != "" {
			<span class={ getNavbarActionBadgeClasses() }>
				{ action.Badge }
			</span>
		}
	</div>
}

// Helper functions for navbar styling
func getNavbarClasses(sticky, transparent, border bool) string {
	base := "w-full z-20 top-0 left-0"
	
	var classes []string
	classes = append(classes, base)
	
	if sticky {
		classes = append(classes, "sticky")
	}
	
	if transparent {
		classes = append(classes, "bg-transparent")
	} else {
		classes = append(classes, "bg-gradient-to-r from-white to-gray-50 dark:bg-gray-900")
	}
	
	if border {
		classes = append(classes, "border-b border-gray-200 dark:border-gray-600")
	}
	
	return strings.Join(classes, " ")
}

func getNavbarContainerClasses(fluid bool) string {
	base := "flex flex-wrap items-center justify-between mx-auto p-4"
	
	if fluid {
		return base
	}
	return base + " max-w-screen-xl"
}

func getNavbarBrandClasses() string {
	return "flex items-center space-x-3 rtl:space-x-reverse"
}

func getNavbarLogoClasses() string {
	return "h-8"
}

func getNavbarBrandTextClasses() string {
	return "self-center text-2xl font-semibold whitespace-nowrap dark:text-white"
}

func getNavbarToggleClasses() string {
	return "inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
}

func getNavbarMenuClasses() string {
	return "items-center justify-between hidden w-full md:flex md:w-auto md:order-1"
}

func getNavbarListClasses() string {
	return "flex flex-col font-medium p-4 md:p-0 mt-4 border border-gray-100 rounded-lg bg-gray-50 md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0 md:bg-gradient-to-r from-white to-gray-50 dark:bg-gray-800 md:dark:bg-gray-900 dark:border-gray-700"
}

func getNavbarActionsClasses() string {
	return "flex items-center space-x-3 md:space-x-2 rtl:space-x-reverse"
}

func getNavbarLinkClasses(active, disabled bool) string {
	base := "block py-2 px-3 rounded md:p-0 transition-colors duration-200"
	
	if disabled {
		return base + " text-gray-400 cursor-not-allowed dark:text-gray-600"
	}
	
	if active {
		return base + " text-white bg-blue-700 md:bg-transparent md:text-blue-700 md:dark:text-blue-500"
	}
	
	return base + " text-gray-900 hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-700 dark:text-white md:dark:hover:text-blue-500 dark:hover:bg-gray-700 dark:hover:text-white md:dark:hover:bg-transparent"
}

func getNavbarDropdownClasses() string {
	return "absolute top-full left-0 z-10 font-normal bg-gradient-to-r from-white to-gray-50 divide-y divide-gray-100 rounded-lg shadow w-44 dark:bg-gray-700 dark:divide-gray-600"
}

func getNavbarDropdownItemClasses(disabled bool) string {
	base := "block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
	
	if disabled {
		return base + " text-gray-400 cursor-not-allowed dark:text-gray-600"
	}
	
	return base + " text-gray-700 dark:text-gray-200"
}

func getNavbarBadgeClasses() string {
	return "inline-flex items-center justify-center w-4 h-4 ml-2 text-xs font-semibold text-blue-800 bg-blue-200 rounded-full"
}

func getNavbarActionClasses(variant, size string) string {
	base := "inline-flex items-center justify-center font-medium rounded-lg transition-colors duration-200 focus:ring-4 focus:outline-none"
	
	// Size classes
	var sizeClass string
	switch size {
	case "xs":
		sizeClass = "px-2 py-1 text-xs"
	case "sm":
		sizeClass = "px-3 py-1.5 text-sm"
	case "lg":
		sizeClass = "px-4 py-2.5 text-sm"
	default: // base
		sizeClass = "px-4 py-2 text-sm"
	}
	
	// Variant classes
	var variantClass string
	switch variant {
	case "primary":
		variantClass = "text-white bg-blue-700 hover:bg-blue-800 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
	case "ghost":
		variantClass = "text-gray-500 hover:text-gray-900 hover:bg-gray-100 focus:ring-gray-300 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-700"
	default: // secondary
		variantClass = "text-gray-900 bg-gradient-to-r from-white to-gray-50 border border-gray-300 hover:bg-gray-100 focus:ring-blue-300 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700"
	}
	
	return strings.Join([]string{base, sizeClass, variantClass}, " ")
}

func getNavbarActionBadgeClasses() string {
	return "absolute -top-2 -right-2 inline-flex items-center justify-center w-6 h-6 text-xs font-bold text-white bg-red-500 border-2 border-white rounded-full dark:border-gray-900"
}

func getBrandHref(href string) string {
	if href != "" {
		return href
	}
	return "/"
}

// Navbar store initialization script for Alpine.js
templ NavbarStore() {
	<script>
		document.addEventListener('alpine:init', () => {
			Alpine.store('navbar', {
				mobileOpen: false,
				
				toggleMobile() {
					this.mobileOpen = !this.mobileOpen;
				},
				
				closeMobile() {
					this.mobileOpen = false;
				},
				
				openMobile() {
					this.mobileOpen = true;
				}
			});
		});
	</script>
}