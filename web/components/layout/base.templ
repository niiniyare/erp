package layout

import (
"context"
"github.com/niiniyare/erp/web/types"
)

// BaseLayout provides the main application layout with sidebar and navigation
templ BaseLayout(ctx context.Context, title string, user *types.UserInfo, sidebarItems []types.NavItem) {
<!DOCTYPE html>
<html lang="en" x-data="{ sidebarOpen: false }" x-init="initializeApp()">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#1f2937" />
  <title>{ title } - ERP System</title>

  <!-- Security Headers -->
  <meta http-equiv="Content-Security-Policy"
    content="default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" />
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta http-equiv="X-Frame-Options" content="DENY" />
  <meta http-equiv="X-XSS-Protection" content="1; mode=block" />
  <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
  <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=()" />

  <!-- Accessibility and Progressive Enhancement -->
  <meta name="description"
    content="Enterprise Resource Planning System - Manage your business operations efficiently" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- HTMX for partial page updates -->
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>

  <!-- Alpine.js for client-side reactivity -->
  <script src="https://unpkg.com/alpinejs@3.13.3/dist/cdn.min.js" defer></script>

  <!-- Flowbite CSS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.0/flowbite.min.css" rel="stylesheet" />

  <!-- Font Awesome for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Exciting Theme CSS -->
  <link rel="stylesheet" href="/styles/themes.css" />

  <!-- AlpineJS Hooks -->
  <script src="/hooks/datatable.js"></script>
  <script src="/hooks/modal.js"></script>
  <script src="/hooks/forms.js"></script>
  <script src="/hooks/navBar.js"></script>
  <script src="/hooks/breadCrumbs.js"></script>
  <script src="/hooks/app.js"></script>

  <!-- Accessibility CSS -->
  <style>
    /* Screen reader only content */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* Make sr-only content visible when focused */
    .sr-only:focus,
    .focus\:not-sr-only:focus {
      position: static;
      width: auto;
      height: auto;
      padding: inherit;
      margin: inherit;
      overflow: visible;
      clip: auto;
      white-space: normal;
    }

    /* High contrast mode support */
    @media (prefers-contrast: high) {
      .high-contrast {
        filter: contrast(2);
      }
    }

    /* Reduced motion support */
    @media (prefers-reduced-motion: reduce) {
      .respect-motion-preference * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Focus indicators */
    .focus-visible:focus-visible {
      outline: 2px solid #3b82f6;
      outline-offset: 2px;
    }

    /* Progressive enhancement */
    .no-js .js-only {
      display: none !important;
    }

    .js .no-js-only {
      display: none !important;
    }
  </style>

  <!-- Meta tags for HTMX -->
  <meta name="htmx-config" content='{"globalViewTransitions": true, "scrollBehavior": "smooth"}' />

  <!-- CSRF Token -->
  <meta name="csrf-token" content={ getCsrfToken() } />

  <!-- Security: Add nonce for inline scripts -->
  <meta name="script-nonce" content={ generateNonce() } />
</head>

<body class="bg-gray-50 no-js" hx-headers='{"X-CSRF-Token": document.querySelector("meta[name=csrf-token]").content}'>

  <!-- Progressive Enhancement: Add js class when JavaScript loads -->
  <script>document.body.classList.remove('no-js'); document.body.classList.add('js');</script>

  <!-- Skip Links for Accessibility -->
  <nav aria-label="Skip links" class="sr-only focus-within:not-sr-only">
    <a href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-blue-600 text-white px-4 py-2 rounded-md z-50 focus:outline-none focus:ring-2 focus:ring-white">
      Skip to main content
    </a>
    <a href="#sidebar-nav"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-blue-600 text-white px-4 py-2 rounded-md z-50 focus:outline-none focus:ring-2 focus:ring-white">
      Skip to navigation
    </a>
  </nav>

  <!-- Global Alpine.js stores initialization -->
  <script>
    document.addEventListener('alpine:init', () => {
      // Application state store
      Alpine.store('app', {
        sidebarOpen: false,
        theme: localStorage.getItem('theme') || 'light',
        notifications: [],
        user: @if user != nil {
          {
            id: '{ user.ID }',
              name: '{ user.Name }',
                email: '{ user.Email }',
                  role: '{ user.Role }',
                    tenantId: '{ user.TenantID }'
          }
        } else {null},
      permissions: [], // Will be populated by server-side data
        features: { }, // Will be populated by server-side feature flags
      config: {
        dateFormat: 'YYYY-MM-DD',
          currency: 'USD',
            timezone: 'UTC'
      },

      // Methods
      toggleSidebar() {
        this.sidebarOpen = !this.sidebarOpen;
      },

      addNotification(type, message, duration = 5000) {
        const id = Date.now();
        this.notifications.push({id, type, message});
        setTimeout(() => this.removeNotification(id), duration);
      },

      removeNotification(id) {
        this.notifications = this.notifications.filter(n => n.id !== id);
      },

      setTheme(theme) {
        this.theme = theme;
        localStorage.setItem('theme', theme);
        document.documentElement.setAttribute('data-theme', theme);
      },

      hasPermission(permission) {
        return this.permissions.includes(permission) || this.permissions.includes('*');
      },

      hasFeature(feature) {
        return this.features[feature] === true;
      }
    });

    // Enhanced error management store
    Alpine.store('errors', {
      errors: {},
      globalError: null,
      networkError: false,
      retryCount: {},
      maxRetries: 3,

      setError(context, field, message, type = 'validation') {
        if (!this.errors[context]) {
          this.errors[context] = {};
        }
        this.errors[context][field] = {
          message,
          type,
          timestamp: Date.now(),
          attempts: (this.retryCount[`${context}_${field}`] || 0) + 1
        };
      },

      clearError(context, field = null) {
        if (field) {
          if (this.errors[context]) {
            delete this.errors[context][field];
            delete this.retryCount[`${context}_${field}`];
          }
        } else {
          delete this.errors[context];
          // Clear retry counts for this context
          Object.keys(this.retryCount).forEach(key => {
            if (key.startsWith(context + '_')) {
              delete this.retryCount[key];
            }
          });
        }
      },

      clearAllErrors() {
        this.errors = {};
        this.globalError = null;
        this.networkError = false;
        this.retryCount = {};
      },

      hasErrors(context = null) {
        if (context) {
          return this.errors[context] && Object.keys(this.errors[context]).length > 0;
        }
        return Object.keys(this.errors).length > 0 || this.globalError !== null;
      },

      getError(context, field) {
        return this.errors[context]?.[field];
      },

      setGlobalError(message, type = 'error') {
        this.globalError = {message, type, timestamp: Date.now()};
      },

      setNetworkError(isError) {
        this.networkError = isError;
        if (isError) {
          this.setGlobalError('Network connection lost. Please check your internet connection.', 'network');
        } else if (this.globalError?.type === 'network') {
          this.globalError = null;
        }
      },

      canRetry(context, field) {
        const key = `${context}_${field}`;
        return (this.retryCount[key] || 0) < this.maxRetries;
      },

      incrementRetry(context, field) {
        const key = `${context}_${field}`;
        this.retryCount[key] = (this.retryCount[key] || 0) + 1;
      }
    });

    // Form state management store with enhanced error integration
    Alpine.store('forms', {
      drafts: {},
      validation: {},
      validating: {},
      submitting: {},

      saveDraft(formId, data) {
        try {
          this.drafts[formId] = {
            data,
            timestamp: Date.now()
          };
          localStorage.setItem(`draft_${formId}`, JSON.stringify(this.drafts[formId]));
          Alpine.store('errors').clearError('forms', `${formId}_draft`);
        } catch (error) {
          Alpine.store('errors').setError('forms', `${formId}_draft`, 'Failed to save draft');
        }
      },

      loadDraft(formId) {
        try {
          const stored = localStorage.getItem(`draft_${formId}`);
          if (stored) {
            this.drafts[formId] = JSON.parse(stored);
            return this.drafts[formId].data;
          }
          return null;
        } catch (error) {
          Alpine.store('errors').setError('forms', `${formId}_load`, 'Failed to load draft');
          return null;
        }
      },

      clearDraft(formId) {
        delete this.drafts[formId];
        localStorage.removeItem(`draft_${formId}`);
        Alpine.store('errors').clearError('forms', `${formId}_draft`);
      },

      setFieldValidation(form, field, isValid, message = '') {
        if (!this.validation[form]) {
          this.validation[form] = {};
        }
        this.validation[form][field] = {isValid, message};

        // Also update error store
        if (!isValid && message) {
          Alpine.store('errors').setError(form, field, message, 'validation');
        } else {
          Alpine.store('errors').clearError(form, field);
        }
      },

      setValidating(field, validating) {
        this.validating[field] = validating;
      },

      setSubmitting(formId, submitting) {
        this.submitting[formId] = submitting;
      },

      isSubmitting(formId) {
        return this.submitting[formId] || false;
      },

      hasValidationErrors(form) {
        return Alpine.store('errors').hasErrors(form);
      },

      getValidationError(form, field) {
        return Alpine.store('errors').getError(form, field);
      }
    });

    // Cache store for performance
    Alpine.store('cache', {
      data: {},
      timestamps: {},
      ttl: 5 * 60 * 1000, // 5 minutes

      set(key, value) {
        this.data[key] = value;
        this.timestamps[key] = Date.now();
      },

      get(key) {
        const timestamp = this.timestamps[key];
        if (!timestamp || (Date.now() - timestamp) > this.ttl) {
          delete this.data[key];
          delete this.timestamps[key];
          return null;
        }
        return this.data[key];
      },

      clear(pattern = null) {
        if (pattern) {
          Object.keys(this.data).forEach(key => {
            if (key.includes(pattern)) {
              delete this.data[key];
              delete this.timestamps[key];
            }
          });
        } else {
          this.data = {};
          this.timestamps = {};
        }
      }
    });
			});

    // Global utility functions
    function initializeApp() {
      // Sync state with server
      syncAppState();

      // Set up HTMX event listeners
      setupHTMXEvents();

      // Initialize theme
      const theme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', theme);
    }

    function syncAppState() {
      fetch('/api/app-state', {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name=csrf-token]').content
        }
      })
        .then(response => response.json())
        .then(data => {
          if (data.permissions) Alpine.store('app').permissions = data.permissions;
          if (data.features) Alpine.store('app').features = data.features;
          if (data.config) Alpine.store('app').config = {...Alpine.store('app').config, ...data.config};
        })
        .catch(error => console.error('Failed to sync app state:', error));
    }

    function setupHTMXEvents() {
      // Security: Validate HTMX requests
      document.body.addEventListener('htmx:beforeRequest', function (evt) {
        // Add rate limiting check
        if (!checkRateLimit()) {
          evt.preventDefault();
          Alpine.store('app').addNotification('error', 'Too many requests. Please slow down.');
          return;
        }

        // Validate CSRF token exists
        const csrfToken = document.querySelector('meta[name=csrf-token]')?.content;
        if (!csrfToken) {
          evt.preventDefault();
          Alpine.store('app').addNotification('error', 'Security token missing. Please refresh the page.');
          return;
        }

        document.body.style.cursor = 'progress';
      });

      // Handle HTMX success/error responses
      document.body.addEventListener('htmx:afterSwap', function (evt) {
        // Re-initialize Alpine components in swapped content
        if (evt.detail.target && typeof Alpine !== 'undefined') {
          Alpine.initTree(evt.detail.target);
        }
      });

      // Enhanced error handling
      document.body.addEventListener('htmx:responseError', function (evt) {
        const status = evt.detail.xhr.status;
        let message = 'An error occurred. Please try again.';

        switch (status) {
          case 401:
            message = 'Session expired. Please login again.';
            window.location.href = '/login';
            break;
          case 403:
            message = 'Access denied. You do not have permission.';
            break;
          case 429:
            message = 'Too many requests. Please wait before trying again.';
            break;
          case 500:
            message = 'Server error. Please contact support if this persists.';
            break;
        }

        Alpine.store('app').addNotification('error', message);
      });

      // Handle custom triggers for notifications
      document.body.addEventListener('htmx:afterRequest', function (evt) {
        document.body.style.cursor = 'default';

        const triggerHeader = evt.detail.xhr.getResponseHeader('HX-Trigger');
        if (triggerHeader) {
          try {
            const triggers = JSON.parse(triggerHeader);
            if (triggers.showNotification) {
              Alpine.store('app').addNotification(
                triggers.showNotification.type,
                triggers.showNotification.message
              );
            }
            if (triggers.refreshCSRF) {
              // Refresh CSRF token
              refreshCSRFToken();
            }
          } catch (e) {
            console.error('Error parsing HX-Trigger header:', e);
          }
        }
      });
    }

    // Rate limiting implementation
    let requestCount = 0;
    let requestWindow = Date.now();

    function checkRateLimit() {
      const now = Date.now();
      const windowDuration = 60000; // 1 minute
      const maxRequests = 100; // Max requests per minute

      if (now - requestWindow > windowDuration) {
        requestCount = 0;
        requestWindow = now;
      }

      requestCount++;
      return requestCount <= maxRequests;
    }

    // CSRF token refresh
    function refreshCSRFToken() {
      fetch('/api/csrf-token', {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json'
        }
      })
        .then(response => response.json())
        .then(data => {
          if (data.token) {
            document.querySelector('meta[name=csrf-token]').content = data.token;
          }
        })
        .catch(error => console.error('Failed to refresh CSRF token:', error));
    }

    // Global modal functions
    function closeModal() {
      document.getElementById('modal-container').innerHTML = '';
    }

    function showNotification(type, message) {
      Alpine.store('app').addNotification(type, message);
    }
  </script>

  <!-- Sidebar -->
  @Sidebar(ctx, sidebarItems, user)

  <!-- Main Content Area -->
  <div class="p-4 sm:ml-64">
    <main class="p-4 border-2 border-gray-200 border-dashed rounded-lg" id="main-content" role="main"
      aria-label="Main content">
      { children... }
    </main>
  </div>

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-5 right-5 z-50" x-data>
    <template x-for="notification in $store.app.notifications" :key="notification.id">
      <div x-show="true" x-transition:enter="transform ease-out duration-300 transition"
        x-transition:enter-start="translate-y-2 opacity-0 sm:translate-y-0 sm:translate-x-2"
        x-transition:enter-end="translate-y-0 opacity-100 sm:translate-x-0"
        x-transition:leave="transition ease-in duration-100" x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0" :class="{
						'bg-green-500': notification.type === 'success',
						'bg-red-500': notification.type === 'error',
						'bg-yellow-500': notification.type === 'warning',
						'bg-blue-500': notification.type === 'info'
					}"
        class="mb-4 max-w-sm w-full text-white shadow-lg rounded-lg pointer-events-auto ring-1 ring-black ring-opacity-5 overflow-hidden">
        <div class="p-4">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <i :class="{
									'fas fa-check-circle': notification.type === 'success',
									'fas fa-exclamation-triangle': notification.type === 'error',
									'fas fa-exclamation-circle': notification.type === 'warning',
									'fas fa-info-circle': notification.type === 'info'
								}" class="h-5 w-5"></i>
            </div>
            <div class="ml-3 w-0 flex-1 pt-0.5">
              <p class="text-sm font-medium" x-text="notification.message"></p>
            </div>
            <div class="ml-4 flex-shrink-0 flex">
              <button @click="$store.app.removeNotification(notification.id)"
                class="text-white hover:text-gray-200 focus:outline-none">
                <i class="fas fa-times h-4 w-4"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- Modal Container -->
  <div id="modal-container" class="relative z-50"></div>

  <!-- Global Loading Indicator -->
  <div id="global-loading" class="fixed inset-0 bg-gray-600 bg-opacity-50 z-50 hidden" x-show="$store.app.loading"
    x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
    x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
    <div class="flex items-center justify-center min-h-screen">
      <div class="bg-white p-4 rounded-lg shadow-lg">
        <div class="flex items-center space-x-3">
          <svg class="animate-spin h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
            </path>
          </svg>
          <span class="text-gray-700">Loading...</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Flowbite JS -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.0/flowbite.min.js"></script>
</body>

</html>
}

// Helper function to get CSRF token (to be implemented in context)
func getCsrfToken() string {
// NOTE:This will be implemented to get CSRF token from context
return ""
}

// Helper function to generate nonce for CSP (to be implemented)
func generateNonce() string {
// NOTE:This will be implemented to generate cryptographic nonce
return ""
}
