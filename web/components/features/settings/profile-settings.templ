package settings

import (
	"github.com/niiniyare/erp/web/components/atoms"
	"github.com/niiniyare/erp/web/components/molecules"
)

// ProfileSettingsProps defines properties for profile settings
type ProfileSettingsProps struct {
	UserID      string            `json:"userId"`
	User        ProfileUser       `json:"user"`
	Errors      map[string]string `json:"errors,omitempty"`
	Success     bool              `json:"success,omitempty"`
	HxPost      string            `json:"hxPost,omitempty"`
	HxTarget    string            `json:"hxTarget,omitempty"`
	CanEdit     bool              `json:"canEdit"`
	CanUpload   bool              `json:"canUpload"`
}

// ProfileUser represents user profile data
type ProfileUser struct {
	Name        string `json:"name"`
	Email       string `json:"email"`
	Phone       string `json:"phone,omitempty"`
	Avatar      string `json:"avatar,omitempty"`
	Title       string `json:"title,omitempty"`
	Department  string `json:"department,omitempty"`
	Location    string `json:"location,omitempty"`
	Timezone    string `json:"timezone,omitempty"`
	Language    string `json:"language,omitempty"`
	DateFormat  string `json:"dateFormat,omitempty"`
	TimeFormat  string `json:"timeFormat,omitempty"`
}

// ProfileSettings renders the profile settings form
templ ProfileSettings(props ProfileSettingsProps) {
	<div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
		<!-- Header -->
		<div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
			<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
				Profile Settings
			</h3>
			<p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
				Update your personal information and preferences
			</p>
		</div>

		<!-- Form Content -->
		<form 
			class="p-6 space-y-6"
			if props.HxPost != "" {
				hx-post={ props.HxPost }
			}
			if props.HxTarget != "" {
				hx-target={ props.HxTarget }
			}
			hx-swap="innerHTML"
			hx-indicator="#profile-loading"
		>
			<!-- Success Message -->
			if props.Success {
				<div class="rounded-md bg-green-50 dark:bg-green-900/50 p-4">
					<div class="text-sm text-green-700 dark:text-green-200">
						Profile updated successfully!
					</div>
				</div>
			}

			<!-- Avatar Section -->
			if props.CanUpload {
				<div class="flex items-center space-x-6">
					<div class="flex-shrink-0">
						<img 
							class="h-20 w-20 rounded-full object-cover ring-4 ring-white dark:ring-gray-800"
							src={ getAvatarUrl(props.User.Avatar) }
							alt={ props.User.Name }
						/>
					</div>
					<div>
						<h4 class="text-sm font-medium text-gray-900 dark:text-white">
							Profile Photo
						</h4>
						<p class="text-sm text-gray-600 dark:text-gray-400">
							Update your profile photo
						</p>
						<div class="mt-2 flex space-x-3">
							@atoms.Button(atoms.ButtonProps{
								Text:    "Change",
								Variant: atoms.VariantSecondary,
								Size:    atoms.SizeSM,
								OnClick: "openAvatarUpload()",
							})
							if props.User.Avatar != "" {
								@atoms.Button(atoms.ButtonProps{
									Text:    "Remove",
									Variant: atoms.ButtonLight,
									Size:    atoms.SizeSM,
									OnClick: "removeAvatar()",
								})
							}
						</div>
					</div>
				</div>
			}

			<!-- Basic Information -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<!-- Full Name -->
				<div>
					@molecules.Field(molecules.FieldProps{
						Type:        molecules.FieldTypeInput,
						Label:       "Full Name",
						Name:        "name",
						Value:       props.User.Name,
						Placeholder: "Enter your full name",
						Required:    true,
						InputType:   atoms.InputText,
						ID:          "name",
						ErrorText:   getFieldError(props.Errors, "name"),
						ReadOnly:    !props.CanEdit,
					})
				</div>

				<!-- Email -->
				<div>
					@molecules.Field(molecules.FieldProps{
						Type:        molecules.FieldTypeInput,
						Label:       "Email Address",
						Name:        "email",
						Value:       props.User.Email,
						Placeholder: "Enter your email",
						Required:    true,
						InputType:   atoms.InputEmail,
						ID:          "email",
						ErrorText:   getFieldError(props.Errors, "email"),
						ReadOnly:    !props.CanEdit,
					})
				</div>

				<!-- Phone -->
				<div>
					@molecules.Field(molecules.FieldProps{
						Type:        molecules.FieldTypeInput,
						Label:       "Phone Number",
						Name:        "phone",
						Value:       props.User.Phone,
						Placeholder: "Enter your phone number",
						InputType:   atoms.InputTel,
						ID:          "phone",
						ErrorText:   getFieldError(props.Errors, "phone"),
						ReadOnly:    !props.CanEdit,
					})
				</div>

				<!-- Job Title -->
				<div>
					@molecules.Field(molecules.FieldProps{
						Type:        molecules.FieldTypeInput,
						Label:       "Job Title",
						Name:        "title",
						Value:       props.User.Title,
						Placeholder: "Enter your job title",
						InputType:   atoms.InputText,
						ID:          "title",
						ErrorText:   getFieldError(props.Errors, "title"),
						ReadOnly:    !props.CanEdit,
					})
				</div>
			</div>

			<!-- Preferences Section -->
			<div class="pt-6 border-t border-gray-200 dark:border-gray-700">
				<h4 class="text-lg font-medium text-gray-900 dark:text-white mb-4">
					Preferences
				</h4>
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<!-- Timezone -->
					<div>
						@molecules.Field(molecules.FieldProps{
							Type:        molecules.FieldTypeSelect,
							Label:       "Timezone",
							Name:        "timezone",
							Value:       props.User.Timezone,
							Options:     getTimezoneOptions(),
							ID:          "timezone",
							ErrorText:   getFieldError(props.Errors, "timezone"),
							Disabled:    !props.CanEdit,
						})
					</div>

					<!-- Language -->
					<div>
						@molecules.Field(molecules.FieldProps{
							Type:        molecules.FieldTypeSelect,
							Label:       "Language",
							Name:        "language",
							Value:       props.User.Language,
							Options:     getLanguageOptions(),
							ID:          "language",
							ErrorText:   getFieldError(props.Errors, "language"),
							Disabled:    !props.CanEdit,
						})
					</div>

					<!-- Date Format -->
					<div>
						@molecules.Field(molecules.FieldProps{
							Type:        molecules.FieldTypeSelect,
							Label:       "Date Format",
							Name:        "date_format",
							Value:       props.User.DateFormat,
							Options:     getDateFormatOptions(),
							ID:          "date_format",
							ErrorText:   getFieldError(props.Errors, "date_format"),
							Disabled:    !props.CanEdit,
						})
					</div>

					<!-- Time Format -->
					<div>
						@molecules.Field(molecules.FieldProps{
							Type:        molecules.FieldTypeSelect,
							Label:       "Time Format",
							Name:        "time_format",
							Value:       props.User.TimeFormat,
							Options:     getTimeFormatOptions(),
							ID:          "time_format",
							ErrorText:   getFieldError(props.Errors, "time_format"),
							Disabled:    !props.CanEdit,
						})
					</div>
				</div>
			</div>

			<!-- Form Actions -->
			if props.CanEdit {
				<div class="flex justify-end space-x-3 pt-6 border-t border-gray-200 dark:border-gray-700">
					@atoms.Button(atoms.ButtonProps{
						Text:    "Cancel",
						Variant: atoms.ButtonLight,
						OnClick: "resetForm()",
					})
					@atoms.Button(atoms.ButtonProps{
						Text:    "Save Changes",
						Type:    "submit",
						Variant: atoms.ButtonPrimary,
						Icon:    "save",
					})
				</div>
			}

			<!-- Loading Indicator -->
			<div id="profile-loading" class="htmx-indicator">
				<div class="flex items-center justify-center">
					@atoms.Spinner(atoms.SpinnerProps{
						Size:  atoms.SpinnerSizeSM,
						Color: "blue",
					})
					<span class="ml-2 text-sm text-gray-600 dark:text-gray-400">
						Updating profile...
					</span>
				</div>
			</div>
		</form>
	</div>
}

// Helper functions
func getFieldError(errors map[string]string, field string) string {
	if errors == nil {
		return ""
	}
	return errors[field]
}

func getAvatarUrl(avatar string) string {
	if avatar == "" {
		return "/static/img/default-avatar.svg"
	}
	return avatar
}

func getTimezoneOptions() []atoms.SelectOption {
	return []atoms.SelectOption{
		{Value: "UTC", Label: "UTC"},
		{Value: "America/New_York", Label: "Eastern Time"},
		{Value: "America/Chicago", Label: "Central Time"},
		{Value: "America/Denver", Label: "Mountain Time"},
		{Value: "America/Los_Angeles", Label: "Pacific Time"},
		{Value: "Europe/London", Label: "London"},
		{Value: "Europe/Paris", Label: "Paris"},
		{Value: "Asia/Tokyo", Label: "Tokyo"},
		{Value: "Australia/Sydney", Label: "Sydney"},
	}
}

func getLanguageOptions() []atoms.SelectOption {
	return []atoms.SelectOption{
		{Value: "en", Label: "English"},
		{Value: "es", Label: "Spanish"},
		{Value: "fr", Label: "French"},
		{Value: "de", Label: "German"},
		{Value: "it", Label: "Italian"},
		{Value: "pt", Label: "Portuguese"},
		{Value: "ja", Label: "Japanese"},
		{Value: "ko", Label: "Korean"},
		{Value: "zh", Label: "Chinese"},
	}
}

func getDateFormatOptions() []atoms.SelectOption {
	return []atoms.SelectOption{
		{Value: "MM/DD/YYYY", Label: "MM/DD/YYYY (US)"},
		{Value: "DD/MM/YYYY", Label: "DD/MM/YYYY (UK)"},
		{Value: "YYYY-MM-DD", Label: "YYYY-MM-DD (ISO)"},
		{Value: "DD.MM.YYYY", Label: "DD.MM.YYYY (DE)"},
		{Value: "DD-MM-YYYY", Label: "DD-MM-YYYY"},
	}
}

func getTimeFormatOptions() []atoms.SelectOption {
	return []atoms.SelectOption{
		{Value: "12", Label: "12-hour (AM/PM)"},
		{Value: "24", Label: "24-hour"},
	}
}