package settings

import (
	"github.com/niiniyare/erp/web/components/atoms"
	"github.com/niiniyare/erp/web/components/molecules"
)

// SecuritySettingsProps defines properties for the security settings component
type SecuritySettingsProps struct {
	Title       string            `json:"title"`
	Subtitle    string            `json:"subtitle,omitempty"`
	Errors      map[string]string `json:"errors,omitempty"`
	
	// Current security settings
	TwoFactorEnabled bool   `json:"twoFactorEnabled"`
	LastLogin        string `json:"lastLogin,omitempty"`
	LoginAttempts    int    `json:"loginAttempts"`
	
	// Session management
	ActiveSessions   []SessionInfo `json:"activeSessions,omitempty"`
	
	// Security preferences
	SessionTimeout   int  `json:"sessionTimeout"`   // Minutes
	EmailOnLogin     bool `json:"emailOnLogin"`
	EmailOnNewDevice bool `json:"emailOnNewDevice"`
	
	// Form handling
	HxPost   string `json:"hxPost,omitempty"`
	HxTarget string `json:"hxTarget,omitempty"`
}

// SessionInfo represents an active user session
type SessionInfo struct {
	ID         string `json:"id"`
	Device     string `json:"device"`
	Location   string `json:"location,omitempty"`
	LastActive string `json:"lastActive"`
	Current    bool   `json:"current"`
	IPAddress  string `json:"ipAddress,omitempty"`
}

// SecuritySettings renders a comprehensive security settings form
templ SecuritySettings(props SecuritySettingsProps) {
	<div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg">
		<!-- Header -->
		<div class="p-6 border-b border-gray-200 dark:border-gray-700">
			<h3 class="text-lg font-medium text-gray-900 dark:text-white">
				{ getSecurityTitle(props.Title) }
			</h3>
			if props.Subtitle != "" {
				<p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
					{ props.Subtitle }
				</p>
			}
		</div>
		
		<!-- Content -->
		<div class="p-6 space-y-8">
			<!-- Password Section -->
			<div>
				<h4 class="text-base font-medium text-gray-900 dark:text-white mb-4">
					Password & Authentication
				</h4>
				
				<form 
					class="space-y-4"
					if props.HxPost != "" {
						hx-post={ props.HxPost }
					}
					if props.HxTarget != "" {
						hx-target={ props.HxTarget }
					}
					hx-swap="outerHTML"
				>
					<input type="hidden" name="action" value="change_password" />
					
					<!-- Current Password -->
					<div>
						@molecules.Field(molecules.FieldProps{
							Type:        molecules.FieldTypeInput,
							Label:       "Current Password",
							Name:        "current_password",
							Placeholder: "Enter your current password",
							Required:    true,
							InputType:   atoms.InputPassword,
							ID:          "current_password",
							ErrorText:   getFieldError(props.Errors, "current_password"),
							Class:       "w-full",
						})
					</div>
					
					<!-- New Password -->
					<div>
						@molecules.Field(molecules.FieldProps{
							Type:        molecules.FieldTypeInput,
							Label:       "New Password",
							Name:        "new_password",
							Placeholder: "Enter a strong new password",
							Required:    true,
							InputType:   atoms.InputPassword,
							ID:          "new_password",
							ErrorText:   getFieldError(props.Errors, "new_password"),
							HelpText:    "Minimum 8 characters with mixed case, numbers, and symbols",
							Class:       "w-full",
						})
					</div>
					
					<!-- Confirm New Password -->
					<div>
						@molecules.Field(molecules.FieldProps{
							Type:        molecules.FieldTypeInput,
							Label:       "Confirm New Password",
							Name:        "confirm_password",
							Placeholder: "Confirm your new password",
							Required:    true,
							InputType:   atoms.InputPassword,
							ID:          "confirm_password",
							ErrorText:   getFieldError(props.Errors, "confirm_password"),
							Class:       "w-full",
						})
					</div>
					
					<div class="flex justify-end">
						@atoms.Button(atoms.ButtonProps{
							Text:    "Update Password",
							Type:    "submit",
							Variant: atoms.ButtonPrimary,
							Size:    atoms.ButtonSizeMD,
						})
					</div>
				</form>
			</div>
			
			<!-- Two-Factor Authentication -->
			<div class="border-t border-gray-200 dark:border-gray-700 pt-8">
				<h4 class="text-base font-medium text-gray-900 dark:text-white mb-4">
					Two-Factor Authentication
				</h4>
				
				<div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-700 rounded-lg">
					<div>
						<div class="flex items-center space-x-2">
							@atoms.Icon(atoms.IconProps{
								Name:  getTwoFactorIcon(props.TwoFactorEnabled),
								Size:  atoms.IconSizeSM,
								Class: getTwoFactorIconColor(props.TwoFactorEnabled),
							})
							<span class="font-medium text-gray-900 dark:text-white">
								Two-Factor Authentication
							</span>
						</div>
						<p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
							{ getTwoFactorDescription(props.TwoFactorEnabled) }
						</p>
					</div>
					
					<div>
						if props.TwoFactorEnabled {
							@atoms.Button(atoms.ButtonProps{
								Text:    "Disable",
								Variant: atoms.ButtonSecondary,
								Size:    atoms.ButtonSizeSM,
								HxPost:  "/settings/security/2fa/disable",
								HxTarget: "#security-settings",
							})
						} else {
							@atoms.Button(atoms.ButtonProps{
								Text:    "Enable",
								Variant: atoms.ButtonPrimary,
								Size:    atoms.ButtonSizeSM,
								HxGet:   "/settings/security/2fa/setup",
								HxTarget: "#main-modal",
							})
						}
					</div>
				</div>
			</div>
			
			<!-- Security Preferences -->
			<div class="border-t border-gray-200 dark:border-gray-700 pt-8">
				<h4 class="text-base font-medium text-gray-900 dark:text-white mb-4">
					Security Preferences
				</h4>
				
				<form 
					class="space-y-4"
					hx-post="/settings/security/preferences"
					hx-target="#security-settings"
					hx-swap="outerHTML"
				>
					<!-- Session Timeout -->
					<div>
						@molecules.Field(molecules.FieldProps{
							Type:        molecules.FieldTypeSelect,
							Label:       "Session Timeout",
							Name:        "session_timeout",
							Required:    true,
							ID:          "session_timeout",
							Value:       getSessionTimeoutValue(props.SessionTimeout),
							Options: []atoms.SelectOption{
								{Value: "30", Label: "30 minutes"},
								{Value: "60", Label: "1 hour"},
								{Value: "120", Label: "2 hours"},
								{Value: "240", Label: "4 hours"},
								{Value: "480", Label: "8 hours"},
							},
							HelpText: "How long you stay logged in when inactive",
							Class:    "w-full",
						})
					</div>
					
					<!-- Email Notifications -->
					<div class="space-y-3">
						<div class="flex items-center justify-between">
							<div>
								<label class="text-sm font-medium text-gray-900 dark:text-white">
									Email on Login
								</label>
								<p class="text-sm text-gray-600 dark:text-gray-400">
									Get notified when someone signs into your account
								</p>
							</div>
							@atoms.Toggle(atoms.ToggleProps{
								Name:    "email_on_login",
								ID:      "email_on_login",
								Checked: props.EmailOnLogin,
							})
						</div>
						
						<div class="flex items-center justify-between">
							<div>
								<label class="text-sm font-medium text-gray-900 dark:text-white">
									Email on New Device
								</label>
								<p class="text-sm text-gray-600 dark:text-gray-400">
									Get notified when your account is accessed from a new device
								</p>
							</div>
							@atoms.Toggle(atoms.ToggleProps{
								Name:    "email_on_new_device",
								ID:      "email_on_new_device",
								Checked: props.EmailOnNewDevice,
							})
						</div>
					</div>
					
					<div class="flex justify-end">
						@atoms.Button(atoms.ButtonProps{
							Text:    "Save Preferences",
							Type:    "submit",
							Variant: atoms.ButtonPrimary,
							Size:    atoms.ButtonSizeMD,
						})
					</div>
				</form>
			</div>
			
			<!-- Active Sessions -->
			if len(props.ActiveSessions) > 0 {
				<div class="border-t border-gray-200 dark:border-gray-700 pt-8">
					<div class="flex items-center justify-between mb-4">
						<h4 class="text-base font-medium text-gray-900 dark:text-white">
							Active Sessions
						</h4>
						<button 
							type="button"
							class="text-sm text-red-600 hover:text-red-500 dark:text-red-400"
							hx-post="/settings/security/sessions/revoke-all"
							hx-target="#security-settings"
							hx-confirm="Are you sure you want to sign out of all other devices?"
						>
							Sign out all devices
						</button>
					</div>
					
					<div class="space-y-3">
						for _, session := range props.ActiveSessions {
							@SessionItem(session)
						}
					</div>
				</div>
			}
			
			<!-- Login History -->
			<div class="border-t border-gray-200 dark:border-gray-700 pt-8">
				<h4 class="text-base font-medium text-gray-900 dark:text-white mb-4">
					Login History
				</h4>
				
				<div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-4">
					<div class="flex items-center justify-between">
						<div>
							<p class="text-sm font-medium text-gray-900 dark:text-white">
								Last Login
							</p>
							<p class="text-sm text-gray-600 dark:text-gray-400">
								{ getLastLoginText(props.LastLogin) }
							</p>
						</div>
						
						<div>
							<p class="text-sm font-medium text-gray-900 dark:text-white">
								Failed Attempts
							</p>
							<p class="text-sm text-gray-600 dark:text-gray-400">
								{ getLoginAttemptsText(props.LoginAttempts) }
							</p>
						</div>
						
						<div>
							@atoms.Button(atoms.ButtonProps{
								Text:    "View Full History",
								Variant: atoms.ButtonSecondary,
								Size:    atoms.ButtonSizeSM,
								HxGet:   "/settings/security/login-history",
								HxTarget: "#main-modal",
							})
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// SessionItem renders a single active session
templ SessionItem(session SessionInfo) {
	<div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-700 rounded-lg">
		<div class="flex items-center space-x-3">
			<div class="flex-shrink-0">
				@atoms.Icon(atoms.IconProps{
					Name:  getDeviceIcon(session.Device),
					Size:  atoms.IconSizeMD,
					Class: "text-gray-600 dark:text-gray-400",
				})
			</div>
			
			<div>
				<div class="flex items-center space-x-2">
					<p class="text-sm font-medium text-gray-900 dark:text-white">
						{ session.Device }
					</p>
					if session.Current {
						<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">
							Current
						</span>
					}
				</div>
				
				<div class="text-xs text-gray-600 dark:text-gray-400 space-x-2">
					if session.Location != "" {
						<span>{ session.Location }</span>
						<span>•</span>
					}
					if session.IPAddress != "" {
						<span>{ session.IPAddress }</span>
						<span>•</span>
					}
					<span>Active { session.LastActive }</span>
				</div>
			</div>
		</div>
		
		if !session.Current {
			<button 
				type="button"
				class="text-sm text-red-600 hover:text-red-500 dark:text-red-400"
				hx-delete={ "/settings/security/sessions/" + session.ID }
				hx-target="#security-settings"
				hx-confirm="Sign out this device?"
			>
				Sign out
			</button>
		}
	</div>
}

// Helper functions
func getSecurityTitle(title string) string {
	if title == "" {
		return "Security Settings"
	}
	return title
}

func getTwoFactorIcon(enabled bool) string {
	if enabled {
		return "shield-check"
	}
	return "shield-exclamation"
}

func getTwoFactorIconColor(enabled bool) string {
	if enabled {
		return "text-green-600 dark:text-green-400"
	}
	return "text-yellow-600 dark:text-yellow-400"
}

func getTwoFactorDescription(enabled bool) string {
	if enabled {
		return "Two-factor authentication is enabled and protecting your account"
	}
	return "Add an extra layer of security to your account"
}

func getSessionTimeoutValue(timeout int) string {
	if timeout == 0 {
		return "60" // Default to 1 hour
	}
	return toString(timeout)
}

func getDeviceIcon(device string) string {
	// Simple device detection based on device string
	switch {
	case contains(device, "Mobile"), contains(device, "iPhone"), contains(device, "Android"):
		return "device-phone-mobile"
	case contains(device, "iPad"), contains(device, "Tablet"):
		return "device-tablet"
	default:
		return "computer-desktop"
	}
}

func getLastLoginText(lastLogin string) string {
	if lastLogin == "" {
		return "Unknown"
	}
	return lastLogin
}

func getLoginAttemptsText(attempts int) string {
	if attempts == 0 {
		return "None recent"
	}
	return toString(attempts) + " recent"
}


// Helper functions for string operations
func toString(i int) string {
	// NOTE: This should be replaced with proper integer to string conversion
	// when a formatting utility is available
	switch i {
	case 0: return "0"
	case 1: return "1"
	case 2: return "2"
	case 3: return "3"
	case 4: return "4"
	case 5: return "5"
	case 30: return "30"
	case 60: return "60"
	case 120: return "120"
	case 240: return "240"
	case 480: return "480"
	default: return "unknown"
	}
}

func contains(s, substr string) bool {
	// NOTE: This should be replaced with proper string contains function
	// when a string utility is available
	return false // Placeholder implementation
}