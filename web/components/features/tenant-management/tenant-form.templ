package tenant_management

import (
	"github.com/niiniyare/erp/web/components/atoms"
	"github.com/niiniyare/erp/web/components/molecules"
)

// TenantFormProps defines properties for tenant creation/editing forms
type TenantFormProps struct {
	// Form mode
	Mode string `json:"mode"` // "create", "edit", "view"
	
	// Tenant data
	Tenant *TenantFormData `json:"tenant,omitempty"`
	
	// Form configuration
	ShowHeader    bool   `json:"showHeader"`
	HeaderTitle   string `json:"headerTitle,omitempty"`
	HeaderSubtitle string `json:"headerSubtitle,omitempty"`
	
	// Form behavior
	SubmitUrl    string `json:"submitUrl"`
	CancelUrl    string `json:"cancelUrl,omitempty"`
	SubmitText   string `json:"submitText,omitempty"`
	CancelText   string `json:"cancelText,omitempty"`
	
	// Validation
	Errors       map[string]string `json:"errors,omitempty"`
	ShowRequired bool              `json:"showRequired"`
	
	// Field visibility and configuration
	Fields       TenantFormFields `json:"fields"`
	
	// UI state
	ID         string `json:"id,omitempty"`
	Class      string `json:"class,omitempty"`
	IsLoading  bool   `json:"isLoading"`
	IsReadonly bool   `json:"isReadonly"`
	
	// Additional configuration
	EnableAutosave   bool   `json:"enableAutosave"`
	AutosaveInterval int    `json:"autosaveInterval,omitempty"` // in seconds
	ShowProgress     bool   `json:"showProgress"`
	Progress         int    `json:"progress,omitempty"` // 0-100
}

// TenantFormData represents tenant form data
type TenantFormData struct {
	ID           string                 `json:"id,omitempty"`
	Slug         string                 `json:"slug"`
	Name         string                 `json:"name"`
	Email        string                 `json:"email"`
	Subdomain    string                 `json:"subdomain,omitempty"`
	Status       string                 `json:"status,omitempty"`
	Timezone     string                 `json:"timezone"`
	CurrencyCode string                 `json:"currency_code"`
	Industry     string                 `json:"industry,omitempty"`
	CompanySize  string                 `json:"company_size,omitempty"`
	Description  string                 `json:"description,omitempty"`
	Website      string                 `json:"website,omitempty"`
	Phone        string                 `json:"phone,omitempty"`
	Address      TenantAddress          `json:"address,omitempty"`
	Billing      TenantBilling          `json:"billing,omitempty"`
	Settings     TenantSettings         `json:"settings,omitempty"`
	Metadata     map[string]interface{} `json:"metadata,omitempty"`
}

// TenantAddress represents tenant address information
type TenantAddress struct {
	Street     string `json:"street,omitempty"`
	City       string `json:"city,omitempty"`
	State      string `json:"state,omitempty"`
	PostalCode string `json:"postal_code,omitempty"`
	Country    string `json:"country,omitempty"`
}

// TenantBilling represents tenant billing information
type TenantBilling struct {
	PlanID          string `json:"plan_id,omitempty"`
	BillingCycle    string `json:"billing_cycle,omitempty"` // monthly, annually
	PaymentMethod   string `json:"payment_method,omitempty"`
	NextBillingDate string `json:"next_billing_date,omitempty"`
}

// TenantSettings represents tenant configuration settings
type TenantSettings struct {
	AllowSignup           bool `json:"allow_signup"`
	RequireEmailVerification bool `json:"require_email_verification"`
	EnableSSO             bool `json:"enable_sso"`
	EnableAPI             bool `json:"enable_api"`
	MaxUsers              int  `json:"max_users,omitempty"`
	MaxStorage            int64 `json:"max_storage,omitempty"` // in bytes
}

// TenantFormFields defines which fields to show and their configuration
type TenantFormFields struct {
	// Basic Info
	ShowSlug        bool `json:"showSlug"`
	ShowSubdomain   bool `json:"showSubdomain"`
	ShowDescription bool `json:"showDescription"`
	ShowWebsite     bool `json:"showWebsite"`
	ShowPhone       bool `json:"showPhone"`
	
	// Address
	ShowAddress bool `json:"showAddress"`
	
	// Billing
	ShowBilling bool `json:"showBilling"`
	
	// Settings
	ShowSettings bool `json:"showSettings"`
	
	// Advanced
	ShowMetadata bool `json:"showMetadata"`
	ShowStatus   bool `json:"showStatus"`
}

// TenantForm renders a comprehensive tenant form for create/edit/view
templ TenantForm(props TenantFormProps) {
	<div 
		class={ "tenant-form-container", props.Class }
		if props.ID != "" {
			id={ props.ID }
		}
		x-data="tenantForm()"
		x-init="init()"
	>
		<!-- Form Header -->
		if props.ShowHeader {
			@TenantFormHeader(props)
		}
		
		<!-- Progress Bar -->
		if props.ShowProgress {
			@TenantFormProgress(props.Progress)
		}
		
		<!-- Form -->
		<form
			hx-post={ props.SubmitUrl }
			hx-target="#modal-container"
			hx-swap="innerHTML"
			hx-indicator="#tenant-form-loading"
			class="space-y-6"
			x-ref="form"
			@submit.prevent="submitForm()"
		>
			<!-- Loading Indicator -->
			<div 
				class="htmx-indicator absolute inset-0 bg-white/75 dark:bg-gray-800/75 z-10 flex items-center justify-center rounded-lg"
				id="tenant-form-loading"
			>
				@atoms.Spinner(atoms.SpinnerProps{
					Size: atoms.SpinnerSizeLG,
					Class: "text-blue-600",
				})
			</div>
			
			<!-- Error Summary -->
			if len(props.Errors) > 0 {
				@TenantFormErrorSummary(props.Errors)
			}
			
			<!-- Basic Information Section -->
			@TenantFormBasicSection(props)
			
			<!-- Address Section -->
			if props.Fields.ShowAddress {
				@TenantFormAddressSection(props)
			}
			
			<!-- Billing Section -->
			if props.Fields.ShowBilling && props.Mode != "create" {
				@TenantFormBillingSection(props)
			}
			
			<!-- Settings Section -->
			if props.Fields.ShowSettings {
				@TenantFormSettingsSection(props)
			}
			
			<!-- Metadata Section -->
			if props.Fields.ShowMetadata && props.Mode == "edit" {
				@TenantFormMetadataSection(props)
			}
			
			<!-- Form Actions -->
			if !props.IsReadonly {
				@TenantFormActions(props)
			}
		</form>
		
		<!-- Autosave Status -->
		if props.EnableAutosave && !props.IsReadonly {
			@TenantFormAutosaveStatus()
		}
	</div>
}

// TenantFormHeader renders the form header
templ TenantFormHeader(props TenantFormProps) {
	<div class="border-b border-gray-200 dark:border-gray-700 pb-6 mb-6">
		<div class="flex items-center justify-between">
			<div>
				<h2 class="text-xl font-semibold text-gray-900 dark:text-white">
					{ getTenantFormTitle(props) }
				</h2>
				if props.HeaderSubtitle != "" {
					<p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
						{ props.HeaderSubtitle }
					</p>
				}
			</div>
			
			<!-- Mode Badge -->
			<div class="flex items-center space-x-2">
				@TenantFormModeBadge(props.Mode)
				
				if props.Tenant != nil && props.Tenant.Status != "" {
					@TenantStatusBadge(props.Tenant.Status)
				}
			</div>
		</div>
	</div>
}

// TenantFormProgress renders a progress bar
templ TenantFormProgress(progress int) {
	<div class="mb-6">
		<div class="flex items-center justify-between text-sm text-gray-600 dark:text-gray-400 mb-2">
			<span>Form completion</span>
			<span>{ formatNumber(progress) }%</span>
		</div>
		<div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
			<div 
				class="bg-blue-600 h-2 rounded-full transition-all duration-300"
				style={ "width: " + formatNumber(progress) + "%" }
			></div>
		</div>
	</div>
}

// TenantFormErrorSummary renders form validation errors
templ TenantFormErrorSummary(errors map[string]string) {
	<div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-6">
		<div class="flex items-start">
			<div class="flex-shrink-0">
				@atoms.Icon(atoms.IconProps{
					Name:  "exclamation-circle",
					Size:  atoms.IconSizeSM,
					Class: "text-red-400",
				})
			</div>
			<div class="ml-3">
				<h3 class="text-sm font-medium text-red-800 dark:text-red-200">
					There { getErrorCountText(len(errors)) } with your submission
				</h3>
				<div class="mt-2 text-sm text-red-700 dark:text-red-300">
					<ul class="list-disc list-inside space-y-1">
						for field, message := range errors {
							<li>{ formatFieldName(field) }: { message }</li>
						}
					</ul>
				</div>
			</div>
		</div>
	</div>
}

// TenantFormBasicSection renders basic tenant information fields
templ TenantFormBasicSection(props TenantFormProps) {
	<div class="space-y-6">
		<div class="bg-white dark:bg-gray-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
			<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">
				Basic Information
			</h3>
			
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<!-- Organization Name -->
				@molecules.Field(molecules.FieldProps{
					Type:        molecules.FieldTypeInput,
					Label:       "Organization Name",
					Name:        "name",
					Placeholder: "Enter organization name",
					Value:       getTenantFieldValue(props.Tenant, "name"),
					Required:    true,
					Disabled:    props.IsReadonly,
					ErrorText:   props.Errors["name"],
					InputType:   atoms.InputText,
				})
				
				<!-- Email -->
				@molecules.Field(molecules.FieldProps{
					Type:        molecules.FieldTypeInput,
					Label:       "Contact Email",
					Name:        "email",
					Placeholder: "contact@company.com",
					Value:       getTenantFieldValue(props.Tenant, "email"),
					Required:    true,
					Disabled:    props.IsReadonly,
					ErrorText:   props.Errors["email"],
					InputType:   atoms.InputEmail,
				})
				
				<!-- Slug -->
				if props.Fields.ShowSlug {
					@molecules.Field(molecules.FieldProps{
						Type:        molecules.FieldTypeInput,
						Label:       "Organization Slug",
						Name:        "slug",
						Placeholder: "organization-slug",
						Value:       getTenantFieldValue(props.Tenant, "slug"),
						Required:    props.Mode == "create",
						Disabled:    props.IsReadonly || props.Mode == "edit",
						ErrorText:   props.Errors["slug"],
						HelpText:    "Used in URLs and system references. Must be unique.",
						InputType:   atoms.InputText,
					})
				}
				
				<!-- Subdomain -->
				if props.Fields.ShowSubdomain {
					@molecules.Field(molecules.FieldProps{
						Type:        molecules.FieldTypeInput,
						Label:       "Subdomain",
						Name:        "subdomain",
						Placeholder: "company",
						Value:       getTenantFieldValue(props.Tenant, "subdomain"),
						Disabled:    props.IsReadonly,
						ErrorText:   props.Errors["subdomain"],
						HelpText:    "Custom subdomain for accessing the application",
						InputType:   atoms.InputText,
					})
				}
				
				<!-- Timezone -->
				@molecules.Field(molecules.FieldProps{
					Type:      molecules.FieldTypeSelect,
					Label:     "Timezone",
					Name:      "timezone",
					Value:     getTenantFieldValue(props.Tenant, "timezone"),
					Required:  true,
					Disabled:  props.IsReadonly,
					ErrorText: props.Errors["timezone"],
					Options:   getTimezoneOptions(),
				})
				
				<!-- Currency -->
				@molecules.Field(molecules.FieldProps{
					Type:      molecules.FieldTypeSelect,
					Label:     "Currency",
					Name:      "currency_code",
					Value:     getTenantFieldValue(props.Tenant, "currency_code"),
					Required:  true,
					Disabled:  props.IsReadonly,
					ErrorText: props.Errors["currency_code"],
					Options:   getCurrencyOptions(),
				})
				
				<!-- Industry -->
				@molecules.Field(molecules.FieldProps{
					Type:      molecules.FieldTypeSelect,
					Label:     "Industry",
					Name:      "industry",
					Value:     getTenantFieldValue(props.Tenant, "industry"),
					Disabled:  props.IsReadonly,
					ErrorText: props.Errors["industry"],
					Options:   getIndustryOptions(),
				})
				
				<!-- Company Size -->
				@molecules.Field(molecules.FieldProps{
					Type:      molecules.FieldTypeSelect,
					Label:     "Company Size",
					Name:      "company_size",
					Value:     getTenantFieldValue(props.Tenant, "company_size"),
					Disabled:  props.IsReadonly,
					ErrorText: props.Errors["company_size"],
					Options:   getCompanySizeOptions(),
				})
			</div>
			
			<!-- Description -->
			if props.Fields.ShowDescription {
				<div class="mt-6">
					@molecules.Field(molecules.FieldProps{
						Type:        molecules.FieldTypeTextarea,
						Label:       "Description",
						Name:        "description",
						Placeholder: "Brief description of your organization...",
						Value:       getTenantFieldValue(props.Tenant, "description"),
						Rows:        3,
						Disabled:    props.IsReadonly,
						ErrorText:   props.Errors["description"],
					})
				</div>
			}
			
			<!-- Contact Information -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
				if props.Fields.ShowWebsite {
					@molecules.Field(molecules.FieldProps{
						Type:        molecules.FieldTypeInput,
						Label:       "Website",
						Name:        "website",
						Placeholder: "https://company.com",
						Value:       getTenantFieldValue(props.Tenant, "website"),
						Disabled:    props.IsReadonly,
						ErrorText:   props.Errors["website"],
						InputType:   atoms.InputURL,
					})
				}
				
				if props.Fields.ShowPhone {
					@molecules.Field(molecules.FieldProps{
						Type:        molecules.FieldTypeInput,
						Label:       "Phone",
						Name:        "phone",
						Placeholder: "+1 (555) 123-4567",
						Value:       getTenantFieldValue(props.Tenant, "phone"),
						Disabled:    props.IsReadonly,
						ErrorText:   props.Errors["phone"],
						InputType:   atoms.InputTel,
					})
				}
			</div>
			
			<!-- Status (edit mode only) -->
			if props.Fields.ShowStatus && props.Mode == "edit" {
				<div class="mt-6">
					@molecules.Field(molecules.FieldProps{
						Type:      molecules.FieldTypeSelect,
						Label:     "Status",
						Name:      "status",
						Value:     getTenantFieldValue(props.Tenant, "status"),
						Required:  true,
						Disabled:  props.IsReadonly,
						ErrorText: props.Errors["status"],
						HelpText:  "Control the tenant's access and billing status",
						Options:   getTenantStatusOptions(),
					})
				</div>
			}
		</div>
	</div>
}

// TenantFormAddressSection renders address fields
templ TenantFormAddressSection(props TenantFormProps) {
	<div class="bg-white dark:bg-gray-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
		<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">
			Address Information
		</h3>
		
		<div class="space-y-6">
			<!-- Street Address -->
			@molecules.Field(molecules.FieldProps{
				Type:        molecules.FieldTypeInput,
				Label:       "Street Address",
				Name:        "address.street",
				Placeholder: "123 Main Street",
				Value:       getTenantAddressValue(props.Tenant, "street"),
				Disabled:    props.IsReadonly,
				ErrorText:   props.Errors["address.street"],
				InputType:   atoms.InputText,
			})
			
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- City -->
				@molecules.Field(molecules.FieldProps{
					Type:        molecules.FieldTypeInput,
					Label:       "City",
					Name:        "address.city",
					Placeholder: "San Francisco",
					Value:       getTenantAddressValue(props.Tenant, "city"),
					Disabled:    props.IsReadonly,
					ErrorText:   props.Errors["address.city"],
					InputType:   atoms.InputText,
				})
				
				<!-- State -->
				@molecules.Field(molecules.FieldProps{
					Type:        molecules.FieldTypeInput,
					Label:       "State/Province",
					Name:        "address.state",
					Placeholder: "CA",
					Value:       getTenantAddressValue(props.Tenant, "state"),
					Disabled:    props.IsReadonly,
					ErrorText:   props.Errors["address.state"],
					InputType:   atoms.InputText,
				})
				
				<!-- Postal Code -->
				@molecules.Field(molecules.FieldProps{
					Type:        molecules.FieldTypeInput,
					Label:       "Postal Code",
					Name:        "address.postal_code",
					Placeholder: "94105",
					Value:       getTenantAddressValue(props.Tenant, "postal_code"),
					Disabled:    props.IsReadonly,
					ErrorText:   props.Errors["address.postal_code"],
					InputType:   atoms.InputText,
				})
			</div>
			
			<!-- Country -->
			@molecules.Field(molecules.FieldProps{
				Type:      molecules.FieldTypeSelect,
				Label:     "Country",
				Name:      "address.country",
				Value:     getTenantAddressValue(props.Tenant, "country"),
				Disabled:  props.IsReadonly,
				ErrorText: props.Errors["address.country"],
				Options:   getCountryOptions(),
			})
		</div>
	</div>
}

// TenantFormBillingSection renders billing information
templ TenantFormBillingSection(props TenantFormProps) {
	<div class="bg-white dark:bg-gray-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
		<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">
			Billing Information
		</h3>
		
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<!-- Plan -->
			@molecules.Field(molecules.FieldProps{
				Type:      molecules.FieldTypeSelect,
				Label:     "Subscription Plan",
				Name:      "billing.plan_id",
				Value:     getTenantBillingValue(props.Tenant, "plan_id"),
				Disabled:  props.IsReadonly,
				ErrorText: props.Errors["billing.plan_id"],
				Options:   getSubscriptionPlanOptions(),
			})
			
			<!-- Billing Cycle -->
			@molecules.Field(molecules.FieldProps{
				Type:      molecules.FieldTypeSelect,
				Label:     "Billing Cycle",
				Name:      "billing.billing_cycle",
				Value:     getTenantBillingValue(props.Tenant, "billing_cycle"),
				Disabled:  props.IsReadonly,
				ErrorText: props.Errors["billing.billing_cycle"],
				Options:   getBillingCycleOptions(),
			})
		</div>
	</div>
}

// TenantFormSettingsSection renders tenant settings
templ TenantFormSettingsSection(props TenantFormProps) {
	<div class="bg-white dark:bg-gray-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
		<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">
			Configuration Settings
		</h3>
		
		<div class="space-y-6">
			<!-- Feature Toggles -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				@molecules.Field(molecules.FieldProps{
					Type:     molecules.FieldTypeCheckbox,
					Label:    "Allow User Signup",
					Name:     "settings.allow_signup",
					Value:    getTenantSettingValue(props.Tenant, "allow_signup"),
					Disabled: props.IsReadonly,
					HelpText: "Enable public user registration for this tenant",
				})
				
				@molecules.Field(molecules.FieldProps{
					Type:     molecules.FieldTypeCheckbox,
					Label:    "Require Email Verification",
					Name:     "settings.require_email_verification",
					Value:    getTenantSettingValue(props.Tenant, "require_email_verification"),
					Disabled: props.IsReadonly,
					HelpText: "Require users to verify their email before accessing the system",
				})
				
				@molecules.Field(molecules.FieldProps{
					Type:     molecules.FieldTypeCheckbox,
					Label:    "Enable SSO",
					Name:     "settings.enable_sso",
					Value:    getTenantSettingValue(props.Tenant, "enable_sso"),
					Disabled: props.IsReadonly,
					HelpText: "Allow single sign-on authentication",
				})
				
				@molecules.Field(molecules.FieldProps{
					Type:     molecules.FieldTypeCheckbox,
					Label:    "Enable API Access",
					Name:     "settings.enable_api",
					Value:    getTenantSettingValue(props.Tenant, "enable_api"),
					Disabled: props.IsReadonly,
					HelpText: "Allow API access for this tenant",
				})
			</div>
			
			<!-- Limits -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				@molecules.Field(molecules.FieldProps{
					Type:      molecules.FieldTypeInput,
					Label:     "Maximum Users",
					Name:      "settings.max_users",
					Value:     getTenantSettingValue(props.Tenant, "max_users"),
					Disabled:  props.IsReadonly,
					ErrorText: props.Errors["settings.max_users"],
					HelpText:  "Maximum number of users allowed (0 for unlimited)",
					InputType: atoms.InputNumber,
				})
				
				@molecules.Field(molecules.FieldProps{
					Type:      molecules.FieldTypeInput,
					Label:     "Storage Quota (GB)",
					Name:      "settings.max_storage",
					Value:     getTenantSettingStorageValue(props.Tenant),
					Disabled:  props.IsReadonly,
					ErrorText: props.Errors["settings.max_storage"],
					HelpText:  "Maximum storage allowed in gigabytes (0 for unlimited)",
					InputType: atoms.InputNumber,
				})
			</div>
		</div>
	</div>
}

// TenantFormMetadataSection renders metadata editor
templ TenantFormMetadataSection(props TenantFormProps) {
	<div class="bg-white dark:bg-gray-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
		<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">
			Custom Metadata
		</h3>
		
		<div class="space-y-4" x-data="metadataEditor()">
			<!-- Add Metadata Button -->
			<div class="flex justify-end">
				@atoms.Button(atoms.ButtonProps{
					Text:    "Add Field",
					Icon:    "plus",
					Variant: atoms.VariantSecondary,
					Size:    atoms.SizeSM,
					OnClick: "addMetadataField()",
				})
			</div>
			
			<!-- Metadata Fields -->
			<div class="space-y-3" x-show="metadataFields.length > 0">
				<template x-for="(field, index) in metadataFields" :key="index">
					<div class="flex items-end space-x-3">
						<div class="flex-1">
							<input
								type="text"
								placeholder="Key"
								x-model="field.key"
								class="block w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
							/>
						</div>
						<div class="flex-1">
							<input
								type="text"
								placeholder="Value"
								x-model="field.value"
								class="block w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
							/>
						</div>
						<div>
							@atoms.Button(atoms.ButtonProps{
								Icon:    "trash",
								Variant: atoms.ButtonDanger,
								Size:    atoms.SizeSM,
								OnClick: "removeMetadataField(index)",
								Class:   "px-3",
							})
						</div>
					</div>
				</template>
			</div>
			
			<!-- Hidden input for form submission -->
			<input type="hidden" name="metadata" x-model="JSON.stringify(getMetadataObject())" />
		</div>
	</div>
}

// TenantFormModeBadge renders a badge showing the form mode
templ TenantFormModeBadge(mode string) {
	<span class={ "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium", getTenantFormModeClasses(mode) }>
		{ formatTenantFormMode(mode) }
	</span>
}

// TenantFormActions renders form action buttons
templ TenantFormActions(props TenantFormProps) {
	<div class="flex items-center justify-between pt-6 border-t border-gray-200 dark:border-gray-700">
		<div class="flex items-center space-x-3">
			<!-- Cancel Button -->
			if props.CancelUrl != "" || props.CancelText != "" {
				@atoms.Button(atoms.ButtonProps{
					Text:    getTenantFormCancelText(props.CancelText),
					Variant: atoms.VariantSecondary,
					Size:    atoms.SizeMD,
					OnClick: "cancelForm()",
				})
			}
		</div>
		
		<div class="flex items-center space-x-3">
			<!-- Save Draft (for create/edit modes) -->
			if props.EnableAutosave && (props.Mode == "create" || props.Mode == "edit") {
				@atoms.Button(atoms.ButtonProps{
					Text:    "Save Draft",
					Icon:    "document",
					Variant: atoms.VariantSecondary,
					Size:    atoms.SizeMD,
					OnClick: "saveDraft()",
				})
			}
			
			<!-- Primary Action Button -->
			@atoms.Button(atoms.ButtonProps{
				Text:    getTenantFormSubmitText(props),
				Icon:    getTenantFormSubmitIcon(props.Mode),
				Variant: atoms.ButtonPrimary,
				Size:    atoms.SizeMD,
				Type:    "submit",
				Loading: props.IsLoading,
			})
		</div>
	</div>
}

// TenantFormAutosaveStatus renders autosave status indicator
templ TenantFormAutosaveStatus() {
	<div class="fixed bottom-4 right-4 z-50" x-show="showAutosaveStatus" x-transition>
		<div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg p-3">
			<div class="flex items-center space-x-2 text-sm">
				<div x-show="autosaveStatus === 'saving'">
					@atoms.Spinner(atoms.SpinnerProps{
						Size:  atoms.SpinnerSizeXS,
						Class: "text-blue-600",
					})
					<span class="text-gray-600 dark:text-gray-400">Saving draft...</span>
				</div>
				<div x-show="autosaveStatus === 'saved'" class="flex items-center space-x-2">
					@atoms.Icon(atoms.IconProps{
						Name:  "check",
						Size:  atoms.IconSizeXS,
						Class: "text-green-500",
					})
					<span class="text-gray-600 dark:text-gray-400">Draft saved</span>
				</div>
				<div x-show="autosaveStatus === 'error'" class="flex items-center space-x-2">
					@atoms.Icon(atoms.IconProps{
						Name:  "exclamation-triangle",
						Size:  atoms.IconSizeXS,
						Class: "text-red-500",
					})
					<span class="text-gray-600 dark:text-gray-400">Save failed</span>
				</div>
			</div>
		</div>
	</div>
}

// Alpine.js components
script tenantForm() {
	return {
		formData: {},
		isDirty: false,
		isSubmitting: false,
		
		init() {
			this.initializeFormData();
			this.watchForChanges();
		},
		
		initializeFormData() {
			const form = this.$refs.form;
			if (form) {
				const formData = new FormData(form);
				this.formData = Object.fromEntries(formData.entries());
			}
		},
		
		watchForChanges() {
			this.$refs.form.addEventListener('input', () => {
				this.isDirty = true;
			});
		},
		
		submitForm() {
			this.isSubmitting = true;
			// Form submission is handled by HTMX
		},
		
		cancelForm() {
			if (this.isDirty) {
				if (confirm('You have unsaved changes. Are you sure you want to cancel?')) {
					this.closeModal();
				}
			} else {
				this.closeModal();
			}
		},
		
		closeModal() {
			// Close modal by clearing container
			document.getElementById('modal-container').innerHTML = '';
		},
		
		saveDraft() {
			// Implement draft saving
			console.log('Save draft');
		}
	}
}

script metadataEditor() {
	return {
		metadataFields: [],
		
		init() {
			// Initialize with existing metadata if any
			this.loadExistingMetadata();
		},
		
		loadExistingMetadata() {
			// Load existing metadata from props
		},
		
		addMetadataField() {
			this.metadataFields.push({ key: '', value: '' });
		},
		
		removeMetadataField(index) {
			this.metadataFields.splice(index, 1);
		},
		
		getMetadataObject() {
			const obj = {};
			this.metadataFields.forEach(field => {
				if (field.key && field.value) {
					obj[field.key] = field.value;
				}
			});
			return obj;
		}
	}
}

// Helper functions
func getTenantFormTitle(props TenantFormProps) string {
	if props.HeaderTitle != "" {
		return props.HeaderTitle
	}
	
	switch props.Mode {
	case "create":
		return "Create New Tenant"
	case "edit":
		return "Edit Tenant"
	case "view":
		return "Tenant Details"
	default:
		return "Tenant Form"
	}
}

func getTenantFormModeClasses(mode string) string {
	switch mode {
	case "create":
		return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200"
	case "edit":
		return "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200"
	case "view":
		return "bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200"
	default:
		return "bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200"
	}
}

func formatTenantFormMode(mode string) string {
	switch mode {
	case "create":
		return "Creating"
	case "edit":
		return "Editing"
	case "view":
		return "Viewing"
	default:
		return mode
	}
}

func getTenantFormSubmitText(props TenantFormProps) string {
	if props.SubmitText != "" {
		return props.SubmitText
	}
	
	switch props.Mode {
	case "create":
		return "Create Tenant"
	case "edit":
		return "Save Changes"
	default:
		return "Submit"
	}
}

func getTenantFormSubmitIcon(mode string) string {
	switch mode {
	case "create":
		return "plus"
	case "edit":
		return "check"
	default:
		return ""
	}
}

func getTenantFormCancelText(text string) string {
	if text != "" {
		return text
	}
	return "Cancel"
}

func getErrorCountText(count int) string {
	if count == 1 {
		return "was 1 error"
	}
	return "were " + formatNumber(count) + " errors"
}

func formatFieldName(field string) string {
	// Convert field names to human readable
	switch field {
	case "name":
		return "Organization name"
	case "email":
		return "Contact email"
	case "slug":
		return "Organization slug"
	case "timezone":
		return "Timezone"
	case "currency_code":
		return "Currency"
	default:
		return field
	}
}

func getTenantFieldValue(tenant *TenantFormData, field string) string {
	if tenant == nil {
		return ""
	}
	
	switch field {
	case "name":
		return tenant.Name
	case "email":
		return tenant.Email
	case "slug":
		return tenant.Slug
	case "subdomain":
		return tenant.Subdomain
	case "timezone":
		return tenant.Timezone
	case "currency_code":
		return tenant.CurrencyCode
	case "industry":
		return tenant.Industry
	case "company_size":
		return tenant.CompanySize
	case "description":
		return tenant.Description
	case "website":
		return tenant.Website
	case "phone":
		return tenant.Phone
	case "status":
		return tenant.Status
	default:
		return ""
	}
}

func getTenantAddressValue(tenant *TenantFormData, field string) string {
	if tenant == nil {
		return ""
	}
	
	switch field {
	case "street":
		return tenant.Address.Street
	case "city":
		return tenant.Address.City
	case "state":
		return tenant.Address.State
	case "postal_code":
		return tenant.Address.PostalCode
	case "country":
		return tenant.Address.Country
	default:
		return ""
	}
}

func getTenantBillingValue(tenant *TenantFormData, field string) string {
	if tenant == nil {
		return ""
	}
	
	switch field {
	case "plan_id":
		return tenant.Billing.PlanID
	case "billing_cycle":
		return tenant.Billing.BillingCycle
	case "payment_method":
		return tenant.Billing.PaymentMethod
	case "next_billing_date":
		return tenant.Billing.NextBillingDate
	default:
		return ""
	}
}

func getTenantSettingBool(tenant *TenantFormData, field string) bool {
	if tenant == nil {
		return false
	}
	
	switch field {
	case "allow_signup":
		return tenant.Settings.AllowSignup
	case "require_email_verification":
		return tenant.Settings.RequireEmailVerification
	case "enable_sso":
		return tenant.Settings.EnableSSO
	case "enable_api":
		return tenant.Settings.EnableAPI
	default:
		return false
	}
}

func getTenantSettingValue(tenant *TenantFormData, field string) string {
	if tenant == nil {
		return ""
	}
	
	switch field {
	case "max_users":
		return formatNumber(tenant.Settings.MaxUsers)
	default:
		return ""
	}
}

func getTenantSettingStorageValue(tenant *TenantFormData) string {
	if tenant == nil {
		return ""
	}
	
	// Convert bytes to GB
	gb := float64(tenant.Settings.MaxStorage) / (1024 * 1024 * 1024)
	if gb == 0 {
		return ""
	}
	
	return formatFloat(gb)
}

func formatFloat(f float64) string {
	// Simple float formatting
	return "0.0"
}

