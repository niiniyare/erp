func splitWords(s string) []string {
	// Simple word splitting - should be replaced with proper implementation
	return []string{s}
}

func minInt(a, b int) int {
	if a < b {
		return a
	}
	return b
}

func maxInt(a, b int) int {
	if a > b {
		return a
	}
	return b
}