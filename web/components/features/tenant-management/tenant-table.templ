package tenant_management

import (
	"github.com/niiniyare/erp/web/components/atoms"
	"github.com/niiniyare/erp/web/components/molecules"
	"github.com/niiniyare/erp/web/components/organisms/table"
)

// TenantTableProps defines properties for the tenant management table
type TenantTableProps struct {
	// Data
	Tenants []TenantListItem `json:"tenants"`
	
	// Table configuration
	Config table.DataTableConfig `json:"config"`
	
	// Pagination
	Pagination *PaginationInfo `json:"pagination,omitempty"`
	
	// Actions
	ShowCreateButton bool   `json:"showCreateButton"`
	CreateButtonText string `json:"createButtonText"`
	
	// HTMX endpoints
	DataUrl    string `json:"dataUrl"`
	CreateUrl  string `json:"createUrl"`
	EditUrl    string `json:"editUrl"`
	DeleteUrl  string `json:"deleteUrl"`
	
	// Permissions
	CanCreate bool `json:"canCreate"`
	CanEdit   bool `json:"canEdit"`
	CanDelete bool `json:"canDelete"`
	CanView   bool `json:"canView"`
	
	// Search and filtering
	SearchEnabled bool                   `json:"searchEnabled"`
	SearchProps   *molecules.SearchProps `json:"searchProps,omitempty"`
	Filters       []TenantFilter         `json:"filters,omitempty"`
	
	// UI state
	ID         string `json:"id,omitempty"`
	Class      string `json:"class,omitempty"`
	EmptyText  string `json:"emptyText,omitempty"`
}

// TenantListItem represents a tenant in the table
type TenantListItem struct {
	ID           string `json:"id"`
	Slug         string `json:"slug"`
	Name         string `json:"name"`
	Email        string `json:"email"`
	Status       string `json:"status"`
	Timezone     string `json:"timezone"`
	CurrencyCode string `json:"currency_code"`
	Industry     string `json:"industry,omitempty"`
	CompanySize  string `json:"company_size,omitempty"`
	CreatedAt    string `json:"created_at"`
	UpdatedAt    string `json:"updated_at"`
	UsersCount   int    `json:"users_count,omitempty"`
	IsActive     bool   `json:"is_active"`
}

// TenantFilter represents filtering options
type TenantFilter struct {
	Key      string                 `json:"key"`
	Label    string                 `json:"label"`
	Type     string                 `json:"type"` // select, text, date
	Options  []TenantFilterOption   `json:"options,omitempty"`
	Value    string                 `json:"value,omitempty"`
	Operator string                 `json:"operator,omitempty"` // eq, contains, gte, lte
}

// TenantFilterOption represents a filter option
type TenantFilterOption struct {
	Value string `json:"value"`
	Label string `json:"label"`
	Count int    `json:"count,omitempty"`
}

// PaginationInfo represents pagination state
type PaginationInfo struct {
	CurrentPage  int   `json:"current_page"`
	TotalPages   int   `json:"total_pages"`
	TotalItems   int64 `json:"total_items"`
	ItemsPerPage int   `json:"items_per_page"`
	HasNext      bool  `json:"has_next"`
	HasPrev      bool  `json:"has_prev"`
}

// TenantTable renders a comprehensive tenant management table
templ TenantTable(props TenantTableProps) {
	<div 
		class={ "tenant-table-container", props.Class }
		if props.ID != "" {
			id={ props.ID }
		}
		x-data="tenantTable()"
		x-init="init()"
	>
		<!-- Table Header with Search and Actions -->
		<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 space-y-4 sm:space-y-0">
			<!-- Left side: Search and Filters -->
			<div class="flex flex-col sm:flex-row sm:items-center space-y-4 sm:space-y-0 sm:space-x-4">
				if props.SearchEnabled && props.SearchProps != nil {
					<div class="flex-1 max-w-md">
						@molecules.Search(*props.SearchProps)
					</div>
				}
				
				if len(props.Filters) > 0 {
					@TenantTableFilters(props.Filters)
				}
			</div>
			
			<!-- Right side: Actions -->
			<div class="flex items-center space-x-3">
				<!-- Bulk Actions -->
				<div class="hidden" x-show="selectedTenants.length > 0">
					@TenantBulkActions()
				</div>
				
				<!-- Create Button -->
				if props.ShowCreateButton && props.CanCreate {
					@atoms.Button(atoms.ButtonProps{
						Text:     getCreateButtonText(props.CreateButtonText),
						Icon:     "plus",
						Variant:  atoms.ButtonPrimary,
						Size:     atoms.ButtonSizeMD,
						HxGet:    props.CreateUrl,
						HxTarget: "#modal-container",
						HxSwap:   "innerHTML",
						Class:    "whitespace-nowrap",
					})
				}
				
				<!-- Refresh Button -->
				@atoms.Button(atoms.ButtonProps{
					Icon:     "refresh",
					Variant:  atoms.ButtonSecondary,
					Size:     atoms.ButtonSizeMD,
					HxGet:    props.DataUrl,
					HxTarget: "#tenant-table-body",
					HxSwap:   "outerHTML",
					AriaLabel:    "Refresh table data",
					Class:    "px-3",
				})
			</div>
		</div>
		
		<!-- Table -->
		<div class="bg-white dark:bg-gray-800 shadow-sm rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
			<!-- Loading Indicator -->
			<div 
				class="htmx-indicator absolute inset-0 bg-white/75 dark:bg-gray-800/75 z-10 flex items-center justify-center"
				id="tenant-table-loading"
			>
				@atoms.Spinner(atoms.SpinnerProps{
					Size: atoms.SpinnerSizeLG,
					Class: "text-blue-600",
				})
			</div>
			
			<!-- Table Content -->
			<div 
				id="tenant-table-body"
				hx-get={ props.DataUrl }
				hx-trigger="load, tenantUpdated from:body, tenantDeleted from:body"
				hx-swap="outerHTML"
				hx-indicator="#tenant-table-loading"
			>
				@TenantTableContent(props)
			</div>
		</div>
		
		<!-- Pagination -->
		if props.Pagination != nil && props.Pagination.TotalPages > 1 {
			@TenantTablePagination(*props.Pagination, props.DataUrl)
		}
	</div>
}

// TenantTableContent renders the table content
templ TenantTableContent(props TenantTableProps) {
	if len(props.Tenants) == 0 {
		@TenantTableEmpty(props.EmptyText)
	} else {
		<div class="overflow-x-auto">
			<table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
				@TenantTableHeader(props)
				@TenantTableBody(props)
			</table>
		</div>
	}
}

// TenantTableHeader renders the table header
templ TenantTableHeader(props TenantTableProps) {
	<thead class="bg-gray-50 dark:bg-gray-700">
		<tr>
			<!-- Selection Column -->
			if props.Config.RowSelection {
				<th scope="col" class="relative w-12 px-6 sm:w-16 sm:px-8">
					<input
						type="checkbox"
						class="absolute left-4 top-1/2 -mt-2 h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700"
						x-model="selectAll"
						@change="toggleAllSelection()"
					/>
				</th>
			}
			
			<!-- Name Column -->
			<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
				<div class="flex items-center space-x-1">
					<span>Organization</span>
					if props.Config.Sortable {
						@TenantTableSortButton("name")
					}
				</div>
			</th>
			
			<!-- Status Column -->
			<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
				<div class="flex items-center space-x-1">
					<span>Status</span>
					if props.Config.Sortable {
						@TenantTableSortButton("status")
					}
				</div>
			</th>
			
			<!-- Industry Column -->
			<th scope="col" class="hidden md:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
				<div class="flex items-center space-x-1">
					<span>Industry</span>
					if props.Config.Sortable {
						@TenantTableSortButton("industry")
					}
				</div>
			</th>
			
			<!-- Users Column -->
			<th scope="col" class="hidden lg:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
				<div class="flex items-center space-x-1">
					<span>Users</span>
					if props.Config.Sortable {
						@TenantTableSortButton("users_count")
					}
				</div>
			</th>
			
			<!-- Created Column -->
			<th scope="col" class="hidden lg:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
				<div class="flex items-center space-x-1">
					<span>Created</span>
					if props.Config.Sortable {
						@TenantTableSortButton("created_at")
					}
				</div>
			</th>
			
			<!-- Actions Column -->
			<th scope="col" class="relative px-6 py-3">
				<span class="sr-only">Actions</span>
			</th>
		</tr>
	</thead>
}

// TenantTableBody renders the table body
templ TenantTableBody(props TenantTableProps) {
	<tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
		for _, tenant := range props.Tenants {
			@TenantTableRow(tenant, props)
		}
	</tbody>
}

// TenantTableRow renders a single tenant row
templ TenantTableRow(tenant TenantListItem, props TenantTableProps) {
	<tr 
		class="hover:bg-gray-50 dark:hover:bg-gray-700"
		x-bind:class="{ 'bg-blue-50 dark:bg-blue-900/20': selectedTenants.includes('{ tenant.ID }') }"
	>
		<!-- Selection Column -->
		if props.Config.RowSelection {
			<td class="relative w-12 px-6 sm:w-16 sm:px-8">
				<input
					type="checkbox"
					class="absolute left-4 top-1/2 -mt-2 h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700"
					value={ tenant.ID }
					x-model="selectedTenants"
				/>
			</td>
		}
		
		<!-- Organization Info -->
		<td class="px-6 py-4">
			<div class="flex items-center">
				<div class="flex-shrink-0 h-10 w-10">
					<div class="h-10 w-10 rounded-full bg-gray-300 dark:bg-gray-600 flex items-center justify-center">
						<span class="text-sm font-medium text-gray-700 dark:text-gray-300">
							{ getInitials(tenant.Name) }
						</span>
					</div>
				</div>
				<div class="ml-4">
					<div class="flex items-center space-x-2">
						<div 
							class="text-sm font-medium text-gray-900 dark:text-white cursor-pointer hover:text-blue-600 dark:hover:text-blue-400"
							hx-get={ props.EditUrl + "/" + tenant.ID }
							hx-target="#modal-container"
							hx-swap="innerHTML"
						>
							{ tenant.Name }
						</div>
						if !tenant.IsActive {
							@atoms.Icon(atoms.IconProps{
								Name:  "pause-circle",
								Size:  atoms.IconSizeXS,
								Class: "text-gray-400",
								AriaLabel: "Inactive",
							})
						}
					</div>
					<div class="text-sm text-gray-500 dark:text-gray-400">
						{ tenant.Email }
					</div>
					<div class="text-xs text-gray-400 dark:text-gray-500">
						{ tenant.Slug }
					</div>
				</div>
			</div>
		</td>
		
		<!-- Status -->
		<td class="px-6 py-4 whitespace-nowrap">
			@TenantStatusBadge(tenant.Status)
		</td>
		
		<!-- Industry -->
		<td class="hidden md:table-cell px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
			if tenant.Industry != "" {
				{ tenant.Industry }
			} else {
				<span class="text-gray-300 dark:text-gray-600">—</span>
			}
		</td>
		
		<!-- Users Count -->
		<td class="hidden lg:table-cell px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
			if tenant.UsersCount > 0 {
				<span class="inline-flex items-center">
					@atoms.Icon(atoms.IconProps{
						Name:  "users",
						Size:  atoms.IconSizeXS,
						Class: "mr-1",
					})
					{ formatNumber(tenant.UsersCount) }
				</span>
			} else {
				<span class="text-gray-300 dark:text-gray-600">—</span>
			}
		</td>
		
		<!-- Created Date -->
		<td class="hidden lg:table-cell px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
			<div title={ tenant.CreatedAt }>
				{ formatRelativeDate(tenant.CreatedAt) }
			</div>
		</td>
		
		<!-- Actions -->
		<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
			@TenantRowActions(tenant, props)
		</td>
	</tr>
}

// TenantStatusBadge renders a status badge
templ TenantStatusBadge(status string) {
	<span class={ "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium", getTenantStatusClasses(status) }>
		<span class={ "w-1.5 h-1.5 mr-1.5 rounded-full", getTenantStatusDotClasses(status) }></span>
		{ formatTenantStatus(status) }
	</span>
}

// TenantRowActions renders action buttons for a tenant row
templ TenantRowActions(tenant TenantListItem, props TenantTableProps) {
	<div class="flex items-center space-x-2">
		<!-- View Button -->
		if props.CanView {
			@atoms.Button(atoms.ButtonProps{
				Icon:     "eye",
				Variant:  atoms.ButtonGhost,
				Size:     atoms.ButtonSizeSM,
				HxGet:    props.EditUrl + "/" + tenant.ID + "?mode=view",
				HxTarget: "#modal-container",
				HxSwap:   "innerHTML",
				AriaLabel:    "View tenant details",
				Class:    "px-2",
			})
		}
		
		<!-- Edit Button -->
		if props.CanEdit {
			@atoms.Button(atoms.ButtonProps{
				Icon:     "pencil",
				Variant:  atoms.ButtonGhost,
				Size:     atoms.ButtonSizeSM,
				HxGet:    props.EditUrl + "/" + tenant.ID,
				HxTarget: "#modal-container",
				HxSwap:   "innerHTML",
				AriaLabel:    "Edit tenant",
				Class:    "px-2",
			})
		}
		
		<!-- Delete Button -->
		if props.CanDelete && tenant.Status != "ACTIVE" {
			@atoms.Button(atoms.ButtonProps{
				Icon:      "trash",
				Variant:   atoms.ButtonDanger,
				Size:      atoms.ButtonSizeSM,
				HxDelete:  props.DeleteUrl + "/" + tenant.ID,
				HxConfirm: "Are you sure you want to delete this tenant? This action cannot be undone.",
				HxTarget:  "#tenant-table-body",
				HxSwap:    "outerHTML",
				AriaLabel:     "Delete tenant",
				Class:     "px-2",
			})
		}
	</div>
}

// TenantTableEmpty renders empty state
templ TenantTableEmpty(emptyText string) {
	<div class="text-center py-12">
		<div class="inline-flex items-center justify-center w-16 h-16 bg-gray-100 dark:bg-gray-700 rounded-full mb-4">
			@atoms.Icon(atoms.IconProps{
				Name:  "building-office",
				Size:  atoms.IconSizeLG,
				Class: "text-gray-400 dark:text-gray-500",
			})
		</div>
		<h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">
			No tenants found
		</h3>
		<p class="text-gray-500 dark:text-gray-400 max-w-sm mx-auto">
			if emptyText != "" {
				{ emptyText }
			} else {
				Get started by creating your first tenant organization.
			}
		</p>
	</div>
}

// TenantTableFilters renders filter controls
templ TenantTableFilters(filters []TenantFilter) {
	<div class="flex items-center space-x-3">
		@atoms.Button(atoms.ButtonProps{
			Text:    "Filters",
			Icon:    "filter",
			Variant: atoms.ButtonSecondary,
			Size:    atoms.ButtonSizeSM,
			OnClick: "showFilters = !showFilters",
		})
		
		<!-- Active Filter Badges -->
		<div class="flex items-center space-x-2" x-show="activeFiltersCount > 0">
			for _, filter := range filters {
				if filter.Value != "" {
					<span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
						{ filter.Label }: { filter.Value }
						<button
							type="button"
							class="ml-1 inline-flex items-center p-0.5 rounded-sm hover:bg-blue-200 dark:hover:bg-blue-800"
							@click="clearFilter('{ filter.Key }')"
						>
							@atoms.Icon(atoms.IconProps{
								Name: "x",
								Size: atoms.IconSizeXS,
							})
						</button>
					</span>
				}
			}
		</div>
	</div>
}

// TenantBulkActions renders bulk action buttons
templ TenantBulkActions() {
	<div class="flex items-center space-x-2">
		<span class="text-sm text-gray-500 dark:text-gray-400" x-text="`${selectedTenants.length} selected`"></span>
		
		@atoms.Button(atoms.ButtonProps{
			Text:    "Export",
			Icon:    "download",
			Variant: atoms.ButtonSecondary,
			Size:    atoms.ButtonSizeSM,
			OnClick: "exportSelected()",
		})
		
		@atoms.Button(atoms.ButtonProps{
			Text:    "Deactivate",
			Icon:    "pause",
			Variant: atoms.ButtonWarning,
			Size:    atoms.ButtonSizeSM,
			OnClick: "bulkDeactivate()",
		})
	</div>
}

// TenantTableSortButton renders a sort button for columns
templ TenantTableSortButton(field string) {
	<button
		type="button"
		class="group inline-flex items-center hover:text-gray-900 dark:hover:text-white"
		@click="sort('{ field }')"
	>
		@atoms.Icon(atoms.IconProps{
			Name:  "arrows-up-down",
			Size:  atoms.IconSizeXS,
			Class: "text-gray-400 group-hover:text-gray-500",
		})
	</button>
}

// TenantTablePagination renders pagination controls
templ TenantTablePagination(pagination PaginationInfo, dataUrl string) {
	<div class="bg-white dark:bg-gray-800 px-4 py-3 border-t border-gray-200 dark:border-gray-700 sm:px-6">
		<div class="flex items-center justify-between">
			<div class="flex items-center text-sm text-gray-700 dark:text-gray-300">
				<span>
					Showing { formatNumber((pagination.CurrentPage-1)*pagination.ItemsPerPage + 1) } to { formatNumber(minInt(pagination.CurrentPage*pagination.ItemsPerPage, int(pagination.TotalItems))) } of { formatNumber(int(pagination.TotalItems)) } results
				</span>
			</div>
			
			<div class="flex items-center space-x-2">
				<!-- Previous Button -->
				if pagination.HasPrev {
					@atoms.Button(atoms.ButtonProps{
						Icon:     "chevron-left",
						Variant:  atoms.ButtonSecondary,
						Size:     atoms.ButtonSizeSM,
						HxGet:    dataUrl + "?page=" + formatNumber(pagination.CurrentPage-1),
						HxTarget: "#tenant-table-body",
						HxSwap:   "outerHTML",
						AriaLabel:    "Previous page",
						Class:    "px-3",
					})
				} else {
					@atoms.Button(atoms.ButtonProps{
						Icon:     "chevron-left",
						Variant:  atoms.ButtonSecondary,
						Size:     atoms.ButtonSizeSM,
						Disabled: true,
						Class:    "px-3",
					})
				}
				
				<!-- Page Numbers -->
				<div class="flex items-center space-x-1">
					for i := maxInt(1, pagination.CurrentPage-2); i <= minInt(pagination.TotalPages, pagination.CurrentPage+2); i++ {
						if i == pagination.CurrentPage {
							<span class="inline-flex items-center px-3 py-1 border border-blue-500 bg-blue-50 dark:bg-blue-900 text-sm font-medium text-blue-600 dark:text-blue-400 rounded-md">
								{ formatNumber(i) }
							</span>
						} else {
							@atoms.Button(atoms.ButtonProps{
								Text:     formatNumber(i),
								Variant:  atoms.ButtonSecondary,
								Size:     atoms.ButtonSizeSM,
								HxGet:    dataUrl + "?page=" + formatNumber(i),
								HxTarget: "#tenant-table-body",
								HxSwap:   "outerHTML",
								Class:    "px-3",
							})
						}
					}
				</div>
				
				<!-- Next Button -->
				if pagination.HasNext {
					@atoms.Button(atoms.ButtonProps{
						Icon:     "chevron-right",
						Variant:  atoms.ButtonSecondary,
						Size:     atoms.ButtonSizeSM,
						HxGet:    dataUrl + "?page=" + formatNumber(pagination.CurrentPage+1),
						HxTarget: "#tenant-table-body",
						HxSwap:   "outerHTML",
						AriaLabel:    "Next page",
						Class:    "px-3",
					})
				} else {
					@atoms.Button(atoms.ButtonProps{
						Icon:     "chevron-right",
						Variant:  atoms.ButtonSecondary,
						Size:     atoms.ButtonSizeSM,
						Disabled: true,
						Class:    "px-3",
					})
				}
			</div>
		</div>
	</div>
}

// Alpine.js component script
script tenantTable() {
	return {
		selectedTenants: [],
		selectAll: false,
		showFilters: false,
		activeFiltersCount: 0,
		sortField: '',
		sortDirection: 'asc',
		
		init() {
			// Initialize any needed data
			this.calculateActiveFilters();
		},
		
		toggleAllSelection() {
			if (this.selectAll) {
				// Select all visible tenants
				const checkboxes = this.$el.querySelectorAll('tbody input[type="checkbox"]');
				this.selectedTenants = Array.from(checkboxes).map(cb => cb.value);
			} else {
				this.selectedTenants = [];
			}
		},
		
		sort(field) {
			if (this.sortField === field) {
				this.sortDirection = this.sortDirection === 'asc' ? 'desc' : 'asc';
			} else {
				this.sortField = field;
				this.sortDirection = 'asc';
			}
			
			// Trigger HTMX request with sort parameters
			htmx.trigger('#tenant-table-body', 'load', {
				values: {
					sort: field,
					direction: this.sortDirection
				}
			});
		},
		
		clearFilter(key) {
			// Implementation for clearing specific filter
			console.log('Clear filter:', key);
		},
		
		calculateActiveFilters() {
			// Count active filters
			this.activeFiltersCount = 0;
		},
		
		exportSelected() {
			if (this.selectedTenants.length === 0) {
				alert('Please select tenants to export');
				return;
			}
			
			// Implementation for export
			console.log('Export selected:', this.selectedTenants);
		},
		
		bulkDeactivate() {
			if (this.selectedTenants.length === 0) {
				alert('Please select tenants to deactivate');
				return;
			}
			
			if (confirm(`Are you sure you want to deactivate ${this.selectedTenants.length} tenants?`)) {
				// Implementation for bulk deactivation
				console.log('Bulk deactivate:', this.selectedTenants);
			}
		}
	}
}

// Helper functions
func getCreateButtonText(text string) string {
	if text != "" {
		return text
	}
	return "Create Tenant"
}

func getInitials(name string) string {
	if len(name) == 0 {
		return "?"
	}
	
	words := splitWords(name)
	if len(words) == 0 {
		return string(name[0])
	}
	
	if len(words) == 1 {
		return string(name[0])
	}
	
	return string(words[0][0]) + string(words[1][0])
}

func getTenantStatusClasses(status string) string {
	switch status {
	case "ACTIVE":
		return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200"
	case "TRIAL":
		return "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200"
	case "SUSPENDED":
		return "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200"
	case "CANCELLED":
		return "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200"
	default:
		return "bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200"
	}
}

func getTenantStatusDotClasses(status string) string {
	switch status {
	case "ACTIVE":
		return "bg-green-400"
	case "TRIAL":
		return "bg-blue-400"
	case "SUSPENDED":
		return "bg-yellow-400"
	case "CANCELLED":
		return "bg-red-400"
	default:
		return "bg-gray-400"
	}
}

func formatTenantStatus(status string) string {
	switch status {
	case "ACTIVE":
		return "Active"
	case "TRIAL":
		return "Trial"
	case "SUSPENDED":
		return "Suspended"
	case "CANCELLED":
		return "Cancelled"
	default:
		return status
	}
}

