package notifications

import (
	"github.com/niiniyare/erp/web/components/atoms"
)

// NotificationListProps defines properties for the notification list component
type NotificationListProps struct {
	Title         string         `json:"title"`
	Subtitle      string         `json:"subtitle,omitempty"`
	Notifications []Notification `json:"notifications"`
	ShowActions   bool           `json:"showActions"`
	Compact       bool           `json:"compact"`
	MaxItems      int            `json:"maxItems,omitempty"`
	
	// Pagination
	HasMore    bool   `json:"hasMore"`
	LoadMoreURL string `json:"loadMoreUrl,omitempty"`
	
	// Actions
	MarkAllReadURL string `json:"markAllReadUrl,omitempty"`
	ClearAllURL    string `json:"clearAllUrl,omitempty"`
}

// Notification represents a single notification
type Notification struct {
	ID          string `json:"id"`
	Title       string `json:"title"`
	Message     string `json:"message"`
	Type        string `json:"type"`        // info, success, warning, error
	Category    string `json:"category"`    // system, user, invoice, etc.
	IsRead      bool   `json:"isRead"`
	CreatedAt   string `json:"createdAt"`
	ActionURL   string `json:"actionUrl,omitempty"`
	ActionText  string `json:"actionText,omitempty"`
	
	// Rich content
	Icon        string            `json:"icon,omitempty"`
	Avatar      string            `json:"avatar,omitempty"`
	AvatarName  string            `json:"avatarName,omitempty"`
	Metadata    map[string]string `json:"metadata,omitempty"`
}

// NotificationList renders a list of notifications
templ NotificationList(props NotificationListProps) {
	<div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg">
		<!-- Header -->
		if props.Title != "" || props.ShowActions {
			<div class="flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-700">
				<div>
					<h3 class="text-lg font-medium text-gray-900 dark:text-white">
						{ getNotificationTitle(props.Title) }
					</h3>
					if props.Subtitle != "" {
						<p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
							{ props.Subtitle }
						</p>
					}
				</div>
				
				if props.ShowActions {
					<div class="flex items-center space-x-2">
						if props.MarkAllReadURL != "" {
							@atoms.Button(atoms.ButtonProps{
								Text:     "Mark all read",
								Variant:  atoms.VariantSecondary,
								Size:     atoms.SizeSM,
								HxPost:   props.MarkAllReadURL,
								HxTarget: "#notification-list",
								HxSwap:   "outerHTML",
							})
						}
						
						if props.ClearAllURL != "" {
							@atoms.Button(atoms.ButtonProps{
								Text:     "Clear all",
								Variant:  atoms.VariantSecondary,
								Size:     atoms.SizeSM,
								HxDelete: props.ClearAllURL,
								HxTarget: "#notification-list",
								HxSwap:   "outerHTML",
								HxConfirm: "Clear all notifications?",
							})
						}
					</div>
				}
			</div>
		}
		
		<!-- Notification Items -->
		<div class="divide-y divide-gray-200 dark:divide-gray-700">
			if len(props.Notifications) == 0 {
				@EmptyNotifications()
			} else {
				for i, notification := range props.Notifications {
					if props.MaxItems == 0 || i < props.MaxItems {
						@NotificationItem(notification, props.Compact)
					}
				}
			}
		</div>
		
		<!-- Load More -->
		if props.HasMore && props.LoadMoreURL != "" {
			<div class="p-4 text-center border-t border-gray-200 dark:border-gray-700">
				@atoms.Button(atoms.ButtonProps{
					Text:     "Load more notifications",
					Variant:  atoms.VariantSecondary,
					Size:     atoms.SizeMD,
					HxGet:    props.LoadMoreURL,
					HxTarget: "#notification-list",
					HxSwap:   "beforeend",
				})
			</div>
		}
	</div>
}

// NotificationItem renders a single notification item
templ NotificationItem(notification Notification, compact bool) {
	<div class={ getNotificationItemClasses(notification, compact) }>
		<div class="flex items-start space-x-3">
			<!-- Icon or Avatar -->
			<div class="flex-shrink-0 mt-1">
				if notification.Avatar != "" {
					<div class="h-8 w-8 rounded-full bg-gray-300 dark:bg-gray-600 flex items-center justify-center">
						<span class="text-xs font-medium text-gray-700 dark:text-gray-300">
							{ getAvatarInitials(notification.AvatarName) }
						</span>
					</div>
				} else {
					<div class={ getNotificationIconWrapper(notification.Type) }>
						@atoms.Icon(atoms.IconProps{
							Name:  getNotificationIcon(notification.Type, notification.Icon),
							Size:  atoms.IconSizeXS,
							Class: getNotificationIconColor(notification.Type),
						})
					</div>
				}
			</div>
			
			<!-- Content -->
			<div class="flex-1 min-w-0">
				<div class="flex items-start justify-between">
					<div class="flex-1">
						<p class={ getNotificationTitleClasses(notification.IsRead, compact) }>
							{ notification.Title }
						</p>
						
						if notification.Message != "" {
							<p class={ getNotificationMessageClasses(compact) }>
								{ notification.Message }
							</p>
						}
						
						<div class="flex items-center space-x-2 mt-1">
							<span class="text-xs text-gray-500 dark:text-gray-400">
								{ notification.CreatedAt }
							</span>
							
							if notification.Category != "" {
								<span class="text-xs text-gray-400 dark:text-gray-500">•</span>
								<span class="text-xs text-gray-500 dark:text-gray-400">
									{ notification.Category }
								</span>
							}
						</div>
					</div>
					
					<!-- Actions -->
					<div class="flex items-center space-x-2 ml-4">
						if notification.ActionURL != "" && notification.ActionText != "" {
							<a 
								href={ notification.ActionURL }
								class="text-sm font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300"
							>
								{ notification.ActionText }
							</a>
						}
						
						<!-- Mark as read/unread -->
						if !notification.IsRead {
							<button 
								type="button"
								class="text-xs text-blue-600 hover:text-blue-500 dark:text-blue-400"
								hx-post={ "/notifications/" + notification.ID + "/mark-read" }
								hx-target="closest .notification-item"
								hx-swap="outerHTML"
							>
								Mark read
							</button>
						}
						
						<!-- Delete notification -->
						<button 
							type="button"
							class="text-xs text-gray-500 hover:text-red-500 dark:text-gray-400 dark:hover:text-red-400"
							hx-delete={ "/notifications/" + notification.ID }
							hx-target="closest .notification-item"
							hx-swap="outerHTML"
							hx-confirm="Delete this notification?"
						>
							@atoms.Icon(atoms.IconProps{
								Name:  "x-mark",
								Size:  atoms.IconSizeXS,
								Class: "text-current",
							})
						</button>
					</div>
				</div>
			</div>
		</div>
		
		<!-- Read indicator -->
		if !notification.IsRead {
			<div class="absolute top-3 left-1 w-2 h-2 bg-blue-600 rounded-full"></div>
		}
	</div>
}

// EmptyNotifications renders empty state
templ EmptyNotifications() {
	<div class="p-8 text-center">
		<div class="flex justify-center mb-4">
			@atoms.Icon(atoms.IconProps{
				Name:  "bell-slash",
				Size:  atoms.IconSizeLG,
				Class: "text-gray-400 dark:text-gray-500",
			})
		</div>
		
		<h3 class="text-sm font-medium text-gray-900 dark:text-white mb-1">
			No notifications
		</h3>
		
		<p class="text-sm text-gray-600 dark:text-gray-400">
			You're all caught up! New notifications will appear here.
		</p>
	</div>
}

// Helper functions
func getNotificationTitle(title string) string {
	if title == "" {
		return "Notifications"
	}
	return title
}

func getNotificationItemClasses(notification Notification, compact bool) string {
	baseClasses := "notification-item relative p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors duration-150"
	
	if !notification.IsRead {
		baseClasses += " bg-blue-50/50 dark:bg-blue-900/10"
	}
	
	if compact {
		baseClasses = "notification-item relative p-3 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors duration-150"
	}
	
	return baseClasses
}

func getNotificationTitleClasses(isRead bool, compact bool) string {
	classes := "text-sm text-gray-900 dark:text-white"
	
	if !isRead {
		classes += " font-medium"
	}
	
	if compact {
		classes = "text-xs text-gray-900 dark:text-white"
		if !isRead {
			classes += " font-medium"
		}
	}
	
	return classes
}

func getNotificationMessageClasses(compact bool) string {
	if compact {
		return "text-xs text-gray-600 dark:text-gray-400 mt-0.5"
	}
	return "text-sm text-gray-600 dark:text-gray-400 mt-1"
}

func getNotificationIcon(notificationType, customIcon string) string {
	if customIcon != "" {
		return customIcon
	}
	
	switch notificationType {
	case "success":
		return "check-circle"
	case "warning":
		return "exclamation-triangle"
	case "error":
		return "x-circle"
	default:
		return "information-circle"
	}
}

func getNotificationIconColor(notificationType string) string {
	switch notificationType {
	case "success":
		return "text-green-600 dark:text-green-400"
	case "warning":
		return "text-yellow-600 dark:text-yellow-400"
	case "error":
		return "text-red-600 dark:text-red-400"
	default:
		return "text-blue-600 dark:text-blue-400"
	}
}

func getNotificationIconWrapper(notificationType string) string {
	baseClasses := "flex items-center justify-center w-6 h-6 rounded-full"
	
	switch notificationType {
	case "success":
		return baseClasses + " bg-green-100 dark:bg-green-900/20"
	case "warning":
		return baseClasses + " bg-yellow-100 dark:bg-yellow-900/20"
	case "error":
		return baseClasses + " bg-red-100 dark:bg-red-900/20"
	default:
		return baseClasses + " bg-blue-100 dark:bg-blue-900/20"
	}
}

func getAvatarInitials(name string) string {
	if name == "" {
		return "?"
	}
	// Simple implementation - take first character
	return name[:1]
}