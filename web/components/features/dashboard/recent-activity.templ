package dashboard

import (
	"fmt"
	"strings"
	"github.com/niiniyare/erp/web/components/atoms"
)

// RecentActivityProps defines properties for the recent activity widget
type RecentActivityProps struct {
	Title       string         `json:"title,omitempty"`
	Activities  []Activity     `json:"activities"`
	ShowMore    bool           `json:"showMore"`
	MoreUrl     string         `json:"moreUrl,omitempty"`
	MaxItems    int            `json:"maxItems,omitempty"`      // Limit displayed items
	ShowAvatars bool           `json:"showAvatars"`             // Show user avatars
	ShowIcons   bool           `json:"showIcons"`               // Show activity type icons
	ShowTimes   bool           `json:"showTimes"`               // Show relative times
	GroupByDate bool           `json:"groupByDate"`             // Group activities by date
	Realtime    bool           `json:"realtime"`                // Real-time updates
	RefreshUrl  string         `json:"refreshUrl,omitempty"`    // Auto-refresh endpoint
	RefreshInterval int        `json:"refreshInterval,omitempty"` // Refresh interval in seconds
	EmptyMessage string        `json:"emptyMessage,omitempty"`  // Custom empty state message
}

// Activity represents a single activity item
type Activity struct {
	ID          string      `json:"id"`
	Type        string      `json:"type"`        // login, create, update, delete, etc.
	Title       string      `json:"title"`       // Main activity description
	Description string      `json:"description,omitempty"` // Additional details
	Time        string      `json:"time"`        // Timestamp
	RelativeTime string     `json:"relativeTime,omitempty"` // "2 hours ago"
	
	// User information
	User        *ActivityUser `json:"user,omitempty"`
	
	// Activity target/object
	Target      *ActivityTarget `json:"target,omitempty"`
	
	// Visual styling
	Icon        string      `json:"icon,omitempty"`
	Color       string      `json:"color,omitempty"`      // Color theme
	Priority    string      `json:"priority,omitempty"`   // high, medium, low
	
	// Actions
	Actions     []ActivityAction `json:"actions,omitempty"`
	ViewUrl     string      `json:"viewUrl,omitempty"`    // Link to full details
	
	// Grouping
	Date        string      `json:"date,omitempty"`       // For date grouping (YYYY-MM-DD)
	Category    string      `json:"category,omitempty"`   // Activity category
	
	// State
	Read        bool        `json:"read"`                 // Has been viewed
	Important   bool        `json:"important"`            // Mark as important
}

// ActivityUser represents the user who performed the activity
type ActivityUser struct {
	ID     string `json:"id"`
	Name   string `json:"name"`
	Avatar string `json:"avatar,omitempty"`
	Email  string `json:"email,omitempty"`
	Role   string `json:"role,omitempty"`
}

// ActivityTarget represents the object/target of the activity
type ActivityTarget struct {
	Type string `json:"type"`        // user, project, document, etc.
	ID   string `json:"id"`
	Name string `json:"name"`
	Url  string `json:"url,omitempty"`
}

// ActivityAction represents an action that can be taken on an activity
type ActivityAction struct {
	Text    string `json:"text"`
	Icon    string `json:"icon,omitempty"`
	Href    string `json:"href,omitempty"`
	OnClick string `json:"onClick,omitempty"`
	HxGet   string `json:"hxGet,omitempty"`
	HxPost  string `json:"hxPost,omitempty"`
	HxTarget string `json:"hxTarget,omitempty"`
	Primary bool   `json:"primary"`
}

// RecentActivity renders a recent activity feed widget
templ RecentActivity(props RecentActivityProps) {
	<div 
		class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg"
		if props.Realtime && props.RefreshUrl != "" && props.RefreshInterval > 0 {
			hx-get={ props.RefreshUrl }
			hx-trigger={ fmt.Sprintf("every %ds", props.RefreshInterval) }
			hx-target="this"
			hx-swap="outerHTML"
		}
	>
		<!-- Header -->
		<div class="p-4 border-b border-gray-200 dark:border-gray-700">
			<div class="flex items-center justify-between">
				<h3 class="text-lg font-medium text-gray-900 dark:text-white">
					{ getActivityTitle(props.Title) }
				</h3>
				
				<div class="flex items-center space-x-2">
					<!-- Refresh Button -->
					if props.RefreshUrl != "" {
						<button
							type="button"
							hx-get={ props.RefreshUrl }
							hx-target="[data-activity-feed]"
							hx-swap="innerHTML"
							class="p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
							title="Refresh activities"
						>
							@atoms.Icon(atoms.IconProps{
								Name: "refresh",
								Size: atoms.IconSizeXS,
							})
						</button>
					}
					
					<!-- View More -->
					if props.ShowMore && props.MoreUrl != "" {
						<a 
							href={ props.MoreUrl }
							class="text-sm font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300"
						>
							View all
						</a>
					}
				</div>
			</div>
		</div>
		
		<!-- Activity Feed -->
		<div class="max-h-96 overflow-y-auto" data-activity-feed>
			if len(props.Activities) == 0 {
				@ActivityEmptyState(props.EmptyMessage)
			} else if props.GroupByDate {
				@GroupedActivityList(props)
			} else {
				@ActivityList(props)
			}
		</div>
	</div>
}

// ActivityList renders a simple activity list
templ ActivityList(props RecentActivityProps) {
	<div class="divide-y divide-gray-200 dark:divide-gray-700">
		for i, activity := range props.Activities {
			if props.MaxItems == 0 || i < props.MaxItems {
				@ActivityItem(activity, props)
			}
		}
	</div>
}

// GroupedActivityList renders activities grouped by date
templ GroupedActivityList(props RecentActivityProps) {
	<div class="space-y-4 p-4">
		for date, activities := range groupActivitiesByDate(props.Activities) {
			<div>
				<!-- Date Header -->
				<div class="flex items-center mb-3">
					<h4 class="text-sm font-medium text-gray-900 dark:text-white">
						{ formatActivityDate(date) }
					</h4>
					<div class="ml-3 flex-1 border-t border-gray-200 dark:border-gray-700"></div>
				</div>
				
				<!-- Activities for this date -->
				<div class="space-y-3">
					for _, activity := range activities {
						@ActivityItem(activity, props)
					}
				</div>
			</div>
		}
	</div>
}

// ActivityItem renders a single activity item
templ ActivityItem(activity Activity, props RecentActivityProps) {
	<div class={ "p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors duration-150", getActivityItemClasses(activity) }>
		<div class="flex space-x-3">
			<!-- Avatar or Icon -->
			<div class="flex-shrink-0">
				if props.ShowAvatars && activity.User != nil && activity.User.Avatar != "" {
					@UserAvatar(activity.User)
				} else if props.ShowIcons && activity.Icon != "" {
					@ActivityIcon(activity)
				} else {
					@DefaultActivityIcon(activity.Type)
				}
			</div>
			
			<!-- Content -->
			<div class="flex-1 min-w-0">
				<div class="flex items-start justify-between">
					<!-- Activity Description -->
					<div class="flex-1 min-w-0">
						<p class="text-sm text-gray-900 dark:text-white">
							@ActivityDescription(activity)
						</p>
						
						if activity.Description != "" {
							<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
								{ activity.Description }
							</p>
						}
						
						<!-- Time and Metadata -->
						<div class="mt-1 flex items-center space-x-2 text-xs text-gray-500 dark:text-gray-400">
							if props.ShowTimes {
								<span>{ getActivityTime(activity) }</span>
							}
							
							if activity.Category != "" {
								<span>•</span>
								<span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">
									{ activity.Category }
								</span>
							}
						</div>
					</div>
					
					<!-- Activity Actions -->
					if len(activity.Actions) > 0 {
						@ActivityActions(activity.Actions)
					}
				</div>
			</div>
			
			<!-- Priority Indicator -->
			if activity.Priority == "high" || activity.Important {
				<div class="flex-shrink-0">
					@atoms.Icon(atoms.IconProps{
						Name:  "exclamation",
						Size:  atoms.IconSizeXS,
						Class: "text-red-500",
					})
				</div>
			}
		</div>
	</div>
}

// UserAvatar renders a user avatar for activity
templ UserAvatar(user *ActivityUser) {
	if user.Avatar != "" {
		<img 
			class="h-8 w-8 rounded-full"
			src={ user.Avatar }
			alt={ user.Name + " avatar" }
			title={ user.Name }
		/>
	} else {
		<div class="h-8 w-8 rounded-full bg-gray-300 dark:bg-gray-600 flex items-center justify-center">
			<span class="text-xs font-medium text-gray-700 dark:text-gray-300">
				{ getUserInitials(user.Name) }
			</span>
		</div>
	}
}

// ActivityIcon renders an activity type icon
templ ActivityIcon(activity Activity) {
	<div class={ "h-8 w-8 rounded-full flex items-center justify-center", getActivityIconWrapperClasses(activity.Color) }>
		@atoms.Icon(atoms.IconProps{
			Name:  activity.Icon,
			Size:  atoms.IconSizeXS,
			Class: getActivityIconClasses(activity.Color),
		})
	</div>
}

// DefaultActivityIcon renders a default icon based on activity type
templ DefaultActivityIcon(activityType string) {
	<div class="h-8 w-8 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center">
		@atoms.Icon(atoms.IconProps{
			Name:  getDefaultActivityIcon(activityType),
			Size:  atoms.IconSizeXS,
			Class: "text-gray-600 dark:text-gray-400",
		})
	</div>
}

// ActivityDescription renders the main activity description with rich formatting
templ ActivityDescription(activity Activity) {
	if activity.User != nil {
		<span class="font-medium">{ activity.User.Name }</span>
		<span> { activity.Title }</span>
	} else {
		<span>{ activity.Title }</span>
	}
	
	<!-- Target object link -->
	if activity.Target != nil {
		<span> </span>
		if activity.Target.Url != "" {
			<a 
				href={ activity.Target.Url }
				class="font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300"
			>
				{ activity.Target.Name }
			</a>
		} else {
			<span class="font-medium">{ activity.Target.Name }</span>
		}
	}
}

// ActivityActions renders action buttons for an activity
templ ActivityActions(actions []ActivityAction) {
	<div class="flex items-center space-x-1">
		for _, action := range actions {
			@ActivityActionButton(action)
		}
	</div>
}

// ActivityActionButton renders a single activity action button
templ ActivityActionButton(action ActivityAction) {
	if action.Href != "" {
		<a
			href={ action.Href }
			class={ "inline-flex items-center px-2 py-1 text-xs font-medium rounded border border-transparent hover:bg-gray-100 dark:hover:bg-gray-600", getActionButtonClasses(action.Primary) }
		>
			if action.Icon != "" {
				@atoms.Icon(atoms.IconProps{
					Name:  action.Icon,
					Size:  atoms.IconSizeXS,
					Class: "mr-1",
				})
			}
			{ action.Text }
		</a>
	} else {
		<button
			type="button"
			@click={ action.OnClick }
			if action.HxGet != "" {
				hx-get={ action.HxGet }
			}
			if action.HxPost != "" {
				hx-post={ action.HxPost }
			}
			if action.HxTarget != "" {
				hx-target={ action.HxTarget }
			}
			class={ "inline-flex items-center px-2 py-1 text-xs font-medium rounded border border-transparent hover:bg-gray-100 dark:hover:bg-gray-600", getActionButtonClasses(action.Primary) }
		>
			if action.Icon != "" {
				@atoms.Icon(atoms.IconProps{
					Name:  action.Icon,
					Size:  atoms.IconSizeXS,
					Class: "mr-1",
				})
			}
			{ action.Text }
		</button>
	}
}

// ActivityEmptyState renders an empty state when no activities are present
templ ActivityEmptyState(customMessage string) {
	<div class="text-center py-8">
		@atoms.Icon(atoms.IconProps{
			Name:  "clock",
			Size:  "48",
			Class: "mx-auto text-gray-400 mb-4",
		})
		<h3 class="text-sm font-medium text-gray-900 dark:text-white mb-1">
			No recent activity
		</h3>
		<p class="text-xs text-gray-500 dark:text-gray-400">
			{ getEmptyStateMessage(customMessage) }
		</p>
	</div>
}

// ActivityCompact renders a compact horizontal activity list
templ ActivityCompact(activities []Activity, maxItems int) {
	<div class="space-y-2">
		for i, activity := range activities {
			if maxItems == 0 || i < maxItems {
				<div class="flex items-center space-x-2 text-sm">
					<div class="flex-shrink-0">
						@DefaultActivityIcon(activity.Type)
					</div>
					<div class="flex-1 min-w-0">
						<p class="text-gray-900 dark:text-white truncate">
							{ activity.Title }
						</p>
					</div>
					<div class="flex-shrink-0 text-xs text-gray-500 dark:text-gray-400">
						{ activity.RelativeTime }
					</div>
				</div>
			}
		}
	</div>
}

// Helper functions
func getActivityTitle(title string) string {
	if title == "" {
		return "Recent Activity"
	}
	return title
}

func getActivityTime(activity Activity) string {
	if activity.RelativeTime != "" {
		return activity.RelativeTime
	}
	return activity.Time
}

func getActivityItemClasses(activity Activity) string {
	classes := ""
	
	if !activity.Read {
		classes += " bg-blue-50 dark:bg-blue-900/10 border-l-2 border-blue-500"
	}
	
	if activity.Important {
		classes += " bg-yellow-50 dark:bg-yellow-900/10"
	}
	
	return classes
}

func getActivityIconWrapperClasses(color string) string {
	switch color {
	case "blue":
		return "bg-blue-100 dark:bg-blue-900/20"
	case "green":
		return "bg-green-100 dark:bg-green-900/20"
	case "yellow":
		return "bg-yellow-100 dark:bg-yellow-900/20"
	case "red":
		return "bg-red-100 dark:bg-red-900/20"
	case "purple":
		return "bg-purple-100 dark:bg-purple-900/20"
	default:
		return "bg-gray-100 dark:bg-gray-700"
	}
}

func getActivityIconClasses(color string) string {
	switch color {
	case "blue":
		return "text-blue-600 dark:text-blue-400"
	case "green":
		return "text-green-600 dark:text-green-400"
	case "yellow":
		return "text-yellow-600 dark:text-yellow-400"
	case "red":
		return "text-red-600 dark:text-red-400"
	case "purple":
		return "text-purple-600 dark:text-purple-400"
	default:
		return "text-gray-600 dark:text-gray-400"
	}
}

func getDefaultActivityIcon(activityType string) string {
	switch activityType {
	case "login":
		return "login"
	case "create":
		return "plus"
	case "update":
		return "pencil"
	case "delete":
		return "trash"
	case "view":
		return "eye"
	case "comment":
		return "chat"
	case "upload":
		return "upload"
	case "download":
		return "download"
	default:
		return "bell"
	}
}

func getUserInitials(name string) string {
	if len(name) == 0 {
		return "?"
	}
	if len(name) == 1 {
		return string(name[0])
	}
	
	parts := strings.Fields(name)
	if len(parts) >= 2 {
		return string(parts[0][0]) + string(parts[1][0])
	}
	
	return string(name[0])
}

func getActionButtonClasses(primary bool) string {
	if primary {
		return "text-blue-600 dark:text-blue-400 hover:text-blue-500 dark:hover:text-blue-300"
	}
	return "text-gray-600 dark:text-gray-400 hover:text-gray-500 dark:hover:text-gray-300"
}

func getEmptyStateMessage(customMessage string) string {
	if customMessage != "" {
		return customMessage
	}
	return "When activity happens, it will appear here."
}

func groupActivitiesByDate(activities []Activity) map[string][]Activity {
	grouped := make(map[string][]Activity)
	for _, activity := range activities {
		date := activity.Date
		if date == "" {
			date = "today" // fallback
		}
		grouped[date] = append(grouped[date], activity)
	}
	return grouped
}

func formatActivityDate(date string) string {
	switch date {
	case "today":
		return "Today"
	case "yesterday":
		return "Yesterday"
	default:
		return date
	}
}