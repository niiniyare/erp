package usermanagement

import (
	"github.com/niiniyare/erp/web/components/atoms"
)

// RoleSelectorProps defines properties for role assignment interface
type RoleSelectorProps struct {
	UserID          string                 `json:"userId"`
	CurrentRole     string                 `json:"currentRole"`
	AvailableRoles  []Role                 `json:"availableRoles"`
	CanAssignRoles  []string               `json:"canAssignRoles"`      // Roles current user can assign
	ShowPermissions bool                   `json:"showPermissions"`     // Show permission details
	HxPost          string                 `json:"hxPost,omitempty"`
	HxTarget        string                 `json:"hxTarget,omitempty"`
	OnChange        string                 `json:"onChange,omitempty"`
}

// Role represents a system role with permissions
type Role struct {
	ID          string       `json:"id"`
	Name        string       `json:"name"`
	DisplayName string       `json:"displayName"`
	Description string       `json:"description"`
	Level       int          `json:"level"`          // Role hierarchy level
	Permissions []Permission `json:"permissions"`
	Color       string       `json:"color"`          // Badge color
	Icon        string       `json:"icon,omitempty"`
	Active      bool         `json:"active"`
	System      bool         `json:"system"`         // System role (cannot be deleted)
}

// Permission represents a system permission
type Permission struct {
	ID          string `json:"id"`
	Name        string `json:"name"`
	DisplayName string `json:"displayName"`
	Description string `json:"description"`
	Category    string `json:"category"`
	Resource    string `json:"resource"`    // e.g., "users", "projects", "finance"
	Action      string `json:"action"`      // e.g., "create", "read", "update", "delete"
	Scope       string `json:"scope"`       // e.g., "own", "department", "all"
}

// RoleSelector renders an advanced role assignment interface
templ RoleSelector(props RoleSelectorProps) {
	<div 
		class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg"
		x-data="roleSelector()"
		x-init="init()"
	>
		<!-- Header -->
		<div class="p-4 border-b border-gray-200 dark:border-gray-700">
			<h3 class="text-lg font-medium text-gray-900 dark:text-white">
				Role Assignment
			</h3>
			<p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
				Assign roles to control user permissions and access levels
			</p>
		</div>

		<!-- Role Selection -->
		<div class="p-4">
			<form 
				if props.HxPost != "" {
					hx-post={ props.HxPost }
				}
				if props.HxTarget != "" {
					hx-target={ props.HxTarget }
				}
				hx-swap="innerHTML"
				@submit="loading = true"
				@htmx:after-request="loading = false"
			>
				<input type="hidden" name="user_id" value={ props.UserID } />
				
				<!-- Current Role Display -->
				<div class="mb-6">
					<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
						Current Role
					</label>
					<div class="flex items-center space-x-2">
						@RoleBadge(getCurrentRole(props.AvailableRoles, props.CurrentRole))
						<span class="text-sm text-gray-500 dark:text-gray-400">
							{ getRoleDescription(props.AvailableRoles, props.CurrentRole) }
						</span>
					</div>
				</div>

				<!-- Role Grid -->
				<div class="space-y-4">
					<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Select New Role
					</label>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
						for _, role := range props.AvailableRoles {
							if canAssignRole(props.CanAssignRoles, role.ID) {
								@RoleCard(role, props.CurrentRole, props.ShowPermissions)
							}
						}
					</div>
				</div>

				<!-- Role Comparison -->
				<div 
					x-show="selectedRole && selectedRole !== currentRole"
					x-transition
					class="mt-6 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg"
				>
					<h4 class="font-medium text-blue-900 dark:text-blue-300 mb-3">
						Role Change Summary
					</h4>
					<div class="space-y-2">
						<div class="flex items-center text-sm">
							<span class="text-blue-700 dark:text-blue-300">From:</span>
							<span class="ml-2 font-medium" x-text="getCurrentRoleName()"></span>
						</div>
						<div class="flex items-center text-sm">
							<span class="text-blue-700 dark:text-blue-300">To:</span>
							<span class="ml-2 font-medium" x-text="getSelectedRoleName()"></span>
						</div>
					</div>
				</div>

				<!-- Permission Preview -->
				if props.ShowPermissions {
					<div 
						x-show="selectedRole"
						x-transition
						class="mt-6"
					>
						<h4 class="font-medium text-gray-900 dark:text-white mb-3">
							Permissions for Selected Role
						</h4>
						<div 
							id="permission-preview"
							hx-get={ "/admin/roles/" + "{roleId}" + "/permissions" }
							hx-trigger="roleChanged from:body"
							hx-swap="innerHTML"
							class="space-y-4"
						>
							<!-- Permissions will be loaded dynamically -->
						</div>
					</div>
				}

				<!-- Action Buttons -->
				<div class="flex items-center justify-between mt-8 pt-4 border-t border-gray-200 dark:border-gray-700">
					<div class="text-sm text-gray-500 dark:text-gray-400">
						<span x-show="!selectedRole || selectedRole === currentRole">
							No changes to apply
						</span>
						<span x-show="selectedRole && selectedRole !== currentRole">
							Role change requires confirmation
						</span>
					</div>
					
					<div class="flex items-center space-x-3">
						@atoms.Button(atoms.ButtonProps{
							Text:     "Cancel",
							Variant:  atoms.ButtonLight,
							Size:     atoms.ButtonSizeSM,
							Type:     "button",
							OnClick:  "resetSelection()",
						})

						<div x-show="selectedRole && selectedRole !== currentRole">
							@atoms.Button(atoms.ButtonProps{
								Text:     "Apply Role Change",
								Icon:     "check",
								Variant:  atoms.ButtonPrimary,
								Size:     atoms.ButtonSizeSM,
								Type:     "submit",
								Loading:  false,
							})
						</div>
					</div>
				</div>
			</form>
		</div>
	</div>
}

// RoleCard renders a selectable role card
templ RoleCard(role Role, currentRole string, showPermissions bool) {
	<div 
		class={ "relative border-2 rounded-lg p-4 cursor-pointer transition-all duration-200", getRoleCardClasses(role, currentRole) }
		@click={ "selectRole('" + role.ID + "')" }
		:class={ "{ 'ring-2 ring-blue-500 border-blue-500': selectedRole === '" + role.ID + "' }" }
	>
		<!-- Selection Indicator -->
		<div class="absolute top-2 right-2">
			<input 
				type="radio" 
				name="role" 
				value={ role.ID }
				:checked={ "selectedRole === '" + role.ID + "'" }
				class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300"
			/>
		</div>

		<!-- Role Header -->
		<div class="space-y-2 pr-6">
			<div class="flex items-center space-x-2">
				if role.Icon != "" {
					@atoms.Icon(atoms.IconProps{
						Name:  role.Icon,
						Size:  atoms.IconSizeSM,
						Class: "text-gray-600 dark:text-gray-400",
					})
				}
				<h4 class="font-medium text-gray-900 dark:text-white">
					{ role.DisplayName }
				</h4>
				if role.ID == currentRole {
					<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">
						Current
					</span>
				}
			</div>

			<!-- Role Description -->
			<p class="text-sm text-gray-600 dark:text-gray-400">
				{ role.Description }
			</p>

			<!-- Role Level -->
			<div class="flex items-center space-x-2">
				<span class="text-xs text-gray-500 dark:text-gray-400">Level:</span>
				<div class="flex items-center">
					for i := 1; i <= 5; i++ {
						if i <= role.Level {
							<div class="w-2 h-2 bg-blue-500 rounded-full mr-1"></div>
						} else {
							<div class="w-2 h-2 bg-gray-300 dark:bg-gray-600 rounded-full mr-1"></div>
						}
					}
				</div>
			</div>

			<!-- Permission Count -->
			if showPermissions {
				<div class="text-xs text-gray-500 dark:text-gray-400">
					{ len(role.Permissions) } permissions
				</div>
			}
		</div>

		<!-- System Role Indicator -->
		if role.System {
			<div class="absolute bottom-2 right-2">
				@atoms.Icon(atoms.IconProps{
					Name:  "shield",
					Size:  atoms.IconSizeXS,
					Class: "text-blue-500",
				})
			</div>
		}
	</div>
}

// RoleBadge renders a role badge with color coding
templ RoleBadge(role Role) {
	<span class={ "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium", getRoleBadgeClasses(role) }>
		if role.Icon != "" {
			@atoms.Icon(atoms.IconProps{
				Name:  role.Icon,
				Size:  atoms.IconSizeXS,
				Class: "mr-1",
			})
		}
		{ role.DisplayName }
	</span>
}

// RoleQuickSelector renders a compact role dropdown
templ RoleQuickSelector(props RoleSelectorProps) {
	<div class="relative" x-data="{ open: false }">
		<button
			type="button"
			@click="open = !open"
			class="inline-flex items-center justify-between w-full px-3 py-2 text-sm bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
		>
			<span>{ getRoleDisplayName(props.AvailableRoles, props.CurrentRole) }</span>
			@atoms.Icon(atoms.IconProps{
				Name: "chevron-down",
				Size: atoms.IconSizeXS,
				Class: "ml-2",
			})
		</button>

		<div 
			x-show="open"
			@click.away="open = false"
			x-transition
			class="absolute z-10 mt-1 w-full bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md shadow-lg"
		>
			<div class="py-1">
				for _, role := range props.AvailableRoles {
					if canAssignRole(props.CanAssignRoles, role.ID) {
						<button
							type="button"
							@click={ "changeRole('" + role.ID + "'); open = false" }
							class={ "w-full text-left px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600", getQuickRoleClasses(role, props.CurrentRole) }
						>
							<div class="flex items-center justify-between">
								<span>{ role.DisplayName }</span>
								if role.ID == props.CurrentRole {
									@atoms.Icon(atoms.IconProps{
										Name: "check",
										Size: atoms.IconSizeXS,
										Class: "text-green-500",
									})
								}
							</div>
							<div class="text-xs text-gray-500 dark:text-gray-400 mt-1">
								{ role.Description }
							</div>
						</button>
					}
				}
			</div>
		</div>
	</div>
}

// JavaScript for role selector functionality
script roleSelector() {
	return {
		selectedRole: null,
		currentRole: '',
		loading: false,
		
		init() {
			this.currentRole = this.$el.dataset.currentRole;
			this.selectedRole = this.currentRole;
		},
		
		selectRole(roleId) {
			this.selectedRole = roleId;
			// Trigger permission preview update
			this.$dispatch('roleChanged', { roleId: roleId });
		},
		
		resetSelection() {
			this.selectedRole = this.currentRole;
		},
		
		getCurrentRoleName() {
			const role = this.getRoleById(this.currentRole);
			return role ? role.displayName : 'Unknown';
		},
		
		getSelectedRoleName() {
			const role = this.getRoleById(this.selectedRole);
			return role ? role.displayName : 'Unknown';
		},
		
		getRoleById(roleId) {
			// This would reference the roles data passed from server
			return window.availableRoles?.find(r => r.id === roleId);
		},
		
		changeRole(roleId) {
			// Quick role change for dropdown
			htmx.ajax('POST', this.$el.dataset.hxPost, {
				values: { user_id: this.$el.dataset.userId, role: roleId },
				target: this.$el.dataset.hxTarget
			});
		}
	}
}

// Helper functions
func getCurrentRole(roles []Role, currentRoleID string) Role {
	for _, role := range roles {
		if role.ID == currentRoleID {
			return role
		}
	}
	return Role{ID: currentRoleID, DisplayName: "Unknown Role"}
}

func getRoleDescription(roles []Role, roleID string) string {
	for _, role := range roles {
		if role.ID == roleID {
			return role.Description
		}
	}
	return ""
}

func getRoleDisplayName(roles []Role, roleID string) string {
	for _, role := range roles {
		if role.ID == roleID {
			return role.DisplayName
		}
	}
	return "Select Role"
}

func canAssignRole(allowedRoles []string, roleID string) bool {
	if len(allowedRoles) == 0 {
		return true // No restrictions
	}
	for _, allowed := range allowedRoles {
		if allowed == roleID {
			return true
		}
	}
	return false
}

func getRoleCardClasses(role Role, currentRole string) string {
	baseClasses := "border-gray-200 dark:border-gray-700 hover:border-blue-300 dark:hover:border-blue-600"
	if role.ID == currentRole {
		return baseClasses + " bg-green-50 dark:bg-green-900/20 border-green-300 dark:border-green-700"
	}
	return baseClasses + " bg-white dark:bg-gray-800"
}

func getRoleBadgeClasses(role Role) string {
	switch role.Color {
	case "red":
		return "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300"
	case "yellow":
		return "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300"
	case "green":
		return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300"
	case "blue":
		return "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300"
	case "purple":
		return "bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-300"
	default:
		return "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300"
	}
}

func getQuickRoleClasses(role Role, currentRole string) string {
	if role.ID == currentRole {
		return "bg-blue-50 dark:bg-blue-900/20 text-blue-900 dark:text-blue-300"
	}
	return "text-gray-900 dark:text-gray-300"
}