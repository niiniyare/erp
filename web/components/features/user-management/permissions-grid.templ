package usermanagement

import (
	"github.com/niiniyare/erp/web/components/atoms"
)

// PermissionsGridProps defines properties for the permissions management interface
type PermissionsGridProps struct {
	UserID           string                 `json:"userId,omitempty"`
	RoleID           string                 `json:"roleId,omitempty"`
	PermissionMatrix []PermissionCategory   `json:"permissionMatrix"`
	UserPermissions  []string               `json:"userPermissions"`     // User-specific permission overrides
	RolePermissions  []string               `json:"rolePermissions"`     // Permissions from role
	CanEditRoles     bool                   `json:"canEditRoles"`        // Can modify role permissions
	CanEditUsers     bool                   `json:"canEditUsers"`        // Can modify user permissions
	ShowInherited    bool                   `json:"showInherited"`       // Show inherited permissions
	ShowOverrides    bool                   `json:"showOverrides"`       // Show user overrides
	HxPost           string                 `json:"hxPost,omitempty"`
	HxTarget         string                 `json:"hxTarget,omitempty"`
}

// PermissionCategory groups related permissions
type PermissionCategory struct {
	ID          string       `json:"id"`
	Name        string       `json:"name"`
	Description string       `json:"description"`
	Icon        string       `json:"icon,omitempty"`
	Permissions []Permission `json:"permissions"`
	Collapsed   bool         `json:"collapsed"`
}

// PermissionsGrid renders a comprehensive permission management interface
templ PermissionsGrid(props PermissionsGridProps) {
	<div 
		class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg"
		x-data="permissionsGrid()"
		x-init="init()"
	>
		<!-- Header -->
		<div class="p-4 border-b border-gray-200 dark:border-gray-700">
			<div class="flex items-center justify-between">
				<div>
					<h3 class="text-lg font-medium text-gray-900 dark:text-white">
						Permission Management
					</h3>
					<p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
						Configure user permissions and role-based access control
					</p>
				</div>
				
				<!-- Controls -->
				<div class="flex items-center space-x-3">
					<!-- Permission Legend -->
					<div class="flex items-center space-x-2 text-xs">
						<div class="flex items-center space-x-1">
							<div class="w-3 h-3 bg-green-500 rounded-sm"></div>
							<span class="text-gray-600 dark:text-gray-400">Granted</span>
						</div>
						<div class="flex items-center space-x-1">
							<div class="w-3 h-3 bg-yellow-500 rounded-sm"></div>
							<span class="text-gray-600 dark:text-gray-400">Inherited</span>
						</div>
						<div class="flex items-center space-x-1">
							<div class="w-3 h-3 bg-red-500 rounded-sm"></div>
							<span class="text-gray-600 dark:text-gray-400">Denied</span>
						</div>
					</div>

					<!-- View Options -->
					<div class="flex items-center space-x-2">
						if props.ShowInherited {
							@atoms.Checkbox(atoms.CheckboxProps{
								ID:       "show-inherited",
								Label:    "Show Inherited",
								Checked:  true,
								OnChange: "toggleInherited()",
								Size:     "sm",
							})
						}
						
						if props.ShowOverrides {
							@atoms.Checkbox(atoms.CheckboxProps{
								ID:       "show-overrides",
								Label:    "Show Overrides",
								Checked:  true,
								OnChange: "toggleOverrides()",
								Size:     "sm",
							})
						}
					</div>
				</div>
			</div>
		</div>

		<!-- Permission Matrix -->
		<div class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, category := range props.PermissionMatrix {
				@PermissionCategorySection(category, props)
			}
		</div>

		<!-- Bulk Actions -->
		if props.CanEditUsers || props.CanEditRoles {
			<div class="p-4 bg-gray-50 dark:bg-gray-700/50 border-t border-gray-200 dark:border-gray-700">
				<div class="flex items-center justify-between">
					<div class="flex items-center space-x-4">
						<!-- Select All Options -->
						<div class="flex items-center space-x-2">
							@atoms.Button(atoms.ButtonProps{
								Text:    "Grant All",
								Icon:    "check-circle",
								Variant: atoms.VariantSecondary,
								Size:    atoms.SizeSM,
								OnClick: "grantAllPermissions()",
							})

							@atoms.Button(atoms.ButtonProps{
								Text:    "Revoke All",
								Icon:    "x-circle",
								Variant: atoms.ButtonLight,
								Size:    atoms.SizeSM,
								OnClick: "revokeAllPermissions()",
							})

							@atoms.Button(atoms.ButtonProps{
								Text:    "Reset to Role",
								Icon:    "refresh",
								Variant: atoms.ButtonLight,
								Size:    atoms.SizeSM,
								OnClick: "resetToRolePermissions()",
							})
						</div>
					</div>

					<!-- Save Changes -->
					<div class="flex items-center space-x-3">
						<div class="text-sm text-gray-500 dark:text-gray-400">
							<span x-show="hasChanges" x-text="`${changeCount} changes`"></span>
							<span x-show="!hasChanges">No changes</span>
						</div>

						<div x-show="hasChanges">
							@atoms.Button(atoms.ButtonProps{
								Text:     "Save Changes",
								Icon:     "save",
								Variant:  atoms.ButtonPrimary,
								Size:     atoms.SizeSM,
								HxPost:   props.HxPost,
								HxTarget: props.HxTarget,
								OnClick:  "savePermissions()",
								Loading:  false,
							})
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}

// PermissionCategorySection renders a collapsible category of permissions
templ PermissionCategorySection(category PermissionCategory, props PermissionsGridProps) {
	<div class="divide-y divide-gray-200 dark:divide-gray-700">
		<!-- Category Header -->
		<div 
			class="p-4 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700/50"
			@click={ "toggleCategory('" + category.ID + "')" }
		>
			<div class="flex items-center justify-between">
				<div class="flex items-center space-x-3">
					<!-- Expand/Collapse Icon -->
					<div class="transform transition-transform duration-200" :class="{ 'rotate-90': !categories[category.id]?.collapsed }">
						@atoms.Icon(atoms.IconProps{
							Name: "chevron-right",
							Size: atoms.IconSizeSM,
							Class: "text-gray-400",
						})
					</div>

					<!-- Category Icon -->
					if category.Icon != "" {
						@atoms.Icon(atoms.IconProps{
							Name:  category.Icon,
							Size:  atoms.IconSizeSM,
							Class: "text-gray-600 dark:text-gray-400",
						})
					}

					<!-- Category Info -->
					<div>
						<h4 class="font-medium text-gray-900 dark:text-white">
							{ category.Name }
						</h4>
						if category.Description != "" {
							<p class="text-sm text-gray-500 dark:text-gray-400">
								{ category.Description }
							</p>
						}
					</div>
				</div>

				<!-- Category Summary -->
				<div class="flex items-center space-x-2">
					<span class="text-sm text-gray-500 dark:text-gray-400">
						<span x-text={ "getCategoryGrantedCount('" + category.ID + "')" }></span>
						/
						<span>{ len(category.Permissions) }</span>
					</span>
					@PermissionCategoryToggle(category, props)
				</div>
			</div>
		</div>

		<!-- Category Permissions -->
		<div 
			x-show={ "!categories['" + category.ID + "']?.collapsed" }
			x-transition
			class="bg-gray-50 dark:bg-gray-700/20"
		>
			<div class="p-4">
				<!-- Permission Table Header -->
				<div class="grid grid-cols-12 gap-4 mb-4 text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
					<div class="col-span-5">Permission</div>
					<div class="col-span-2 text-center">Create</div>
					<div class="col-span-2 text-center">Read</div>
					<div class="col-span-2 text-center">Update</div>
					<div class="col-span-1 text-center">Delete</div>
				</div>

				<!-- Permission Rows -->
				<div class="space-y-2">
					for _, permission := range category.Permissions {
						@PermissionRow(permission, props, category.ID)
					}
				</div>
			</div>
		</div>
	</div>
}

// PermissionRow renders a single permission with CRUD toggles
templ PermissionRow(permission Permission, props PermissionsGridProps, categoryID string) {
	<div class="grid grid-cols-12 gap-4 items-center py-2 bg-white dark:bg-gray-800 rounded border border-gray-200 dark:border-gray-700">
		<!-- Permission Info -->
		<div class="col-span-5 px-3">
			<div class="flex items-center space-x-2">
				<div>
					<div class="font-medium text-gray-900 dark:text-white text-sm">
						{ permission.DisplayName }
					</div>
					if permission.Description != "" {
						<div class="text-xs text-gray-500 dark:text-gray-400">
							{ permission.Description }
						</div>
					}
				</div>
				
				<!-- Override Indicator -->
				<div x-show={ "hasOverride('" + permission.ID + "')" } title="User override">
					@atoms.Icon(atoms.IconProps{
						Name:  "star",
						Size:  atoms.IconSizeXS,
						Class: "text-yellow-500",
					})
				</div>
			</div>
		</div>

		<!-- CRUD Permissions -->
		<div class="col-span-2 flex justify-center">
			@PermissionToggle(permission.ID, "create", props)
		</div>
		<div class="col-span-2 flex justify-center">
			@PermissionToggle(permission.ID, "read", props)
		</div>
		<div class="col-span-2 flex justify-center">
			@PermissionToggle(permission.ID, "update", props)
		</div>
		<div class="col-span-1 flex justify-center">
			@PermissionToggle(permission.ID, "delete", props)
		</div>
	</div>
}

// PermissionToggle renders a three-state permission toggle
templ PermissionToggle(permissionID, action string, props PermissionsGridProps) {
	<div 
		class="relative"
		x-data={ "{ state: getPermissionState('" + permissionID + "', '" + action + "') }" }
	>
		<button
			type="button"
			@click={ "togglePermission('" + permissionID + "', '" + action + "')" }
			:disabled={ "!" + getBoolString(props.CanEditUsers || props.CanEditRoles) }
			class="w-6 h-6 rounded border-2 transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1"
			:class="getToggleClasses(state)"
			:title="getToggleTitle(state)"
		>
			<!-- Permission State Icon -->
			<div x-show="state === 'granted'" class="flex items-center justify-center">
				@atoms.Icon(atoms.IconProps{
					Name:  "check",
					Size:  atoms.IconSizeXS,
					Class: "text-white",
				})
			</div>
			<div x-show="state === 'inherited'" class="flex items-center justify-center">
				@atoms.Icon(atoms.IconProps{
					Name:  "arrow-down",
					Size:  atoms.IconSizeXS,
					Class: "text-white",
				})
			</div>
			<div x-show="state === 'denied'" class="flex items-center justify-center">
				@atoms.Icon(atoms.IconProps{
					Name:  "x",
					Size:  atoms.IconSizeXS,
					Class: "text-white",
				})
			</div>
		</button>
	</div>
}

// PermissionCategoryToggle renders bulk toggle for category
templ PermissionCategoryToggle(category PermissionCategory, props PermissionsGridProps) {
	if props.CanEditUsers || props.CanEditRoles {
		<div class="flex items-center space-x-1">
			<button
				type="button"
				@click={ "grantCategoryPermissions('" + category.ID + "')" }
				class="p-1 text-green-600 hover:bg-green-100 dark:hover:bg-green-900/20 rounded"
				title="Grant all permissions in this category"
			>
				@atoms.Icon(atoms.IconProps{
					Name: "check-circle",
					Size: atoms.IconSizeXS,
				})
			</button>
			<button
				type="button"
				@click={ "revokeCategoryPermissions('" + category.ID + "')" }
				class="p-1 text-red-600 hover:bg-red-100 dark:hover:bg-red-900/20 rounded"
				title="Revoke all permissions in this category"
			>
				@atoms.Icon(atoms.IconProps{
					Name: "x-circle",
					Size: atoms.IconSizeXS,
				})
			</button>
		</div>
	}
}

// PermissionSummaryCard renders a summary of user permissions
templ PermissionSummaryCard(props PermissionsGridProps) {
	<div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4">
		<h4 class="font-medium text-gray-900 dark:text-white mb-3">Permission Summary</h4>
		<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
			<div class="text-center">
				<div class="text-2xl font-bold text-green-600" x-text="getTotalGranted()">0</div>
				<div class="text-sm text-gray-500 dark:text-gray-400">Granted</div>
			</div>
			<div class="text-center">
				<div class="text-2xl font-bold text-yellow-600" x-text="getTotalInherited()">0</div>
				<div class="text-sm text-gray-500 dark:text-gray-400">Inherited</div>
			</div>
			<div class="text-2xl font-bold text-red-600" x-text="getTotalDenied()">0</div>
			<div class="text-sm text-gray-500 dark:text-gray-400">Denied</div>
			<div class="text-center">
				<div class="text-2xl font-bold text-blue-600" x-text="getTotalOverrides()">0</div>
				<div class="text-sm text-gray-500 dark:text-gray-400">Overrides</div>
			</div>
		</div>
	</div>
}

// JavaScript for permissions grid functionality
script permissionsGrid() {
	return {
		permissions: {},
		categories: {},
		changes: {},
		hasChanges: false,
		changeCount: 0,
		showInherited: true,
		showOverrides: true,
		
		init() {
			this.loadPermissions();
			this.initializeCategories();
		},
		
		loadPermissions() {
			// Initialize permissions state from props
			// This would be populated from server data
		},
		
		initializeCategories() {
			// Initialize category collapse state
		},
		
		toggleCategory(categoryId) {
			if (!this.categories[categoryId]) {
				this.categories[categoryId] = {};
			}
			this.categories[categoryId].collapsed = !this.categories[categoryId].collapsed;
		},
		
		togglePermission(permissionId, action) {
			const key = `${permissionId}:${action}`;
			const currentState = this.getPermissionState(permissionId, action);
			let newState;
			
			// Cycle through states: denied -> inherited -> granted -> denied
			switch (currentState) {
				case 'denied':
					newState = 'inherited';
					break;
				case 'inherited':
					newState = 'granted';
					break;
				case 'granted':
					newState = 'denied';
					break;
				default:
					newState = 'granted';
			}
			
			this.changes[key] = newState;
			this.updateChangeCount();
		},
		
		getPermissionState(permissionId, action) {
			const key = `${permissionId}:${action}`;
			if (this.changes[key]) {
				return this.changes[key];
			}
			// Check user permissions, then role permissions
			return this.permissions[key] || 'denied';
		},
		
		hasOverride(permissionId) {
			// Check if user has specific overrides for this permission
			return Object.keys(this.changes).some(key => key.startsWith(permissionId + ':'));
		},
		
		updateChangeCount() {
			this.changeCount = Object.keys(this.changes).length;
			this.hasChanges = this.changeCount > 0;
		},
		
		grantAllPermissions() {
			// Grant all visible permissions
		},
		
		revokeAllPermissions() {
			// Revoke all permissions
		},
		
		resetToRolePermissions() {
			// Reset to role-based permissions
			this.changes = {};
			this.updateChangeCount();
		},
		
		grantCategoryPermissions(categoryId) {
			// Grant all permissions in category
		},
		
		revokeCategoryPermissions(categoryId) {
			// Revoke all permissions in category
		},
		
		getCategoryGrantedCount(categoryId) {
			// Count granted permissions in category
			return 0;
		},
		
		savePermissions() {
			// Save permission changes
			const data = {
				user_id: this.$el.dataset.userId,
				role_id: this.$el.dataset.roleId,
				changes: this.changes
			};
			
			htmx.ajax('POST', this.$el.dataset.hxPost, {
				values: data,
				target: this.$el.dataset.hxTarget
			});
		}
	}
}

// Helper functions
func getBoolString(value bool) string {
	if value {
		return "true"
	}
	return "false"
}

func hasPermission(permissions []string, permissionID string) bool {
	for _, p := range permissions {
		if p == permissionID {
			return true
		}
	}
	return false
}

func getPermissionLevel(userPerms, rolePerms []string, permissionID string) string {
	if hasPermission(userPerms, permissionID) {
		return "granted"
	}
	if hasPermission(rolePerms, permissionID) {
		return "inherited"
	}
	return "denied"
}