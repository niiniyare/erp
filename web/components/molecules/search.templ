package molecules

import (
	"strings"
	"github.com/niiniyare/erp/web/components/atoms"
)

// SearchProps defines properties for the Search molecule
type SearchProps struct {
	// Content
	Placeholder string `json:"placeholder,omitempty"`
	Value       string `json:"value,omitempty"`
	Label       string `json:"label,omitempty"`
	
	// Search configuration
	Name        string `json:"name,omitempty"`
	Size        atoms.InputSize `json:"size"`
	Disabled    bool   `json:"disabled,omitempty"`
	ReadOnly    bool   `json:"readonly,omitempty"`
	
	// Search behavior
	InstantSearch    bool   `json:"instantSearch,omitempty"`    // Search as user types
	MinSearchLength  int    `json:"minSearchLength,omitempty"` // Min chars before search
	SearchDelay      int    `json:"searchDelay,omitempty"`     // Debounce delay in ms
	ShowClearButton  bool   `json:"showClearButton,omitempty"`
	
	// HTML attributes
	ID         string `json:"id,omitempty"`
	Class      string `json:"class,omitempty"`
	DataTestID string `json:"dataTestId,omitempty"`
	
	// Accessibility
	AriaLabel       string `json:"ariaLabel,omitempty"`
	AriaDescribedBy string `json:"ariaDescribedBy,omitempty"`
	
	// Behavior
	OnSearch    string `json:"onSearch,omitempty"`    // Alpine.js search handler
	OnClear     string `json:"onClear,omitempty"`     // Alpine.js clear handler
	OnFocus     string `json:"onFocus,omitempty"`
	OnBlur      string `json:"onBlur,omitempty"`
	
	// HTMX attributes
	HxGet       string `json:"hxGet,omitempty"`
	HxPost      string `json:"hxPost,omitempty"`
	HxTarget    string `json:"hxTarget,omitempty"`
	HxSwap      string `json:"hxSwap,omitempty"`
	HxTrigger   string `json:"hxTrigger,omitempty"`
	HxIndicator string `json:"hxIndicator,omitempty"`
	
	// Results
	ShowResults   bool   `json:"showResults,omitempty"`
	ResultsTarget string `json:"resultsTarget,omitempty"`
}

// Search renders a search input with icon and optional clear button
templ Search(props SearchProps) {
	<div class={ getSearchWrapperClasses(props) }>
		if props.Label != "" {
			<label 
				if props.ID != "" {
					for={ props.ID }
				}
				class="block text-sm font-medium text-gray-900 dark:text-white mb-2"
			>
				{ props.Label }
			</label>
		}
		
		<div 
			class="relative"
			if props.InstantSearch {
				x-data={ getSearchAlpineData(props) }
			}
		>
			<div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
				if props.InstantSearch && props.HxGet != "" {
					<div 
						class="htmx-indicator"
						if props.HxIndicator != "" {
							id={ props.HxIndicator }
						}
					>
						@atoms.Spinner(atoms.SpinnerProps{
							Size:  atoms.SpinnerSizeXS,
							Color: "gray",
						})
					</div>
					<div class="htmx-indicator-static">
						@atoms.Icon(atoms.IconProps{
							Name:  "search",
							Size:  getSearchIconSize(props.Size),
							Class: "text-gray-500 dark:text-gray-400",
						})
					</div>
				} else {
					@atoms.Icon(atoms.IconProps{
						Name:  "search",
						Size:  getSearchIconSize(props.Size),
						Class: "text-gray-500 dark:text-gray-400",
					})
				}
			</div>
			
			<input
				type="search"
				if props.ID != "" {
					id={ props.ID }
				}
				if props.Name != "" {
					name={ props.Name }
				}
				if props.Value != "" {
					value={ props.Value }
				}
				if props.Placeholder != "" {
					placeholder={ props.Placeholder }
				} else {
					placeholder="Search..."
				}
				class={ getSearchInputClasses(props) }
				if props.Disabled {
					disabled
				}
				if props.ReadOnly {
					readonly
				}
				if props.AriaLabel != "" {
					aria-label={ props.AriaLabel }
				}
				if props.AriaDescribedBy != "" {
					aria-describedby={ props.AriaDescribedBy }
				}
				if props.DataTestID != "" {
					data-testid={ props.DataTestID }
				}
				if props.OnFocus != "" {
					@focus={ props.OnFocus }
				}
				if props.OnBlur != "" {
					@blur={ props.OnBlur }
				}
				if props.InstantSearch {
					x-model="searchTerm"
					@input="handleInput()"
				}
				if props.HxGet != "" {
					hx-get={ props.HxGet }
				}
				if props.HxPost != "" {
					hx-post={ props.HxPost }
				}
				if props.HxTarget != "" {
					hx-target={ props.HxTarget }
				}
				if props.HxSwap != "" {
					hx-swap={ props.HxSwap }
				}
				if props.HxTrigger != "" {
					hx-trigger={ props.HxTrigger }
				} else if props.InstantSearch && props.HxGet != "" {
					hx-trigger={ getDefaultSearchTrigger(props) }
				}
				if props.HxIndicator != "" {
					hx-indicator={ "#" + props.HxIndicator }
				}
			/>
			
			if props.ShowClearButton {
				<button
					type="button"
					class={ getSearchClearButtonClasses(props) }
					if props.InstantSearch {
						x-show="searchTerm.length > 0"
						@click="clearSearch()"
					}
					if props.OnClear != "" {
						@click={ props.OnClear }
					}
					aria-label="Clear search"
					if props.DataTestID != "" {
						data-testid={ props.DataTestID + "-clear" }
					}
				>
					@atoms.Icon(atoms.IconProps{
						Name:  "close",
						Size:  getSearchIconSize(props.Size),
						Class: "text-gray-400 hover:text-gray-600 dark:hover:text-gray-300",
					})
				</button>
			}
		</div>
		
		if props.ShowResults && props.ResultsTarget != "" {
			<div 
				if props.ResultsTarget != "" {
					id={ props.ResultsTarget }
				}
				class="search-results mt-2"
				aria-live="polite"
				aria-label="Search results"
			>
				<!-- Search results will be populated by HTMX -->
			</div>
		}
	</div>
}

// SearchResults renders a container for search results
templ SearchResults(items []SearchResultItem, props SearchResultsProps) {
	<div class={ getSearchResultsClasses(props) }>
		if len(items) == 0 {
			@SearchEmptyState(props.EmptyMessage)
		} else {
			<ul class="divide-y divide-gray-200 dark:divide-gray-700" role="listbox">
				for _, item := range items {
					@SearchResultItemComponent(item, props.ItemClickHandler)
				}
			</ul>
		}
	</div>
}

// SearchResultItemComponent renders a single search result
templ SearchResultItemComponent(item SearchResultItem, clickHandler string) {
	<li 
		class="search-result-item py-3 px-4 hover:bg-gray-50 dark:hover:bg-gray-800 cursor-pointer transition-colors duration-150"
		role="option"
		if clickHandler != "" {
			@click={ clickHandler }
		}
		if item.Value != "" {
			data-value={ item.Value }
		}
		if item.ID != "" {
			data-id={ item.ID }
		}
	>
		<div class="flex items-center justify-between">
			<div class="flex-1 min-w-0">
				<div class="text-sm font-medium text-gray-900 dark:text-white truncate">
					{ item.Title }
				</div>
				if item.Description != "" {
					<div class="text-sm text-gray-500 dark:text-gray-400 truncate">
						{ item.Description }
					</div>
				}
			</div>
			if item.Badge != "" {
				<div class="ml-2 flex-shrink-0">
					<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300">
						{ item.Badge }
					</span>
				</div>
			}
		</div>
	</li>
}

// SearchEmptyState renders when no results are found
templ SearchEmptyState(message string) {
	<div class="text-center py-6">
		<div class="mx-auto h-12 w-12 text-gray-400 mb-4">
			@atoms.Icon(atoms.IconProps{Name: "search", Size: atoms.IconSize2XL, Class: "mx-auto"})
		</div>
		<h3 class="text-sm font-medium text-gray-900 dark:text-white">
			if message != "" {
				{ message }
			} else {
				No results found
			}
		</h3>
		<p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
			Try adjusting your search terms.
		</p>
	</div>
}

// Supporting types
type SearchResultItem struct {
	ID          string `json:"id"`
	Value       string `json:"value"`
	Title       string `json:"title"`
	Description string `json:"description,omitempty"`
	Badge       string `json:"badge,omitempty"`
}

type SearchResultsProps struct {
	MaxHeight        string `json:"maxHeight,omitempty"`
	EmptyMessage     string `json:"emptyMessage,omitempty"`
	ItemClickHandler string `json:"itemClickHandler,omitempty"`
	Class            string `json:"class,omitempty"`
}

// Helper functions
func getSearchWrapperClasses(props SearchProps) string {
	classes := []string{"search-wrapper"}
	
	if props.Class != "" {
		classes = append(classes, props.Class)
	}
	
	return strings.Join(classes, " ")
}

func getSearchInputClasses(props SearchProps) string {
	classes := []string{
		"block",
		"w-full",
		"ps-10",
		"text-gray-900",
		"border",
		"border-gray-300",
		"rounded-lg",
		"bg-gray-50",
		"focus:ring-blue-500",
		"focus:border-blue-500",
		"focus:outline-none",
		"dark:bg-gray-700",
		"dark:border-gray-600",
		"dark:placeholder-gray-400",
		"dark:text-white",
		"dark:focus:ring-blue-500",
		"dark:focus:border-blue-500",
		"transition-colors",
		"duration-200",
	}
	
	// Add size-specific classes
	switch props.Size {
	case atoms.InputSizeSM:
		classes = append(classes, "p-2", "text-xs")
		if props.ShowClearButton {
			classes = append(classes, "pe-8")
		}
	case atoms.InputSizeLG:
		classes = append(classes, "p-4", "text-base")
		if props.ShowClearButton {
			classes = append(classes, "pe-12")
		}
	default:
		classes = append(classes, "p-2.5", "text-sm")
		if props.ShowClearButton {
			classes = append(classes, "pe-10")
		}
	}
	
	return strings.Join(classes, " ")
}

func getSearchClearButtonClasses(props SearchProps) string {
	classes := []string{
		"absolute",
		"inset-y-0",
		"end-0",
		"flex",
		"items-center",
		"pr-3",
		"focus:outline-none",
		"focus:ring-2",
		"focus:ring-blue-500",
		"rounded",
	}
	
	return strings.Join(classes, " ")
}

func getSearchResultsClasses(props SearchResultsProps) string {
	classes := []string{
		"search-results",
		"bg-white",
		"dark:bg-gray-800",
		"border",
		"border-gray-200",
		"dark:border-gray-700",
		"rounded-lg",
		"shadow-lg",
		"overflow-hidden",
	}
	
	if props.MaxHeight != "" {
		classes = append(classes, "overflow-y-auto")
	} else {
		classes = append(classes, "max-h-64", "overflow-y-auto")
	}
	
	if props.Class != "" {
		classes = append(classes, props.Class)
	}
	
	return strings.Join(classes, " ")
}

func getSearchIconSize(inputSize atoms.InputSize) atoms.IconSize {
	switch inputSize {
	case atoms.InputSizeSM:
		return atoms.IconSizeXS
	case atoms.InputSizeLG:
		return atoms.IconSizeMD
	default:
		return atoms.IconSizeSM
	}
}

func getSearchAlpineData(props SearchProps) string {
	minLength := props.MinSearchLength
	if minLength == 0 {
		minLength = 2
	}
	
	delay := props.SearchDelay
	if delay == 0 {
		delay = 300
	}
	
	return `{
		searchTerm: '` + props.Value + `',
		searchTimeout: null,
		handleInput() {
			clearTimeout(this.searchTimeout);
			if (this.searchTerm.length >= ` + string(rune(minLength)) + `) {
				this.searchTimeout = setTimeout(() => {
					this.$el.querySelector('input').dispatchEvent(new Event('search'));
				}, ` + string(rune(delay)) + `);
			}
		},
		clearSearch() {
			this.searchTerm = '';
			this.$el.querySelector('input').focus();
			if (this.$el.querySelector('input').dispatchEvent) {
				this.$el.querySelector('input').dispatchEvent(new Event('search'));
			}
		}
	}`
}

func getDefaultSearchTrigger(props SearchProps) string {
	delay := props.SearchDelay
	if delay == 0 {
		delay = 300
	}
	
	minLength := props.MinSearchLength
	if minLength == 0 {
		minLength = 2
	}
	
	return "search, keyup delay:" + string(rune(delay)) + "ms changed"
}