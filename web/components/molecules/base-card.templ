package molecules

import (
	"strings"
	"github.com/niiniyare/erp/web/components/atoms"
)

// CardVariant defines the visual style of the card
type CardVariant string

const (
	CardVariantDefault CardVariant = "default"
	CardVariantBordered CardVariant = "bordered"
	CardVariantShadow CardVariant = "shadow"
	CardVariantOutline CardVariant = "outline"
)

// CardSize defines the padding and spacing of the card
type CardSize string

const (
	CardSizeSM CardSize = "sm"
	CardSizeMD CardSize = "md"
	CardSizeLG CardSize = "lg"
	CardSizeXL CardSize = "xl"
)

// CardHeaderProps defines properties for card header
type CardHeaderProps struct {
	Title       string `json:"title,omitempty"`
	Subtitle    string `json:"subtitle,omitempty"`
	Icon        string `json:"icon,omitempty"`
	Actions     []CardAction `json:"actions,omitempty"`
	Class       string `json:"class,omitempty"`
}

// CardFooterProps defines properties for card footer
type CardFooterProps struct {
	Actions     []CardAction `json:"actions,omitempty"`
	Text        string `json:"text,omitempty"`
	Justify     string `json:"justify,omitempty"` // "start", "center", "end", "between"
	Class       string `json:"class,omitempty"`
}

// CardAction represents an action button in header/footer
type CardAction struct {
	Text      string               `json:"text"`
	Icon      string               `json:"icon,omitempty"`
	Variant   atoms.ButtonVariant  `json:"variant,omitempty"`
	Size      atoms.ButtonSize     `json:"size,omitempty"`
	OnClick   string               `json:"onclick,omitempty"`
	HxPost    string               `json:"hxPost,omitempty"`
	HxGet     string               `json:"hxGet,omitempty"`
	HxTarget  string               `json:"hxTarget,omitempty"`
	HxSwap    string               `json:"hxSwap,omitempty"`
	HxConfirm string               `json:"hxConfirm,omitempty"`
	Disabled  bool                 `json:"disabled,omitempty"`
	Class     string               `json:"class,omitempty"`
}

// BaseCardProps defines properties for the BaseCard molecule
type BaseCardProps struct {
	// Content
	Header      *CardHeaderProps `json:"header,omitempty"`
	Footer      *CardFooterProps `json:"footer,omitempty"`
	
	// Styling
	Variant     CardVariant `json:"variant"`
	Size        CardSize    `json:"size"`
	
	// Layout
	Clickable   bool   `json:"clickable,omitempty"`
	Hoverable   bool   `json:"hoverable,omitempty"`
	
	// HTML attributes
	ID         string `json:"id,omitempty"`
	Class      string `json:"class,omitempty"`
	DataTestID string `json:"dataTestId,omitempty"`
	
	// Behavior
	OnClick    string `json:"onclick,omitempty"`
	
	// HTMX attributes
	HxGet      string `json:"hxGet,omitempty"`
	HxPost     string `json:"hxPost,omitempty"`
	HxTarget   string `json:"hxTarget,omitempty"`
	HxSwap     string `json:"hxSwap,omitempty"`
	
	// Accessibility
	AriaLabel  string `json:"ariaLabel,omitempty"`
	Role       string `json:"role,omitempty"`
}

// BaseCard renders a flexible card container with header, body, and footer
templ BaseCard(props BaseCardProps) {
	if props.Clickable || props.OnClick != "" || props.HxGet != "" || props.HxPost != "" {
		<div
			if props.ID != "" {
				id={ props.ID }
			}
			class={ getCardClasses(props) }
			if props.Role != "" {
				role={ props.Role }
			} else {
				role="button"
			}
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			}
			if props.DataTestID != "" {
				data-testid={ props.DataTestID }
			}
			if props.OnClick != "" {
				@click={ props.OnClick }
			}
			if props.HxGet != "" {
				hx-get={ props.HxGet }
			}
			if props.HxPost != "" {
				hx-post={ props.HxPost }
			}
			if props.HxTarget != "" {
				hx-target={ props.HxTarget }
			}
			if props.HxSwap != "" {
				hx-swap={ props.HxSwap }
			}
		>
			@CardContent(props)
		</div>
	} else {
		<div
			if props.ID != "" {
				id={ props.ID }
			}
			class={ getCardClasses(props) }
			if props.Role != "" {
				role={ props.Role }
			}
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			}
			if props.DataTestID != "" {
				data-testid={ props.DataTestID }
			}
		>
			@CardContent(props)
		</div>
	}
}

// CardContent renders the internal structure of the card
templ CardContent(props BaseCardProps) {
	if props.Header != nil {
		@CardHeader(*props.Header, props.Size)
	}
	
	<div class={ getCardBodyClasses(props) }>
		{ children... }
	</div>
	
	if props.Footer != nil {
		@CardFooter(*props.Footer, props.Size)
	}
}

// CardHeader renders the card header with title, subtitle, icon, and actions
templ CardHeader(header CardHeaderProps, cardSize CardSize) {
	<div class={ getCardHeaderClasses(header, cardSize) }>
		<div class="flex items-center justify-between">
			<div class="flex items-center space-x-3 min-w-0 flex-1">
				if header.Icon != "" {
					<div class="flex-shrink-0">
						@atoms.Icon(atoms.IconProps{
							Name: header.Icon,
							Size: getHeaderIconSize(cardSize),
							Class: "text-gray-500 dark:text-gray-400",
						})
					</div>
				}
				
				<div class="min-w-0 flex-1">
					if header.Title != "" {
						<h3 class={ getCardTitleClasses(cardSize) }>
							{ header.Title }
						</h3>
					}
					if header.Subtitle != "" {
						<p class={ getCardSubtitleClasses(cardSize) }>
							{ header.Subtitle }
						</p>
					}
				</div>
			</div>
			
			if len(header.Actions) > 0 {
				<div class="flex items-center space-x-2 flex-shrink-0">
					for _, action := range header.Actions {
						@CardActionButton(action, getHeaderActionSize(cardSize))
					}
				</div>
			}
		</div>
	</div>
}

// CardFooter renders the card footer with actions and text
templ CardFooter(footer CardFooterProps, cardSize CardSize) {
	<div class={ getCardFooterClasses(footer, cardSize) }>
		<div class={ getFooterContentClasses(footer.Justify) }>
			if footer.Text != "" {
				<p class={ getFooterTextClasses(cardSize) }>
					{ footer.Text }
				</p>
			}
			
			if len(footer.Actions) > 0 {
				<div class="flex items-center space-x-2">
					for _, action := range footer.Actions {
						@CardActionButton(action, getFooterActionSize(cardSize))
					}
				</div>
			}
		</div>
	</div>
}

// CardActionButton renders an action button
templ CardActionButton(action CardAction, size atoms.ButtonSize) {
	@atoms.Button(atoms.ButtonProps{
		Text:     action.Text,
		Variant:  getActionVariant(action.Variant),
		Size:     size,
		OnClick:  action.OnClick,
		HxPost:   action.HxPost,
		HxGet:    action.HxGet,
		Disabled: action.Disabled,
		Class:    action.Class,
	})
}

// Helper functions
func getCardClasses(props BaseCardProps) string {
	classes := []string{
		"card",
		"bg-white",
		"dark:bg-gray-800",
		"rounded-lg",
		"overflow-hidden",
	}
	
	// Add variant-specific classes
	switch props.Variant {
	case CardVariantBordered:
		classes = append(classes, "border", "border-gray-200", "dark:border-gray-700")
	case CardVariantShadow:
		classes = append(classes, "shadow-md", "hover:shadow-lg", "transition-shadow", "duration-200")
	case CardVariantOutline:
		classes = append(classes, "ring-1", "ring-gray-200", "dark:ring-gray-700")
	default:
		classes = append(classes, "border", "border-gray-200", "dark:border-gray-700")
	}
	
	// Add interactive classes
	if props.Clickable || props.OnClick != "" || props.HxGet != "" || props.HxPost != "" {
		classes = append(classes, "cursor-pointer", "transition-all", "duration-200")
		if props.Hoverable {
			classes = append(classes, "hover:shadow-md", "hover:scale-105")
		}
	}
	
	// Add custom classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}
	
	return strings.Join(classes, " ")
}

func getCardBodyClasses(props BaseCardProps) string {
	classes := []string{"card-body"}
	
	// Add size-specific padding
	switch props.Size {
	case CardSizeSM:
		classes = append(classes, "p-3")
	case CardSizeLG:
		classes = append(classes, "p-6")
	case CardSizeXL:
		classes = append(classes, "p-8")
	default: // MD
		classes = append(classes, "p-4")
	}
	
	return strings.Join(classes, " ")
}

func getCardHeaderClasses(header CardHeaderProps, size CardSize) string {
	classes := []string{
		"card-header",
		"border-b",
		"border-gray-200",
		"dark:border-gray-700",
		"bg-gray-50",
		"dark:bg-gray-900/50",
	}
	
	// Add size-specific padding
	switch size {
	case CardSizeSM:
		classes = append(classes, "px-3", "py-2")
	case CardSizeLG:
		classes = append(classes, "px-6", "py-4")
	case CardSizeXL:
		classes = append(classes, "px-8", "py-5")
	default: // MD
		classes = append(classes, "px-4", "py-3")
	}
	
	// Add custom classes
	if header.Class != "" {
		classes = append(classes, header.Class)
	}
	
	return strings.Join(classes, " ")
}

func getCardFooterClasses(footer CardFooterProps, size CardSize) string {
	classes := []string{
		"card-footer",
		"border-t",
		"border-gray-200",
		"dark:border-gray-700",
		"bg-gray-50",
		"dark:bg-gray-900/50",
	}
	
	// Add size-specific padding
	switch size {
	case CardSizeSM:
		classes = append(classes, "px-3", "py-2")
	case CardSizeLG:
		classes = append(classes, "px-6", "py-4")
	case CardSizeXL:
		classes = append(classes, "px-8", "py-5")
	default: // MD
		classes = append(classes, "px-4", "py-3")
	}
	
	// Add custom classes
	if footer.Class != "" {
		classes = append(classes, footer.Class)
	}
	
	return strings.Join(classes, " ")
}

func getCardTitleClasses(size CardSize) string {
	classes := []string{
		"font-semibold",
		"text-gray-900",
		"dark:text-white",
		"truncate",
	}
	
	switch size {
	case CardSizeSM:
		classes = append(classes, "text-sm")
	case CardSizeLG:
		classes = append(classes, "text-lg")
	case CardSizeXL:
		classes = append(classes, "text-xl")
	default: // MD
		classes = append(classes, "text-base")
	}
	
	return strings.Join(classes, " ")
}

func getCardSubtitleClasses(size CardSize) string {
	classes := []string{
		"text-gray-500",
		"dark:text-gray-400",
		"truncate",
	}
	
	switch size {
	case CardSizeSM:
		classes = append(classes, "text-xs")
	case CardSizeLG:
		classes = append(classes, "text-base")
	case CardSizeXL:
		classes = append(classes, "text-lg")
	default: // MD
		classes = append(classes, "text-sm")
	}
	
	return strings.Join(classes, " ")
}

func getFooterContentClasses(justify string) string {
	classes := []string{"flex", "items-center"}
	
	switch justify {
	case "center":
		classes = append(classes, "justify-center")
	case "end":
		classes = append(classes, "justify-end")
	case "between":
		classes = append(classes, "justify-between")
	default: // start
		classes = append(classes, "justify-start", "space-x-4")
	}
	
	return strings.Join(classes, " ")
}

func getFooterTextClasses(size CardSize) string {
	classes := []string{
		"text-gray-600",
		"dark:text-gray-400",
	}
	
	switch size {
	case CardSizeSM:
		classes = append(classes, "text-xs")
	case CardSizeLG:
		classes = append(classes, "text-base")
	case CardSizeXL:
		classes = append(classes, "text-lg")
	default: // MD
		classes = append(classes, "text-sm")
	}
	
	return strings.Join(classes, " ")
}

func getHeaderIconSize(size CardSize) atoms.IconSize {
	switch size {
	case CardSizeSM:
		return atoms.IconSizeSM
	case CardSizeLG:
		return atoms.IconSizeLG
	case CardSizeXL:
		return atoms.IconSizeXL
	default:
		return atoms.IconSizeMD
	}
}

func getHeaderActionSize(size CardSize) atoms.ButtonSize {
	switch size {
	case CardSizeSM:
		return atoms.ButtonSizeXS
	case CardSizeLG:
		return atoms.ButtonSizeMD
	case CardSizeXL:
		return atoms.ButtonSizeLG
	default:
		return atoms.ButtonSizeSM
	}
}

func getFooterActionSize(size CardSize) atoms.ButtonSize {
	switch size {
	case CardSizeSM:
		return atoms.ButtonSizeXS
	case CardSizeLG:
		return atoms.ButtonSizeMD
	case CardSizeXL:
		return atoms.ButtonSizeLG
	default:
		return atoms.ButtonSizeSM
	}
}

func getActionVariant(variant atoms.ButtonVariant) atoms.ButtonVariant {
	if variant == "" {
		return atoms.ButtonSecondary
	}
	return variant
}