package molecules

import (
	"github.com/niiniyare/erp/web/components/atoms"
	"strings"
)

// AlertType defines the semantic type of the alert
type AlertType string

const (
	AlertTypeInfo    AlertType = "info"
	AlertTypeSuccess AlertType = "success"
	AlertTypeWarning AlertType = "warning"
	AlertTypeError   AlertType = "error"
)

// AlertSize defines the padding and text size of the alert
type AlertSize string

const (
	AlertSizeSM AlertSize = "sm"
	AlertSizeMD AlertSize = "md"
	AlertSizeLG AlertSize = "lg"
)

// AlertProps defines properties for the Alert molecule
type AlertProps struct {
	// Content
	Title   string    `json:"title,omitempty"`
	Message string    `json:"message"`
	Type    AlertType `json:"type"`
	Size    AlertSize `json:"size"`

	// Behavior
	Dismissible bool `json:"dismissible,omitempty"`
	AutoDismiss bool `json:"autoDismiss,omitempty"`
	Duration    int  `json:"duration,omitempty"` // Auto-dismiss duration in seconds

	// Actions
	Actions []AlertAction `json:"actions,omitempty"`

	// Styling
	Border bool `json:"border,omitempty"`
	Shadow bool `json:"shadow,omitempty"`

	// HTML attributes
	ID         string `json:"id,omitempty"`
	Class      string `json:"class,omitempty"`
	DataTestID string `json:"dataTestId,omitempty"`

	// Accessibility
	AriaLabel string `json:"ariaLabel,omitempty"`

	// Behavior
	OnDismiss string `json:"onDismiss,omitempty"` // Alpine.js dismiss handler

	// HTMX attributes for dynamic alerts
	HxSwapOOB string `json:"hxSwapOOB,omitempty"`
}

// AlertAction represents an action button in the alert
type AlertAction struct {
	Text     string `json:"text"`
	OnClick  string `json:"onclick,omitempty"`
	HxPost   string `json:"hxPost,omitempty"`
	HxGet    string `json:"hxGet,omitempty"`
	HxTarget string `json:"hxTarget,omitempty"`
	HxSwap   string `json:"hxSwap,omitempty"`
	Primary  bool   `json:"primary,omitempty"`
	Class    string `json:"class,omitempty"`
}

// Alert renders a Flowbite-styled alert with various types and behaviors
templ Alert(props AlertProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getAlertClasses(props) }
		role="alert"
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		if props.DataTestID != "" {
			data-testid={ props.DataTestID }
		}
		if props.HxSwapOOB != "" {
			hx-swap-oob={ props.HxSwapOOB }
		}
		if props.Dismissible || props.AutoDismiss {
			x-data={ getAlertAlpineData(props) }
			x-show="visible"
			x-transition:enter="transition ease-out duration-300"
			x-transition:enter-start="opacity-0 transform scale-95"
			x-transition:enter-end="opacity-100 transform scale-100"
			x-transition:leave="transition ease-in duration-200"
			x-transition:leave-start="opacity-100 transform scale-100"
			x-transition:leave-end="opacity-0 transform scale-95"
		}
	>
		<div class={ getAlertContentClasses(props) }>
			<div class="flex">
				<div class="flex-shrink-0">
					@atoms.Icon(atoms.IconProps{
						Name:  getAlertIcon(props.Type),
						Size:  getAlertIconSize(props.Size),
						Class: getAlertIconClasses(props.Type),
					})
				</div>
				<div class="ml-3 flex-1">
					if props.Title != "" {
						<h3 class={ getAlertTitleClasses(props) }>
							{ props.Title }
						</h3>
					}
					<div class={ getAlertMessageClasses(props) }>
						{ props.Message }
					</div>
					if len(props.Actions) > 0 {
						<div class={ getAlertActionsClasses(props) }>
							for _, action := range props.Actions {
								@AlertActionButton(action, props.Type, props.Size)
							}
						</div>
					}
				</div>
				if props.Dismissible {
					<div class="ml-auto pl-3">
						<div class="-mx-1.5 -my-1.5">
							<button
								type="button"
								class={ getAlertDismissClasses(props) }
								@click="dismiss()"
								if props.OnDismiss != "" {
									@click={ props.OnDismiss }
								}
								aria-label="Dismiss alert"
							>
								<span class="sr-only">Dismiss</span>
								@atoms.Icon(atoms.IconProps{
									Name: "close",
									Size: getAlertDismissIconSize(props.Size),
								})
							</button>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
}

// AlertActionButton renders an action button within the alert
templ AlertActionButton(action AlertAction, alertType AlertType, alertSize AlertSize) {
	<button
		type="button"
		class={ getAlertActionButtonClasses(action, alertType, alertSize) }
		if action.OnClick != "" {
			@click={ action.OnClick }
		}
		if action.HxPost != "" {
			hx-post={ action.HxPost }
		}
		if action.HxGet != "" {
			hx-get={ action.HxGet }
		}
		if action.HxTarget != "" {
			hx-target={ action.HxTarget }
		}
		if action.HxSwap != "" {
			hx-swap={ action.HxSwap }
		}
	>
		{ action.Text }
	</button>
}

// Helper functions
func getAlertClasses(props AlertProps) string {
	classes := []string{"alert"}

	// Add type-specific background and border classes
	switch props.Type {
	case AlertTypeSuccess:
		classes = append(classes, "bg-green-50", "dark:bg-green-900/20")
		if props.Border {
			classes = append(classes, "border", "border-green-300", "dark:border-green-800")
		}
	case AlertTypeWarning:
		classes = append(classes, "bg-yellow-50", "dark:bg-yellow-900/20")
		if props.Border {
			classes = append(classes, "border", "border-yellow-300", "dark:border-yellow-800")
		}
	case AlertTypeError:
		classes = append(classes, "bg-red-50", "dark:bg-red-900/20")
		if props.Border {
			classes = append(classes, "border", "border-red-300", "dark:border-red-800")
		}
	default: // info
		classes = append(classes, "bg-blue-50", "dark:bg-blue-900/20")
		if props.Border {
			classes = append(classes, "border", "border-blue-300", "dark:border-blue-800")
		}
	}

	// Add rounded corners
	classes = append(classes, "rounded-lg")

	// Add shadow if requested
	if props.Shadow {
		classes = append(classes, "shadow-md")
	}

	// Add custom classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}

	return strings.Join(classes, " ")
}

func getAlertContentClasses(props AlertProps) string {
	classes := []string{}

	// Add size-specific padding
	switch props.Size {
	case AlertSizeSM:
		classes = append(classes, "p-3")
	case AlertSizeLG:
		classes = append(classes, "p-6")
	default: // MD
		classes = append(classes, "p-4")
	}

	return strings.Join(classes, " ")
}

func getAlertTitleClasses(props AlertProps) string {
	classes := []string{"font-medium"}

	// Add type-specific text colors
	switch props.Type {
	case AlertTypeSuccess:
		classes = append(classes, "text-green-800", "dark:text-green-400")
	case AlertTypeWarning:
		classes = append(classes, "text-yellow-800", "dark:text-yellow-400")
	case AlertTypeError:
		classes = append(classes, "text-red-800", "dark:text-red-400")
	default: // info
		classes = append(classes, "text-blue-800", "dark:text-blue-400")
	}

	// Add size-specific text size
	switch props.Size {
	case AlertSizeSM:
		classes = append(classes, "text-sm")
	case AlertSizeLG:
		classes = append(classes, "text-lg")
	default: // MD
		classes = append(classes, "text-base")
	}

	return strings.Join(classes, " ")
}

func getAlertMessageClasses(props AlertProps) string {
	classes := []string{}

	// Add type-specific text colors
	switch props.Type {
	case AlertTypeSuccess:
		classes = append(classes, "text-green-700", "dark:text-green-300")
	case AlertTypeWarning:
		classes = append(classes, "text-yellow-700", "dark:text-yellow-300")
	case AlertTypeError:
		classes = append(classes, "text-red-700", "dark:text-red-300")
	default: // info
		classes = append(classes, "text-blue-700", "dark:text-blue-300")
	}

	// Add size-specific text size and spacing
	switch props.Size {
	case AlertSizeSM:
		classes = append(classes, "text-xs")
		if props.Title != "" {
			classes = append(classes, "mt-1")
		}
	case AlertSizeLG:
		classes = append(classes, "text-base")
		if props.Title != "" {
			classes = append(classes, "mt-2")
		}
	default: // MD
		classes = append(classes, "text-sm")
		if props.Title != "" {
			classes = append(classes, "mt-1")
		}
	}

	return strings.Join(classes, " ")
}

func getAlertActionsClasses(props AlertProps) string {
	classes := []string{"flex", "space-x-2"}

	switch props.Size {
	case AlertSizeSM:
		classes = append(classes, "mt-2")
	case AlertSizeLG:
		classes = append(classes, "mt-4")
	default: // MD
		classes = append(classes, "mt-3")
	}

	return strings.Join(classes, " ")
}

func getAlertDismissClasses(props AlertProps) string {
	classes := []string{
		"inline-flex",
		"rounded-md",
		"p-1.5",
		"focus:outline-none",
		"focus:ring-2",
		"focus:ring-offset-2",
		"transition-colors",
		"duration-200",
	}

	// Add type-specific colors
	switch props.Type {
	case AlertTypeSuccess:
		classes = append(classes,
			"bg-green-50", "text-green-500",
			"hover:bg-green-100", "focus:ring-green-600", "focus:ring-offset-green-50",
			"dark:bg-green-900/20", "dark:text-green-400", "dark:hover:bg-green-900/30",
		)
	case AlertTypeWarning:
		classes = append(classes,
			"bg-yellow-50", "text-yellow-500",
			"hover:bg-yellow-100", "focus:ring-yellow-600", "focus:ring-offset-yellow-50",
			"dark:bg-yellow-900/20", "dark:text-yellow-400", "dark:hover:bg-yellow-900/30",
		)
	case AlertTypeError:
		classes = append(classes,
			"bg-red-50", "text-red-500",
			"hover:bg-red-100", "focus:ring-red-600", "focus:ring-offset-red-50",
			"dark:bg-red-900/20", "dark:text-red-400", "dark:hover:bg-red-900/30",
		)
	default: // info
		classes = append(classes,
			"bg-blue-50", "text-blue-500",
			"hover:bg-blue-100", "focus:ring-blue-600", "focus:ring-offset-blue-50",
			"dark:bg-blue-900/20", "dark:text-blue-400", "dark:hover:bg-blue-900/30",
		)
	}

	return strings.Join(classes, " ")
}

func getAlertActionButtonClasses(action AlertAction, alertType AlertType, alertSize AlertSize) string {
	classes := []string{
		"inline-flex",
		"items-center",
		"rounded-md",
		"border",
		"border-transparent",
		"font-medium",
		"focus:outline-none",
		"focus:ring-2",
		"focus:ring-offset-2",
		"transition-colors",
		"duration-200",
	}

	// Add size-specific classes
	switch alertSize {
	case AlertSizeSM:
		classes = append(classes, "px-2", "py-1", "text-xs")
	case AlertSizeLG:
		classes = append(classes, "px-4", "py-2", "text-base")
	default: // MD
		classes = append(classes, "px-3", "py-1.5", "text-sm")
	}

	// Add type and style-specific colors
	if action.Primary {
		switch alertType {
		case AlertTypeSuccess:
			classes = append(classes,
				"bg-green-600", "text-white",
				"hover:bg-green-700", "focus:ring-green-500",
			)
		case AlertTypeWarning:
			classes = append(classes,
				"bg-yellow-600", "text-white",
				"hover:bg-yellow-700", "focus:ring-yellow-500",
			)
		case AlertTypeError:
			classes = append(classes,
				"bg-red-600", "text-white",
				"hover:bg-red-700", "focus:ring-red-500",
			)
		default: // info
			classes = append(classes,
				"bg-blue-600", "text-white",
				"hover:bg-blue-700", "focus:ring-blue-500",
			)
		}
	} else {
		switch alertType {
		case AlertTypeSuccess:
			classes = append(classes,
				"bg-transparent", "text-green-700",
				"hover:bg-green-100", "focus:ring-green-500",
				"dark:text-green-300", "dark:hover:bg-green-900/30",
			)
		case AlertTypeWarning:
			classes = append(classes,
				"bg-transparent", "text-yellow-700",
				"hover:bg-yellow-100", "focus:ring-yellow-500",
				"dark:text-yellow-300", "dark:hover:bg-yellow-900/30",
			)
		case AlertTypeError:
			classes = append(classes,
				"bg-transparent", "text-red-700",
				"hover:bg-red-100", "focus:ring-red-500",
				"dark:text-red-300", "dark:hover:bg-red-900/30",
			)
		default: // info
			classes = append(classes,
				"bg-transparent", "text-blue-700",
				"hover:bg-blue-100", "focus:ring-blue-500",
				"dark:text-blue-300", "dark:hover:bg-blue-900/30",
			)
		}
	}

	// Add custom classes
	if action.Class != "" {
		classes = append(classes, action.Class)
	}

	return strings.Join(classes, " ")
}

func getAlertIcon(alertType AlertType) string {
	switch alertType {
	case AlertTypeSuccess:
		return "check-circle"
	case AlertTypeWarning:
		return "warning"
	case AlertTypeError:
		return "error"
	default: // info
		return "info"
	}
}

func getAlertIconClasses(alertType AlertType) string {
	switch alertType {
	case AlertTypeSuccess:
		return "text-green-400 dark:text-green-300"
	case AlertTypeWarning:
		return "text-yellow-400 dark:text-yellow-300"
	case AlertTypeError:
		return "text-red-400 dark:text-red-300"
	default: // info
		return "text-blue-400 dark:text-blue-300"
	}
}

func getAlertIconSize(alertSize AlertSize) atoms.IconSize {
	switch alertSize {
	case AlertSizeSM:
		return atoms.IconSizeSM
	case AlertSizeLG:
		return atoms.IconSizeLG
	default:
		return atoms.IconSizeMD
	}
}

func getAlertDismissIconSize(alertSize AlertSize) atoms.IconSize {
	switch alertSize {
	case AlertSizeSM:
		return atoms.IconSizeXS
	case AlertSizeLG:
		return atoms.IconSizeMD
	default:
		return atoms.IconSizeSM
	}
}

func getAlertAlpineData(props AlertProps) string {
	data := "{ visible: true"

	if props.AutoDismiss && props.Duration > 0 {
		data += ", init() { setTimeout(() => this.visible = false, " + string(rune(props.Duration*1000)) + ") }"
	}

	data += ", dismiss() { this.visible = false"
	if props.OnDismiss != "" {
		data += "; " + props.OnDismiss
	}
	data += " } }"

	return data
}
