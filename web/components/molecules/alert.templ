package molecules

import (
	"github.com/niiniyare/erp/web/components/atoms"
	"strings"
)

// ============================================================================
// DESIGN RATIONALE - ALERT MOLECULE
// ============================================================================
// Following the composition-based architecture established in atoms:
//
// 1. COMPOSITION OVER INHERITANCE: Uses shared atoms.BaseProps, atoms.ValidationProps
// 2. SEMANTIC MAPPING: AlertType maps directly to atoms.ColorScheme for consistency
// 3. SIZE STANDARDIZATION: Uses atoms.Size instead of custom AlertSize
// 4. ICON INTEGRATION: Leverages atoms.Icon with proper size/color mapping
// 5. ACCESSIBILITY: Proper ARIA roles and semantic structure
// 6. SCHEMA COMPLIANCE: Aligned with AlertSchema definitions
// ============================================================================

// AlertProps defines properties for the Alert molecule using composition
type AlertProps struct {
	// Composition from atoms - reuse shared types
	atoms.BaseProps
	atoms.AccessibilityProps
	atoms.EventProps
	
	// Content configuration
	Title   string `json:"title,omitempty"`
	Message string `json:"message"`
	
	// Visual properties aligned with atoms
	Color   atoms.ColorScheme `json:"color,omitempty"`   // Maps to alert type (info->ColorInfo, etc.)
	Variant atoms.Variant     `json:"variant,omitempty"` // Default, outlined, filled
	Size    atoms.Size        `json:"size,omitempty"`
	
	// Behavior
	Dismissible bool `json:"dismissible,omitempty"`
	AutoDismiss bool `json:"autoDismiss,omitempty"`
	Duration    int  `json:"duration,omitempty"` // Auto-dismiss duration in seconds
	
	// Actions
	Actions []AlertAction `json:"actions,omitempty"`
	
	// Layout options
	ShowIcon bool `json:"showIcon,omitempty"`
	Border   bool `json:"border,omitempty"`
	Shadow   bool `json:"shadow,omitempty"`
	
	// Behavior
	OnDismiss string `json:"onDismiss,omitempty"` // Alpine.js dismiss handler
}

// AlertAction represents an action button in the alert
type AlertAction struct {
	atoms.BaseProps
	atoms.EventProps
	
	Text    string        `json:"text"`
	Variant atoms.Variant `json:"variant,omitempty"`
	Size    atoms.Size    `json:"size,omitempty"`
	Primary bool          `json:"primary,omitempty"`
}

// Alert renders a modern alert component with composition-based architecture
templ Alert(props AlertProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getAlertClasses(props) }
		role="alert"
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		if props.AriaDescribedBy != "" {
			aria-describedby={ props.AriaDescribedBy }
		}
		if props.Dismissible || props.AutoDismiss {
			x-data={ getAlertAlpineData(props) }
			x-show="visible"
			x-transition:enter="transition ease-out duration-300"
			x-transition:enter-start="opacity-0 transform scale-95"
			x-transition:enter-end="opacity-100 transform scale-100"
			x-transition:leave="transition ease-in duration-200"
			x-transition:leave-start="opacity-100 transform scale-100"
			x-transition:leave-end="opacity-0 transform scale-95"
		}
		if props.OnClick != "" {
			@click={ props.OnClick }
		}
	>
		<div class={ getAlertContentClasses(props) }>
			<div class="flex">
				if props.ShowIcon {
					<div class="flex-shrink-0">
						@atoms.Icon(atoms.IconProps{
							BaseProps: atoms.BaseProps{
								Class: getAlertIconClasses(props.Color),
							},
							Name: getAlertIcon(props.Color),
							Size: props.Size,
						})
					</div>
				}
				<div class="ml-3 flex-1">
					if props.Title != "" {
						<h3 class={ getAlertTitleClasses(props) }>
							{ props.Title }
						</h3>
					}
					<div class={ getAlertMessageClasses(props) }>
						{ props.Message }
					</div>
					if len(props.Actions) > 0 {
						<div class={ getAlertActionsClasses(props) }>
							for _, action := range props.Actions {
								@atoms.Button(atoms.ButtonProps{
									BaseProps: action.BaseProps,
									AlpinEventHandlers: action.EventProps,
									Text: action.Text,
									Variant: getActionVariant(action, props.Color),
									Size: action.Size,
								})
							}
						</div>
					}
				</div>
				if props.Dismissible {
					<div class="ml-auto pl-3">
						<div class="-mx-1.5 -my-1.5">
							@atoms.Button(atoms.ButtonProps{
								BaseProps: atoms.BaseProps{
									Class: getAlertDismissClasses(props),
								},
								AccessibilityProps: atoms.AccessibilityProps{
									AriaLabel: "Dismiss alert",
								},
								Variant: atoms.VariantGhost,
								Size: atoms.SizeSM,
								IconOnly: true,
								IconName: "close",
								OnClick: getDismissHandler(props),
							})
						</div>
					</div>
				}
			</div>
		</div>
	</div>
}

// ============================================================================
// CONFIGURATION CONSTANTS
// ============================================================================

// Alert color scheme mapping - consistent with atoms.ColorScheme
var alertColorSchemes = map[atoms.ColorScheme][]string{
	atoms.ColorInfo:    {"bg-blue-50", "border-blue-300", "dark:bg-blue-900/20", "dark:border-blue-800"},
	atoms.ColorSuccess: {"bg-green-50", "border-green-300", "dark:bg-green-900/20", "dark:border-green-800"},
	atoms.ColorWarning: {"bg-yellow-50", "border-yellow-300", "dark:bg-yellow-900/20", "dark:border-yellow-800"},
	atoms.ColorDanger:  {"bg-red-50", "border-red-300", "dark:bg-red-900/20", "dark:border-red-800"},
	atoms.ColorDefault: {"bg-gray-50", "border-gray-300", "dark:bg-gray-900/20", "dark:border-gray-800"},
}

// Alert size dimensions
var alertSizeDimensions = map[atoms.Size][]string{
	atoms.SizeSM: {"p-3", "text-sm"},
	atoms.SizeMD: {"p-4", "text-base"},
	atoms.SizeLG: {"p-6", "text-lg"},
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

func getAlertClasses(props AlertProps) string {
	classes := []string{"alert", "rounded-lg"}

	// Add color scheme classes
	if colorClasses, exists := alertColorSchemes[props.Color]; exists {
		classes = append(classes, colorClasses[0], colorClasses[2]) // background classes
		if props.Border {
			classes = append(classes, "border", colorClasses[1], colorClasses[3]) // border classes
		}
	}

	// Add variant-specific styling
	switch props.Variant {
	case atoms.VariantOutlined:
		classes = append(classes, "bg-transparent", "border-2")
	case atoms.VariantFilled:
		classes = append(classes, "border-0")
	default:
		// Default variant uses base color scheme
	}

	// Add shadow if requested
	if props.Shadow {
		classes = append(classes, "shadow-md")
	}

	// Add custom classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}

	return strings.Join(classes, " ")
}

func getAlertContentClasses(props AlertProps) string {
	classes := []string{}

	// Add size-specific padding using atoms.Size
	if sizeDimensions, exists := alertSizeDimensions[props.Size]; exists {
		classes = append(classes, sizeDimensions[0]) // padding class
	} else {
		classes = append(classes, "p-4") // default padding
	}

	return strings.Join(classes, " ")
}

func getAlertTitleClasses(props AlertProps) string {
	classes := []string{"font-medium"}

	// Add color-specific text colors
	switch props.Color {
	case atoms.ColorSuccess:
		classes = append(classes, "text-green-800", "dark:text-green-400")
	case atoms.ColorWarning:
		classes = append(classes, "text-yellow-800", "dark:text-yellow-400")
	case atoms.ColorDanger:
		classes = append(classes, "text-red-800", "dark:text-red-400")
	case atoms.ColorInfo:
		classes = append(classes, "text-blue-800", "dark:text-blue-400")
	default:
		classes = append(classes, "text-gray-800", "dark:text-gray-400")
	}

	// Add size-specific text size
	if sizeDimensions, exists := alertSizeDimensions[props.Size]; exists {
		classes = append(classes, sizeDimensions[1]) // text size class
	} else {
		classes = append(classes, "text-base") // default text size
	}

	return strings.Join(classes, " ")
}

func getAlertMessageClasses(props AlertProps) string {
	classes := []string{}

	// Add color-specific text colors
	switch props.Color {
	case atoms.ColorSuccess:
		classes = append(classes, "text-green-700", "dark:text-green-300")
	case atoms.ColorWarning:
		classes = append(classes, "text-yellow-700", "dark:text-yellow-300")
	case atoms.ColorDanger:
		classes = append(classes, "text-red-700", "dark:text-red-300")
	case atoms.ColorInfo:
		classes = append(classes, "text-blue-700", "dark:text-blue-300")
	default:
		classes = append(classes, "text-gray-700", "dark:text-gray-300")
	}

	// Add size-specific text size and spacing
	switch props.Size {
	case atoms.SizeSM:
		classes = append(classes, "text-xs")
		if props.Title != "" {
			classes = append(classes, "mt-1")
		}
	case atoms.SizeLG:
		classes = append(classes, "text-base")
		if props.Title != "" {
			classes = append(classes, "mt-2")
		}
	default: // MD
		classes = append(classes, "text-sm")
		if props.Title != "" {
			classes = append(classes, "mt-1")
		}
	}

	return strings.Join(classes, " ")
}

func getAlertActionsClasses(props AlertProps) string {
	classes := []string{"flex", "space-x-2"}

	switch props.Size {
	case atoms.SizeSM:
		classes = append(classes, "mt-2")
	case atoms.SizeLG:
		classes = append(classes, "mt-4")
	default: // MD
		classes = append(classes, "mt-3")
	}

	return strings.Join(classes, " ")
}

func getAlertDismissClasses(props AlertProps) string {
	classes := []string{
		"inline-flex",
		"rounded-md",
		"p-1.5",
		"focus:outline-none",
		"focus:ring-2",
		"focus:ring-offset-2",
		"transition-colors",
		"duration-200",
	}

	// Add color-specific classes
	switch props.Color {
	case atoms.ColorSuccess:
		classes = append(classes,
			"bg-green-50", "text-green-500",
			"hover:bg-green-100", "focus:ring-green-600", "focus:ring-offset-green-50",
			"dark:bg-green-900/20", "dark:text-green-400", "dark:hover:bg-green-900/30",
		)
	case atoms.ColorWarning:
		classes = append(classes,
			"bg-yellow-50", "text-yellow-500",
			"hover:bg-yellow-100", "focus:ring-yellow-600", "focus:ring-offset-yellow-50",
			"dark:bg-yellow-900/20", "dark:text-yellow-400", "dark:hover:bg-yellow-900/30",
		)
	case atoms.ColorDanger:
		classes = append(classes,
			"bg-red-50", "text-red-500",
			"hover:bg-red-100", "focus:ring-red-600", "focus:ring-offset-red-50",
			"dark:bg-red-900/20", "dark:text-red-400", "dark:hover:bg-red-900/30",
		)
	case atoms.ColorInfo:
		classes = append(classes,
			"bg-blue-50", "text-blue-500",
			"hover:bg-blue-100", "focus:ring-blue-600", "focus:ring-offset-blue-50",
			"dark:bg-blue-900/20", "dark:text-blue-400", "dark:hover:bg-blue-900/30",
		)
	default:
		classes = append(classes,
			"bg-gray-50", "text-gray-500",
			"hover:bg-gray-100", "focus:ring-gray-600", "focus:ring-offset-gray-50",
			"dark:bg-gray-900/20", "dark:text-gray-400", "dark:hover:bg-gray-900/30",
		)
	}

	return strings.Join(classes, " ")
}

// getActionVariant determines the button variant based on action properties
func getActionVariant(action AlertAction, alertColor atoms.ColorScheme) atoms.Variant {
	if action.Primary {
		return atoms.VariantSolid
	}
	if action.Variant != "" {
		return action.Variant
	}
	return atoms.VariantGhost
}

// getDismissHandler creates the dismiss click handler
func getDismissHandler(props AlertProps) string {
	handler := "dismiss()"
	if props.OnDismiss != "" {
		handler += "; " + props.OnDismiss
	}
	return handler
}

func getAlertIcon(color atoms.ColorScheme) string {
	switch color {
	case atoms.ColorSuccess:
		return "check-circle"
	case atoms.ColorWarning:
		return "warning"
	case atoms.ColorDanger:
		return "error"
	case atoms.ColorInfo:
		return "info"
	default:
		return "info"
	}
}

func getAlertIconClasses(color atoms.ColorScheme) string {
	switch color {
	case atoms.ColorSuccess:
		return "text-green-400 dark:text-green-300"
	case atoms.ColorWarning:
		return "text-yellow-400 dark:text-yellow-300"
	case atoms.ColorDanger:
		return "text-red-400 dark:text-red-300"
	case atoms.ColorInfo:
		return "text-blue-400 dark:text-blue-300"
	default:
		return "text-gray-400 dark:text-gray-300"
	}
}

func getAlertAlpineData(props AlertProps) string {
	data := "{ visible: true"

	if props.AutoDismiss && props.Duration > 0 {
		data += ", init() { setTimeout(() => this.visible = false, " + string(rune(props.Duration*1000)) + ") }"
	}

	data += ", dismiss() { this.visible = false"
	if props.OnDismiss != "" {
		data += "; " + props.OnDismiss
	}
	data += " } }"

	return data
}

// ============================================================================
// CONSTRUCTOR WITH SENSIBLE DEFAULTS
// ============================================================================

// NewAlert creates a new AlertProps with sensible defaults
// Example usage:
// alert := NewAlert("Operation completed successfully", atoms.ColorSuccess)
// alert.Title = "Success"
// alert.Dismissible = true
func NewAlert(message string, color atoms.ColorScheme) AlertProps {
	return AlertProps{
		BaseProps: atoms.BaseProps{
			ID: atoms.EnsureID("alert", "alert"),
		},
		Message:  message,
		Color:    color,
		Variant:  atoms.VariantDefault,
		Size:     atoms.SizeMD,
		ShowIcon: true,
		Border:   false,
		Shadow:   false,
	}
}

// NewInfoAlert creates an info alert
func NewInfoAlert(message string) AlertProps {
	return NewAlert(message, atoms.ColorInfo)
}

// NewSuccessAlert creates a success alert
func NewSuccessAlert(message string) AlertProps {
	return NewAlert(message, atoms.ColorSuccess)
}

// NewWarningAlert creates a warning alert
func NewWarningAlert(message string) AlertProps {
	return NewAlert(message, atoms.ColorWarning)
}

// NewErrorAlert creates an error alert
func NewErrorAlert(message string) AlertProps {
	return NewAlert(message, atoms.ColorDanger)
}

// NewDismissibleAlert creates a dismissible alert
func NewDismissibleAlert(message string, color atoms.ColorScheme) AlertProps {
	alert := NewAlert(message, color)
	alert.Dismissible = true
	return alert
}
