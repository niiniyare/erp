package molecules

import (
	"strings"
	"github.com/niiniyare/erp/web/components/atoms"
)

// FieldGroupLayout defines how fields are arranged
type FieldGroupLayout string

const (
	FieldGroupLayoutVertical   FieldGroupLayout = "vertical"
	FieldGroupLayoutHorizontal FieldGroupLayout = "horizontal"
	FieldGroupLayoutGrid2      FieldGroupLayout = "grid-2"
	FieldGroupLayoutGrid3      FieldGroupLayout = "grid-3"
	FieldGroupLayoutGrid4      FieldGroupLayout = "grid-4"
)

// FieldGroupProps defines properties for grouping related fields
type FieldGroupProps struct {
	// Group configuration
	Title       string           `json:"title,omitempty"`
	Description string           `json:"description,omitempty"`
	Fields      []FieldProps     `json:"fields"`
	Layout      FieldGroupLayout `json:"layout"`
	
	// Group validation state
	HasError    bool   `json:"hasError,omitempty"`
	HasSuccess  bool   `json:"hasSuccess,omitempty"`
	ErrorText   string `json:"errorText,omitempty"`
	SuccessText string `json:"successText,omitempty"`
	
	// HTML attributes
	ID         string `json:"id,omitempty"`
	Class      string `json:"class,omitempty"`
	DataTestID string `json:"dataTestId,omitempty"`
	
	// Accessibility
	AriaLabel       string `json:"ariaLabel,omitempty"`
	AriaDescribedBy string `json:"ariaDescribedBy,omitempty"`
	
	// Behavior
	Collapsible bool   `json:"collapsible,omitempty"`
	Collapsed   bool   `json:"collapsed,omitempty"`
	OnToggle    string `json:"onToggle,omitempty"` // Alpine.js toggle handler
}

// FieldGroup renders a group of related form fields
templ FieldGroup(props FieldGroupProps) {
	<fieldset 
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getFieldGroupClasses(props) }
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		if props.AriaDescribedBy != "" {
			aria-describedby={ props.AriaDescribedBy }
		}
		if props.DataTestID != "" {
			data-testid={ props.DataTestID }
		}
		if props.Collapsible {
			x-data={ getFieldGroupAlpineData(props) }
		}
	>
		if props.Title != "" || props.Description != "" {
			@FieldGroupHeader(props)
		}
		
		<div 
			class={ getFieldGroupContentClasses(props) }
			if props.Collapsible {
				x-show="!collapsed"
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="opacity-0 transform scale-95"
				x-transition:enter-end="opacity-100 transform scale-100"
				x-transition:leave="transition ease-in duration-150"
				x-transition:leave-start="opacity-100 transform scale-100"
				x-transition:leave-end="opacity-0 transform scale-95"
			}
		>
			<div class={ getFieldGroupLayoutClasses(props.Layout) }>
				for _, field := range props.Fields {
					@Field(field)
				}
			</div>
		</div>
		
		if shouldShowGroupFeedback(props) {
			@FieldGroupFeedback(props)
		}
	</fieldset>
}

// FieldGroupHeader renders the group title and description
templ FieldGroupHeader(props FieldGroupProps) {
	<div class="field-group-header mb-4">
		if props.Title != "" {
			<legend class={ getFieldGroupTitleClasses(props) }>
				<div class="flex items-center justify-between">
					<span>{ props.Title }</span>
					if props.Collapsible {
						<button
							type="button"
							class="ml-2 p-1 text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 rounded"
							@click="collapsed = !collapsed"
							if props.OnToggle != "" {
								@click={ props.OnToggle }
							}
							aria-label="Toggle field group"
						>
							@atoms.Icon(atoms.IconProps{
								Name: "arrow-down",
								Size: atoms.IconSizeSM,
								Class: "transform transition-transform duration-200",
							})
						</button>
					}
				</div>
			</legend>
		}
		
		if props.Description != "" {
			<p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
				{ props.Description }
			</p>
		}
	</div>
}

// FieldGroupFeedback renders group-level feedback
templ FieldGroupFeedback(props FieldGroupProps) {
	if props.HasError && props.ErrorText != "" {
		<div class="mt-4 p-3 bg-red-50 border border-red-200 rounded-md dark:bg-red-900/20 dark:border-red-800">
			<div class="flex items-center">
				@atoms.Icon(atoms.IconProps{Name: "error", Size: atoms.IconSizeSM, Class: "text-red-400 mr-2"})
				<p class="text-sm text-red-800 dark:text-red-400">
					<span class="font-medium">Group Error:</span> { props.ErrorText }
				</p>
			</div>
		</div>
	} else if props.HasSuccess && props.SuccessText != "" {
		<div class="mt-4 p-3 bg-green-50 border border-green-200 rounded-md dark:bg-green-900/20 dark:border-green-800">
			<div class="flex items-center">
				@atoms.Icon(atoms.IconProps{Name: "check", Size: atoms.IconSizeSM, Class: "text-green-400 mr-2"})
				<p class="text-sm text-green-800 dark:text-green-400">
					<span class="font-medium">Success:</span> { props.SuccessText }
				</p>
			</div>
		</div>
	}
}

// Helper functions
func getFieldGroupClasses(props FieldGroupProps) string {
	classes := []string{"field-group"}
	
	// Add state classes
	if props.HasError {
		classes = append(classes, "field-group-error")
	} else if props.HasSuccess {
		classes = append(classes, "field-group-success")
	}
	
	// Add collapsible classes
	if props.Collapsible {
		classes = append(classes, "field-group-collapsible")
	}
	
	// Add custom classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}
	
	return strings.Join(classes, " ")
}

func getFieldGroupContentClasses(props FieldGroupProps) string {
	classes := []string{"field-group-content"}
	
	return strings.Join(classes, " ")
}

func getFieldGroupTitleClasses(props FieldGroupProps) string {
	classes := []string{
		"text-base",
		"font-semibold",
		"leading-6",
	}
	
	// Add state-specific colors
	if props.HasError {
		classes = append(classes, "text-red-900", "dark:text-red-400")
	} else if props.HasSuccess {
		classes = append(classes, "text-green-900", "dark:text-green-400")
	} else {
		classes = append(classes, "text-gray-900", "dark:text-white")
	}
	
	return strings.Join(classes, " ")
}

func getFieldGroupLayoutClasses(layout FieldGroupLayout) string {
	switch layout {
	case FieldGroupLayoutHorizontal:
		return "flex flex-wrap gap-4"
	case FieldGroupLayoutGrid2:
		return "grid grid-cols-1 md:grid-cols-2 gap-4"
	case FieldGroupLayoutGrid3:
		return "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"
	case FieldGroupLayoutGrid4:
		return "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4"
	default: // FieldGroupLayoutVertical
		return "space-y-4"
	}
}

func shouldShowGroupFeedback(props FieldGroupProps) bool {
	return (props.HasError && props.ErrorText != "") ||
		   (props.HasSuccess && props.SuccessText != "")
}

func getFieldGroupAlpineData(props FieldGroupProps) string {
	if props.Collapsed {
		return "{ collapsed: true }"
	}
	return "{ collapsed: false }"
}