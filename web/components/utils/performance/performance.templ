// BundleOptimizer provides code splitting and resource optimization
type BundleOptimizerProps struct {
	ChunkName    string   `json:"chunk_name" validate:"required"`
	Modules      []string `json:"modules"`      // Modules to include in chunk
	Preload      []string `json:"preload"`      // Resources to preload
	Prefetch     []string `json:"prefetch"`     // Resources to prefetch
	CriticalCSS  string   `json:"critical_css"` // Inline critical CSS
	DeferJS      bool     `json:"defer_js"`     // Defer non-critical JS
	Minify       bool     `json:"minify"`       // Enable minification
	Compress     bool     `json:"compress"`     // Enable gzip/brotli
	ID           string   `json:"id"`
}

// ComponentVirtualizerProps for handling large component lists
type ComponentVirtualizerProps struct {
	Components      []VirtualComponent `json:"components" validate:"required"`
	ComponentHeight int                `json:"component_height" validate:"required,min=1"`
	WindowHeight    int                `json:"window_height" validate:"required,min=1"`
	RenderBuffer    int                `json:"render_buffer"`    // Extra components to render
	RecycleLimit    int                `json:"recycle_limit"`    // Max components to keep in memory
	LazyMount       bool               `json:"lazy_mount"`       // Lazy mount components
	KeepAlive       bool               `json:"keep_alive"`       // Keep component state
	ID              string             `json:"id"`
	Class           string             `json:"class"`
}

// VirtualComponent represents a component in virtualized list
type VirtualComponent struct {
	ID       string                 `json:"id" validate:"required"`
	Template string                 `json:"template" validate:"required"`
	Props    map[string]interface{} `json:"props"`
	Priority int                    `json:"priority"` // Rendering priority
}

// PerformanceResourcePreloaderProps for optimizing resource loading
type PerformanceResourcePreloaderProps struct {
	CriticalResources []PerformanceResource `json:"critical_resources"` // Must load first
	AsyncResources    []PerformanceResource `json:"async_resources"`    // Load asynchronously
	LazyResources     []PerformanceResource `json:"lazy_resources"`     // Load on demand
	ServiceWorker     string                `json:"service_worker"`     // SW for caching
	CachingStrategy   string                `json:"caching_strategy" validate:"oneof=cache-first network-first stale-while-revalidate"`
	OfflineSupport    bool                  `json:"offline_support"`    // Enable offline mode
	ID                string                `json:"id"`
}

// PerformanceResource represents a loadable resource
type PerformanceResource struct {
	URL         string            `json:"url" validate:"required"`
	Type        string            `json:"type" validate:"oneof=script style image font"`
	As          string            `json:"as"`         // Resource hint
	Crossorigin string            `json:"crossorigin"` // CORS setting
	Integrity   string            `json:"integrity"`   // SRI hash
	Media       string            `json:"media"`       // Media query for CSS
	Sizes       string            `json:"sizes"`       // Sizes for images
	Priority    string            `json:"priority" validate:"oneof=high low"`
	Headers     map[string]string `json:"headers"`     // Custom headers
}

// BundleOptimizer provides code splitting and resource optimization
templ BundleOptimizer(props BundleOptimizerProps) {
	<div 
		id={ props.ID }
		x-data={ getBundleOptimizerData(props) }
		x-init="initBundleOptimizer()"
	>
		// Critical CSS inline
		if props.CriticalCSS != "" {
			<style>{ props.CriticalCSS }</style>
		}
		
		// Preload resources
		<template x-for="resource in preloadResources" :key="resource.url">
			<link 
				rel="preload" 
				:href="resource.url"
				:as="resource.as"
				:crossorigin="resource.crossorigin"
				:integrity="resource.integrity"
			/>
		</template>
		
		// Prefetch resources
		<template x-for="resource in prefetchResources" :key="resource.url">
			<link 
				rel="prefetch" 
				:href="resource.url"
			/>
		</template>
		
		// Dynamic chunk loading
		<div x-show="chunkLoading" class="fixed inset-0 bg-black bg-opacity-25 flex items-center justify-center z-50">
			<div class="bg-white rounded-lg p-4 flex items-center space-x-3">
				<div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600"></div>
				<span class="text-gray-700">Loading module...</span>
			</div>
		</div>
	</div>
}

// ComponentVirtualizer efficiently handles large lists of components
templ ComponentVirtualizer(props ComponentVirtualizerProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ "component-virtualizer overflow-hidden " + props.Class }
		x-data={ getComponentVirtualizerData(props) }
		x-init="initComponentVirtualizer()"
		x-ref="container"
	>
		// Virtual scrolling container
		<div 
			class="relative"
			style={ fmt.Sprintf("height: %dpx;", props.WindowHeight) }
			@scroll="handleVirtualScroll()"
		>
			// Top spacer
			<div 
				x-show="virtualTop > 0"
				:style="`height: ${virtualTop}px;`"
				class="virtual-spacer"
			></div>
			
			// Rendered components
			<template x-for="component in visibleComponents" :key="component.id">
				<div 
					class="virtual-component"
					:style="`height: ${componentHeight}px;`"
					x-data="getComponentData(component)"
					x-init="if (component.lazyMount) { loadComponent(); }"
				>
					<div 
						x-show="componentLoaded || !component.lazyMount"
						x-html="componentHTML"
					></div>
					
					// Component loading state
					<div 
						x-show="!componentLoaded && component.lazyMount"
						class="flex items-center justify-center h-full"
					>
						<div class="animate-pulse bg-gray-200 rounded w-full h-16"></div>
					</div>
				</div>
			</template>
			
			// Bottom spacer
			<div 
				x-show="virtualBottom > 0"
				:style="`height: ${virtualBottom}px;`"
				class="virtual-spacer"
			></div>
		</div>
	</div>
}

// PerformanceResourcePreloader optimizes resource loading strategies
templ PerformanceResourcePreloader(props PerformanceResourcePreloaderProps) {
	<div 
		id={ props.ID }
		x-data={ getPerformanceResourcePreloaderData(props) }
		x-init="initResourcePreloader()"
		class="resource-preloader"
	>
		// Service Worker registration
		if props.ServiceWorker != "" {
			<script>
				if ('serviceWorker' in navigator) {
					navigator.serviceWorker.register('{ props.ServiceWorker }')
						.then(() => console.log('SW registered'))
						.catch(err => console.error('SW registration failed', err));
				}
			</script>
		}
		
		// Critical resource preloading
		<template x-for="resource in criticalResources" :key="resource.url">
			<link 
				rel="preload" 
				:href="resource.url"
				:as="resource.as"
				:type="resource.type"
				:crossorigin="resource.crossorigin"
				:integrity="resource.integrity"
				:media="resource.media"
				:sizes="resource.sizes"
				fetchpriority="high"
			/>
		</template>
		
		// Async resource hints
		<template x-for="resource in asyncResources" :key="resource.url">
			<link 
				rel="prefetch" 
				:href="resource.url"
				:as="resource.as"
			/>
		</template>
		
		// Performance monitoring
		<div 
			x-show="showPerformanceMonitor" 
			class="fixed bottom-4 right-4 bg-black bg-opacity-75 text-white p-2 rounded text-xs font-mono z-50"
		>
			<div>FCP: <span x-text="performanceMetrics.fcp">-</span>ms</div>
			<div>LCP: <span x-text="performanceMetrics.lcp">-</span>ms</div>
			<div>CLS: <span x-text="performanceMetrics.cls">-</span></div>
			<div>FID: <span x-text="performanceMetrics.fid">-</span>ms</div>
		</div>
	</div>
}

// Helper functions for new optimization components
func getBundleOptimizerData(props BundleOptimizerProps) string {
	return fmt.Sprintf(`{
		chunkName: '%s',
		preloadResources: %s,
		prefetchResources: %s,
		chunkLoading: false,
		loadedChunks: new Set(),
		
		initBundleOptimizer() {
			this.setupResourceHints();
			this.enableChunkPreloading();
			if (%t) this.setupCompressionHeaders();
		},
		
		setupResourceHints() {
			// Preload critical resources
			this.preloadResources.forEach(resource => {
				const link = document.createElement('link');
				link.rel = 'preload';
				link.href = resource;
				document.head.appendChild(link);
			});
		},
		
		async loadChunk(chunkName) {
			if (this.loadedChunks.has(chunkName)) return;
			
			this.chunkLoading = true;
			try {
				const module = await import('/' + chunkName + '.js');
				this.loadedChunks.add(chunkName);
				return module;
			} finally {
				this.chunkLoading = false;
			}
		},
		
		enableChunkPreloading() {
			// Preload chunks on hover
			document.addEventListener('mouseover', (e) => {
				const link = e.target.closest('[data-preload-chunk]');
				if (link) {
					const chunk = link.dataset.preloadChunk;
					this.preloadChunk(chunk);
				}
			});
		},
		
		preloadChunk(chunkName) {
			if (this.loadedChunks.has(chunkName)) return;
			
			const link = document.createElement('link');
			link.rel = 'modulepreload';
			link.href = '/' + chunkName + '.js';
			document.head.appendChild(link);
		},
		
		setupCompressionHeaders() {
			// Enable compression for resources
			if ('serviceWorker' in navigator) {
				navigator.serviceWorker.ready.then(registration => {
					registration.active.postMessage({
						type: 'ENABLE_COMPRESSION',
						chunkName: this.chunkName
					});
				});
			}
		}
	}`, props.ChunkName, getResourceListJSON(props.Preload), getResourceListJSON(props.Prefetch), props.Compress)
}

func getComponentVirtualizerData(props ComponentVirtualizerProps) string {
	return fmt.Sprintf(`{
		components: %s,
		visibleComponents: [],
		componentHeight: %d,
		windowHeight: %d,
		renderBuffer: %d,
		scrollTop: 0,
		virtualTop: 0,
		virtualBottom: 0,
		componentPool: new Map(),
		
		initComponentVirtualizer() {
			this.updateVisibleComponents();
			this.setupComponentPool();
		},
		
		handleVirtualScroll() {
			this.scrollTop = this.$refs.container.scrollTop;
			this.updateVisibleComponents();
		},
		
		updateVisibleComponents() {
			const visibleCount = Math.ceil(this.windowHeight / this.componentHeight);
			const startIndex = Math.max(0, Math.floor(this.scrollTop / this.componentHeight) - this.renderBuffer);
			const endIndex = Math.min(this.components.length, startIndex + visibleCount + this.renderBuffer * 2);
			
			this.virtualTop = startIndex * this.componentHeight;
			this.virtualBottom = (this.components.length - endIndex) * this.componentHeight;
			
			this.visibleComponents = this.components.slice(startIndex, endIndex);
		},
		
		setupComponentPool() {
			// Implement component recycling for memory efficiency
			const maxPool = %d;
			this.componentPool = new Map();
		},
		
		getComponentData(component) {
			return {
				componentLoaded: !%t,
				componentHTML: '',
				
				async loadComponent() {
					if (this.componentLoaded) return;
					
					try {
						// Simulate component loading
						await new Promise(resolve => setTimeout(resolve, 100));
						this.componentHTML = this.renderComponent(component);
						this.componentLoaded = true;
					} catch (error) {
						console.error('Failed to load component:', error);
						this.componentHTML = '<div class="error">Component failed to load</div>';
					}
				},
				
				renderComponent(comp) {
					// Template rendering logic
					return '<div class="component-' + comp.template + '">' + JSON.stringify(comp.props) + '</div>';
				}
			};
		}
	}`, getComponentsJSON(props.Components), props.ComponentHeight, props.WindowHeight, props.RenderBuffer, props.RecycleLimit, props.LazyMount)
}

func getPerformanceResourcePreloaderData(props PerformanceResourcePreloaderProps) string {
	return fmt.Sprintf(`{
		criticalResources: %s,
		asyncResources: %s,
		lazyResources: %s,
		performanceMetrics: { fcp: 0, lcp: 0, cls: 0, fid: 0 },
		showPerformanceMonitor: false,
		
		initResourcePreloader() {
			this.loadCriticalResources();
			this.setupPerformanceMonitoring();
			this.enableLazyLoading();
			if (%t) this.setupOfflineSupport();
		},
		
		loadCriticalResources() {
			this.criticalResources.forEach(resource => {
				const link = document.createElement('link');
				link.rel = 'preload';
				link.href = resource.url;
				link.as = resource.as;
				if (resource.crossorigin) link.crossOrigin = resource.crossorigin;
				if (resource.integrity) link.integrity = resource.integrity;
				document.head.appendChild(link);
			});
		},
		
		setupPerformanceMonitoring() {
			// Core Web Vitals monitoring
			if ('PerformanceObserver' in window) {
				const observer = new PerformanceObserver((list) => {
					for (const entry of list.getEntries()) {
						if (entry.name === 'first-contentful-paint') {
							this.performanceMetrics.fcp = Math.round(entry.startTime);
						}
						if (entry.name === 'largest-contentful-paint') {
							this.performanceMetrics.lcp = Math.round(entry.startTime);
						}
					}
				});
				observer.observe({ entryTypes: ['paint', 'largest-contentful-paint'] });
			}
			
			// Toggle performance monitor on Ctrl+Shift+P
			document.addEventListener('keydown', (e) => {
				if (e.ctrlKey && e.shiftKey && e.key === 'P') {
					this.showPerformanceMonitor = !this.showPerformanceMonitor;
				}
			});
		},
		
		enableLazyLoading() {
			// Lazy load resources on demand
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						const resource = entry.target.dataset.lazyResource;
						if (resource) {
							this.loadResource(JSON.parse(resource));
							observer.unobserve(entry.target);
						}
					}
				});
			});
			
			document.querySelectorAll('[data-lazy-resource]').forEach(el => {
				observer.observe(el);
			});
		},
		
		loadResource(resource) {
			if (resource.type === 'script') {
				const script = document.createElement('script');
				script.src = resource.url;
				script.async = true;
				document.head.appendChild(script);
			} else if (resource.type === 'style') {
				const link = document.createElement('link');
				link.rel = 'stylesheet';
				link.href = resource.url;
				document.head.appendChild(link);
			}
		},
		
		setupOfflineSupport() {
			// Cache resources for offline use
			if ('caches' in window) {
				caches.open('erp-cache-v1').then(cache => {
					const urls = [...this.criticalResources, ...this.asyncResources]
						.map(r => r.url);
					cache.addAll(urls);
				});
			}
		}
	}`, getPerformanceResourcesJSON(props.CriticalResources), getPerformanceResourcesJSON(props.AsyncResources), getPerformanceResourcesJSON(props.LazyResources), props.OfflineSupport)
}

// Helper functions for resource optimization
func getResourceListJSON(resources []string) string {
	if len(resources) == 0 {
		return "[]"
	}
	result := "["
	for i, resource := range resources {
		if i > 0 {
			result += ","
		}
		result += fmt.Sprintf(`"%s"`, resource)
	}
	return result + "]"
}

