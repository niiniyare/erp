package helpers

import (
	"fmt"
)

// LazyImageProps defines properties for lazy loading images
type LazyImageProps struct {
	Src         string `json:"src" validate:"required"`
	Alt         string `json:"alt" validate:"required"`
	Class       string `json:"class"`
	Width       string `json:"width"`
	Height      string `json:"height"`
	Placeholder string `json:"placeholder"` // Base64 or URL for placeholder
	Sizes       string `json:"sizes"`       // Responsive image sizes
	Loading     string `json:"loading" validate:"oneof=lazy eager auto"`
	Quality     int    `json:"quality"`    // Image quality (1-100)
	BlurAmount  int    `json:"blur_amount"` // Blur for placeholder
	FadeIn      bool   `json:"fade_in"`    // Fade in animation
	ID          string `json:"id"`
	AriaLabel   string `json:"aria_label"`
}

// OptimizedImageProps defines properties for next-gen image formats with fallbacks
type OptimizedImageProps struct {
	Src          string `json:"src" validate:"required"`           // Original image source
	SrcWebP      string `json:"src_webp"`                        // WebP format source
	SrcAVIF      string `json:"src_avif"`                        // AVIF format source
	Srcset       string `json:"srcset"`                          // Responsive image sizes
	Sizes        string `json:"sizes"`                           // Responsive breakpoints
	Alt          string `json:"alt" validate:"required"`
	LQIP         string `json:"lqip"`                            // Low Quality Image Placeholder
	NativeWidth  string `json:"native_width"`                   // Original image width
	NativeHeight string `json:"native_height"`                  // Original image height
	Width        string `json:"width"`                           // Display width
	Height       string `json:"height"`                          // Display height
	Class        string `json:"class"`
	Loading      string `json:"loading" validate:"oneof=lazy eager auto"`
	Decoding     string `json:"decoding" validate:"oneof=sync async auto"`
	FetchPriority string `json:"fetch_priority" validate:"oneof=high low auto"`
	ID           string `json:"id"`
	AriaLabel    string `json:"aria_label"`
}

// VirtualListProps defines properties for virtualized lists
type VirtualListProps struct {
	Items        []VirtualListItem `json:"items" validate:"required"`
	ItemHeight   int               `json:"item_height" validate:"required,min=1"`
	ContainerHeight int            `json:"container_height" validate:"required,min=1"`
	Overscan     int               `json:"overscan"`           // Number of items to render outside viewport
	ScrollBuffer int               `json:"scroll_buffer"`      // Buffer for smooth scrolling
	ItemTemplate string            `json:"item_template"`      // Template name for items
	LoadMore     bool              `json:"load_more"`          // Enable infinite scroll
	LoadingText  string            `json:"loading_text"`
	EmptyText    string            `json:"empty_text"`
	ID           string            `json:"id"`
	Class        string            `json:"class"`
	AriaLabel    string            `json:"aria_label"`
}

// VirtualListItem represents an item in a virtual list
type VirtualListItem struct {
	ID   string                 `json:"id" validate:"required"`
	Data map[string]interface{} `json:"data"`
}

// LazyLoaderProps defines properties for lazy loading content sections
type LazyLoaderProps struct {
	Endpoint     string `json:"endpoint" validate:"required"`
	TriggerClass string `json:"trigger_class"`
	Threshold    string `json:"threshold"`    // Intersection threshold (0.0-1.0)
	RootMargin   string `json:"root_margin"` // Margin around root for early loading
	LoadOnce     bool   `json:"load_once"`   // Load content only once
	ShowSpinner  bool   `json:"show_spinner"`
	SpinnerSize  string `json:"spinner_size" validate:"oneof=sm base lg"`
	ErrorText    string `json:"error_text"`
	RetryButton  bool   `json:"retry_button"`
	Placeholder  string `json:"placeholder"` // Placeholder content
	ID           string `json:"id"`
	Class        string `json:"class"`
}

// CacheConfig defines caching configuration
type CacheConfig struct {
	Key        string `json:"key" validate:"required"`
	TTL        int    `json:"ttl"`        // Time to live in seconds
	Namespace  string `json:"namespace"`  // Cache namespace
	Versioned  bool   `json:"versioned"`  // Include version in cache key
	Persistent bool   `json:"persistent"` // Use localStorage instead of memory
}

// OptimizedImage provides modern image formats with progressive loading
templ OptimizedImage(props OptimizedImageProps) {
	<div class="relative overflow-hidden" style={ "width: " + props.Width + "; height: " + props.Height }>
		// Low-quality image placeholder (LQIP)
		if props.LQIP != "" {
			<div 
				id={ "lqip-" + props.ID }
				class="absolute inset-0 transition-opacity duration-500"
			>
				<img 
					src={ props.LQIP }
					alt=""
					class="w-full h-full object-cover filter blur-sm transform scale-110"
					loading="eager"
				/>
			</div>
		}
		
		// Progressive image with modern format support
		<picture 
			id={ "picture-" + props.ID }
			class="block w-full h-full opacity-0 transition-opacity duration-500"
			x-data="{ loaded: false, error: false }"
			x-init="
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							const picture = entry.target;
							const img = picture.querySelector('img');
							
							// Progressive enhancement for modern formats
							const sources = picture.querySelectorAll('source');
							sources.forEach(source => {
								if (source.dataset.srcset) {
									source.srcset = source.dataset.srcset;
								}
							});
							
							if (img.dataset.src) {
								img.src = img.dataset.src;
							}
							if (img.dataset.srcset) {
								img.srcset = img.dataset.srcset;
							}
							
							img.onload = () => {
								picture.classList.remove('opacity-0');
								picture.classList.add('opacity-100');
								const lqip = document.getElementById('lqip-' + $el.id.split('-')[1]);
								if (lqip) {
									lqip.classList.add('opacity-0');
									setTimeout(() => lqip.remove(), 500);
								}
								loaded = true;
							};
							
							img.onerror = () => {
								error = true;
								img.src = '/assets/images/placeholder-error.png';
								picture.classList.remove('opacity-0');
								picture.classList.add('opacity-100');
							};
							
							observer.unobserve(picture);
						}
					});
				}, { 
					threshold: 0.1,
					rootMargin: '50px 0px'
				});
				observer.observe($el);
			"
		>
			// AVIF source (best compression)
			if props.SrcAVIF != "" {
				<source 
					data-srcset={ props.SrcAVIF }
					type="image/avif"
				/>
			}
			
			// WebP source (good compression, wide support)
			if props.SrcWebP != "" {
				<source 
					data-srcset={ props.SrcWebP }
					type="image/webp"
				/>
			}
			
			// Fallback JPEG/PNG
			<img 
				data-src={ props.Src }
				data-srcset={ props.Srcset }
				alt={ props.Alt }
				class={ "w-full h-full object-cover " + props.Class }
				if props.Loading != "" {
					loading={ props.Loading }
				}
				if props.Decoding != "" {
					decoding={ props.Decoding }
				}
				if props.FetchPriority != "" {
					fetchpriority={ props.FetchPriority }
				}
				if props.NativeWidth != "" {
					width={ props.NativeWidth }
				}
				if props.NativeHeight != "" {
					height={ props.NativeHeight }
				}
				if props.Sizes != "" {
					sizes={ props.Sizes }
				}
			/>
		</picture>
		
		// Loading spinner
		<div 
			x-show="!loaded && !error" 
			class="absolute inset-0 flex items-center justify-center bg-gray-100"
		>
			<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
		</div>
		
		// Error state
		<div 
			x-show="error" 
			class="absolute inset-0 flex items-center justify-center bg-gray-100 text-gray-500"
		>
			<svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
			</svg>
		</div>
	</div>
}

// LazyImage renders a performance-optimized lazy loading image
templ LazyImage(props LazyImageProps) {
	<div 
		class={ getLazyImageContainerClasses(props.Class) }
		if props.ID != "" {
			id={ props.ID }
		}
		x-data={ getLazyImageData(props) }
		x-init="initLazyImage()"
	>
		<!-- Placeholder -->
		<div 
			x-show="!loaded" 
			class={ getLazyImagePlaceholderClasses() }
			if props.Width != "" && props.Height != "" {
				style={ fmt.Sprintf("width: %s; height: %s;", props.Width, props.Height) }
			}
		>
			if props.Placeholder != "" {
				<img 
					src={ props.Placeholder }
					alt={ props.Alt }
					class={ getLazyImagePlaceholderImageClasses(props.BlurAmount) }
					aria-hidden="true"
				/>
			} else {
				<!-- Default skeleton placeholder -->
				<div class={ getLazyImageSkeletonClasses() }>
					<svg class="w-8 h-8 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
					</svg>
				</div>
			}
		</div>

		<!-- Actual Image -->
		<img 
			x-show="loaded"
			x-ref="image"
			:src="imageSrc"
			alt={ props.Alt }
			class={ getLazyImageClasses(props.FadeIn) }
			if props.Width != "" {
				width={ props.Width }
			}
			if props.Height != "" {
				height={ props.Height }
			}
			if props.Sizes != "" {
				sizes={ props.Sizes }
			}
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			}
			@load="handleImageLoad()"
			@error="handleImageError()"
		/>

		<!-- Error State -->
		<div 
			x-show="error" 
			class={ getLazyImageErrorClasses() }
		>
			<svg class="w-8 h-8 text-gray-400 mb-2" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
			</svg>
			<p class="text-sm text-gray-500">Failed to load image</p>
			<button 
				@click="retryLoad()"
				class="mt-2 px-3 py-1 text-xs bg-blue-600 text-white rounded hover:bg-blue-700"
			>
				Retry
			</button>
		</div>
	</div>
}

// VirtualList renders a virtualized list for performance with large datasets
templ VirtualList(props VirtualListProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getVirtualListClasses() + " " + props.Class }
		x-data={ getVirtualListData(props) }
		x-init="initVirtualList()"
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		role="list"
	>
		<!-- Virtual Container -->
		<div 
			class={ getVirtualListContainerClasses() }
			style={ fmt.Sprintf("height: %dpx;", props.ContainerHeight) }
			x-ref="container"
			@scroll="handleScroll()"
		>
			<!-- Virtual Spacer Top -->
			<div 
				x-show="virtualTop > 0"
				:style="`height: ${virtualTop}px;`"
				class="virtual-spacer-top"
			></div>

			<!-- Rendered Items -->
			<template x-for="(item, index) in visibleItems" :key="item.id">
				<div 
					class={ getVirtualListItemClasses() }
					:style="`height: ${itemHeight}px;`"
					role="listitem"
					:aria-setsize="totalItems"
					:aria-posinset="item.virtualIndex + 1"
				>
					<!-- Dynamic Item Content -->
					<div x-html="renderItem(item)"></div>
				</div>
			</template>

			<!-- Virtual Spacer Bottom -->
			<div 
				x-show="virtualBottom > 0"
				:style="`height: ${virtualBottom}px;`"
				class="virtual-spacer-bottom"
			></div>

			<!-- Loading More Indicator -->
			<div 
				x-show="loadingMore"
				class={ getVirtualListLoadingClasses() }
			>
				<svg class="animate-spin h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
				</svg>
				<span class="ml-2">{ getLoadingText(props.LoadingText) }</span>
			</div>

			<!-- Empty State -->
			<div 
				x-show="totalItems === 0 && !loading"
				class={ getVirtualListEmptyClasses() }
			>
				<svg class="w-12 h-12 text-gray-300 mb-4" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
				</svg>
				<p class="text-gray-500">{ getEmptyText(props.EmptyText) }</p>
			</div>
		</div>
	</div>
}

// LazyLoader renders a container that loads content when it comes into view
templ LazyLoader(props LazyLoaderProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getLazyLoaderClasses() + " " + props.Class }
		x-data={ getLazyLoaderData(props) }
		x-init="initLazyLoader()"
		x-ref="lazyContainer"
	>
		<!-- Loading State -->
		<div 
			x-show="loading"
			class={ getLazyLoaderLoadingClasses() }
		>
			if props.ShowSpinner {
				<div class={ getLazyLoaderSpinnerClasses(props.SpinnerSize) }>
					<svg class="animate-spin h-full w-full text-blue-500" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
					</svg>
				</div>
			}
			<span class="text-gray-600 dark:text-gray-400">Loading content...</span>
		</div>

		<!-- Placeholder Content -->
		<div 
			x-show="!loaded && !loading && !error"
			class={ getLazyLoaderPlaceholderClasses() }
		>
			if props.Placeholder != "" {
				{ props.Placeholder }
			} else {
				<!-- Default skeleton -->
				<div class="animate-pulse space-y-4">
					<div class="h-4 bg-gray-300 rounded w-3/4"></div>
					<div class="h-4 bg-gray-300 rounded w-1/2"></div>
					<div class="h-4 bg-gray-300 rounded w-5/6"></div>
				</div>
			}
		</div>

		<!-- Loaded Content -->
		<div 
			x-show="loaded"
			x-html="content"
			class="lazy-content"
		></div>

		<!-- Error State -->
		<div 
			x-show="error"
			class={ getLazyLoaderErrorClasses() }
		>
			<svg class="w-8 h-8 text-red-400 mb-2" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
			</svg>
			<p class="text-red-600 mb-2">{ getErrorText(props.ErrorText) }</p>
			if props.RetryButton {
				<button 
					@click="retryLoad()"
					class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition-colors"
				>
					Retry
				</button>
			}
		</div>
	</div>
}

// Performance optimization helper functions
func getLazyImageData(props LazyImageProps) string {
	quality := 75
	if props.Quality > 0 && props.Quality <= 100 {
		quality = props.Quality
	}

	loading := "lazy"
	if props.Loading != "" {
		loading = props.Loading
	}

	return fmt.Sprintf(`{
		loaded: false,
		loading: false,
		error: false,
		imageSrc: '',
		originalSrc: '%s',
		quality: %d,
		loading: '%s',
		observer: null,
		
		initLazyImage() {
			if (this.loading === 'eager') {
				this.loadImage();
				return;
			}
			
			// Set up Intersection Observer
			this.observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting && !this.loaded && !this.loading) {
						this.loadImage();
						if (this.loading !== 'auto') {
							this.observer.disconnect();
						}
					}
				});
			}, {
				threshold: 0.1,
				rootMargin: '50px'
			});
			
			this.observer.observe(this.$el);
		},
		
		loadImage() {
			this.loading = true;
			this.error = false;
			
			// Construct optimized image URL
			this.imageSrc = this.optimizeImageUrl(this.originalSrc);
			
			// Preload image
			const img = new Image();
			img.onload = () => {
				this.loaded = true;
				this.loading = false;
			};
			img.onerror = () => {
				this.error = true;
				this.loading = false;
			};
			img.src = this.imageSrc;
		},
		
		optimizeImageUrl(url) {
			// Add quality and format parameters if supported
			const separator = url.includes('?') ? '&' : '?';
			return url + separator + 'q=' + this.quality + '&auto=format';
		},
		
		handleImageLoad() {
			this.loaded = true;
			this.loading = false;
		},
		
		handleImageError() {
			this.error = true;
			this.loading = false;
		},
		
		retryLoad() {
			this.loadImage();
		}
	}`, props.Src, quality, loading)
}

func getVirtualListData(props VirtualListProps) string {
	overscan := 5
	if props.Overscan > 0 {
		overscan = props.Overscan
	}

	return fmt.Sprintf(`{
		items: %s,
		visibleItems: [],
		itemHeight: %d,
		containerHeight: %d,
		overscan: %d,
		scrollTop: 0,
		virtualTop: 0,
		virtualBottom: 0,
		totalItems: 0,
		startIndex: 0,
		endIndex: 0,
		loadingMore: false,
		
		initVirtualList() {
			this.totalItems = this.items.length;
			this.updateVisibleItems();
			
			// Set up ResizeObserver for dynamic container sizing
			if (window.ResizeObserver) {
				const resizeObserver = new ResizeObserver(() => {
					this.updateVisibleItems();
				});
				resizeObserver.observe(this.$refs.container);
			}
		},
		
		handleScroll() {
			this.scrollTop = this.$refs.container.scrollTop;
			this.updateVisibleItems();
			
			// Infinite scroll
			if (this.isLoadMoreEnabled() && this.isNearBottom()) {
				this.loadMore();
			}
		},
		
		updateVisibleItems() {
			const visibleCount = Math.ceil(this.containerHeight / this.itemHeight);
			this.startIndex = Math.max(0, Math.floor(this.scrollTop / this.itemHeight) - this.overscan);
			this.endIndex = Math.min(this.totalItems, this.startIndex + visibleCount + this.overscan * 2);
			
			this.virtualTop = this.startIndex * this.itemHeight;
			this.virtualBottom = (this.totalItems - this.endIndex) * this.itemHeight;
			
			this.visibleItems = this.items.slice(this.startIndex, this.endIndex).map((item, index) => ({
				...item,
				virtualIndex: this.startIndex + index
			}));
		},
		
		renderItem(item) {
			// This would integrate with your templating system
			return '<div class="p-4 border-b">' + JSON.stringify(item.data) + '</div>';
		},
		
		isLoadMoreEnabled() {
			return %t;
		},
		
		isNearBottom() {
			const threshold = 100; // pixels from bottom
			return (this.scrollTop + this.containerHeight) >= (this.totalItems * this.itemHeight - threshold);
		},
		
		async loadMore() {
			if (this.loadingMore) return;
			
			this.loadingMore = true;
			try {
				// Simulate API call
				await new Promise(resolve => setTimeout(resolve, 1000));
				// In real implementation, you'd fetch more items here
				this.loadingMore = false;
			} catch (error) {
				this.loadingMore = false;
				console.error('Failed to load more items:', error);
			}
		}
	}`, getItemsJSON(props.Items), props.ItemHeight, props.ContainerHeight, overscan, props.LoadMore)
}

func getLazyLoaderData(props LazyLoaderProps) string {
	threshold := "0.1"
	if props.Threshold != "" {
		threshold = props.Threshold
	}

	rootMargin := "0px"
	if props.RootMargin != "" {
		rootMargin = props.RootMargin
	}

	return fmt.Sprintf(`{
		loaded: false,
		loading: false,
		error: false,
		content: '',
		observer: null,
		loadOnce: %t,
		
		initLazyLoader() {
			this.observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting && !this.loaded && !this.loading) {
						this.loadContent();
						if (this.loadOnce) {
							this.observer.disconnect();
						}
					}
				});
			}, {
				threshold: %s,
				rootMargin: '%s'
			});
			
			this.observer.observe(this.$refs.lazyContainer);
		},
		
		async loadContent() {
			this.loading = true;
			this.error = false;
			
			try {
				const response = await fetch('%s', {
					headers: {
						'X-Requested-With': 'XMLHttpRequest',
						'Accept': 'text/html'
					}
				});
				
				if (!response.ok) {
					throw new Error('Failed to load content');
				}
				
				this.content = await response.text();
				this.loaded = true;
			} catch (error) {
				this.error = true;
				console.error('Error loading content:', error);
			} finally {
				this.loading = false;
			}
		},
		
		retryLoad() {
			this.loadContent();
		}
	}`, props.LoadOnce, threshold, rootMargin, props.Endpoint)
}

// Helper functions for styling
func getLazyImageContainerClasses(class string) string {
	base := "relative overflow-hidden"
	if class != "" {
		return base + " " + class
	}
	return base
}

func getLazyImagePlaceholderClasses() string {
	return "absolute inset-0 bg-gray-200 dark:bg-gray-700 flex items-center justify-center"
}

func getLazyImagePlaceholderImageClasses(blurAmount int) string {
	blur := 4
	if blurAmount > 0 {
		blur = blurAmount
	}
	return fmt.Sprintf("w-full h-full object-cover filter blur-%dpx", blur)
}

func getLazyImageSkeletonClasses() string {
	return "w-full h-full flex items-center justify-center bg-gray-200 dark:bg-gray-700"
}

