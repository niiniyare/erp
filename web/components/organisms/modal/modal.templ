package modal

import (
	"github.com/niiniyare/erp/web/components/atoms"
)

// Modal renders a dialog modal with backdrop and focus management
templ Modal(props ModalProps) {
	<div 
		class={ "fixed inset-0 overflow-y-auto", getModalZIndex(props.ZIndex) }
		:class="{ 'hidden': !open }"
		x-data={ generateModalAlpineData(props) }
		x-show="open"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		if props.ID != "" {
			id={ props.ID }
		}
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		if props.AriaDescribedBy != "" {
			aria-describedby={ props.AriaDescribedBy }
		}
		role={ getModalRole(props.Type) }
		aria-modal="true"
		@keydown.escape="handleEscapeKey()"
		if props.DataTestID != "" {
			data-testid={ props.DataTestID }
		}
	>
		<!-- Backdrop -->
		<div 
			class={ "fixed inset-0", getModalBackdropClasses(props.Backdrop) }
			@click="handleBackdropClick()"
			aria-hidden="true"
		></div>

		<!-- Modal Container -->
		<div class={ "flex min-h-full p-4", getModalPositionClasses(props.Position) }>
			<!-- Modal Content -->
			<div 
				class={ 
					"relative bg-white dark:bg-gray-800 rounded-lg shadow-xl",
					getModalSizeClasses(props.Size),
					getModalAnimation(props.Animation),
					getModalTypeClasses(props.Type),
					props.Class,
				}
				x-show="open"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				@click.stop
			>
				if props.HxGet != "" {
					<div 
						hx-get={ props.HxGet }
						if props.HxTarget != "" {
							hx-target={ props.HxTarget }
						}
						if props.HxSwap != "" {
							hx-swap={ props.HxSwap }
						}
						if props.HxTrigger != "" {
							hx-trigger={ props.HxTrigger }
						}
						hx-indicator="#modal-loading"
					>
						@ModalLoadingState()
					</div>
				} else {
					<!-- Header Section -->
					if props.Header != nil {
						@ModalHeaderSection(*props.Header, props.Closable)
					}

					<!-- Body Section -->
					@ModalBodySection(props.Body)

					<!-- Footer Section -->
					if props.Footer != nil {
						@ModalFooterSection(*props.Footer)
					}
				}
			</div>
		</div>
	</div>
}

// ModalHeaderSection renders the modal header with title and close button
templ ModalHeaderSection(header ModalHeader, closable bool) {
	<div class="flex items-center justify-between p-4 md:p-5 border-b border-gray-200 dark:border-gray-600 rounded-t">
		<div class="flex items-center space-x-3">
			if header.Icon != "" {
				<div class="flex-shrink-0">
					@atoms.Icon(atoms.IconProps{
						Name:  header.Icon,
						Size:  atoms.IconSizeMD,
						Class: "text-gray-500 dark:text-gray-400",
					})
				</div>
			}
			<div class="flex-1 min-w-0">
				if header.Title != "" {
					switch header.Level {
					case 1:
						<h1 class="text-xl font-semibold text-gray-900 dark:text-white">
							{ header.Title }
						</h1>
					case 2:
						<h2 class="text-xl font-semibold text-gray-900 dark:text-white">
							{ header.Title }
						</h2>
					case 3:
						<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
							{ header.Title }
						</h3>
					default:
						<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
							{ header.Title }
						</h3>
					}
				}
				if header.Subtitle != "" {
					<p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
						{ header.Subtitle }
					</p>
				}
			</div>
		</div>
		
		if closable && header.Closable {
			<button
				type="button"
				class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white transition-colors duration-150"
				@click="closeModal()"
				aria-label="Close modal"
			>
				@atoms.Icon(atoms.IconProps{
					Name: "x",
					Size: atoms.IconSizeSM,
				})
			</button>
		}
	</div>
}

// ModalBodySection renders the modal body content
templ ModalBodySection(body ModalBody) {
	<div 
		class={ 
			"p-4 md:p-5",
			body.Padding,
			templ.KV("overflow-y-auto max-h-96", body.Scrollable),
		}
		if body.FormID != "" {
			id={ body.FormID + "-body" }
		}
	>
		if body.Loading {
			@ModalLoadingState()
		} else {
			if body.HTML != "" {
				@templ.Raw(body.HTML)
			} else if body.Content != "" {
				<div class="text-gray-700 dark:text-gray-300">
					{ body.Content }
				</div>
			}
		}
	</div>
}

// ModalFooterSection renders the modal footer with action buttons
templ ModalFooterSection(footer ModalFooter) {
	<div class={ 
		"flex items-center p-4 md:p-5 border-t border-gray-200 dark:border-gray-600 rounded-b",
		getFooterAlignmentClasses(footer.Alignment),
		templ.KV("space-x-2", !footer.Compact),
		templ.KV("space-x-1", footer.Compact),
	}>
		if footer.CustomContent != "" {
			@templ.Raw(footer.CustomContent)
		} else {
			for _, action := range footer.Actions {
				@ModalActionButton(action)
			}
		}
	</div>
}

// ModalActionButton renders a single action button
templ ModalActionButton(action ModalAction) {
	@atoms.Button(atoms.ButtonProps{
		Text:      action.Text,
		Icon:      action.Icon,
		Variant:   action.Variant,
		Size:      action.Size,
		Type:      action.Type,
		OnClick:   action.OnClick,
		HxPost:    action.HxPost,
		HxGet:     action.HxGet,
		HxTarget:  action.HxTarget,
		HxSwap:    action.HxSwap,
		HxConfirm: action.HxConfirm,
		Form:      action.Form,
		Disabled:  action.Disabled,
		AutoFocus: action.AutoFocus,
		ID:        action.ID,
		Class:     action.Class,
	})
}

// ModalLoadingState renders loading spinner for modal content
templ ModalLoadingState() {
	<div id="modal-loading" class="flex items-center justify-center p-8">
		<div class="text-center">
			@atoms.Spinner(atoms.SpinnerProps{
				Size: atoms.SpinnerSizeMD,
				Color: "text-blue-600",
			})
			<p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
				Loading...
			</p>
		</div>
	</div>
}

// ConfirmModal renders a confirmation dialog
templ ConfirmModal(props ConfirmModalProps) {
	if props.Title == "" {
		// Set default title
		{{ props.Title = "Confirm Action" }}
	}
	if props.ConfirmText == "" {
		{{ props.ConfirmText = "Confirm" }}
	}
	if props.CancelText == "" {
		{{ props.CancelText = "Cancel" }}
	}
	
	<div 
		class="fixed inset-0 z-50 overflow-y-auto"
		x-data="{ open: false }"
		x-show="open"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		role="alertdialog"
		aria-modal="true"
		@keydown.escape="open = false"
	>
		<!-- Backdrop -->
		<div class="fixed inset-0 bg-gray-900/50 backdrop-blur-sm" @click="open = false"></div>

		<!-- Modal -->
		<div class="flex min-h-full items-center justify-center p-4">
			<div 
				class="relative bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-md w-full"
				x-show="open"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				@click.stop
			>
				<div class="p-6 text-center">
					if props.Icon != "" {
						<div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full mb-4">
							{{ iconColor, _ := getConfirmVariantClasses(props.Variant) }}
							@atoms.Icon(atoms.IconProps{
								Name:  props.Icon,
								Size:  atoms.IconSizeLG,
								Class: iconColor,
							})
						</div>
					} else {
						<div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full mb-4">
							{{ iconColor, _ := getConfirmVariantClasses(props.Variant) }}
							@atoms.Icon(atoms.IconProps{
								Name:  getConfirmIcon(props.Variant),
								Size:  atoms.IconSizeLG,
								Class: iconColor,
							})
						</div>
					}

					<h3 class="mb-5 text-lg font-normal text-gray-500 dark:text-gray-400">
						{ props.Title }
					</h3>
					
					if props.Message != "" {
						<p class="mb-5 text-sm text-gray-500 dark:text-gray-400">
							{ props.Message }
						</p>
					}

					<div class="flex justify-center gap-4">
						{{ _, buttonVariant := getConfirmVariantClasses(props.Variant) }}
						@atoms.Button(atoms.ButtonProps{
							Text:    props.ConfirmText,
							Variant: getButtonVariantFromString(buttonVariant),
							OnClick: props.OnConfirm + "; open = false",
							AutoFocus: true,
						})
						
						@atoms.Button(atoms.ButtonProps{
							Text:    props.CancelText,
							Variant: atoms.ButtonLight,
							OnClick: props.OnCancel + "; open = false",
						})
					</div>
				</div>
			</div>
		</div>
	</div>
}

// FormModal renders a modal specifically designed for forms
templ FormModal(props FormModalProps) {
	<div 
		class="fixed inset-0 z-50 overflow-y-auto"
		x-data={ generateFormAlpineData(props) }
		x-show="open"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		role="dialog"
		aria-modal="true"
		@keydown.escape="closeModal()"
	>
		<!-- Backdrop -->
		<div class="fixed inset-0 bg-gray-900/50 backdrop-blur-sm" @click="closeModal()"></div>

		<!-- Modal -->
		<div class="flex min-h-full items-center justify-center p-4">
			<div 
				class={ "relative bg-white dark:bg-gray-800 rounded-lg shadow-xl", getModalSizeClasses(props.Size) }
				x-show="open"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				@click.stop
			>
				<!-- Header -->
				<div class="flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-600">
					<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
						{ props.Title }
					</h3>
					<button
						type="button"
						class="text-gray-400 hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white"
						@click="closeModal()"
					>
						@atoms.Icon(atoms.IconProps{
							Name: "x",
							Size: atoms.IconSizeSM,
						})
					</button>
				</div>

				<!-- Form Content -->
				<form 
					if props.FormID != "" {
						id={ props.FormID }
					}
					if props.FormAction != "" && props.HxPost == "" {
						action={ props.FormAction }
					}
					if props.FormMethod != "" && props.HxPost == "" {
						method={ props.FormMethod }
					}
					if props.HxPost != "" {
						hx-post={ props.HxPost }
					}
					if props.HxTarget != "" {
						hx-target={ props.HxTarget }
					}
					if props.HxSwap != "" {
						hx-swap={ props.HxSwap }
					}
					@submit="submitForm()"
					@htmx:after-request="handleFormResponse($event.detail)"
				>
					<div class="p-4">
						if props.Content != "" {
							@templ.Raw(props.Content)
						}
					</div>

					<!-- Footer -->
					<div class="flex items-center justify-end gap-2 p-4 border-t border-gray-200 dark:border-gray-600">
						@atoms.Button(atoms.ButtonProps{
							Text:    props.CancelText,
							Variant: atoms.ButtonLight,
							Type:    "button",
							OnClick: "closeModal()",
						})
						
						@atoms.Button(atoms.ButtonProps{
							Text:     props.SubmitText,
							Variant:  atoms.ButtonPrimary,
							Type:     "submit",
							Disabled: false,
							Class:    "min-w-[100px]",
						})
					</div>
				</form>
			</div>
		</div>
	</div>
}