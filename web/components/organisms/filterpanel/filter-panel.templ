package filterpanel

import (
	"fmt"
	"github.com/niiniyare/erp/web/components/atoms"
	"github.com/niiniyare/erp/web/components/molecules"
)

// FilterPanel renders an advanced filter system with collapsible groups
templ FilterPanel(props FilterPanelProps) {
	<div 
		class={ getFilterPanelClasses(props) }
		x-data={ generateFilterPanelAlpineData(props) }
		if props.ID != "" {
			id={ props.ID }
		}
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		if props.DataTestID != "" {
			data-testid={ props.DataTestID }
		}
	>
		<!-- Filter Panel Header -->
		if props.Title != "" || props.Collapsible || props.ShowPresets {
			@FilterPanelHeader(props)
		}

		<!-- Filter Content -->
		<div 
			class="transition-all duration-300 ease-in-out overflow-hidden"
			:class="{ 'max-h-0': collapsed, 'max-h-none': !collapsed }"
			x-show="!collapsed"
			x-transition:enter="transition ease-out duration-300"
			x-transition:enter-start="opacity-0 max-h-0"
			x-transition:enter-end="opacity-100 max-h-none"
			x-transition:leave="transition ease-in duration-300"
			x-transition:leave-start="opacity-100 max-h-none"
			x-transition:leave-end="opacity-0 max-h-0"
		>
			<!-- Search Integration -->
			if props.SearchProps != nil {
				<div class="p-4 border-b border-gray-200 dark:border-gray-700">
					@molecules.Search(*props.SearchProps)
				</div>
			}

			<!-- Filter Form -->
			<form 
				if props.FormAction != "" && props.HxPost == "" {
					action={ props.FormAction }
				}
				if props.FormMethod != "" && props.HxPost == "" {
					method={ props.FormMethod }
				}
				if props.HxPost != "" {
					hx-post={ props.HxPost }
				}
				if props.HxGet != "" {
					hx-get={ props.HxGet }
				}
				if props.HxTarget != "" {
					hx-target={ props.HxTarget }
				}
				if props.HxSwap != "" {
					hx-swap={ props.HxSwap }
				}
				if props.HxTrigger != "" {
					hx-trigger={ props.HxTrigger }
				}
				@submit="applyFilters()"
				@htmx:after-request="updateResultCount($event.detail.xhr.getResponseHeader('X-Result-Count') || 0); loading = false"
			>
				<!-- Filter Groups -->
				if len(props.Groups) > 0 {
					for _, group := range props.Groups {
						@FilterGroupComponent(group)
					}
				}

				<!-- Standalone Fields -->
				if len(props.Fields) > 0 {
					<div class="p-4">
						<div class={ getFilterLayoutClasses(1, "") }>
							for _, field := range props.Fields {
								@FilterFieldComponent(field, 1)
							}
						</div>
					</div>
				}

				<!-- Filter Actions -->
				@FilterPanelActions(props)
			</form>

			<!-- Result Count -->
			if props.ShowCount {
				@FilterResultCount(props.CountText)
			}
		</div>
	</div>
}

// FilterPanelHeader renders the header with title, presets, and collapse toggle
templ FilterPanelHeader(props FilterPanelProps) {
	<div class="flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-700">
		<div class="flex items-center space-x-3">
			if props.Title != "" {
				<h3 class="text-lg font-medium text-gray-900 dark:text-white">
					{ props.Title }
				</h3>
			}

			<!-- Result Count Badge -->
			if props.ShowCount {
				<span 
					class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300"
					x-show="resultCount > 0"
					x-text="`${resultCount} results`"
				></span>
			}
		</div>

		<div class="flex items-center space-x-2">
			<!-- Preset Selector -->
			if props.ShowPresets && len(props.Presets) > 0 {
				@FilterPresetSelector(props.Presets)
			}

			<!-- Clear All Button -->
			if props.ClearAll {
				@atoms.Button(atoms.ButtonProps{
					BaseProps: atoms.BaseProps{
						Class: "text-xs",
					},
					AlpinEventHandlers: atoms.AlpinEventHandlers{
						OnClick: "clearAllFilters()",
					},
					Text:    "Clear All",
					Icon:    atoms.IconProps{Name: "x"},
					Variant: atoms.VariantLight,
					Size:    atoms.ButtonSizeSM,
				})
			}

			<!-- Collapse Toggle -->
			if props.Collapsible {
				<button
					type="button"
					class="p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors duration-150"
					@click="toggleCollapsed()"
					:aria-expanded="!collapsed"
					aria-label="Toggle filter panel"
				>
					<div class="transform transition-transform duration-300" :class="{ 'rotate-180': !collapsed }">
						@atoms.Icon(atoms.IconProps{
							Name: "chevron-up",
							Size: atoms.IconSizeSM,
						})
					</div>
				</button>
			}
		</div>
	</div>
}

// FilterGroup renders a collapsible group of filter fields
templ FilterGroupComponent(group FilterGroup) {
	<div 
		class={ getFilterGroupClasses(group) }
		if group.ID != "" {
			id={ group.ID }
		}
		x-show="!loading"
	>
		<!-- Group Header -->
		if group.Title != "" {
			<div class="flex items-center justify-between p-4 cursor-pointer" @click="$refs.groupContent.classList.toggle('hidden')">
				<div class="flex items-center space-x-2">
					if group.Icon != "" {
						@atoms.Icon(atoms.IconProps{
							Name:  group.Icon,
							Size:  atoms.IconSizeSM,
							Class: "text-gray-500 dark:text-gray-400",
						})
					}
					<h4 class="font-medium text-gray-900 dark:text-white">
						{ group.Title }
					</h4>
					if group.Description != "" {
						<span class="text-sm text-gray-500 dark:text-gray-400">
							{ group.Description }
						</span>
					}
				</div>
				
				if group.Collapsible {
					<div class="transform transition-transform duration-200" :class="{ 'rotate-180': !$refs.groupContent.classList.contains('hidden') }">
						@atoms.Icon(atoms.IconProps{
							Name: "chevron-down",
							Size: atoms.IconSizeXS,
						})
					</div>
				}
			</div>
		}

		<!-- Group Content -->
		<div 
			x-ref="groupContent"
			class={ templ.KV("hidden", group.Collapsed) }
		>
			<div class="p-4 pt-0">
				<div class={ getFilterLayoutClasses(group.Columns, group.Spacing) }>
					for _, field := range group.Fields {
						@FilterFieldComponent(field, group.Columns)
					}
				</div>
			</div>
		</div>
	</div>
}

// FilterField renders a single filter field with appropriate input type
templ FilterFieldComponent(field FilterField, columns int) {
	<div 
		class={ getFilterFieldClasses(field, columns) }
		if field.ID != "" {
			id={ field.ID + "-container" }
		}
		x-show="isFieldVisible(field)"
	>
		switch field.Type {
		case FilterTypeText, FilterTypeNumber, FilterTypeDate:
			@FilterInputField(field)
		case FilterTypeSearch:
			@FilterSearchField(field)
		case FilterTypeSelect:
			@FilterSelectField(field)
		case FilterTypeCheckbox:
			@FilterCheckboxField(field)
		case FilterTypeRadio:
			@FilterRadioField(field)
		case FilterTypeDateRange:
			@FilterDateRangeField(field)
		default:
			@FilterInputField(field)
		}
	</div>
}

// FilterInputField renders basic input fields
templ FilterInputField(field FilterField) {
	@molecules.Field(molecules.FieldProps{
		BaseProps: atoms.BaseProps{
			ID:    field.Name,
			Class: field.Class + " w-full",
		},
		AlpinEventHandlers: atoms.AlpinEventHandlers{
			OnChange: "onFieldChange('" + field.Name + "', $event.target.value)",
		},
		Type:        molecules.FieldTypeInput,
		Label:       field.Label,
		Name:        field.Name,
		Value:       formatFieldValue(field.Value, field.Type),
		Placeholder: field.Placeholder,
		HelpText:    field.Help,
		Required:    field.Required,
		InputType:   getInputTypeForFilter(field.Type),
	})
}

// FilterSearchField renders search input with suggestions
templ FilterSearchField(field FilterField) {
	@molecules.Search(molecules.SearchProps{
		Name:        field.Name,
		Placeholder: field.Placeholder,
		Value:       fmt.Sprintf("%v", field.Value),
		OnSearch:    "onFieldChange('" + field.Name + "', $event.target.value)",
		HxGet:       field.HxGet,
		HxTarget:    field.HxTarget,
		HxTrigger:   field.HxTrigger,
		Class:       field.Class,
	})
}

// FilterSelectField renders select dropdown
templ FilterSelectField(field FilterField) {
	@molecules.Field(molecules.FieldProps{
		BaseProps: atoms.BaseProps{
			ID:    field.Name,
			Class: field.Class + " w-full",
		},
		AlpinEventHandlers: atoms.AlpinEventHandlers{
			OnChange: "onFieldChange('" + field.Name + "', $event.target.value)",
		},
		Type:        molecules.FieldTypeSelect,
		Label:       field.Label,
		Name:        field.Name,
		Required:    field.Required,
		HelpText:    field.Help,
		Multiple:    field.Multiple,
		Options:     convertToSelectOptions(field.Options),
	})
}

// FilterCheckboxField renders checkbox group
templ FilterCheckboxField(field FilterField) {
	<div class="space-y-2">
		if field.Label != "" {
			<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
				{ field.Label }
				if field.Required {
					<span class="text-red-500">*</span>
				}
			</label>
		}
		<div class="space-y-2">
			for _, option := range field.Options {
				@atoms.Checkbox(atoms.CheckboxProps{
					BaseProps: atoms.BaseProps{
						ID:   field.Name + "_" + option.Value,
						Name: field.Name + "[]",
					},
					LabelProps: atoms.LabelProps{
						Label: option.Label,
					},
					InteractionProps: atoms.InteractionProps{
						Disabled: option.Disabled,
					},
					AlpinEventHandlers: atoms.AlpinEventHandlers{
						OnChange: "onFieldChange('" + field.Name + "', getCheckboxValues('" + field.Name + "'))",
					},
					Value:   option.Value,
					Checked: option.Selected,
				})
			}
		</div>
		if field.Help != "" {
			<p class="text-sm text-gray-500 dark:text-gray-400">{ field.Help }</p>
		}
	</div>
}

// FilterRadioField renders radio button group
templ FilterRadioField(field FilterField) {
	<div class="space-y-2">
		if field.Label != "" {
			<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
				{ field.Label }
				if field.Required {
					<span class="text-red-500">*</span>
				}
			</label>
		}
		<div class="space-y-2">
			for _, option := range field.Options {
				@atoms.Radio(atoms.RadioProps{
					BaseProps: atoms.BaseProps{
						ID:   field.Name + "_" + option.Value,
						Name: field.Name,
					},
					LabelProps: atoms.LabelProps{
						Label: option.Label,
					},
					InteractionProps: atoms.InteractionProps{
						Disabled: option.Disabled,
					},
					AlpinEventHandlers: atoms.AlpinEventHandlers{
						OnChange: "onFieldChange('" + field.Name + "', $event.target.value)",
					},
					Value:   option.Value,
					Checked: option.Selected,
				})
			}
		</div>
		if field.Help != "" {
			<p class="text-sm text-gray-500 dark:text-gray-400">{ field.Help }</p>
		}
	</div>
}

// FilterDateRangeField renders date range picker
templ FilterDateRangeField(field FilterField) {
	@molecules.FieldGroup(molecules.FieldGroupProps{
		Title:       field.Label,
		Fields: []molecules.FieldProps{
			{
				BaseProps: atoms.BaseProps{
					ID: field.Name + "_start",
				},
				AlpinEventHandlers: atoms.AlpinEventHandlers{
					OnChange: "onFieldChange('" + field.Name + "_start', $event.target.value)",
				},
				Type:        molecules.FieldTypeInput,
				Label:       "Start Date",
				Name:        field.Name + "[start]",
				InputType:   atoms.InputTypeDate,
				Placeholder: "Start date",
			},
			{
				BaseProps: atoms.BaseProps{
					ID: field.Name + "_end",
				},
				AlpinEventHandlers: atoms.AlpinEventHandlers{
					OnChange: "onFieldChange('" + field.Name + "_end', $event.target.value)",
				},
				Type:        molecules.FieldTypeInput,
				Label:       "End Date",
				Name:        field.Name + "[end]",
				InputType:   atoms.InputTypeDate,
				Placeholder: "End date",
			},
		},
	})
}

// FilterPanelActions renders action buttons
templ FilterPanelActions(props FilterPanelProps) {
	<div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-700/50 border-t border-gray-200 dark:border-gray-600">
		<div class="flex items-center space-x-2">
			<!-- Custom Actions (Left) -->
			for _, action := range props.Actions {
				if action.Position == "left" {
					@FilterActionButton(action)
				}
			}
		</div>

		<div class="flex items-center space-x-2">
			<!-- Save Preset -->
			if props.ShowSave {
				@atoms.Button(atoms.ButtonProps{
					AlpinEventHandlers: atoms.AlpinEventHandlers{
						OnClick: "savePreset(prompt('Preset name:'), prompt('Description (optional):'))",
					},
					Text:    "Save",
					Icon:    atoms.IconProps{Name: "bookmark"},
					Variant: atoms.VariantLight,
					Size:    atoms.ButtonSizeSM,
				})
			}

			<!-- Reset -->
			if props.ShowReset {
				@atoms.Button(atoms.ButtonProps{
					Text:    "Reset",
					Icon:    atoms.IconProps{Name: "refresh"},
					Variant: atoms.VariantLight,
					Size:    atoms.ButtonSizeSM,
					Type:    "reset",
					OnClick: "resetFilters()",
				})
			}

			<!-- Apply -->
			if props.ShowApply {
				@atoms.Button(atoms.ButtonProps{
					BaseProps: atoms.BaseProps{
						Class: "min-w-[120px]",
					},
					Text:    "Apply Filters",
					Icon:    atoms.IconProps{Name: "search"},
					Variant: atoms.VariantPrimary,
					Size:    atoms.ButtonSizeSM,
					Type:    "submit",
					Loading: false,
				})
			}

			<!-- Custom Actions (Right) -->
			for _, action := range props.Actions {
				if action.Position != "left" {
					@FilterActionButton(action)
				}
			}
		</div>
	</div>
}

// FilterActionButton renders a custom action button
templ FilterActionButton(action FilterAction) {
	@atoms.Button(atoms.ButtonProps{
		AlpinEventHandlers: atoms.AlpinEventHandlers{
			OnClick: action.OnClick,
		},
		Text:      action.Text,
		Icon:      atoms.IconProps{Name: action.Icon},
		Variant:   action.Variant,
		Size:      action.Size,
		Type:      action.Type,
		HxPost:    action.HxPost,
		HxGet:     action.HxGet,
		HxTarget:  action.HxTarget,
		BaseProps: atoms.BaseProps{
			ID:    action.ID,
			Class: action.Class,
		},
		InteractionProps: atoms.InteractionProps{
			Disabled: action.Disabled,
		},
		HxSwap:    action.HxSwap,
		// Note: AutoFocus not supported in ButtonProps
	})
}

// FilterPresetSelector renders preset dropdown
templ FilterPresetSelector(presets []FilterPreset) {
	<div class="relative" x-data="{ open: false }">
		<button
			type="button"
			class="inline-flex items-center px-3 py-2 border border-gray-300 dark:border-gray-600 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
			@click="open = !open"
		>
			@atoms.Icon(atoms.IconProps{
				Name: "bookmark",
				Size: atoms.IconSizeXS,
				Class: "mr-2",
			})
			<span x-text="selectedPreset ? presets.find(p => p.id === selectedPreset)?.name : 'Presets'"></span>
			@atoms.Icon(atoms.IconProps{
				Name: "chevron-down",
				Size: atoms.IconSizeXS,
				Class: "ml-2",
			})
		</button>

		<div 
			class="absolute right-0 mt-2 w-56 rounded-md shadow-lg bg-white dark:bg-gray-700 ring-1 ring-black ring-opacity-5 z-10"
			x-show="open"
			@click.away="open = false"
			x-transition:enter="transition ease-out duration-100"
			x-transition:enter-start="transform opacity-0 scale-95"
			x-transition:enter-end="transform opacity-100 scale-100"
		>
			<div class="py-1">
				for _, preset := range presets {
					<button
						type="button"
						class="w-full text-left block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-600"
						@click={ "loadPreset(" + preset.ID + "); open = false" }
					>
						<div class="font-medium">{ preset.Name }</div>
						if preset.Description != "" {
							<div class="text-xs text-gray-500 dark:text-gray-400">{ preset.Description }</div>
						}
					</button>
				}
			</div>
		</div>
	</div>
}

// FilterResultCount renders the result count display
templ FilterResultCount(customText string) {
	<div class="px-4 py-2 bg-blue-50 dark:bg-blue-900/20 border-t border-blue-200 dark:border-blue-800">
		<div class="flex items-center justify-between">
			<p class="text-sm text-blue-700 dark:text-blue-300">
				if customText != "" {
					<span x-text={ "`" + customText + " ${resultCount}`" }></span>
				} else {
					<span x-show="resultCount > 0" x-text="`Found ${resultCount} results`"></span>
					<span x-show="resultCount === 0">No results found</span>
				}
			</p>
			<div class="flex items-center" x-show="loading">
				@atoms.Spinner(atoms.SpinnerProps{
					Size:  atoms.SpinnerSizeXS,
					Color: "text-blue-600",
				})
			</div>
		</div>
	</div>
}

// QuickFilter renders a simplified horizontal filter layout
templ QuickFilter(props QuickFilterProps) {
	<div 
		class={ "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4", getQuickFilterClasses(props) }
		x-data="{ filters: {} }"
	>
		<form 
			if props.HxPost != "" {
				hx-post={ props.HxPost }
			}
			if props.HxTarget != "" {
				hx-target={ props.HxTarget }
			}
			hx-trigger="submit, change delay:500ms"
		>
			for _, field := range props.Fields {
				@FilterFieldComponent(field, 1)
			}
			
			if !props.Compact {
				<div class="flex-shrink-0">
					@atoms.Button(atoms.ButtonProps{
						Text:    "Filter",
						Icon:    atoms.IconProps{Name: "search"},
						Variant: atoms.VariantPrimary,
						Size:    atoms.ButtonSizeSM,
						Type:    "submit",
					})
				</div>
			}
		</form>
	</div>
}