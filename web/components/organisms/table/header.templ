package table

import (
	"github.com/niiniyare/erp/web/components/atoms"
	"github.com/niiniyare/erp/web/components/molecules"
)

// DataTableHeader renders the table header with search and actions
templ DataTableHeader(props DataTableProps) {
	<div class="flex flex-col md:flex-row items-center justify-between space-y-3 md:space-y-0 md:space-x-4 p-4">
		<div class="w-full md:w-1/2">
			if props.SearchProps != nil {
				@molecules.Search(*props.SearchProps)
			}
		</div>
		
		<div class="w-full md:w-auto flex flex-col md:flex-row space-y-2 md:space-y-0 items-stretch md:items-center justify-end md:space-x-3 flex-shrink-0">
			if len(props.Actions) > 0 {
				for _, action := range props.Actions {
					@atoms.Button(atoms.ButtonProps{
						Text:     action.Text,
						Icon:     action.Icon,
						Variant:  action.Variant,
						OnClick:  action.OnClick,
						HxPost:   action.HxPost,
						HxGet:    action.HxGet,
						HxTarget: action.HxTarget,
					})
				}
			}
			
			if props.ShowFilters {
				@atoms.Button(atoms.ButtonProps{
					Text:    "Filters",
					Icon:    "filter",
					Variant: atoms.ButtonSecondary,
					OnClick: "toggleFilters()",
				})
			}
		</div>
	</div>
}

// DataTableHead renders the table header row
templ DataTableHead(columns []DataTableColumn, sortable bool) {
	<thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
		<tr>
			<th scope="col" class="p-4">
				<div class="flex items-center">
					@atoms.Checkbox(atoms.CheckboxProps{
						ID:      "select-all",
						OnChange: "toggleSelectAll()",
						Class:   "text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600",
					})
					<label for="select-all" class="sr-only">Select all</label>
				</div>
			</th>
			
			for _, column := range columns {
				if !column.Hidden {
					@DataTableHeaderCell(column, sortable)
				}
			}
			
			<th scope="col" class="p-4">
				<span class="sr-only">Actions</span>
			</th>
		</tr>
	</thead>
}

// DataTableHeaderCell renders a single header cell
templ DataTableHeaderCell(column DataTableColumn, sortable bool) {
	<th 
		scope="col" 
		class={ getTableHeaderClasses(column, sortable) }
		if column.Width != "" {
			style={ "width: " + column.Width }
		}
		if sortable && column.Sortable {
			@click={ "sortBy('" + column.Key + "')" }
			role="button"
			tabindex="0"
			@keydown.enter={ "sortBy('" + column.Key + "')" }
			@keydown.space.prevent={ "sortBy('" + column.Key + "')" }
		}
	>
		<div class="flex items-center">
			{ column.Label }
			if sortable && column.Sortable {
				<div class="ml-1 flex flex-col">
					<div 
						class="transition-opacity duration-150"
						:class={ "{ 'opacity-100': sortColumn === '" + column.Key + "' && sortDirection === 'asc', 'opacity-30': sortColumn !== '" + column.Key + "' || sortDirection !== 'asc' }" }
					>
						@atoms.Icon(atoms.IconProps{
							Name: "chevron-up",
							Size: atoms.IconSizeXS,
							Class: "text-gray-400",
						})
					</div>
					<div 
						class="transition-opacity duration-150 -mt-1"
						:class={ "{ 'opacity-100': sortColumn === '" + column.Key + "' && sortDirection === 'desc', 'opacity-30': sortColumn !== '" + column.Key + "' || sortDirection !== 'desc' }" }
					>
						@atoms.Icon(atoms.IconProps{
							Name: "chevron-down",
							Size: atoms.IconSizeXS,
							Class: "text-gray-400",
						})
					</div>
				</div>
			}
		</div>
	</th>
}