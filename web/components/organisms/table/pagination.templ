package table

import (
	"github.com/niiniyare/erp/web/components/atoms"
)

// DataTablePagination renders pagination controls
templ DataTablePagination(props DataTableProps) {
	<div class="flex items-center justify-between px-4 py-3 bg-white border-t border-gray-200 dark:bg-gray-800 dark:border-gray-700 sm:px-6">
		@DataTablePaginationInfo()
		@DataTablePaginationControls(props)
	</div>
}

// DataTablePaginationInfo renders the pagination information text
templ DataTablePaginationInfo() {
	<div class="flex items-center text-sm text-gray-700 dark:text-gray-400">
		<span>Showing</span>
		<span class="font-medium mx-1" x-text="pageInfo.start || 0"></span>
		<span>to</span>
		<span class="font-medium mx-1" x-text="pageInfo.end || 0"></span>
		<span>of</span>
		<span class="font-medium mx-1" x-text="pageInfo.total || 0"></span>
		<span>results</span>
	</div>
}

// DataTablePaginationControls renders the pagination navigation controls
templ DataTablePaginationControls(props DataTableProps) {
	<div class="flex items-center space-x-2">
		@DataTablePaginationPrevious()
		@DataTablePaginationPages()
		@DataTablePaginationNext()
		@DataTablePaginationSizeSelector(props)
	</div>
}

// DataTablePaginationPrevious renders the previous page button
templ DataTablePaginationPrevious() {
	@atoms.Button(atoms.ButtonProps{
		AccessibilityProps: atoms.AccessibilityProps{
			AriaLabel: "Go to previous page",
		},
		InteractionProps: atoms.InteractionProps{
			Disabled: true, // TODO: Bind to actual pagination state
		},
		AlpinEventHandlers: atoms.AlpinEventHandlers{
			OnClick: "goToPage(pageInfo.current - 1)",
		},
		Icon:     atoms.IconProps{Name: "chevron-left"},
		Variant:  atoms.VariantLight,
		Size:     atoms.ButtonSizeSM,
	})
}

// DataTablePaginationNext renders the next page button
templ DataTablePaginationNext() {
	@atoms.Button(atoms.ButtonProps{
		AccessibilityProps: atoms.AccessibilityProps{
			AriaLabel: "Go to next page",
		},
		InteractionProps: atoms.InteractionProps{
			Disabled: true, // TODO: Bind to actual pagination state
		},
		AlpinEventHandlers: atoms.AlpinEventHandlers{
			OnClick: "goToPage(pageInfo.current + 1)",
		},
		Icon:     atoms.IconProps{Name: "chevron-right"},
		Variant:  atoms.VariantLight,
		Size:     atoms.ButtonSizeSM,
	})
}

// DataTablePaginationPages renders the page number buttons
templ DataTablePaginationPages() {
	<div class="hidden sm:flex items-center space-x-1">
		<!-- TODO: Implement page number generation -->
		<!-- FIXME: Connect with simple-datatables pagination API -->
		<template x-for="page in paginationPages" :key="page">
			<button
				type="button"
				class="relative inline-flex items-center px-3 py-2 text-sm font-medium rounded-md transition-colors duration-150"
				:class="{
					'bg-blue-600 text-white border-blue-600': page === pageInfo.current,
					'text-gray-700 bg-white border-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:bg-gray-700': page !== pageInfo.current
				}"
				@click="goToPage(page)"
				:aria-current="page === pageInfo.current ? 'page' : undefined"
				x-text="page"
			>
			</button>
		</template>
	</div>
}

// DataTablePaginationSizeSelector renders the page size dropdown
templ DataTablePaginationSizeSelector(props DataTableProps) {
	if props.Config.LengthChange {
		<div class="flex items-center space-x-2">
			<label for="page-size" class="text-sm text-gray-700 dark:text-gray-400">Show:</label>
			<select 
				id="page-size"
				name="pageSize"
				class="block w-auto px-3 py-1 text-sm border border-gray-300 rounded-md bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
				@change="changePageSize($event.target.value)"
				x-model="pageInfo.pageSize"
			>
				@DataTablePageSizeOptions(props.Config.PageLength)
			</select>
		</div>
	}
}

// DataTablePageSizeOptions renders the page size options
templ DataTablePageSizeOptions(defaultPageLength int) {
	<option value="10" selected?={ defaultPageLength == 10 }>10</option>
	<option value="25" selected?={ defaultPageLength == 25 }>25</option>
	<option value="50" selected?={ defaultPageLength == 50 }>50</option>
	<option value="100" selected?={ defaultPageLength == 100 }>100</option>
}

// DataTablePaginationCompact renders a compact pagination for mobile
templ DataTablePaginationCompact() {
	<div class="flex sm:hidden items-center justify-between w-full">
		<div class="flex items-center">
			@atoms.Button(atoms.ButtonProps{
				Text:    "Previous",
				Variant: atoms.ButtonLight,
				Size:    atoms.ButtonSizeSM,
				OnClick: "goToPage(pageInfo.current - 1)",
			})
		</div>
		
		<div class="text-sm text-gray-700 dark:text-gray-400">
			<span x-text="pageInfo.current"></span>
			<span class="mx-1">of</span>
			<span x-text="pageInfo.totalPages"></span>
		</div>
		
		<div class="flex items-center">
			@atoms.Button(atoms.ButtonProps{
				Text:    "Next",
				Variant: atoms.ButtonLight,
				Size:    atoms.ButtonSizeSM,
				OnClick: "goToPage(pageInfo.current + 1)",
			})
		</div>
	</div>
}

// DataTablePaginationJumpTo renders a page jump input
templ DataTablePaginationJumpTo() {
	<div class="hidden lg:flex items-center space-x-2">
		<span class="text-sm text-gray-700 dark:text-gray-400">Go to page:</span>
		<input
			type="number"
			min="1"
			:max="pageInfo.totalPages"
			class="block w-16 px-2 py-1 text-sm border border-gray-300 rounded-md bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
			@keydown.enter="goToPage(parseInt($event.target.value))"
			placeholder="1"
		/>
	</div>
}