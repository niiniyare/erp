package table

import (
	"github.com/niiniyare/erp/web/components/atoms"
)

// DataTable renders a complete data table organism with sorting, search, and pagination
templ DataTable(props DataTableProps) {
	<div 
		class={ getDataTableWrapperClasses(props) }
		if props.ID != "" {
			id={ props.ID + "-wrapper" }
		}
		x-data={ getDataTableAlpineData(props) }
	>
		<!-- Table Header with Search and Actions -->
		@DataTableHeader(props)
		
		<!-- Filters Panel (if enabled) -->
		if props.ShowFilters {
			@DataTableFilters(props)
		}
		
		<!-- Table Container -->
		<div class="relative overflow-hidden bg-white shadow-md dark:bg-gray-800 sm:rounded-lg">
			<!-- Bulk Actions Toolbar -->
			if len(props.BulkActions) > 0 {
				@DataTableBulkActions(props.BulkActions)
			}
			
			<!-- Loading Indicator -->
			<div 
				class="htmx-indicator absolute inset-0 bg-white/75 dark:bg-gray-800/75 z-10 flex items-center justify-center"
				if props.ID != "" {
					id={ props.ID + "-loading" }
				}
			>
				@atoms.Spinner(atoms.SpinnerProps{
					BaseProps: atoms.BaseProps{
						Class: "text-blue-600",
					},
					Size: atoms.SpinnerSizeLG,
				})
			</div>
			
			<!-- Table Element -->
			<div class="overflow-x-auto">
				<table
					if props.ID != "" {
						id={ props.ID }
					}
					class={ getDataTableClasses(props) }
					if props.AriaLabel != "" {
						aria-label={ props.AriaLabel }
					}
					if props.DataTestID != "" {
						data-testid={ props.DataTestID }
					}
					if props.Config.ServerSide && props.DataUrl != "" {
						hx-get={ props.DataUrl }
						hx-trigger="load, refreshTable from:body"
						hx-target={ "closest .overflow-x-auto" }
						hx-swap="innerHTML"
						hx-indicator={ "#" + props.ID + "-loading" }
					}
				>
					if props.Caption != "" {
						<caption class="sr-only">{ props.Caption }</caption>
					}
					
					@DataTableHead(props.Columns, props.Config.Sortable)
					@DataTableBody(props.Data, props.Columns, props.Actions)
				</table>
			</div>
			
			<!-- Pagination -->
			if props.Config.Paging {
				@DataTablePagination(props)
			}
		</div>
	</div>
}

// DataTableFilters renders collapsible filter panel
templ DataTableFilters(props DataTableProps) {
	<div 
		class="border-t border-gray-200 dark:border-gray-700"
		x-show="showFilters"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 -translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 -translate-y-2"
	>
		<div class="p-4 bg-gray-50 dark:bg-gray-900/50">
			<!-- TODO: Implement filter form using molecules.FieldGroup -->
			<!-- This would compose multiple molecules.Field components for advanced filtering -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				<div class="text-sm text-gray-600 dark:text-gray-400">
					<!-- FIXME: Replace with actual filter form composition using molecules -->
					Advanced filters will be implemented here using field molecules
				</div>
			</div>
		</div>
	</div>
}