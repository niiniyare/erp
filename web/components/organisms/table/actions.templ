package table

import (
	"strconv"
	"github.com/niiniyare/erp/web/components/atoms"
)

// DataTableBulkActions renders bulk actions toolbar
templ DataTableBulkActions(actions []DataTableAction) {
	<div 
		class="flex items-center justify-between p-4 bg-blue-50 dark:bg-blue-900/20 border-b border-blue-200 dark:border-blue-800"
		x-show="selectedRows.length > 0"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 -translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 -translate-y-2"
	>
		<div class="flex items-center">
			<span class="text-sm font-medium text-blue-900 dark:text-blue-200" x-text="`${selectedRows.length} item${selectedRows.length === 1 ? '' : 's'} selected`"></span>
		</div>
		
		<div class="flex items-center space-x-2">
			@DataTableBulkActionButtons(actions)
			
			@atoms.Button(atoms.ButtonProps{
				AlpinEventHandlers: atoms.AlpinEventHandlers{
					OnClick: "clearSelection()",
				},
				Text:    "Cancel",
				Variant: atoms.VariantLight,
				Size:    atoms.ButtonSizeSM,
			})
		</div>
	</div>
}

// DataTableBulkActionButtons renders individual bulk action buttons
templ DataTableBulkActionButtons(actions []DataTableAction) {
	for _, action := range actions {
		if action.Bulk {
			@DataTableBulkActionButton(action)
		}
	}
}

// DataTableBulkActionButton renders a single bulk action button
templ DataTableBulkActionButton(action DataTableAction) {
	@atoms.Button(atoms.ButtonProps{
		BaseProps: atoms.BaseProps{
			Class: getActionClasses(action),
		},
		InteractionProps: atoms.InteractionProps{
			Disabled: action.Disabled,
		},
		AlpinEventHandlers: atoms.AlpinEventHandlers{
			OnClick: buildBulkActionClick(action),
		},
		Text:      action.Text,
		Icon:      atoms.IconProps{Name: action.Icon},
		Variant:   action.Variant,
		Size:      atoms.ButtonSizeSM,
		HxPost:    action.HxPost,
		HxConfirm: getBulkActionConfirm(action),
	})
}

// DataTableActionsDropdown renders a dropdown for multiple actions
templ DataTableActionsDropdown(actions []DataTableAction, rowIndex int) {
	<div class="relative" x-data="{ open: false }">
		@atoms.Button(atoms.ButtonProps{
			AccessibilityProps: atoms.AccessibilityProps{
				AriaLabel: "Row actions for item " + strconv.Itoa(rowIndex + 1),
			},
			AlpinEventHandlers: atoms.AlpinEventHandlers{
				OnClick: "open = !open",
			},
			Icon:      atoms.IconProps{Name: "dots-vertical"},
			Variant:   atoms.VariantLight,
			Size:      atoms.ButtonSizeSM,
		})
		
		<!-- Dropdown menu -->
		<div 
			x-show="open"
			@click.away="open = false"
			x-transition:enter="transition ease-out duration-100"
			x-transition:enter-start="transform opacity-0 scale-95"
			x-transition:enter-end="transform opacity-100 scale-100"
			x-transition:leave="transition ease-in duration-75"
			x-transition:leave-start="transform opacity-100 scale-100"
			x-transition:leave-end="transform opacity-0 scale-95"
			class="absolute right-0 z-10 mt-2 w-48 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none dark:bg-gray-700 dark:ring-gray-600"
			role="menu"
		>
			for _, action := range actions {
				if action.Single {
					@DataTableActionMenuItem(action, rowIndex)
				}
			}
		</div>
	</div>
}

// DataTableActionMenuItem renders a single action menu item
templ DataTableActionMenuItem(action DataTableAction, rowIndex int) {
	<button
		type="button"
		class="group flex w-full items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-600 transition-colors duration-150"
		if action.OnClick != "" {
			@click={ action.OnClick + "; open = false" }
		}
		if action.HxPost != "" {
			hx-post={ action.HxPost }
			@click="open = false"
		}
		if action.HxGet != "" {
			hx-get={ action.HxGet }
			@click="open = false"
		}
		if action.HxTarget != "" {
			hx-target={ action.HxTarget }
		}
		if action.HxConfirm != "" {
			hx-confirm={ action.HxConfirm }
		}
		role="menuitem"
	>
		if action.Icon != "" {
			@atoms.Icon(atoms.IconProps{
				Name:  action.Icon,
				Size:  atoms.IconSizeSM,
				Class: "mr-3 text-gray-400 group-hover:text-gray-500 dark:text-gray-500 dark:group-hover:text-gray-400",
			})
		}
		{ action.Text }
	</button>
}

// DataTableQuickActions renders quick action buttons without dropdown
templ DataTableQuickActions(actions []DataTableAction, rowIndex int) {
	<div class="flex items-center space-x-1">
		for i, action := range actions {
			if action.Single && i < 3 {
				@atoms.Button(atoms.ButtonProps{
					AccessibilityProps: atoms.AccessibilityProps{
						AriaLabel: action.Text + " for row " + strconv.Itoa(rowIndex + 1),
					},
					AlpinEventHandlers: atoms.AlpinEventHandlers{
						OnClick: action.OnClick,
					},
					Icon:      atoms.IconProps{Name: action.Icon},
					Variant:   atoms.VariantLight,
					Size:      atoms.ButtonSizeSM,
					HxPost:    action.HxPost,
					HxGet:     action.HxGet,
					HxTarget:  action.HxTarget,
					HxConfirm: action.HxConfirm,
				})
			}
		}
		
		<!-- Show dropdown if more than 3 actions -->
		<!-- TODO: Implement overflow actions dropdown -->
		<!-- FIXME: Add logic to show dropdown when actions > 3 -->
	</div>
}

// Helper functions for bulk actions
func buildBulkActionClick(action DataTableAction) string {
	if action.OnClick != "" {
		return action.OnClick
	}
	
	// TODO: Build default bulk action click handler
	// FIXME: Implement proper bulk action parameter building
	return "handleBulkAction('" + action.Text + "')"
}

func getBulkActionConfirm(action DataTableAction) string {
	if action.HxConfirm != "" {
		return action.HxConfirm
	}
	
	// Default confirmation for bulk actions
	if action.Variant == atoms.VariantDefault { // TODO: Use proper danger variant
		return "Are you sure you want to " + action.Text + " the selected items?"
	}
	
	return ""
}