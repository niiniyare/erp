package tree

import (
"fmt"
"strings"
"github.com/niiniyare/erp/web/components/atoms"
)

// Tree renders a hierarchical tree view with expand/collapse, selection, and search
templ Tree(props TreeProps) {
	<div 
		class={ getTreeClasses(props) } 
		x-data={ getAlpineTreeData(props) }
		if props.ID != "" {
			id={ props.ID }
		}
		if props.DataTestID != "" {
			data-testid={ props.DataTestID }
		}
		if props.Config.MaxHeight != "" {
			style={ fmt.Sprintf("max-height: %s", props.Config.MaxHeight) }
		}
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		role="tree"
	>
  <!-- Tree Header -->
  if props.Title != "" || props.Config.Searchable || len(props.Actions) > 0 {
  @TreeHeader(props)
  }

  <!-- Tree Content -->
  <div class="tree-content">
    if props.Loading.Show {
    @TreeLoadingState(props)
    } else if len(props.Data) == 0 {
    @TreeEmptyState(props)
    } else {
    @TreeNodes(props.Data, props, 0)
    }
  </div>
</div>
}

// TreeHeader renders the tree header with title, search, and actions
templ TreeHeader(props TreeProps) {
<div class="tree-header mb-4">
  <!-- Title and Description -->
  if props.Title != "" {
  <div class="mb-3">
    <h3 class="text-lg font-medium text-gray-900 dark:text-white">
      { props.Title }
    </h3>
    if props.Description != "" {
    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
      { props.Description }
    </p>
    }
  </div>
  }

  <!-- Search and Actions Row -->
  if props.Config.Searchable || len(props.Actions) > 0 {
  <div class="flex items-center justify-between gap-4">
    <!-- Search Box -->
    if props.Config.Searchable {
    <div class="flex-1">
      @TreeSearchBox(props)
    </div>
    }

    <!-- Tree Actions -->
    if len(props.Actions) > 0 {
    <div class="flex items-center gap-2">
      for _, action := range props.Actions {
      @TreeActionComponent(action, "tree-action")
      }
    </div>
    }
  </div>
  }
</div>
}

// TreeSearchBox renders the search input for the tree
templ TreeSearchBox(props TreeProps) {
if props.SearchProps != nil {
<div class="relative">
  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
    @atoms.Icon(atoms.IconProps{
    Name: "search",
    Size: atoms.SizeSM,
    Class: "text-gray-400",
    })
  </div>
  <input 
    type="text"
    class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md leading-5 bg-white dark:bg-gray-700 dark:border-gray-600 placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-blue-500 focus:border-blue-500 text-sm"
    placeholder={ props.SearchProps.Placeholder } 
    x-model="searchTerm"
    x-on:input="filterNodes()"
    if props.SearchUrl != "" {
      hx-get={ props.SearchUrl }
      hx-target="#tree-content"
      hx-trigger="input changed delay:300ms"
    }
  />
  if props.SearchProps.Clearable {
  <div class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer" x-show="searchTerm.length > 0"
    x-on:click="searchTerm = ''; filterNodes()">
    @atoms.Icon(atoms.IconProps{
    Name: "x",
    Size: atoms.SizeSM,
    Class: "text-gray-400 hover:text-gray-600",
    })
  </div>
  }
</div>
}
}

// TreeNodes renders a list of tree nodes recursively
templ TreeNodes(nodes []TreeNode, props TreeProps, level int) {
<div class="tree-nodes" if level==0 { role="group" }>
  for _, node := range nodes {
  @TreeNodeComponent(node, props, level)
  }
</div>
}

// TreeNodeComponent renders an individual tree node with expand/collapse and selection
templ TreeNodeComponent(node TreeNode, props TreeProps, level int) {
	<div 
		class={ getTreeNodeClasses(node, props, level) } 
		x-show={ getNodeVisibilityExpression(node) } 
		data-node-id={ node.ID } 
		x-on:click={ getNodeClickHandler(node, props) }
		role="treeitem"
		if node.Selected {
			aria-selected="true"
		}
		if node.Expanded {
			aria-expanded="true"
		} else if node.HasChildren {
			aria-expanded="false"
		}
	>
  <!-- Node Content -->
  <div class="tree-node-content flex items-center w-full" style={ getTreeNodeIndentStyle(level, props.Config.Indent) }>
    <!-- Expand/Collapse Icon -->
    if node.HasChildren {
    <button type="button" class={ getExpandIconClasses(node, node.Expanded) }
      x-on:click.stop="toggleNode('{ node.ID }')" aria-label={ fmt.Sprintf("Toggle %s", node.Label) }>
      @atoms.Icon(atoms.IconProps{
      Name: getExpandIcon(node),
      Size: atoms.SizeSM,
      })
    </button>
    } else {
    <div class="w-4 h-4 mr-2"></div>
    }

    <!-- Selection Checkbox -->
    if props.Config.Checkboxes && props.Config.Selectable {
    <label class="flex items-center mr-2">
      <input type="checkbox" class={ getCheckboxClasses() } x-model="selected" :checked="isSelected('{ node.ID }')"
        x-on:change="toggleSelection('{ node.ID }', $event.target.checked)" if node.Disabled { disabled } />
    </label>
    }

    <!-- Node Icon -->
    if props.Config.ShowIcons && node.Icon != "" {
    <div class={ getNodeIconClasses(node) }>
      @atoms.Icon(atoms.IconProps{
      Name: node.Icon,
      Size: atoms.SizeSM,
      })
    </div>
    }

    <!-- Node Label -->
    <span class={ getNodeLabelClasses(node) } if props.Config.ShowTooltips && node.Description !="" { title={
      node.Description } }>
      { node.Label }
    </span>

    <!-- Node Badge -->
    if node.Badge != "" {
    <span class={ getBadgeClasses() }>
      { node.Badge }
    </span>
    }

    <!-- Node Actions -->
    if len(props.NodeActions) > 0 {
    <div class={ getNodeActionsClasses("hover") }>
      for _, action := range props.NodeActions {
      @TreeNodeAction(action, node)
      }
    </div>
    }
  </div>

  <!-- Child Nodes -->
  if node.HasChildren && len(node.Children) > 0 {
  <div class="tree-node-children" x-show="isExpanded('{ node.ID }')"
    x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 scale-95"
    x-transition:enter-end="opacity-100 scale-100" x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95" id={
    fmt.Sprintf("node-%s-children", node.ID) }>
    @TreeNodes(node.Children, props, level+1)
  </div>
  }
</div>
}

// TreeActionComponent renders a tree-level action button
templ TreeActionComponent(action TreeAction, context string) {
@atoms.Button(atoms.ButtonProps{
BaseProps: atoms.BaseProps{
ID: action.ID,
Class: action.Class,
},
AccessibilityProps: atoms.AccessibilityProps{
AriaLabel: action.Tooltip,
},
InteractionProps: atoms.InteractionProps{
Disabled: action.Disabled,
},
AlpinEventHandlers: atoms.AlpinEventHandlers{
OnClick: action.OnClick,
},
Text: action.Text,
Icon: atoms.IconProps{
Name: action.Icon,
},
Variant: action.Variant,
Size: action.Size,
HxPost: action.HxPost,
HxGet: action.HxGet,
HxTarget: action.HxTarget,
HxSwap: action.HxSwap,
})
}

// TreeNodeAction renders an action button for individual nodes
templ TreeNodeAction(action TreeAction, node TreeNode) {
	<button 
		type="button" 
		class={ getNodeActionClasses(action) } 
		x-show={ getActionVisibilityExpression(action, node) }
		if action.OnClick != "" {
			x-on:click.stop={ fmt.Sprintf("%s('%s')", action.OnClick, node.ID) }
		}
		if action.HxPost != "" {
			hx-post={ action.HxPost }
			hx-vals={ fmt.Sprintf(`{"nodeId": "%s"}`, node.ID) }
		}
		if action.HxGet != "" {
			hx-get={ action.HxGet }
			hx-vals={ fmt.Sprintf(`{"nodeId": "%s"}`, node.ID) }
		}
		if action.HxDelete != "" {
			hx-delete={ action.HxDelete }
			hx-vals={ fmt.Sprintf(`{"nodeId": "%s"}`, node.ID) }
		}
		if action.HxTarget != "" {
			hx-target={ action.HxTarget }
		}
		if action.HxSwap != "" {
			hx-swap={ action.HxSwap }
		}
		if action.HxConfirm != "" {
			hx-confirm={ action.HxConfirm }
		}
		if action.Tooltip != "" {
			title={ action.Tooltip }
		}
		if action.Disabled {
			disabled
		}
		aria-label={ fmt.Sprintf("%s %s", action.Text, node.Label) }
	>
		if action.Icon != "" {
			@atoms.Icon(atoms.IconProps{
				Name: action.Icon,
				Size: atoms.SizeXS,
			})
		} else {
			{ action.Text }
		}
	</button>
}

// TreeLoadingState renders the loading state with skeleton nodes
templ TreeLoadingState(props TreeProps) {
<div class="tree-loading-state">
  if props.Loading.Text != "" {
  <div class="flex items-center justify-center py-4 text-sm text-gray-500">
    @atoms.Spinner(atoms.SpinnerProps{
    BaseProps: atoms.BaseProps{
    Class: "mr-2",
    },
    Size: atoms.SizeSM,
    })
    { props.Loading.Text }
  </div>
  }

		if props.Loading.Skeleton {
			<div class="space-y-2">
				@TreeSkeletonNodes(props.Loading.SkeletonCount)
			</div>
		}
	</div>
}

// TreeSkeletonNodes renders multiple skeleton nodes
templ TreeSkeletonNodes(count int) {
	for i := 0; i < count; i++ {
		@TreeSkeletonNode(i)
	}
}

// TreeSkeletonNode renders a skeleton placeholder for loading nodes
templ TreeSkeletonNode(index int) {
  <div class="tree-skeleton-node animate-pulse">
    <div class="flex items-center h-10 px-4">
      <div class="w-4 h-4 bg-gray-200 rounded mr-2"></div>
      <div class="w-4 h-4 bg-gray-200 rounded mr-2"></div>
      <div class="h-4 bg-gray-200 rounded" style={ fmt.Sprintf("width: %d%%", 60+index*10) }></div>
    </div>
  </div>
}

// TreeEmptyState renders the empty state when no data is available
templ TreeEmptyState(props TreeProps) {
  <div class="tree-empty-state flex flex-col items-center justify-center py-12 text-center">
    if props.Empty.Icon != "" {
    <div class="mb-4">
      @atoms.Icon(atoms.IconProps{
      Name: props.Empty.Icon,
      Size: atoms.SizeXL,
      Class: "text-gray-400",
      })
    </div>
    }

    <p class="text-gray-500 dark:text-gray-400 mb-4">
      { props.Empty.Message }
    </p>

    if props.Empty.ShowCreateButton {
    @atoms.Button(atoms.ButtonProps{
    Text: props.Empty.CreateText,
    Variant: atoms.VariantPrimary,
    Size: atoms.SizeMD,
    OnClick: props.Empty.CreateAction,
    })
    }
  </div>
  }

  // ============================================================================
  // HELPER FUNCTIONS FOR TEMPLATE LOGIC
  // ============================================================================

  // getNodeVisibilityExpression returns Alpine.js expression for node visibility
  func getNodeVisibilityExpression(node TreeNode) string {
  if node.Hidden {
  return "false"
  }
  return "true"
  }

  // getNodeClickHandler returns the click handler for a node
  func getNodeClickHandler(node TreeNode, props TreeProps) string {
  if node.Disabled {
  return ""
  }

  handlers := []string{}

  if props.Config.Selectable && !props.Config.Checkboxes {
  handlers = append(handlers, fmt.Sprintf("toggleSelection('%s')", node.ID))
  }

  if props.OnNodeClick != "" {
  handlers = append(handlers, fmt.Sprintf("%s('%s')", props.OnNodeClick, node.ID))
  }

  if len(handlers) == 0 {
  return ""
  }

  return fmt.Sprintf("%s", strings.Join(handlers, "; "))
  }

  // getExpandIcon returns the appropriate icon name for expand/collapse
  func getExpandIcon(node TreeNode) string {
  if node.CollapsedIcon != "" && !node.Expanded {
  return node.CollapsedIcon
  }
  if node.ExpandedIcon != "" && node.Expanded {
  return node.ExpandedIcon
  }
  return "chevron-right"
  }

  // getActionVisibilityExpression returns Alpine.js expression for action visibility
  func getActionVisibilityExpression(action TreeAction, node TreeNode) string {
  conditions := []string{}

  switch action.VisibleOn {
  case "hover":
  // Handled by CSS classes
  return "true"
  case "selected":
  conditions = append(conditions, fmt.Sprintf("isSelected('%s')", node.ID))
  case "always":
  // Always visible
  default:
  // Default to hover
  return "true"
  }

  if action.ShowWhen != nil {
  // Add custom show condition
  //TODO: This would need to be evaluated based on the expression
  conditions = append(conditions, "true") // Placeholder
  }

  if len(conditions) == 0 {
  return "true"
  }

  return strings.Join(conditions, " && ")
  }

  // getNodeActionClasses returns CSS classes for node action buttons
  func getNodeActionClasses(action TreeAction) string {
  classes := []string{
  "tree-node-action",
  "inline-flex",
  "items-center",
  "justify-center",
  "w-6",
  "h-6",
  "rounded",
  "text-gray-400",
  "hover:text-gray-600",
  "hover:bg-gray-100",
  "dark:hover:bg-gray-700",
  "transition-colors",
  "duration-200",
  }

  if action.Disabled {
  classes = append(classes, "opacity-50", "cursor-not-allowed")
  } else {
  classes = append(classes, "cursor-pointer")
  }

  if action.Class != "" {
  classes = append(classes, action.Class)
  }

  return strings.Join(classes, " ")
  }
