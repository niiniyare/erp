package sidebar

import (
	"strconv"
	"github.com/niiniyare/erp/web/components/atoms"
)

// SidebarNavigation renders the main navigation list
templ SidebarNavigation(items []SidebarItem) {
	<nav class="space-y-1" role="navigation">
		for _, item := range items {
			@SidebarItemRouter(item, 0)
		}
	</nav>
}

// SidebarItemRouter renders a navigation item based on its type
templ SidebarItemRouter(item SidebarItem, level int) {
	switch item.Type {
	case "header":
		@SidebarHeader(item, level)
	case "divider":
		@SidebarDivider()
	default:
		@SidebarNavItem(item, level)
	}
}

// SidebarNavItem renders a navigation item with optional children
templ SidebarNavItem(item SidebarItem, level int) {
	<div 
		class="sidebar-item"
		if item.ID != "" {
			id={ item.ID }
		}
	>
		if len(item.Children) > 0 {
			@SidebarItemWithChildren(item, level)
		} else {
			@SidebarItemSimple(item, level)
		}
	</div>
}

// SidebarItemSimple renders a simple navigation item without children
templ SidebarItemSimple(item SidebarItem, level int) {
	if item.Href != "" {
		<a
			href={ item.Href }
			class={ getSidebarItemClasses(item, level) }
			if item.Target != "" {
				target={ item.Target }
			}
			if item.OnClick != "" {
				@click={ item.OnClick }
			}
			if item.HxGet != "" {
				hx-get={ item.HxGet }
			}
			if item.HxPost != "" {
				hx-post={ item.HxPost }
			}
			if item.HxTarget != "" {
				hx-target={ item.HxTarget }
			}
			if item.HxSwap != "" {
				hx-swap={ item.HxSwap }
			}
		>
			@SidebarItemContent(item)
		</a>
	} else {
		<button
			type="button"
			class={ getSidebarItemClasses(item, level) + " w-full text-left" }
			if item.Disabled {
				disabled
			}
			if item.OnClick != "" {
				@click={ item.OnClick }
			}
			if item.HxGet != "" {
				hx-get={ item.HxGet }
			}
			if item.HxPost != "" {
				hx-post={ item.HxPost }
			}
			if item.HxTarget != "" {
				hx-target={ item.HxTarget }
			}
			if item.HxSwap != "" {
				hx-swap={ item.HxSwap }
			}
		>
			@SidebarItemContent(item)
		</button>
	}
}

// SidebarItemWithChildren renders a navigation item with expandable children
templ SidebarItemWithChildren(item SidebarItem, level int) {
	<div x-data={ getSidebarItemAlpineData(item.Expanded) }>
		<button
			type="button"
			class={ getSidebarItemClasses(item, level) + " w-full text-left flex items-center justify-between" }
			@click="toggleExpanded()"
			:aria-expanded="expanded"
			aria-haspopup="true"
		>
			<div class="flex items-center flex-1 min-w-0">
				@SidebarItemContent(item)
			</div>
			
			<!-- Expand/Collapse Icon -->
			<div 
				class="flex-shrink-0 ml-2 transition-transform duration-200"
				:class="{ 'rotate-90': expanded }"
				:style="collapsed ? 'display: none' : ''"
			>
				@atoms.Icon(atoms.IconProps{
					Name: "chevron-right",
					Size: atoms.IconSizeXS,
					Class: "text-gray-400 dark:text-gray-500",
				})
			</div>
		</button>
		
		<!-- Children Container -->
		<div 
			x-show="expanded && !collapsed"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 -translate-y-1"
			x-transition:enter-end="opacity-100 translate-y-0"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 translate-y-0"
			x-transition:leave-end="opacity-0 -translate-y-1"
			class="mt-1 space-y-1"
		>
			for _, child := range item.Children {
				@SidebarItemRouter(child, level+1)
			}
		</div>
	</div>
}

// SidebarItemContent renders the content of a navigation item
templ SidebarItemContent(item SidebarItem) {
	<div class="flex items-center min-w-0">
		<!-- Icon -->
		if item.Icon != "" {
			<div class="flex-shrink-0">
				@atoms.Icon(atoms.IconProps{
					Name: item.Icon,
					Size: getSidebarIconSize(item.Level),
					Class: getSidebarIconClasses(item),
				})
			</div>
		}
		
		<!-- Text and Description -->
		<div 
			class="flex-1 min-w-0 ml-3 transition-opacity duration-200"
			:class="{ 'opacity-0 w-0 overflow-hidden': collapsed, 'opacity-100': !collapsed }"
		>
			<div class="flex items-center justify-between">
				<span class="text-sm font-medium truncate">
					{ item.Text }
				</span>
				
				<!-- Badge -->
				if item.Badge != "" {
					@SidebarItemBadge(item.Badge, item.BadgeColor)
				}
			</div>
			
			<!-- Description -->
			if item.Description != "" {
				<p class="text-xs text-gray-500 dark:text-gray-400 truncate mt-0.5">
					{ item.Description }
				</p>
			}
		</div>
	</div>
}

// SidebarItemBadge renders a badge for navigation items
templ SidebarItemBadge(badge string, color string) {
	<span class={ getSidebarBadgeClasses(color) }>
		{ badge }
	</span>
}

// SidebarHeader renders a section header
templ SidebarHeader(item SidebarItem, level int) {
	<div class={ getSidebarHeaderClasses(level) }>
		<h3 
			class="text-xs font-semibold text-gray-500 uppercase tracking-wider transition-opacity duration-200"
			:class="{ 'opacity-0 w-0 overflow-hidden': collapsed, 'opacity-100': !collapsed }"
		>
			{ item.Text }
		</h3>
		
		<!-- Collapsed state indicator -->
		<div 
			class="w-full h-px bg-gray-200 dark:bg-gray-700 transition-opacity duration-200"
			:class="{ 'opacity-100': collapsed, 'opacity-0': !collapsed }"
		></div>
	</div>
}

// SidebarDivider renders a visual separator
templ SidebarDivider() {
	<div class="py-2">
		<div class="border-t border-gray-200 dark:border-gray-700"></div>
	</div>
}

// SidebarGroupHeader renders a collapsible group header
templ SidebarGroupHeader(group SidebarGroup) {
	<div class="py-2" x-data={ getSidebarGroupAlpineData(group.Expanded) }>
		if group.Collapsible {
			<button
				type="button"
				class="flex items-center justify-between w-full px-2 py-1 text-xs font-semibold text-gray-500 uppercase tracking-wider hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300 transition-colors duration-150"
				@click="toggleExpanded()"
				:aria-expanded="expanded"
			>
				<span 
					class="transition-opacity duration-200"
					:class="{ 'opacity-0 w-0 overflow-hidden': collapsed, 'opacity-100': !collapsed }"
				>
					{ group.Title }
				</span>
				<div 
					class="transition-transform duration-200"
					:class="{ 'rotate-90': expanded }"
					:style="collapsed ? 'display: none' : ''"
				>
					@atoms.Icon(atoms.IconProps{
						Name: "chevron-right",
						Size: atoms.IconSizeXS,
					})
				</div>
			</button>
			
			<div 
				x-show="expanded && !collapsed"
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				class="mt-2 space-y-1"
			>
				for _, item := range group.Items {
					@SidebarItemRouter(item, 0)
				}
			</div>
		} else {
			<h3 
				class="px-2 py-1 text-xs font-semibold text-gray-500 uppercase tracking-wider transition-opacity duration-200"
				:class="{ 'opacity-0 w-0 overflow-hidden': collapsed, 'opacity-100': !collapsed }"
			>
				{ group.Title }
			</h3>
			
			<div class="mt-2 space-y-1">
				for _, item := range group.Items {
					@SidebarItemRouter(item, 0)
				}
			</div>
		}
	</div>
}

// SidebarSearchBox renders a search input in the sidebar
templ SidebarSearchBox(placeholder string) {
	<div class="p-3 border-b border-gray-200 dark:border-gray-700">
		<div class="relative">
			<div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
				@atoms.Icon(atoms.IconProps{
					Name:  "search",
					Size:  atoms.IconSizeXS,
					Class: "text-gray-400 dark:text-gray-500",
				})
			</div>
			<input
				type="search"
				class="block w-full pl-9 pr-3 py-2 text-sm text-gray-900 border border-gray-200 rounded-lg bg-gray-50 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500 transition-opacity duration-200"
				:class="{ 'opacity-0 w-0 overflow-hidden': collapsed, 'opacity-100': !collapsed }"
				placeholder={ getSearchPlaceholder(placeholder) }
				x-model="searchTerm"
				@input="filterItems()"
			/>
		</div>
	</div>
}

// Helper functions for Alpine.js data
func getSidebarItemAlpineData(expanded bool) string {
	return `{
		expanded: ` + strconv.FormatBool(expanded) + `,
		toggleExpanded() {
			this.expanded = !this.expanded;
		}
	}`
}

func getSidebarGroupAlpineData(expanded bool) string {
	return `{
		expanded: ` + strconv.FormatBool(expanded) + `,
		toggleExpanded() {
			this.expanded = !this.expanded;
		}
	}`
}