package sidebar

import (
	"github.com/niiniyare/erp/web/components/atoms"
)

// Sidebar renders the main sidebar organism with navigation, branding, and footer
templ Sidebar(props SidebarProps) {
	<aside
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getSidebarClasses(props) }
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		} else {
			aria-label="Main navigation"
		}
		if props.DataTestID != "" {
			data-testid={ props.DataTestID }
		}
		x-data={ getSidebarAlpineData(props) }
		:class="{ 'collapsed': collapsed }"
	>
		<!-- Sidebar Content Container -->
		<div class="flex flex-col h-full">
			<!-- Brand Section -->
			if props.Brand != nil {
				@SidebarBrandSection(*props.Brand)
			}
			
			<!-- Collapse Toggle Button (if collapsible) -->
			if props.Collapsible {
				@SidebarCollapseButton()
			}
			
			<!-- Navigation Section -->
			<div class="flex-1 overflow-y-auto px-3 py-4 space-y-2">
				@SidebarNavigation(props.Items)
			</div>
			
			<!-- Footer Section -->
			if props.Footer != nil {
				@SidebarFooterSection(*props.Footer)
			}
		</div>
		
		<!-- Mobile Overlay (when overlay mode is enabled) -->
		if props.Overlay {
			@SidebarOverlay()
		}
	</aside>
}

// SidebarBrandSection renders the brand/logo area
templ SidebarBrandSection(brand SidebarBrand) {
	<div class="p-4 border-b border-gray-200 dark:border-gray-700">
		<a 
			href={ getBrandHref(brand.Href) }
			class="flex items-center"
			if brand.ID != "" {
				id={ brand.ID }
			}
		>
			<!-- Logo -->
			if brand.Logo != "" || brand.LogoSmall != "" {
				@SidebarBrandLogo(brand)
			}
			
			<!-- Brand Text -->
			if brand.ShowText && brand.Text != "" {
				<span 
					class="ml-3 text-xl font-semibold text-gray-900 dark:text-white transition-opacity duration-200"
					:class="{ 'opacity-0 w-0 overflow-hidden': collapsed, 'opacity-100': !collapsed }"
				>
					{ brand.Text }
				</span>
			}
		</a>
	</div>
}

// SidebarBrandLogo renders the brand logo with collapsed state support
templ SidebarBrandLogo(brand SidebarBrand) {
	<div class="flex-shrink-0">
		if brand.LogoSmall != "" {
			<!-- Full logo for expanded state -->
			<img 
				src={ brand.Logo } 
				class="h-8 transition-opacity duration-200"
				:class="{ 'opacity-0 w-0 overflow-hidden': collapsed, 'opacity-100': !collapsed }"
				alt={ brand.LogoAlt }
			/>
			<!-- Small logo for collapsed state -->
			<img 
				src={ brand.LogoSmall } 
				class="h-8 transition-opacity duration-200"
				:class="{ 'opacity-100': collapsed, 'opacity-0 w-0 overflow-hidden': !collapsed }"
				alt={ brand.LogoAlt }
			/>
		} else {
			<img 
				src={ brand.Logo } 
				class="h-8"
				alt={ brand.LogoAlt }
			/>
		}
	</div>
}

// SidebarCollapseButton renders the collapse toggle button
templ SidebarCollapseButton() {
	<div class="absolute top-4 -right-3 z-10">
		<button
			type="button"
			class="flex items-center justify-center w-6 h-6 bg-white border border-gray-200 rounded-full shadow-md hover:bg-gray-50 dark:bg-gray-800 dark:border-gray-600 dark:hover:bg-gray-700 transition-colors duration-200"
			@click="toggleCollapsed()"
			:aria-expanded="!collapsed"
			aria-label="Toggle sidebar"
		>
			<div class="transition-transform duration-200" :class="{ 'rotate-180': collapsed }">
				@atoms.Icon(atoms.IconProps{
					Name: "chevron-left",
					Size: atoms.IconSizeXS,
					Class: "text-gray-500 dark:text-gray-400",
				})
			</div>
		</button>
	</div>
}

// SidebarOverlay renders the mobile overlay backdrop
templ SidebarOverlay() {
	<div 
		class="fixed inset-0 z-40 bg-black bg-opacity-50 lg:hidden"
		x-show="mobileOpen"
		@click="mobileOpen = false"
		x-transition:enter="transition-opacity ease-linear duration-300"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition-opacity ease-linear duration-300"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
	></div>
}