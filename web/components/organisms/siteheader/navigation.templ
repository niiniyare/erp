package siteheader

import (
	"github.com/niiniyare/erp/web/components/atoms"
)

// HeaderNavigation renders the main navigation menu
templ HeaderNavigation(items []NavItem) {
	<nav class="hidden md:block">
		<ul class="flex flex-col p-4 md:p-0 mt-4 font-medium border border-gray-100 rounded-lg bg-gray-50 md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0 md:bg-white dark:bg-gray-800 md:dark:bg-gray-900 dark:border-gray-700">
			for _, item := range items {
				@HeaderNavItem(item)
			}
		</ul>
	</nav>
}

// HeaderNavItem renders a single navigation item
templ HeaderNavItem(item NavItem) {
	<li class="relative">
		if len(item.Children) > 0 {
			@HeaderNavItemWithDropdown(item)
		} else {
			@HeaderNavItemSimple(item)
		}
	</li>
}

// HeaderNavItemSimple renders a simple navigation link
templ HeaderNavItemSimple(item NavItem) {
	if item.Href != "" {
		<a
			href={ item.Href }
			class={ getNavItemClasses(item) }
			if item.External {
				target="_blank"
				rel="noopener noreferrer"
			}
			if item.ID != "" {
				id={ item.ID }
			}
			if item.OnClick != "" {
				@click={ item.OnClick }
			}
			if item.HxGet != "" {
				hx-get={ item.HxGet }
			}
			if item.HxPost != "" {
				hx-post={ item.HxPost }
			}
			if item.HxTarget != "" {
				hx-target={ item.HxTarget }
			}
		>
			@HeaderNavItemContent(item)
		</a>
	} else {
		<button
			type="button"
			class={ getNavItemClasses(item) }
			if item.Disabled {
				disabled
			}
			if item.ID != "" {
				id={ item.ID }
			}
			if item.OnClick != "" {
				@click={ item.OnClick }
			}
			if item.HxGet != "" {
				hx-get={ item.HxGet }
			}
			if item.HxPost != "" {
				hx-post={ item.HxPost }
			}
			if item.HxTarget != "" {
				hx-target={ item.HxTarget }
			}
		>
			@HeaderNavItemContent(item)
		</button>
	}
}

// HeaderNavItemWithDropdown renders a navigation item with dropdown menu
templ HeaderNavItemWithDropdown(item NavItem) {
	<div class="relative" x-data="{ open: false }">
		<button
			type="button"
			class={ getNavItemClasses(item) + " flex items-center" }
			@click="open = !open"
			@keydown.escape="open = false"
			:aria-expanded="open"
			aria-haspopup="true"
			if item.ID != "" {
				id={ item.ID }
			}
		>
			@HeaderNavItemContent(item)
			@atoms.Icon(atoms.IconProps{
				Name:  "chevron-down",
				Size:  atoms.IconSizeXS,
				Class: "ml-1 transition-transform duration-200",
			})
		</button>
		
		<!-- Dropdown Menu -->
		@HeaderNavDropdown(item.Children, item.ID)
	</div>
}

// HeaderNavItemContent renders the content of a navigation item
templ HeaderNavItemContent(item NavItem) {
	<div class="flex items-center">
		if item.Icon != "" {
			@atoms.Icon(atoms.IconProps{
				Name:  item.Icon,
				Size:  atoms.IconSizeSM,
				Class: "mr-2",
			})
		}
		
		<span>{ item.Text }</span>
		
		if item.Badge != "" {
			@HeaderNavItemBadge(item.Badge, item.BadgeColor)
		}
		
		if item.External {
			@atoms.Icon(atoms.IconProps{
				Name:  "external-link",
				Size:  atoms.IconSizeXS,
				Class: "ml-1 opacity-60",
			})
		}
	</div>
}

// HeaderNavItemBadge renders a badge for navigation items
templ HeaderNavItemBadge(badge string, color string) {
	<span class={ getNavBadgeClasses(color) }>
		{ badge }
	</span>
}

// HeaderNavDropdown renders a dropdown menu for navigation items
templ HeaderNavDropdown(items []NavItem, parentID string) {
	<div
		x-show="open"
		@click.away="open = false"
		x-transition:enter="transition ease-out duration-100"
		x-transition:enter-start="transform opacity-0 scale-95"
		x-transition:enter-end="transform opacity-100 scale-100"
		x-transition:leave="transition ease-in duration-75"
		x-transition:leave-start="transform opacity-100 scale-100"
		x-transition:leave-end="transform opacity-0 scale-95"
		class="absolute left-0 z-10 mt-2 w-56 origin-top-left rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none dark:bg-gray-700 dark:ring-gray-600"
		role="menu"
		if parentID != "" {
			aria-labelledby={ parentID }
		}
	>
		<div class="py-1" role="none">
			for _, item := range items {
				@HeaderNavDropdownItem(item)
			}
		</div>
	</div>
}

// HeaderNavDropdownItem renders a single dropdown menu item
templ HeaderNavDropdownItem(item NavItem) {
	if item.Href != "" {
		<a
			href={ item.Href }
			class={ getDropdownItemClasses(item) }
			role="menuitem"
			if item.External {
				target="_blank"
				rel="noopener noreferrer"
			}
			if item.ID != "" {
				id={ item.ID }
			}
			@click="open = false"
		>
			@HeaderNavItemContent(item)
		</a>
	} else {
		<button
			type="button"
			class={ getDropdownItemClasses(item) + " w-full text-left" }
			role="menuitem"
			if item.Disabled {
				disabled
			}
			if item.ID != "" {
				id={ item.ID }
			}
			if item.OnClick != "" {
				@click={ item.OnClick + "; open = false" }
			}
			if item.HxGet != "" {
				hx-get={ item.HxGet }
				@click="open = false"
			}
			if item.HxPost != "" {
				hx-post={ item.HxPost }
				@click="open = false"
			}
			if item.HxTarget != "" {
				hx-target={ item.HxTarget }
			}
		>
			@HeaderNavItemContent(item)
		</button>
	}
}

// HeaderMobileMenu renders the mobile navigation menu
templ HeaderMobileMenu(props SiteHeaderProps) {
	<div 
		class="w-full md:hidden"
		x-show="mobileMenuOpen"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 -translate-y-1"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 -translate-y-1"
		id="navbar-default"
	>
		<div class="border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800">
			<!-- Mobile Navigation -->
			if len(props.Navigation) > 0 {
				@HeaderMobileNavigation(props.Navigation)
			}
			
			<!-- Mobile Search -->
			if props.Search != nil && props.Search.Enabled && !props.Search.MobileHidden {
				<div class="p-4 border-t border-gray-200 dark:border-gray-700">
					@HeaderSearchSection(*props.Search)
				</div>
			}
			
			<!-- Mobile Actions -->
			if len(props.Actions) > 0 {
				@HeaderMobileActions(props.Actions)
			}
			
			<!-- Mobile User Menu -->
			if props.UserMenu != nil {
				@HeaderMobileUserMenu(*props.UserMenu)
			}
		</div>
	</div>
}

// HeaderMobileNavigation renders navigation for mobile
templ HeaderMobileNavigation(items []NavItem) {
	<nav class="px-4 py-2">
		<ul class="space-y-1">
			for _, item := range items {
				@HeaderMobileNavItem(item)
			}
		</ul>
	</nav>
}

// HeaderMobileNavItem renders a mobile navigation item
templ HeaderMobileNavItem(item NavItem) {
	<li>
		if len(item.Children) > 0 {
			@HeaderMobileNavItemWithChildren(item)
		} else {
			@HeaderMobileNavItemSimple(item)
		}
	</li>
}

// HeaderMobileNavItemSimple renders a simple mobile nav item
templ HeaderMobileNavItemSimple(item NavItem) {
	if item.Href != "" {
		<a
			href={ item.Href }
			class={ getMobileNavItemClasses(item) }
			if item.External {
				target="_blank"
				rel="noopener noreferrer"
			}
			@click="mobileMenuOpen = false"
		>
			@HeaderNavItemContent(item)
		</a>
	} else {
		<button
			type="button"
			class={ getMobileNavItemClasses(item) + " w-full text-left" }
			if item.OnClick != "" {
				@click={ item.OnClick + "; mobileMenuOpen = false" }
			}
		>
			@HeaderNavItemContent(item)
		</button>
	}
}

// HeaderMobileNavItemWithChildren renders a mobile nav item with children
templ HeaderMobileNavItemWithChildren(item NavItem) {
	<div x-data="{ open: false }">
		<button
			type="button"
			class={ getMobileNavItemClasses(item) + " w-full text-left flex items-center justify-between" }
			@click="open = !open"
		>
			<div class="flex items-center">
				@HeaderNavItemContent(item)
			</div>
			@atoms.Icon(atoms.IconProps{
				Name:  "chevron-down",
				Size:  atoms.IconSizeXS,
				Class: "transition-transform duration-200",
			})
		</button>
		
		<div 
			x-show="open"
			x-transition:enter="transition ease-out duration-100"
			x-transition:enter-start="opacity-0 -translate-y-1"
			x-transition:enter-end="opacity-100 translate-y-0"
			class="ml-4 mt-1 space-y-1"
		>
			for _, child := range item.Children {
				@HeaderMobileNavItemSimple(child)
			}
		</div>
	</div>
}

// HeaderMobileActions renders actions for mobile
templ HeaderMobileActions(actions []HeaderAction) {
	<div class="p-4 border-t border-gray-200 dark:border-gray-700">
		<div class="grid grid-cols-2 gap-2">
			for _, action := range actions {
				if !action.MobileHidden {
					@atoms.Button(atoms.ButtonProps{
						BaseProps: atoms.BaseProps{
							Class: "w-full justify-center",
						},
						AlpinEventHandlers: atoms.AlpinEventHandlers{
							OnClick: action.OnClick,
						},
						Text:     action.Text,
						Icon:     atoms.IconProps{Name: action.Icon},
						Variant:  action.Variant,
						Size:     atoms.ButtonSizeSM,
						HxPost:   action.HxPost,
						HxGet:    action.HxGet,
						HxTarget: action.HxTarget,
					})
				}
			}
		</div>
	</div>
}