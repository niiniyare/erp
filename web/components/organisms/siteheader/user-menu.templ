package siteheader

import (
	"github.com/niiniyare/erp/web/components/atoms"
)

// HeaderUserMenuSection renders the user menu section
templ HeaderUserMenuSection(userMenu HeaderUserMenu) {
	<div class="relative" x-data="{ open: false }">
		<button
			type="button"
			class="flex items-center text-sm bg-gray-800 rounded-full focus:ring-4 focus:ring-gray-300 dark:focus:ring-gray-600"
			@click="open = !open"
			@keydown.escape="open = false"
			:aria-expanded="open"
			aria-haspopup="true"
		>
			<span class="sr-only">Open user menu</span>
			@HeaderUserAvatar(userMenu.User, userMenu.ShowAvatar)
		</button>
		
		<!-- User Dropdown Menu -->
		@HeaderUserDropdown(userMenu)
	</div>
}

// HeaderUserAvatar renders the user avatar or initials
templ HeaderUserAvatar(user HeaderUser, showAvatar bool) {
	if showAvatar {
		if user.Avatar != "" {
			<img 
				class="w-8 h-8 rounded-full"
				src={ user.Avatar }
				alt={ user.Name + " avatar" }
			/>
		} else {
			<div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center">
				<span class="text-sm font-medium text-white">
					{ getUserInitials(user) }
				</span>
			</div>
		}
		
		if user.Status != "" {
			@HeaderUserStatus(user.Status)
		}
	}
}

// HeaderUserStatus renders the user's online status
templ HeaderUserStatus(status string) {
	<div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full border-2 border-white dark:border-gray-800">
		<div class={ getUserStatusClasses(status) }></div>
	</div>
}

// HeaderUserDropdown renders the user dropdown menu
templ HeaderUserDropdown(userMenu HeaderUserMenu) {
	<div
		x-show="open"
		@click.away="open = false"
		x-transition:enter="transition ease-out duration-100"
		x-transition:enter-start="transform opacity-0 scale-95"
		x-transition:enter-end="transform opacity-100 scale-100"
		x-transition:leave="transition ease-in duration-75"
		x-transition:leave-start="transform opacity-100 scale-100"
		x-transition:leave-end="transform opacity-0 scale-95"
		class={ getUserDropdownClasses(userMenu.Position) }
		role="menu"
	>
		<!-- User Info Header -->
		@HeaderUserInfo(userMenu.User, userMenu.ShowName)
		
		<!-- Menu Items -->
		if len(userMenu.MenuItems) > 0 {
			<div class="py-1" role="none">
				for _, item := range userMenu.MenuItems {
					@HeaderUserMenuItem(item)
				}
			</div>
		}
	</div>
}

// HeaderUserInfo renders user information in the dropdown header
templ HeaderUserInfo(user HeaderUser, showName bool) {
	if showName {
		<div class="px-4 py-3 border-b border-gray-200 dark:border-gray-600">
			<div class="flex items-center space-x-3">
				<div class="flex-shrink-0">
					if user.Avatar != "" {
						<img 
							class="w-10 h-10 rounded-full"
							src={ user.Avatar }
							alt={ user.Name + " avatar" }
						/>
					} else {
						<div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center">
							<span class="text-base font-medium text-white">
								{ getUserInitials(user) }
							</span>
						</div>
					}
				</div>
				
				<div class="flex-1 min-w-0">
					<p class="text-sm font-medium text-gray-900 dark:text-white truncate">
						{ user.Name }
					</p>
					if user.Email != "" {
						<p class="text-sm text-gray-500 dark:text-gray-400 truncate">
							{ user.Email }
						</p>
					}
					if user.Role != "" {
						<p class="text-xs text-blue-600 dark:text-blue-400 font-medium">
							{ user.Role }
						</p>
					}
				</div>
				
				if user.Status != "" {
					<div class="flex-shrink-0">
						@HeaderUserStatusIndicator(user.Status)
					</div>
				}
			</div>
		</div>
	}
}

// HeaderUserStatusIndicator renders a status indicator with text
templ HeaderUserStatusIndicator(status string) {
	<div class="flex items-center space-x-1">
		<div class={ "w-2 h-2 rounded-full " + getUserStatusColor(status) }></div>
		<span class="text-xs text-gray-500 dark:text-gray-400 capitalize">
			{ status }
		</span>
	</div>
}

// HeaderUserMenuItem renders a single user menu item
templ HeaderUserMenuItem(item HeaderMenuItem) {
	if item.Divider {
		<hr class="border-gray-200 dark:border-gray-600" />
	} else {
		if item.Href != "" {
			<a
				href={ item.Href }
				class={ getUserMenuItemClasses() }
				role="menuitem"
				@click="open = false"
				if item.ID != "" {
					id={ item.ID }
				}
			>
				@HeaderUserMenuItemContent(item)
			</a>
		} else {
			<button
				type="button"
				class={ getUserMenuItemClasses() + " w-full text-left" }
				role="menuitem"
				if item.OnClick != "" {
					@click={ item.OnClick + "; open = false" }
				}
				if item.HxPost != "" {
					hx-post={ item.HxPost }
					@click="open = false"
				}
				if item.HxGet != "" {
					hx-get={ item.HxGet }
					@click="open = false"
				}
				if item.HxConfirm != "" {
					hx-confirm={ item.HxConfirm }
				}
				if item.ID != "" {
					id={ item.ID }
				}
			>
				@HeaderUserMenuItemContent(item)
			</button>
		}
	}
}

// HeaderUserMenuItemContent renders the content of a user menu item
templ HeaderUserMenuItemContent(item HeaderMenuItem) {
	<div class="flex items-center">
		if item.Icon != "" {
			@atoms.Icon(atoms.IconProps{
				Name:  item.Icon,
				Size:  atoms.IconSizeSM,
				Class: "mr-3 text-gray-400 group-hover:text-gray-500 dark:text-gray-500 dark:group-hover:text-gray-400",
			})
		}
		<span>{ item.Text }</span>
	</div>
}

// HeaderMobileUserMenu renders the user menu for mobile
templ HeaderMobileUserMenu(userMenu HeaderUserMenu) {
	<div class="p-4 border-t border-gray-200 dark:border-gray-700">
		<!-- Mobile User Info -->
		<div class="flex items-center space-x-3 mb-4">
			<div class="flex-shrink-0">
				@HeaderUserAvatar(userMenu.User, userMenu.ShowAvatar)
			</div>
			
			if userMenu.ShowName {
				<div class="flex-1 min-w-0">
					<p class="text-base font-medium text-gray-900 dark:text-white truncate">
						{ userMenu.User.Name }
					</p>
					if userMenu.User.Email != "" {
						<p class="text-sm text-gray-500 dark:text-gray-400 truncate">
							{ userMenu.User.Email }
						</p>
					}
				</div>
			}
		</div>
		
		<!-- Mobile Menu Items -->
		if len(userMenu.MenuItems) > 0 {
			<div class="space-y-1">
				for _, item := range userMenu.MenuItems {
					@HeaderMobileUserMenuItem(item)
				}
			</div>
		}
	</div>
}

// HeaderMobileUserMenuItem renders a mobile user menu item
templ HeaderMobileUserMenuItem(item HeaderMenuItem) {
	if item.Divider {
		<hr class="my-2 border-gray-200 dark:border-gray-600" />
	} else {
		if item.Href != "" {
			<a
				href={ item.Href }
				class="flex items-center px-3 py-2 text-sm text-gray-700 rounded-lg hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-600 transition-colors duration-150"
				@click="mobileMenuOpen = false"
			>
				@HeaderUserMenuItemContent(item)
			</a>
		} else {
			<button
				type="button"
				class="w-full flex items-center px-3 py-2 text-sm text-gray-700 rounded-lg hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-600 transition-colors duration-150 text-left"
				if item.OnClick != "" {
					@click={ item.OnClick + "; mobileMenuOpen = false" }
				}
				if item.HxPost != "" {
					hx-post={ item.HxPost }
					@click="mobileMenuOpen = false"
				}
				if item.HxGet != "" {
					hx-get={ item.HxGet }
					@click="mobileMenuOpen = false"
				}
				if item.HxConfirm != "" {
					hx-confirm={ item.HxConfirm }
				}
			>
				@HeaderUserMenuItemContent(item)
			</button>
		}
	}
}