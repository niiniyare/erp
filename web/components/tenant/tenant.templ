// Tenant UI Components for Awo ERP
package tenant

import (
	"fmt"
	"github.com/niiniyare/erp/web/utils"
	"github.com/niiniyare/erp/web/components/table"
	"github.com/niiniyare/erp/web/components/card"
	"github.com/niiniyare/erp/web/components/button"
	"github.com/niiniyare/erp/web/components/badge"
	"github.com/niiniyare/erp/web/components/input"
	"github.com/niiniyare/erp/web/components/label"
	genTenant "github.com/niiniyare/erp/internal/api/gen/tenant"
)

// PaginationInfo represents pagination information
type PaginationInfo struct {
	Page       int
	PerPage    int
	Total      int
	TotalPages int
}

// TenantCardProps for individual tenant display
type TenantCardProps struct {
	Tenant   *genTenant.Tenant
	ShowEdit bool
	Class    string
}

// TenantListProps for tenant list display
type TenantListProps struct {
	Tenants     []*genTenant.Tenant
	Pagination  *PaginationInfo
	Class       string
}

// TenantFormProps for tenant creation/edit forms
type TenantFormProps struct {
	Tenant      *genTenant.Tenant // nil for create, populated for edit
	Action      string            // "create" or "edit"
	ActionURL   string            // form submission URL
	Class       string
}

// TenantCard renders a single tenant as a card
templ TenantCard(props TenantCardProps) {
	@card.Card(card.Props{
		Class: utils.TwMerge("hover:shadow-lg transition-shadow", props.Class),
	}) {
		<div class="p-6">
			<div class="flex items-start justify-between mb-4">
				<div>
					<h3 class="text-lg font-semibold text-gray-900">
						{ props.Tenant.Name }
					</h3>
					<p class="text-sm text-gray-500">
						{ props.Tenant.Slug }
					</p>
				</div>
				<div class="flex gap-2">
					@TenantStatusBadge(props.Tenant.Status)
					if props.ShowEdit {
						@button.Button(button.Props{
							Variant: "outline",
							Size:    "sm",
							Attributes: templ.Attributes{
								"hx-get": fmt.Sprintf("/api/v1/tenants/%s/edit", props.Tenant.ID),
								"hx-target": "#main-content",
							},
						}) {
							Edit
						}
					}
				</div>
			</div>
			
			<div class="space-y-2 text-sm">
				<div class="flex justify-between">
					<span class="text-gray-500">Email:</span>
					<span class="text-gray-900">{ props.Tenant.Email }</span>
				</div>
				if props.Tenant.Subdomain != nil {
					<div class="flex justify-between">
						<span class="text-gray-500">Subdomain:</span>
						<span class="text-gray-900">{ *props.Tenant.Subdomain }</span>
					</div>
				}
				<div class="flex justify-between">
					<span class="text-gray-500">Created:</span>
					<span class="text-gray-900">{ props.Tenant.CreatedAt }</span>
				</div>
			</div>
		</div>
	}
}

// TenantList renders a list of tenants in a table format
templ TenantList(props TenantListProps) {
	<div class={ utils.TwMerge("space-y-4", props.Class) }>
		<div class="flex items-center justify-between">
			<h2 class="text-xl font-semibold text-gray-900">Tenants</h2>
			@button.Button(button.Props{
				Variant: "default",
				Attributes: templ.Attributes{
					"hx-get": "/api/v1/tenants/new",
					"hx-target": "#main-content",
				},
			}) {
				Add Tenant
			}
		</div>

		@table.Table() {
			@table.Header() {
				@table.Row() {
					@table.Head() { Name }
					@table.Head() { Slug }
					@table.Head() { Email }
					@table.Head() { Status }
					@table.Head() { Created }
					@table.Head() { Actions }
				}
			}
			@table.Body() {
				for _, tenant := range props.Tenants {
					@table.Row() {
						@table.Cell() { 
							<div class="font-medium">{ tenant.Name }</div>
						}
						@table.Cell() { 
							<code class="text-xs bg-gray-100 px-2 py-1 rounded">{ tenant.Slug }</code>
						}
						@table.Cell() { { tenant.Email } }
						@table.Cell() { @TenantStatusBadge(tenant.Status) }
						@table.Cell() { 
							<span class="text-sm text-gray-500">{ tenant.CreatedAt }</span>
						}
						@table.Cell() {
							<div class="flex gap-2">
								@button.Button(button.Props{
									Variant: "ghost",
									Size:    "sm",
									Attributes: templ.Attributes{
										"hx-get": fmt.Sprintf("/api/v1/tenants/%s", tenant.ID),
										"hx-target": "#main-content",
									},
								}) {
									View
								}
								@button.Button(button.Props{
									Variant: "ghost",
									Size:    "sm",
									Attributes: templ.Attributes{
										"hx-get": fmt.Sprintf("/api/v1/tenants/%s/edit", tenant.ID),
										"hx-target": "#main-content",
									},
								}) {
									Edit
								}
							</div>
						}
					}
				}
			}
		}
		
		if props.Pagination != nil {
			@TenantPagination(*props.Pagination)
		}
	</div>
}

// TenantForm renders create/edit form for tenants
templ TenantForm(props TenantFormProps) {
	<div class={ utils.TwMerge("max-w-2xl mx-auto", props.Class) }>
		@card.Card() {
			<div class="p-6">
				<div class="mb-6">
					<h2 class="text-xl font-semibold text-gray-900">
						if props.Action == "create" {
							Create New Tenant
						} else {
							Edit Tenant
						}
					</h2>
					<p class="text-sm text-gray-500 mt-1">
						if props.Action == "create" {
							Add a new tenant to the system
						} else {
							Update tenant information
						}
					</p>
				</div>

				<form 
					hx-post={ props.ActionURL }
					hx-target="#main-content"
					hx-indicator="#form-loading"
					class="space-y-6"
				>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div>
							@label.Label(label.Props{For: "name"}) { Name * }
							@input.Input(input.Props{
								ID:          "name",
								Name:        "name",
								Type:        "text",
								Placeholder: "Company Name",
								Required:    true,
								Value:       utils.IfElse(props.Tenant != nil, props.Tenant.Name, ""),
							})
						</div>

						<div>
							@label.Label(label.Props{For: "slug"}) { Slug * }
							@input.Input(input.Props{
								ID:          "slug",
								Name:        "slug",
								Type:        "text",
								Placeholder: "company-slug",
								Required:    true,
								Value:       utils.IfElse(props.Tenant != nil, props.Tenant.Slug, ""),
								Attributes: templ.Attributes{
									"pattern": "^[a-z0-9-]+$",
									"title": "Only lowercase letters, numbers, and hyphens allowed",
								},
							})
						</div>
					</div>

					<div>
						@label.Label(label.Props{For: "email"}) { Email * }
						@input.Input(input.Props{
							ID:          "email",
							Name:        "email",
							Type:        "email",
							Placeholder: "admin@company.com",
							Required:    true,
							Value:       utils.IfElse(props.Tenant != nil, props.Tenant.Email, ""),
						})
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div>
							@label.Label(label.Props{For: "subdomain"}) { Subdomain }
							@input.Input(input.Props{
								ID:          "subdomain",
								Name:        "subdomain",
								Type:        "text",
								Placeholder: "company",
								Value:       getSubdomainValue(props.Tenant),
							})
							<p class="text-xs text-gray-500 mt-1">Optional: For custom subdomain access</p>
						</div>

						<div>
							@label.Label(label.Props{For: "timezone"}) { Timezone }
							@input.Input(input.Props{
								ID:          "timezone",
								Name:        "timezone",
								Type:        "text",
								Placeholder: "UTC",
								Value:       getTimezoneValue(props.Tenant),
							})
						</div>
					</div>

					<div class="flex justify-end gap-3 pt-6 border-t">
						@button.Button(button.Props{
							Type:    "button",
							Variant: "outline",
							Attributes: templ.Attributes{
								"hx-get": "/api/v1/tenants",
								"hx-target": "#main-content",
							},
						}) {
							Cancel
						}

						@button.Button(button.Props{
							Type:    "submit",
							Variant: "default",
						}) {
							<span id="form-loading" class="htmx-indicator">
								<svg class="animate-spin h-4 w-4 mr-2" viewBox="0 0 24 24">
									<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" stroke-dasharray="31.416" stroke-dashoffset="31.416"></circle>
								</svg>
							</span>
							if props.Action == "create" {
								Create Tenant
							} else {
								Update Tenant
							}
						}
					</div>
				</form>
			</div>
		}
	</div>
}

// TenantDetail renders detailed view of a single tenant
templ TenantDetail(tenant *genTenant.Tenant) {
	<div class="max-w-4xl mx-auto space-y-6">
		<div class="flex items-center justify-between">
			<div>
				<h1 class="text-2xl font-bold text-gray-900">{ tenant.Name }</h1>
				<p class="text-gray-500">Tenant Details</p>
			</div>
			<div class="flex gap-3">
				@button.Button(button.Props{
					Variant: "outline",
					Attributes: templ.Attributes{
						"hx-get": fmt.Sprintf("/api/v1/tenants/%s/edit", tenant.ID),
						"hx-target": "#main-content",
					},
				}) {
					Edit Tenant
				}
				@button.Button(button.Props{
					Variant: "outline",
					Attributes: templ.Attributes{
						"hx-get": "/api/v1/tenants",
						"hx-target": "#main-content",
					},
				}) {
					Back to List
				}
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<div class="lg:col-span-2">
				@card.Card() {
					<div class="p-6">
						<h3 class="text-lg font-semibold mb-4">Basic Information</h3>
						<dl class="space-y-4">
							<div>
								<dt class="text-sm font-medium text-gray-500">Name</dt>
								<dd class="text-sm text-gray-900">{ tenant.Name }</dd>
							</div>
							<div>
								<dt class="text-sm font-medium text-gray-500">Slug</dt>
								<dd class="text-sm text-gray-900">
									<code class="bg-gray-100 px-2 py-1 rounded">{ tenant.Slug }</code>
								</dd>
							</div>
							<div>
								<dt class="text-sm font-medium text-gray-500">Email</dt>
								<dd class="text-sm text-gray-900">{ tenant.Email }</dd>
							</div>
							if tenant.Subdomain != nil {
								<div>
									<dt class="text-sm font-medium text-gray-500">Subdomain</dt>
									<dd class="text-sm text-gray-900">{ *tenant.Subdomain }</dd>
								</div>
							}
							<div>
								<dt class="text-sm font-medium text-gray-500">Timezone</dt>
								<dd class="text-sm text-gray-900">{ tenant.Timezone }</dd>
							</div>
						</dl>
					</div>
				}
			</div>

			<div>
				@card.Card() {
					<div class="p-6">
						<h3 class="text-lg font-semibold mb-4">Status & Metadata</h3>
						<dl class="space-y-4">
							<div>
								<dt class="text-sm font-medium text-gray-500">Status</dt>
								<dd class="text-sm">@TenantStatusBadge(tenant.Status)</dd>
							</div>
							<div>
								<dt class="text-sm font-medium text-gray-500">Created</dt>
								<dd class="text-sm text-gray-900">{ tenant.CreatedAt }</dd>
							</div>
							if tenant.UpdatedAt != nil {
								<div>
									<dt class="text-sm font-medium text-gray-500">Updated</dt>
									<dd class="text-sm text-gray-900">{ *tenant.UpdatedAt }</dd>
								</div>
							}
						</dl>
					</div>
				}
			</div>
		</div>
	</div>
}

// TenantStatusBadge renders status badge with appropriate colors
templ TenantStatusBadge(status string) {
	@badge.Badge(badge.Props{
		Variant: getBadgeVariant(status),
	}) {
		{ status }
	}
}

// TenantPagination renders pagination controls
templ TenantPagination(pagination PaginationInfo) {
	<div class="flex items-center justify-between">
		<div class="text-sm text-gray-700">
			Showing page { fmt.Sprintf("%d", pagination.Page) } of { fmt.Sprintf("%d", pagination.TotalPages) }
			({ fmt.Sprintf("%d", pagination.Total) } total)
		</div>
		<div class="flex gap-2">
			if pagination.Page > 1 {
				@button.Button(button.Props{
					Variant: "outline",
					Size:    "sm",
					Attributes: templ.Attributes{
						"hx-get": fmt.Sprintf("/api/v1/tenants?page=%d", pagination.Page-1),
						"hx-target": "#main-content",
					},
				}) {
					Previous
				}
			}
			if pagination.Page < pagination.TotalPages {
				@button.Button(button.Props{
					Variant: "outline",
					Size:    "sm",
					Attributes: templ.Attributes{
						"hx-get": fmt.Sprintf("/api/v1/tenants?page=%d", pagination.Page+1),
						"hx-target": "#main-content",
					},
				}) {
					Next
				}
			}
		</div>
	</div>
}

// Helper functions

func getBadgeVariant(status string) badge.Variant {
	switch status {
	case "ACTIVE":
		return badge.VariantDefault
	case "SUSPENDED":
		return badge.VariantDestructive
	case "INACTIVE":
		return badge.VariantSecondary
	default:
		return badge.VariantDefault
	}
}

func getSubdomainValue(tenant *genTenant.Tenant) string {
	if tenant != nil && tenant.Subdomain != nil {
		return *tenant.Subdomain
	}
	return ""
}

func getTimezoneValue(tenant *genTenant.Tenant) string {
	if tenant != nil && tenant.Timezone != "" {
		return tenant.Timezone
	}
	return "UTC"
}