package atoms

import (
	"encoding/json"
	"strings"
	"github.com/niiniyare/erp/web/schemas"
)

// ButtonSchema defines the JSON schema structure for button generation
type ButtonSchema struct {
	schemas.ComponentDefinition
	UITags    ButtonUITags    `json:"uiTags"`
	FormTags  ButtonFormTags  `json:"formTags"`
	TableTags ButtonTableTags `json:"tableTags"`
}

// ButtonUITags represents ui: tag configuration
type ButtonUITags struct {
	Component   string `json:"component"`           // "button", "icon-button", "link-button"
	Label       string `json:"label"`               // Display text
	Variant     string `json:"variant"`             // primary, secondary, danger, etc.
	Size        string `json:"size"`                // xs, sm, md, lg, xl
	Icon        string `json:"icon,omitempty"`      // Icon name
	IconPosition string `json:"iconPosition,omitempty"` // left, right
	Required    bool   `json:"required,omitempty"`  // Mark as required
	Hidden      bool   `json:"hidden,omitempty"`    // Hide from UI
	Help        string `json:"help,omitempty"`      // Help text/tooltip
	Loading     bool   `json:"loading,omitempty"`   // Show loading state
	Pill        bool   `json:"pill,omitempty"`      // Rounded full
}

// ButtonFormTags represents form: tag configuration
type ButtonFormTags struct {
	Type        string `json:"type"`                // button, submit, reset
	Tab         string `json:"tab,omitempty"`       // Tab grouping
	Section     string `json:"section,omitempty"`   // Section grouping
	DependsOn   string `json:"dependsOn,omitempty"` // Field dependency
	ShowWhen    string `json:"showWhen,omitempty"`  // Conditional display
	Validation  string `json:"validation,omitempty"` // Validation rules
}

// ButtonTableTags represents table: tag configuration
type ButtonTableTags struct {
	Width     string `json:"width,omitempty"`     // Column width
	Align     string `json:"align,omitempty"`     // center, left, right
	Sortable  bool   `json:"sortable,omitempty"`  // Enable sorting
	Fixed     bool   `json:"fixed,omitempty"`     // Fixed column
	Action    bool   `json:"action"`              // Mark as action column
}

// ButtonFromSchema creates a button component from a JSON schema definition
// This is the new schema-driven entry point
templ ButtonFromSchema(schema ButtonSchema) {
	// Convert schema to traditional props for backward compatibility
	@Button(convertSchemaToProps(schema))
}

// convertSchemaToProps converts schema definition to ButtonProps
func convertSchemaToProps(schema ButtonSchema) ButtonProps {
	props := ButtonProps{
		// Core properties from UITags
		Text:         schema.UITags.Label,
		Icon:         schema.UITags.Icon,
		IconPosition: schema.UITags.IconPosition,
		Variant:      ButtonVariant(schema.UITags.Variant),
		Size:         ButtonSize(schema.UITags.Size),
		Pill:         schema.UITags.Pill,
		Loading:      schema.UITags.Loading,
		
		// Form properties from FormTags
		Type:         schema.FormTags.Type,
		
		// Standard ComponentDefinition properties
		ID:           schema.ID,
		Class:        schema.Class,
		Disabled:     schema.Disabled,
	}
	
	// Apply default values if not specified
	if props.Variant == "" {
		props.Variant = ButtonPrimary
	}
	if props.Size == "" {
		props.Size = ButtonSizeMD
	}
	if props.Type == "" {
		props.Type = "button"
	}
	
	// Extract HTMX properties from schema props
	if htmxGet, exists := schema.Props["hxGet"]; exists {
		if str, ok := htmxGet.(string); ok {
			props.HxGet = str
		}
	}
	if htmxPost, exists := schema.Props["hxPost"]; exists {
		if str, ok := htmxPost.(string); ok {
			props.HxPost = str
		}
	}
	if htmxTarget, exists := schema.Props["hxTarget"]; exists {
		if str, ok := htmxTarget.(string); ok {
			props.HxTarget = str
		}
	}
	if htmxSwap, exists := schema.Props["hxSwap"]; exists {
		if str, ok := htmxSwap.(string); ok {
			props.HxSwap = str
		}
	}
	if onClick, exists := schema.Props["onClick"]; exists {
		if str, ok := onClick.(string); ok {
			props.OnClick = str
		}
	}
	
	return props
}

// ButtonSchemaFromTags creates a ButtonSchema from Go struct tags
// This enables auto-generation from Go models with ui: tags
func ButtonSchemaFromTags(fieldName string, tags map[string]string) ButtonSchema {
	schema := ButtonSchema{
		ComponentDefinition: schemas.ComponentDefinition{
			Type:  "atoms.button",
			Props: make(map[string]any),
		},
	}
	
	// Parse ui: tag
	if uiTag, exists := tags["ui"]; exists {
		schema.UITags = parseUITag(uiTag)
		
		// Set component type based on ui tag
		if schema.UITags.Component != "" {
			schema.Type = "atoms." + schema.UITags.Component
		}
		
		// Set default label from field name if not specified
		if schema.UITags.Label == "" {
			schema.UITags.Label = humanizeFieldName(fieldName)
		}
	}
	
	// Parse form: tag
	if formTag, exists := tags["form"]; exists {
		schema.FormTags = parseFormTag(formTag)
	}
	
	// Parse table: tag
	if tableTag, exists := tags["table"]; exists {
		schema.TableTags = parseTableTag(tableTag)
	}
	
	return schema
}

// parseUITag parses ui: tag string into ButtonUITags struct
func parseUITag(tag string) ButtonUITags {
	uiTags := ButtonUITags{}
	
	// Split by semicolon and parse key=value pairs
	pairs := strings.Split(tag, ";")
	for _, pair := range pairs {
		if kv := strings.SplitN(pair, "=", 2); len(kv) == 2 {
			key := strings.TrimSpace(kv[0])
			value := strings.TrimSpace(kv[1])
			
			switch key {
			case "component":
				uiTags.Component = value
			case "label":
				uiTags.Label = value
			case "variant":
				uiTags.Variant = value
			case "size":
				uiTags.Size = value
			case "icon":
				uiTags.Icon = value
			case "iconPosition":
				uiTags.IconPosition = value
			case "required":
				uiTags.Required = value == "true"
			case "hidden":
				uiTags.Hidden = value == "true"
			case "help":
				uiTags.Help = value
			case "loading":
				uiTags.Loading = value == "true"
			case "pill":
				uiTags.Pill = value == "true"
			}
		}
	}
	
	return uiTags
}

// parseFormTag parses form: tag string into ButtonFormTags struct
func parseFormTag(tag string) ButtonFormTags {
	formTags := ButtonFormTags{}
	
	pairs := strings.Split(tag, ";")
	for _, pair := range pairs {
		if kv := strings.SplitN(pair, "=", 2); len(kv) == 2 {
			key := strings.TrimSpace(kv[0])
			value := strings.TrimSpace(kv[1])
			
			switch key {
			case "type":
				formTags.Type = value
			case "tab":
				formTags.Tab = value
			case "section":
				formTags.Section = value
			case "dependsOn":
				formTags.DependsOn = value
			case "showWhen":
				formTags.ShowWhen = value
			case "validation":
				formTags.Validation = value
			}
		}
	}
	
	return formTags
}

// parseTableTag parses table: tag string into ButtonTableTags struct
func parseTableTag(tag string) ButtonTableTags {
	tableTags := ButtonTableTags{}
	
	pairs := strings.Split(tag, ";")
	for _, pair := range pairs {
		if kv := strings.SplitN(pair, "=", 2); len(kv) == 2 {
			key := strings.TrimSpace(kv[0])
			value := strings.TrimSpace(kv[1])
			
			switch key {
			case "width":
				tableTags.Width = value
			case "align":
				tableTags.Align = value
			case "sortable":
				tableTags.Sortable = value == "true"
			case "fixed":
				tableTags.Fixed = value == "true"
			case "action":
				tableTags.Action = value == "true"
			}
		}
	}
	
	return tableTags
}

// humanizeFieldName converts camelCase/PascalCase to human readable form
func humanizeFieldName(fieldName string) string {
	// Simple implementation - can be enhanced
	if fieldName == "" {
		return ""
	}
	
	// Convert PascalCase to space-separated words
	var result []rune
	for i, r := range fieldName {
		if i > 0 && 'A' <= r && r <= 'Z' {
			result = append(result, ' ')
		}
		result = append(result, r)
	}
	
	return string(result)
}

// SchemaFromJSON creates ButtonSchema from JSON string
func ButtonSchemaFromJSON(jsonStr string) (ButtonSchema, error) {
	var schema ButtonSchema
	err := json.Unmarshal([]byte(jsonStr), &schema)
	return schema, err
}

// ToJSON converts ButtonSchema to JSON string  
func (schema ButtonSchema) ToJSON() (string, error) {
	data, err := json.Marshal(schema)
	return string(data), err
}

// Validate ensures the schema is valid for rendering
func (schema ButtonSchema) Validate() error {
	// Basic validation rules
	if schema.Type == "" {
		return schemas.NewSchemaError(schemas.ErrCodeMissingComponent, "button schema must have a type")
	}
	
	// Component-specific validation
	if schema.UITags.Component != "" {
		validComponents := []string{"button", "icon-button", "link-button"}
		valid := false
		for _, c := range validComponents {
			if schema.UITags.Component == c {
				valid = true
				break
			}
		}
		if !valid {
			return schemas.NewSchemaError(schemas.ErrCodeInvalidProps, 
				"invalid button component type: " + schema.UITags.Component)
		}
	}
	
	// Variant validation
	if schema.UITags.Variant != "" {
		validVariants := []string{"primary", "secondary", "dark", "light", "green", "red", "yellow", "purple", "outline"}
		valid := false
		for _, v := range validVariants {
			if schema.UITags.Variant == v {
				valid = true
				break
			}
		}
		if !valid {
			return schemas.NewSchemaError(schemas.ErrCodeInvalidProps, 
				"invalid button variant: " + schema.UITags.Variant)
		}
	}
	
	return nil
}

// Clone creates a deep copy of the ButtonSchema
func (schema ButtonSchema) Clone() ButtonSchema {
	clone := schema
	
	// Deep copy Props map
	clone.Props = make(map[string]any)
	for k, v := range schema.Props {
		clone.Props[k] = v
	}
	
	return clone
}

// Merge combines this schema with another, with the other taking precedence
func (schema ButtonSchema) Merge(other ButtonSchema) ButtonSchema {
	merged := schema.Clone()
	
	// Merge ComponentDefinition fields
	if other.Type != "" {
		merged.Type = other.Type
	}
	if other.ID != "" {
		merged.ID = other.ID
	}
	if other.Class != "" {
		merged.Class = other.Class
	}
	merged.Disabled = merged.Disabled || other.Disabled
	
	// Merge props
	for k, v := range other.Props {
		merged.Props[k] = v
	}
	
	// Merge UITags - non-empty values take precedence
	if other.UITags.Component != "" {
		merged.UITags.Component = other.UITags.Component
	}
	if other.UITags.Label != "" {
		merged.UITags.Label = other.UITags.Label
	}
	if other.UITags.Variant != "" {
		merged.UITags.Variant = other.UITags.Variant
	}
	if other.UITags.Size != "" {
		merged.UITags.Size = other.UITags.Size
	}
	if other.UITags.Icon != "" {
		merged.UITags.Icon = other.UITags.Icon
	}
	if other.UITags.IconPosition != "" {
		merged.UITags.IconPosition = other.UITags.IconPosition
	}
	merged.UITags.Required = merged.UITags.Required || other.UITags.Required
	merged.UITags.Hidden = merged.UITags.Hidden || other.UITags.Hidden
	if other.UITags.Help != "" {
		merged.UITags.Help = other.UITags.Help
	}
	merged.UITags.Loading = merged.UITags.Loading || other.UITags.Loading
	merged.UITags.Pill = merged.UITags.Pill || other.UITags.Pill
	
	// Merge FormTags
	if other.FormTags.Type != "" {
		merged.FormTags.Type = other.FormTags.Type
	}
	if other.FormTags.Tab != "" {
		merged.FormTags.Tab = other.FormTags.Tab
	}
	if other.FormTags.Section != "" {
		merged.FormTags.Section = other.FormTags.Section
	}
	if other.FormTags.DependsOn != "" {
		merged.FormTags.DependsOn = other.FormTags.DependsOn
	}
	if other.FormTags.ShowWhen != "" {
		merged.FormTags.ShowWhen = other.FormTags.ShowWhen
	}
	if other.FormTags.Validation != "" {
		merged.FormTags.Validation = other.FormTags.Validation
	}
	
	// Merge TableTags
	if other.TableTags.Width != "" {
		merged.TableTags.Width = other.TableTags.Width
	}
	if other.TableTags.Align != "" {
		merged.TableTags.Align = other.TableTags.Align
	}
	merged.TableTags.Sortable = merged.TableTags.Sortable || other.TableTags.Sortable
	merged.TableTags.Fixed = merged.TableTags.Fixed || other.TableTags.Fixed
	merged.TableTags.Action = merged.TableTags.Action || other.TableTags.Action
	
	return merged
}