package atoms

import (
	"strings"
)

// ============================================================================
// DESIGN RATIONALE - LINK COMPONENT
// ============================================================================
// Following the composition-based architecture established in checkbox.templ:
//
// 1. REUSABLE STRUCTS: Uses shared BaseProps, AccessibilityProps, etc.
// 2. CONFIGURATION-DRIVEN: Color schemes, variants, underline styles
// 3. ALPINE.JS INTEGRATION: Event handling for dynamic navigation
// 4. ACCESSIBILITY: Comprehensive ARIA support and semantic HTML
// 5. FLEXIBLE VARIANTS: Internal, external, button-style, icon links
// 6. SECURITY: External link protection with rel attributes
// ============================================================================

// LinkProps defines all properties for the Link component
// Composed of shared structs plus link-specific fields
type LinkProps struct {
	// Composition of shared property groups
	BaseProps
	AccessibilityProps
	InteractionProps
	AlpineEventHandlers

	// Content
	Text   string `json:"text,omitempty"`   // Link text content
	Href   string `json:"href,omitempty"`   // URL or path
	Target string `json:"target,omitempty"` // Link target (_blank, _self, etc.)

	// Link-specific attributes
	Color    string `json:"color,omitempty"`    // Color scheme
	Variant  string `json:"variant,omitempty"`  // Visual style variant
	External bool   `json:"external,omitempty"` // External link (adds security attrs)
	Download string `json:"download,omitempty"` // Download attribute

	// Link-specific styling
	ComponentSize Size `json:"componentSize"` // Component sizing
	Underline     bool `json:"underline,omitempty"` // Show underline
	Icon          string `json:"icon,omitempty"`     // Icon SVG
	IconPosition  string `json:"iconPosition,omitempty"` // "left" or "right"
}

// ============================================================================
// CONFIGURATION CONSTANTS
// ============================================================================

// Link color schemes
var linkColorSchemes = map[string][]string{
	"blue":    {"text-blue-600", "hover:text-blue-800", "dark:text-blue-400", "dark:hover:text-blue-300"},
	"gray":    {"text-gray-600", "hover:text-gray-800", "dark:text-gray-400", "dark:hover:text-gray-300"},
	"red":     {"text-red-600", "hover:text-red-800", "dark:text-red-400", "dark:hover:text-red-300"},
	"green":   {"text-green-600", "hover:text-green-800", "dark:text-green-400", "dark:hover:text-green-300"},
	"yellow":  {"text-yellow-600", "hover:text-yellow-800", "dark:text-yellow-400", "dark:hover:text-yellow-300"},
	"indigo":  {"text-indigo-600", "hover:text-indigo-800", "dark:text-indigo-400", "dark:hover:text-indigo-300"},
	"purple":  {"text-purple-600", "hover:text-purple-800", "dark:text-purple-400", "dark:hover:text-purple-300"},
	"pink":    {"text-pink-600", "hover:text-pink-800", "dark:text-pink-400", "dark:hover:text-pink-300"},
	"default": {"text-blue-600", "hover:text-blue-800", "dark:text-blue-400", "dark:hover:text-blue-300"},
}

// Link button variant color schemes
var linkButtonColorSchemes = map[string][]string{
	"blue":    {"bg-blue-600", "hover:bg-blue-700", "text-white", "focus:ring-blue-300"},
	"gray":    {"bg-gray-600", "hover:bg-gray-700", "text-white", "focus:ring-gray-300"},
	"red":     {"bg-red-600", "hover:bg-red-700", "text-white", "focus:ring-red-300"},
	"green":   {"bg-green-600", "hover:bg-green-700", "text-white", "focus:ring-green-300"},
	"yellow":  {"bg-yellow-600", "hover:bg-yellow-700", "text-white", "focus:ring-yellow-300"},
	"indigo":  {"bg-indigo-600", "hover:bg-indigo-700", "text-white", "focus:ring-indigo-300"},
	"purple":  {"bg-purple-600", "hover:bg-purple-700", "text-white", "focus:ring-purple-300"},
	"pink":    {"bg-pink-600", "hover:bg-pink-700", "text-white", "focus:ring-pink-300"},
	"default": {"bg-blue-600", "hover:bg-blue-700", "text-white", "focus:ring-blue-300"},
}

// Link size dimensions
var linkDimensions = map[Size][]string{
	SizeSM: {"text-sm"},
	SizeMD: {"text-base"},
	SizeLG: {"text-lg"},
}

// Link button size dimensions
var linkButtonDimensions = map[Size][]string{
	SizeSM: {"px-3", "py-2", "text-sm"},
	SizeMD: {"px-4", "py-2.5", "text-base"},
	SizeLG: {"px-5", "py-3", "text-lg"},
}

// Link variant styles
var linkVariants = map[string][]string{
	"default":  {"transition-colors", "duration-200"},
	"button":   {"inline-flex", "items-center", "justify-center", "rounded-lg", "font-medium", "transition-all", "duration-200", "focus:outline-none", "focus:ring-4"},
	"outlined": {"inline-flex", "items-center", "justify-center", "rounded-lg", "font-medium", "border-2", "transition-all", "duration-200", "focus:outline-none", "focus:ring-4"},
	"ghost":    {"inline-flex", "items-center", "justify-center", "rounded-lg", "font-medium", "transition-colors", "duration-200", "hover:bg-gray-100", "dark:hover:bg-gray-800"},
}

// Link base classes
const (
	linkBaseClasses        = "transition-colors duration-200 focus:outline-none"
	linkUnderlineClasses   = "underline decoration-2 underline-offset-2"
	linkHoverUnderline     = "hover:underline"
	linkIconClasses        = "w-4 h-4"
	linkIconSpacingLeft    = "me-2"
	linkIconSpacingRight   = "ms-2"
	linkDisabledClasses    = "opacity-50 cursor-not-allowed pointer-events-none"
)

// External link icon
const externalLinkIcon = `<svg class="w-3 h-3 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 18"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11v4.833A1.166 1.166 0 0 1 13.833 17H2.167A1.167 1.167 0 0 1 1 15.833V4.167A1.166 1.166 0 0 1 2.167 3h4.618m4.447-2H17v5.768M9.111 8.889l7.778-7.778"/></svg>`

// ============================================================================
// CONSTRUCTOR WITH SENSIBLE DEFAULTS
// ============================================================================

// NewLink creates a new LinkProps with sensible defaults
// Example usage:
// link := NewLink("Visit our docs", "/docs")
// link.Color = "blue"
// link.Underline = true
func NewLink(text, href string) LinkProps {
	return LinkProps{
		Text:          text,
		Href:          href,
		Color:         "default",
		Variant:       "default",
		ComponentSize: SizeMD,
		Target:        "_self",
	}
}

// NewExternalLink creates an external link with security attributes
func NewExternalLink(text, href string) LinkProps {
	props := NewLink(text, href)
	props.External = true
	props.Target = "_blank"
	return props
}

// NewButtonLink creates a button-style link
func NewButtonLink(text, href string) LinkProps {
	props := NewLink(text, href)
	props.Variant = "button"
	return props
}

// ============================================================================
// TEMPLATE COMPONENTS
// ============================================================================

// Link renders a fully-featured link with Flowbite styling
// Supports various colors, variants, sizes, and accessibility features
templ Link(props LinkProps) {
	<a
		// Base HTML attributes
		if props.ID != "" {
			id={ props.ID }
		}
		href={ props.Href }
		if props.Target != "" {
			target={ props.Target }
		}
		if props.Download != "" {
			download={ props.Download }
		}
		// Security attributes for external links
		if props.External {
			rel="noopener noreferrer"
		}
		// Styling classes
		class={ getLinkClasses(props) }
		// Accessibility attributes
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		if props.AriaDescribedBy != "" {
			aria-describedby={ props.AriaDescribedBy }
		}
		// Testing
		if props.DataTestID != "" {
			data-testid={ props.DataTestID }
		}
		// Alpine.js event handlers (using correct x-on: syntax)
		if props.OnClick != "" {
			x-on:click={ props.OnClick }
		}
	>
		// Left icon
		if props.Icon != "" && props.IconPosition != "right" {
			<span class={ linkIconClasses + " " + linkIconSpacingLeft }>
				@templ.Raw(props.Icon)
			</span>
		}
		
		// Link text
		{ props.Text }
		
		// Right icon
		if props.Icon != "" && props.IconPosition == "right" {
			<span class={ linkIconClasses + " " + linkIconSpacingRight }>
				@templ.Raw(props.Icon)
			</span>
		}
		
		// External link indicator
		if props.External && props.Icon == "" {
			@templ.Raw(externalLinkIcon)
		}
	</a>
}

// ============================================================================
// HELPER FUNCTIONS - Generate CSS classes based on props and state
// ============================================================================

// getLinkClasses generates the main link element classes
func getLinkClasses(props LinkProps) string {
	classes := []string{linkBaseClasses}

	// Add variant-specific styling from configuration
	if variants, ok := linkVariants[props.Variant]; ok {
		classes = append(classes, variants...)
	}

	// Add size-specific dimensions based on variant
	if props.Variant == "button" || props.Variant == "outlined" || props.Variant == "ghost" {
		if dimensions, ok := linkButtonDimensions[props.ComponentSize]; ok {
			classes = append(classes, dimensions...)
		}
	} else {
		if dimensions, ok := linkDimensions[props.ComponentSize]; ok {
			classes = append(classes, dimensions...)
		}
	}

	// Add color scheme based on variant
	if props.Variant == "button" {
		if colors, ok := linkButtonColorSchemes[props.Color]; ok {
			classes = append(classes, colors...)
		} else if colors, ok := linkButtonColorSchemes["default"]; ok {
			classes = append(classes, colors...)
		}
	} else if props.Variant == "outlined" {
		// Outlined variant uses text colors for border and text
		if colors, ok := linkColorSchemes[props.Color]; ok {
			// Convert text colors to border colors
			for _, class := range colors {
				if strings.HasPrefix(class, "text-") {
					borderClass := strings.Replace(class, "text-", "border-", 1)
					classes = append(classes, borderClass)
				}
				classes = append(classes, class)
			}
		}
		classes = append(classes, "bg-transparent", "hover:bg-opacity-10")
	} else {
		if colors, ok := linkColorSchemes[props.Color]; ok {
			classes = append(classes, colors...)
		} else if colors, ok := linkColorSchemes["default"]; ok {
			classes = append(classes, colors...)
		}
	}

	// Add underline styling
	if props.Underline {
		classes = append(classes, linkUnderlineClasses)
	} else if props.Variant == "default" {
		classes = append(classes, linkHoverUnderline)
	}

	// Handle disabled state
	if props.Disabled {
		classes = append(classes, linkDisabledClasses)
	}

	// Allow custom classes to be added
	if props.Class != "" {
		classes = append(classes, props.Class)
	}

	return strings.Join(classes, " ")
}

// ============================================================================
// UTILITY FUNCTIONS FOR COMMON PATTERNS
// ============================================================================

// WithColor returns a new LinkProps with color set
func (p LinkProps) WithColor(color string) LinkProps {
	p.Color = color
	return p
}

// WithVariant returns a new LinkProps with variant set
func (p LinkProps) WithVariant(variant string) LinkProps {
	p.Variant = variant
	return p
}

// WithIcon returns a new LinkProps with icon set
func (p LinkProps) WithIcon(iconSVG string, position string) LinkProps {
	p.Icon = iconSVG
	p.IconPosition = position
	return p
}

// AsExternal returns a new LinkProps configured for external links
func (p LinkProps) AsExternal() LinkProps {
	p.External = true
	p.Target = "_blank"
	return p
}

// AsButton returns a new LinkProps with button variant
func (p LinkProps) AsButton() LinkProps {
	p.Variant = "button"
	return p
}

// AsOutlined returns a new LinkProps with outlined variant
func (p LinkProps) AsOutlined() LinkProps {
	p.Variant = "outlined"
	return p
}

// AsGhost returns a new LinkProps with ghost variant
func (p LinkProps) AsGhost() LinkProps {
	p.Variant = "ghost"
	return p
}

// WithUnderline returns a new LinkProps with underline enabled
func (p LinkProps) WithUnderline() LinkProps {
	p.Underline = true
	return p
}

// AsDownload returns a new LinkProps configured for file download
func (p LinkProps) AsDownload(filename string) LinkProps {
	p.Download = filename
	return p
}

// AsDisabled returns a new LinkProps with disabled state
func (p LinkProps) AsDisabled() LinkProps {
	p.Disabled = true
	return p
}