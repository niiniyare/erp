package atoms

import (
"fmt"
)
// ============================================================================
// DESIGN RATIONALE - STATIC COMPONENT
// ============================================================================
// Following the composition-based architecture established in checkbox.templ:
//
// 1. REUSABLE STRUCTS: Uses shared BaseProps for consistency
// 2. CONFIGURATION-DRIVEN: Different text styles, formats, and semantic elements
// 3. SEMANTIC HTML: Proper semantic elements based on content type
// 4. TYPOGRAPHY: Consistent typography scales and styles
// 5. ACCESSIBILITY: Proper ARIA attributes and semantic markup
// 6. RESPONSIVE: Support for responsive text sizing
// ============================================================================

// ============================================================================
// CONFIGURATION CONSTANTS
// ============================================================================

// Text style configurations for different semantic meanings
var staticTextStyles = map[string][]string{
"body": {
"text-gray-900", "dark:text-gray-100",
},
"caption": {
"text-sm", "text-gray-600", "dark:text-gray-400",
},
"label": {
"text-sm", "font-medium", "text-gray-700", "dark:text-gray-300",
},
"heading": {
"font-semibold", "text-gray-900", "dark:text-white",
},
"subheading": {
"font-medium", "text-gray-700", "dark:text-gray-300",
},
"muted": {
"text-gray-500", "dark:text-gray-400",
},
"error": {
"text-red-600", "dark:text-red-400",
},
"success": {
"text-green-600", "dark:text-green-400",
},
"warning": {
"text-yellow-600", "dark:text-yellow-400",
},
"info": {
"text-blue-600", "dark:text-blue-400",
},
"code": {
"font-mono", "text-sm", "bg-gray-100", "dark:bg-gray-800",
"px-1", "py-0.5", "rounded", "text-gray-900", "dark:text-gray-100",
},
"emphasis": {
"font-semibold", "text-gray-900", "dark:text-white",
},
}

// Text size configurations
var staticTextSizes = map[Size][]string{
SizeXS: {"text-xs"},
SizeSM: {"text-sm"},
SizeMD: {"text-base"},
SizeLG: {"text-lg"},
SizeXL: {"text-xl"},
}

// Text alignment options
var textAlignments = map[string][]string{
"left": {"text-left"},
"center": {"text-center"},
"right": {"text-right"},
"justify": {"text-justify"},
}

// StaticProps defines properties for Static Text components.
type StaticProps struct {
BaseProps
AccessibilityProps
InteractionProps

// Static content
Text string `json:"text,omitempty"` // Text content
Html string `json:"html,omitempty"` // HTML content (use with caution)

// Static styling
TextStyle string `json:"textStyle,omitempty"` // Text style variant
Size Size `json:"size,omitempty"` // Text size
Element string `json:"element,omitempty"` // HTML element (span, p, h1, etc.)
Alignment string `json:"alignment,omitempty"` // Text alignment
Truncate bool `json:"truncate,omitempty"` // Truncate text
LineClamp int `json:"lineClamp,omitempty"` // Line clamp
PreserveWhitespace bool `json:"preserveWhitespace,omitempty"` // Preserve whitespace

// Static behavior
OnClick string `json:"onClick,omitempty"` // Click handler
For string `json:"for,omitempty"` // For label elements
Style string `json:"style,omitempty"` // Inline styles

// Children for complex text
Children []templ.Component `json:"-"` // Child components
}



// ============================================================================
// CONSTRUCTOR WITH SENSIBLE DEFAULTS
// ============================================================================

// NewStatic creates a new StaticProps with sensible defaults
// Example usage:
// static := NewStatic("This is some text", "body")
// static.Size = SizeLG
func NewStatic(text, textStyle string) StaticProps {
return StaticProps{
BaseProps: BaseProps{
ID: GenerateID("static"),
},
Text: text,
TextStyle: textStyle,
Size: SizeMD,
Element: "span",
Alignment: "left",
}
}

// NewLabel creates a static text configured as a label
func NewLabel(text string) StaticProps {
static := NewStatic(text, "label")
static.Element = "label"
return static
}

// NewHeading creates a static text configured as a heading
func NewHeading(text string, level int) StaticProps {
static := NewStatic(text, "heading")
switch level {
case 1:
static.Element = "h1"
static.Size = SizeXL
case 2:
static.Element = "h2"
static.Size = SizeLG
case 3:
static.Element = "h3"
static.Size = SizeMD
default:
static.Element = "h4"
static.Size = SizeSM
}
return static
}

// NewCaption creates a static text configured as a caption
func NewCaption(text string) StaticProps {
static := NewStatic(text, "caption")
static.Element = "figcaption"
static.Size = SizeSM
return static
}

// NewCode creates a static text configured for code display
func NewCode(text string) StaticProps {
static := NewStatic(text, "code")
static.Element = "code"
return static
}

// NewError creates a static text for error messages
func NewError(text string) StaticProps {
static := NewStatic(text, "error")
static.Element = "span"
static.AriaLive = "polite"
static.Role = "alert"
return static
}

// NewSuccess creates a static text for success messages
func NewSuccess(text string) StaticProps {
static := NewStatic(text, "success")
static.Element = "span"
static.AriaLive = "polite"
static.Role = "status"
return static
}

// ============================================================================
// TEMPLATE COMPONENTS
// ============================================================================

// Static renders static text content with proper styling and semantic elements
// Supports different text styles, sizes, alignments, and semantic HTML elements
templ Static(props StaticProps) {
switch props.Element {
case "h1":
<h1 { staticAttributes(props)... }>
  @staticContent(props)
</h1>
case "h2":
<h2 { staticAttributes(props)... }>
  @staticContent(props)
</h2>
case "h3":
<h3 { staticAttributes(props)... }>
  @staticContent(props)
</h3>
case "h4":
<h4 { staticAttributes(props)... }>
  @staticContent(props)
</h4>
case "h5":
<h5 { staticAttributes(props)... }>
  @staticContent(props)
</h5>
case "h6":
<h6 { staticAttributes(props)... }>
  @staticContent(props)
</h6>
case "p":
<p { staticAttributes(props)... }>
  @staticContent(props)
</p>
case "label":
<label { staticAttributes(props)... }>
  @staticContent(props)
</label>
case "div":
<div { staticAttributes(props)... }>
  @staticContent(props)
</div>
case "figcaption":
<figcaption { staticAttributes(props)... }>
  @staticContent(props)
</figcaption>
case "code":
<code { staticAttributes(props)... }>
  @staticContent(props)
</code>
case "pre":
<pre { staticAttributes(props)... }>
  @staticContent(props)
</pre>
case "blockquote":
<blockquote { staticAttributes(props)... }>
  @staticContent(props)
</blockquote>
case "em":
<em { staticAttributes(props)... }>
  @staticContent(props)
</em>
case "strong":
<strong { staticAttributes(props)... }>
  @staticContent(props)
</strong>
case "small":
<small { staticAttributes(props)... }>
  @staticContent(props)
</small>
default: // span
<span { staticAttributes(props)... }>
  @staticContent(props)
</span>
}
}

// staticContent renders the inner content of the static element
templ staticContent(props StaticProps) {
if props.Html != "" {
// Render HTML content (use with caution)
@templ.Raw(props.Html)
} else if props.Text != "" {
// Render plain text
{ props.Text }
} else if props.Children != nil {
// Render child components
for _, child := range props.Children {
@child
}
}
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// staticAttributes returns a map of HTML attributes for the static element
func staticAttributes(props StaticProps) templ.Attributes {
attrs := templ.Attributes{}

// ID
if props.GetID("static") != "" {
attrs["id"] = props.GetID("static")
}

// Classes
attrs["class"] = getStaticClasses(props)

// For attribute (for label elements)
if props.Element == "label" && props.For != "" {
attrs["for"] = props.For
}

// ARIA attributes
if props.AriaLabel != "" {
attrs["aria-label"] = props.AriaLabel
}
if props.AriaDescribedBy != "" {
attrs["aria-describedby"] = props.AriaDescribedBy
}
if props.AriaLabelledBy != "" {
attrs["aria-labelledby"] = props.AriaLabelledBy
}
if props.AriaLive != "" {
attrs["aria-live"] = props.AriaLive
}
if props.Role != "" {
attrs["role"] = props.Role
}
if props.AriaHidden {
attrs["aria-hidden"] = "true"
}

// Data attributes
if props.DataTestID != "" {
attrs["data-testid"] = props.DataTestID
}

// Style attribute
if props.Style != "" {
attrs["style"] = props.Style
}

return attrs
}

// getStaticClasses generates all static element classes based on props
func getStaticClasses(props StaticProps) string {
classes := []string{}

// Add text style classes
if styleClasses, ok := staticTextStyles[props.TextStyle]; ok {
classes = append(classes, styleClasses...)
}

// Add size classes
if sizeClasses, ok := staticTextSizes[props.Size]; ok {
classes = append(classes, sizeClasses...)
}

// Add alignment classes
if alignClasses, ok := textAlignments[props.Alignment]; ok {
classes = append(classes, alignClasses...)
}

// Add truncation
if props.Truncate {
classes = append(classes, "truncate")
}

// Add line clamp
if props.LineClamp > 0 {
classes = append(classes, "line-clamp-"+fmt.Sprintf("%d", props.LineClamp))
}

// Add whitespace handling
if props.PreserveWhitespace {
classes = append(classes, "whitespace-pre-wrap")
}

// Add clickable classes
if props.OnClick != "" {
classes = append(classes, "cursor-pointer", "hover:opacity-80", "transition-opacity", "duration-200")
}

// Add custom classes
if props.Class != "" {
classes = append(classes, props.Class)
}

return JoinClasses(classes...)
}

// ============================================================================
// UTILITY FUNCTIONS FOR COMMON PATTERNS
// ============================================================================

// WithText returns a new StaticProps with specified text
func (p StaticProps) WithText(text string) StaticProps {
p.Text = text
return p
}

// WithHtml returns a new StaticProps with HTML content
func (p StaticProps) WithHtml(html string) StaticProps {
p.Html = html
return p
}

// WithElement returns a new StaticProps with specified HTML element
func (p StaticProps) WithElement(element string) StaticProps {
p.Element = element
return p
}

// WithStyle returns a new StaticProps with specified text style
func (p StaticProps) WithStyle(style string) StaticProps {
p.TextStyle = style
return p
}

// WithSize returns a new StaticProps with specified size
func (p StaticProps) WithSize(size Size) StaticProps {
p.Size = size
return p
}

// WithAlignment returns a new StaticProps with specified alignment
func (p StaticProps) WithAlignment(alignment string) StaticProps {
p.Alignment = alignment
return p
}

// WithFor returns a new StaticProps with specified for attribute (for labels)
func (p StaticProps) WithFor(forID string) StaticProps {
p.For = forID
return p
}

// AsTruncated returns a new StaticProps with text truncation enabled
func (p StaticProps) AsTruncated() StaticProps {
p.Truncate = true
return p
}

// WithLineClamp returns a new StaticProps with line clamping
func (p StaticProps) WithLineClamp(lines int) StaticProps {
p.LineClamp = lines
return p
}

// WithPreservedWhitespace returns a new StaticProps with whitespace preservation
func (p StaticProps) WithPreservedWhitespace() StaticProps {
p.PreserveWhitespace = true
return p
}

// AsClickable returns a new StaticProps with click handler
func (p StaticProps) AsClickable(onClick string) StaticProps {
p.OnClick = onClick
return p
}

// AsHeading returns a new StaticProps configured as a heading
func (p StaticProps) AsHeading(level int) StaticProps {
p.TextStyle = "heading"
switch level {
case 1:
p.Element = "h1"
p.Size = SizeXL
case 2:
p.Element = "h2"
p.Size = SizeLG
case 3:
p.Element = "h3"
p.Size = SizeMD
default:
p.Element = "h4"
p.Size = SizeSM
}
return p
}

// AsParagraph returns a new StaticProps configured as a paragraph
func (p StaticProps) AsParagraph() StaticProps {
p.Element = "p"
p.TextStyle = "body"
return p
}

// AsCode returns a new StaticProps configured for code display
func (p StaticProps) AsCode() StaticProps {
p.Element = "code"
p.TextStyle = "code"
return p
}

// AsEmphasis returns a new StaticProps with emphasis styling
func (p StaticProps) AsEmphasis() StaticProps {
p.TextStyle = "emphasis"
return p
}

// AsMuted returns a new StaticProps with muted styling
func (p StaticProps) AsMuted() StaticProps {
p.TextStyle = "muted"
return p
}

// AsCentered returns a new StaticProps with center alignment
func (p StaticProps) AsCentered() StaticProps {
p.Alignment = "center"
return p
}
