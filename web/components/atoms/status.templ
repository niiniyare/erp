package atoms

// ============================================================================
// DESIGN RATIONALE - STATUS COMPONENT
// ============================================================================
// Following the composition-based architecture established in checkbox.templ:
//
// 1. REUSABLE STRUCTS: Uses shared BaseProps, ValidationProps for consistency
// 2. CONFIGURATION-DRIVEN: Status types, variants, and sizes use enums
// 3. ALPINE.JS INTEGRATION: Proper x-on: syntax for event handling
// 4. SEMANTIC MEANING: Different status types convey different meanings
// 5. ICON SUPPORT: Built-in icons for different status types
// 6. ACCESSIBILITY: Proper ARIA attributes and semantic markup
// ============================================================================

// ============================================================================
// CONFIGURATION CONSTANTS
// ============================================================================

// Status type configurations mapping to Flowbite classes and icons
var statusTypeClasses = map[ValidationState]map[Variant][]string{
	StateSuccess: {
		VariantDefault: {
			"bg-green-100", "text-green-800", "border-green-200",
			"dark:bg-green-900", "dark:text-green-300", "dark:border-green-700",
		},
		VariantFilled: {
			"bg-green-500", "text-white",
		},
		VariantOutlined: {
			"text-green-800", "border", "border-green-300", "bg-transparent",
			"dark:text-green-400", "dark:border-green-400",
		},
	},
	StateError: {
		VariantDefault: {
			"bg-red-100", "text-red-800", "border-red-200",
			"dark:bg-red-900", "dark:text-red-300", "dark:border-red-700",
		},
		VariantFilled: {
			"bg-red-500", "text-white",
		},
		VariantOutlined: {
			"text-red-800", "border", "border-red-300", "bg-transparent",
			"dark:text-red-400", "dark:border-red-400",
		},
	},
	StateWarning: {
		VariantDefault: {
			"bg-yellow-100", "text-yellow-800", "border-yellow-200",
			"dark:bg-yellow-900", "dark:text-yellow-300", "dark:border-yellow-700",
		},
		VariantFilled: {
			"bg-yellow-500", "text-white",
		},
		VariantOutlined: {
			"text-yellow-800", "border", "border-yellow-300", "bg-transparent",
			"dark:text-yellow-400", "dark:border-yellow-400",
		},
	},
	StateInfo: {
		VariantDefault: {
			"bg-blue-100", "text-blue-800", "border-blue-200",
			"dark:bg-blue-900", "dark:text-blue-300", "dark:border-blue-700",
		},
		VariantFilled: {
			"bg-blue-500", "text-white",
		},
		VariantOutlined: {
			"text-blue-800", "border", "border-blue-300", "bg-transparent",
			"dark:text-blue-400", "dark:border-blue-400",
		},
	},
	StateDefault: {
		VariantDefault: {
			"bg-gray-100", "text-gray-800", "border-gray-200",
			"dark:bg-gray-900", "dark:text-gray-300", "dark:border-gray-700",
		},
		VariantFilled: {
			"bg-gray-500", "text-white",
		},
		VariantOutlined: {
			"text-gray-800", "border", "border-gray-300", "bg-transparent",
			"dark:text-gray-400", "dark:border-gray-400",
		},
	},
}

// Status type to icon mapping
var statusTypeIcons = map[ValidationState]string{
	StateSuccess: "check-circle",
	StateError:   "error",
	StateWarning: "warning",
	StateInfo:    "info",
	StateDefault: "info",
}

// Base status classes
const (
	statusBaseClasses = "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium transition-colors duration-200"
	statusWithIconSpacing = "gap-1"
	statusClickableClasses = "cursor-pointer hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2"
)

// ============================================================================
// CONSTRUCTOR WITH SENSIBLE DEFAULTS
// ============================================================================

// NewStatus creates a new StatusProps with sensible defaults
// Example usage:
// status := NewStatus("Active", StateSuccess)
// status.ShowIcon = true
func NewStatus(text string, statusType ValidationState) StatusProps {
	return StatusProps{
		BaseProps: BaseProps{
			ID: GenerateID("status"),
		},
		Text:    text,
		Type:    statusType,
		Variant: VariantDefault,
		Size:    SizeMD,
	}
}

// NewSuccessStatus creates a status indicating success
func NewSuccessStatus(text string) StatusProps {
	status := NewStatus(text, StateSuccess)
	status.ShowIcon = true
	return status
}

// NewErrorStatus creates a status indicating error
func NewErrorStatus(text string) StatusProps {
	status := NewStatus(text, StateError)
	status.ShowIcon = true
	return status
}

// NewWarningStatus creates a status indicating warning
func NewWarningStatus(text string) StatusProps {
	status := NewStatus(text, StateWarning)
	status.ShowIcon = true
	return status
}

// NewInfoStatus creates a status indicating information
func NewInfoStatus(text string) StatusProps {
	status := NewStatus(text, StateInfo)
	status.ShowIcon = true
	return status
}

// ============================================================================
// TEMPLATE COMPONENTS
// ============================================================================

// Status renders a status indicator with proper styling and optional icon
// Supports different types (success, error, warning, info), variants, and sizes
templ Status(props StatusProps) {
	<span
		if props.GetID("status") != "" {
			id={ props.GetID("status") }
		}
		class={ getStatusClasses(props) }
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		} else {
			aria-label={ getDefaultAriaLabel(props.Type, props.Text) }
		}
		if props.Role != "" {
			role={ props.Role }
		} else if props.OnClick != "" {
			role="button"
			tabindex="0"
		}
		if props.DataTestID != "" {
			data-testid={ props.DataTestID }
		}
		if props.OnClick != "" {
			x-on:click={ props.OnClick }
		}
		if props.OnKeyDown != "" {
			x-on:keydown={ props.OnKeyDown }
		}
	>
		// Icon (if enabled)
		if props.ShowIcon {
			@statusIcon(props)
		}
		
		// Status text
		<span>{ props.Text }</span>
	</span>
}

// statusIcon renders the appropriate icon for the status type
templ statusIcon(props StatusProps) {
	if iconName, ok := statusTypeIcons[props.Type]; ok {
		@Icon(IconProps{
			Name: iconName,
			Size: getStatusIconSize(props.Size),
		})
	}
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// getStatusClasses generates all status classes based on props
func getStatusClasses(props StatusProps) string {
	classes := []string{statusBaseClasses}
	
	// Add type and variant classes
	if typeVariants, ok := statusTypeClasses[props.Type]; ok {
		if variantClasses, ok := typeVariants[props.Variant]; ok {
			classes = append(classes, variantClasses...)
		}
	}
	
	// Add size classes
	classes = append(classes, GetStatusSizeClasses(props.Size)...)
	
	// Add icon spacing
	if props.ShowIcon {
		classes = append(classes, statusWithIconSpacing)
	}
	
	// Add clickable classes
	if props.OnClick != "" {
		classes = append(classes, statusClickableClasses)
		// Add focus ring color based on type
		classes = append(classes, getStatusFocusRingClasses(props.Type)...)
	}
	
	// Add custom classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}
	
	return JoinClasses(classes...)
}

// getStatusIconSize returns appropriate icon size for status size
func getStatusIconSize(size Size) Size {
	switch size {
	case SizeXS:
		return SizeXS
	case SizeSM:
		return SizeSM
	case SizeLG, SizeXL:
		return SizeMD
	default:
		return SizeSM
	}
}

// getStatusFocusRingClasses returns focus ring classes based on status type
func getStatusFocusRingClasses(statusType ValidationState) []string {
	switch statusType {
	case StateSuccess:
		return []string{"focus:ring-green-500"}
	case StateError:
		return []string{"focus:ring-red-500"}
	case StateWarning:
		return []string{"focus:ring-yellow-500"}
	case StateInfo:
		return []string{"focus:ring-blue-500"}
	default:
		return []string{"focus:ring-gray-500"}
	}
}

// getDefaultAriaLabel returns a default ARIA label for the status
func getDefaultAriaLabel(statusType ValidationState, text string) string {
	switch statusType {
	case StateSuccess:
		return "Success: " + text
	case StateError:
		return "Error: " + text
	case StateWarning:
		return "Warning: " + text
	case StateInfo:
		return "Information: " + text
	default:
		return "Status: " + text
	}
}

// ============================================================================
// UTILITY FUNCTIONS FOR COMMON PATTERNS
// ============================================================================

// WithText returns a new StatusProps with specified text
func (p StatusProps) WithText(text string) StatusProps {
	p.Text = text
	return p
}

// WithType returns a new StatusProps with specified type
func (p StatusProps) WithType(statusType ValidationState) StatusProps {
	p.Type = statusType
	return p
}

// WithVariant returns a new StatusProps with specified variant
func (p StatusProps) WithVariant(variant Variant) StatusProps {
	p.Variant = variant
	return p
}

// WithSize returns a new StatusProps with specified size
func (p StatusProps) WithSize(size Size) StatusProps {
	p.Size = size
	return p
}

// WithIcon returns a new StatusProps with icon enabled
func (p StatusProps) WithIcon(show bool) StatusProps {
	p.ShowIcon = show
	return p
}

// AsClickable returns a new StatusProps with click handler
func (p StatusProps) AsClickable(onClick string) StatusProps {
	p.OnClick = onClick
	return p
}

// AsFilled returns a new StatusProps with filled variant
func (p StatusProps) AsFilled() StatusProps {
	p.Variant = VariantFilled
	return p
}

// AsOutlined returns a new StatusProps with outlined variant
func (p StatusProps) AsOutlined() StatusProps {
	p.Variant = VariantOutlined
	return p
}