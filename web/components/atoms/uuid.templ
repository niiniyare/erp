package atoms

import (
	"crypto/rand"
	"fmt"
	"strconv"
	"strings"
)

// ============================================================================
// DESIGN RATIONALE - UUID COMPONENT
// ============================================================================
// Following the composition-based architecture established in checkbox.templ:
//
// 1. REUSABLE STRUCTS: Uses shared BaseProps for consistency
// 2. UUID GENERATION: Built-in UUID v4 generation capabilities
// 3. DISPLAY MODES: Support for different UUID display formats
// 4. COPY FUNCTIONALITY: Built-in copy-to-clipboard with e.js
// 5. VALIDATION: UUID format validation and visual feedback
// 6. ACCESSIBILITY: Proper ARIA labels and keyboard navigation
// ============================================================================

// ============================================================================
// CONFIGURATION CONSTANTS
// ============================================================================

// UUID display format configurations
var uuidFormatClasses = map[string][]string{
	"full": {"font-mono", "text-sm"},
	"short": {"font-mono", "text-sm", "tracking-wide"},
	"compact": {"font-mono", "text-xs", "tracking-tight"},
}

// UUID input variant configurations
var uuidInputVariantClasses = map[Variant][]string{
	VariantDefault: {
		"bg-gray-50", "border", "border-gray-300", "text-gray-900",
		"focus:ring-blue-500", "focus:border-blue-500",
		"dark:bg-gray-700", "dark:border-gray-600", "dark:text-white",
	},
	VariantOutlined: {
		"bg-transparent", "border", "border-gray-300", "text-gray-900",
		"focus:ring-blue-500", "focus:border-blue-500",
		"dark:border-gray-600", "dark:text-white",
	},
}

// Base UUID classes
const (
	uuidBaseClasses = "block w-full rounded-lg text-sm transition-colors duration-200"
	uuidDisplayClasses = "inline-flex items-center gap-2 px-3 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg"
	uuidReadOnlyClasses = "bg-gray-100 cursor-default dark:bg-gray-600"
	uuidCopyButtonClasses = "p-1 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
)

// ============================================================================
// UUID GENERATION FUNCTIONS
// ============================================================================

// GenerateUUIDv4 generates a new UUID v4 string
func GenerateUUIDv4() string {
	uuid := make([]byte, 16)
	_, err := rand.Read(uuid)
	if err != nil {
		// Fallback to a simple ID if crypto/rand fails
		return GenerateID("uuid")
	}
	
	// Set version (4) and variant bits
	uuid[6] = (uuid[6] & 0x0f) | 0x40 // Version 4
	uuid[8] = (uuid[8] & 0x3f) | 0x80 // Variant 10
	
	return fmt.Sprintf("%08x-%04x-%04x-%04x-%012x",
		uuid[0:4], uuid[4:6], uuid[6:8], uuid[8:10], uuid[10:16])
}

// ValidateUUID checks if a string is a valid UUID format
func ValidateUUID(uuid string) bool {
	if len(uuid) != 36 {
		return false
	}
	
	// Check format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
	parts := strings.Split(uuid, "-")
	if len(parts) != 5 {
		return false
	}
	
	expectedLengths := []int{8, 4, 4, 4, 12}
	for i, part := range parts {
		if len(part) != expectedLengths[i] {
			return false
		}
		for _, char := range part {
			if !((char >= '0' && char <= '9') || (char >= 'a' && char <= 'f') || (char >= 'A' && char <= 'F')) {
				return false
			}
		}
	}
	
	return true
}

// FormatUUID formats a UUID according to the specified display format
func FormatUUID(uuid, format string) string {
	if !ValidateUUID(uuid) {
		return uuid
	}
	
	switch format {
	case "short":
		// Show first 8 and last 12 characters with ellipsis
		return uuid[:8] + "..." + uuid[24:]
	case "compact":
		// Show first 8 characters only
		return uuid[:8]
	case "no-dashes":
		// Remove dashes
		return strings.ReplaceAll(uuid, "-", "")
	default: // "full"
		return uuid
	}
}

// ============================================================================
// CONSTRUCTOR WITH SENSIBLE DEFAULTS
// ============================================================================

// NewUUID creates a new UUIDProps with sensible defaults
// Example usage:
// uuid := NewUUID("entity_id", "")
// uuid.AutoGenerate = true
func NewUUID(name, value string) UUIDProps {
	return UUIDProps{
		BaseProps: BaseProps{
			ID:   GenerateID("uuid"),
			Name: name,
		},
		Value:         value,
		Variant:       VariantDefault,
		Size:          SizeMD,
		DisplayFormat: "full",
		Editable:      true,
	}
}

// NewUUIDDisplay creates a UUID component for display-only purposes
func NewUUIDDisplay(uuid string) UUIDProps {
	props := NewUUID("", uuid)
	props.Editable = false
	props.ShowCopyButton = true
	return props
}

// NewUUIDGenerator creates a UUID component with auto-generation
func NewUUIDGenerator(name string) UUIDProps {
	props := NewUUID(name, GenerateUUIDv4())
	props.AutoGenerate = true
	props.ShowCopyButton = true
	props.ShowGenerateButton = true
	return props
}

// ============================================================================
// TEMPLATE COMPONENTS
// ============================================================================

// UUID renders a UUID input or display component
// Supports generation, validation, copying, and different display formats
templ UUID(props UUIDProps) {
	<div class={ getUUIDWrapperClasses(props) }>
		// Label
		if props.Label != "" {
			@uuidLabel(props)
		}
		
		<div class="relative">
			if props.Editable {
				// Editable UUID input
				<input
					type="text"
					id={ props.GetID("uuid") }
					class={ getUUIDInputClasses(props) }
					if props.Name != "" {
						name={ props.Name }
					}
					value={ props.Value }
					if props.Placeholder != "" {
						placeholder={ props.Placeholder }
					} else {
						placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
					}
					if props.Required {
						required
					}
					if props.ReadOnly {
						readonly
					}
					if props.Disabled {
						disabled
					}
					pattern="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
					maxlength="36"
					if props.DataTestID != "" {
						data-testid={ props.DataTestID }
					}
					if props.AriaLabel != "" {
						aria-label={ props.AriaLabel }
					}
					if props.AriaDescribedBy != "" {
						aria-describedby={ props.AriaDescribedBy }
					}
					if props.TabIndex != 0 {
						tabindex={ strconv.Itoa(props.TabIndex) }
					}
					if props.OnChange != "" {
						x-on:change={ props.OnChange }
					}
					if props.OnInput != "" {
						x-on:input={ props.OnInput }
					}
					x-on:input="$el.setCustomValidity(!/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test($el.value) && $el.value !== '' ? 'Please enter a valid UUID format' : '')"
				/>
			} else {
				// Display-only UUID
				<div class={ uuidDisplayClasses }>
					<span class={ getUUIDFormatClasses(props.DisplayFormat) }>
						{ FormatUUID(props.Value, props.DisplayFormat) }
					</span>
				</div>
			}
			
			// Action buttons container
			if props.ShowCopyButton || props.ShowGenerateButton {
				<div class="absolute inset-y-0 right-0 flex items-center pr-3 gap-1">
					// Copy button
					if props.ShowCopyButton && props.Value != "" {
						@uuidCopyButton(props)
					}
					
					// Generate button
					if props.ShowGenerateButton && props.Editable {
						@uuidGenerateButton(props)
					}
				</div>
			}
		</div>
		
		// Validation and help text
		@uuidValidationText(props)
	</div>
}

// uuidLabel renders the label for the UUID component
templ uuidLabel(props UUIDProps) {
	<label
		for={ props.GetID("uuid") }
		class="block text-sm font-medium text-gray-900 dark:text-white mb-2"
	>
		{ props.GetLabelText() }
		if props.Required {
			<span class="text-red-500 ml-1">*</span>
		}
	</label>
}

// uuidCopyButton renders the copy to clipboard button
templ uuidCopyButton(props UUIDProps) {
	<button
		type="button"
		class={ uuidCopyButtonClasses }
		title="Copy to clipboard"
		aria-label="Copy UUID to clipboard"
		x-on:click="navigator.clipboard.writeText($el.closest('.relative').querySelector('input, span').textContent || $el.closest('.relative').querySelector('input').value).then(() => { $el.classList.add('text-green-500'); setTimeout(() => $el.classList.remove('text-green-500'), 2000); })"
	>
		@Icon(IconProps{
			Name: "copy",
			Size: SizeSM,
		})
	</button>
}

// uuidGenerateButton renders the generate new UUID button
templ uuidGenerateButton(props UUIDProps) {
	<button
		type="button"
		class={ uuidCopyButtonClasses }
		title="Generate new UUID"
		aria-label="Generate new UUID"
		x-on:click="
			const input = $el.closest('.relative').querySelector('input');
			if (input) {
				const newUuid = crypto.randomUUID ? crypto.randomUUID() : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
					const r = Math.random() * 16 | 0;
					const v = c == 'x' ? r : (r & 0x3 | 0x8);
					return v.toString(16);
				});
				input.value = newUuid;
				input.dispatchEvent(new Event('input', { bubbles: true }));
				input.dispatchEvent(new Event('change', { bubbles: true }));
			}
		"
	>
		@Icon(IconProps{
			Name: "refresh",
			Size: SizeSM,
		})
	</button>
}

// uuidValidationText renders validation messages and help text
templ uuidValidationText(props UUIDProps) {
	if props.HelpText != "" || props.ShowValidation {
		<div class="mt-2 text-sm">
			if props.ShowValidation && props.ErrorText != "" {
				<p class="text-red-600 dark:text-red-400">{ props.ErrorText }</p>
			} else if props.HelpText != "" {
				<p class="text-gray-600 dark:text-gray-400">{ props.HelpText }</p>
			}
		</div>
	}
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// getUUIDWrapperClasses returns classes for the UUID wrapper
func getUUIDWrapperClasses(props UUIDProps) string {
	classes := []string{}
	
	// Add custom wrapper classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}
	
	return JoinClasses(classes...)
}

// getUUIDInputClasses generates input classes based on props
func getUUIDInputClasses(props UUIDProps) string {
	classes := []string{uuidBaseClasses}
	
	// Add variant classes
	if variantClasses, ok := uuidInputVariantClasses[props.Variant]; ok {
		classes = append(classes, variantClasses...)
	}
	
	// Add size classes
	classes = append(classes, GetInputSizeClasses(props.Size)...)
	
	// Add readonly state
	if props.ReadOnly {
		classes = append(classes, uuidReadOnlyClasses)
	}
	
	// Add padding for buttons
	if props.ShowCopyButton || props.ShowGenerateButton {
		classes = append(classes, "pr-16")
	}
	
	return JoinClasses(classes...)
}

// getUUIDFormatClasses returns classes for UUID display format
func getUUIDFormatClasses(format string) string {
	if formatClasses, ok := uuidFormatClasses[format]; ok {
		return JoinClasses(formatClasses...)
	}
	return JoinClasses(uuidFormatClasses["full"]...)
}

// ============================================================================
// UTILITY FUNCTIONS FOR COMMON PATTERNS
// ============================================================================

// WithValue returns a new UUIDProps with specified value
func (p UUIDProps) WithValue(value string) UUIDProps {
	p.Value = value
	return p
}

// WithLabel returns a new UUIDProps with specified label
func (p UUIDProps) WithLabel(label string) UUIDProps {
	p.Label = label
	return p
}

// WithDisplayFormat returns a new UUIDProps with specified display format
func (p UUIDProps) WithDisplayFormat(format string) UUIDProps {
	p.DisplayFormat = format
	return p
}

// AsReadOnly returns a new UUIDProps marked as read-only
func (p UUIDProps) AsReadOnly() UUIDProps {
	p.ReadOnly = true
	p.Editable = false
	return p
}

// AsRequired returns a new UUIDProps marked as required
func (p UUIDProps) AsRequired() UUIDProps {
	p.Required = true
	return p
}

// WithCopyButton returns a new UUIDProps with copy button enabled
func (p UUIDProps) WithCopyButton(show bool) UUIDProps {
	p.ShowCopyButton = show
	return p
}

// WithGenerateButton returns a new UUIDProps with generate button enabled
func (p UUIDProps) WithGenerateButton(show bool) UUIDProps {
	p.ShowGenerateButton = show
	return p
}

// WithAutoGenerate returns a new UUIDProps with auto-generation enabled
func (p UUIDProps) WithAutoGenerate(enable bool) UUIDProps {
	p.AutoGenerate = enable
	if enable && p.Value == "" {
		p.Value = GenerateUUIDv4()
	}
	return p
}

// WithSize returns a new UUIDProps with specified size
func (p UUIDProps) WithSize(size Size) UUIDProps {
	p.Size = size
	return p
}