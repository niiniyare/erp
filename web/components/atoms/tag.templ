package atoms

import (
	"strings"
)

// ============================================================================
// DESIGN RATIONALE - TAG COMPONENT
// ============================================================================
// Following the composition-based architecture established in checkbox.templ:
//
// 1. REUSABLE STRUCTS: Uses shared BaseProps, AccessibilityProps, etc.
// 2. CONFIGURATION-DRIVEN: Color schemes, variants, selectable states
// 3. ALPINE.JS INTEGRATION: Event handling for interactive tags
// 4. ACCESSIBILITY: ARIA support and keyboard navigation
// 5. FLEXIBLE STATES: Selectable, removable, different visual variants
// 6. SEMANTIC USAGE: Tags for categorization, filtering, and labeling
// ============================================================================

// TagProps defines all properties for the Tag component
// Composed of shared structs plus tag-specific fields
type TagProps struct {
	// Composition of shared property groups
	BaseProps
	AccessibilityProps
	InteractionProps
	AlpineEventHandlers

	// Content
	Text string `json:"text,omitempty"` // Tag text content

	// Tag-specific attributes
	Color      string `json:"color,omitempty"`      // Color scheme
	Variant    string `json:"variant,omitempty"`    // Visual style variant
	Selectable bool   `json:"selectable,omitempty"` // Can be selected/toggled
	Selected   bool   `json:"selected,omitempty"`   // Current selection state
	Removable  bool   `json:"removable,omitempty"`  // Can be removed/dismissed

	// Tag-specific styling
	ComponentSize Size `json:"componentSize"` // Component sizing
}

// ============================================================================
// CONFIGURATION CONSTANTS
// ============================================================================

// Tag color schemes (slightly different from badges - more muted)
var tagColorSchemes = map[string][]string{
	"blue":    {"bg-blue-50", "text-blue-700", "border-blue-200", "dark:bg-blue-900/20", "dark:text-blue-300", "dark:border-blue-800"},
	"gray":    {"bg-gray-50", "text-gray-700", "border-gray-200", "dark:bg-gray-800", "dark:text-gray-300", "dark:border-gray-600"},
	"red":     {"bg-red-50", "text-red-700", "border-red-200", "dark:bg-red-900/20", "dark:text-red-300", "dark:border-red-800"},
	"green":   {"bg-green-50", "text-green-700", "border-green-200", "dark:bg-green-900/20", "dark:text-green-300", "dark:border-green-800"},
	"yellow":  {"bg-yellow-50", "text-yellow-700", "border-yellow-200", "dark:bg-yellow-900/20", "dark:text-yellow-300", "dark:border-yellow-800"},
	"indigo":  {"bg-indigo-50", "text-indigo-700", "border-indigo-200", "dark:bg-indigo-900/20", "dark:text-indigo-300", "dark:border-indigo-800"},
	"purple":  {"bg-purple-50", "text-purple-700", "border-purple-200", "dark:bg-purple-900/20", "dark:text-purple-300", "dark:border-purple-800"},
	"pink":    {"bg-pink-50", "text-pink-700", "border-pink-200", "dark:bg-pink-900/20", "dark:text-pink-300", "dark:border-pink-800"},
	"default": {"bg-gray-50", "text-gray-700", "border-gray-200", "dark:bg-gray-800", "dark:text-gray-300", "dark:border-gray-600"},
}

// Tag selected state color schemes
var tagSelectedColorSchemes = map[string][]string{
	"blue":    {"bg-blue-500", "text-white", "border-blue-500"},
	"gray":    {"bg-gray-500", "text-white", "border-gray-500"},
	"red":     {"bg-red-500", "text-white", "border-red-500"},
	"green":   {"bg-green-500", "text-white", "border-green-500"},
	"yellow":  {"bg-yellow-500", "text-white", "border-yellow-500"},
	"indigo":  {"bg-indigo-500", "text-white", "border-indigo-500"},
	"purple":  {"bg-purple-500", "text-white", "border-purple-500"},
	"pink":    {"bg-pink-500", "text-white", "border-pink-500"},
	"default": {"bg-gray-500", "text-white", "border-gray-500"},
}

// Tag size dimensions
var tagDimensions = map[Size][]string{
	SizeSM: {"text-xs", "px-2", "py-1"},
	SizeMD: {"text-sm", "px-3", "py-1.5"},
	SizeLG: {"text-base", "px-4", "py-2"},
}

// Tag variant styles
var tagVariants = map[string][]string{
	"default":  {"rounded-md", "border"},
	"pill":     {"rounded-full", "border"},
	"outlined": {"border-2", "bg-transparent"},
	"solid":    {"border-0"},
}

// Tag base classes
const (
	tagBaseClasses        = "inline-flex items-center font-medium transition-colors duration-200"
	tagSelectableClasses  = "cursor-pointer hover:opacity-80"
	tagRemoveClasses      = "inline-flex items-center p-0.5 ms-2 text-sm bg-transparent rounded-sm hover:bg-black/10"
	tagDisabledClasses    = "opacity-50 cursor-not-allowed"
)

// Remove icon SVG
const tagRemoveIcon = `<svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/></svg>`

// ============================================================================
// CONSTRUCTOR WITH SENSIBLE DEFAULTS
// ============================================================================

// NewTag creates a new TagProps with sensible defaults
// Example usage:
// tag := NewTag("Frontend")
// tag.Color = "blue"
// tag.Selectable = true
func NewTag(text string) TagProps {
	return TagProps{
		Text:          text,
		Color:         "default",
		Variant:       "default",
		ComponentSize: SizeSM,
	}
}

// NewTagWithColor creates a tag with specified color
func NewTagWithColor(text, color string) TagProps {
	props := NewTag(text)
	props.Color = color
	return props
}

// NewSelectableTag creates a selectable tag
func NewSelectableTag(text, color string) TagProps {
	props := NewTag(text)
	props.Color = color
	props.Selectable = true
	return props
}

// ============================================================================
// TEMPLATE COMPONENTS
// ============================================================================

// Tag renders a fully-featured tag with Flowbite styling
// Supports various colors, variants, sizes, and interactive features
templ Tag(props TagProps) {
	if props.Selectable {
		// Selectable tag (button)
		<button
			type="button"
			// Base HTML attributes
			if props.ID != "" {
				id={ props.ID }
			}
			// Styling classes
			class={ getTagClasses(props) }
			// Boolean states
			if props.Disabled {
				disabled
			}
			// Accessibility attributes
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			}
			if props.AriaDescribedBy != "" {
				aria-describedby={ props.AriaDescribedBy }
			}
			aria-pressed={ templ.Bool(props.Selected) }
			// Testing
			if props.DataTestID != "" {
				data-testid={ props.DataTestID }
			}
			// Alpine.js event handlers (using correct x-on: syntax)
			if props.OnClick != "" {
				x-on:click={ props.OnClick }
			}
		>
			// Tag text
			{ props.Text }
			
			// Remove button
			if props.Removable {
				<span
					class={ tagRemoveClasses }
					if props.AriaLabel != "" {
						aria-label={ "Remove " + props.AriaLabel + " tag" }
					} else {
						aria-label="Remove tag"
					}
				>
					@templ.Raw(tagRemoveIcon)
				</span>
			}
		</button>
	} else {
		// Regular tag (span)
		<span
			// Base HTML attributes
			if props.ID != "" {
				id={ props.ID }
			}
			// Styling classes
			class={ getTagClasses(props) }
			// Accessibility attributes
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			}
			if props.AriaDescribedBy != "" {
				aria-describedby={ props.AriaDescribedBy }
			}
			// Testing
			if props.DataTestID != "" {
				data-testid={ props.DataTestID }
			}
			// Alpine.js event handlers (using correct x-on: syntax)
			if props.OnClick != "" {
				x-on:click={ props.OnClick }
			}
		>
			// Tag text
			{ props.Text }
			
			// Remove button
			if props.Removable {
				<button
					type="button"
					class={ tagRemoveClasses }
					if props.AriaLabel != "" {
						aria-label={ "Remove " + props.AriaLabel + " tag" }
					} else {
						aria-label="Remove tag"
					}
					if props.OnClick != "" {
						x-on:click={ props.OnClick }
					}
				>
					@templ.Raw(tagRemoveIcon)
					<span class="sr-only">Remove tag</span>
				</button>
			}
		</span>
	}
}

// ============================================================================
// HELPER FUNCTIONS - Generate CSS classes based on props and state
// ============================================================================

// getTagClasses generates the main tag element classes
func getTagClasses(props TagProps) string {
	classes := []string{tagBaseClasses}

	// Add size-specific dimensions from configuration
	if dimensions, ok := tagDimensions[props.ComponentSize]; ok {
		classes = append(classes, dimensions...)
	}

	// Add variant-specific styling from configuration
	if variants, ok := tagVariants[props.Variant]; ok {
		classes = append(classes, variants...)
	}

	// Add selectable interaction classes
	if props.Selectable && !props.Disabled {
		classes = append(classes, tagSelectableClasses)
	}

	// Add color scheme based on selection state
	if props.Selected && props.Selectable {
		if colors, ok := tagSelectedColorSchemes[props.Color]; ok {
			classes = append(classes, colors...)
		} else if colors, ok := tagSelectedColorSchemes["default"]; ok {
			classes = append(classes, colors...)
		}
	} else {
		if colors, ok := tagColorSchemes[props.Color]; ok {
			classes = append(classes, colors...)
		} else if colors, ok := tagColorSchemes["default"]; ok {
			classes = append(classes, colors...)
		}
	}

	// Handle disabled state
	if props.Disabled {
		classes = append(classes, tagDisabledClasses)
	}

	// Allow custom classes to be added
	if props.Class != "" {
		classes = append(classes, props.Class)
	}

	return strings.Join(classes, " ")
}

// ============================================================================
// UTILITY FUNCTIONS FOR COMMON PATTERNS
// ============================================================================

// WithColor returns a new TagProps with color set
func (p TagProps) WithColor(color string) TagProps {
	p.Color = color
	return p
}

// WithVariant returns a new TagProps with variant set
func (p TagProps) WithVariant(variant string) TagProps {
	p.Variant = variant
	return p
}

// AsSelectable returns a new TagProps with selectable behavior
func (p TagProps) AsSelectable() TagProps {
	p.Selectable = true
	return p
}

// AsSelected returns a new TagProps with selected state
func (p TagProps) AsSelected() TagProps {
	p.Selected = true
	return p
}

// AsRemovable returns a new TagProps with remove button
func (p TagProps) AsRemovable() TagProps {
	p.Removable = true
	return p
}

// AsPill returns a new TagProps with pill variant
func (p TagProps) AsPill() TagProps {
	p.Variant = "pill"
	return p
}

// AsOutlined returns a new TagProps with outlined variant
func (p TagProps) AsOutlined() TagProps {
	p.Variant = "outlined"
	return p
}

// AsSolid returns a new TagProps with solid variant
func (p TagProps) AsSolid() TagProps {
	p.Variant = "solid"
	return p
}

// AsDisabled returns a new TagProps with disabled state
func (p TagProps) AsDisabled() TagProps {
	p.Disabled = true
	return p
}