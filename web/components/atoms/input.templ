package atoms

import (
	"context"
	"strconv"
)

// InputProps defines the properties for the Input component
type InputProps struct {
	BaseAtomProps

	// Content
	Label       string `json:"label,omitempty"`
	Value       string `json:"value,omitempty"`
	Placeholder string `json:"placeholder,omitempty"`
	HelpText    string `json:"helpText,omitempty"`
	ErrorText   string `json:"errorText,omitempty"`

	// Input attributes
	Type         string `json:"type,omitempty"`          // text, email, password, number, etc.
	Name         string `json:"name,omitempty"`
	Required     bool   `json:"required,omitempty"`
	ReadOnly     bool   `json:"readonly,omitempty"`
	AutoFocus    bool   `json:"autofocus,omitempty"`
	AutoComplete string `json:"autocomplete,omitempty"`
	Pattern      string `json:"pattern,omitempty"`
	MinLength    int    `json:"minlength,omitempty"`
	MaxLength    int    `json:"maxlength,omitempty"`
	Min          string `json:"min,omitempty"`
	Max          string `json:"max,omitempty"`
	Step         string `json:"step,omitempty"`

	// Styling
	Variant string `json:"variant,omitempty"` // default, floating, outlined
	Size    string `json:"size,omitempty"`    // sm, md, lg
	State   string `json:"state,omitempty"`   // default, success, error

	// Behavior
	OnChange string `json:"onchange,omitempty"` // Alpine.js change handler
	OnInput  string `json:"oninput,omitempty"`  // Alpine.js input handler
	OnFocus  string `json:"onfocus,omitempty"`  // Alpine.js focus handler
	OnBlur   string `json:"onblur,omitempty"`   // Alpine.js blur handler

	// Icons
	LeftIcon  string `json:"leftIcon,omitempty"`
	RightIcon string `json:"rightIcon,omitempty"`

	// Validation
	ShowValidation bool `json:"showValidation,omitempty"`
}

// Input renders an input using the self-contained CSS factory
templ Input(ctx context.Context, props InputProps) {
	<div>
		<input
			if props.ID != "" {
				id={ props.ID }
			}
			style={ GetInputCSS(props.State) }
			if props.ClassName != "" {
				class={ props.ClassName }
			}
			if props.Type != "" {
				type={ props.Type }
			} else {
				type="text"
			}
			if props.Name != "" {
				name={ props.Name }
			}
			if props.Value != "" {
				value={ props.Value }
			}
			if props.Placeholder != "" {
				placeholder={ props.Placeholder }
			}
			if props.Required {
				required
			}
			if props.Disabled {
				disabled
			}
			if props.ReadOnly {
				readonly
			}
			if props.AutoFocus {
				autofocus
			}
			if props.AutoComplete != "" {
				autocomplete={ props.AutoComplete }
			}
			if props.Pattern != "" {
				pattern={ props.Pattern }
			}
			if props.MinLength > 0 {
				minlength={ strconv.Itoa(props.MinLength) }
			}
			if props.MaxLength > 0 {
				maxlength={ strconv.Itoa(props.MaxLength) }
			}
			if props.Min != "" {
				min={ props.Min }
			}
			if props.Max != "" {
				max={ props.Max }
			}
			if props.Step != "" {
				step={ props.Step }
			}
			if props.TestID != "" {
				data-testid={ props.TestID }
			}
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			}
			if props.AriaDescribedBy != "" {
				aria-describedby={ props.AriaDescribedBy }
			}
			if props.OnChange != "" {
				@change={ props.OnChange }
			}
			if props.OnInput != "" {
				@input={ props.OnInput }
			}
			if props.OnFocus != "" {
				@focus={ props.OnFocus }
			}
			if props.OnBlur != "" {
				@blur={ props.OnBlur }
			}
		/>
		if props.Label != "" {
			<label for={ props.ID }>{ props.Label }</label>
		}
		if props.HelpText != "" {
			<div class="help-text">{ props.HelpText }</div>
		}
		if props.ErrorText != "" {
			<div class="error-text">{ props.ErrorText }</div>
		}
	</div>
}

// InputFromSchema creates an Input component from JSON schema configuration
templ InputFromSchema(ctx context.Context, schemaConfig string) {
	<div>Placeholder for schema-based input</div>
}