package atoms

import (
	"strconv"
	"strings"
)

// ============================================================================
// DESIGN RATIONALE - PROGRESS COMPONENT
// ============================================================================
// Following the composition-based architecture established in checkbox.templ:
//
// 1. REUSABLE STRUCTS: Uses shared BaseProps, AccessibilityProps, etc.
// 2. CONFIGURATION-DRIVEN: Color schemes, variants, animation support
// 3. ALPINE.JS INTEGRATION: Dynamic progress updates and events
// 4. ACCESSIBILITY: ARIA progress attributes and screen reader support
// 5. FLEXIBLE VARIANTS: Linear, circular, indeterminate states
// 6. SEMANTIC USAGE: Progress indicators for loading, completion, steps
// ============================================================================

// ProgressProps is defined in probs.go to avoid duplication

// ============================================================================
// CONFIGURATION CONSTANTS
// ============================================================================

// Progress color schemes
var progressColorSchemes = map[string][]string{
	"blue":    {"bg-blue-600"},
	"gray":    {"bg-gray-600"},
	"red":     {"bg-red-600"},
	"green":   {"bg-green-600"},
	"yellow":  {"bg-yellow-600"},
	"indigo":  {"bg-indigo-600"},
	"purple":  {"bg-purple-600"},
	"pink":    {"bg-pink-600"},
	"default": {"bg-blue-600"},
}

// Progress background color schemes
var progressBgColorSchemes = map[string][]string{
	"blue":    {"bg-blue-200", "dark:bg-blue-700"},
	"gray":    {"bg-gray-200", "dark:bg-gray-700"},
	"red":     {"bg-red-200", "dark:bg-red-700"},
	"green":   {"bg-green-200", "dark:bg-green-700"},
	"yellow":  {"bg-yellow-200", "dark:bg-yellow-700"},
	"indigo":  {"bg-indigo-200", "dark:bg-indigo-700"},
	"purple":  {"bg-purple-200", "dark:bg-purple-700"},
	"pink":    {"bg-pink-200", "dark:bg-pink-700"},
	"default": {"bg-gray-200", "dark:bg-gray-700"},
}

// Progress size dimensions
var progressDimensions = map[Size][]string{
	SizeSM: {"h-1.5"},
	SizeMD: {"h-2.5"},
	SizeLG: {"h-4"},
}

// Progress label text sizes
var progressLabelSizes = map[Size][]string{
	SizeSM: {"text-xs"},
	SizeMD: {"text-sm"},
	SizeLG: {"text-base"},
}

// Progress variant styles
var progressVariants = map[string][]string{
	"default": {"rounded-full"},
	"square":  {"rounded-none"},
	"rounded": {"rounded-lg"},
}

// Progress base classes
const (
	progressBaseClasses     = "w-full overflow-hidden"
	progressBarClasses      = "h-full transition-all duration-300 ease-out"
	progressStripedClasses  = "bg-stripes bg-stripes-white"
	progressAnimatedClasses = "animate-stripes"
	progressLabelClasses    = "flex justify-between items-center mb-1 font-medium"
	progressPercentClasses  = "text-sm font-medium"
)

// ProgressProps defines properties for Progress components.
type ProgressProps struct {
	BaseProps
	AccessibilityProps
	AlpinEventHandlers

	// Progress attributes
	Value float64 `json:"value,omitempty"` // Current progress value
	Max   float64 `json:"max,omitempty"`   // Maximum progress value
	Min   float64 `json:"min,omitempty"`   // Minimum progress value

	// Progress content
	Label       string `json:"label,omitempty"`       // Progress label
	Description string `json:"description,omitempty"` // Progress description

	// Progress styling
	Variant       Variant       `json:"variant,omitempty"`       // Progress variant
	Size          Size          `json:"size,omitempty"`          // Progress size
	Color         ColorScheme   `json:"color,omitempty"`         // Progress color
	LabelPosition LabelPosition `json:"labelPosition,omitempty"` // Label position
	ShowPercent   bool          `json:"showPercent,omitempty"`   // Show percentage text
	ShowValue     bool          `json:"showValue,omitempty"`     // Show current value
	Animated      bool          `json:"animated,omitempty"`      // Animated progress
	Striped       bool          `json:"striped,omitempty"`       // Striped pattern
}

// ============================================================================
// CONSTRUCTOR WITH SENSIBLE DEFAULTS
// ============================================================================

// NewProgress creates a new ProgressProps with sensible defaults
// Example usage:
// progress := NewProgress("Loading", 45)
// progress.Color = "blue"
// progress.Animated = true
func NewProgress(label string, value float64) ProgressProps {
	return ProgressProps{
		Label:         label,
		Value:         value,
		Max:           100,
		Min:           0,
		Color:         "default",
		Variant:       "default",
		Size:          SizeMD,
		LabelPosition: LabelTop,
	}
}

// NewProgressWithRange creates a progress with custom min/max values
func NewProgressWithRange(label string, value, min, max float64) ProgressProps {
	props := NewProgress(label, value)
	props.Min = min
	props.Max = max
	return props
}

// NewIndeterminateProgress creates an indeterminate/loading progress
func NewIndeterminateProgress(label string) ProgressProps {
	return ProgressProps{
		Label:         label,
		Value:         0,
		Max:           100,
		Min:           0,
		Color:         "default",
		Variant:       "default",
		Size:          SizeMD,
		Striped:       true,
		Animated:      true,
		LabelPosition: LabelTop,
	}
}

// ============================================================================
// TEMPLATE COMPONENTS
// ============================================================================

// Progress renders a fully-featured progress bar with Flowbite styling
// Supports various colors, variants, sizes, and animation features
templ Progress(props ProgressProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getProgressWrapperClasses(props) }
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		if props.AriaDescribedBy != "" {
			aria-describedby={ props.AriaDescribedBy }
		}
		if props.DataTestID != "" {
			data-testid={ props.DataTestID }
		}
		if props.OnClick != "" {
			x-on:click={ props.OnClick }
		}
	>
		if props.LabelPosition != LabelNone && (props.Label != "" || props.ShowPercent) {
			<div class={ progressLabelClasses }>
				if props.Label != "" {
					<span class={ getProgressLabelClasses(props) }>{ props.Label }</span>
				}
				if props.ShowPercent {
					<span class={ getProgressPercentClasses(props) }>{ getPercentageText(props) }</span>
				}
			</div>
		}
		<div
			class={ getProgressContainerClasses(props) }
			role="progressbar"
			aria-valuenow={ strconv.FormatFloat(props.Value, 'f', -1, 64) }
			aria-valuemin={ strconv.FormatFloat(props.Min, 'f', -1, 64) }
			aria-valuemax={ strconv.FormatFloat(props.Max, 'f', -1, 64) }
		>
			<div class={ getProgressBarClasses(props) } style={ getProgressBarStyle(props) }></div>
		</div>
	</div>
}

// ============================================================================
// HELPER FUNCTIONS - Generate CSS classes based on props and state
// ============================================================================

// getProgressWrapperClasses returns classes for the outer container
func getProgressWrapperClasses(props ProgressProps) string {
	classes := []string{}

	// Allow custom classes to be added
	if props.Class != "" {
		classes = append(classes, props.Class)
	}

	return strings.Join(classes, " ")
}

// getProgressLabelClasses generates label classes based on size
func getProgressLabelClasses(props ProgressProps) string {
	classes := []string{"text-gray-700", "dark:text-gray-300"}

	// Add size-appropriate text class
	if textSize, ok := progressLabelSizes[props.Size]; ok {
		classes = append(classes, textSize...)
	}

	return strings.Join(classes, " ")
}

// getProgressPercentClasses generates percentage text classes
func getProgressPercentClasses(props ProgressProps) string {
	classes := []string{progressPercentClasses, "text-gray-700", "dark:text-gray-300"}

	return strings.Join(classes, " ")
}

// getProgressContainerClasses generates the progress container classes
func getProgressContainerClasses(props ProgressProps) string {
	classes := []string{progressBaseClasses}

	// Add size-specific dimensions from configuration
	if dimensions, ok := progressDimensions[props.Size]; ok {
		classes = append(classes, dimensions...)
	}

	// Add variant-specific styling from configuration
	if variants, ok := progressVariants[string(props.Variant)]; ok {
		classes = append(classes, variants...)
	}

	// Add background color scheme
	if colors, ok := progressBgColorSchemes[string(props.Color)]; ok {
		classes = append(classes, colors...)
	} else if colors, ok := progressBgColorSchemes["default"]; ok {
		classes = append(classes, colors...)
	}

	return strings.Join(classes, " ")
}

// getProgressBarClasses generates the progress bar fill classes
func getProgressBarClasses(props ProgressProps) string {
	classes := []string{progressBarClasses}

	// Add color scheme from configuration
	if colors, ok := progressColorSchemes[string(props.Color)]; ok {
		classes = append(classes, colors...)
	} else if colors, ok := progressColorSchemes["default"]; ok {
		classes = append(classes, colors...)
	}

	// Add striped pattern
	if props.Striped {
		classes = append(classes, progressStripedClasses)
	}

	// Add animation
	if props.Animated && props.Striped {
		classes = append(classes, progressAnimatedClasses)
	}

	return strings.Join(classes, " ")
}

// getProgressBarStyle generates the inline style for progress width
func getProgressBarStyle(props ProgressProps) string {
	// Calculate percentage
	percentage := ((props.Value - props.Min) / (props.Max - props.Min)) * 100

	// Clamp between 0 and 100
	if percentage < 0 {
		percentage = 0
	} else if percentage > 100 {
		percentage = 100
	}

	return "width: " + strconv.FormatFloat(percentage, 'f', 1, 64) + "%"
}

// getPercentageText returns formatted percentage text
func getPercentageText(props ProgressProps) string {
	percentage := ((props.Value - props.Min) / (props.Max - props.Min)) * 100

	// Clamp between 0 and 100
	if percentage < 0 {
		percentage = 0
	} else if percentage > 100 {
		percentage = 100
	}

	return strconv.FormatFloat(percentage, 'f', 0, 64) + "%"
}

// ============================================================================
// UTILITY FUNCTIONS FOR COMMON PATTERNS
// ============================================================================

// WithColor returns a new ProgressProps with color set
func (p ProgressProps) WithColor(color string) ProgressProps {
	p.Color = ColorScheme(color)
	return p
}

// WithVariant returns a new ProgressProps with variant set
func (p ProgressProps) WithVariant(variant string) ProgressProps {
	p.Variant = Variant(variant)
	return p
}

// WithValue returns a new ProgressProps with value set
func (p ProgressProps) WithValue(value float64) ProgressProps {
	p.Value = value
	return p
}

// AsStriped returns a new ProgressProps with striped pattern
func (p ProgressProps) AsStriped() ProgressProps {
	p.Striped = true
	return p
}

// AsAnimated returns a new ProgressProps with animation
func (p ProgressProps) AsAnimated() ProgressProps {
	p.Animated = true
	p.Striped = true // Animation requires stripes
	return p
}

// WithPercent returns a new ProgressProps with percentage display
func (p ProgressProps) WithPercent() ProgressProps {
	p.ShowPercent = true
	return p
}

// AsSquare returns a new ProgressProps with square variant
func (p ProgressProps) AsSquare() ProgressProps {
	p.Variant = Variant("square")
	return p
}

// AsRounded returns a new ProgressProps with rounded variant
func (p ProgressProps) AsRounded() ProgressProps {
	p.Variant = Variant("rounded")
	return p
}

// WithRange returns a new ProgressProps with custom min/max values
func (p ProgressProps) WithRange(min, max float64) ProgressProps {
	p.Min = min
	p.Max = max
	return p
}
