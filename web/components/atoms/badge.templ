package atoms

import (
	"strings"
)

// ============================================================================
// DESIGN RATIONALE - BADGE COMPONENT
// ============================================================================
// Following the composition-based architecture established in checkbox.templ:
//
// 1. REUSABLE STRUCTS: Uses shared BaseProps, AccessibilityProps, etc.
// 2. CONFIGURATION-DRIVEN: Color schemes, variants, icon support
// 3. ALPINE.JS INTEGRATION: Event handling for interactive badges
// 4. ACCESSIBILITY: Screen reader support and semantic HTML
// 5. FLEXIBLE VARIANTS: Normal, pill, outlined, with icons/dots
// 6. SEMANTIC COLORS: Status-aware color schemes for different contexts
// ============================================================================

// BadgeProps is defined in probs.go to avoid duplication

// ============================================================================
// CONFIGURATION CONSTANTS
// ============================================================================

// Badge color schemes
var badgeColorSchemes = map[string][]string{
	"blue":    {"bg-blue-100", "text-blue-800", "dark:bg-blue-900", "dark:text-blue-300"},
	"gray":    {"bg-gray-100", "text-gray-800", "dark:bg-gray-700", "dark:text-gray-300"},
	"red":     {"bg-red-100", "text-red-800", "dark:bg-red-900", "dark:text-red-300"},
	"green":   {"bg-green-100", "text-green-800", "dark:bg-green-900", "dark:text-green-300"},
	"yellow":  {"bg-yellow-100", "text-yellow-800", "dark:bg-yellow-900", "dark:text-yellow-300"},
	"indigo":  {"bg-indigo-100", "text-indigo-800", "dark:bg-indigo-900", "dark:text-indigo-300"},
	"purple":  {"bg-purple-100", "text-purple-800", "dark:bg-purple-900", "dark:text-purple-300"},
	"pink":    {"bg-pink-100", "text-pink-800", "dark:bg-pink-900", "dark:text-pink-300"},
	"default": {"bg-blue-100", "text-blue-800", "dark:bg-blue-900", "dark:text-blue-300"},
}

// Badge outlined color schemes
var badgeOutlinedColorSchemes = map[string][]string{
	"blue":    {"text-blue-800", "border-blue-800", "dark:text-blue-400", "dark:border-blue-400"},
	"gray":    {"text-gray-800", "border-gray-800", "dark:text-gray-400", "dark:border-gray-400"},
	"red":     {"text-red-800", "border-red-800", "dark:text-red-400", "dark:border-red-400"},
	"green":   {"text-green-800", "border-green-800", "dark:text-green-400", "dark:border-green-400"},
	"yellow":  {"text-yellow-800", "border-yellow-800", "dark:text-yellow-400", "dark:border-yellow-400"},
	"indigo":  {"text-indigo-800", "border-indigo-800", "dark:text-indigo-400", "dark:border-indigo-400"},
	"purple":  {"text-purple-800", "border-purple-800", "dark:text-purple-400", "dark:border-purple-400"},
	"pink":    {"text-pink-800", "border-pink-800", "dark:text-pink-400", "dark:border-pink-400"},
	"default": {"text-blue-800", "border-blue-800", "dark:text-blue-400", "dark:border-blue-400"},
}

// Badge size dimensions
var badgeDimensions = map[Size][]string{
	SizeSM: {"text-xs", "px-2.5", "py-0.5"},
	SizeMD: {"text-sm", "px-3", "py-1"},
	SizeLG: {"text-base", "px-4", "py-1.5"},
}

// Badge variant styles
var badgeVariants = map[string][]string{
	"default":  {"rounded"},
	"pill":     {"rounded-full"},
	"outlined": {"border", "bg-transparent"},
	"dot":      {"w-3", "h-3", "rounded-full", "p-0"},
}

// Badge base classes
const (
	badgeBaseClasses      = "inline-flex items-center font-medium"
	badgeCloseClasses     = "inline-flex items-center p-1 ms-2 text-sm bg-transparent rounded-sm hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-gray-300"
	badgeIconClasses      = "w-2.5 h-2.5 me-1"
	badgeDismissibleSpace = "me-2"
)

// Close icon SVG
const badgeCloseIcon = `<svg class="w-2 h-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/></svg>`

// ============================================================================
// CONSTRUCTOR WITH SENSIBLE DEFAULTS
// ============================================================================

// NewBadge creates a new BadgeProps with sensible defaults
// Example usage:
// badge := NewBadge("New")
// badge.Color = "green"
// badge.Variant = "pill"
func NewBadge(text string) BadgeProps {
	return BadgeProps{
		Text:          text,
		Color:         "default",
		Variant:       "default",
		ComponentSize: SizeSM,
	}
}

// NewBadgeWithColor creates a badge with specified color
func NewBadgeWithColor(text string, color ColorScheme) BadgeProps {
	props := NewBadge(text)
	props.Color = color
	return props
}

// NewDotBadge creates a dot indicator badge
func NewDotBadge(color ColorScheme) BadgeProps {
	return BadgeProps{
		Color:         color,
		Variant:       "default",
		ComponentSize: SizeSM,
		Dot:           true,
	}
}

// ============================================================================
// TEMPLATE COMPONENTS
// ============================================================================

// Badge renders a fully-featured badge with Flowbite styling
// Supports various colors, variants, sizes, and interactive features
templ Badge(props BadgeProps) {
	if props.Dot {
		<span
			if props.ID != "" {
				id={ props.ID }
			}
			class={ getDotBadgeClasses(props) }
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			}
			if props.AriaDescribedBy != "" {
				aria-describedby={ props.AriaDescribedBy }
			}
			if props.DataTestID != "" {
				data-testid={ props.DataTestID }
			}
			if props.OnClick != "" {
				x-on:click={ props.OnClick }
			}
		></span>
	} else {
		<span
			if props.ID != "" {
				id={ props.ID }
			}
			class={ getBadgeClasses(props) }
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			}
			if props.AriaDescribedBy != "" {
				aria-describedby={ props.AriaDescribedBy }
			}
			if props.DataTestID != "" {
				data-testid={ props.DataTestID }
			}
			if props.OnClick != "" {
				x-on:click={ props.OnClick }
			}
		>
			if props.Icon != "" {
				<span class={ badgeIconClasses }>
					@templ.Raw(props.Icon)
				</span>
			}
			{ props.Text }
			if props.Dismissible {
				<button
					type="button"
					class={ badgeCloseClasses }
					if props.AriaLabel != "" {
						aria-label={ "Remove " + props.AriaLabel + " badge" }
					} else {
						aria-label="Remove badge"
					}
					if props.OnClick != "" {
						x-on:click={ props.OnClick }
					}
				>
					@templ.Raw(badgeCloseIcon)
					<span class="sr-only">Remove badge</span>
				</button>
			}
		</span>
	}
}

// ============================================================================
// HELPER FUNCTIONS - Generate CSS classes based on props and state
// ============================================================================

// getBadgeClasses generates the main badge element classes
func getBadgeClasses(props BadgeProps) string {
	classes := []string{badgeBaseClasses}

	// Add size-specific dimensions from configuration
	if dimensions, ok := badgeDimensions[props.ComponentSize]; ok {
		classes = append(classes, dimensions...)
	}

	// Add variant-specific styling from configuration
	if variants, ok := badgeVariants[string(props.Variant)]; ok {
		classes = append(classes, variants...)
	}

	// Add color scheme based on variant
	if props.Variant == "outlined" {
		if colors, ok := badgeOutlinedColorSchemes[string(props.Color)]; ok {
			classes = append(classes, colors...)
		} else if colors, ok := badgeOutlinedColorSchemes["default"]; ok {
			classes = append(classes, colors...)
		}
	} else {
		if colors, ok := badgeColorSchemes[string(props.Color)]; ok {
			classes = append(classes, colors...)
		} else if colors, ok := badgeColorSchemes["default"]; ok {
			classes = append(classes, colors...)
		}
	}

	// Allow custom classes to be added
	if props.Class != "" {
		classes = append(classes, props.Class)
	}

	return strings.Join(classes, " ")
}

// getDotBadgeClasses generates classes for dot indicator badges
func getDotBadgeClasses(props BadgeProps) string {
	classes := []string{}

	// Add dot variant styling
	if variants, ok := badgeVariants["dot"]; ok {
		classes = append(classes, variants...)
	}

	// Add color scheme (use solid colors for dots)
	if colors, ok := badgeColorSchemes[string(props.Color)]; ok {
		// Extract background color from the scheme
		for _, class := range colors {
			if strings.HasPrefix(class, "bg-") {
				classes = append(classes, class)
				break
			}
		}
	}

	// Allow custom classes to be added
	if props.Class != "" {
		classes = append(classes, props.Class)
	}

	return strings.Join(classes, " ")
}

// ============================================================================
// UTILITY FUNCTIONS FOR COMMON PATTERNS
// ============================================================================

// WithColor returns a new BadgeProps with color set
func (p BadgeProps) WithColor(color ColorScheme) BadgeProps {
	p.Color = color
	return p
}

// WithVariant returns a new BadgeProps with variant set
func (p BadgeProps) WithVariant(variant Variant) BadgeProps {
	p.Variant = variant
	return p
}

// WithIcon returns a new BadgeProps with icon set
func (p BadgeProps) WithIcon(iconSVG string) BadgeProps {
	p.Icon = iconSVG
	return p
}

// AsDismissible returns a new BadgeProps with dismissible close button
func (p BadgeProps) AsDismissible() BadgeProps {
	p.Dismissible = true
	return p
}

// AsPill returns a new BadgeProps with pill variant
func (p BadgeProps) AsPill() BadgeProps {
	p.Variant = "pill" // Use string literal since pill is not in Variant constants
	return p
}

// AsOutlined returns a new BadgeProps with outlined variant
func (p BadgeProps) AsOutlined() BadgeProps {
	p.Variant = VariantOutlined
	return p
}

// AsDot returns a new BadgeProps configured as dot indicator
func (p BadgeProps) AsDot() BadgeProps {
	p.Dot = true
	p.Text = "" // Dots don't have text
	return p
}