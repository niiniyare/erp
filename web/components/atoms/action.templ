package atoms

import (
	"strconv"
)

// ============================================================================
// DESIGN RATIONALE - ACTION COMPONENT
// ============================================================================
// Following the composition-based architecture established in checkbox.templ:
//
// 1. REUSABLE STRUCTS: Uses shared BaseProps, AccessibilityProps
// 2. CONFIGURATION-DRIVEN: Different action types and execution modes
// 3. ALPINE.JS INTEGRATION: Seamless e.js action handling
// 4. COMMAND PATTERNS: Support for various command execution patterns
// 5. ACCESSIBILITY: Proper ARIA attributes for screen readers
// 6. SECURITY: Safe action execution with validation
// ============================================================================

// ============================================================================
// CONFIGURATION CONSTANTS
// ============================================================================

// Action type configurations
const (
	ActionTypeClick    = "click"    // Simple click action
	ActionTypeSubmit   = "submit"   // Form submission
	ActionTypeToggle   = "toggle"   // Toggle state
	ActionTypeConfirm  = "confirm"  // Confirmation dialog
	ActionTypeNavigate = "navigate" // Navigation action
	ActionTypeApi      = "api"      // API call
	ActionTypeCustom   = "custom"   // Custom e.js code
)

// Action execution modes
const (
	ExecutionModeImmediate = "immediate" // Execute immediately
	ExecutionModeDeferred  = "deferred"  // Execute after delay
	ExecutionModeConfirm   = "confirm"   // Require confirmation
	ExecutionModeThrottle  = "throttle"  // Throttle execution
	ExecutionModeDebounce  = "debounce"  // Debounce execution
)

// Action variant configurations for different contexts
var actionVariantClasses = map[Variant][]string{
	VariantDefault: {
		"inline-flex", "items-center", "justify-center",
		"text-sm", "font-medium", "text-gray-700", "dark:text-gray-300",
		"hover:text-gray-900", "dark:hover:text-white",
		"focus:outline-none", "focus:ring-2", "focus:ring-blue-500",
		"transition-colors", "duration-200",
	},
	VariantGhost: {
		"inline-flex", "items-center", "justify-center",
		"text-sm", "font-medium", "text-gray-500", "dark:text-gray-400",
		"hover:text-gray-700", "dark:hover:text-gray-200",
		"hover:bg-gray-100", "dark:hover:bg-gray-700",
		"focus:outline-none", "focus:ring-2", "focus:ring-blue-500",
		"rounded-md", "p-2", "transition-all", "duration-200",
	},
	VariantSolid: {
		"inline-flex", "items-center", "justify-center",
		"text-sm", "font-medium", "text-white",
		"bg-blue-600", "hover:bg-blue-700",
		"focus:outline-none", "focus:ring-2", "focus:ring-blue-500",
		"rounded-md", "px-3", "py-2", "transition-all", "duration-200",
	},
}

// Base action classes
const (
	actionBaseClasses = "cursor-pointer select-none"
	actionDisabledClasses = "opacity-50 cursor-not-allowed pointer-events-none"
	actionLoadingClasses = "opacity-75 cursor-wait"
)

// ============================================================================
// CONSTRUCTOR WITH SENSIBLE DEFAULTS
// ============================================================================

// NewAction creates a new ActionProps with sensible defaults
// Example usage:
// action := NewAction(ActionTypeClick, "alert('Hello!')")
// action.Label = "Say Hello"
func NewAction(actionType, command string) ActionProps {
	return ActionProps{
		BaseProps: BaseProps{
			ID: GenerateID("action"),
		},
		ActionType:     actionType,
		Command:        command,
		Variant:        VariantDefault,
		Size:           SizeMD,
		ExecutionMode:  ExecutionModeImmediate,
		Element:        "button",
	}
}

// NewClickAction creates an action for click events
func NewClickAction(command string) ActionProps {
	action := NewAction(ActionTypeClick, command)
	action.Element = "button"
	action.Type = "button"
	return action
}

// NewSubmitAction creates an action for form submission
func NewSubmitAction(command string) ActionProps {
	action := NewAction(ActionTypeSubmit, command)
	action.Element = "button"
	action.Type = "submit"
	return action
}

// NewToggleAction creates an action for toggling state
func NewToggleAction(target string) ActionProps {
	command := target + " = !" + target
	action := NewAction(ActionTypeToggle, command)
	action.Element = "button"
	action.Type = "button"
	return action
}

// NewConfirmAction creates an action that requires confirmation
func NewConfirmAction(message, command string) ActionProps {
	confirmCommand := "if (confirm('" + message + "')) { " + command + " }"
	action := NewAction(ActionTypeConfirm, confirmCommand)
	action.ExecutionMode = ExecutionModeConfirm
	action.ConfirmMessage = message
	return action
}

// NewNavigateAction creates an action for navigation
func NewNavigateAction(url string) ActionProps {
	command := "window.location.href = '" + url + "'"
	action := NewAction(ActionTypeNavigate, command)
	action.URL = url
	return action
}

// NewApiAction creates an action for API calls
func NewApiAction(endpoint, method string) ActionProps {
	command := "fetch('" + endpoint + "', { method: '" + method + "' })"
	action := NewAction(ActionTypeApi, command)
	action.ApiEndpoint = endpoint
	action.ApiMethod = method
	return action
}

// ============================================================================
// TEMPLATE COMPONENTS
// ============================================================================

// Action renders an interactive action element with proper event handling
// Supports different action types, execution modes, and accessibility features
templ Action(props ActionProps) {
	switch props.Element {
	case "a":
		<a { actionAttributes(props)... }>
			@actionContent(props)
		</a>
	case "div":
		<div { actionAttributes(props)... }>
			@actionContent(props)
		</div>
	case "span":
		<span { actionAttributes(props)... }>
			@actionContent(props)
		</span>
	default: // button
		<button { actionAttributes(props)... }>
			@actionContent(props)
		</button>
	}
}

// actionContent renders the inner content of the action element
templ actionContent(props ActionProps) {
	// Loading state
	if props.Loading {
		@actionLoadingContent(props)
	} else {
		// Icon (left position)
		if props.Icon.Name != "" && props.Icon.Position == IconLeft {
			@Icon(props.Icon.WithSize(getActionIconSize(props.Size)))
		}
		
		// Label text
		if props.Label != "" {
			<span>{ props.Label }</span>
		}
		
		// Icon (right position)
		if props.Icon.Name != "" && props.Icon.Position == IconRight {
			@Icon(props.Icon.WithSize(getActionIconSize(props.Size)))
		}
		
		// Children content
		if props.Children != nil {
			for _, child := range props.Children {
				@child
			}
		}
	}
}

// actionLoadingContent renders loading state content
templ actionLoadingContent(props ActionProps) {
	<span class="flex items-center gap-2">
		@Icon(IconProps{
			Name: "spinner",
			Size: getActionIconSize(props.Size),
			Class: "animate-spin",
		})
		if props.LoadingText != "" {
			<span>{ props.LoadingText }</span>
		} else if props.Label != "" {
			<span>{ props.Label }</span>
		}
	</span>
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// actionAttributes returns a map of HTML attributes for the action element
func actionAttributes(props ActionProps) templ.Attributes {
	attrs := templ.Attributes{}
	
	// ID
	if props.GetID("action") != "" {
		attrs["id"] = props.GetID("action")
	}
	
	// Classes
	attrs["class"] = getActionClasses(props)
	
	// Type (for button elements)
	if props.Element == "button" || props.Element == "" {
		if props.Type != "" {
			attrs["type"] = props.Type
		} else {
			attrs["type"] = "button"
		}
	}
	
	// Href (for anchor elements)
	if props.Element == "a" && props.URL != "" {
		attrs["href"] = props.URL
	}
	
	// Target (for links)
	if props.Target != "" {
		attrs["target"] = props.Target
	}
	
	// Disabled state
	if props.Disabled || props.Loading {
		if props.Element == "button" {
			attrs["disabled"] = "true"
		}
	}
	
	// ARIA attributes
	if props.AriaLabel != "" {
		attrs["aria-label"] = props.AriaLabel
	}
	if props.AriaDescribedBy != "" {
		attrs["aria-describedby"] = props.AriaDescribedBy
	}
	if props.AriaExpanded != nil {
		attrs["aria-expanded"] = strconv.FormatBool(*props.AriaExpanded)
	}
	if props.AriaControls != "" {
		attrs["aria-controls"] = props.AriaControls
	}
	if props.Role != "" {
		attrs["role"] = props.Role
	}
	if props.AriaPressed != nil {
		attrs["aria-pressed"] = strconv.FormatBool(*props.AriaPressed)
	}
	
	// Data attributes
	if props.DataTestID != "" {
		attrs["data-testid"] = props.DataTestID
	}
	
	// Tab index
	if props.TabIndex != 0 {
		attrs["tabindex"] = strconv.Itoa(props.TabIndex)
	}
	
	// e.js events
	if props.Command != "" && !props.Disabled && !props.Loading {
		eventHandler := getEventHandler(props)
		attrs[getEventAttribute(props.ActionType)] = eventHandler
	}
	
	return attrs
}

// getActionClasses generates all action classes based on props
func getActionClasses(props ActionProps) string {
	classes := []string{actionBaseClasses}
	
	// Add variant classes
	if variantClasses, ok := actionVariantClasses[props.Variant]; ok {
		classes = append(classes, variantClasses...)
	}
	
	// Add size classes
	classes = append(classes, GetActionSizeClasses(props.Size)...)
	
	// Add state classes
	if props.Disabled {
		classes = append(classes, actionDisabledClasses)
	}
	if props.Loading {
		classes = append(classes, actionLoadingClasses)
	}
	
	// Add icon spacing
	if props.Icon.Name != "" {
		classes = append(classes, "gap-2")
	}
	
	// Add custom classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}
	
	return JoinClasses(classes...)
}

// getEventAttribute returns the appropriate event attribute name
func getEventAttribute(actionType string) string {
	switch actionType {
	case ActionTypeSubmit:
		return "x-on:click"
	default:
		return "x-on:click"
	}
}

// getEventHandler returns the e.js event handler code
func getEventHandler(props ActionProps) string {
	command := props.Command
	
	// Add execution mode handling
	switch props.ExecutionMode {
	case ExecutionModeDeferred:
		if props.Delay > 0 {
			command = "setTimeout(() => { " + command + " }, " + strconv.Itoa(props.Delay) + ")"
		}
	case ExecutionModeThrottle:
		if props.ThrottleMs > 0 {
			command = "$throttle(" + command + ", " + strconv.Itoa(props.ThrottleMs) + ")"
		}
	case ExecutionModeDebounce:
		if props.DebounceMs > 0 {
			command = "$debounce(" + command + ", " + strconv.Itoa(props.DebounceMs) + ")"
		}
	}
	
	return command
}

// getActionIconSize returns appropriate icon size for action size
func getActionIconSize(size Size) Size {
	switch size {
	case SizeXS:
		return SizeXS
	case SizeSM:
		return SizeSM
	case SizeLG:
		return SizeMD
	case SizeXL:
		return SizeLG
	default:
		return SizeSM
	}
}

// ============================================================================
// UTILITY FUNCTIONS FOR COMMON PATTERNS
// ============================================================================

// WithLabel returns a new ActionProps with specified label
func (p ActionProps) WithLabel(label string) ActionProps {
	p.Label = label
	return p
}

// WithCommand returns a new ActionProps with specified command
func (p ActionProps) WithCommand(command string) ActionProps {
	p.Command = command
	return p
}

// WithIcon returns a new ActionProps with specified icon
func (p ActionProps) WithIcon(iconName string, position IconPosition) ActionProps {
	p.Icon = IconProps{
		Name:     iconName,
		Position: position,
	}
	return p
}

// WithVariant returns a new ActionProps with specified variant
func (p ActionProps) WithVariant(variant Variant) ActionProps {
	p.Variant = variant
	return p
}

// WithSize returns a new ActionProps with specified size
func (p ActionProps) WithSize(size Size) ActionProps {
	p.Size = size
	return p
}

// WithExecutionMode returns a new ActionProps with specified execution mode
func (p ActionProps) WithExecutionMode(mode string) ActionProps {
	p.ExecutionMode = mode
	return p
}

// WithDelay returns a new ActionProps with deferred execution
func (p ActionProps) WithDelay(delayMs int) ActionProps {
	p.ExecutionMode = ExecutionModeDeferred
	p.Delay = delayMs
	return p
}

// WithThrottle returns a new ActionProps with throttled execution
func (p ActionProps) WithThrottle(throttleMs int) ActionProps {
	p.ExecutionMode = ExecutionModeThrottle
	p.ThrottleMs = throttleMs
	return p
}

// WithDebounce returns a new ActionProps with debounced execution
func (p ActionProps) WithDebounce(debounceMs int) ActionProps {
	p.ExecutionMode = ExecutionModeDebounce
	p.DebounceMs = debounceMs
	return p
}

// AsDisabled returns a new ActionProps marked as disabled
func (p ActionProps) AsDisabled() ActionProps {
	p.Disabled = true
	return p
}

// AsLoading returns a new ActionProps in loading state
func (p ActionProps) AsLoading(loadingText string) ActionProps {
	p.Loading = true
	p.LoadingText = loadingText
	return p
}

// AsAnchor returns a new ActionProps configured as an anchor element
func (p ActionProps) AsAnchor(url string) ActionProps {
	p.Element = "a"
	p.URL = url
	return p
}

// WithTarget returns a new ActionProps with specified link target
func (p ActionProps) WithTarget(target string) ActionProps {
	p.Target = target
	return p
}

// AsConfirmation returns a new ActionProps with confirmation dialog
func (p ActionProps) AsConfirmation(message string) ActionProps {
	p.ExecutionMode = ExecutionModeConfirm
	p.ConfirmMessage = message
	p.Command = "if (confirm('" + message + "')) { " + p.Command + " }"
	return p
}