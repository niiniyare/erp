package atoms

import (
	"fmt"
	"strconv"
	"strings"
)

// ============================================================================
// DESIGN RATIONALE - COLOR INPUT COMPONENT
// ============================================================================
// Following the composition-based architecture established in checkbox.templ:
//
// 1. REUSABLE STRUCTS: Uses shared BaseProps, ValidationProps
// 2. CONFIGURATION-DRIVEN: Different color input modes and formats
// 3. ALPINE.JS INTEGRATION: Real-time color preview and validation
// 4. COLOR FORMATS: Support for HEX, RGB, HSL, and named colors
// 5. ACCESSIBILITY: Proper color contrast and ARIA attributes
// 6. VISUAL PREVIEW: Built-in color preview with fallback
// ============================================================================

// ============================================================================
// CONFIGURATION CONSTANTS
// ============================================================================

// Color format types
const (
	ColorFormatHex   = "hex"   // #RRGGBB or #RGB
	ColorFormatRGB   = "rgb"   // rgb(r, g, b)
	ColorFormatHSL   = "hsl"   // hsl(h, s%, l%)
	ColorFormatNamed = "named" // CSS named colors
)

// Predefined color palette
var defaultColorPalette = []string{
	"#000000", "#FFFFFF", "#FF0000", "#00FF00", "#0000FF",
	"#FFFF00", "#FF00FF", "#00FFFF", "#FFA500", "#800080",
	"#FFC0CB", "#A52A2A", "#808080", "#008000", "#000080",
	"#FF69B4", "#DC143C", "#4B0082", "#32CD32", "#FFD700",
}

// Color input variant configurations
var colorInputVariantClasses = map[Variant][]string{
	VariantDefault: {
		"bg-gray-50", "border", "border-gray-300", "text-gray-900",
		"focus:ring-blue-500", "focus:border-blue-500",
		"dark:bg-gray-700", "dark:border-gray-600", "dark:text-white",
	},
	VariantOutlined: {
		"bg-transparent", "border", "border-gray-300", "text-gray-900",
		"focus:ring-blue-500", "focus:border-blue-500",
		"dark:border-gray-600", "dark:text-white",
	},
}

// Base color input classes
const (
	colorInputBaseClasses = "block w-full rounded-lg text-sm transition-colors duration-200"
	colorPreviewClasses = "w-8 h-8 rounded border border-gray-300 dark:border-gray-600 cursor-pointer transition-all duration-200 hover:scale-105"
	colorPaletteClasses = "grid grid-cols-5 gap-2 p-3 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-lg shadow-lg"
	colorPaletteItemClasses = "w-6 h-6 rounded cursor-pointer border border-gray-300 dark:border-gray-600 hover:scale-110 transition-transform duration-200"
)

// ============================================================================
// COLOR UTILITY FUNCTIONS
// ============================================================================

// ValidateHexColor validates a hex color string
func ValidateHexColor(color string) bool {
	if !strings.HasPrefix(color, "#") {
		return false
	}
	
	color = color[1:] // Remove #
	if len(color) != 3 && len(color) != 6 {
		return false
	}
	
	for _, char := range color {
		if !((char >= '0' && char <= '9') || (char >= 'a' && char <= 'f') || (char >= 'A' && char <= 'F')) {
			return false
		}
	}
	
	return true
}

// NormalizeHexColor is defined in util.go

// GetColorLuminance calculates the relative luminance of a hex color
func GetColorLuminance(hexColor string) float64 {
	if !ValidateHexColor(hexColor) {
		return 0.5 // Default to medium luminance
	}
	
	hex := hexColor[1:] // Remove #
	if len(hex) == 3 {
		hex = fmt.Sprintf("%c%c%c%c%c%c", hex[0], hex[0], hex[1], hex[1], hex[2], hex[2])
	}
	
	// Parse RGB values
	r, _ := strconv.ParseInt(hex[0:2], 16, 64)
	g, _ := strconv.ParseInt(hex[2:4], 16, 64)
	b, _ := strconv.ParseInt(hex[4:6], 16, 64)
	
	// Convert to relative luminance (simplified)
	return (0.299*float64(r) + 0.587*float64(g) + 0.114*float64(b)) / 255.0
}

// GetContrastTextColor returns black or white text color based on background
func GetContrastTextColor(bgColor string) string {
	luminance := GetColorLuminance(bgColor)
	if luminance > 0.5 {
		return "#000000"
	}
	return "#FFFFFF"
}

// ============================================================================
// CONSTRUCTOR WITH SENSIBLE DEFAULTS
// ============================================================================

// NewColorInput creates a new ColorInputProps with sensible defaults
// Example usage:
// colorInput := NewColorInput("background_color", "#3B82F6")
// colorInput.ShowPalette = true
func NewColorInput(name, value string) ColorInputProps {
	return ColorInputProps{
		BaseProps: BaseProps{
			ID:   GenerateID("color-input"),
			Name: name,
		},
		Value:       value,
		Variant:     VariantDefault,
		Size:        SizeMD,
		Format:      ColorFormatHex,
		ShowPreview: true,
		ValidationProps: ValidationProps{
			State: StateDefault,
		},
	}
}

// NewColorPicker creates a color input with palette picker
func NewColorPicker(name, value string) ColorInputProps {
	colorInput := NewColorInput(name, value)
	colorInput.ShowPalette = true
	colorInput.ShowPreview = true
	return colorInput
}

// NewColorSwatch creates a color input optimized for swatch selection
func NewColorSwatch(name, value string) ColorInputProps {
	colorInput := NewColorInput(name, value)
	colorInput.ShowPreview = true
	colorInput.ReadOnly = true
	colorInput.ShowPalette = true
	return colorInput
}

// ============================================================================
// TEMPLATE COMPONENTS
// ============================================================================

// ColorInput renders a color input with preview, validation, and optional palette
// Supports different color formats and provides real-time visual feedback
templ ColorInput(props ColorInputProps) {
	<div class={ getColorInputWrapperClasses(props) }>
		// Label
		if props.Label != "" {
			@colorInputLabel(props)
		}
		
		<div class="relative" x-data={ "{ showPalette: false, currentColor: '" + props.Value + "' }" }>
			// Input with color preview
			<div class="flex items-center gap-2">
				// Color preview box
				if props.ShowPreview {
					@colorPreview(props)
				}
				
				// Text input
				<input
					type="text"
					id={ props.GetID("color-input") }
					class={ getColorInputClasses(props) }
					if props.Name != "" {
						name={ props.Name }
					}
					x-model="currentColor"
					if props.Placeholder != "" {
						placeholder={ props.Placeholder }
					} else {
						placeholder="#000000"
					}
					if props.Required {
						required
					}
					if props.ReadOnly {
						readonly
					}
					if props.Disabled {
						disabled
					}
					if props.Format == ColorFormatHex {
						pattern="^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
					}
					if props.DataTestID != "" {
						data-testid={ props.DataTestID }
					}
					if props.AriaLabel != "" {
						aria-label={ props.AriaLabel }
					}
					if props.AriaDescribedBy != "" {
						aria-describedby={ props.AriaDescribedBy }
					}
					if props.TabIndex != 0 {
						tabindex={ strconv.Itoa(props.TabIndex) }
					}
					x-on:input="
						$el.setCustomValidity('');
						if ($el.value && !/^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$/.test($el.value)) {
							$el.setCustomValidity('Please enter a valid hex color (e.g., #FF0000)');
						}
					"
					if props.OnChange != "" {
						x-on:change={ props.OnChange }
					}
					if props.OnInput != "" {
						x-on:input={ props.OnInput }
					}
				/>
				
				// Palette toggle button
				if props.ShowPalette {
					@colorPaletteToggle(props)
				}
			</div>
			
			// Color palette dropdown
			if props.ShowPalette {
				@colorPalette(props)
			}
		</div>
		
		// Validation and help text
		@colorInputValidationText(props)
	</div>
}

// colorInputLabel renders the label for the color input
templ colorInputLabel(props ColorInputProps) {
	<label
		for={ props.GetID("color-input") }
		class="block text-sm font-medium text-gray-900 dark:text-white mb-2"
	>
		{ props.GetLabelText() }
		if props.Required {
			<span class="text-red-500 ml-1">*</span>
		}
	</label>
}

// colorPreview renders the color preview box
templ colorPreview(props ColorInputProps) {
	<div
		class={ colorPreviewClasses }
		x-bind:style="'background-color: ' + (currentColor || '#ffffff')"
		x-bind:title="'Current color: ' + (currentColor || 'None')"
		x-on:click="$refs.colorPicker?.click()"
		role="button"
		tabindex="0"
		aria-label="Color preview, click to open palette"
	>
		// Hidden native color input for fallback
		<input
			type="color"
			x-ref="colorPicker"
			class="sr-only"
			x-model="currentColor"
			aria-hidden="true"
		/>
	</div>
}

// colorPaletteToggle renders the button to toggle color palette
templ colorPaletteToggle(props ColorInputProps) {
	<button
		type="button"
		class="p-2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
		x-on:click="showPalette = !showPalette"
		aria-label="Toggle color palette"
		title="Show color palette"
	>
		@Icon(IconProps{
			Name: "palette",
			Size: SizeSM,
		})
	</button>
}

// colorPalette renders the color palette dropdown
templ colorPalette(props ColorInputProps) {
	<div
		x-show="showPalette"
		x-transition
		class="absolute top-full left-0 mt-2 z-50"
		x-on:click.away="showPalette = false"
	>
		<div class={ colorPaletteClasses }>
			for _, color := range defaultColorPalette {
				<button
					type="button"
					class={ colorPaletteItemClasses }
					style={ fmt.Sprintf("background-color: %s", color) }
					title={ color }
					aria-label={ fmt.Sprintf("Select color %s", color) }
					x-on:click={ fmt.Sprintf("currentColor = '%s'; showPalette = false", color) }
				></button>
			}
		</div>
	</div>
}

// colorInputValidationText renders validation messages and help text
templ colorInputValidationText(props ColorInputProps) {
	if props.ShowValidation || props.HelpText != "" {
		<div class="mt-2 text-sm">
			if props.ShowValidation {
				if msg, _ := props.GetFeedbackMessage(); msg != "" {
					<p class={ getValidationTextClasses(props.State) }>
						{ msg }
					</p>
				}
			}
			if !props.ShowValidation && props.HelpText != "" {
				<p class="text-gray-600 dark:text-gray-400">{ props.HelpText }</p>
			}
		</div>
	}
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// getColorInputWrapperClasses returns classes for the color input wrapper
func getColorInputWrapperClasses(props ColorInputProps) string {
	classes := []string{}
	
	// Add custom wrapper classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}
	
	return JoinClasses(classes...)
}

// getColorInputClasses generates input classes based on props
func getColorInputClasses(props ColorInputProps) string {
	classes := []string{colorInputBaseClasses, "flex-1"}
	
	// Add variant classes with state handling
	classes = append(classes, GetInputVariantClasses(props.Variant, props.State)...)
	
	// Add size classes
	classes = append(classes, GetInputSizeClasses(props.Size)...)
	
	return JoinClasses(classes...)
}

// ============================================================================
// UTILITY FUNCTIONS FOR COMMON PATTERNS
// ============================================================================

// WithValue returns a new ColorInputProps with specified value
func (p ColorInputProps) WithValue(value string) ColorInputProps {
	p.Value = NormalizeHexColor(value)
	return p
}

// WithLabel returns a new ColorInputProps with specified label
func (p ColorInputProps) WithLabel(label string) ColorInputProps {
	p.Label = label
	return p
}

// WithFormat returns a new ColorInputProps with specified format
func (p ColorInputProps) WithFormat(format string) ColorInputProps {
	p.Format = format
	return p
}

// WithPalette returns a new ColorInputProps with palette enabled
func (p ColorInputProps) WithPalette(show bool) ColorInputProps {
	p.ShowPalette = show
	return p
}

// WithPreview returns a new ColorInputProps with preview enabled
func (p ColorInputProps) WithPreview(show bool) ColorInputProps {
	p.ShowPreview = show
	return p
}

// AsRequired returns a new ColorInputProps marked as required
func (p ColorInputProps) AsRequired() ColorInputProps {
	p.Required = true
	return p
}

// AsReadonly returns a new ColorInputProps marked as readonly
func (p ColorInputProps) AsReadonly() ColorInputProps {
	p.ReadOnly = true
	return p
}

// WithSize returns a new ColorInputProps with specified size
func (p ColorInputProps) WithSize(size Size) ColorInputProps {
	p.Size = size
	return p
}

// WithVariant returns a new ColorInputProps with specified variant
func (p ColorInputProps) WithVariant(variant Variant) ColorInputProps {
	p.Variant = variant
	return p
}

// WithValidation returns a new ColorInputProps with validation state
func (p ColorInputProps) WithValidation(state ValidationState, message string) ColorInputProps {
	p.ValidationProps = NewValidationProps().WithState(state).Build()
	switch state {
	case StateError:
		p.ErrorText = message
	case StateSuccess:
		p.SuccessText = message
	case StateWarning:
		p.WarningText = message
	case StateInfo:
		p.InfoText = message
	}
	p.ShowValidation = true
	return p
}