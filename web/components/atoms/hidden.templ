package atoms

// ============================================================================
// DESIGN RATIONALE - HIDDEN INPUT COMPONENT
// ============================================================================
// Following the composition-based architecture established in checkbox.templ:
//
// 1. REUSABLE STRUCTS: Uses shared BaseProps for consistency
// 2. CONFIGURATION-DRIVEN: Simple hidden input with essential attributes
// 3. FORM INTEGRATION: Seamless integration with form systems
// 4. ACCESSIBILITY: Properly hidden from screen readers when appropriate
// 5. DATA ATTRIBUTES: Support for data attributes and tracking
// 6. MINIMAL FOOTPRINT: Lightweight component for hidden data
// ============================================================================

// ============================================================================
// CONSTRUCTOR WITH SENSIBLE DEFAULTS
// ============================================================================

// NewHidden creates a new HiddenProps with sensible defaults
// Example usage:
// hidden := NewHidden("csrf_token", "abc123...")
// hidden.DataTestID = "csrf-token"
func NewHidden(name, value string) HiddenProps {
	return HiddenProps{
		BaseProps: BaseProps{
			ID: GenerateID("hidden"),
		},
		Name:  name,
		Value: value,
	}
}

// NewCSRFToken creates a hidden input for CSRF tokens
func NewCSRFToken(token string) HiddenProps {
	hidden := NewHidden("_token", token)
	hidden.DataTestID = "csrf-token"
	return hidden
}

// NewFormMethod creates a hidden input for HTTP method override
func NewFormMethod(method string) HiddenProps {
	hidden := NewHidden("_method", method)
	hidden.DataTestID = "form-method"
	return hidden
}

// NewSessionID creates a hidden input for session tracking
func NewSessionID(sessionID string) HiddenProps {
	hidden := NewHidden("session_id", sessionID)
	hidden.DataTestID = "session-id"
	return hidden
}

// NewUserID creates a hidden input for user identification
func NewUserID(userID string) HiddenProps {
	hidden := NewHidden("user_id", userID)
	hidden.DataTestID = "user-id"
	return hidden
}

// ============================================================================
// TEMPLATE COMPONENTS
// ============================================================================

// Hidden renders a hidden input field for form data
// Used for security tokens, session data, and other hidden form values
templ Hidden(props HiddenProps) {
	<input
		type="hidden"
		if props.GetID("hidden") != "" {
			id={ props.GetID("hidden") }
		}
		if props.Name != "" {
			name={ props.Name }
		}
		if props.Value != "" {
			value={ props.Value }
		}
		if props.Form != "" {
			form={ props.Form }
		}
		if props.DataTestID != "" {
			data-testid={ props.DataTestID }
		}
		if props.Class != "" {
			class={ props.Class }
		}
	/>
}

// HiddenGroup renders multiple hidden inputs as a group
// Useful for rendering multiple related hidden values at once
templ HiddenGroup(hiddenInputs []HiddenProps) {
	for _, hidden := range hiddenInputs {
		@Hidden(hidden)
	}
}

// ============================================================================
// UTILITY FUNCTIONS FOR COMMON PATTERNS
// ============================================================================

// WithValue returns a new HiddenProps with specified value
func (p HiddenProps) WithValue(value string) HiddenProps {
	p.Value = value
	return p
}

// WithName returns a new HiddenProps with specified name
func (p HiddenProps) WithName(name string) HiddenProps {
	p.Name = name
	return p
}

// WithForm returns a new HiddenProps associated with a specific form
func (p HiddenProps) WithForm(formID string) HiddenProps {
	p.Form = formID
	return p
}

// WithTestID returns a new HiddenProps with test ID for automated testing
func (p HiddenProps) WithTestID(testID string) HiddenProps {
	p.DataTestID = testID
	return p
}

// AsRequired returns a new HiddenProps marked as required (for validation)
func (p HiddenProps) AsRequired() HiddenProps {
	p.Required = true
	return p
}

// ============================================================================
// HELPER FUNCTIONS FOR HIDDEN INPUT GROUPS
// ============================================================================

// CreateHiddenGroup creates a slice of HiddenProps from a map of name-value pairs
// Example usage:
// hiddens := CreateHiddenGroup(map[string]string{
//     "_token": "abc123",
//     "_method": "PUT",
//     "user_id": "456",
// })
func CreateHiddenGroup(values map[string]string) []HiddenProps {
	var hiddens []HiddenProps
	
	for name, value := range values {
		hiddens = append(hiddens, NewHidden(name, value))
	}
	
	return hiddens
}

// CreateSecurityTokens creates common security-related hidden inputs
func CreateSecurityTokens(csrfToken, sessionID string) []HiddenProps {
	return []HiddenProps{
		NewCSRFToken(csrfToken),
		NewSessionID(sessionID),
	}
}

// CreateFormOverrides creates hidden inputs for HTTP method and form overrides
func CreateFormOverrides(method string, formID string) []HiddenProps {
	var hiddens []HiddenProps
	
	if method != "" && method != "GET" && method != "POST" {
		hiddens = append(hiddens, NewFormMethod(method))
	}
	
	return hiddens
}

// ============================================================================
// VALIDATION HELPERS
// ============================================================================

// ValidateHiddenProps performs basic validation on hidden input properties
func ValidateHiddenProps(props HiddenProps) error {
	if props.Name == "" {
		return NewValidationError("Hidden input must have a name")
	}
	
	if props.Required && props.Value == "" {
		return NewValidationError("Required hidden input must have a value")
	}
	
	return nil
}

// NewValidationError creates a new validation error
func NewValidationError(message string) error {
	return &ValidationErrorType{Message: message}
}

// ValidationErrorType represents a validation error
type ValidationErrorType struct {
	Message string
}

// Error implements the error interface
func (e *ValidationErrorType) Error() string {
	return e.Message
}