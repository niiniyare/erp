package atoms

import (
	"context"
)

// Button renders a button using the self-contained CSS factory
templ Button(ctx context.Context, props ButtonProps) {
	<button
		if props.ID != "" {
			id={ props.ID }
		}
		style={ GetButtonCSS(props.Variant) }
		if props.ClassName != "" {
			class={ props.ClassName }
		}
		if props.Disabled {
			disabled
		}
		if props.TestID != "" {
			data-testid={ props.TestID }
		}
	>
		if props.Loading {
			<span class="loading-spinner"></span>
			Loading...
		} else {
			if props.Icon != "" {
				<i class={ "icon-" + props.Icon }></i>
			}
			{ GetButtonDisplayText(props) }
		}
	</button>
}

// ButtonFromSchema creates a Button component from JSON schema configuration
templ ButtonFromSchema(ctx context.Context, schemaConfig string) {
	<div>Placeholder for schema-based button</div>
}