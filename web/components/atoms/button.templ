package atoms

import "strings"

// ButtonVariant defines the visual style of the button
type ButtonVariant string

const (
	ButtonPrimary   ButtonVariant = "primary"
	ButtonSecondary ButtonVariant = "secondary" 
	ButtonDark      ButtonVariant = "dark"
	ButtonLight     ButtonVariant = "light"
	ButtonGreen     ButtonVariant = "green"
	ButtonRed       ButtonVariant = "red"
	ButtonYellow    ButtonVariant = "yellow"
	ButtonPurple    ButtonVariant = "purple"
	ButtonOutline   ButtonVariant = "outline"
	ButtonSuccess   ButtonVariant = "green"    // Alias for green
	ButtonDanger    ButtonVariant = "red"      // Alias for red 
	ButtonWarning   ButtonVariant = "yellow"   // Alias for yellow
	ButtonInfo      ButtonVariant = "purple"   // Alias for purple
	ButtonGhost     ButtonVariant = "outline"  // Alias for outline
)

// ButtonSize defines the size of the button
type ButtonSize string

const (
	ButtonSizeXS ButtonSize = "xs"
	ButtonSizeSM ButtonSize = "sm"
	ButtonSizeMD ButtonSize = "md"
	ButtonSizeLG ButtonSize = "lg"
	ButtonSizeXL ButtonSize = "xl"
)

// ButtonProps defines the properties for the Button component
type ButtonProps struct {
	// Content
	Text        string        `json:"text"`
	Icon        string        `json:"icon,omitempty"`
	IconPosition string       `json:"iconPosition,omitempty"` // "left" or "right"
	
	// Styling
	Variant     ButtonVariant `json:"variant"`
	Size        ButtonSize    `json:"size"`
	Pill        bool          `json:"pill,omitempty"`         // Rounded full
	Loading     bool          `json:"loading,omitempty"`
	
	// Behavior
	Type        string        `json:"type,omitempty"`         // "button", "submit", "reset"
	Disabled    bool          `json:"disabled,omitempty"`
	OnClick     string        `json:"onclick,omitempty"`      // Alpine.js click handler
	
	// HTMX attributes
	HxPost      string        `json:"hxPost,omitempty"`
	HxGet       string        `json:"hxGet,omitempty"`
	HxDelete    string        `json:"hxDelete,omitempty"`
	HxTarget    string        `json:"hxTarget,omitempty"`
	HxSwap      string        `json:"hxSwap,omitempty"`
	HxConfirm   string        `json:"hxConfirm,omitempty"`
	
	// Form attributes
	Form        string        `json:"form,omitempty"`
	AutoFocus   bool          `json:"autoFocus,omitempty"`
	
	// HTML attributes
	ID          string        `json:"id,omitempty"`
	Class       string        `json:"class,omitempty"`
	AriaLabel   string        `json:"ariaLabel,omitempty"`
	DataTestID  string        `json:"dataTestId,omitempty"`
}

// Button renders a Flowbite-styled button with various variants and behaviors
templ Button(props ButtonProps) {
	<button
		if props.ID != "" {
			id={ props.ID }
		}
		type={ getButtonType(props.Type) }
		class={ getButtonClasses(props) }
		if props.Disabled {
			disabled
		}
		if props.OnClick != "" {
			@click={ props.OnClick }
		}
		if props.HxPost != "" {
			hx-post={ props.HxPost }
		}
		if props.HxGet != "" {
			hx-get={ props.HxGet }
		}
		if props.HxDelete != "" {
			hx-delete={ props.HxDelete }
		}
		if props.HxTarget != "" {
			hx-target={ props.HxTarget }
		}
		if props.HxSwap != "" {
			hx-swap={ props.HxSwap }
		}
		if props.HxConfirm != "" {
			hx-confirm={ props.HxConfirm }
		}
		if props.Form != "" {
			form={ props.Form }
		}
		if props.AutoFocus {
			autofocus
		}
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		if props.DataTestID != "" {
			data-testid={ props.DataTestID }
		}
		if props.Loading {
			x-data="{ loading: true }"
			:disabled="loading"
		}
	>
		if props.Loading {
			<div class="flex items-center">
				@Spinner(SpinnerProps{Size: getButtonSpinnerSize(props.Size), Class: "me-2"})
				<span>Loading...</span>
			</div>
		} else {
			if props.Icon != "" && props.IconPosition != "right" {
				@Icon(IconProps{Name: props.Icon, Size: getIconSizeForButton(props.Size), Class: "me-2"})
			}
			if props.Text != "" {
				<span>{ props.Text }</span>
			}
			if props.Icon != "" && props.IconPosition == "right" {
				@Icon(IconProps{Name: props.Icon, Size: getIconSizeForButton(props.Size), Class: "ms-2"})
			}
		}
	</button>
}

// IconButton renders a button with only an icon (square button)
templ IconButton(props ButtonProps) {
	<button
		if props.ID != "" {
			id={ props.ID }
		}
		type={ getButtonType(props.Type) }
		class={ getIconButtonClasses(props) }
		if props.Disabled {
			disabled
		}
		if props.OnClick != "" {
			@click={ props.OnClick }
		}
		if props.HxPost != "" {
			hx-post={ props.HxPost }
		}
		if props.HxGet != "" {
			hx-get={ props.HxGet }
		}
		if props.HxTarget != "" {
			hx-target={ props.HxTarget }
		}
		if props.HxSwap != "" {
			hx-swap={ props.HxSwap }
		}
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		if props.DataTestID != "" {
			data-testid={ props.DataTestID }
		}
	>
		if props.Loading {
			@Spinner(SpinnerProps{Size: getButtonSpinnerSize(props.Size)})
		} else {
			@Icon(IconProps{Name: props.Icon, Size: getIconSizeForButton(props.Size)})
		}
	</button>
}

// LinkButton renders a button that looks like a link
templ LinkButton(props ButtonProps) {
	<button
		if props.ID != "" {
			id={ props.ID }
		}
		type={ getButtonType(props.Type) }
		class={ getLinkButtonClasses(props) }
		if props.Disabled {
			disabled
		}
		if props.OnClick != "" {
			@click={ props.OnClick }
		}
		if props.HxPost != "" {
			hx-post={ props.HxPost }
		}
		if props.HxGet != "" {
			hx-get={ props.HxGet }
		}
		if props.HxTarget != "" {
			hx-target={ props.HxTarget }
		}
		if props.HxSwap != "" {
			hx-swap={ props.HxSwap }
		}
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		if props.DataTestID != "" {
			data-testid={ props.DataTestID }
		}
	>
		if props.Icon != "" && props.IconPosition != "right" {
			@Icon(IconProps{Name: props.Icon, Size: "sm", Class: "me-1"})
		}
		{ props.Text }
		if props.Icon != "" && props.IconPosition == "right" {
			@Icon(IconProps{Name: props.Icon, Size: "sm", Class: "ms-1"})
		}
	</button>
}

// Helper functions
func getButtonType(buttonType string) string {
	if buttonType == "" {
		return "button"
	}
	return buttonType
}

func getButtonClasses(props ButtonProps) string {
	classes := []string{
		"font-medium",
		"focus:ring-4",
		"focus:outline-none",
		"text-center",
		"transition-colors",
		"duration-200",
	}
	
	// Add variant classes
	classes = append(classes, getVariantClasses(props.Variant)...)
	
	// Add size classes
	classes = append(classes, getSizeClasses(props.Size)...)
	
	// Add shape classes
	if props.Pill {
		classes = append(classes, "rounded-full")
	} else {
		classes = append(classes, "rounded-lg")
	}
	
	// Add disabled classes
	if props.Disabled {
		classes = append(classes, "opacity-50", "cursor-not-allowed")
	}
	
	// Add custom classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}
	
	return strings.Join(classes, " ")
}

func getIconButtonClasses(props ButtonProps) string {
	classes := []string{
		"inline-flex",
		"items-center",
		"justify-center",
		"font-medium",
		"focus:ring-4",
		"focus:outline-none",
		"transition-colors",
		"duration-200",
	}
	
	// Add variant classes
	classes = append(classes, getVariantClasses(props.Variant)...)
	
	// Add icon button specific size classes
	classes = append(classes, getIconButtonSizeClasses(props.Size)...)
	
	// Add shape classes
	if props.Pill {
		classes = append(classes, "rounded-full")
	} else {
		classes = append(classes, "rounded-lg")
	}
	
	// Add disabled classes
	if props.Disabled {
		classes = append(classes, "opacity-50", "cursor-not-allowed")
	}
	
	// Add custom classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}
	
	return strings.Join(classes, " ")
}

func getLinkButtonClasses(props ButtonProps) string {
	classes := []string{
		"inline-flex",
		"items-center",
		"font-medium",
		"text-blue-600",
		"hover:text-blue-800",
		"focus:outline-none",
		"focus:ring-2",
		"focus:ring-blue-300",
		"underline",
		"dark:text-blue-500",
		"dark:hover:text-blue-400",
		"transition-colors",
		"duration-200",
	}
	
	// Add size classes for link buttons
	switch props.Size {
	case ButtonSizeXS:
		classes = append(classes, "text-xs")
	case ButtonSizeSM:
		classes = append(classes, "text-sm")
	case ButtonSizeLG:
		classes = append(classes, "text-lg")
	case ButtonSizeXL:
		classes = append(classes, "text-xl")
	default:
		classes = append(classes, "text-sm")
	}
	
	// Add disabled classes
	if props.Disabled {
		classes = append(classes, "opacity-50", "cursor-not-allowed", "no-underline")
	}
	
	// Add custom classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}
	
	return strings.Join(classes, " ")
}

func getVariantClasses(variant ButtonVariant) []string {
	switch variant {
	case ButtonPrimary:
		return []string{
			"text-white",
			"bg-blue-700",
			"hover:bg-blue-800",
			"focus:ring-blue-300",
			"dark:bg-blue-600",
			"dark:hover:bg-blue-700",
			"dark:focus:ring-blue-800",
		}
	case ButtonSecondary:
		return []string{
			"text-gray-900",
			"bg-white",
			"border",
			"border-gray-200",
			"hover:bg-gray-100",
			"hover:text-blue-700",
			"focus:z-10",
			"focus:ring-gray-100",
			"dark:focus:ring-gray-700",
			"dark:bg-gray-800",
			"dark:text-gray-400",
			"dark:border-gray-600",
			"dark:hover:text-white",
			"dark:hover:bg-gray-700",
		}
	case ButtonDark:
		return []string{
			"text-white",
			"bg-gray-800",
			"hover:bg-gray-900",
			"focus:ring-gray-300",
			"dark:bg-gray-800",
			"dark:hover:bg-gray-700",
			"dark:focus:ring-gray-700",
			"dark:border-gray-700",
		}
	case ButtonLight:
		return []string{
			"text-gray-900",
			"bg-white",
			"border",
			"border-gray-300",
			"hover:bg-gray-100",
			"focus:ring-gray-100",
			"dark:bg-gray-800",
			"dark:text-white",
			"dark:border-gray-600",
			"dark:hover:bg-gray-700",
			"dark:hover:border-gray-600",
			"dark:focus:ring-gray-700",
		}
	case ButtonGreen:
		return []string{
			"text-white",
			"bg-green-700",
			"hover:bg-green-800",
			"focus:ring-green-300",
			"dark:bg-green-600",
			"dark:hover:bg-green-700",
			"dark:focus:ring-green-800",
		}
	case ButtonRed:
		return []string{
			"text-white",
			"bg-red-700",
			"hover:bg-red-800",
			"focus:ring-red-300",
			"dark:bg-red-600",
			"dark:hover:bg-red-700",
			"dark:focus:ring-red-900",
		}
	case ButtonYellow:
		return []string{
			"text-white",
			"bg-yellow-400",
			"hover:bg-yellow-500",
			"focus:ring-yellow-300",
			"dark:focus:ring-yellow-900",
		}
	case ButtonPurple:
		return []string{
			"text-white",
			"bg-purple-700",
			"hover:bg-purple-800",
			"focus:ring-purple-300",
			"dark:bg-purple-600",
			"dark:hover:bg-purple-700",
			"dark:focus:ring-purple-900",
		}
	case ButtonOutline:
		return []string{
			"text-blue-700",
			"border",
			"border-blue-700",
			"hover:bg-blue-700",
			"hover:text-white",
			"focus:ring-blue-300",
			"dark:border-blue-500",
			"dark:text-blue-500",
			"dark:hover:text-white",
			"dark:hover:bg-blue-500",
			"dark:focus:ring-blue-800",
		}
	default:
		return []string{
			"text-white",
			"bg-blue-700",
			"hover:bg-blue-800",
			"focus:ring-blue-300",
			"dark:bg-blue-600",
			"dark:hover:bg-blue-700",
			"dark:focus:ring-blue-800",
		}
	}
}

func getSizeClasses(size ButtonSize) []string {
	switch size {
	case ButtonSizeXS:
		return []string{"px-3", "py-2", "text-xs"}
	case ButtonSizeSM:
		return []string{"px-3", "py-2", "text-sm"}
	case ButtonSizeLG:
		return []string{"px-5", "py-3", "text-base"}
	case ButtonSizeXL:
		return []string{"px-6", "py-3.5", "text-base"}
	default: // MD
		return []string{"px-5", "py-2.5", "text-sm"}
	}
}

func getIconButtonSizeClasses(size ButtonSize) []string {
	switch size {
	case ButtonSizeXS:
		return []string{"w-6", "h-6", "text-xs"}
	case ButtonSizeSM:
		return []string{"w-8", "h-8", "text-sm"}
	case ButtonSizeLG:
		return []string{"w-12", "h-12", "text-base"}
	case ButtonSizeXL:
		return []string{"w-14", "h-14", "text-lg"}
	default: // MD
		return []string{"w-10", "h-10", "text-sm"}
	}
}

func getIconSizeForButton(buttonSize ButtonSize) IconSize {
	switch buttonSize {
	case ButtonSizeXS:
		return IconSizeXS
	case ButtonSizeSM:
		return IconSizeSM
	case ButtonSizeLG:
		return IconSizeLG
	case ButtonSizeXL:
		return IconSizeXL
	default:
		return IconSizeSM
	}
}

func getButtonSpinnerSize(buttonSize ButtonSize) SpinnerSize {
	switch buttonSize {
	case ButtonSizeXS:
		return SpinnerSizeXS
	case ButtonSizeSM:
		return SpinnerSizeSM
	case ButtonSizeLG:
		return SpinnerSizeLG
	case ButtonSizeXL:
		return SpinnerSizeXL
	default:
		return SpinnerSizeSM
	}
}