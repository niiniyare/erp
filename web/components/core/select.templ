package core

import "strings"

// SelectOption represents an option in a select dropdown
type SelectOption struct {
	Value    string `json:"value"`
	Label    string `json:"label"`
	Selected bool   `json:"selected"`
	Disabled bool   `json:"disabled"`
}

// SelectProps defines the properties for the Select component
type SelectProps struct {
	Options     []SelectOption `json:"options" validate:"required"`
	Value       string         `json:"value"`
	Placeholder string         `json:"placeholder"`
	Name        string         `json:"name" validate:"required"`
	Label       string         `json:"label"`
	Multiple    bool           `json:"multiple"`
	Size        string         `json:"size" validate:"oneof=sm base lg"`
	Validation  string         `json:"validation" validate:"oneof=none success error"`
	Disabled    bool           `json:"disabled"`
	Required    bool           `json:"required"`
	HelperText  string         `json:"helper_text"`
	ID          string         `json:"id"`
	Class       string         `json:"class"`
}

// Select renders a Flowbite-styled select component
templ Select(props SelectProps) {
	<div class="erp-input">
		if props.Label != "" {
			<label 
				for={ getSelectID(props.ID, props.Name) }
				class="erp-input"
			>
				{ props.Label }
				if props.Required {
					<span class="erp-input">*</span>
				}
			</label>
		}
		<select
			id={ getSelectID(props.ID, props.Name) }
			name={ props.Name }
			class={ getSelectClasses(props.Size, props.Validation) + " " + props.Class }
			if props.Multiple {
				multiple
			}
			if props.Required {
				required
			}
			if props.Disabled {
				disabled
			}
			if props.Validation == "error" {
				aria-invalid="true"
			}
		>
			if props.Placeholder != "" && !props.Multiple {
				<option value="" disabled selected>{ props.Placeholder }</option>
			}
			for _, option := range props.Options {
				<option 
					value={ option.Value }
					if option.Selected || (props.Value != "" && option.Value == props.Value) {
						selected
					}
					if option.Disabled {
						disabled
					}
				>
					{ option.Label }
				</option>
			}
		</select>
		if props.HelperText != "" {
			<div class={ getSelectHelperTextClasses(props.Validation) }>
				{ props.HelperText }
			</div>
		}
	</div>
}

// Helper functions for select styling
func getSelectClasses(size, validation string) string {
	base := "block w-full rounded-lg border focus:outline-none focus:ring-1"
	
	// Size classes
	var sizeClass string
	switch size {
	case "sm":
		sizeClass = "p-2 text-sm"
	case "lg":
		sizeClass = "p-4 text-base"
	default: // base
		sizeClass = "p-2.5 text-sm"
	}
	
	// Validation state classes
	var validationClass string
	switch validation {
	case "success":
		validationClass = "border-green-500 bg-green-50 focus:ring-green-500 focus:border-green-500 text-green-900 dark:bg-gray-700 dark:border-green-500 dark:text-green-400"
	case "error":
		validationClass = "border-red-500 bg-red-50 focus:ring-red-500 focus:border-red-500 text-red-900 dark:bg-gray-700 dark:border-red-500 dark:text-red-400"
	default: // none
		validationClass = "border-gray-300 bg-gray-50 focus:ring-blue-500 focus:border-blue-500 text-gray-900 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
	}
	
	return strings.Join([]string{base, sizeClass, validationClass}, " ")
}

func getSelectHelperTextClasses(validation string) string {
	base := "mt-2 text-sm"
	
	switch validation {
	case "success":
		return base + " text-green-600 dark:text-green-500"
	case "error":
		return base + " text-red-600 dark:text-red-500"
	default:
		return base + " text-gray-500 dark:text-gray-400"
	}
}

func getSelectID(id, name string) string {
	if id != "" {
		return id
	}
	if name != "" {
		return name + "-select"
	}
	return ""
}