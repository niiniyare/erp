package core

import "strings"

// LinkProps defines the properties for the Link component
type LinkProps struct {
	Href      string `json:"href" validate:"required"`
	Text      string `json:"text" validate:"required"`
	Target    string `json:"target" validate:"oneof=_blank _self _parent _top"`
	Rel       string `json:"rel"`
	Underline bool   `json:"underline"`
	Color     string `json:"color" validate:"oneof=blue red green yellow indigo purple pink gray"`
	External  bool   `json:"external"`
	Disabled  bool   `json:"disabled"`
	Size      string `json:"size" validate:"oneof=xs sm base lg xl"`
	ID        string `json:"id"`
	Class     string `json:"class"`
}

// Link renders a Flowbite-styled link component
templ Link(props LinkProps) {
	if props.Disabled {
		<span
			if props.ID != "" {
				id={ props.ID }
			}
			class={ getLinkClasses(props.Color, props.Size, props.Underline, true) + " " + props.Class }
			aria-disabled="true"
		>
			{ props.Text }
		</span>
	} else {
		<a
			href={ props.Href }
			if props.ID != "" {
				id={ props.ID }
			}
			if props.Target != "" {
				target={ props.Target }
			}
			rel={ getLinkRel(props.External, props.Target, props.Rel) }
			class={ getLinkClasses(props.Color, props.Size, props.Underline, false) + " " + props.Class }
		>
			{ props.Text }
			if props.External && props.Target == "_blank" {
				<svg class="w-3 h-3 ml-2 inline-block" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 18">
					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11v4.833A1.166 1.166 0 0 1 13.833 17H2.167A1.167 1.167 0 0 1 1 15.833V4.167A1.166 1.166 0 0 1 2.167 3h4.618m4.447-2H17v5.768M9.111 8.889l7.778-7.778"/>
				</svg>
			}
		</a>
	}
}

// Helper functions for link styling
func getLinkClasses(color, size string, underline, disabled bool) string {
	base := "font-medium transition-colors duration-200"
	
	// Size classes
	var sizeClass string
	switch size {
	case "xs":
		sizeClass = "text-xs"
	case "sm":
		sizeClass = "text-sm"
	case "lg":
		sizeClass = "text-lg"
	case "xl":
		sizeClass = "text-xl"
	default: // base
		sizeClass = "text-base"
	}
	
	// Underline class
	var underlineClass string
	if underline {
		underlineClass = "underline"
	} else {
		underlineClass = "no-underline hover:underline"
	}
	
	// Color and state classes
	var colorClass string
	if disabled {
		colorClass = "text-gray-400 cursor-not-allowed dark:text-gray-600"
	} else {
		switch color {
		case "blue":
			colorClass = "text-blue-600 hover:text-blue-800 dark:text-blue-500 dark:hover:text-blue-400"
		case "red":
			colorClass = "text-red-600 hover:text-red-800 dark:text-red-500 dark:hover:text-red-400"
		case "green":
			colorClass = "text-green-600 hover:text-green-800 dark:text-green-500 dark:hover:text-green-400"
		case "yellow":
			colorClass = "text-yellow-600 hover:text-yellow-800 dark:text-yellow-500 dark:hover:text-yellow-400"
		case "indigo":
			colorClass = "text-indigo-600 hover:text-indigo-800 dark:text-indigo-500 dark:hover:text-indigo-400"
		case "purple":
			colorClass = "text-purple-600 hover:text-purple-800 dark:text-purple-500 dark:hover:text-purple-400"
		case "pink":
			colorClass = "text-pink-600 hover:text-pink-800 dark:text-pink-500 dark:hover:text-pink-400"
		case "gray":
			colorClass = "text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200"
		default: // blue
			colorClass = "text-blue-600 hover:text-blue-800 dark:text-blue-500 dark:hover:text-blue-400"
		}
	}
	
	return strings.Join([]string{base, sizeClass, underlineClass, colorClass}, " ")
}

func getLinkRel(external bool, target, customRel string) string {
	if customRel != "" {
		return customRel
	}
	
	if external && target == "_blank" {
		return "noopener noreferrer"
	}
	
	if external {
		return "noopener"
	}
	
	return ""
}