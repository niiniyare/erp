package core

import "strings"

// ButtonProps defines the properties for the Button component
type ButtonProps struct {
	Text        string `json:"text" validate:"required,min=1,max=50"`
	LoadingText string `json:"loading_text"`
	Variant     string `json:"variant" validate:"oneof=primary secondary success danger warning info light dark"`
	Size        string `json:"size" validate:"oneof=xs sm base lg xl"`
	Type        string `json:"type" validate:"oneof=button submit reset"`
	Disabled    bool   `json:"disabled"`
	Loading     bool   `json:"loading"`
	ID          string `json:"id"`
	Class       string `json:"class"`
	AriaLabel   string `json:"aria_label"`
	OnClick     string `json:"onclick"`
	HXPost      string `json:"hx_post"`
	HXTarget    string `json:"hx_target"`
	HXSwap      string `json:"hx_swap"`
}

// Button renders a Flowbite-styled button component with enhanced features
templ Button(props ButtonProps) {
	<button
		type={ getButtonType(props.Type) }
		if props.ID != "" {
			id={ props.ID }
		}
		class={ getButtonClasses(props.Variant, props.Size) + " " + props.Class }
		if props.Disabled || props.Loading {
			disabled
		}
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		if props.OnClick != "" {
			onclick={ props.OnClick }
		}
		if props.HXPost != "" {
			hx-post={ props.HXPost }
		}
		if props.HXTarget != "" {
			hx-target={ props.HXTarget }
		}
		if props.HXSwap != "" {
			hx-swap={ props.HXSwap }
		}
		if props.HXPost != "" {
			hx-indicator={ "#" + props.ID + "-spinner" }
			hx-on::before-request="this.setAttribute('aria-busy', 'true')"
			hx-on::after-request="this.setAttribute('aria-busy', 'false')"
		}
		if props.Loading {
			aria-busy="true"
		}
	>
		<div class="flex items-center justify-center">
			if props.Loading {
				<svg class="animate-spin -ml-1 mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
				</svg>
				{ getLoadingText(props.LoadingText) }
			} else {
				{ props.Text }
			}
			if props.HXPost != "" && !props.Loading {
				<svg 
					id={ props.ID + "-spinner" }
					class="htmx-indicator animate-spin ml-2 h-4 w-4" 
					xmlns="http://www.w3.org/2000/svg" 
					fill="none" 
					viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
				</svg>
			}
		</div>
	</button>
}

// Helper functions for button styling with exciting theme
func getButtonClasses(variant, size string) string {
	base := "erp-btn font-medium focus:outline-none"
	
	// Size classes
	var sizeClass string
	switch size {
	case "xs":
		sizeClass = "px-3 py-2 text-xs"
	case "sm":
		sizeClass = "px-3 py-2 text-sm"
	case "lg":
		sizeClass = "px-5 py-3 text-base"
	case "xl":
		sizeClass = "px-6 py-3.5 text-base"
	default: // base
		sizeClass = "px-5 py-2.5 text-sm"
	}
	
	// Exciting variant classes with modern theme
	var variantClass string
	switch variant {
	case "primary":
		variantClass = "erp-btn-primary"
	case "secondary":
		variantClass = "erp-btn-secondary"
	case "success":
		variantClass = "erp-btn-success bg-gradient-to-r from-green-400 to-emerald-500 text-white shadow-lg hover:shadow-xl"
	case "danger":
		variantClass = "erp-btn-danger"
	case "warning":
		variantClass = "erp-btn-warning bg-gradient-to-r from-yellow-400 to-orange-500 text-white shadow-lg hover:shadow-xl"
	case "info":
		variantClass = "erp-btn-info bg-gradient-to-r from-blue-400 to-cyan-500 text-white shadow-lg hover:shadow-xl"
	case "light":
		variantClass = "erp-btn-secondary"
	case "dark":
		variantClass = "erp-btn-dark bg-gradient-to-r from-gray-700 to-gray-900 text-white shadow-lg hover:shadow-xl"
	default:
		variantClass = "erp-btn-primary"
	}
	
	return strings.Join([]string{base, sizeClass, variantClass}, " ")
}

func getButtonType(btnType string) string {
	if btnType == "" {
		return "button"
	}
	return btnType
}

func getLoadingText(loadingText string) string {
	if loadingText == "" {
		return "Loading..."
	}
	return loadingText
}