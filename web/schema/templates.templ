package schema

import (
	"context"
	"encoding/json"
	"fmt"
	"html"
	"strings"
	"time"

	"github.com/niiniyare/erp/pkg/condition"
)

// FormTemplate renders a complete form with Alpine.js and HTMX
templ FormTemplate(ctx context.Context, schema *Schema, data map[string]any, errors map[string][]string, registry *RendererRegistry, tokens TokenResolver) {
	if schema == nil {
		@ErrorBoundary(ctx, "Schema is required")
		return
	}
	
	<form 
		id={ schema.ID }
		class={ formClasses(ctx, schema) }
		if schema.Config != nil && schema.Config.Action != "" {
			action={ schema.Config.Action }
		}
		if schema.Config != nil && schema.Config.Method != "" {
			method={ schema.Config.Method }
		} else {
			method="POST"
		}
		if schema.Config != nil && schema.Config.Encoding != "" {
			enctype={ schema.Config.Encoding }
		}
		if schema.HTMX != nil && schema.HTMX.Enabled {
			if schema.HTMX.Post != "" {
				hx-post={ schema.HTMX.Post }
			}
			if schema.HTMX.Get != "" {
				hx-get={ schema.HTMX.Get }
			}
			if schema.HTMX.Target != "" {
				hx-target={ schema.HTMX.Target }
			}
			if schema.HTMX.Swap != "" {
				hx-swap={ schema.HTMX.Swap }
			}
			if schema.HTMX.Validate {
				hx-validate="true"
			}
			hx-indicator={ fmt.Sprintf("#%s-loading", schema.ID) }
			hx-disabled-elt="find button[type='submit']"
		}
		x-data={ generateAlpineData(ctx, schema, data) }
		if schema.Alpine != nil && schema.Alpine.XInit != "" {
			x-init={ schema.Alpine.XInit }
		}
		style={ generateFormStyle(ctx, schema, tokens) }
		novalidate
		data-form-id={ schema.ID }
		aria-label={ getFormAriaLabel(ctx, schema) }
	>
		@LoadingOverlay(ctx, schema)
		@FormHeader(ctx, schema)
		@CSRFToken(ctx, schema, data)
		@FormAlerts(ctx, errors)
		@FormContent(ctx, schema, data, errors, registry, tokens)
		@FormActions(ctx, schema, tokens)
	</form>
	@RequiredAssets(ctx, schema, registry)
}

// ErrorBoundary renders error state
templ ErrorBoundary(ctx context.Context, message string) {
	<div class="form-error-boundary" role="alert" aria-live="assertive">
		<div class="error-boundary__icon" aria-hidden="true">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="12" y1="8" x2="12" y2="12"></line>
				<line x1="12" y1="16" x2="12.01" y2="16"></line>
			</svg>
		</div>
		<div class="error-boundary__content">
			<h3 class="error-boundary__title">Form Error</h3>
			<p class="error-boundary__message">{ message }</p>
		</div>
	</div>
}

// LoadingOverlay with Alpine.js show directive
templ LoadingOverlay(ctx context.Context, schema *Schema) {
	<div 
		id={ fmt.Sprintf("%s-loading", schema.ID) } 
		class="form-loading-overlay htmx-indicator" 
		x-show="$store.form.loading"
		x-transition.opacity
		aria-hidden="true"
	>
		<div class="loading-spinner">
			<svg class="spinner" viewBox="0 0 50 50">
				<circle class="spinner-path" cx="25" cy="25" r="20" fill="none" stroke-width="4"></circle>
			</svg>
			<span class="loading-text">Processing...</span>
		</div>
	</div>
}

// FormHeader renders form title and description
templ FormHeader(ctx context.Context, schema *Schema) {
	if schema.Title != "" || schema.Description != "" {
		<div class="form-header" role="banner">
			if schema.Title != "" {
				<h1 class="form-title" id={ fmt.Sprintf("%s-title", schema.ID) }>
					{ schema.Title }
					if schema.Config != nil && schema.Config.Required {
						<span class="form-required-indicator" aria-label="Required form">*</span>
					}
				</h1>
			}
			if schema.Description != "" {
				<p class="form-description" id={ fmt.Sprintf("%s-description", schema.ID) }>
					{ schema.Description }
				</p>
			}
		</div>
	}
}

// CSRFToken renders CSRF protection token
templ CSRFToken(ctx context.Context, schema *Schema, data map[string]any) {
	if schema.Security != nil && schema.Security.CSRF != nil && schema.Security.CSRF.Enabled {
		<input 
			type="hidden" 
			name={ getCSRFTokenField(ctx, schema.Security.CSRF) } 
			value={ getCSRFTokenValue(ctx, data, schema.Security.CSRF) }
			data-csrf-token
		/>
	}
}

// FormAlerts renders form-level error messages with Alpine.js
templ FormAlerts(ctx context.Context, errors map[string][]string) {
	if formErrors, ok := errors["_form"]; ok && len(formErrors) > 0 {
		<div class="form-alerts" role="alert" aria-live="polite" aria-atomic="true">
			for _, err := range formErrors {
				<div 
					class="alert alert--error"
					x-data="{ show: true }"
					x-show="show"
					x-transition
				>
					<svg class="alert__icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
					</svg>
					<span class="alert__message">{ err }</span>
					<button 
						type="button" 
						class="alert__close" 
						aria-label="Dismiss alert"
						@click="show = false"
					>
						<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
							<path d="M4.646 4.646a.5.5 0 01.708 0L8 7.293l2.646-2.647a.5.5 0 01.708.708L8.707 8l2.647 2.646a.5.5 0 01-.708.708L8 8.707l-2.646 2.647a.5.5 0 01-.708-.708L7.293 8 4.646 5.354a.5.5 0 010-.708z"></path>
						</svg>
					</button>
				</div>
			}
		</div>
	}
}

// FormContent renders the main form content
templ FormContent(ctx context.Context, schema *Schema, data map[string]any, errors map[string][]string, registry *RendererRegistry, tokens TokenResolver) {
	<div class="form-content" role="main">
		if schema.Layout != nil {
			if len(schema.Layout.Sections) > 0 {
				@FormSections(ctx, schema, data, errors, registry, tokens)
			} else if len(schema.Layout.Tabs) > 0 {
				@FormTabs(ctx, schema, data, errors, registry, tokens)
			} else if len(schema.Layout.Steps) > 0 {
				@FormSteps(ctx, schema, data, errors, registry, tokens)
			} else {
				@FieldList(ctx, schema.Fields, data, errors, registry, tokens, "")
			}
		} else {
			@FieldList(ctx, schema.Fields, data, errors, registry, tokens, "")
		}
	</div>
}

// FormSections renders form sections with Alpine.js
templ FormSections(ctx context.Context, schema *Schema, data map[string]any, errors map[string][]string, registry *RendererRegistry, tokens TokenResolver) {
	<div class="form-sections">
		for i, section := range schema.Layout.Sections {
			@SectionTemplate(ctx, schema.ID, i, section, getSectionFields(ctx, schema.Fields, section.Fields), data, errors, registry, tokens)
		}
	</div>
}

// SectionTemplate with Alpine.js collapsible support
templ SectionTemplate(ctx context.Context, formID string, index int, section Section, fields []Field, data map[string]any, errors map[string][]string, registry *RendererRegistry, tokens TokenResolver) {
	<section 
		id={ section.ID }
		class={ sectionClasses(ctx, section, hasErrors(ctx, fields, errors)) }
		aria-labelledby={ fmt.Sprintf("%s-header", section.ID) }
		if section.Collapsible {
			x-data="{ expanded: true }"
		}
	>
		if section.Title != "" {
			<header 
				id={ fmt.Sprintf("%s-header", section.ID) }
				class={ sectionHeaderClasses(ctx, section) }
			>
				<div class="section-header__content">
					if section.Icon != "" {
						<span class="section-icon" aria-hidden="true">{ section.Icon }</span>
					}
					<h2 class="section-title">
						{ section.Title }
						if section.Config != nil && section.Config.Required {
							<span class="section-required" aria-label="Required section">*</span>
						}
					</h2>
				</div>
				if section.Collapsible {
					<button 
						type="button" 
						class="section-toggle" 
						@click="expanded = !expanded"
						:aria-expanded="expanded.toString()"
						aria-controls={ fmt.Sprintf("%s-content", section.ID) }
						aria-label={ fmt.Sprintf("Toggle %s section", section.Title) }
					>
						<svg 
							class="section-toggle__icon" 
							width="20" 
							height="20" 
							viewBox="0 0 20 20" 
							fill="currentColor"
							:class="{ 'rotate-180': !expanded }"
						>
							<path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
						</svg>
					</button>
				}
			</header>
		}
		if section.Description != "" {
			<p class="section-description">{ section.Description }</p>
		}
		<div 
			id={ fmt.Sprintf("%s-content", section.ID) }
			class="section-content"
			if section.Collapsible {
				x-show="expanded"
				x-transition
				:aria-hidden="(!expanded).toString()"
			}
		>
			@FieldList(ctx, fields, data, errors, registry, tokens, section.ID)
		</div>
	</section>
}

// FormTabs with Alpine.js state management
templ FormTabs(ctx context.Context, schema *Schema, data map[string]any, errors map[string][]string, registry *RendererRegistry, tokens TokenResolver) {
	<div 
		class="form-tabs" 
		x-data="{ activeTab: 0 }"
		data-tabs={ schema.ID }
	>
		<nav class="tab-nav" role="tablist" aria-label="Form sections">
			for i, tab := range schema.Layout.Tabs {
				<button 
					type="button" 
					class="tab-nav__button"
					:class={ fmt.Sprintf("{ 'tab-nav__button--active': activeTab === %d }", i) }
					role="tab" 
					id={ fmt.Sprintf("%s-tab-%d-button", schema.ID, i) }
					:aria-selected={ fmt.Sprintf("(activeTab === %d).toString()", i) }
					aria-controls={ fmt.Sprintf("%s-tab-%d", schema.ID, i) }
					:tabindex={ fmt.Sprintf("activeTab === %d ? '0' : '-1'", i) }
					@click={ fmt.Sprintf("activeTab = %d", i) }
					@keydown.arrow-left.prevent={ fmt.Sprintf("activeTab = activeTab > 0 ? activeTab - 1 : %d", len(schema.Layout.Tabs)-1) }
					@keydown.arrow-right.prevent={ fmt.Sprintf("activeTab = activeTab < %d ? activeTab + 1 : 0", len(schema.Layout.Tabs)-1) }
					@keydown.home.prevent="activeTab = 0"
					@keydown.end.prevent={ fmt.Sprintf("activeTab = %d", len(schema.Layout.Tabs)-1) }
				>
					if tab.Icon != "" {
						<span class="tab-icon" aria-hidden="true">{ tab.Icon }</span>
					}
					<span class="tab-title">{ tab.Title }</span>
					if tab.Badge != "" {
						<span class="tab-badge" aria-label={ fmt.Sprintf("%s notifications", tab.Badge) }>{ tab.Badge }</span>
					}
					if hasErrors(ctx, getSectionFields(ctx, schema.Fields, tab.Fields), errors) {
						<span class="tab-error-indicator" aria-label="Contains errors">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
								<circle cx="8" cy="8" r="8"></circle>
							</svg>
						</span>
					}
				</button>
			}
		</nav>
		for i, tab := range schema.Layout.Tabs {
			<div 
				class="tab-content"
				:class={ fmt.Sprintf("{ 'tab-content--active': activeTab === %d }", i) }
				role="tabpanel" 
				id={ fmt.Sprintf("%s-tab-%d", schema.ID, i) }
				aria-labelledby={ fmt.Sprintf("%s-tab-%d-button", schema.ID, i) }
				tabindex="0"
				x-show={ fmt.Sprintf("activeTab === %d", i) }
				x-transition
			>
				if tab.Title != "" {
					<h3 class="sr-only">{ tab.Title }</h3>
				}
				@FieldList(ctx, getSectionFields(ctx, schema.Fields, tab.Fields), data, errors, registry, tokens, fmt.Sprintf("%s-tab-%d", schema.ID, i))
			</div>
		}
	</div>
}

// FormSteps with Alpine.js progress tracking
templ FormSteps(ctx context.Context, schema *Schema, data map[string]any, errors map[string][]string, registry *RendererRegistry, tokens TokenResolver) {
	<div 
		class="form-steps" 
		x-data={ fmt.Sprintf("{ currentStep: 0, totalSteps: %d, completedSteps: new Set() }", len(schema.Layout.Steps)) }
		data-steps={ schema.ID }
	>
		<div 
			class="step-progress" 
			role="progressbar" 
			:aria-valuenow="currentStep" 
			aria-valuemin="0" 
			:aria-valuemax={ fmt.Sprintf("%d", len(schema.Layout.Steps)-1) }
			aria-label="Form progress"
		>
			<ol class="step-indicators">
				for i, step := range schema.Layout.Steps {
					<li 
						class="step-indicator"
						:class={ fmt.Sprintf("{ 'step-indicator--active': currentStep === %d, 'step-indicator--completed': completedSteps.has(%d) }", i, i) }
					>
						<button 
							type="button"
							class="step-indicator__button"
							@click={ fmt.Sprintf("if (completedSteps.has(%d) || currentStep === %d) currentStep = %d", i, i, i) }
							aria-label={ fmt.Sprintf("Step %d: %s", i+1, step.Title) }
							:disabled={ fmt.Sprintf("!completedSteps.has(%d) && currentStep !== %d", i, i) }
						>
							<span class="step-number" aria-hidden="true" x-show={ fmt.Sprintf("!completedSteps.has(%d)", i) }>{ fmt.Sprintf("%d", i+1) }</span>
							<span class="step-check" aria-hidden="true" x-show={ fmt.Sprintf("completedSteps.has(%d)", i) }>
								<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
									<path d="M13.854 3.646a.5.5 0 010 .708l-7 7a.5.5 0 01-.708 0l-3.5-3.5a.5.5 0 11.708-.708L6.5 10.293l6.646-6.647a.5.5 0 01.708 0z"></path>
								</svg>
							</span>
						</button>
						<span class="step-title">{ step.Title }</span>
					</li>
				}
			</ol>
			<div class="step-progress-bar">
				<div 
					class="step-progress-fill" 
					:style={ fmt.Sprintf("`width: ${(currentStep / (%d - 1)) * 100}%%`", len(schema.Layout.Steps)) }
					role="presentation"
				></div>
			</div>
		</div>
		for i, step := range schema.Layout.Steps {
			<div 
				class="step-content"
				:class={ fmt.Sprintf("{ 'step-content--active': currentStep === %d }", i) }
				id={ fmt.Sprintf("%s-step-%d", schema.ID, i) }
				role="group"
				aria-labelledby={ fmt.Sprintf("%s-step-%d-title", schema.ID, i) }
				x-show={ fmt.Sprintf("currentStep === %d", i) }
				x-transition
			>
				if step.Title != "" {
					<h3 id={ fmt.Sprintf("%s-step-%d-title", schema.ID, i) } class="step-content-title">{ step.Title }</h3>
				}
				if step.Description != "" {
					<p class="step-description">{ step.Description }</p>
				}
				@FieldList(ctx, getSectionFields(ctx, schema.Fields, step.Fields), data, errors, registry, tokens, fmt.Sprintf("%s-step-%d", schema.ID, i))
				<div class="step-navigation">
					if i > 0 {
						<button 
							type="button" 
							class="btn btn--secondary step-btn step-btn--previous" 
							@click="currentStep--"
							aria-label="Previous step"
						>
							<svg class="btn__icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path>
							</svg>
							<span>Previous</span>
						</button>
					}
					<div class="step-info" aria-live="polite">
						<span class="step-current" x-text={ fmt.Sprintf("`Step ${currentStep + 1}`") }></span>
						<span class="step-total">of { fmt.Sprintf("%d", len(schema.Layout.Steps)) }</span>
					</div>
					if i < len(schema.Layout.Steps)-1 {
						<button 
							type="button" 
							class="btn btn--primary step-btn step-btn--next" 
							@click={ fmt.Sprintf("if ($el.form.reportValidity()) { completedSteps.add(%d); currentStep++ }", i) }
							aria-label="Next step"
						>
							<span>Next</span>
							<svg class="btn__icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
							</svg>
						</button>
					}
				</div>
			</div>
		}
	</div>
}

// FieldList renders a list of fields with condition evaluation
templ FieldList(ctx context.Context, fields []Field, data map[string]any, errors map[string][]string, registry *RendererRegistry, tokens TokenResolver, context string) {
	<div class="form-fields" data-context={ context }>
		for _, field := range fields {
			if shouldRenderField(ctx, &field, data) {
				@FieldWrapper(ctx, &field, getFieldValue(ctx, data, field.Name), getFieldErrors(ctx, errors, field.Name), registry, tokens)
			}
		}
	</div>
}

// FieldWrapper wraps a field with proper container
templ FieldWrapper(ctx context.Context, field *Field, value any, errors []string, registry *RendererRegistry, tokens TokenResolver) {
	<div 
		class={ fieldWrapperClasses(ctx, field, len(errors) > 0) }
		id={ fmt.Sprintf("%s-wrapper", field.Name) }
		data-field-name={ field.Name }
		if field.Validation != nil && field.Validation.Required {
			data-required="true"
		}
		if field.Conditions != nil {
			x-show={ generateConditionExpression(ctx, field.Conditions) }
			x-transition
		}
	>
		@FieldTemplate(ctx, field, value, errors, registry, tokens)
		if len(errors) > 0 {
			@FieldErrors(ctx, field.Name, errors)
		}
		if field.HelpText != "" {
			@FieldHelpText(ctx, field.Name, field.HelpText)
		}
	</div>
}

// FieldTemplate renders a single field using the appropriate renderer
templ FieldTemplate(ctx context.Context, field *Field, value any, errors []string, registry *RendererRegistry, tokens TokenResolver) {
	@templ.Raw(renderFieldHTML(ctx, field, value, errors, registry, tokens))
}

// FieldErrors renders field-level errors
templ FieldErrors(ctx context.Context, fieldName string, errors []string) {
	<div 
		class="field-errors" 
		id={ fmt.Sprintf("%s-errors", fieldName) }
		role="alert" 
		aria-live="polite"
		x-data="{ show: true }"
		x-show="show"
		x-transition
	>
		for _, err := range errors {
			<span class="field-error">
				<svg class="field-error__icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" d="M8 15A7 7 0 108 1a7 7 0 000 14zm0-1A6 6 0 108 2a6 6 0 000 12zm.93-9.412l-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 110-2 1 1 0 010 2z" clip-rule="evenodd"></path>
				</svg>
				{ err }
			</span>
		}
	</div>
}

// FieldHelpText renders field help text
templ FieldHelpText(ctx context.Context, fieldName string, helpText string) {
	<small 
		class="field-help" 
		id={ fmt.Sprintf("%s-help", fieldName) }
	>
		{ helpText }
	</small>
}

// FormActions renders form action buttons
templ FormActions(ctx context.Context, schema *Schema, tokens TokenResolver) {
	if len(schema.Actions) > 0 {
		<div class="form-actions" role="group" aria-label="Form actions">
			for _, action := range schema.Actions {
				@ActionTemplate(ctx, &action, schema.ID, tokens)
			}
		</div>
	}
}

// ActionTemplate with Alpine.js and HTMX
templ ActionTemplate(ctx context.Context, action *Action, formID string, tokens TokenResolver) {
	<button 
		id={ action.ID }
		type={ string(action.Type) }
		class={ actionClasses(ctx, action) }
		if action.Disabled {
			disabled
			aria-disabled="true"
		}
		if action.HTMX != nil {
			if action.HTMX.Post != "" {
				hx-post={ action.HTMX.Post }
			}
			if action.HTMX.Get != "" {
				hx-get={ action.HTMX.Get }
			}
			if action.HTMX.Target != "" {
				hx-target={ action.HTMX.Target }
			}
			if action.HTMX.Confirm != "" {
				hx-confirm={ action.HTMX.Confirm }
			}
		}
		if action.Confirm != nil {
			@click.prevent={ fmt.Sprintf("if (confirm('%s')) $el.form.submit()", escapeJS(action.Confirm.Message)) }
		}
		aria-label={ getActionAriaLabel(ctx, action) }
		x-data="{ loading: false }"
		:class="{ 'btn--loading': loading }"
		@htmx:before-request="loading = true"
		@htmx:after-request="loading = false"
	>
		if action.Icon != "" {
			<span class="btn__icon" aria-hidden="true">{ action.Icon }</span>
		}
		<span class="btn__text">{ action.Text }</span>
		<span class="btn__spinner" aria-hidden="true" x-show="loading">
			<svg class="spinner" width="16" height="16" viewBox="0 0 50 50">
				<circle class="spinner-path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
			</svg>
		</span>
	</button>
}

// RequiredAssets renders all CSS dependencies
templ RequiredAssets(ctx context.Context, schema *Schema, registry *RendererRegistry) {
	<style nonce={ getCSPNonce(ctx) }>
		@templ.Raw(getBaseFormStyles())
	</style>
	
	if registry != nil {
		for _, asset := range registry.GetAllRequiredAssets() {
			if strings.HasSuffix(asset, ".css") {
				<link rel="stylesheet" href={ templ.URL(fmt.Sprintf("/assets/%s", asset)) } nonce={ getCSPNonce(ctx) }/>
			}
		}
	}
}
	classes := []string{"form"}
	if schema.Config != nil && schema.Config.Classes != "" {
		classes = append(classes, schema.Config.Classes)
	}
	if schema.Layout != nil {
		if len(schema.Layout.Tabs) > 0 {
			classes = append(classes, "form--tabbed")
		} else if len(schema.Layout.Steps) > 0 {
			classes = append(classes, "form--stepped")
		}
	}
	return strings.Join(classes, " ")
}

func sectionClasses(ctx context.Context, section Section, hasErrors bool) string {
	classes := []string{"form-section"}
	if section.Collapsible {
		classes = append(classes, "form-section--collapsible")
	}
	if hasErrors {
		classes = append(classes, "form-section--has-errors")
	}
	if section.Config != nil && section.Config.Classes != "" {
		classes = append(classes, section.Config.Classes)
	}
	return strings.Join(classes, " ")
}

func sectionHeaderClasses(ctx context.Context, section Section) string {
	classes := []string{"section-header"}
	if section.Collapsible {
		classes = append(classes, "section-header--collapsible")
	}
	return strings.Join(classes, " ")
}

func fieldWrapperClasses(ctx context.Context, field *Field, hasErrors bool) string {
	classes := []string{"form-field"}
	if field.Type != "" {
		classes = append(classes, fmt.Sprintf("form-field--%s", field.Type))
	}
	if hasErrors {
		classes = append(classes, "form-field--error")
	}
	if field.Validation != nil && field.Validation.Required {
		classes = append(classes, "form-field--required")
	}
	if field.Disabled {
		classes = append(classes, "form-field--disabled")
	}
	return strings.Join(classes, " ")
}

func actionClasses(ctx context.Context, action *Action) string {
	classes := []string{"btn"}
	classes = append(classes, fmt.Sprintf("btn--%s", action.Variant))
	if action.Size != "" {
		classes = append(classes, fmt.Sprintf("btn--%s", action.Size))
	}
	if action.Config != nil && action.Config.Classes != "" {
		classes = append(classes, action.Config.Classes)
	}
	return strings.Join(classes, " ")
}

func getFormAriaLabel(ctx context.Context, schema *Schema) string {
	if schema.Title != "" {
		return schema.Title
	}
	return "Form"
}

func getActionAriaLabel(ctx context.Context, action *Action) string {
	if action.AriaLabel != "" {
		return action.AriaLabel
	}
	return action.Text
}

func getCSRFTokenField(ctx context.Context, csrf *CSRFConfig) string {
	if csrf.FieldName != "" {
		return csrf.FieldName
	}
	return "_csrf"
}

func getCSRFTokenValue(ctx context.Context, data map[string]any, csrf *CSRFConfig) string {
	if data == nil {
		return ""
	}
	fieldName := getCSRFTokenField(ctx, csrf)
	if val, ok := data[fieldName]; ok {
		if str, ok := val.(string); ok {
			return str
		}
	}
	return ""
}

func getSectionFields(ctx context.Context, allFields []Field, fieldNames []string) []Field {
	if len(fieldNames) == 0 {
		return allFields
	}
	
	fieldMap := make(map[string]Field)
	for _, field := range allFields {
		fieldMap[field.Name] = field
	}
	
	result := make([]Field, 0, len(fieldNames))
	for _, name := range fieldNames {
		if field, ok := fieldMap[name]; ok {
			result = append(result, field)
		}
	}
	return result
}

func getFieldValue(ctx context.Context, data map[string]any, fieldName string) any {
	if data == nil {
		return nil
	}
	return data[fieldName]
}

func getFieldErrors(ctx context.Context, errors map[string][]string, fieldName string) []string {
	if errors == nil {
		return nil
	}
	return errors[fieldName]
}

func hasErrors(ctx context.Context, fields []Field, errors map[string][]string) bool {
	if errors == nil {
		return false
	}
	for _, field := range fields {
		if errs, ok := errors[field.Name]; ok && len(errs) > 0 {
			return true
		}
	}
	return false
}

// shouldRenderField evaluates conditions using the condition package
func shouldRenderField(ctx context.Context, field *Field, data map[string]any) bool {
	if field.Conditions == nil || len(field.Conditions.Show) == 0 {
		return true
	}
	
	// Build condition group from field conditions
	builder := condition.NewBuilder(condition.ConjunctionAnd)
	
	for _, cond := range field.Conditions.Show {
		var op condition.OperatorType
		switch cond.Operator {
		case "eq", "equals":
			op = condition.OpEqual
		case "ne", "not_equals":
			op = condition.OpNotEqual
		case "gt", "greater_than":
			op = condition.OpGreater
		case "gte", "greater_than_or_equal":
			op = condition.OpGreaterOrEqual
		case "lt", "less_than":
			op = condition.OpLess
		case "lte", "less_than_or_equal":
			op = condition.OpLessOrEqual
		case "contains":
			op = condition.OpContains
		case "not_contains":
			op = condition.OpNotContains
		case "starts_with":
			op = condition.OpStartsWith
		case "ends_with":
			op = condition.OpEndsWith
		case "in":
			op = condition.OpIn
		case "not_in":
			op = condition.OpNotIn
		default:
			op = condition.OpEqual
		}
		
		builder.AddRule(cond.Field, op, cond.Value)
	}
	
	group := builder.Build()
	
	// Create evaluation context
	evalCtx := condition.NewEvalContext(data, condition.DefaultEvalOptions())
	
	// Create evaluator with timeout
	evaluator := condition.NewEvaluator(nil, condition.EvalOptions{
		MaxDepth:      10,
		MaxConditions: 100,
		Timeout:       100 * time.Millisecond,
		CacheResults:  true,
	})
	
	// Evaluate condition
	result, err := evaluator.Evaluate(ctx, group, evalCtx)
	if err != nil {
		// Log error but don't break rendering
		// In production, you'd want proper logging
		return true
	}
	
	return result
}

// generateConditionExpression creates Alpine.js expression from conditions
func generateConditionExpression(ctx context.Context, conditions *FieldConditions) string {
	if conditions == nil || len(conditions.Show) == 0 {
		return "true"
	}
	
	var expressions []string
	for _, cond := range conditions.Show {
		expr := generateSingleCondition(cond)
		expressions = append(expressions, expr)
	}
	
	return strings.Join(expressions, " && ")
}

func generateSingleCondition(cond Condition) string {
	field := fmt.Sprintf("$el.form.elements['%s']?.value", cond.Field)
	value := fmt.Sprintf("'%s'", escapeJS(fmt.Sprintf("%v", cond.Value)))
	
	switch cond.Operator {
	case "eq", "equals":
		return fmt.Sprintf("%s === %s", field, value)
	case "ne", "not_equals":
		return fmt.Sprintf("%s !== %s", field, value)
	case "gt", "greater_than":
		return fmt.Sprintf("parseFloat(%s) > parseFloat(%s)", field, value)
	case "gte", "greater_than_or_equal":
		return fmt.Sprintf("parseFloat(%s) >= parseFloat(%s)", field, value)
	case "lt", "less_than":
		return fmt.Sprintf("parseFloat(%s) < parseFloat(%s)", field, value)
	case "lte", "less_than_or_equal":
		return fmt.Sprintf("parseFloat(%s) <= parseFloat(%s)", field, value)
	case "contains":
		return fmt.Sprintf("%s?.includes(%s)", field, value)
	default:
		return "true"
	}
}

func generateFormStyle(ctx context.Context, schema *Schema, tokens TokenResolver) string {
	if tokens == nil {
		return ""
	}
	
	var styles []string
	
	if schema.Theme != nil {
		if schema.Theme.PrimaryColor != "" {
			styles = append(styles, fmt.Sprintf("--form-primary-color: %s", schema.Theme.PrimaryColor))
		}
		if schema.Theme.Spacing != "" {
			styles = append(styles, fmt.Sprintf("--form-spacing: %s", schema.Theme.Spacing))
		}
		if schema.Theme.BorderRadius != "" {
			styles = append(styles, fmt.Sprintf("--form-border-radius: %s", schema.Theme.BorderRadius))
		}
	}
	
	return strings.Join(styles, "; ")
}

// generateAlpineData creates Alpine.js x-data attribute
func generateAlpineData(ctx context.Context, schema *Schema, data map[string]any) string {
	if schema.Alpine != nil && schema.Alpine.XData != "" {
		return schema.Alpine.XData
	}
	
	// Default Alpine state
	state := map[string]any{
		"loading": false,
		"errors":  map[string]any{},
	}
	
	jsonBytes, err := json.Marshal(state)
	if err != nil {
		return "{}"
	}
	
	return string(jsonBytes)
}

func renderFieldHTML(ctx context.Context, field *Field, value any, errors []string, registry *RendererRegistry, tokens TokenResolver) string {
	if registry == nil {
		return renderDefaultField(ctx, field, value, errors)
	}
	
	renderer := registry.GetRenderer(field.Type)
	if renderer == nil {
		return renderDefaultField(ctx, field, value, errors)
	}
	
	html, err := renderer.Render(field, value, errors)
	if err != nil {
		return fmt.Sprintf(`<div class="field-error" role="alert">Error rendering field: %s</div>`, html.EscapeString(err.Error()))
	}
	
	return html
}

func renderDefaultField(ctx context.Context, field *Field, value any, errors []string) string {
	hasError := len(errors) > 0
	errorClass := ""
	if hasError {
		errorClass = " input--error"
	}
	
	requiredAttr := ""
	ariaRequired := ""
	if field.Validation != nil && field.Validation.Required {
		requiredAttr = " required"
		ariaRequired = ` aria-required="true"`
	}
	
	disabledAttr := ""
	if field.Disabled {
		disabledAttr = " disabled"
	}
	
	ariaDescribedby := ""
	if hasError {
		ariaDescribedby = fmt.Sprintf(` aria-describedby="%s-errors"`, field.Name)
	} else if field.HelpText != "" {
		ariaDescribedby = fmt.Sprintf(` aria-describedby="%s-help"`, field.Name)
	}
	
	valueAttr := ""
	if value != nil {
		valueAttr = fmt.Sprintf(` value="%s"`, html.EscapeString(fmt.Sprintf("%v", value)))
	}
	
	placeholder := ""
	if field.Placeholder != "" {
		placeholder = fmt.Sprintf(` placeholder="%s"`, html.EscapeString(field.Placeholder))
	}
	
	// Add Alpine.js validation
	alpineAttrs := `
		@blur="$el.checkValidity() || $el.reportValidity()"
		@input="if ($el.validity.valid) $el.closest('.form-field')?.classList.remove('form-field--error')"
	`
	
	return fmt.Sprintf(`
		<label for="%s" class="field-label">
			%s
			%s
		</label>
		<input 
			type="%s" 
			id="%s" 
			name="%s" 
			class="input%s"
			%s%s%s%s%s%s
			%s
		>`,
		field.Name,
		html.EscapeString(field.Label),
		func() string {
			if field.Validation != nil && field.Validation.Required {
				return `<span class="field-required" aria-label="required">*</span>`
			}
			return ""
		}(),
		field.Type,
		field.Name,
		field.Name,
		errorClass,
		valueAttr,
		placeholder,
		requiredAttr,
		ariaRequired,
		disabledAttr,
		ariaDescribedby,
		alpineAttrs,
	)
}

func escapeJS(s string) string {
	s = strings.ReplaceAll(s, `\`, `\\`)
	s = strings.ReplaceAll(s, `'`, `\'`)
	s = strings.ReplaceAll(s, `"`, `\"`)
	s = strings.ReplaceAll(s, "\n", `\n`)
	s = strings.ReplaceAll(s, "\r", `\r`)
	return s
}

func getCSPNonce(ctx context.Context) string {
	// Retrieve from context in production
	if nonce, ok := ctx.Value("csp_nonce").(string); ok {
		return nonce
	}
	return ""
}

