{
  "type": "object",
  "properties": {
    "$$id": {
      "type": "string",
      "description": "The unique id of the component, mainly used to locate json nodes in the page designer"
    },
    "className": {
      "$ref": "#/definitions/SchemaClassName",
      "description": "Container css class name"
    },
    "$ref": {
      "type": "string",
      "description": "Used together with definitions, an infinite loop renderer can be implemented."
    },
    "disabled": {
      "type": "boolean",
      "description": "Whether to disable"
    },
    "disabledOn": {
      "$ref": "#/definitions/SchemaExpression",
      "description": "Whether to disable expressions"
    },
    "hidden": {
      "type": "boolean",
      "description": "Whether to hide"
    },
    "hiddenOn": {
      "$ref": "#/definitions/SchemaExpression",
      "description": "Whether to hide expressions"
    },
    "visible": {
      "type": "boolean",
      "description": "Whether to display"
    },
    "visibleOn": {
      "$ref": "#/definitions/SchemaExpression",
      "description": "Whether to display expressions"
    },
    "id": {
      "type": "string",
      "description": "The unique id of the component, mainly used for log collection"
    },
    "onEvent": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "weight": {
            "type": "number"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/ListenerAction"
            }
          },
          "debounce": {
            "$ref": "#/definitions/debounceConfig"
          },
          "track": {
            "$ref": "#/definitions/trackConfig"
          }
        },
        "required": [
          "actions"
        ],
        "additionalProperties": false
      },
      "description": "Event action configuration"
    },
    "static": {
      "type": "boolean",
      "description": "Whether to display statically"
    },
    "staticOn": {
      "$ref": "#/definitions/SchemaExpression",
      "description": "Whether to display expressions statically"
    },
    "staticPlaceholder": {
      "type": "string",
      "description": "Static display of empty value placeholder"
    },
    "staticClassName": {
      "$ref": "#/definitions/SchemaClassName",
      "description": "Static display form item class name"
    },
    "staticLabelClassName": {
      "$ref": "#/definitions/SchemaClassName",
      "description": "Static display of form item Label class name"
    },
    "staticInputClassName": {
      "$ref": "#/definitions/SchemaClassName",
      "description": "Static display of form item Value class name"
    },
    "staticSchema": {},
    "style": {
      "type": "object",
      "description": "Component style"
    },
    "editorSetting": {
      "type": "object",
      "properties": {
        "behavior": {
          "type": "string",
          "description": "Component behavior and usage, such as create, update, remove"
        },
        "displayName": {
          "type": "string",
          "description": "Component name, usually the business name for easy location"
        },
        "mock": {
          "description": "Editor fake data for easy display"
        }
      },
      "description": "Editor configuration, can be ignored at runtime"
    },
    "useMobileUI": {
      "type": "boolean",
      "description": "Can be used to turn off mobile style at the component level"
    },
    "testIdBuilder": {
      "$ref": "#/definitions/TestIdBuilder"
    },
    "type": {
      "type": "string",
      "enum": [
        "table",
        "static-table"
      ],
      "description": "Specified as table renderer."
    },
    "testid": {
      "type": "string"
    },
    "affixHeader": {
      "type": "boolean",
      "description": "Whether to fix the header"
    },
    "affixFooter": {
      "type": "boolean",
      "description": "Is it solid?"
    },
    "columns": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TableColumn"
      },
      "description": "Table column information"
    },
    "columnsTogglable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "const": "auto"
        }
      ],
      "description": "Display column display switch, automatic: automatically turned on when the number of columns is greater than or equal to 5"
    },
    "footable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "expand": {
              "type": "string",
              "enum": [
                "first",
                "all",
                "none"
              ]
            },
            "accordion": {
              "type": "boolean",
              "description": "Whether it is accordion mode"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Whether to enable the bottom display function, suitable for mobile display"
    },
    "footerClassName": {
      "$ref": "#/definitions/SchemaClassName",
      "description": "Bottom outer CSS class name"
    },
    "headerClassName": {
      "$ref": "#/definitions/SchemaClassName",
      "description": "Top outer CSS class name"
    },
    "placeholder": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/SchemaTpl"
        }
      ],
      "description": "placeholder"
    },
    "showFooter": {
      "type": "boolean",
      "description": "Whether to show the bottom"
    },
    "showHeader": {
      "type": "boolean",
      "description": "Whether to display the header"
    },
    "source": {
      "$ref": "#/definitions/SchemaTokenizeableString",
      "description": "Data source: bind current environment variables"
    },
    "tableClassName": {
      "$ref": "#/definitions/SchemaClassName",
      "description": "Table CSS class name"
    },
    "title": {
      "type": "string",
      "description": "title"
    },
    "toolbarClassName": {
      "$ref": "#/definitions/SchemaClassName",
      "description": "Toolbar CSS class name"
    },
    "combineNum": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/definitions/SchemaExpression"
        }
      ],
      "description": "Merge cell configuration, the configuration number indicates how many columns from left to right to automatically merge cells."
    },
    "combineFromIndex": {
      "type": "number",
      "description": "Merge cell configuration, configure the column from which to start merging."
    },
    "prefixRow": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SchemaObject"
      },
      "description": "top summary line"
    },
    "affixRow": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SchemaObject"
      },
      "description": "Bottom summary line"
    },
    "resizable": {
      "type": "boolean",
      "description": "Whether the column width can be adjusted"
    },
    "rowClassNameExpr": {
      "type": "string",
      "description": "Row style sheet expression"
    },
    "itemBadge": {
      "$ref": "#/definitions/BadgeObject",
      "description": "Row mark"
    },
    "autoGenerateFilter": {
      "anyOf": [
        {
          "$ref": "#/definitions/AutoGenerateFilterObject"
        },
        {
          "type": "boolean"
        }
      ],
      "description": "When the query area is enabled, a query condition form will be automatically generated based on the searchable attribute value of the column element."
    },
    "canAccessSuperData": {
      "type": "boolean",
      "description": "Whether the table can obtain the parent data field value, the default is false"
    },
    "autoFillHeight": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "height": {
              "type": "number"
            },
            "maxHeight": {
              "type": "number"
            }
          },
          "required": [
            "height",
            "maxHeight"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Table automatically calculates height"
    },
    "tableLayout": {
      "type": "string",
      "enum": [
        "fixed",
        "auto"
      ],
      "description": "table layout"
    },
    "deferApi": {
      "$ref": "#/definitions/SchemaApi",
      "description": "Lazy loading API, when the row data is marked with defer: true, its child nodes will use this API to pull data."
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "description": "Table table renderer. Documentation: https://aisuda.bce.baidu.com/amis/zh-CN/components/table",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "./TableSchema.json"
}