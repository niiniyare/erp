{
  "type": "object",
  "properties": {
    "options": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Option"
          }
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "$ref": "#/definitions/PlainObject"
        }
      ],
      "description": "Options collection"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/definitions/BaseApiObject"
        },
        {
          "type": "string"
        }
      ],
      "description": "Can be used to fetch options through API."
    },
    "selectFirst": {
      "type": "boolean",
      "description": "Select the first option value by default."
    },
    "initFetchOn": {
      "type": "string",
      "description": "Use expression to configure whether the source interface should fetch initially"
    },
    "initFetch": {
      "type": "boolean",
      "description": "Configure whether the source interface should fetch initially."
    },
    "multiple": {
      "type": "boolean",
      "description": "Whether it is multi-select mode"
    },
    "joinValues": {
      "type": "boolean",
      "description": "Single-select mode: When user selects an option, the value in the option will be submitted as the form item value, otherwise the entire option object will be submitted as the form item value. Multi-select mode: The `value` of multiple selected options will be connected through `delimiter`, otherwise the values will be submitted directly in array form."
    },
    "delimiter": {
      "type": "string",
      "description": "Delimiter"
    },
    "valuesNoWrap": {
      "type": "boolean",
      "description": "Multi-select mode, whether to avoid line wrapping when there are too many values"
    },
    "extractValue": {
      "type": "boolean",
      "description": "When enabled, the selected option value will be wrapped as an array and used as the current form item value."
    },
    "clearable": {
      "type": "boolean",
      "description": "Whether it can be cleared."
    },
    "resetValue": {
      "type": "string",
      "description": "When clicking the clear button, set the form item to the currently configured value.",
      "default": ""
    },
    "deferField": {
      "type": "string",
      "description": "Lazy loading field"
    },
    "deferApi": {
      "anyOf": [
        {
          "$ref": "#/definitions/BaseApiObject"
        },
        {
          "type": "string"
        }
      ],
      "description": "Delayed loading API. When there are options with defer: true in the options, clicking will expand through this interface."
    },
    "addApi": {
      "anyOf": [
        {
          "$ref": "#/definitions/BaseApiObject"
        },
        {
          "type": "string"
        }
      ],
      "description": "Interface called when adding"
    },
    "addControls": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PlainObject"
      },
      "description": "Form items for adding new entries."
    },
    "addDialog": {
      "$ref": "#/definitions/PlainObject",
      "description": "Control settings for new addition dialog"
    },
    "creatable": {
      "type": "boolean",
      "description": "Whether new items can be added"
    },
    "createBtnLabel": {
      "type": "string",
      "description": "Add button text"
    },
    "editable": {
      "type": "boolean",
      "description": "Whether it can be edited"
    },
    "editApi": {
      "anyOf": [
        {
          "$ref": "#/definitions/BaseApiObject"
        },
        {
          "type": "string"
        }
      ],
      "description": "API called when editing"
    },
    "editControls": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PlainObject"
      },
      "description": "Form items for option modification"
    },
    "editDialog": {
      "$ref": "#/definitions/PlainObject",
      "description": "Control settings for edit dialog"
    },
    "removable": {
      "type": "boolean",
      "description": "Whether it can be deleted"
    },
    "deleteApi": {
      "anyOf": [
        {
          "$ref": "#/definitions/BaseApiObject"
        },
        {
          "type": "string"
        }
      ],
      "description": "Option deletion API"
    },
    "deleteConfirmText": {
      "type": "string",
      "description": "Option deletion confirmation text."
    },
    "size": {
      "type": "string",
      "enum": [
        "xs",
        "sm",
        "md",
        "lg",
        "full"
      ],
      "description": "Form item size"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean",
          "const": false
        }
      ],
      "description": "Description title"
    },
    "labelAlign": {
      "$ref": "#/definitions/LabelAlign",
      "description": "Description title"
    },
    "labelWidth": {
      "type": [
        "number",
        "string"
      ],
      "description": "Label custom width, default unit is px"
    },
    "labelClassName": {
      "type": "string",
      "description": "Configure label className"
    },
    "name": {
      "type": "string",
      "description": "Field name, key when form is submitted, supports multi-level, connected with dots, e.g.: a.b.c"
    },
    "extraName": {
      "type": "string",
      "description": "Additional field name, can be used to flatten another value when it's a range component"
    },
    "hint": {
      "type": "string",
      "description": "Input hint, displayed when focused"
    },
    "submitOnChange": {
      "type": "boolean",
      "description": "Whether to submit the form when modification is complete."
    },
    "readOnly": {
      "type": "boolean",
      "description": "Whether it is read-only"
    },
    "readOnlyOn": {
      "type": "string",
      "description": "Read-only condition"
    },
    "validateOnChange": {
      "type": "boolean",
      "description": "When not set, each modification of form items will trigger re-validation after form submission. If set, this configuration item determines whether to trigger validation on each modification."
    },
    "description": {
      "type": "string",
      "description": "Description content, supports Html fragments."
    },
    "desc": {
      "type": "string"
    },
    "descriptionClassName": {
      "$ref": "#/definitions/ClassName",
      "description": "Configure className for description"
    },
    "mode": {
      "type": "string",
      "enum": [
        "normal",
        "inline",
        "horizontal"
      ],
      "description": "Configure current form item display mode"
    },
    "horizontal": {
      "$ref": "#/definitions/FormHorizontal",
      "description": "When configured as horizontal layout, used to configure specific left-right allocation."
    },
    "inline": {
      "type": "boolean",
      "description": "Whether form control is in inline mode."
    },
    "inputClassName": {
      "$ref": "#/definitions/ClassName",
      "description": "Configure input className"
    },
    "placeholder": {
      "type": "string",
      "description": "Placeholder"
    },
    "required": {
      "type": "boolean",
      "description": "Whether it is required"
    },
    "validationErrors": {
      "type": "object",
      "properties": {
        "isAlpha": {
          "type": "string"
        },
        "isAlphanumeric": {
          "type": "string"
        },
        "isEmail": {
          "type": "string"
        },
        "isFloat": {
          "type": "string"
        },
        "isInt": {
          "type": "string"
        },
        "isJson": {
          "type": "string"
        },
        "isLength": {
          "type": "string"
        },
        "isNumeric": {
          "type": "string"
        },
        "isRequired": {
          "type": "string"
        },
        "isUrl": {
          "type": "string"
        },
        "matchRegexp": {
          "type": "string"
        },
        "matchRegexp2": {
          "type": "string"
        },
        "matchRegexp3": {
          "type": "string"
        },
        "matchRegexp4": {
          "type": "string"
        },
        "matchRegexp5": {
          "type": "string"
        },
        "maxLength": {
          "type": "string"
        },
        "maximum": {
          "type": "string"
        },
        "minLength": {
          "type": "string"
        },
        "minimum": {
          "type": "string"
        },
        "isDateTimeSame": {
          "type": "string"
        },
        "isDateTimeBefore": {
          "type": "string"
        },
        "isDateTimeAfter": {
          "type": "string"
        },
        "isDateTimeSameOrBefore": {
          "type": "string"
        },
        "isDateTimeSameOrAfter": {
          "type": "string"
        },
        "isDateTimeBetween": {
          "type": "string"
        },
        "isTimeSame": {
          "type": "string"
        },
        "isTimeBefore": {
          "type": "string"
        },
        "isTimeAfter": {
          "type": "string"
        },
        "isTimeSameOrBefore": {
          "type": "string"
        },
        "isTimeSameOrAfter": {
          "type": "string"
        },
        "isTimeBetween": {
          "type": "string"
        }
      },
      "description": "验证失败的提示信息"
    },
    "validations": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "isAlpha": {
              "type": "boolean",
              "description": "Whether it is alphabetic"
            },
            "isAlphanumeric": {
              "type": "boolean",
              "description": "Whether it is alphanumeric"
            },
            "isEmail": {
              "type": "boolean",
              "description": "Whether it is an email address"
            },
            "isFloat": {
              "type": "boolean",
              "description": "Whether it is a float type"
            },
            "isInt": {
              "type": "boolean",
              "description": "Whether it is an integer type"
            },
            "isJson": {
              "type": "boolean",
              "description": "Whether it is JSON"
            },
            "isLength": {
              "type": "number",
              "description": "Length equals specified value"
            },
            "isNumeric": {
              "type": "boolean",
              "description": "Whether it is numeric"
            },
            "isRequired": {
              "type": "boolean",
              "description": "Whether it is required"
            },
            "isUrl": {
              "type": "boolean",
              "description": "Whether it is a URL address"
            },
            "matchRegexp": {
              "type": "string",
              "description": "Content matches specified regular expression"
            },
            "matchRegexp1": {
              "type": "string",
              "description": "Content matches specified regular expression"
            },
            "matchRegexp2": {
              "type": "string",
              "description": "Content matches specified regular expression"
            },
            "matchRegexp3": {
              "type": "string",
              "description": "Content matches specified regular expression"
            },
            "matchRegexp4": {
              "type": "string",
              "description": "Content matches specified regular expression"
            },
            "matchRegexp5": {
              "type": "string",
              "description": "Content matches specified regular expression"
            },
            "maxLength": {
              "type": "number",
              "description": "Maximum length is specified value"
            },
            "maximum": {
              "type": "number",
              "description": "Maximum value is specified value"
            },
            "minLength": {
              "type": "number",
              "description": "Minimum length is specified value"
            },
            "minimum": {
              "type": "number",
              "description": "Minimum value is specified value"
            },
            "isDateTimeSame": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Same as target date, supports specified granularity, defaults to milliseconds"
            },
            "isDateTimeBefore": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Earlier than target date, supports specified granularity, defaults to milliseconds"
            },
            "isDateTimeAfter": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Later than target date, supports specified granularity, defaults to milliseconds"
            },
            "isDateTimeSameOrBefore": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Earlier than target date or same as target date, supports specified granularity, defaults to milliseconds"
            },
            "isDateTimeSameOrAfter": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Later than target date or same as target date, supports specified granularity, defaults to milliseconds"
            },
            "isDateTimeBetween": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Date is within target date range, supports specified granularity and interval open/closed forms, defaults to milliseconds, open interval on both sides"
            },
            "isTimeSame": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Same as target time, supports specified granularity, defaults to milliseconds"
            },
            "isTimeBefore": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Earlier than target time, supports specified granularity, defaults to milliseconds"
            },
            "isTimeAfter": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Later than target time, supports specified granularity, defaults to milliseconds"
            },
            "isTimeSameOrBefore": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Earlier than target time or same as target time, supports specified granularity, defaults to milliseconds"
            },
            "isTimeSameOrAfter": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Later than target time or same as target time, supports specified granularity, defaults to milliseconds"
            },
            "isTimeBetween": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ],
              "description": "Time is within target time range, supports specified granularity and interval open/closed forms, defaults to milliseconds, open interval on both sides"
            }
          }
        }
      ]
    },
    "value": {
      "description": "Default value, remember it can only be a static value, does not support variables, data association is achieved by setting the name attribute."
    },
    "clearValueOnHidden": {
      "type": "boolean",
      "description": "When form item is hidden, whether to delete the form item value from current Form. Note that values of unhidden form items with the same name will also be deleted"
    },
    "validateApi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/BaseApiObject"
        }
      ],
      "description": "Remote validation interface for form items"
    },
    "autoFill": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "properties": {
            "showSuggestion": {
              "type": "boolean",
              "description": "Whether it is reference input mode, reference input will display candidate values for user selection instead of direct filling."
            },
            "defaultSelection": {
              "description": "Default selected value in reference input mode"
            },
            "api": {
              "anyOf": [
                {
                  "$ref": "#/definitions/BaseApiObject"
                },
                {
                  "type": "string"
                }
              ],
              "description": "Auto-fill API"
            },
            "silent": {
              "type": "boolean",
              "description": "是否展示数据格式错误提示，默认为不展示",
              "default": true
            },
            "fillMappinng": {
              "type": "object",
              "description": "填充时的数据映射"
            },
            "trigger": {
              "type": "string",
              "enum": [
                "change",
                "focus",
                "blur"
              ],
              "description": "触发条件，默认为 change"
            },
            "mode": {
              "type": "string",
              "enum": [
                "popOver",
                "dialog",
                "drawer"
              ],
              "description": "弹窗方式，当为参照录入时用可以配置"
            },
            "position": {
              "type": "string",
              "description": "当参照录入为抽屉时可以配置弹出位置"
            },
            "size": {
              "type": "string",
              "description": "当为参照录入时可以配置弹出容器的大小"
            },
            "columns": {
              "type": "array",
              "items": {},
              "description": "参照录入展示的项"
            },
            "filter": {
              "description": "参照录入时的过滤条件"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "自动填充，当选项被选择的时候，将选项中的其他值同步设置到表单内。"
    },
    "initAutoFill": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "const": "fillIfNotSet"
        }
      ]
    },
    "row": {
      "type": "number"
    },
    "$$id": {
      "type": "string",
      "description": "组件唯一 id，主要用于页面设计器中定位 json 节点"
    },
    "className": {
      "$ref": "#/definitions/SchemaClassName",
      "description": "容器 css 类名"
    },
    "$ref": {
      "type": "string",
      "description": "配合 definitions 一起使用，可以实现无限循环的渲染器。"
    },
    "disabled": {
      "type": "boolean",
      "description": "是否禁用"
    },
    "disabledOn": {
      "$ref": "#/definitions/SchemaExpression",
      "description": "是否禁用表达式"
    },
    "hidden": {
      "type": "boolean",
      "description": "是否隐藏"
    },
    "hiddenOn": {
      "$ref": "#/definitions/SchemaExpression",
      "description": "是否隐藏表达式"
    },
    "visible": {
      "type": "boolean",
      "description": "是否显示"
    },
    "visibleOn": {
      "$ref": "#/definitions/SchemaExpression",
      "description": "是否显示表达式"
    },
    "id": {
      "type": "string",
      "description": "组件唯一 id，主要用于日志采集"
    },
    "onEvent": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "weight": {
            "type": "number"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/ListenerAction"
            }
          },
          "debounce": {
            "$ref": "#/definitions/debounceConfig"
          },
          "track": {
            "$ref": "#/definitions/trackConfig"
          }
        },
        "required": [
          "actions"
        ],
        "additionalProperties": false
      },
      "description": "事件动作配置"
    },
    "static": {
      "type": "boolean",
      "description": "是否静态展示"
    },
    "staticOn": {
      "$ref": "#/definitions/SchemaExpression",
      "description": "是否静态展示表达式"
    },
    "staticPlaceholder": {
      "type": "string",
      "description": "静态展示空值占位"
    },
    "staticClassName": {
      "$ref": "#/definitions/SchemaClassName",
      "description": "静态展示表单项类名"
    },
    "staticLabelClassName": {
      "$ref": "#/definitions/SchemaClassName",
      "description": "静态展示表单项Label类名"
    },
    "staticInputClassName": {
      "$ref": "#/definitions/SchemaClassName",
      "description": "静态展示表单项Value类名"
    },
    "staticSchema": {},
    "style": {
      "type": "object",
      "description": "组件样式"
    },
    "editorSetting": {
      "type": "object",
      "properties": {
        "behavior": {
          "type": "string",
          "description": "组件行为、用途，如 create、update、remove"
        },
        "displayName": {
          "type": "string",
          "description": "组件名称，通常是业务名称方便定位"
        },
        "mock": {
          "description": "编辑器假数据，方便展示"
        }
      },
      "description": "编辑器配置，运行时可以忽略"
    },
    "useMobileUI": {
      "type": "boolean",
      "description": "可以组件级别用来关闭移动端样式"
    },
    "testIdBuilder": {
      "$ref": "#/definitions/TestIdBuilder"
    },
    "remark": {
      "$ref": "#/definitions/SchemaRemark",
      "description": "显示一个小图标, 鼠标放上去的时候显示提示内容"
    },
    "labelRemark": {
      "$ref": "#/definitions/SchemaRemark",
      "description": "显示一个小图标, 鼠标放上去的时候显示提示内容, 这个小图标跟 label 在一起"
    },
    "type": {
      "type": "string",
      "enum": [
        "input-text",
        "input-email",
        "input-url",
        "input-password",
        "native-date",
        "native-time",
        "native-number"
      ],
      "description": "表单项类型"
    },
    "addOn": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "$$id": {
              "type": "string",
              "description": "组件唯一 id，主要用于页面设计器中定位 json 节点"
            },
            "className": {
              "type": "string"
            },
            "$ref": {
              "type": "string",
              "description": "配合 definitions 一起使用，可以实现无限循环的渲染器。"
            },
            "disabled": {
              "type": "boolean",
              "description": "是否禁用"
            },
            "disabledOn": {
              "$ref": "#/definitions/SchemaExpression",
              "description": "是否禁用表达式"
            },
            "hidden": {
              "type": "boolean",
              "description": "是否隐藏"
            },
            "hiddenOn": {
              "$ref": "#/definitions/SchemaExpression",
              "description": "是否隐藏表达式"
            },
            "visible": {
              "type": "boolean",
              "description": "是否显示"
            },
            "visibleOn": {
              "$ref": "#/definitions/SchemaExpression",
              "description": "是否显示表达式"
            },
            "id": {
              "type": "string",
              "description": "主要用于用户行为跟踪里区分是哪个按钮"
            },
            "onEvent": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "weight": {
                    "type": "number"
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/ListenerAction"
                    }
                  },
                  "debounce": {
