	        SELECT e.id, ep.ancestor_id, ep.depth + 1, e.tenant_id
	        FROM entities e
	        JOIN entity_paths ep ON e.parent_id = ep.id
	    )
	    INSERT INTO hierarchy_paths (tenant_id, ancestor_id, descendant_id, depth)
	    SELECT tenant_id, ancestor_id, id, depth
	    FROM entity_paths;
	END;
	
	
	
