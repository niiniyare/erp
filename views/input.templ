package ui

import "fmt"

// InputType represents the type of input
type InputType string

const (
	InputTypeText     InputType = "text"
	InputTypeEmail    InputType = "email"
	InputTypePassword InputType = "password"
	InputTypeNumber   InputType = "number"
	InputTypeTel      InputType = "tel"
	InputTypeURL      InputType = "url"
	InputTypeDate     InputType = "date"
	InputTypeTime     InputType = "time"
	InputTypeDatetime InputType = "datetime-local"
	InputTypeSearch   InputType = "search"
	InputTypeHidden   InputType = "hidden"
	InputTypeColor    InputType = "color"
	InputTypeFile     InputType = "file"
)

// InputProps defines properties for input component
type InputProps struct {
	Type        InputType
	Name        string
	ID          string
	Value       string
	Placeholder string
	Required    bool
	Disabled    bool
	Readonly    bool
	Autofocus   bool
	Class       string
	
	// Validation attributes
	MinLength   int
	MaxLength   int
	Min         string // For number, date, time inputs
	Max         string
	Step        string
	Pattern     string
	
	// HTMX attributes
	HxPost      string
	HxGet       string
	HxTrigger   string
	HxTarget    string
	HxSwap      string
	HxValidate  bool
	
	// Alpine.js
	AlpineModel string
	AlpineOn    string
	
	// Accessibility
	AriaLabel       string
	AriaDescribedBy string
	AriaInvalid     bool
	
	// Additional attributes
	Autocomplete string
	Accept       string // For file input
	Multiple     bool   // For file input
}

// getInputClasses returns the Tailwind classes for the input
func (p InputProps) getInputClasses() string {
	if p.Type == InputTypeHidden {
		return ""
	}
	
	classes := "input"
	
	if p.AriaInvalid {
		classes += " border-destructive focus-visible:ring-destructive"
	}
	
	if p.Class != "" {
		classes += " " + p.Class
	}
	
	return classes
}

// Input renders a standard input field
templ Input(props InputProps) {
	<input
		type={ string(props.Type) }
		name={ props.Name }
		class={ props.getInputClasses() }
		if props.ID != "" {
			id={ props.ID }
		}
		if props.Value != "" {
			value={ props.Value }
		}
		if props.Placeholder != "" {
			placeholder={ props.Placeholder }
		}
		if props.Required {
			required
		}
		if props.Disabled {
			disabled
		}
		if props.Readonly {
			readonly
		}
		if props.Autofocus {
			autofocus
		}
		if props.MinLength > 0 {
			minlength={ fmt.Sprintf("%d", props.MinLength) }
		}
		if props.MaxLength > 0 {
			maxlength={ fmt.Sprintf("%d", props.MaxLength) }
		}
		if props.Min != "" {
			min={ props.Min }
		}
		if props.Max != "" {
			max={ props.Max }
		}
		if props.Step != "" {
			step={ props.Step }
		}
		if props.Pattern != "" {
			pattern={ props.Pattern }
		}
		if props.Autocomplete != "" {
			autocomplete={ props.Autocomplete }
		}
		if props.Accept != "" {
			accept={ props.Accept }
		}
		if props.Multiple {
			multiple
		}
		if props.HxPost != "" {
			hx-post={ props.HxPost }
		}
		if props.HxGet != "" {
			hx-get={ props.HxGet }
		}
		if props.HxTrigger != "" {
			hx-trigger={ props.HxTrigger }
		}
		if props.HxTarget != "" {
			hx-target={ props.HxTarget }
		}
		if props.HxSwap != "" {
			hx-swap={ props.HxSwap }
		}
		if props.HxValidate {
			hx-validate="true"
		}
		if props.AlpineModel != "" {
			x-model={ props.AlpineModel }
		}
		if props.AlpineOn != "" {
			x-on={ props.AlpineOn }
		}
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		if props.AriaDescribedBy != "" {
			aria-describedby={ props.AriaDescribedBy }
		}
		if props.AriaInvalid {
			aria-invalid="true"
		}
	/>
}

// InputWithLabel renders an input with a label
templ InputWithLabel(labelText string, props InputProps) {
	<div class="space-y-2">
		@Label(LabelProps{
			For:  props.ID,
			Text: labelText,
			Required: props.Required,
		})
		@Input(props)
	</div>
}

// InputWithIcon renders an input with an icon prefix/suffix
templ InputWithIcon(props InputProps, iconClass string, position string) {
	<div class="relative">
		if position == "left" {
			<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
				<i class={ iconClass + " text-muted-foreground" }></i>
			</div>
			<input
				type={ string(props.Type) }
				name={ props.Name }
				class={ props.getInputClasses() + " pl-10" }
				if props.ID != "" {
					id={ props.ID }
				}
				if props.Value != "" {
					value={ props.Value }
				}
				if props.Placeholder != "" {
					placeholder={ props.Placeholder }
				}
				if props.Required {
					required
				}
				if props.Disabled {
					disabled
				}
			/>
		} else {
			<input
				type={ string(props.Type) }
				name={ props.Name }
				class={ props.getInputClasses() + " pr-10" }
				if props.ID != "" {
					id={ props.ID }
				}
				if props.Value != "" {
					value={ props.Value }
				}
				if props.Placeholder != "" {
					placeholder={ props.Placeholder }
				}
				if props.Required {
					required
				}
				if props.Disabled {
					disabled
				}
			/>
			<div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
				<i class={ iconClass + " text-muted-foreground" }></i>
			</div>
		}
	</div>
}

// NumberInput renders a number input with increment/decrement buttons
templ NumberInput(props InputProps, showStepper bool) {
	if showStepper {
		<div class="relative flex items-center">
			<button
				type="button"
				class="absolute left-0 h-full px-3 text-muted-foreground hover:text-foreground focus:outline-none"
				x-on:click={ fmt.Sprintf("$refs.%s.stepDown()", props.ID) }
			>
				<i class="fa fa-minus text-xs"></i>
			</button>
			<input
				type="number"
				name={ props.Name }
				id={ props.ID }
				x-ref={ props.ID }
				class={ props.getInputClasses() + " text-center px-12" }
				if props.Value != "" {
					value={ props.Value }
				}
				if props.Placeholder != "" {
					placeholder={ props.Placeholder }
				}
				if props.Min != "" {
					min={ props.Min }
				}
				if props.Max != "" {
					max={ props.Max }
				}
				if props.Step != "" {
					step={ props.Step }
				}
				if props.Required {
					required
				}
				if props.Disabled {
					disabled
				}
			/>
			<button
				type="button"
				class="absolute right-0 h-full px-3 text-muted-foreground hover:text-foreground focus:outline-none"
				x-on:click={ fmt.Sprintf("$refs.%s.stepUp()", props.ID) }
			>
				<i class="fa fa-plus text-xs"></i>
			</button>
		</div>
	} else {
		@Input(props)
	}
}

// SearchInput renders a search input with clear button
templ SearchInput(props InputProps) {
	<div class="relative" x-data="{ search: '' }">
		<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
			<i class="fa fa-search text-muted-foreground"></i>
		</div>
		<input
			type="search"
			name={ props.Name }
			class={ props.getInputClasses() + " pl-10 pr-10" }
			placeholder={ props.Placeholder }
			x-model="search"
			if props.ID != "" {
				id={ props.ID }
			}
		/>
		<button
			type="button"
			class="absolute inset-y-0 right-0 pr-3 flex items-center"
			x-show="search !== ''"
			x-on:click="search = ''"
		>
			<i class="fa fa-times text-muted-foreground hover:text-foreground"></i>
		</button>
	</div>
}

// PasswordInput renders a password input with show/hide toggle
templ PasswordInput(props InputProps) {
	<div class="relative" x-data="{ show: false }">
		<input
			x-bind:type="show ? 'text' : 'password'"
			name={ props.Name }
			class={ props.getInputClasses() + " pr-10" }
			if props.ID != "" {
				id={ props.ID }
			}
			if props.Value != "" {
				value={ props.Value }
			}
			if props.Placeholder != "" {
				placeholder={ props.Placeholder }
			}
			if props.Required {
				required
			}
			if props.MinLength > 0 {
				minlength={ fmt.Sprintf("%d", props.MinLength) }
			}
			if props.Pattern != "" {
				pattern={ props.Pattern }
			}
			if props.Autocomplete != "" {
				autocomplete={ props.Autocomplete }
			}
		/>
		<button
			type="button"
			class="absolute inset-y-0 right-0 pr-3 flex items-center"
			x-on:click="show = !show"
		>
			<i class="fa" x-bind:class="show ? 'fa-eye-slash' : 'fa-eye'" class="text-muted-foreground hover:text-foreground"></i>
		</button>
	</div>
}

// CurrencyInput renders a currency input with formatting
templ CurrencyInput(props InputProps, currency string, symbol string) {
	<div class="relative">
		<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
			<span class="text-muted-foreground sm:text-sm">{ symbol }</span>
		</div>
		<input
			type="number"
			name={ props.Name }
			class={ props.getInputClasses() + " pl-10" }
			step="0.01"
			if props.ID != "" {
				id={ props.ID }
			}
			if props.Value != "" {
				value={ props.Value }
			}
			if props.Placeholder != "" {
				placeholder={ props.Placeholder }
			}
			if props.Min != "" {
				min={ props.Min }
			}
			if props.Max != "" {
				max={ props.Max }
			}
			if props.Required {
				required
			}
			if props.Disabled {
				disabled
			}
		/>
	</div>
}
