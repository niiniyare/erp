package ui

// ============================================================================
// Card Component
// ============================================================================

// CardProps defines properties for card component
type CardProps struct {
	Class string
}

// Card renders a card container
templ Card(props CardProps, children ...templ.Component) {
	<div class={ "card " + props.Class }>
		for _, child := range children {
			@child
		}
	</div>
}

// CardHeader renders card header
templ CardHeader(children ...templ.Component) {
	<div class="card-header">
		for _, child := range children {
			@child
		}
	</div>
}

// CardTitle renders card title
templ CardTitle(title string, class string) {
	<h3 class={ "card-title " + class }>{ title }</h3>
}

// CardDescription renders card description
templ CardDescription(description string) {
	<p class="card-description">{ description }</p>
}

// CardContent renders card content
templ CardContent(children ...templ.Component) {
	<div class="card-content">
		for _, child := range children {
			@child
		}
	</div>
}

// CardFooter renders card footer
templ CardFooter(children ...templ.Component) {
	<div class="card-footer">
		for _, child := range children {
			@child
		}
	</div>
}

// ============================================================================
// Alert Component
// ============================================================================

// AlertVariant represents the type of alert
type AlertVariant string

const (
	AlertVariantDefault     AlertVariant = "default"
	AlertVariantDestructive AlertVariant = "destructive"
	AlertVariantSuccess     AlertVariant = "success"
	AlertVariantWarning     AlertVariant = "warning"
	AlertVariantInfo        AlertVariant = "info"
)

// AlertProps defines properties for alert component
type AlertProps struct {
	Variant     AlertVariant
	Title       string
	Description string
	Icon        string
	Dismissible bool
	Class       string
}

// Alert renders an alert box
templ Alert(props AlertProps) {
	<div
		class={ "alert " + getAlertClasses(props.Variant) + " " + props.Class }
		role="alert"
		if props.Dismissible {
			x-data="{ show: true }"
			x-show="show"
			x-transition
		}
	>
		if props.Icon != "" {
			<i class={ props.Icon + " h-4 w-4" }></i>
		}
		<div class="flex-1">
			if props.Title != "" {
				<h5 class="font-medium leading-none tracking-tight mb-1">{ props.Title }</h5>
			}
			if props.Description != "" {
				<div class="text-sm [&_p]:leading-relaxed">{ props.Description }</div>
			}
		</div>
		if props.Dismissible {
			<button
				type="button"
				class="opacity-70 hover:opacity-100 transition-opacity"
				x-on:click="show = false"
				aria-label="Close"
			>
				<i class="fa fa-times h-4 w-4"></i>
			</button>
		}
	</div>
}

func getAlertClasses(variant AlertVariant) string {
	switch variant {
	case AlertVariantDestructive:
		return "alert-destructive"
	case AlertVariantSuccess:
		return "border-green-500/50 text-green-600 dark:border-green-500 [&>svg]:text-green-600"
	case AlertVariantWarning:
		return "border-yellow-500/50 text-yellow-600 dark:border-yellow-500 [&>svg]:text-yellow-600"
	case AlertVariantInfo:
		return "border-blue-500/50 text-blue-600 dark:border-blue-500 [&>svg]:text-blue-600"
	default:
		return ""
	}
}

// ============================================================================
// Badge Component
// ============================================================================

// BadgeVariant represents the type of badge
type BadgeVariant string

const (
	BadgeVariantDefault     BadgeVariant = "default"
	BadgeVariantSecondary   BadgeVariant = "secondary"
	BadgeVariantDestructive BadgeVariant = "destructive"
	BadgeVariantOutline     BadgeVariant = "outline"
	BadgeVariantSuccess     BadgeVariant = "success"
	BadgeVariantWarning     BadgeVariant = "warning"
)

// BadgeProps defines properties for badge component
type BadgeProps struct {
	Variant BadgeVariant
	Text    string
	Icon    string
	Class   string
}

// Badge renders a badge
templ Badge(props BadgeProps) {
	<span class={ "badge " + getBadgeClasses(props.Variant) + " " + props.Class }>
		if props.Icon != "" {
			<i class={ props.Icon + " mr-1 h-3 w-3" }></i>
		}
		{ props.Text }
	</span>
}

func getBadgeClasses(variant BadgeVariant) string {
	switch variant {
	case BadgeVariantSecondary:
		return "badge-secondary"
	case BadgeVariantDestructive:
		return "badge-destructive"
	case BadgeVariantOutline:
		return "badge-outline"
	case BadgeVariantSuccess:
		return "border-transparent bg-green-600 text-white hover:bg-green-700"
	case BadgeVariantWarning:
		return "border-transparent bg-yellow-600 text-white hover:bg-yellow-700"
	default:
		return "badge-default"
	}
}

// ============================================================================
// Form Field Component
// ============================================================================

// FormFieldProps defines properties for a complete form field
type FormFieldProps struct {
	Label       string
	Name        string
	ID          string
	Required    bool
	Description string
	Error       string
	Class       string
}

// FormField renders a complete form field with label, description, and error
templ FormField(props FormFieldProps, children ...templ.Component) {
	<div class={ "space-y-2 " + props.Class }>
		if props.Label != "" {
			@Label(LabelProps{
				For:      props.ID,
				Text:     props.Label,
				Required: props.Required,
			})
		}
		<div>
			for _, child := range children {
				@child
			}
		</div>
		if props.Description != "" {
			@FormDescription(props.Description)
		}
		if props.Error != "" {
			@FormError(props.Error)
		}
	</div>
}

// FormDescription renders help text for a form field
templ FormDescription(text string) {
	<p class="text-sm text-muted-foreground">{ text }</p>
}

// FormError renders an error message for a form field
templ FormError(text string) {
	<p class="text-sm font-medium text-destructive">{ text }</p>
}

// FormErrors renders multiple error messages
templ FormErrors(errors []string) {
	if len(errors) > 0 {
		<div class="space-y-1">
			for _, err := range errors {
				@FormError(err)
			}
		</div>
	}
}

// ============================================================================
// Form Wrapper Component
// ============================================================================

// FormProps defines properties for form component
type FormProps struct {
	Action   string
	Method   string
	Encoding string
	Class    string
	
	// HTMX attributes
	HxPost   string
	HxGet    string
	HxPut    string
	HxTarget string
	HxSwap   string
	
	// Other attributes
	ID          string
	Novalidate  bool
	Autocomplete string
}

// Form renders a form element
templ Form(props FormProps, children ...templ.Component) {
	<form
		if props.Action != "" {
			action={ props.Action }
		}
		if props.Method != "" {
			method={ props.Method }
		}
		if props.Encoding != "" {
			enctype={ props.Encoding }
		}
		class={ props.Class }
		if props.ID != "" {
			id={ props.ID }
		}
		if props.Novalidate {
			novalidate
		}
		if props.Autocomplete != "" {
			autocomplete={ props.Autocomplete }
		}
		if props.HxPost != "" {
			hx-post={ props.HxPost }
		}
		if props.HxGet != "" {
			hx-get={ props.HxGet }
		}
		if props.HxPut != "" {
			hx-put={ props.HxPut }
		}
		if props.HxTarget != "" {
			hx-target={ props.HxTarget }
		}
		if props.HxSwap != "" {
			hx-swap={ props.HxSwap }
		}
	>
		for _, child := range children {
			@child
		}
	</form>
}

// ============================================================================
// Grid and Layout Components
// ============================================================================

// GridProps defines properties for grid layout
type GridProps struct {
	Cols  int
	Gap   string
	Class string
}

// Grid renders a grid layout
templ Grid(props GridProps, children ...templ.Component) {
	<div class={ getGridClasses(props) }>
		for _, child := range children {
			@child
		}
	</div>
}

func getGridClasses(props GridProps) string {
	classes := "grid"
	
	// Default gap
	gap := props.Gap
	if gap == "" {
		gap = "gap-4"
	}
	
	// Grid columns
	switch props.Cols {
	case 1:
		classes += " grid-cols-1"
	case 2:
		classes += " grid-cols-1 md:grid-cols-2"
	case 3:
		classes += " grid-cols-1 md:grid-cols-2 lg:grid-cols-3"
	case 4:
		classes += " grid-cols-1 md:grid-cols-2 lg:grid-cols-4"
	case 6:
		classes += " grid-cols-2 md:grid-cols-3 lg:grid-cols-6"
	default:
		classes += " grid-cols-1 md:grid-cols-2"
	}
	
	classes += " " + gap
	
	if props.Class != "" {
		classes += " " + props.Class
	}
	
	return classes
}

// Stack renders a vertical stack layout
templ Stack(gap string, children ...templ.Component) {
	<div class={ "flex flex-col " + gap }>
		for _, child := range children {
			@child
		}
	</div>
}

// HStack renders a horizontal stack layout
templ HStack(gap string, children ...templ.Component) {
	<div class={ "flex items-center " + gap }>
		for _, child := range children {
			@child
		}
	</div>
}

// Separator renders a horizontal line separator
templ Separator(class string) {
	<div class={ "shrink-0 bg-border h-[1px] w-full " + class }></div>
}

// ============================================================================
// Loading and Skeleton Components
// ============================================================================

// Spinner renders a loading spinner
templ Spinner(size string) {
	<svg
		class={ "animate-spin " + size }
		xmlns="http://www.w3.org/2000/svg"
		fill="none"
		viewBox="0 0 24 24"
	>
		<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
		<path
			class="opacity-75"
			fill="currentColor"
			d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
		></path>
	</svg>
}

// LoadingSpinner renders a centered loading spinner with text
templ LoadingSpinner(text string) {
	<div class="flex flex-col items-center justify-center p-8 space-y-4">
		@Spinner("h-8 w-8")
		if text != "" {
			<p class="text-sm text-muted-foreground">{ text }</p>
		}
	</div>
}

// Skeleton renders a skeleton loading placeholder
templ Skeleton(class string) {
	<div class={ "skeleton " + class }></div>
}

// SkeletonText renders skeleton placeholder for text
templ SkeletonText(lines int) {
	<div class="space-y-2">
		for i := 0; i < lines; i++ {
			<div class="skeleton h-4 w-full"></div>
		}
	</div>
}

// SkeletonCard renders skeleton placeholder for a card
templ SkeletonCard() {
	<div class="card">
		<div class="card-header space-y-2">
			<div class="skeleton h-6 w-3/4"></div>
			<div class="skeleton h-4 w-1/2"></div>
		</div>
		<div class="card-content space-y-2">
			<div class="skeleton h-4 w-full"></div>
			<div class="skeleton h-4 w-5/6"></div>
			<div class="skeleton h-4 w-4/6"></div>
		</div>
	</div>
}
