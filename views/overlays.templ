package ui

// ============================================================================
// Modal/Dialog Component
// ============================================================================

// ModalProps defines properties for modal component
type ModalProps struct {
	ID          string
	Title       string
	Description string
	Size        string // sm, md, lg, xl, full
	Dismissible bool
	ShowFooter  bool
	Class       string
}

// Modal renders a modal dialog
templ Modal(props ModalProps, children ...templ.Component) {
	<div
		id={ props.ID }
		x-data="{ open: false }"
		x-on:open-modal.window={ "if ($event.detail.id === '" + props.ID + "') { open = true }" }
		x-on:close-modal.window={ "if ($event.detail.id === '" + props.ID + "') { open = false }" }
		x-on:keydown.escape.window="open = false"
		style="display: none;"
		x-show="open"
	>
		<!-- Overlay -->
		<div
			class="dialog-overlay"
			x-show="open"
			x-transition.opacity
			if props.Dismissible {
				x-on:click="open = false"
			}
		></div>
		
		<!-- Modal content -->
		<div
			class={ "dialog-content " + getModalSizeClass(props.Size) + " " + props.Class }
			x-show="open"
			x-transition
			x-on:click.stop
		>
			<!-- Header -->
			<div class="flex items-start justify-between">
				<div class="space-y-1">
					<h2 class="text-lg font-semibold">{ props.Title }</h2>
					if props.Description != "" {
						<p class="text-sm text-muted-foreground">{ props.Description }</p>
					}
				</div>
				if props.Dismissible {
					<button
						type="button"
						class="rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100"
						x-on:click="open = false"
					>
						<i class="fa fa-times h-4 w-4"></i>
						<span class="sr-only">Close</span>
					</button>
				}
			</div>
			
			<!-- Body -->
			<div class="mt-4">
				for _, child := range children {
					@child
				}
			</div>
		</div>
	</div>
}

func getModalSizeClass(size string) string {
	switch size {
	case "sm":
		return "max-w-sm"
	case "md":
		return "max-w-md"
	case "lg":
		return "max-w-lg"
	case "xl":
		return "max-w-xl"
	case "2xl":
		return "max-w-2xl"
	case "full":
		return "max-w-full"
	default:
		return "max-w-lg"
	}
}

// ModalFooter renders modal footer with actions
templ ModalFooter(children ...templ.Component) {
	<div class="mt-6 flex items-center justify-end space-x-2">
		for _, child := range children {
			@child
		}
	</div>
}

// ConfirmDialog renders a confirmation dialog
templ ConfirmDialog(id string, title string, message string, confirmText string, cancelText string) {
	@Modal(ModalProps{
		ID:          id,
		Title:       title,
		Dismissible: true,
		Size:        "sm",
	}) {
		<p class="text-sm">{ message }</p>
		@ModalFooter() {
			@Button(ButtonProps{
				Type:    "button",
				Variant: ButtonVariantOutline,
			}) {
				<span x-on:click="open = false">{ cancelText }</span>
			}
			@Button(ButtonProps{
				Type:    "button",
				Variant: ButtonVariantDestructive,
			}) {
				<span>{ confirmText }</span>
			}
		}
	}
}

// ============================================================================
// Dropdown Menu Component
// ============================================================================

// DropdownProps defines properties for dropdown component
type DropdownProps struct {
	ID        string
	Trigger   string
	Placement string // bottom, top, left, right
	Class     string
}

// Dropdown renders a dropdown menu
templ Dropdown(props DropdownProps, children ...templ.Component) {
	<div
		x-data="{ open: false }"
		x-on:click.away="open = false"
		class="relative inline-block text-left"
	>
		<!-- Trigger button -->
		<button
			type="button"
			x-on:click="open = !open"
			class="btn btn-outline btn-default-size"
		>
			{ props.Trigger }
			<i class="fa fa-chevron-down ml-2 h-4 w-4"></i>
		</button>
		
		<!-- Dropdown panel -->
		<div
			x-show="open"
			x-transition
			class={ "dropdown-menu-content absolute z-50 " + getDropdownPlacementClass(props.Placement) + " " + props.Class }
		>
			for _, child := range children {
				@child
			}
		</div>
	</div>
}

func getDropdownPlacementClass(placement string) string {
	switch placement {
	case "top":
		return "bottom-full mb-2 right-0"
	case "left":
		return "right-full mr-2 top-0"
	case "right":
		return "left-full ml-2 top-0"
	default: // bottom
		return "top-full mt-2 right-0"
	}
}

// DropdownItem renders a dropdown menu item
templ DropdownItem(icon string, text string, onClick string) {
	<button
		type="button"
		class="dropdown-menu-item w-full"
		x-on:click={ onClick + "; open = false" }
	>
		if icon != "" {
			<i class={ icon + " mr-2 h-4 w-4" }></i>
		}
		<span>{ text }</span>
	</button>
}

// DropdownSeparator renders a dropdown separator
templ DropdownSeparator() {
	<div class="my-1 h-px bg-border"></div>
}

// ============================================================================
// Toast Notification Component
// ============================================================================

// Toast renders a toast notification
templ Toast(variant AlertVariant, title string, description string) {
	<div
		x-data="{ show: true }"
		x-show="show"
		x-transition
		x-init="setTimeout(() => show = false, 5000)"
		class={ "toast " + getToastVariantClass(variant) }
	>
		<div class="flex-1">
			<div class="font-medium">{ title }</div>
			if description != "" {
				<div class="text-sm opacity-90">{ description }</div>
			}
		</div>
		<button
			type="button"
			class="ml-4"
			x-on:click="show = false"
		>
			<i class="fa fa-times h-4 w-4"></i>
		</button>
	</div>
}

func getToastVariantClass(variant AlertVariant) string {
	switch variant {
	case AlertVariantDestructive:
		return "toast-destructive"
	case AlertVariantSuccess:
		return "border-green-500 bg-green-50 text-green-900 dark:bg-green-900/20 dark:text-green-100"
	default:
		return ""
	}
}

// ToastContainer renders a container for toast notifications
templ ToastContainer() {
	<div
		id="toast-container"
		class="fixed bottom-4 right-4 z-50 space-y-2 w-full max-w-sm"
	>
		<!-- Toasts will be dynamically inserted here -->
	</div>
}

// ============================================================================
// Popover Component
// ============================================================================

// Popover renders a popover
templ Popover(id string, trigger string, placement string, children ...templ.Component) {
	<div
		x-data="{ open: false }"
		x-on:click.away="open = false"
		class="relative inline-block"
	>
		<button
			type="button"
			x-on:click="open = !open"
		>
			{ trigger }
		</button>
		
		<div
			x-show="open"
			x-transition
			class={ "absolute z-50 w-64 rounded-md border bg-popover p-4 text-popover-foreground shadow-md " + getDropdownPlacementClass(placement) }
		>
			for _, child := range children {
				@child
			}
		</div>
	</div>
}

// ============================================================================
// Tooltip Component
// ============================================================================

// Tooltip renders a tooltip
templ Tooltip(text string, placement string, children ...templ.Component) {
	<div
		x-data="{ show: false }"
		x-on:mouseenter="show = true"
		x-on:mouseleave="show = false"
		class="relative inline-block"
	>
		<div>
			for _, child := range children {
				@child
			}
		</div>
		
		<div
			x-show="show"
			x-transition
			class={ "absolute z-50 px-3 py-2 text-sm text-white bg-gray-900 rounded-md whitespace-nowrap " + getTooltipPlacementClass(placement) }
		>
			{ text }
			<!-- Arrow -->
			<div class={ "absolute w-2 h-2 bg-gray-900 transform rotate-45 " + getTooltipArrowClass(placement) }></div>
		</div>
	</div>
}

func getTooltipPlacementClass(placement string) string {
	switch placement {
	case "top":
		return "bottom-full mb-2 left-1/2 -translate-x-1/2"
	case "bottom":
		return "top-full mt-2 left-1/2 -translate-x-1/2"
	case "left":
		return "right-full mr-2 top-1/2 -translate-y-1/2"
	case "right":
		return "left-full ml-2 top-1/2 -translate-y-1/2"
	default:
		return "top-full mt-2 left-1/2 -translate-x-1/2"
	}
}

func getTooltipArrowClass(placement string) string {
	switch placement {
	case "top":
		return "top-full left-1/2 -translate-x-1/2 -mt-1"
	case "bottom":
		return "bottom-full left-1/2 -translate-x-1/2 -mb-1"
	case "left":
		return "left-full top-1/2 -translate-y-1/2 -ml-1"
	case "right":
		return "right-full top-1/2 -translate-y-1/2 -mr-1"
	default:
		return "bottom-full left-1/2 -translate-x-1/2 -mb-1"
	}
}

// ============================================================================
// Progress Bar Component
// ============================================================================

// Progress renders a progress bar
templ Progress(value int, max int, showLabel bool) {
	<div
		x-data={ fmt.Sprintf("{ value: %d, max: %d }", value, max) }
		class="space-y-2"
	>
		if showLabel {
			<div class="flex items-center justify-between text-sm">
				<span class="text-muted-foreground">Progress</span>
				<span class="font-medium" x-text="Math.round((value / max) * 100) + '%'"></span>
			</div>
		}
		<div class="progress">
			<div
				class="progress-indicator"
				x-bind:style={ "'width: ' + ((value / max) * 100) + '%'" }
			></div>
		</div>
	</div>
}

// ============================================================================
// Breadcrumb Component
// ============================================================================

// BreadcrumbItem represents a breadcrumb item
type BreadcrumbItem struct {
	Label string
	Href  string
}

// Breadcrumb renders a breadcrumb navigation
templ Breadcrumb(items []BreadcrumbItem) {
	<nav aria-label="Breadcrumb">
		<ol class="flex items-center space-x-2 text-sm text-muted-foreground">
			for i, item := range items {
				<li class="flex items-center">
					if i > 0 {
						<i class="fa fa-chevron-right mx-2 h-4 w-4"></i>
					}
					if item.Href != "" {
						<a
							href={ templ.URL(item.Href) }
							class="hover:text-foreground transition-colors"
						>
							{ item.Label }
						</a>
					} else {
						<span class="font-medium text-foreground">{ item.Label }</span>
					}
				</li>
			}
		</ol>
	</nav>
}
