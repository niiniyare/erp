// HiddenFieldRenderer renders a hidden input field
templ HiddenFieldRenderer(field *schema.Field, value any) {
	@Input(InputProps{
		Type:  InputTypeHidden,
		Name:  field.Name,
		Value: fmt.Sprintf("%v", value),
	})
}

// TextareaFieldRenderer renders a textarea field
templ TextareaFieldRenderer(field *schema.Field, value any, errors []string) {
	@FormField(FormFieldProps{
		Label:       field.Label,
		Name:        field.Name,
		ID:          field.Name,
		Required:    field.Required,
		Description: field.Hint,
		Error:       getFirstError(errors),
	}) {
		if field.Config != nil && field.Config["showCount"] == true {
			@TextareaWithCounter(TextareaProps{
				Name:        field.Name,
				ID:          field.Name,
				Value:       fmt.Sprintf("%v", value),
				Placeholder: field.Placeholder,
				Required:    field.Required,
				Disabled:    field.Readonly,
				Rows:        getConfigInt(field, "rows", 4),
				MaxLength:   getValidationInt(field, "maxLength"),
				AriaInvalid: len(errors) > 0,
			})
		} else {
			@Textarea(TextareaProps{
				Name:        field.Name,
				ID:          field.Name,
				Value:       fmt.Sprintf("%v", value),
				Placeholder: field.Placeholder,
				Required:    field.Required,
				Disabled:    field.Readonly,
				Rows:        getConfigInt(field, "rows", 4),
				MaxLength:   getValidationInt(field, "maxLength"),
				AriaInvalid: len(errors) > 0,
			})
		}
	}
}

// SelectFieldRenderer renders a select dropdown field
templ SelectFieldRenderer(field *schema.Field, value any, errors []string) {
	@FormField(FormFieldProps{
		Label:       field.Label,
		Name:        field.Name,
		ID:          field.Name,
		Required:    field.Required,
		Description: field.Hint,
		Error:       getFirstError(errors),
	}) {
		@Select(SelectProps{
			Name:        field.Name,
			ID:          field.Name,
			Options:     convertToSelectOptions(field.Options, fmt.Sprintf("%v", value)),
			Required:    field.Required,
			Disabled:    field.Readonly,
			Multiple:    getConfigBool(field, "multiple"),
			Placeholder: field.Placeholder,
		})
	}
}

// CheckboxFieldRenderer renders a single checkbox field
templ CheckboxFieldRenderer(field *schema.Field, value any, errors []string) {
	@FormField(FormFieldProps{
		Name:        field.Name,
		ID:          field.Name,
		Description: field.Hint,
		Error:       getFirstError(errors),
	}) {
		@CheckboxWithLabel(CheckboxProps{
			Name:        field.Name,
			ID:          field.Name,
			Checked:     value == true || value == "true" || value == "1",
			Required:    field.Required,
			Disabled:    field.Readonly,
			AriaInvalid: len(errors) > 0,
		}, field.Label)
	}
}

// CheckboxesFieldRenderer renders multiple checkboxes
templ CheckboxesFieldRenderer(field *schema.Field, value any, errors []string) {
	@FormField(FormFieldProps{
		Label:       field.Label,
		Name:        field.Name,
		Required:    field.Required,
		Description: field.Hint,
		Error:       getFirstError(errors),
	}) {
		<div class={ templ.KV("space-y-2", !getConfigBool(field, "inline")) + templ.KV("flex space-x-4", getConfigBool(field, "inline")) }>
			for _, option := range field.Options {
				@CheckboxWithLabel(CheckboxProps{
					Name:  field.Name + "[]",
					ID:    fmt.Sprintf("%s-%s", field.Name, option.Value),
					Value: option.Value,
					Checked: isValueSelected(value, option.Value),
					Disabled: field.Readonly,
				}, option.Label)
			}
		</div>
	}
}

// RadioFieldRenderer renders radio buttons
templ RadioFieldRenderer(field *schema.Field, value any, errors []string) {
	@FormField(FormFieldProps{
		Label:       field.Label,
		Name:        field.Name,
		Required:    field.Required,
		Description: field.Hint,
		Error:       getFirstError(errors),
	}) {
		@RadioGroup(field.Name, convertToSelectOptions(field.Options, fmt.Sprintf("%v", value)), fmt.Sprintf("%v", value), getConfigBool(field, "inline"))
	}
}

// SwitchFieldRenderer renders a switch toggle
templ SwitchFieldRenderer(field *schema.Field, value any, errors []string) {
	@FormField(FormFieldProps{
		Name:        field.Name,
		ID:          field.Name,
		Description: field.Hint,
		Error:       getFirstError(errors),
	}) {
		@SwitchWithLabel(SwitchProps{
			Name:     field.Name,
			ID:       field.Name,
			Checked:  value == true || value == "true" || value == "1",
			Disabled: field.Readonly,
		}, field.Label)
	}
}

