// CurrencyFieldRenderer renders a currency input field
templ CurrencyFieldRenderer(field *schema.Field, value any, errors []string) {
	@FormField(FormFieldProps{
		Label:       field.Label,
		Name:        field.Name,
		ID:          field.Name,
		Required:    field.Required,
		Description: field.Hint,
		Error:       getFirstError(errors),
	}) {
		@CurrencyInput(InputProps{
			Type:        InputTypeNumber,
			Name:        field.Name,
			ID:          field.Name,
			Value:       fmt.Sprintf("%v", value),
			Placeholder: field.Placeholder,
			Required:    field.Required,
			Disabled:    field.Readonly,
			Min:         getValidationString(field, "min"),
			Max:         getValidationString(field, "max"),
			AriaInvalid: len(errors) > 0,
		}, getConfigString(field, "currency", "USD"), getConfigString(field, "symbol", "$"))
	}
}

// Helper functions
func getFirstError(errors []string) string {
	if len(errors) > 0 {
		return errors[0]
	}
	return ""
}

func getValidationInt(field *schema.Field, key string) int {
	if field.Validation == nil {
		return 0
	}
	// Implementation depends on your schema.Validation structure
	return 0
}

func getValidationString(field *schema.Field, key string) string {
	if field.Validation == nil {
		return ""
	}
	// Implementation depends on your schema.Validation structure
	return ""
}

func getConfigInt(field *schema.Field, key string, defaultValue int) int {
	if field.Config == nil {
		return defaultValue
	}
	if val, ok := field.Config[key].(int); ok {
		return val
	}
	return defaultValue
}

func getConfigString(field *schema.Field, key string, defaultValue string) string {
	if field.Config == nil {
		return defaultValue
	}
	if val, ok := field.Config[key].(string); ok {
		return val
	}
	return defaultValue
}

func getConfigBool(field *schema.Field, key string) bool {
	if field.Config == nil {
		return false
	}
	if val, ok := field.Config[key].(bool); ok {
		return val
	}
	return false
}

func convertToSelectOptions(options []schema.Option, selectedValue string) []SelectOption {
	result := make([]SelectOption, len(options))
	for i, opt := range options {
		result[i] = SelectOption{
			Value:    opt.Value,
			Label:    opt.Label,
			Disabled: opt.Disabled,
			Selected: opt.Value == selectedValue,
		}
	}
	return result
}

func isValueSelected(value any, optionValue string) bool {
	// Handle different value types (string, []string, etc.)
	switch v := value.(type) {
	case string:
		return v == optionValue
	case []string:
		for _, val := range v {
			if val == optionValue {
				return true
			}
		}
	case []interface{}:
		for _, val := range v {
			if fmt.Sprintf("%v", val) == optionValue {
				return true
			}
		}
	}
	return false
}
