// NumberFieldRenderer renders a number input field
templ NumberFieldRenderer(field *schema.Field, value any, errors []string) {
	@FormField(FormFieldProps{
		Label:       field.Label,
		Name:        field.Name,
		ID:          field.Name,
		Required:    field.Required,
		Description: field.Hint,
		Error:       getFirstError(errors),
	}) {
		if field.Config != nil && field.Config["showStepper"] == true {
			@NumberInput(InputProps{
				Type:        InputTypeNumber,
				Name:        field.Name,
				ID:          field.Name,
				Value:       fmt.Sprintf("%v", value),
				Placeholder: field.Placeholder,
				Required:    field.Required,
				Disabled:    field.Readonly,
				Min:         getValidationString(field, "min"),
				Max:         getValidationString(field, "max"),
				Step:        getValidationString(field, "step"),
				AriaInvalid: len(errors) > 0,
			}, true)
		} else {
			@Input(InputProps{
				Type:        InputTypeNumber,
				Name:        field.Name,
				ID:          field.Name,
				Value:       fmt.Sprintf("%v", value),
				Placeholder: field.Placeholder,
				Required:    field.Required,
				Disabled:    field.Readonly,
				Min:         getValidationString(field, "min"),
				Max:         getValidationString(field, "max"),
				Step:        getValidationString(field, "step"),
				AriaInvalid: len(errors) > 0,
			})
		}
	}
}

