package ui

import (
	"fmt"
	"github.com/niiniyare/erp/pkg/schema"
)

// FieldRenderer is the main component that renders any field based on its type
templ FieldRenderer(field *schema.Field, value any, errors []string) {
	// Check if field should be visible based on runtime settings
	if field.Runtime != nil && !field.Runtime.Visible {
		// Field is hidden
		@Input(InputProps{
			Type: InputTypeHidden,
			Name: field.Name,
			Value: fmt.Sprintf("%v", value),
		})
	} else {
		// Render based on field type
		switch field.Type {
		case schema.FieldTypeText:
			@TextFieldRenderer(field, value, errors)
		case schema.FieldTypeEmail:
			@EmailFieldRenderer(field, value, errors)
		case schema.FieldTypePassword:
			@PasswordFieldRenderer(field, value, errors)
		case schema.FieldTypeNumber:
			@NumberFieldRenderer(field, value, errors)
		case schema.FieldTypePhone:
			@PhoneFieldRenderer(field, value, errors)
		case schema.FieldTypeURL:
			@URLFieldRenderer(field, value, errors)
		case schema.FieldTypeHidden:
			@HiddenFieldRenderer(field, value)
		case schema.FieldTypeTextarea:
			@TextareaFieldRenderer(field, value, errors)
		case schema.FieldTypeSelect:
			@SelectFieldRenderer(field, value, errors)
		case schema.FieldTypeRadio:
			@RadioFieldRenderer(field, value, errors)
		case schema.FieldTypeCheckbox:
			@CheckboxFieldRenderer(field, value, errors)
		case schema.FieldTypeCheckboxes:
			@CheckboxesFieldRenderer(field, value, errors)
		case schema.FieldTypeSwitch:
			@SwitchFieldRenderer(field, value, errors)
		case schema.FieldTypeDate:
			@DateFieldRenderer(field, value, errors)
		case schema.FieldTypeTime:
			@TimeFieldRenderer(field, value, errors)
		case schema.FieldTypeDatetime:
			@DatetimeFieldRenderer(field, value, errors)
		case schema.FieldTypeCurrency:
			@CurrencyFieldRenderer(field, value, errors)
		case schema.FieldTypeFile:
			@FileFieldRenderer(field, value, errors)
		case schema.FieldTypeImage:
			@ImageFieldRenderer(field, value, errors)
		case schema.FieldTypeTags:
			@TagsFieldRenderer(field, value, errors)
		case schema.FieldTypeRating:
			@RatingFieldRenderer(field, value, errors)
		case schema.FieldTypeSlider:
			@SliderFieldRenderer(field, value, errors)
		case schema.FieldTypeRepeatable:
			@RepeatableFieldRenderer(field, value, errors)
		default:
			@TextFieldRenderer(field, value, errors)
		}
	}
}

// TextFieldRenderer renders a text input field
templ TextFieldRenderer(field *schema.Field, value any, errors []string) {
	@FormField(FormFieldProps{
		Label:       field.Label,
		Name:        field.Name,
		ID:          field.Name,
		Required:    field.Required,
		Description: field.Hint,
		Error:       getFirstError(errors),
	}) {
		if field.Config != nil && field.Config["prefix"] != nil {
			@InputWithIcon(InputProps{
				Type:        InputTypeText,
				Name:        field.Name,
				ID:          field.Name,
				Value:       fmt.Sprintf("%v", value),
				Placeholder: field.Placeholder,
				Required:    field.Required,
				Disabled:    field.Readonly || (field.Runtime != nil && !field.Runtime.Editable),
				MinLength:   getValidationInt(field, "minLength"),
				MaxLength:   getValidationInt(field, "maxLength"),
				Pattern:     getValidationString(field, "pattern"),
				AriaInvalid: len(errors) > 0,
			}, fmt.Sprintf("%v", field.Config["prefix"]), "left")
		} else if field.Config != nil && field.Config["suffix"] != nil {
			@InputWithIcon(InputProps{
				Type:        InputTypeText,
				Name:        field.Name,
				ID:          field.Name,
				Value:       fmt.Sprintf("%v", value),
				Placeholder: field.Placeholder,
				Required:    field.Required,
				Disabled:    field.Readonly || (field.Runtime != nil && !field.Runtime.Editable),
				MinLength:   getValidationInt(field, "minLength"),
				MaxLength:   getValidationInt(field, "maxLength"),
				Pattern:     getValidationString(field, "pattern"),
				AriaInvalid: len(errors) > 0,
			}, fmt.Sprintf("%v", field.Config["suffix"]), "right")
		} else {
			@Input(InputProps{
				Type:        InputTypeText,
				Name:        field.Name,
				ID:          field.Name,
				Value:       fmt.Sprintf("%v", value),
				Placeholder: field.Placeholder,
				Required:    field.Required,
				Disabled:    field.Readonly || (field.Runtime != nil && !field.Runtime.Editable),
				MinLength:   getValidationInt(field, "minLength"),
				MaxLength:   getValidationInt(field, "maxLength"),
				Pattern:     getValidationString(field, "pattern"),
				AriaInvalid: len(errors) > 0,
			})
		}
	}
}

// EmailFieldRenderer renders an email input field
templ EmailFieldRenderer(field *schema.Field, value any, errors []string) {
	@FormField(FormFieldProps{
		Label:       field.Label,
		Name:        field.Name,
		ID:          field.Name,
		Required:    field.Required,
		Description: field.Hint,
		Error:       getFirstError(errors),
	}) {
		@Input(InputProps{
			Type:        InputTypeEmail,
			Name:        field.Name,
			ID:          field.Name,
			Value:       fmt.Sprintf("%v", value),
			Placeholder: field.Placeholder,
			Required:    field.Required,
			Disabled:    field.Readonly,
			MaxLength:   255,
			Autocomplete: "email",
			AriaInvalid: len(errors) > 0,
		})
	}
}

