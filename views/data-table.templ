package ui

import (
	"fmt"
	"github.com/niiniyare/erp/pkg/schema"
)

// ============================================================================
// DataTable Configuration
// ============================================================================

// DataTableProps defines properties for the DataTable component
type DataTableProps struct {
	ID              string
	Schema          *schema.Schema
	Data            []map[string]any
	TotalCount      int
	ServerSide      bool // If true, pagination/sorting/filtering happens server-side
	
	// Simple DataTables options
	SearchEnabled   bool
	SortEnabled     bool
	PaginationEnabled bool
	PerPage         int
	PerPageSelect   []int
	
	// Features
	SelectableRows  bool
	ColumnToggle    bool
	ExportEnabled   bool
	FixedHeader     bool
	FixedColumns    int
	
	// Styling
	Classes         string
	
	// Server-side URLs (for HTMX)
	SearchURL       string
	SortURL         string
	PaginationURL   string
	
	// Callbacks
	OnRowClick      string // Alpine.js expression
	OnSelect        string // Alpine.js expression
}

// DataTable renders a feature-rich data table using Simple DataTables
templ DataTable(props DataTableProps) {
	<div
		id={ props.ID }
		class={ "dataTable-wrapper " + props.Classes }
		x-data={ fmt.Sprintf(`{
			table: null,
			selected: [],
			bulkActionsOpen: false,
			columnToggleOpen: false,
			exportMenuOpen: false,
			init() {
				this.$nextTick(() => {
					this.initTable();
				});
			},
			initTable() {
				const options = {
					searchable: %t,
					sortable: %t,
					perPage: %d,
					perPageSelect: %v,
					fixedHeight: %t,
					fixedColumns: %d,
					labels: {
						placeholder: "Search...",
						perPage: "Show {select} entries",
						noRows: "No entries found",
						info: "Showing {start} to {end} of {rows} entries",
					},
					classes: {
						active: 'active',
						disabled: 'disabled'
					}
				};
				
				this.table = new simpleDatatables.DataTable('#%s-table', options);
				
				// Row click handler
				if (%t) {
					this.table.on('datatable.selectrow', (rowIndex, event) => {
						const rowData = this.table.data.data[rowIndex];
						%s
					});
				}
				
				// Selection handler
				this.table.on('datatable.select', (selected) => {
					this.selected = selected.map(idx => this.table.data.data[idx]);
					%s
				});
			},
			selectAll() {
				this.table.rows().select();
			},
			deselectAll() {
				this.table.rows().deselect();
			},
			exportData(format) {
				const options = {
					filename: '%s_export',
					download: true
				};
				
				switch(format) {
					case 'csv':
						this.table.export({ type: 'csv', ...options });
						break;
					case 'json':
						this.table.export({ type: 'json', ...options });
						break;
					case 'sql':
						this.table.export({ type: 'sql', ...options });
						break;
					case 'txt':
						this.table.export({ type: 'txt', ...options });
						break;
				}
				this.exportMenuOpen = false;
			},
			toggleColumn(columnIndex) {
				this.table.columns().hide([columnIndex]);
			},
			refresh() {
				this.table.refresh();
			}
		}`, 
			props.SearchEnabled,
			props.SortEnabled,
			props.PerPage,
			props.PerPageSelect,
			props.FixedHeader,
			props.FixedColumns,
			props.ID,
			props.OnRowClick != "",
			props.OnRowClick,
			props.OnSelect,
			props.Schema.ID,
		) }
	>
		<!-- Top Toolbar -->
		@DataTableToolbar(props)
		
		<!-- Bulk Actions Bar (shown when rows selected) -->
		<div x-show="selected.length > 0" x-transition class="dataTable-bulk-actions">
			<span class="dataTable-bulk-actions-text" x-text="`${selected.length} row(s) selected`"></span>
			<div class="dataTable-bulk-actions-buttons">
				@BulkActions(props.Schema)
				<button
					type="button"
					class="btn btn-ghost btn-sm"
					x-on:click="deselectAll()"
				>
					Clear
				</button>
			</div>
		</div>
		
		<!-- Filters (if defined in schema) -->
		if props.Schema.Filter != nil && len(props.Schema.Filter.Fields) > 0 {
			@DataTableFilters(props.Schema)
		}
		
		<!-- Table -->
		<div class="dataTable-container">
			<table id={ props.ID + "-table" } class="dataTable-table">
				<thead>
					<tr>
						if props.SelectableRows {
							<th data-sortable="false">
								<input
									type="checkbox"
									class="checkbox"
									x-on:change="$event.target.checked ? selectAll() : deselectAll()"
								/>
							</th>
						}
						for _, col := range props.Schema.Columns {
							<th
								if !col.Sortable {
									data-sortable="false"
								}
							>
								{ col.Label }
							</th>
						}
						if len(props.Schema.ItemActions) > 0 {
							<th data-sortable="false" class="text-right">Actions</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, row := range props.Data {
						<tr>
							if props.SelectableRows {
								<td>
									<input type="checkbox" class="checkbox"/>
								</td>
							}
							for _, col := range props.Schema.Columns {
								<td class={ getCellClass(col) }>
									@RenderCell(col, row[col.Name])
								</td>
							}
							if len(props.Schema.ItemActions) > 0 {
								<td class="text-right">
									@RowActions(props.Schema.ItemActions, row)
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

// DataTableToolbar renders the top toolbar with search, filters, and actions
templ DataTableToolbar(props DataTableProps) {
	<div class="flex items-center justify-between p-4 border-b bg-card">
		<!-- Left side: Title and description -->
		<div>
			<h2 class="text-xl font-semibold">{ props.Schema.Title }</h2>
			if props.Schema.Description != "" {
				<p class="text-sm text-muted-foreground">{ props.Schema.Description }</p>
			}
		</div>
		
		<!-- Right side: Actions -->
		<div class="flex items-center gap-2">
			<!-- Column Toggle -->
			if props.ColumnToggle {
				<div class="relative" x-data="{ open: false }">
					<button
						type="button"
						class="btn btn-outline btn-sm"
						x-on:click="open = !open"
						x-on:click.away="open = false"
					>
						<i class="fa fa-columns mr-2"></i>
						Columns
					</button>
					<div
						x-show="open"
						x-transition
						class="absolute right-0 mt-2 w-56 dropdown-menu-content"
					>
						for i, col := range props.Schema.Columns {
							<label class="dropdown-menu-item">
								<input
									type="checkbox"
									class="checkbox mr-2"
									checked
									x-on:change={ fmt.Sprintf("toggleColumn(%d)", i) }
								/>
								{ col.Label }
							</label>
						}
					</div>
				</div>
			}
			
			<!-- Export Menu -->
			if props.ExportEnabled {
				<div class="relative" x-data="{ open: false }">
					<button
						type="button"
						class="btn btn-outline btn-sm"
						x-on:click="open = !open"
						x-on:click.away="open = false"
					>
						<i class="fa fa-download mr-2"></i>
						Export
					</button>
					<div
						x-show="open"
						x-transition
						class="absolute right-0 mt-2 w-48 dropdown-menu-content"
					>
						<button
							type="button"
							class="dropdown-menu-item w-full"
							x-on:click="exportData('csv')"
						>
							<i class="fa fa-file-csv mr-2"></i>
							Export as CSV
						</button>
						<button
							type="button"
							class="dropdown-menu-item w-full"
							x-on:click="exportData('json')"
						>
							<i class="fa fa-file-code mr-2"></i>
							Export as JSON
						</button>
						<button
							type="button"
							class="dropdown-menu-item w-full"
							x-on:click="exportData('sql')"
						>
							<i class="fa fa-database mr-2"></i>
							Export as SQL
						</button>
						<button
							type="button"
							class="dropdown-menu-item w-full"
							x-on:click="exportData('txt')"
						>
							<i class="fa fa-file-alt mr-2"></i>
							Export as TXT
						</button>
					</div>
				</div>
			}
			
			<!-- Refresh Button -->
			<button
				type="button"
				class="btn btn-outline btn-sm"
				x-on:click="refresh()"
			>
				<i class="fa fa-refresh"></i>
			</button>
			
			<!-- Schema Actions (Add New, etc.) -->
			for _, action := range props.Schema.Actions {
				@Button(ButtonProps{
					Type:    "button",
					Variant: getActionButtonVariant(action.Level),
					Size:    ButtonSizeSm,
					HxGet:   action.Link,
				}) {
					if action.Icon != "" {
						<i class={ action.Icon + " mr-2" }></i>
					}
					<span>{ action.Text }</span>
				}
			}
		</div>
	</div>
}

// DataTableFilters renders advanced filters
templ DataTableFilters(s *schema.Schema) {
	<div
		class="dataTable-filters"
		x-data="{ filtersOpen: false }"
	>
		<button
			type="button"
			class="btn btn-outline btn-sm"
			x-on:click="filtersOpen = !filtersOpen"
		>
			<i class="fa fa-filter mr-2"></i>
			<span x-text="filtersOpen ? 'Hide Filters' : 'Show Filters'"></span>
		</button>
		
		<div
			x-show="filtersOpen"
			x-collapse
			class="flex flex-wrap gap-4 w-full mt-4"
		>
			for i := range s.Filter.Fields {
				field := &s.Filter.Fields[i]
				<div class="dataTable-filter">
					@FieldRenderer(field, nil, nil)
				</div>
			}
			<div class="flex items-end gap-2">
				<button type="button" class="btn btn-default btn-sm">
					Apply Filters
				</button>
				<button type="button" class="btn btn-outline btn-sm">
					Clear
				</button>
			</div>
		</div>
	</div>
}

// RenderCell renders a table cell based on column type
templ RenderCell(col schema.Column, value any) {
	switch col.Type {
	case "badge", "status":
		@Badge(BadgeProps{
			Text:    fmt.Sprintf("%v", value),
			Variant: getBadgeVariantFromValue(value),
		})
	case "boolean":
		if value == true || value == "true" || value == 1 {
			<i class="fa fa-check text-green-600"></i>
		} else {
			<i class="fa fa-times text-red-600"></i>
		}
	case "currency":
		<span class="font-mono">${ formatCurrency(value) }</span>
	case "date":
		<span class="text-muted-foreground">{ formatDate(value) }</span>
	case "datetime":
		<span class="text-muted-foreground">{ formatDateTime(value) }</span>
	case "image":
		<img src={ fmt.Sprintf("%v", value) } alt="" class="w-10 h-10 rounded object-cover"/>
	case "number":
		<span class="font-mono">{ formatNumber(value) }</span>
	case "link":
		<a href={ templ.URL(fmt.Sprintf("%v", value)) } class="text-primary hover:underline">
			{ fmt.Sprintf("%v", value) }
		</a>
	case "email":
		<a href={ templ.URL(fmt.Sprintf("mailto:%v", value)) } class="text-primary hover:underline">
			{ fmt.Sprintf("%v", value) }
		</a>
	case "progress":
		@Progress(int(value.(float64)), 100, false)
	default:
		if col.Template != "" {
			// Render custom template
			@templ.Raw(renderTemplate(col.Template, value))
		} else {
			<span>{ fmt.Sprintf("%v", value) }</span>
		}
	}
}

// RowActions renders action buttons for a table row
templ RowActions(actions []schema.Action, row map[string]any) {
	<div class="dataTable-actions">
		for _, action := range actions {
			if shouldShowAction(action, row) {
				if action.Type == "link" {
					<a
						href={ templ.URL(interpolateURL(action.Link, row)) }
						class="btn btn-ghost btn-icon h-8 w-8"
						title={ action.Text }
					>
						<i class={ action.Icon }></i>
					</a>
				} else {
					<button
						type="button"
						class={ "btn btn-ghost btn-icon h-8 w-8 " + getActionClass(action.Level) }
						title={ action.Text }
						if action.Confirm != "" {
							x-on:click={ fmt.Sprintf("confirm('%s') && fetch('%s', {method: '%s'})", action.Confirm, interpolateURL(action.Link, row), action.Method) }
						} else {
							hx-request={ action.Method + ":" + interpolateURL(action.Link, row) }
						}
					>
						<i class={ action.Icon }></i>
					</button>
				}
			}
		}
	</div>
}

// BulkActions renders bulk action buttons
templ BulkActions(s *schema.Schema) {
	for _, action := range s.BulkActions {
		<button
			type="button"
			class={ "btn btn-sm " + getBulkActionClass(action.Level) }
			x-on:click={ fmt.Sprintf("confirm('%s') && bulkAction('%s', selected)", action.Confirm, action.Link) }
		>
			if action.Icon != "" {
				<i class={ action.Icon + " mr-2" }></i>
			}
			{ action.Text }
		</button>
	}
}

// Helper functions
func getCellClass(col schema.Column) string {
	classes := ""
	switch col.Type {
	case "currency", "number":
		classes += "text-right font-mono"
	case "boolean":
		classes += "text-center"
	case "date", "datetime":
		classes += "text-muted-foreground"
	}
	if col.ClassName != "" {
		classes += " " + col.ClassName
	}
	return classes
}

func getActionButtonVariant(level string) ButtonVariant {
	switch level {
	case "primary":
		return ButtonVariantDefault
	case "secondary":
		return ButtonVariantSecondary
	case "danger":
		return ButtonVariantDestructive
	default:
		return ButtonVariantDefault
	}
}

func getBadgeVariantFromValue(value any) BadgeVariant {
	str := fmt.Sprintf("%v", value)
	switch str {
	case "active", "success", "completed", "approved":
		return BadgeVariantSuccess
	case "pending", "warning":
		return BadgeVariantWarning
	case "error", "failed", "rejected":
		return BadgeVariantDestructive
	default:
		return BadgeVariantDefault
	}
}

func getActionClass(level string) string {
	switch level {
	case "danger":
		return "text-destructive hover:text-destructive"
	default:
		return ""
	}
}

func getBulkActionClass(level string) string {
	switch level {
	case "danger":
		return "btn-destructive"
	default:
		return "btn-outline"
	}
}

func shouldShowAction(action schema.Action, row map[string]any) bool {
	if action.VisibleOn == "" {
		return true
	}
	// TODO: Evaluate condition using your condition package
	return true
}

func interpolateURL(url string, row map[string]any) string {
	// Replace ${field} with row[field]
	// TODO: Implement proper template interpolation
	return url
}

func renderTemplate(template string, value any) string {
	// TODO: Implement template rendering
	return fmt.Sprintf("%v", value)
}

