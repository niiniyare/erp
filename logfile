	-- Currency Exchange Table
	CREATE TABLE currency_exchange (
	    id SERIAL PRIMARY KEY,
	    name VARCHAR(255) UNIQUE NOT NULL,
	    
	    -- Multi-tenancy fields
	    tenant_id INT NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
	    entity_id INT NOT NULL REFERENCES entities(id) ON DELETE CASCADE,
	    
	    -- Core exchange rate fields
	    date DATE NOT NULL,
	    from_currency VARCHAR(3) NOT NULL REFERENCES currency(currency_code) ON DELETE RESTRICT,
	    to_currency VARCHAR(3) NOT NULL REFERENCES currency(currency_code) ON DELETE RESTRICT,
	    exchange_rate DECIMAL(15,9) NOT NULL, -- High precision for exchange rates
	    
	    -- Usage flags
	    for_buying BOOLEAN NOT NULL DEFAULT TRUE,
	    for_selling BOOLEAN NOT NULL DEFAULT TRUE,
	    
	    -- System fields
	    docstatus SMALLINT NOT NULL DEFAULT 0, -- 0=Draft, 1=Submitted, 2=Cancelled
	    creation TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
	    modified TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
	    -- modified_by VARCHAR(255) NOT NULL DEFAULT 'Administrator',
	    -- owner VARCHAR(255) NOT NULL DEFAULT 'Administrator',
	    
	    -- Constraints
	    CONSTRAINT chk_exchange_rate_positive CHECK (exchange_rate > 0),
	    CONSTRAINT chk_different_currencies CHECK (from_currency != to_currency),
	    CONSTRAINT chk_docstatus CHECK (docstatus IN (0, 1, 2)),
	    
	    -- Unique constraint to prevent duplicate rates for same date and currency pair
	    CONSTRAINT uk_currency_exchange_date_currencies UNIQUE (tenant_id, entity_id, date, from_currency, to_currency, for_buying, for_selling)
	);
	
	-- Indexes for better performance
	CREATE INDEX idx_currency_exchange_tenant_entity ON currency_exchange(tenant_id, entity_id);
	CREATE INDEX idx_currency_exchange_date ON currency_exchange(date DESC);
	CREATE INDEX idx_currency_exchange_from_currency ON currency_exchange(from_currency);
	CREATE INDEX idx_currency_exchange_to_currency ON currency_exchange(to_currency);
	CREATE INDEX idx_currency_exchange_lookup ON currency_exchange(tenant_id, entity_id, from_currency, to_currency, date DESC);
	
