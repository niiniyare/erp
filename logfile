	-- Currency Table (Master data for currencies)
	CREATE TABLE currency (
	    id SERIAL PRIMARY KEY,
	    name VARCHAR(255) UNIQUE NOT NULL,
	    
	    -- Multi-tenancy fields
	    tenant_id INT NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
	    entity_id INT NOT NULL REFERENCES entities(id) ON DELETE CASCADE,
	    
	    -- Core currency fields
	    currency_code VARCHAR(3) NOT NULL, -- ISO 4217 currency code (USD, EUR, etc.)
	    currency_name VARCHAR(100) NOT NULL, -- Full name (US Dollar, Euro, etc.)
	    currency_symbol VARCHAR(10), -- Symbol ($, €, £, etc.)
	    fraction VARCHAR(50) DEFAULT 'Cent', -- Fraction unit name
	    fraction_units SMALLINT DEFAULT 100, -- Number of fraction units (100 cents = 1 dollar)
	    
	    -- Display settings
	    -- number_format VARCHAR(50) DEFAULT '#,###.##',
	    smallest_currency_fraction_value DECIMAL(10,6) DEFAULT 0.01,
	    
	    -- Status
	    enabled BOOLEAN NOT NULL DEFAULT TRUE,
	    
	    -- System fields
	    docstatus SMALLINT NOT NULL DEFAULT 0, -- 0=Draft, 1=Submitted, 2=Cancelled
	    creation TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
	    modified TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
	    
	    -- Constraints
	    CONSTRAINT chk_currency_code_format CHECK (currency_code ~ '^[A-Z]{3}$'),
	    CONSTRAINT chk_fraction_units_positive CHECK (fraction_units > 0),
	    CONSTRAINT chk_docstatus_currency CHECK (docstatus IN (0, 1, 2)),
	    
	    -- Unique constraint for currency code within tenant/entity
	    CONSTRAINT uk_currency_code_tenant_entity UNIQUE (tenant_id, entity_id, currency_code)
	);
	
	-- Indexes for currency table
	CREATE INDEX idx_currency_tenant_entity ON currency(tenant_id, entity_id);
	CREATE INDEX idx_currency_code ON currency(currency_code);
	CREATE INDEX idx_currency_enabled ON currency(enabled) WHERE enabled = TRUE;
	
