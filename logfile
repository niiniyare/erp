	CREATE OR REPLACE FUNCTION update_currency_exchange_modified()
	RETURNS TRIGGER AS $$
	BEGIN
	    NEW.modified = CURRENT_TIMESTAMP;
	    RETURN NEW;
	END;
	$$ LANGUAGE plpgsql;
	
