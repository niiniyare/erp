	-- Function to get conversion factor between two UOMs (tenant-aware)
	CREATE OR REPLACE FUNCTION get_conversion_factor(
	    p_tenant_id INTEGER,
	    p_entity_id INTEGER,
	    from_uom_id INTEGER, 
	    to_uom_id INTEGER
	)
	RETURNS DECIMAL(15,6) AS $$
	DECLARE
	    factor DECIMAL(15,6);
	    from_base_factor DECIMAL(15,6);
	    to_base_factor DECIMAL(15,6);
	    from_base_id INTEGER;
	    to_base_id INTEGER;
	BEGIN
	    -- If same UOM, return 1
	    IF from_uom_id = to_uom_id THEN
	        RETURN 1.0;
	    END IF;
	    
	    -- Check direct conversion first
	    SELECT conversion_factor INTO factor 
	    FROM uom_conversion 
	    WHERE tenant_id = p_tenant_id 
	      AND entity_id = p_entity_id
	      AND from_uom_id = get_conversion_factor.from_uom_id 
	      AND to_uom_id = get_conversion_factor.to_uom_id;
	    
	    IF FOUND THEN
	        RETURN factor;
	    END IF;
	    
	    -- Try indirect conversion through base units
	    SELECT COALESCE(base_uom_id, id), conversion_factor 
	    INTO from_base_id, from_base_factor
	    FROM uom 
	    WHERE id = from_uom_id 
	      AND tenant_id = p_tenant_id 
	      AND entity_id = p_entity_id;
	    
	    SELECT COALESCE(base_uom_id, id), conversion_factor 
	    INTO to_base_id, to_base_factor
	    FROM uom 
	    WHERE id = to_uom_id 
	      AND tenant_id = p_tenant_id 
	      AND entity_id = p_entity_id;
	    
	    -- If both have same base unit, calculate conversion
	    IF from_base_id = to_base_id THEN
	        RETURN from_base_factor / to_base_factor;
	    END IF;
	    
	    -- No conversion found
	    RETURN NULL;
	END;
	$$ LANGUAGE plpgsql;
	
	-- Function to convert quantity between UOMs (tenant-aware)
	CREATE OR REPLACE FUNCTION convert_quantity(
	    p_tenant_id INTEGER,
	    p_entity_id INTEGER,
	    quantity DECIMAL(15,6), 
	    from_uom_id INTEGER, 
	    to_uom_id INTEGER
	) RETURNS DECIMAL(15,6) AS $$
	DECLARE
	    factor DECIMAL(15,6);
	BEGIN
	    factor := get_conversion_factor(p_tenant_id, p_entity_id, from_uom_id, to_uom_id);
	    
	    IF factor IS NULL THEN
	        RAISE EXCEPTION 'No conversion available between UOM % and % for tenant % entity %', 
	            from_uom_id, to_uom_id, p_tenant_id, p_entity_id;
	    END IF;
	    
	    RETURN quantity * factor;
	END;
	$$ LANGUAGE plpgsql;
	
	-- Function to get conversion factor using UOM names (tenant-aware)
	CREATE OR REPLACE FUNCTION get_conversion_by_name(
	    p_tenant_id INTEGER,
	    p_entity_id INTEGER,
	    from_uom_name VARCHAR, 
	    to_uom_name VARCHAR
	)
	RETURNS DECIMAL(15,6) AS $$
	DECLARE
	    from_id INTEGER;
	    to_id INTEGER;
	BEGIN
	    SELECT id INTO from_id 
	    FROM uom 
	    WHERE uom_name = from_uom_name 
	      AND tenant_id = p_tenant_id 
	      AND entity_id = p_entity_id;
	      
	    SELECT id INTO to_id 
	    FROM uom 
	    WHERE uom_name = to_uom_name 
	      AND tenant_id = p_tenant_id 
	      AND entity_id = p_entity_id;
	    
	    IF from_id IS NULL THEN
	        RAISE EXCEPTION 'UOM "%" not found for tenant % entity %', from_uom_name, p_tenant_id, p_entity_id;
	    END IF;
	    
	    IF to_id IS NULL THEN
	        RAISE EXCEPTION 'UOM "%" not found for tenant % entity %', to_uom_name, p_tenant_id, p_entity_id;
	    END IF;
	    
	    RETURN get_conversion_factor(p_tenant_id, p_entity_id, from_id, to_id);
	END;
	$$ LANGUAGE plpgsql;
	
