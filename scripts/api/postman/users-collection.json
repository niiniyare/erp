              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"john.doe\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/auth",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "auth"]
            }
          },
          "response": []
        },
        {
          "name": "Authenticate - Invalid Credentials",
          "request": {
            "method": "POST",
