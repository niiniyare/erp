                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"john.doe@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/auth",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "auth"]
            }
          },
          "response": []
        }
